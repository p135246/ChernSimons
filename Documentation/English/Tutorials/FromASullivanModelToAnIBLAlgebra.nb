Cell[TextData[{
 "From here on this is an ordinary alphabet, and the whole IBL layer applies \
to it. The quotient itself rides along as the ",
 Cell[BoxData["\"\<Algebra\>\""], "InlineFormula",ExpressionUUID->
  "7416bbb1-dafe-4b47-91df-364aa0c9e02c"],
 " key of the pairing object, which is where ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CyclicHochschildDifferential"]], 
    "paclet:ChernSimons/ref/CyclicHochschildDifferential", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "61752012-edb8-488c-beeb-e9c1f43fde5b"],
 " reads the chain-level differential from; for ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["CP",
     FontSlant->"Plain"], "2"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"f1dc75d8-f319-4cc8-9d63-20c2eecad851"],
 " that differential is zero, the model being formal, and the next tutorial \
shows the alphabet where it is not. There are three cyclic words of length \
two, for instance, because ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "\[CenterDot]", "1"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"483150a7-fc57-4020-be94-c915e446335f"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["a", "TI"], "\[CenterDot]", 
    StyleBox["a", "TI"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "f74a99f4-4889-4821-b95a-08021dc0c136"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["a", "TI"], "2"], "\[CenterDot]", 
    SuperscriptBox[
     StyleBox["a", "TI"], "2"]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"cf38caab-bace-46e6-9b35-6dd18254fac8"],
 " are cyclically antisymmetric and so vanish:"
}], "Text",ExpressionUUID->"8343880b-a0ce-4870-a95d-42e9919aa4bd"],

