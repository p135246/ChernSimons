 RowBox[{"{", 
  RowBox[{
   RowBox[{"1", "\[Rule]", 
    RowBox[{"-", "1"}]}], ",", 
   RowBox[{"a", "\[Rule]", "1"}], ",", 
   RowBox[{
    SuperscriptBox["a", "2"], "\[Rule]", "3"}]}], "}"}]], "Output",
 CellLabel->
  "Out[14]= ",ExpressionUUID->"ad25d279-7611-4d6d-9e90-47b39aea0a6d"]
}, Open  ]],

