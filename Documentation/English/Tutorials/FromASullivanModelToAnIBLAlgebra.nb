Cell[TextData[{
 "Here ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["V", "TI"], 
    StyleBox["deg",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "dc818c91-a393-4788-ad9f-ab69d96bae5f"],
 " is spanned by ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["b", "TI"], ",", 
    StyleBox["a", "TI"], 
    StyleBox["b", "TI"], ",", 
    SuperscriptBox[
     StyleBox["a", "TI"], "2"], 
    StyleBox["b", "TI"], ",", "\[Ellipsis]"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"38658865-3c95-4fe0-aea5-2037ad2d2487"],
 " together with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["a", "TI"], "3"], ",", 
    SuperscriptBox[
     StyleBox["a", "TI"], "4"], ",", "\[Ellipsis]"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"b47f88b7-f324-4d89-bd70-005b6872487a"],
 ", and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["d",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox[
       StyleBox["a", "TI"], 
       StyleBox["k", "TI"]], 
      StyleBox["b", "TI"]}], ")"}], "\[LongEqual]", 
    SuperscriptBox[
     StyleBox["a", "TI"], 
     RowBox[{
      StyleBox["k", "TI"], "+", "3"}]]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"ddeb88ab-a777-4cff-910a-b55ff9f47c0b"],
 " matches them up in pairs. That is the acyclicity, in closed form."
}], "Text",ExpressionUUID->"e96091f9-8463-4f98-ac8e-7cd8c1d90a73"],

Cell["The nondegenerate quotient", "Section",ExpressionUUID->"8f16fa6a-590e-42b8-bf89-97492f94e2bc"],

Cell[TextData[{
 "Dividing by ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["V", "TI"], 
    StyleBox["deg",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "2864a9b2-c3de-4757-a75f-588b189d47a6"],
 " leaves a finite-dimensional algebra on which the pairing is perfect: a \
Poincar\[EAcute] duality algebra, and, because the quotient map is a \
quasi-isomorphism, a differential Poincar\[EAcute] duality model of the \
original PDGA."
}], "Text",ExpressionUUID->"0e79df45-ce4e-420b-b30c-9a846faea420"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"pd", " ", "=", " ", 
   RowBox[{"NondegenerateQuotient", "[", "model", "]"}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"pd", "[", "\"\<Basis\>\"", "]"}], ",", " ", 
   RowBox[{"pd", "[", "\"\<Degrees\>\"", "]"}]}], "}"}]}], "Input",
 CellLabel->
  "In[10]:= ",ExpressionUUID->"5e015aaf-8564-444f-bed9-43a5a456632f"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", "a", ",", 
     SuperscriptBox["a", "2"]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "2", ",", "4"}], "}"}]}], "}"}]], "Output",
 CellLabel->
  "Out[10]= ",ExpressionUUID->"7bbb00b0-ff32-46d3-9df2-c531a3f29f14"]
}, Open  ]],

Cell[TextData[{
 "For ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["CP",
     FontSlant->"Plain"], "2"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"781f3d59-4798-4190-9b33-8f721f28c11c"],
 " the quotient is the cohomology ring itself, with zero differential, as it \
must be, ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["CP",
     FontSlant->"Plain"], "2"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"b96b20b3-48a3-459e-a86b-df397f02b05f"],
 " being formal. The pairing is stored as a matrix in that basis, and it is \
invertible:"
}], "Text",ExpressionUUID->"5f3bdefb-3537-4d40-9a5e-8bdc30fe1bcf"],

