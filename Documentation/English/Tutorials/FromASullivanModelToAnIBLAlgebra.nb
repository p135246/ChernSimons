Cell[TextData[{
 "Its symmetric degree is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", "(", 
    RowBox[{
     StyleBox["n", "TI"], "-", "3"}], ")"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"75825fd4-b6bc-4091-b8a8-6b244b222328"],
 ", which is the degree of ",
 Cell[BoxData[
  FormBox["\[HBar]", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "b9b222f9-3584-4fb3-ae04-0932e5847ac1"],
 " and so of a BD action:"
}], "Text",ExpressionUUID->"545072f8-186e-42d1-b841-f759841d5263"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"ElementDegree", "[", 
    RowBox[{
     RowBox[{"CyclicWord", "[", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "1", ",", " ", 
        RowBox[{"a", "^", "2"}]}], "}"}], "]"}], ",", " ", "pairing", ",", 
     " ", "\"\<Symmetric\>\""}], "]"}], ",", " ", 
   RowBox[{"ElementDegree", "[", 
    RowBox[{"HBar", ",", " ", "pairing", ",", " ", "\"\<Symmetric\>\""}], 
    "]"}]}], "}"}]], "Input",
 CellLabel->
  "In[21]:= ",ExpressionUUID->"508933af-09aa-4d36-a4ae-ba6b27262702"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"2", ",", "2"}], "}"}]], "Output",
 CellLabel->
  "Out[21]= ",ExpressionUUID->"dc7dcd3d-1961-458a-9ded-031e33900b5d"]
}, Open  ]],

Cell[TextData[{
 "And it solves the Maurer-Cartan equation. That is not a formality: on a \
word of length three the equation reduces to ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["q", "TI"], 
     RowBox[{"2", ",", "1", ",", "0"}]], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["m", "TI"], "\[CircleDot]", 
      StyleBox["m", "TI"]}], ")"}], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"d3651518-154c-41fb-aaab-137141b3a7a5"],
 ", which is associativity of the algebra written in these coordinates."
}], "Text",ExpressionUUID->"fb1d48d3-b7b7-4ff9-b7b8-1142835f137b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"RelationsQ", "[", "m", "]"}]], "Input",
 CellLabel->
  "In[22]:= ",ExpressionUUID->"80599932-c364-4da5-abbe-3c5ee856f492"],

Cell[BoxData["True"], "Output",
 CellLabel->
  "Out[22]= ",ExpressionUUID->"5508d561-daf6-4f74-812a-c483f53c4c25"]
}, Open  ]],

Cell[TextData[{
 "Twisting by it gives the dIBL algebra of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["CP",
     FontSlant->"Plain"], "2"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"1c68b90e-4522-4ffc-8c5b-e59b69d35c68"],
 ": the operations ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["q", "TI"], 
    RowBox[{"1", ",", "1", ",", "0"}], 
    StyleBox["m", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "68aa0e07-069a-478c-9a6c-5bd23e6f4122"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["q", "TI"], 
    RowBox[{"2", ",", "1", ",", "0"}]], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"6f1539ea-594a-49fe-86f9-f6e724580625"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["q", "TI"], 
    RowBox[{"1", ",", "2", ",", "0"}]], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"96d4c05f-538c-4fc5-9e2d-c16bab10ab06"],
 ", whose twisted homology is the cyclic cohomology of the Poincar\[EAcute] \
duality algebra. When the quotient keeps a differential, the chain-level \
operation ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["q", "TI"], 
    RowBox[{"1", ",", "1", ",", "0"}]], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"23a09afc-9fb0-404b-964d-e1354b94cbf8"],
 ", ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CyclicHochschildDifferential"]], 
    "paclet:ChernSimons/ref/CyclicHochschildDifferential", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "5365c860-2ac1-417b-9ae6-99efa32ac69d"],
 ", is nonzero before any twisting, and ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["q", "TI"], 
    RowBox[{"1", ",", "1", ",", "0"}], 
    StyleBox["m", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "fc1f0522-d5fc-4da7-8d3a-c215dc0a3760"],
 " stacks the bracket with the element on top of it; ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["CP",
     FontSlant->"Plain"], "2"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"0d1ca9e0-fb49-4ac0-b218-944f0d42b54a"],
 ", being formal, has none."
}], "Text",ExpressionUUID->"2b8fa2d8-da4a-4a30-ad8c-85833497e4e2"],

Cell["The whole catalogue", "Section",ExpressionUUID->"b1ef7d93-3895-48a1-8162-1c72f61af7fd"],

Cell[TextData[{
 "Every model in ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["$SullivanModels"]], "paclet:ChernSimons/ref/$SullivanModels", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "d8f06079-4e74-4db9-8eeb-a7ef85987f57"],
 " runs through the same five steps. The one exception is the last row, and \
it is the point of the next tutorial."
}], "Text",ExpressionUUID->"cc1a3afb-2424-406d-8490-6eb14032f65b"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"row", "[", "spec_", "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"md", " ", "=", " ", 
       RowBox[{"SullivanModel", "[", "spec", "]"}]}], "}"}], ",", "\n", "   ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"pq", " ", "=", " ", 
         RowBox[{"NondegenerateQuotient", "[", "md", "]"}]}], "}"}], ",", 
       "\n", "     ", 
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"pr", " ", "=", " ", 
           RowBox[{"GradedPairing", "[", "pq", "]"}]}], "}"}], ",", "\n", 
         "       ", 
         RowBox[{"<|", 
          RowBox[{
           RowBox[{"\"\<Model\>\"", " ", "->", " ", "spec"}], ",", " ", 
           RowBox[{"\"\<n\>\"", " ", "->", " ", 
            RowBox[{"md", "[", "\"\<Degree\>\"", "]"}]}], ",", " ", 
           RowBox[{"\"\<Hodge type\>\"", " ", "->", " ", 
            RowBox[{"HodgeTypeQ", "[", "md", "]"}]}], ",", "\n", "         ", 
           
           RowBox[{"\"\<dim Q\>\"", " ", "->", " ", 
            RowBox[{"Length", "[", 
             RowBox[{"pq", "[", "\"\<Basis\>\"", "]"}], "]"}]}], ",", "\n", 
           "         ", 
           RowBox[{"\"\<Maurer-Cartan\>\"", " ", "->", " ", 
            RowBox[{"RelationsQ", "[", 
             RowBox[{"CanonicalMaurerCartan", "[", "pr", "]"}], "]"}]}]}], 
          "|>"}]}], "]"}]}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"Dataset", "[", 
  RowBox[{"Map", "[", 
   RowBox[{"row", ",", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<Circle\>\"", ",", " ", 
      RowBox[{"\"\<Sphere\>\"", "[", "2", "]"}], ",", " ", 
      RowBox[{"\"\<Sphere\>\"", "[", "3", "]"}], ",", " ", 
      RowBox[{"\"\<ComplexProjectiveSpace\>\"", "[", "2", "]"}], ",", "\n", 
      "   ", 
      RowBox[{"\"\<ComplexProjectiveSpace\>\"", "[", "3", "]"}], ",", " ", 
      RowBox[{"\"\<QuaternionicProjectiveSpace\>\"", "[", "2", "]"}], ",", 
      " ", 
      RowBox[{"\"\<Torus\>\"", "[", "3", "]"}], ",", "\n", "   ", 
      RowBox[{"\"\<SpecialUnitaryGroup\>\"", "[", "3", "]"}], ",", 
      " ", "\"\<HeisenbergNilmanifold\>\"", ",", 
      " ", "\"\<KodairaThurston\>\"", ",", "\n", 
      "   ", "\"\<Degree4Obstruction\>\""}], "}"}]}], "]"}], "]"}]}], "Input",\

 CellLabel->
  "In[23]:= ",ExpressionUUID->"dd5ed88a-f289-4a0c-99bb-3532fdb7635a"],

