   RowBox[{
    RowBox[{"{", 
     RowBox[{"3", ",", "1", ",", "1"}], "}"}], "\[Rule]", "1"}]}], 
  "}"}]], "Output",
 CellLabel->
  "Out[13]= ",ExpressionUUID->"f6253991-475d-4b05-a99f-440b59bef921"]
}, Open  ]],

Cell["The dual pairing, and the alphabet", "Section",ExpressionUUID->"1ddc5ba7-e5e1-4293-ae79-75a6dd21f715"],

Cell[TextData[{
 "Shifting the quotient down by one turns the graded symmetric pairing of \
degree ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "8d4ee328-eeb1-4a51-8961-277cef9084ec"],
 " into a graded antisymmetric pairing of degree ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["n", "TI"], "-", "2"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"395fa351-a90d-4dfa-947f-44f55573898c"],
 ", which is what the IBL operations want. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["GradedPairing"]], "paclet:ChernSimons/ref/GradedPairing", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "c8b9adf8-31e2-4671-8dbf-df014fd892c4"],
 " applied to the algebra does exactly that, taking the basis monomials as \
the letters of the alphabet."
}], "Text",ExpressionUUID->"d6a09691-b10d-45a6-93a7-30ce5d695e38"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"pairing", " ", "=", " ", 
   RowBox[{"GradedPairing", "[", "pd", "]"}]}], ";"}], "\n", 
 RowBox[{"Normal", "[", 
  RowBox[{"pairing", "[", "\"\<Degrees\>\"", "]"}], "]"}]}], "Input",
 CellLabel->
  "In[14]:= ",ExpressionUUID->"94dd6f02-b630-49a0-96a7-5cea98c09399"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"1", "\[Rule]", 
    RowBox[{"-", "1"}]}], ",", 
   RowBox[{"a", "\[Rule]", "1"}], ",", 
   RowBox[{
    SuperscriptBox["a", "2"], "\[Rule]", "3"}]}], "}"}]], "Output",
 CellLabel->
  "Out[14]= ",ExpressionUUID->"86f684c9-0183-40da-ac57-b1ebc776eeb3"]
}, Open  ]],

