Cell[TextData[{
 "The triple products ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["O", "TI"], "(", 
    RowBox[{
     SubscriptBox[
      StyleBox["e", "TI"], 
      StyleBox["i", "TI"]], 
     SubscriptBox[
      StyleBox["e", "TI"], 
      StyleBox["j", "TI"]], 
     SubscriptBox[
      StyleBox["e", "TI"], 
      StyleBox["k", "TI"]]}], ")"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e8cdc099-5502-4f07-bbaf-ce5dafd1ce02"],
 " are what the Maurer-Cartan element below is built from; they are kept as \
an Association on the index triples, the zero ones dropped."
}], "Text",ExpressionUUID->"cdc2c56b-a056-4e31-aafa-dabd64abaae8"],

