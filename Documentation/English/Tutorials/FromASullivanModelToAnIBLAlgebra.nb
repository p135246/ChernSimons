   RowBox[{
    RowBox[{"{", 
     RowBox[{"3", ",", "1", ",", "1"}], "}"}], "\[Rule]", "1"}]}], 
  "}"}]], "Output",
 CellLabel->
  "Out[13]= ",ExpressionUUID->"884ded65-bb48-429a-9f0f-68583967a600"]
}, Open  ]],

Cell["The dual pairing, and the alphabet", "Section",ExpressionUUID->"71222c56-4d78-424e-8b65-10317f0530c6"],

Cell[TextData[{
 "Shifting the quotient down by one turns the graded symmetric pairing of \
degree ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1b029ca0-7949-4886-b913-9b99697f5885"],
 " into a graded antisymmetric pairing of degree ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["n", "TI"], "-", "2"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "60b8a9ff-690e-4f54-a464-b14924a1c631"],
 ", which is what the IBL operations want. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["GradedPairing"]], "paclet:ChernSimons/ref/GradedPairing", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "57447c5d-872e-4d39-bf76-b80c5ab18984"],
 " applied to the algebra does exactly that, taking the basis monomials as \
the particles of the alphabet."
}], "Text",ExpressionUUID->"5f8f7f3d-28f8-4313-9412-5bf30d4d044c"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"pairing", " ", "=", " ", 
   RowBox[{"GradedPairing", "[", "pd", "]"}]}], ";"}], "\n", 
 RowBox[{"Normal", "[", 
  RowBox[{"pairing", "[", "\"\<Degrees\>\"", "]"}], "]"}]}], "Input",
 CellLabel->
  "In[14]:= ",ExpressionUUID->"e603635d-92ec-4286-8570-2156728b9940"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"1", "\[Rule]", 
    RowBox[{"-", "1"}]}], ",", 
   RowBox[{"a", "\[Rule]", "1"}], ",", 
   RowBox[{
    SuperscriptBox["a", "2"], "\[Rule]", "3"}]}], "}"}]], "Output",
 CellLabel->
  "Out[14]= ",ExpressionUUID->"3fe848c4-bcee-4f06-a9b0-8a6e0bbf87d6"]
}, Open  ]],

