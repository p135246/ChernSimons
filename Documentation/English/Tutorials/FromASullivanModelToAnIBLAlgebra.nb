Cell[TextData[{
 "Its symmetric degree is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", "(", 
    RowBox[{
     StyleBox["n", "TI"], "-", "3"}], ")"}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "648a74cb-2d1b-4afa-acb1-1e2e2972fc67"],
 ", which is the degree of ",
 Cell[BoxData[
  FormBox["\[HBar]", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "679841e8-f4ed-4a01-a01d-082fd7382072"],
 " and so of a BD action:"
}], "Text",ExpressionUUID->"2778ec28-1ed0-4a42-af40-11dae496ead1"],

