 RowBox[{"{", 
  RowBox[{
   RowBox[{"WordDegree", "[", 
    RowBox[{
     RowBox[{"CyclicWord", "[", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "1", ",", " ", 
        RowBox[{"a", "^", "2"}]}], "}"}], "]"}], ",", " ", "pairing", ",", 
     " ", "\"\<Symmetric\>\""}], "]"}], ",", " ", 
