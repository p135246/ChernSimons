Cell[TextData[{
 "The triple products ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["O", "TI"], "(", 
    RowBox[{
     SubscriptBox[
      StyleBox["e", "TI"], 
      StyleBox["i", "TI"]], 
     SubscriptBox[
      StyleBox["e", "TI"], 
      StyleBox["j", "TI"]], 
     SubscriptBox[
      StyleBox["e", "TI"], 
      StyleBox["k", "TI"]]}], ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"ccdc0394-07bd-40a0-b807-ae51bd5700a2"],
 " are what the Maurer-Cartan element below is built from; they are kept as \
an Association on the index triples, the zero ones dropped."
}], "Text",ExpressionUUID->"b0797cfe-2a2f-4e2c-b961-10102711d2d8"],

