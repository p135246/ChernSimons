Cell[TextData[{
 "The four defining identities of an involutive bi-Lie algebra are the \
relations of the ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["StringAlgebra"]], "paclet:ChernSimons/ref/StringAlgebra", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "f88c6b08-db68-49c4-a8c9-bd3345d8eb39"],
 " of the pairing, and they hold, as they must for any alphabet with a graded \
antisymmetric pairing:"
}], "Text",ExpressionUUID->"c65c2d78-0b3f-4a77-9a6d-a1ff7bbd6b93"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"algebra", " ", "=", " ", 
      RowBox[{"StringAlgebra", "[", "pairing", "]"}]}], ",", " ", 
     RowBox[{"u", " ", "=", " ", 
      RowBox[{"CyclicWord", "[", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "a"}], "}"}], "]"}]}], ",", " ", 
     RowBox[{"v", " ", "=", " ", 
      RowBox[{"CyclicWord", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"a", "^", "2"}], ",", " ", "a"}], "}"}], "]"}]}]}], "}"}], ",",
    "\n", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Obstruction", "[", 
      RowBox[{"algebra", ",", " ", "\"\<Jacobi\>\"", ",", " ", 
       RowBox[{"{", 
        RowBox[{"u", ",", " ", "v", ",", " ", "u"}], "}"}]}], "]"}], ",", " ", 
     RowBox[{"Obstruction", "[", 
      RowBox[{"algebra", ",", " ", "\"\<CoJacobi\>\"", ",", " ", 
       RowBox[{"{", "u", "}"}]}], "]"}], ",", "\n", "  ", 
     RowBox[{"Obstruction", "[", 
      RowBox[{"algebra", ",", " ", "\"\<Drinfeld\>\"", ",", " ", 
       RowBox[{"{", 
        RowBox[{"u", ",", " ", "v"}], "}"}]}], "]"}], ",", " ", 
     RowBox[{"Obstruction", "[", 
      RowBox[{"algebra", ",", " ", "\"\<Involutivity\>\"", ",", " ", 
       RowBox[{"{", "u", "}"}]}], "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->
  "In[19]:= ",ExpressionUUID->"f669ef2d-6c65-4b95-b624-a4ae79968e29"],

