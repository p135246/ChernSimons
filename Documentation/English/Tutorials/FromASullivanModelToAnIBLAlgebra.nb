Cell[TextData[{
 "From here on this is an ordinary alphabet, and the whole IBL layer applies \
to it. The quotient itself rides along as the ",
 Cell[BoxData["\"\<Algebra\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c5eed360-a5b3-4274-a8f6-5f88bc25c7fd"],
 " key of the pairing object, which is where ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CyclicDifferential"]], 
    "paclet:ChernSimons/ref/CyclicDifferential", "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "37363774-345f-419f-861d-19d8c07f42ec"],
 " reads the chain-level differential from; for ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["CP",
     FontSlant->"Plain"], "2"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "627a894e-62c4-45db-bd1f-07c2c2a4ad84"],
 " that differential is zero, the model being formal, and the next tutorial \
shows the alphabet where it is not. The cyclic words of length two, for \
instance \[LongDash] three of them, because ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "\[CenterDot]", "1"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a7e79dea-eca4-42cb-9da3-6d886f16dd2d"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["a", "TI"], "\[CenterDot]", 
    StyleBox["a", "TI"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "90af29e8-a8a5-4cfe-81f7-09b1fb60928a"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["a", "TI"], "2"], "\[CenterDot]", 
    SuperscriptBox[
     StyleBox["a", "TI"], "2"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d47891a5-5ed2-4138-8ec9-6305084fe900"],
 " are cyclically antisymmetric and so vanish:"
}], "Text",ExpressionUUID->"82dde706-d3c7-44eb-82ae-14d39d9495d1"],

Cell[CellGroupData[{

Cell[BoxData[
