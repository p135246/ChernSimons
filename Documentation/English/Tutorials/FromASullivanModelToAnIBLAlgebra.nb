}, Open  ]],

Cell[TextData[{
 "And it solves the Maurer-Cartan equation. That is not a formality: on a \
word of length three the equation reduces to ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["q", "TI"], 
     RowBox[{"2", ",", "1", ",", "0"}]], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["m", "TI"], "\[CircleDot]", 
      StyleBox["m", "TI"]}], ")"}], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"3fd60738-9c55-42c0-a043-cc7ba353c4a8"],
 ", which is associativity of the algebra written in these coordinates."
}], "Text",ExpressionUUID->"7e124841-cca1-4fc5-b6e1-cf1f12f70020"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"RelationsQ", "[", "m", "]"}]], "Input",
 CellLabel->
  "In[22]:= ",ExpressionUUID->"398188ce-bbf7-4f2e-a852-fd3790ce6e8c"],

Cell[BoxData["True"], "Output",
 CellLabel->
  "Out[22]= ",ExpressionUUID->"aa853d89-e173-4b5b-a20e-bcdc0f6f5956"]
}, Open  ]],

Cell[TextData[{
 "Twisting by it gives the dIBL algebra of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["CP",
     FontSlant->"Plain"], "2"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"179376c2-d1c3-42a3-8bb2-d7987afc31f2"],
 ": the operations ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["q", "TI"], 
    RowBox[{"1", ",", "1", ",", "0"}], 
    StyleBox["m", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "2a71fc0a-52c9-48bf-8cf5-9a38fee9e780"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["q", "TI"], 
    RowBox[{"2", ",", "1", ",", "0"}]], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"19fb527c-5963-40d4-ad71-f2ba189de9da"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["q", "TI"], 
    RowBox[{"1", ",", "2", ",", "0"}]], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"b9ce4e5e-c838-4b7d-b32e-aa1080c26739"],
 ", whose twisted homology is the cyclic cohomology of the Poincar\[EAcute] \
duality algebra. When the quotient keeps a differential, the chain-level \
operation ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["q", "TI"], 
    RowBox[{"1", ",", "1", ",", "0"}]], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"7b15aa79-ddc0-4eae-b57c-da63256fb0a8"],
 ", ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CyclicHochschildDifferential"]], 
    "paclet:ChernSimons/ref/CyclicHochschildDifferential", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "371f9f50-3cf5-483a-8b7f-5f6e336cec21"],
 ", is nonzero before any twisting, and ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["q", "TI"], 
    RowBox[{"1", ",", "1", ",", "0"}], 
    StyleBox["m", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "912c7967-04df-46eb-80b8-19871cea34ae"],
 " stacks the bracket with the element on top of it; ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["CP",
     FontSlant->"Plain"], "2"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"2b30c2db-4467-429d-9f35-b41ebc5d2411"],
 ", being formal, has none."
}], "Text",ExpressionUUID->"ce8a922c-5eb6-45ee-b4e9-7b315630a7c2"],

Cell["The whole catalogue", "Section",ExpressionUUID->"0d594510-aa3d-4a2b-9b61-ce39a9d60d0d"],

Cell[TextData[{
 "Every model in ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["$SullivanModels"]], "paclet:ChernSimons/ref/$SullivanModels", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "01bd83bd-408c-4b60-afdc-bbde52051bbf"],
 " runs through the same five steps. The one exception is the last row, and \
it is the point of the next tutorial."
}], "Text",ExpressionUUID->"2282d190-97bc-4b8f-b1b3-1d6925e6a4c5"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"row", "[", "spec_", "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"md", " ", "=", " ", 
       RowBox[{"SullivanModel", "[", "spec", "]"}]}], "}"}], ",", "\n", "   ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"pq", " ", "=", " ", 
         RowBox[{"NondegenerateQuotient", "[", "md", "]"}]}], "}"}], ",", 
       "\n", "     ", 
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"pr", " ", "=", " ", 
           RowBox[{"GradedPairing", "[", "pq", "]"}]}], "}"}], ",", "\n", 
         "       ", 
         RowBox[{"<|", 
          RowBox[{
           RowBox[{"\"\<Model\>\"", " ", "->", " ", "spec"}], ",", " ", 
           RowBox[{"\"\<n\>\"", " ", "->", " ", 
            RowBox[{"md", "[", "\"\<Degree\>\"", "]"}]}], ",", " ", 
           RowBox[{"\"\<Hodge type\>\"", " ", "->", " ", 
            RowBox[{"HodgeTypeQ", "[", "md", "]"}]}], ",", "\n", "         ", 
           
           RowBox[{"\"\<dim Q\>\"", " ", "->", " ", 
            RowBox[{"Length", "[", 
             RowBox[{"pq", "[", "\"\<Basis\>\"", "]"}], "]"}]}], ",", "\n", 
           "         ", 
           RowBox[{"\"\<Maurer-Cartan\>\"", " ", "->", " ", 
            RowBox[{"RelationsQ", "[", 
             RowBox[{"CanonicalMaurerCartan", "[", "pr", "]"}], "]"}]}]}], 
          "|>"}]}], "]"}]}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"Dataset", "[", 
  RowBox[{"Map", "[", 
   RowBox[{"row", ",", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<Circle\>\"", ",", " ", 
      RowBox[{"\"\<Sphere\>\"", "[", "2", "]"}], ",", " ", 
      RowBox[{"\"\<Sphere\>\"", "[", "3", "]"}], ",", " ", 
      RowBox[{"\"\<ComplexProjectiveSpace\>\"", "[", "2", "]"}], ",", "\n", 
      "   ", 
      RowBox[{"\"\<ComplexProjectiveSpace\>\"", "[", "3", "]"}], ",", " ", 
      RowBox[{"\"\<QuaternionicProjectiveSpace\>\"", "[", "2", "]"}], ",", 
      " ", 
      RowBox[{"\"\<Torus\>\"", "[", "3", "]"}], ",", "\n", "   ", 
      RowBox[{"\"\<SpecialUnitaryGroup\>\"", "[", "3", "]"}], ",", 
      " ", "\"\<HeisenbergNilmanifold\>\"", ",", 
      " ", "\"\<KodairaThurston\>\"", ",", "\n", 
      "   ", "\"\<Degree4Obstruction\>\""}], "}"}]}], "]"}], "]"}]}], "Input",\

 CellLabel->
  "In[23]:= ",ExpressionUUID->"aec8be24-60d0-400e-969b-d71164d8474f"],

