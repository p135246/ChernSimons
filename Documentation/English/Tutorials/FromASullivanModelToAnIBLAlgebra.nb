 RowBox[{"{", 
  RowBox[{
   RowBox[{"1", "\[Rule]", 
    RowBox[{"-", "1"}]}], ",", 
   RowBox[{"a", "\[Rule]", "1"}], ",", 
   RowBox[{
    SuperscriptBox["a", "2"], "\[Rule]", "3"}]}], "}"}]], "Output",
 CellLabel->
  "Out[14]= ",ExpressionUUID->"961cdeec-2c19-4687-90e8-a02e607883f3"]
}, Open  ]],

