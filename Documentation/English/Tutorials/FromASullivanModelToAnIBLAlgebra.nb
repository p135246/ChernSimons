Cell[TextData[{
 "Here ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["V", "TI"], 
    StyleBox["deg",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "be9b0233-0eda-4e8a-9b2a-2ffc993e272a"],
 " is spanned by ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["b", "TI"], ",", 
    StyleBox["a", "TI"], 
    StyleBox["b", "TI"], ",", 
    SuperscriptBox[
     StyleBox["a", "TI"], "2"], 
    StyleBox["b", "TI"], ",", "\[Ellipsis]"}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "125635f9-c103-4813-8d9e-3e48bb42e878"],
 " together with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["a", "TI"], "3"], ",", 
    SuperscriptBox[
     StyleBox["a", "TI"], "4"], ",", "\[Ellipsis]"}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b7a2d2dd-61a4-4393-bc0e-261175cf0172"],
 ", and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["d",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox[
       StyleBox["a", "TI"], 
       StyleBox["k", "TI"]], 
      StyleBox["b", "TI"]}], ")"}], "\[LongEqual]", 
    SuperscriptBox[
     StyleBox["a", "TI"], 
     RowBox[{
      StyleBox["k", "TI"], "+", "3"}]]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "70aa2040-95c7-40da-9b6c-52dcb4e2916c"],
 " matches them up in pairs. That is the acyclicity, in closed form."
}], "Text",ExpressionUUID->"048be8f1-de3c-42bb-944d-3151f4f2e476"],

Cell["The nondegenerate quotient", "Section",ExpressionUUID->"16e13ed1-ae26-4dd0-bdb7-b9d8db84baad"],

Cell[TextData[{
 "Dividing by ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["V", "TI"], 
    StyleBox["deg",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9a0970e9-4361-4c89-9872-1286e49e8496"],
 " leaves a finite-dimensional algebra on which the pairing is perfect: a \
Poincar\[EAcute] duality algebra, and, because the quotient map is a \
quasi-isomorphism, a differential Poincar\[EAcute] duality model of the \
original PDGA."
}], "Text",ExpressionUUID->"4fbe0db1-f657-471f-92d3-7c0903d5c3a0"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"pd", " ", "=", " ", 
   RowBox[{"NondegenerateQuotient", "[", "model", "]"}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"pd", "[", "\"\<Basis\>\"", "]"}], ",", " ", 
   RowBox[{"pd", "[", "\"\<Degrees\>\"", "]"}]}], "}"}]}], "Input",
 CellLabel->
  "In[10]:= ",ExpressionUUID->"ad86527b-746f-49a8-ac3a-7826f30ff844"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", "a", ",", 
     SuperscriptBox["a", "2"]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "2", ",", "4"}], "}"}]}], "}"}]], "Output",
 CellLabel->
  "Out[10]= ",ExpressionUUID->"f77fbcb6-43a9-468f-a3e7-20315f118267"]
}, Open  ]],

Cell[TextData[{
 "For ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["CP",
     FontSlant->"Plain"], "2"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0fe3821b-639b-43a3-abdd-95933985cf73"],
 " the quotient is the cohomology ring itself, with zero differential, as it \
must be, ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["CP",
     FontSlant->"Plain"], "2"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ba5084fa-f72a-452e-87e0-01fa0dcd6f1b"],
 " being formal. The pairing is stored as a matrix in that basis, and it is \
invertible:"
}], "Text",ExpressionUUID->"301558a1-3419-4433-a7ca-6651ab1bb561"],

