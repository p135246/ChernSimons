Cell[TextData[{
 "The four defining identities of an involutive bi-Lie algebra are the \
relations of the ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CanonicalLieBialgebra"]], 
    "paclet:ChernSimons/ref/CanonicalLieBialgebra", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "4ac03280-1c37-4e45-9b2f-54e8ffc812cf"],
 " of the pairing, and they hold, as they must for any alphabet with a graded \
antisymmetric pairing:"
}], "Text",ExpressionUUID->"a2b0906a-78af-4d3c-b96d-9d23384df8d0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"algebra", " ", "=", " ", 
      RowBox[{"CanonicalLieBialgebra", "[", "pairing", "]"}]}], ",", " ", 
     RowBox[{"u", " ", "=", " ", 
      RowBox[{"CyclicWord", "[", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "a"}], "}"}], "]"}]}], ",", " ", 
     RowBox[{"v", " ", "=", " ", 
      RowBox[{"CyclicWord", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"a", "^", "2"}], ",", " ", "a"}], "}"}], "]"}]}]}], "}"}], ",",
    "\n", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Obstruction", "[", 
      RowBox[{"algebra", ",", " ", "\"\<Jacobi\>\"", ",", " ", 
       RowBox[{"{", 
        RowBox[{"u", ",", " ", "v", ",", " ", "u"}], "}"}]}], "]"}], ",", " ", 
     RowBox[{"Obstruction", "[", 
      RowBox[{"algebra", ",", " ", "\"\<CoJacobi\>\"", ",", " ", 
       RowBox[{"{", "u", "}"}]}], "]"}], ",", "\n", "  ", 
     RowBox[{"Obstruction", "[", 
      RowBox[{"algebra", ",", " ", "\"\<Drinfeld\>\"", ",", " ", 
       RowBox[{"{", 
        RowBox[{"u", ",", " ", "v"}], "}"}]}], "]"}], ",", " ", 
     RowBox[{"Obstruction", "[", 
      RowBox[{"algebra", ",", " ", "\"\<Involutivity\>\"", ",", " ", 
       RowBox[{"{", "u", "}"}]}], "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->
  "In[19]:= ",ExpressionUUID->"8b549ef1-b54a-4d09-8b6d-f09c53dc165c"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0", ",", "0", ",", "0", ",", "0"}], "}"}]], "Output",
