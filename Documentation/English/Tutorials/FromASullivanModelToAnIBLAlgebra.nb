Cell[TextData[{
 "Its symmetric degree is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", "(", 
    RowBox[{
     StyleBox["n", "TI"], "-", "3"}], ")"}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "82fabfbb-4dbb-46e0-9165-d7fbb1130ff3"],
 ", which is the degree of ",
 Cell[BoxData[
  FormBox["\[HBar]", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "21044d05-a2bc-4cc9-b356-54ed1e308ad2"],
 " and so of a BD action:"
}], "Text",ExpressionUUID->"f5e58d36-3138-4e74-8921-a66ceab07de5"],

