}, Open  ]],

Cell["The canonical Maurer-Cartan element", "Section",ExpressionUUID->"1bb89939-2501-43a8-9df5-145a9cb34eb8"],

Cell["\<\
The triple product of the Poincar\[EAcute] duality algebra is a cyclic \
three-cochain, so it is an element of the cyclic words of length three. \
Written in a basis it is\
\>", "Text",ExpressionUUID->"e8a815be-6039-44c5-a38b-0f6d410259e6"],

Cell[BoxData[
 PaneBox[
  FormBox[
   RowBox[{
    RowBox[{
     SubsuperscriptBox[
      StyleBox["m", "TI"], 
      RowBox[{"1", ",", "0"}], 
      StyleBox["can",
       FontSlant->"Plain"]], "\[LongEqual]", 
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"-", "1"}], ")"}], 
       RowBox[{
        StyleBox["n", "TI"], "-", "2"}]], 
      FractionBox["1", "3"], 
      RowBox[{
       UnderscriptBox["\[Sum]", 
        RowBox[{
         StyleBox["i", "TI"], ",", 
         StyleBox["j", "TI"], ",", 
         StyleBox["k", "TI"]}],
        LimitsPositioning->True], 
       RowBox[{
        RowBox[{"\[PlusMinus]", " ", 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"-", "1"}], ")"}], 
          RowBox[{"deg", 
           SubscriptBox[
            StyleBox["e", "TI"], 
            StyleBox["j", "TI"]]}]]}], " ", 
        StyleBox["O", "TI"], 
        RowBox[{"(", 
         RowBox[{
          SubscriptBox[
           StyleBox["e", "TI"], 
           StyleBox["i", "TI"]], 
          SubscriptBox[
           StyleBox["e", "TI"], 
           StyleBox["j", "TI"]], 
          SubscriptBox[
           StyleBox["e", "TI"], 
           StyleBox["k", "TI"]]}], ")"}], " ", 
        SuperscriptBox[
         StyleBox["e", "TI"], 
         StyleBox["i", "TI"]], 
        SuperscriptBox[
         StyleBox["e", "TI"], 
         StyleBox["j", "TI"]], 
        SuperscriptBox[
         StyleBox["e", "TI"], 
         StyleBox["k", "TI"]]}]}]}]}], ","}],
   TraditionalForm],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",ExpressionUUID->"db2ea580-da3c-40ce-\
a807-425b44a9d20e"],

Cell[TextData[{
 "the ",
 Cell[BoxData[
  FormBox["\[PlusMinus]", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "40cc1dce-27fc-4851-8277-426402c5d19a"],
 " being the reversal sign. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CanonicalMaurerCartan"]], 
    "paclet:ChernSimons/ref/CanonicalMaurerCartan", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "fcd090a6-eb76-400f-9685-71e70f889fd8"],
 " evaluates it, as the part ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["m", "TI"], 
    RowBox[{"1", ",", "0"}]], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"a24a01cf-ec67-42b4-aabe-4d9977ca5028"],
 " of a ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["MaurerCartanElement"]], 
    "paclet:ChernSimons/ref/MaurerCartanElement", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "844d8edd-87c3-4e8b-a9b2-03108cb050c4"],
 "."
}], "Text",ExpressionUUID->"b5382257-d679-434f-a4ed-cb6af97494b6"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"m", " ", "=", " ", 
   RowBox[{"CanonicalMaurerCartan", "[", "pairing", "]"}]}], ";"}], "\n", 
