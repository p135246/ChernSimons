Cell[TextData[{
 "The four defining identities of an involutive bi-Lie algebra are the \
relations of the ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CanonicalLieBialgebra"]], 
    "paclet:ChernSimons/ref/CanonicalLieBialgebra", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "faabf629-51dc-451d-b95c-49695e578cfb"],
 " of the pairing, and they hold, as they must for any alphabet with a graded \
antisymmetric pairing:"
}], "Text",ExpressionUUID->"aaee2aa6-1930-4c4f-93e2-cfcdf770d303"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"algebra", " ", "=", " ", 
      RowBox[{"CanonicalLieBialgebra", "[", "pairing", "]"}]}], ",", " ", 
     RowBox[{"u", " ", "=", " ", 
      RowBox[{"CyclicWord", "[", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "a"}], "}"}], "]"}]}], ",", " ", 
     RowBox[{"v", " ", "=", " ", 
      RowBox[{"CyclicWord", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"a", "^", "2"}], ",", " ", "a"}], "}"}], "]"}]}]}], "}"}], ",",
    "\n", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Obstruction", "[", 
      RowBox[{"algebra", ",", " ", "\"\<Jacobi\>\"", ",", " ", 
       RowBox[{"{", 
        RowBox[{"u", ",", " ", "v", ",", " ", "u"}], "}"}]}], "]"}], ",", " ", 
     RowBox[{"Obstruction", "[", 
      RowBox[{"algebra", ",", " ", "\"\<CoJacobi\>\"", ",", " ", 
       RowBox[{"{", "u", "}"}]}], "]"}], ",", "\n", "  ", 
     RowBox[{"Obstruction", "[", 
      RowBox[{"algebra", ",", " ", "\"\<Drinfeld\>\"", ",", " ", 
       RowBox[{"{", 
        RowBox[{"u", ",", " ", "v"}], "}"}]}], "]"}], ",", " ", 
     RowBox[{"Obstruction", "[", 
      RowBox[{"algebra", ",", " ", "\"\<Involutivity\>\"", ",", " ", 
       RowBox[{"{", "u", "}"}]}], "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->
  "In[19]:= ",ExpressionUUID->"6cb84747-9762-42cf-8cfd-3922e46feca7"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0", ",", "0", ",", "0", ",", "0"}], "}"}]], "Output",
 CellLabel->
  "Out[19]= ",ExpressionUUID->"aea7fb65-392b-4516-bb3f-3bc44a44ee17"]
}, Open  ]],

Cell["The canonical Maurer-Cartan element", "Section",ExpressionUUID->"3bfd68ed-7183-427d-85a8-7766e4d3f163"],

Cell["\<\
The triple product of the Poincar\[EAcute] duality algebra is a cyclic \
three-cochain, so it is an element of the cyclic words of length three. \
Written in a basis it is\
\>", "Text",ExpressionUUID->"7e3b76f8-1871-4fdf-940e-7553c24008b4"],

Cell[BoxData[
 PaneBox[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["m", "TI"], 
     RowBox[{"1", ",", "0"}], 
     StyleBox["can",
      FontSlant->"Plain"]], "\[LongEqual]", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"-", "1"}], ")"}], 
     RowBox[{
      StyleBox["n", "TI"], "-", "2"}]], 
    FractionBox["1", "3"], 
    UnderscriptBox["\[Sum]", 
     RowBox[{
      StyleBox["i", "TI"], ",", 
      StyleBox["j", "TI"], ",", 
      StyleBox["k", "TI"]}],
     LimitsPositioning->True], 
    RowBox[{"\[PlusMinus]", " "}], 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"-", "1"}], ")"}], 
     RowBox[{"deg", 
      SubscriptBox[
       StyleBox["e", "TI"], 
       StyleBox["j", "TI"]]}]], " ", 
    StyleBox["O", "TI"], 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox[
       StyleBox["e", "TI"], 
       StyleBox["i", "TI"]], 
      SubscriptBox[
       StyleBox["e", "TI"], 
       StyleBox["j", "TI"]], 
      SubscriptBox[
       StyleBox["e", "TI"], 
       StyleBox["k", "TI"]]}], ")"}], " ", 
    SuperscriptBox[
     StyleBox["e", "TI"], 
     StyleBox["i", "TI"]], 
    SuperscriptBox[
     StyleBox["e", "TI"], 
     StyleBox["j", "TI"]], 
    SuperscriptBox[
     StyleBox["e", "TI"], 
     StyleBox["k", "TI"]], ","}],
   TraditionalForm],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",ExpressionUUID->"90811555-9138-46fa-\
8f77-dfbf57ed5c8c"],

Cell[TextData[{
 "the ",
 Cell[BoxData[
  FormBox["\[PlusMinus]", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c670d72a-6b76-4db7-9fa8-1cb55cfada00"],
 " being the reversal sign. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CanonicalMaurerCartan"]], 
    "paclet:ChernSimons/ref/CanonicalMaurerCartan", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "9cd4976d-8c9e-4ffc-a63e-68a05ce2774d"],
 " evaluates it, as the part ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["m", "TI"], 
    RowBox[{"1", ",", "0"}]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "11bdc0c3-7c17-4175-b79d-e277c5002b66"],
 " of a ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["MaurerCartanElement"]], 
    "paclet:ChernSimons/ref/MaurerCartanElement", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "69f9013a-f6a5-4ebd-aa86-bbd5c875412f"],
 "."
}], "Text",ExpressionUUID->"1d0fae14-3b24-4e9e-ade0-64e6a68fc343"],

