Cell[TextData[{
 "The four defining identities of an involutive bi-Lie algebra are the \
relations of the ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CanonicalLieBialgebra"]], 
    "paclet:ChernSimons/ref/CanonicalLieBialgebra", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "c532ef15-2dbe-4412-b025-fcfbfd2770d4"],
 " of the pairing, and they hold, as they must for any alphabet with a graded \
antisymmetric pairing:"
}], "Text",ExpressionUUID->"72f21afa-728c-4b4b-83e1-e6bf7a397fa7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"algebra", " ", "=", " ", 
      RowBox[{"CanonicalLieBialgebra", "[", "pairing", "]"}]}], ",", " ", 
     RowBox[{"u", " ", "=", " ", 
      RowBox[{"CyclicWord", "[", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "a"}], "}"}], "]"}]}], ",", " ", 
     RowBox[{"v", " ", "=", " ", 
      RowBox[{"CyclicWord", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"a", "^", "2"}], ",", " ", "a"}], "}"}], "]"}]}]}], "}"}], ",",
    "\n", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Obstruction", "[", 
      RowBox[{"algebra", ",", " ", "\"\<Jacobi\>\"", ",", " ", 
       RowBox[{"{", 
        RowBox[{"u", ",", " ", "v", ",", " ", "u"}], "}"}]}], "]"}], ",", " ", 
     RowBox[{"Obstruction", "[", 
      RowBox[{"algebra", ",", " ", "\"\<CoJacobi\>\"", ",", " ", 
       RowBox[{"{", "u", "}"}]}], "]"}], ",", "\n", "  ", 
     RowBox[{"Obstruction", "[", 
      RowBox[{"algebra", ",", " ", "\"\<Drinfeld\>\"", ",", " ", 
       RowBox[{"{", 
        RowBox[{"u", ",", " ", "v"}], "}"}]}], "]"}], ",", " ", 
     RowBox[{"Obstruction", "[", 
      RowBox[{"algebra", ",", " ", "\"\<Involutivity\>\"", ",", " ", 
       RowBox[{"{", "u", "}"}]}], "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->
  "In[19]:= ",ExpressionUUID->"aaffc09b-efda-4ade-95e2-9cd12b5a2290"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0", ",", "0", ",", "0", ",", "0"}], "}"}]], "Output",
 CellLabel->
  "Out[19]= ",ExpressionUUID->"1a58c36c-30f5-437c-ba2e-6804f519b38a"]
}, Open  ]],

Cell["The canonical Maurer-Cartan element", "Section",ExpressionUUID->"961d3a43-29b2-4c2d-b814-b7cff03db559"],

Cell["\<\
The triple product of the Poincar\[EAcute] duality algebra is a cyclic \
three-cochain, so it is an element of the cyclic words of length three. \
Written in a basis it is\
\>", "Text",ExpressionUUID->"6288178a-57d3-4d27-a115-26ab6cdefeb8"],

Cell[BoxData[
 PaneBox[
  FormBox[
   RowBox[{
    RowBox[{
     SubsuperscriptBox[
      StyleBox["m", "TI"], 
      RowBox[{"1", ",", "0"}], 
      StyleBox["can",
       FontSlant->"Plain"]], "\[LongEqual]", 
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"-", "1"}], ")"}], 
       RowBox[{
        StyleBox["n", "TI"], "-", "2"}]], 
      FractionBox["1", "3"], 
      RowBox[{
       UnderscriptBox["\[Sum]", 
        RowBox[{
         StyleBox["i", "TI"], ",", 
         StyleBox["j", "TI"], ",", 
         StyleBox["k", "TI"]}],
        LimitsPositioning->True], 
       RowBox[{
        RowBox[{"\[PlusMinus]", " ", 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"-", "1"}], ")"}], 
          RowBox[{"deg", 
           SubscriptBox[
            StyleBox["e", "TI"], 
            StyleBox["j", "TI"]]}]]}], " ", 
        StyleBox["O", "TI"], 
        RowBox[{"(", 
         RowBox[{
          SubscriptBox[
           StyleBox["e", "TI"], 
           StyleBox["i", "TI"]], 
          SubscriptBox[
           StyleBox["e", "TI"], 
           StyleBox["j", "TI"]], 
          SubscriptBox[
           StyleBox["e", "TI"], 
           StyleBox["k", "TI"]]}], ")"}], " ", 
        SuperscriptBox[
         StyleBox["e", "TI"], 
         StyleBox["i", "TI"]], 
        SuperscriptBox[
         StyleBox["e", "TI"], 
         StyleBox["j", "TI"]], 
        SuperscriptBox[
         StyleBox["e", "TI"], 
         StyleBox["k", "TI"]]}]}]}]}], ","}],
   TraditionalForm],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",ExpressionUUID->"aad207db-6752-4e27-\
ba81-e20c58b9f505"],

Cell[TextData[{
 "the ",
 Cell[BoxData[
  FormBox["\[PlusMinus]", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "d1b85942-4dce-47a2-bebe-2fd2cf2b7f8a"],
 " being the reversal sign. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CanonicalMaurerCartan"]], 
    "paclet:ChernSimons/ref/CanonicalMaurerCartan", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "d1701b5d-2f97-4ad5-a0ee-5b9a14ea5543"],
 " evaluates it, as the part ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["m", "TI"], 
    RowBox[{"1", ",", "0"}]], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"ef66ee76-2a6d-49e3-a414-d723522b15b0"],
 " of a ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["MaurerCartanElement"]], 
    "paclet:ChernSimons/ref/MaurerCartanElement", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "885e8945-e464-4d36-9db1-ab9b3609dc4d"],
 "."
}], "Text",ExpressionUUID->"5fcb5404-731b-4090-be2f-ce2fdf301368"],

