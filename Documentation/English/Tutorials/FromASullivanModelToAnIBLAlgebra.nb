     RowBox[{"2", ",", "2", ",", "1"}], "}"}], "\[Rule]", "1"}], ",", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"3", ",", "1", ",", "1"}], "}"}], "\[Rule]", "1"}]}], 
  "}"}]], "Output",
 CellLabel->
  "Out[13]= ",ExpressionUUID->"b6805397-8627-41f3-bbb5-818e83023deb"]
}, Open  ]],

Cell["The dual pairing, and the alphabet", "Section",ExpressionUUID->"08a6c919-f0c8-478c-a264-15679d490871"],

Cell[TextData[{
 "Shifting the quotient down by one turns the graded symmetric pairing of \
degree ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "e2721384-5ead-4309-863c-c508b5a010b9"],
 " into a graded antisymmetric pairing of degree ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["n", "TI"], "-", "2"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"4540c05c-3518-4049-bec5-1eec92204d0e"],
 ", which is what the IBL operations want. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["GradedPairing"]], "paclet:ChernSimons/ref/GradedPairing", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "dbadb460-90c5-4114-b239-855fbca5e7e6"],
 " applied to the algebra does exactly that, taking the basis monomials as \
the particles of the alphabet."
}], "Text",ExpressionUUID->"0ebeae1f-e849-44e8-9bbf-71508e6daa0f"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"pairing", " ", "=", " ", 
   RowBox[{"GradedPairing", "[", "pd", "]"}]}], ";"}], "\n", 
 RowBox[{"Normal", "[", 
  RowBox[{"pairing", "[", "\"\<Degrees\>\"", "]"}], "]"}]}], "Input",
 CellLabel->
  "In[14]:= ",ExpressionUUID->"5c3801cd-12f0-433e-842f-5326d37fa687"],

