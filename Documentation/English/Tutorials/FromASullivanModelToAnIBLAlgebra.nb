}, Open  ]],

Cell[TextData[{
 "Its symmetric degree is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", "(", 
    RowBox[{
     StyleBox["n", "TI"], "-", "3"}], ")"}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "eb4416bf-8ca4-46d6-b7d2-8883aefde638"],
 ", which is the degree of ",
 Cell[BoxData[
  FormBox["\[Null]", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cc846201-d6e5-416b-809b-c09e55c17074"],
 " and so of a BD action:"
}], "Text",ExpressionUUID->"5552a6b2-0b4a-4815-805b-88cf2a1033cc"],

Cell[CellGroupData[{

