Cell[TextData[{
 "Here ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["V", "TI"], 
    StyleBox["deg",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "217b9ba6-2886-46fb-8aed-97edb05a4c59"],
 " is spanned by ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["b", "TI"], ",", 
    StyleBox["a", "TI"], 
    StyleBox["b", "TI"], ",", 
    SuperscriptBox[
     StyleBox["a", "TI"], "2"], 
    StyleBox["b", "TI"], ",", "\[Ellipsis]"}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ac7861d5-f81f-47e0-9df5-63a4f9277404"],
 " together with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["a", "TI"], "3"], ",", 
    SuperscriptBox[
     StyleBox["a", "TI"], "4"], ",", "\[Ellipsis]"}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ae569e5d-f4bb-4bde-b970-12fc6e5ceeaf"],
 ", and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["d",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox[
       StyleBox["a", "TI"], 
       StyleBox["k", "TI"]], 
      StyleBox["b", "TI"]}], ")"}], "\[LongEqual]", 
    SuperscriptBox[
     StyleBox["a", "TI"], 
     RowBox[{
      StyleBox["k", "TI"], "+", "3"}]]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9f5603cf-cd5d-4be8-98a1-1fd09c053792"],
 " matches them up in pairs. That is the acyclicity, in closed form."
}], "Text",ExpressionUUID->"e4c29bee-82a3-46cd-926c-a99703ca0f64"],

Cell["The nondegenerate quotient", "Section",ExpressionUUID->"f5a936d8-c694-441e-b44b-fcf087e99661"],

Cell[TextData[{
 "Dividing by ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["V", "TI"], 
    StyleBox["deg",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "41741cc3-e8bd-4bd8-b1cc-eefea8b657e3"],
 " leaves a finite-dimensional algebra on which the pairing is perfect: a \
Poincar\[EAcute] duality algebra, and, because the quotient map is a \
quasi-isomorphism, a differential Poincar\[EAcute] duality model of the \
original PDGA."
}], "Text",ExpressionUUID->"bf8f6bee-a3dd-4a43-9540-4d1e85a8e038"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"pd", " ", "=", " ", 
   RowBox[{"NondegenerateQuotient", "[", "model", "]"}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"pd", "[", "\"\<Basis\>\"", "]"}], ",", " ", 
   RowBox[{"pd", "[", "\"\<Degrees\>\"", "]"}]}], "}"}]}], "Input",
 CellLabel->
  "In[10]:= ",ExpressionUUID->"181a64d7-9f29-4715-9b0e-20232c566553"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", "a", ",", 
     SuperscriptBox["a", "2"]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "2", ",", "4"}], "}"}]}], "}"}]], "Output",
 CellLabel->
  "Out[10]= ",ExpressionUUID->"c540123d-87cd-4d70-b6cd-63d2738517e4"]
}, Open  ]],

Cell[TextData[{
 "For ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["CP",
     FontSlant->"Plain"], "2"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5c441671-6690-4716-9732-1290c907fa92"],
 " the quotient is the cohomology ring itself, with zero differential, as it \
must be, ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["CP",
     FontSlant->"Plain"], "2"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "617f9ba8-4a05-4a58-9479-c4a6e89e7836"],
 " being formal. The pairing is stored as a matrix in that basis, and it is \
invertible:"
}], "Text",ExpressionUUID->"5f83a699-60ac-4ec7-89a6-e08f4c53fe02"],

