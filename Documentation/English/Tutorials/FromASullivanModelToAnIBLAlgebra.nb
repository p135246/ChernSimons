}, Open  ]],

Cell[TextData[{
 "And it solves the Maurer-Cartan equation. That is not a formality: on a \
word of length three the equation reduces to ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["q", "TI"], 
     RowBox[{"2", ",", "1", ",", "0"}]], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["m", "TI"], "\[CircleDot]", 
      StyleBox["m", "TI"]}], ")"}], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fc0b40da-11a1-46cb-973f-293e1d860fa3"],
 ", which is associativity of the algebra written in these coordinates."
}], "Text",ExpressionUUID->"aca63eae-4af0-411e-9a43-3c5153ae90e3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"RelationsQ", "[", "m", "]"}]], "Input",
 CellLabel->
  "In[22]:= ",ExpressionUUID->"384e4cea-0440-46df-875f-3c8672c48b5a"],

Cell[BoxData["True"], "Output",
 CellLabel->
  "Out[22]= ",ExpressionUUID->"7a6f9406-0e22-4559-8aef-04ee31e15e01"]
}, Open  ]],

Cell[TextData[{
 "Twisting by it gives the dIBL algebra of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["CP",
     FontSlant->"Plain"], "2"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6a8e52a9-a826-4075-8b81-58b5845b7bf5"],
 ": the operations ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["q", "TI"], 
    RowBox[{"1", ",", "1", ",", "0"}], 
    StyleBox["m", "TI"]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "759eca88-67ac-4759-a4cc-231d9b14dcd3"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["q", "TI"], 
    RowBox[{"2", ",", "1", ",", "0"}]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "23a5a514-f159-46b1-b1d6-c0b773022f4a"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["q", "TI"], 
    RowBox[{"1", ",", "2", ",", "0"}]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7c7eb027-86c4-4ea3-9b39-37082d0bcdc0"],
 ", whose twisted homology is the cyclic cohomology of the Poincar\[EAcute] \
duality algebra. When the quotient keeps a differential, the chain-level \
operation ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["q", "TI"], 
    RowBox[{"1", ",", "1", ",", "0"}]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8e50d480-1e3b-4158-97dc-6cfd7e85fab4"],
 ", ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CyclicHochschildDifferential"]], 
    "paclet:ChernSimons/ref/CyclicHochschildDifferential", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "2f09222f-ab4e-4f54-8997-1f9421d6f4a3"],
 ", is nonzero before any twisting, and ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["q", "TI"], 
    RowBox[{"1", ",", "1", ",", "0"}], 
    StyleBox["m", "TI"]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "77394fa5-ff5e-4b9c-84a9-9b08fada8211"],
 " stacks the bracket with the element on top of it; ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["CP",
     FontSlant->"Plain"], "2"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a6e6db4d-5d5f-49ea-ab9c-b1dea04add0b"],
 ", being formal, has none."
}], "Text",ExpressionUUID->"fcae6762-e2fa-4482-9646-1a2356733b97"],

Cell["The whole catalogue", "Section",ExpressionUUID->"4d26941b-9fdc-44b3-93cc-b8908ee93e14"],

Cell[TextData[{
 "Every model in ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["$SullivanModels"]], "paclet:ChernSimons/ref/$SullivanModels", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "70066970-5604-418a-afdb-da0d7113a821"],
 " runs through the same five steps. The one exception is the last row, and \
it is the point of the next tutorial."
}], "Text",ExpressionUUID->"2b3b88d7-23e3-4074-b60c-26df5e189b0e"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"row", "[", "spec_", "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"md", " ", "=", " ", 
       RowBox[{"SullivanModel", "[", "spec", "]"}]}], "}"}], ",", "\n", "   ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"pq", " ", "=", " ", 
         RowBox[{"NondegenerateQuotient", "[", "md", "]"}]}], "}"}], ",", 
       "\n", "     ", 
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"pr", " ", "=", " ", 
           RowBox[{"GradedPairing", "[", "pq", "]"}]}], "}"}], ",", "\n", 
         "       ", 
         RowBox[{"<|", 
          RowBox[{
           RowBox[{"\"\<Model\>\"", " ", "->", " ", "spec"}], ",", " ", 
           RowBox[{"\"\<n\>\"", " ", "->", " ", 
            RowBox[{"md", "[", "\"\<Degree\>\"", "]"}]}], ",", " ", 
           RowBox[{"\"\<Hodge type\>\"", " ", "->", " ", 
            RowBox[{"HodgeTypeQ", "[", "md", "]"}]}], ",", "\n", "         ", 
           
           RowBox[{"\"\<dim Q\>\"", " ", "->", " ", 
            RowBox[{"Length", "[", 
             RowBox[{"pq", "[", "\"\<Basis\>\"", "]"}], "]"}]}], ",", "\n", 
           "         ", 
           RowBox[{"\"\<Maurer-Cartan\>\"", " ", "->", " ", 
            RowBox[{"RelationsQ", "[", 
             RowBox[{"CanonicalMaurerCartan", "[", "pr", "]"}], "]"}]}]}], 
          "|>"}]}], "]"}]}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"Dataset", "[", 
  RowBox[{"Map", "[", 
   RowBox[{"row", ",", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<Circle\>\"", ",", " ", 
      RowBox[{"\"\<Sphere\>\"", "[", "2", "]"}], ",", " ", 
      RowBox[{"\"\<Sphere\>\"", "[", "3", "]"}], ",", " ", 
      RowBox[{"\"\<ComplexProjectiveSpace\>\"", "[", "2", "]"}], ",", "\n", 
      "   ", 
      RowBox[{"\"\<ComplexProjectiveSpace\>\"", "[", "3", "]"}], ",", " ", 
      RowBox[{"\"\<QuaternionicProjectiveSpace\>\"", "[", "2", "]"}], ",", 
      " ", 
      RowBox[{"\"\<Torus\>\"", "[", "3", "]"}], ",", "\n", "   ", 
      RowBox[{"\"\<SpecialUnitaryGroup\>\"", "[", "3", "]"}], ",", 
      " ", "\"\<HeisenbergNilmanifold\>\"", ",", 
      " ", "\"\<KodairaThurston\>\"", ",", "\n", 
      "   ", "\"\<Degree4Obstruction\>\""}], "}"}]}], "]"}], "]"}]}], "Input",\

 CellLabel->
  "In[23]:= ",ExpressionUUID->"b907277f-728c-4503-b213-4f101b8495b7"],

