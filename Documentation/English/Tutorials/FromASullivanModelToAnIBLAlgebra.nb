   RowBox[{
    RowBox[{"{", 
     RowBox[{"3", ",", "1", ",", "1"}], "}"}], "\[Rule]", "1"}]}], 
  "}"}]], "Output",
 CellLabel->
  "Out[13]= ",ExpressionUUID->"697b8c3f-ef5a-430c-ac1b-436c22852eeb"]
}, Open  ]],

Cell["The dual pairing, and the alphabet", "Section",ExpressionUUID->"24bfb478-97a8-4d15-9b2e-ebc91eaa3739"],

Cell[TextData[{
 "Shifting the quotient down by one turns the graded symmetric pairing of \
degree ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "559a0b80-a85d-45eb-9dbe-3a8b1da7fffb"],
 " into a graded antisymmetric pairing of degree ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["n", "TI"], "-", "2"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "32ce16d2-33db-4a15-a128-75abffa68160"],
 ", which is what the IBL operations want. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["GradedPairing"]], "paclet:ChernSimons/ref/GradedPairing", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "24716467-4872-464b-b430-94f71bcf44e5"],
 " applied to the algebra does exactly that, taking the basis monomials as \
the particles of the alphabet."
}], "Text",ExpressionUUID->"14d6664c-a3ed-4745-bf9c-afb4b3acadf9"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"pairing", " ", "=", " ", 
   RowBox[{"GradedPairing", "[", "pd", "]"}]}], ";"}], "\n", 
 RowBox[{"Normal", "[", 
  RowBox[{"pairing", "[", "\"\<Degrees\>\"", "]"}], "]"}]}], "Input",
 CellLabel->
  "In[14]:= ",ExpressionUUID->"857f5e4b-fddc-47a7-add9-57291328ad32"],

