Cell["The bracket glues two words by pairing one letter of each:", "Text",ExpressionUUID->"d989be4c-edab-4382-8e69-ac8797256e83"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"CanonicalLieBracket", "[", 
  RowBox[{
   RowBox[{"CyclicWord", "[", 
    RowBox[{"{", 
     RowBox[{"1", ",", " ", "a"}], "}"}], "]"}], ",", " ", 
   RowBox[{"CyclicWord", "[", 
    RowBox[{"{", 
