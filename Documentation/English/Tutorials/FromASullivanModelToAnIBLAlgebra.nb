Cell[TextData[{
 "The triple products ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["O", "TI"], "(", 
    RowBox[{
     SubscriptBox[
      StyleBox["e", "TI"], 
      StyleBox["i", "TI"]], 
     SubscriptBox[
      StyleBox["e", "TI"], 
      StyleBox["j", "TI"]], 
     SubscriptBox[
      StyleBox["e", "TI"], 
      StyleBox["k", "TI"]]}], ")"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6b26a1ba-06df-4cf9-9e9d-b43558c7b2a4"],
 " are what the Maurer-Cartan element below is built from; they are kept as \
an Association on the index triples, the zero ones dropped."
}], "Text",ExpressionUUID->"b5b244f3-f103-4c9b-adc8-434618414278"],

