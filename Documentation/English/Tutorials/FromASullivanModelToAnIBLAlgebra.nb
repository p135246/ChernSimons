Cell[TextData[{
 "Its symmetric degree is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", "(", 
    RowBox[{
     StyleBox["n", "TI"], "-", "3"}], ")"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"e38c3abf-79fd-4adf-aa6f-a338a0149d53"],
 ", which is the degree of ",
 Cell[BoxData[
  FormBox["\[HBar]", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "96fe9d26-8f7a-47c5-928a-a5365d7b30b4"],
 " and so of a BD action:"
}], "Text",ExpressionUUID->"5cddeb4f-9690-4465-9799-03570b5f94a4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"ElementDegree", "[", 
    RowBox[{
     RowBox[{"CyclicWord", "[", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "1", ",", " ", 
        RowBox[{"a", "^", "2"}]}], "}"}], "]"}], ",", " ", "pairing", ",", 
     " ", "\"\<Symmetric\>\""}], "]"}], ",", " ", 
   RowBox[{"ElementDegree", "[", 
    RowBox[{"HBar", ",", " ", "pairing", ",", " ", "\"\<Symmetric\>\""}], 
    "]"}]}], "}"}]], "Input",
 CellLabel->
