 CellLabel->
  "Out[21]= ",ExpressionUUID->"04f2d56a-c6f8-406d-9a62-e55de6f0a10f"]
}, Open  ]],

Cell[TextData[{
 "And it solves the Maurer-Cartan equation. That is not a formality: on a \
word of length three the equation reduces to ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["q", "TI"], 
     RowBox[{"2", ",", "1", ",", "0"}]], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["m", "TI"], "\[CircleDot]", 
      StyleBox["m", "TI"]}], ")"}], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "94e150e0-aaf7-4789-ba83-e61ed738849a"],
 ", which is associativity of the algebra written in these coordinates."
}], "Text",ExpressionUUID->"83271497-725a-40bd-a01e-3ca364720443"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"RelationsQ", "[", "m", "]"}]], "Input",
 CellLabel->
  "In[22]:= ",ExpressionUUID->"49ac88a8-2224-45b6-b155-f47892ab393b"],

Cell[BoxData["True"], "Output",
 CellLabel->
  "Out[22]= ",ExpressionUUID->"237a72ec-4e4b-4ea7-b6f5-6519352747ff"]
}, Open  ]],

Cell[TextData[{
 "Twisting by it gives the dIBL algebra of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["CP",
     FontSlant->"Plain"], "2"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bcf85899-f621-43b4-88ee-aa078bef61c6"],
 ": the operations ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["q", "TI"], 
    RowBox[{"1", ",", "1", ",", "0"}], 
    StyleBox["m", "TI"]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5ea7141b-f17e-4cac-a018-87aceae194a3"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["q", "TI"], 
    RowBox[{"2", ",", "1", ",", "0"}]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "67d3c0a1-0467-4cba-bf1e-5a034fdd52ff"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["q", "TI"], 
    RowBox[{"1", ",", "2", ",", "0"}]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "18b0887b-91e0-4fbb-ad33-5300aba5d9a7"],
 ", whose twisted homology is the cyclic cohomology of the Poincar\[EAcute] \
duality algebra. When the quotient keeps a differential, the chain-level \
operation ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["q", "TI"], 
    RowBox[{"1", ",", "1", ",", "0"}]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dd90dc9a-d246-4301-b800-65c15b66e7a6"],
 ", ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CyclicHochschildDifferential"]], 
    "paclet:ChernSimons/ref/CyclicHochschildDifferential", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "d9d8b4e7-84df-4568-bba8-099e82ab1108"],
 ", is nonzero before any twisting, and ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["q", "TI"], 
    RowBox[{"1", ",", "1", ",", "0"}], 
    StyleBox["m", "TI"]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "be43558f-adeb-4756-9e4e-b71207eb8563"],
 " stacks the bracket with the element on top of it; ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["CP",
     FontSlant->"Plain"], "2"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c65f702f-40b5-4202-8265-6251114f0de7"],
 ", being formal, has none."
}], "Text",ExpressionUUID->"150c8267-12c4-4cb9-8239-7f980c0281d5"],

Cell["The whole catalogue", "Section",ExpressionUUID->"aee9d6ec-a591-44ce-af5a-3439702b8810"],

Cell[TextData[{
 "Every model in ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["$SullivanModels"]], "paclet:ChernSimons/ref/$SullivanModels", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "b033cb74-f7f3-492d-85a7-547189f8bdea"],
 " runs through the same five steps. The one exception is the last row, and \
it is the point of the next tutorial."
}], "Text",ExpressionUUID->"6b93a40f-cc60-4ac9-8a04-1686359ac74a"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"row", "[", "spec_", "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"md", " ", "=", " ", 
       RowBox[{"SullivanModel", "[", "spec", "]"}]}], "}"}], ",", "\n", "   ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"pq", " ", "=", " ", 
         RowBox[{"NondegenerateQuotient", "[", "md", "]"}]}], "}"}], ",", 
       "\n", "     ", 
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"pr", " ", "=", " ", 
           RowBox[{"GradedPairing", "[", "pq", "]"}]}], "}"}], ",", "\n", 
         "       ", 
         RowBox[{"<|", 
          RowBox[{
           RowBox[{"\"\<Model\>\"", " ", "->", " ", "spec"}], ",", " ", 
           RowBox[{"\"\<n\>\"", " ", "->", " ", 
            RowBox[{"md", "[", "\"\<Degree\>\"", "]"}]}], ",", " ", 
           RowBox[{"\"\<Hodge type\>\"", " ", "->", " ", 
            RowBox[{"HodgeTypeQ", "[", "md", "]"}]}], ",", "\n", "         ", 
           
           RowBox[{"\"\<dim Q\>\"", " ", "->", " ", 
            RowBox[{"Length", "[", 
             RowBox[{"pq", "[", "\"\<Basis\>\"", "]"}], "]"}]}], ",", "\n", 
           "         ", 
           RowBox[{"\"\<Maurer-Cartan\>\"", " ", "->", " ", 
            RowBox[{"RelationsQ", "[", 
             RowBox[{"CanonicalMaurerCartan", "[", "pr", "]"}], "]"}]}]}], 
          "|>"}]}], "]"}]}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"Dataset", "[", 
  RowBox[{"Map", "[", 
   RowBox[{"row", ",", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<Circle\>\"", ",", " ", 
      RowBox[{"\"\<Sphere\>\"", "[", "2", "]"}], ",", " ", 
      RowBox[{"\"\<Sphere\>\"", "[", "3", "]"}], ",", " ", 
      RowBox[{"\"\<ComplexProjectiveSpace\>\"", "[", "2", "]"}], ",", "\n", 
      "   ", 
      RowBox[{"\"\<ComplexProjectiveSpace\>\"", "[", "3", "]"}], ",", " ", 
      RowBox[{"\"\<QuaternionicProjectiveSpace\>\"", "[", "2", "]"}], ",", 
      " ", 
      RowBox[{"\"\<Torus\>\"", "[", "3", "]"}], ",", "\n", "   ", 
      RowBox[{"\"\<SpecialUnitaryGroup\>\"", "[", "3", "]"}], ",", 
      " ", "\"\<HeisenbergNilmanifold\>\"", ",", 
      " ", "\"\<KodairaThurston\>\"", ",", "\n", 
      "   ", "\"\<Degree4Obstruction\>\""}], "}"}]}], "]"}], "]"}]}], "Input",\

 CellLabel->
  "In[23]:= ",ExpressionUUID->"7ef15188-2c21-4ddd-9bd6-f68d82cb1476"],

