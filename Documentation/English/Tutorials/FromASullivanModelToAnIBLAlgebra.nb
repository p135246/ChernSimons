Cell["\<\
The four defining identities of an involutive bi-Lie algebra hold, as they \
must for any alphabet with a graded antisymmetric pairing:\
\>", "Text",ExpressionUUID->"6554274d-8dca-46de-974e-755342427a55"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"u", " ", "=", " ", 
      RowBox[{"CyclicWord", "[", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "a"}], "}"}], "]"}]}], ",", " ", 
     RowBox[{"v", " ", "=", " ", 
      RowBox[{"CyclicWord", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"a", "^", "2"}], ",", " ", "a"}], "}"}], "]"}]}]}], "}"}], ",",
    "\n", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"JacobiObstruction", "[", 
      RowBox[{"u", ",", " ", "v", ",", " ", "u", ",", " ", "pairing"}], "]"}],
      ",", " ", 
     RowBox[{"CoJacobiObstruction", "[", 
      RowBox[{"u", ",", " ", "pairing"}], "]"}], ",", " ", 
     RowBox[{"DrinfeldObstruction", "[", 
      RowBox[{"u", ",", " ", "v", ",", " ", "pairing"}], "]"}], ",", " ", 
     RowBox[{"InvolutivityObstruction", "[", 
      RowBox[{"u", ",", " ", "pairing"}], "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->
  "In[19]:= ",ExpressionUUID->"d130b6f8-437f-49cb-8d24-81ad4c09ce21"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0", ",", "0", ",", "0", ",", "0"}], "}"}]], "Output",
 CellLabel->
  "Out[19]= ",ExpressionUUID->"7311c8df-d936-450b-b305-ee09ef540b76"]
}, Open  ]],

Cell["The canonical Maurer-Cartan element", "Section",ExpressionUUID->"f1a89ae8-3a09-4673-a216-45c702f9706c"],

Cell["\<\
The triple product of the Poincar\[EAcute] duality algebra is a cyclic \
three-cochain, so it is an element of the cyclic words of length three. \
Written in a basis it is\
\>", "Text",ExpressionUUID->"2db0132e-5b6f-4d3f-b1ec-f03edae3d3f3"],

Cell[BoxData[
 PaneBox[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["m", "TI"], 
     RowBox[{"1", ",", "0"}], 
     StyleBox["can",
      FontSlant->"Plain"]], "\[LongEqual]", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"-", "1"}], ")"}], 
     RowBox[{
      StyleBox["n", "TI"], "-", "2"}]], 
    FractionBox["1", "3"], 
    UnderscriptBox["\[Sum]", 
     RowBox[{
      StyleBox["i", "TI"], ",", 
      StyleBox["j", "TI"], ",", 
      StyleBox["k", "TI"]}],
     LimitsPositioning->True], 
    RowBox[{"\[PlusMinus]", " "}], 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"-", "1"}], ")"}], 
     RowBox[{"deg", 
      SubscriptBox[
       StyleBox["e", "TI"], 
       StyleBox["j", "TI"]]}]], " ", 
    StyleBox["O", "TI"], 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox[
       StyleBox["e", "TI"], 
       StyleBox["i", "TI"]], 
      SubscriptBox[
       StyleBox["e", "TI"], 
       StyleBox["j", "TI"]], 
      SubscriptBox[
       StyleBox["e", "TI"], 
       StyleBox["k", "TI"]]}], ")"}], " ", 
    SuperscriptBox[
     StyleBox["e", "TI"], 
     StyleBox["i", "TI"]], 
    SuperscriptBox[
     StyleBox["e", "TI"], 
     StyleBox["j", "TI"]], 
    SuperscriptBox[
     StyleBox["e", "TI"], 
     StyleBox["k", "TI"]], ","}],
   TraditionalForm],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",ExpressionUUID->"71cdbd80-d88e-4f2e-\
b5dd-3311050eef80"],

Cell[TextData[{
 "the ",
 Cell[BoxData[
  FormBox["\[PlusMinus]", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "85a187b1-4689-4d37-a835-e0c9489c489f"],
 " being the reversal sign. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CanonicalMaurerCartan"]], 
    "paclet:ChernSimons/ref/CanonicalMaurerCartan", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "9bc912fe-e77d-4059-9bd2-07b2c04ea48f"],
 " evaluates it."
}], "Text",ExpressionUUID->"4a36b19e-f8ed-41c4-ba57-69cd87aa9c27"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"m", " ", "=", " ", 
  RowBox[{"CanonicalMaurerCartan", "[", "pairing", "]"}]}]], "Input",
 CellLabel->
  "In[20]:= ",ExpressionUUID->"e27b638f-01e2-4713-964f-5aba0b453e59"],

