Cell[TextData[{
 "Here ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["V", "TI"], 
    StyleBox["deg",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "65ad7831-67ec-4548-95f4-e91bd155f304"],
 " is spanned by ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["b", "TI"], ",", 
    StyleBox["a", "TI"], 
    StyleBox["b", "TI"], ",", 
    SuperscriptBox[
     StyleBox["a", "TI"], "2"], 
    StyleBox["b", "TI"], ",", "\[Ellipsis]"}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6fbcfdf1-9d39-4233-8caa-a599c7829053"],
 " together with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["a", "TI"], "3"], ",", 
    SuperscriptBox[
     StyleBox["a", "TI"], "4"], ",", "\[Ellipsis]"}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2166f5e6-43fe-4bf9-9706-cf9d88d8a9f5"],
 ", and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["d",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox[
       StyleBox["a", "TI"], 
       StyleBox["k", "TI"]], 
      StyleBox["b", "TI"]}], ")"}], "\[LongEqual]", 
    SuperscriptBox[
     StyleBox["a", "TI"], 
     RowBox[{
      StyleBox["k", "TI"], "+", "3"}]]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0cadcbf1-016a-40fe-be89-4080a92252b1"],
 " matches them up in pairs \[LongDash] that is the acyclicity, in closed \
form."
}], "Text",ExpressionUUID->"64e7ee76-27dc-4717-adef-471ecda58234"],

Cell["The nondegenerate quotient", "Section",ExpressionUUID->"0587a978-20fc-40c7-998f-7c489df28d34"],

Cell[TextData[{
 "Dividing by ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["V", "TI"], 
    StyleBox["deg",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9792f488-7159-4860-9ead-509343bc1846"],
 " leaves a finite-dimensional algebra on which the pairing is perfect: a \
Poincar\[EAcute] duality algebra, and \[LongDash] because the quotient map is \
a quasi-isomorphism \[LongDash] a differential Poincar\[EAcute] duality model \
of the original PDGA."
}], "Text",ExpressionUUID->"69022f45-f3d3-4127-89ed-33041a823c36"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"pd", " ", "=", " ", 
   RowBox[{"NondegenerateQuotient", "[", "model", "]"}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"pd", "[", "\"\<Basis\>\"", "]"}], ",", " ", 
   RowBox[{"pd", "[", "\"\<Degrees\>\"", "]"}]}], "}"}]}], "Input",
 CellLabel->
  "In[10]:= ",ExpressionUUID->"d8198762-3cb2-46f0-bd8d-bea45fe208d8"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", "a", ",", 
     SuperscriptBox["a", "2"]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "2", ",", "4"}], "}"}]}], "}"}]], "Output",
 CellLabel->
  "Out[10]= ",ExpressionUUID->"369bb889-77ab-4e10-944a-d6b05f9249a0"]
}, Open  ]],

Cell[TextData[{
 "For ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["CP",
     FontSlant->"Plain"], "2"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b6463a4a-eb1d-40d2-bd70-032e06b36f59"],
 " the quotient is the cohomology ring itself, with zero differential \
\[LongDash] as it must be, ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["CP",
     FontSlant->"Plain"], "2"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "36b17e1a-4559-405b-9b9a-c0f981343c26"],
 " being formal. The pairing is stored as a matrix in that basis, and it is \
invertible:"
}], "Text",ExpressionUUID->"9248c646-55d0-4de7-8a2c-dfc09188df5d"],

Cell[CellGroupData[{

