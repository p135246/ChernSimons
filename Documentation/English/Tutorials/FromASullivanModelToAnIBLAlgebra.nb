 RowBox[{"{", 
  RowBox[{"2", ",", "2"}], "}"}]], "Output",
 CellLabel->
  "Out[21]= ",ExpressionUUID->"f16ffcff-60b0-4c37-be52-c5e34c529505"]
}, Open  ]],

Cell[TextData[{
 "And it solves the Maurer-Cartan equation. That is not a formality: on a \
word of length three the equation reduces to ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["q", "TI"], 
     RowBox[{"2", ",", "1", ",", "0"}]], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["m", "TI"], "\[CircleDot]", 
      StyleBox["m", "TI"]}], ")"}], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7ec9fd48-00d2-41d7-8140-d1923bc909e6"],
 ", which is associativity of the algebra written in these coordinates."
}], "Text",ExpressionUUID->"1a40e3ff-49c6-4ffa-9e6b-72dde30a318e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"MaurerCartanQ", "[", 
  RowBox[{"m", ",", " ", "pairing"}], "]"}]], "Input",
 CellLabel->
  "In[22]:= ",ExpressionUUID->"9df63828-a97e-49f2-9062-17556f81697d"],

Cell[BoxData["True"], "Output",
 CellLabel->
  "Out[22]= ",ExpressionUUID->"8a1cb9e8-b2b3-414a-966c-caa5bb8b9731"]
}, Open  ]],

Cell[TextData[{
 "Twisting by it gives the dIBL algebra of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["CP",
     FontSlant->"Plain"], "2"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "326f564d-c5b4-497c-8668-9d8e70cae065"],
 ": the operations ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["q", "TI"], 
    RowBox[{"1", ",", "1", ",", "0"}], 
    StyleBox["m", "TI"]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0fcd655f-2c71-4a00-b89d-bec945a949ab"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["q", "TI"], 
    RowBox[{"2", ",", "1", ",", "0"}]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ee83ef7b-c955-4fe1-b723-555d74c483d1"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["q", "TI"], 
    RowBox[{"1", ",", "2", ",", "0"}]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ba1b7f59-f24c-4ffa-815b-25206ed873c4"],
 ", whose twisted homology is the cyclic cohomology of the Poincar\[EAcute] \
duality algebra. When the quotient keeps a differential, the chain-level \
operation ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["q", "TI"], 
    RowBox[{"1", ",", "1", ",", "0"}]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4df2d67c-291e-4a2b-b5f8-c8af9f64237b"],
 " \[LongDash] ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CyclicDifferential"]], 
    "paclet:ChernSimons/ref/CyclicDifferential", "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "50567b7d-68df-4811-8632-4ffcf6dccbe4"],
 " \[LongDash] is nonzero before any twisting, and ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["q", "TI"], 
    RowBox[{"1", ",", "1", ",", "0"}], 
    StyleBox["m", "TI"]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a4fdf94c-ab48-4272-9e75-e13a7042487a"],
 " stacks the bracket with the element on top of it; ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["CP",
     FontSlant->"Plain"], "2"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d50fc4da-d5a9-4215-8427-7b182a8f1015"],
 ", being formal, has none."
}], "Text",ExpressionUUID->"8fee75b7-c7e4-44cf-b13a-898cbafe8a2c"],

Cell["The whole catalogue", "Section",ExpressionUUID->"39e9f747-20e2-4b42-bcd0-3de46c726b19"],

Cell[TextData[{
 "Every model in ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["$SullivanModels"]], "paclet:ChernSimons/ref/$SullivanModels", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "1d753698-b8ca-429a-9aa9-050dccab4f79"],
 " runs through the same five steps. The one exception is the last row, and \
it is the point of the next tutorial."
}], "Text",ExpressionUUID->"02ea3ee6-e3ea-4422-ba1d-52330328a87f"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"row", "[", "spec_", "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"md", " ", "=", " ", 
       RowBox[{"SullivanModel", "[", "spec", "]"}]}], "}"}], ",", "\n", "   ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"pq", " ", "=", " ", 
         RowBox[{"NondegenerateQuotient", "[", "md", "]"}]}], "}"}], ",", 
       "\n", "     ", 
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"pr", " ", "=", " ", 
           RowBox[{"GradedPairing", "[", "pq", "]"}]}], "}"}], ",", "\n", 
         "       ", 
         RowBox[{"<|", 
          RowBox[{
           RowBox[{"\"\<Model\>\"", " ", "->", " ", "spec"}], ",", " ", 
           RowBox[{"\"\<n\>\"", " ", "->", " ", 
            RowBox[{"md", "[", "\"\<Degree\>\"", "]"}]}], ",", " ", 
           RowBox[{"\"\<Hodge type\>\"", " ", "->", " ", 
            RowBox[{"HodgeTypeQ", "[", "md", "]"}]}], ",", "\n", "         ", 
           
           RowBox[{"\"\<dim Q\>\"", " ", "->", " ", 
            RowBox[{"Length", "[", 
             RowBox[{"pq", "[", "\"\<Basis\>\"", "]"}], "]"}]}], ",", "\n", 
           "         ", 
           RowBox[{"\"\<Maurer-Cartan\>\"", " ", "->", " ", 
            RowBox[{"MaurerCartanQ", "[", 
             RowBox[{
              RowBox[{"CanonicalMaurerCartan", "[", "pr", "]"}], ",", " ", 
              "pr"}], "]"}]}]}], "|>"}]}], "]"}]}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"Dataset", "[", 
  RowBox[{"Map", "[", 
   RowBox[{"row", ",", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<Circle\>\"", ",", " ", 
      RowBox[{"\"\<Sphere\>\"", "[", "2", "]"}], ",", " ", 
      RowBox[{"\"\<Sphere\>\"", "[", "3", "]"}], ",", " ", 
      RowBox[{"\"\<ComplexProjectiveSpace\>\"", "[", "2", "]"}], ",", "\n", 
      "   ", 
      RowBox[{"\"\<ComplexProjectiveSpace\>\"", "[", "3", "]"}], ",", " ", 
      RowBox[{"\"\<QuaternionicProjectiveSpace\>\"", "[", "2", "]"}], ",", 
      " ", 
      RowBox[{"\"\<Torus\>\"", "[", "3", "]"}], ",", "\n", "   ", 
      RowBox[{"\"\<SpecialUnitaryGroup\>\"", "[", "3", "]"}], ",", 
      " ", "\"\<HeisenbergNilmanifold\>\"", ",", 
      " ", "\"\<KodairaThurston\>\"", ",", "\n", 
      "   ", "\"\<Degree4Obstruction\>\""}], "}"}]}], "]"}], "]"}]}], "Input",\

 CellLabel->
  "In[23]:= ",ExpressionUUID->"cd39b5a3-f94d-43ea-910a-b5605ba66ff6"],

