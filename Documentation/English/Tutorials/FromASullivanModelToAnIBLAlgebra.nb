 CellLabel->
  "In[20]:= ",ExpressionUUID->"0973f0f7-5c8e-4935-aabb-9f847045e015"],

Cell[BoxData[
 RowBox[{
  RowBox[{"-", 
   InterpretationBox[
    RowBox[{"(", 
