Cell[TextData[{
 "The triple products ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["O", "TI"], "(", 
    RowBox[{
     SubscriptBox[
      StyleBox["e", "TI"], 
      StyleBox["i", "TI"]], 
     SubscriptBox[
      StyleBox["e", "TI"], 
      StyleBox["j", "TI"]], 
     SubscriptBox[
      StyleBox["e", "TI"], 
      StyleBox["k", "TI"]]}], ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"c5b53abe-110c-40aa-bf28-ef0c633d55b3"],
 " are what the Maurer-Cartan element below is built from; they are kept as \
an Association on the index triples, the zero ones dropped."
}], "Text",ExpressionUUID->"9060bf9c-233e-41fe-920c-9ae1d3bdb43b"],

