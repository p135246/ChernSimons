   RowBox[{
    RowBox[{"{", 
     RowBox[{"3", ",", "1", ",", "1"}], "}"}], "\[Rule]", "1"}]}], 
  "}"}]], "Output",
 CellLabel->
  "Out[13]= ",ExpressionUUID->"d089c4fe-a5a4-41d1-a566-89f2d2c7de66"]
}, Open  ]],

Cell["The dual pairing, and the alphabet", "Section",ExpressionUUID->"c2ddac2f-5c20-4094-b54d-b219119572c9"],

Cell[TextData[{
 "Shifting the quotient down by one turns the graded symmetric pairing of \
degree ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fc2c337b-3cdb-441a-ad13-c912da1a6d24"],
 " into a graded antisymmetric pairing of degree ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["n", "TI"], "-", "2"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ace86012-b786-42bf-9213-105bdd64156f"],
 ", which is what the IBL operations want. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["GradedPairing"]], "paclet:ChernSimons/ref/GradedPairing", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "e09943b2-e5ae-460d-9602-6091dd487f59"],
 " applied to the algebra does exactly that, taking the basis monomials as \
the particles of the alphabet."
}], "Text",ExpressionUUID->"d52c20cb-bb85-4891-aecc-1c1b85aae99e"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"pairing", " ", "=", " ", 
   RowBox[{"GradedPairing", "[", "pd", "]"}]}], ";"}], "\n", 
 RowBox[{"Normal", "[", 
  RowBox[{"pairing", "[", "\"\<Degrees\>\"", "]"}], "]"}]}], "Input",
 CellLabel->
  "In[14]:= ",ExpressionUUID->"f6c10ff1-a590-4b43-a663-1490c7345c35"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"1", "\[Rule]", 
    RowBox[{"-", "1"}]}], ",", 
   RowBox[{"a", "\[Rule]", "1"}], ",", 
   RowBox[{
    SuperscriptBox["a", "2"], "\[Rule]", "3"}]}], "}"}]], "Output",
 CellLabel->
  "Out[14]= ",ExpressionUUID->"534fc551-624c-4717-a7a6-44a2eddf98df"]
}, Open  ]],

