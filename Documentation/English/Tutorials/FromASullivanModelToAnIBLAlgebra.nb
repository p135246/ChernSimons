Cell[TextData[{
 "The triple products ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["O", "TI"], "(", 
    RowBox[{
     SubscriptBox[
      StyleBox["e", "TI"], 
      StyleBox["i", "TI"]], 
     SubscriptBox[
      StyleBox["e", "TI"], 
      StyleBox["j", "TI"]], 
     SubscriptBox[
      StyleBox["e", "TI"], 
      StyleBox["k", "TI"]]}], ")"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "152242a4-215a-420d-acb4-ee3a380aff7a"],
 " are what the Maurer-Cartan element below is built from; they are kept as \
an Association on the index triples, the zero ones dropped."
}], "Text",ExpressionUUID->"bc44a90f-d425-4a1c-b34e-ca8732ca5a08"],

