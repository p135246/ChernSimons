Cell[TextData[{
 "Here ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["V", "TI"], 
    StyleBox["deg",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "3305d41d-51ae-4663-9015-3ab4413533e4"],
 " is spanned by ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["b", "TI"], ",", 
    StyleBox["a", "TI"], 
    StyleBox["b", "TI"], ",", 
    SuperscriptBox[
     StyleBox["a", "TI"], "2"], 
    StyleBox["b", "TI"], ",", "\[Ellipsis]"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"6ed56143-8316-4d8c-84fe-5934afe28c2d"],
 " together with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["a", "TI"], "3"], ",", 
    SuperscriptBox[
     StyleBox["a", "TI"], "4"], ",", "\[Ellipsis]"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"49b25034-9690-421e-8a34-4417d42ae366"],
 ", and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["d",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox[
       StyleBox["a", "TI"], 
       StyleBox["k", "TI"]], 
      StyleBox["b", "TI"]}], ")"}], "\[LongEqual]", 
    SuperscriptBox[
     StyleBox["a", "TI"], 
     RowBox[{
      StyleBox["k", "TI"], "+", "3"}]]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"e6a4d6be-b93a-423d-a8c5-17ba2c8c6cfc"],
 " matches them up in pairs. That is the acyclicity, in closed form."
}], "Text",ExpressionUUID->"676c1371-d9df-402a-a8a1-93346b7649be"],

Cell["The nondegenerate quotient", "Section",ExpressionUUID->"35002852-5c36-4792-83f4-c21f29844290"],

Cell[TextData[{
 "Dividing by ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["V", "TI"], 
    StyleBox["deg",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "6a98fac4-5c04-43a5-814a-01efac8f0712"],
 " leaves a finite-dimensional algebra on which the pairing is perfect: a \
Poincar\[EAcute] duality algebra, and, because the quotient map is a \
quasi-isomorphism, a differential Poincar\[EAcute] duality model of the \
original PDGA."
}], "Text",ExpressionUUID->"e81e4ce8-7a64-4066-a8b0-36ce96ccc17b"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"pd", " ", "=", " ", 
   RowBox[{"NondegenerateQuotient", "[", "model", "]"}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"pd", "[", "\"\<Basis\>\"", "]"}], ",", " ", 
   RowBox[{"pd", "[", "\"\<Degrees\>\"", "]"}]}], "}"}]}], "Input",
 CellLabel->
  "In[10]:= ",ExpressionUUID->"e75a961c-52bf-47b2-a191-d5fbdf815b9f"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", "a", ",", 
     SuperscriptBox["a", "2"]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "2", ",", "4"}], "}"}]}], "}"}]], "Output",
 CellLabel->
  "Out[10]= ",ExpressionUUID->"354fb85f-0f9e-46be-bdd2-e2e52d941d28"]
}, Open  ]],

Cell[TextData[{
 "For ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["CP",
     FontSlant->"Plain"], "2"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"0ae33101-594a-4056-b975-8243855537c4"],
 " the quotient is the cohomology ring itself, with zero differential, as it \
must be, ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["CP",
     FontSlant->"Plain"], "2"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"8d7c76d6-4214-43dc-8cf1-5d7ff4e7b1c6"],
 " being formal. The pairing is stored as a matrix in that basis, and it is \
invertible:"
}], "Text",ExpressionUUID->"4152d6fe-396b-4996-aad5-c74e4a5e2059"],

