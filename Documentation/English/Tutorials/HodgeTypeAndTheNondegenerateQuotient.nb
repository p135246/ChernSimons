Cell[TextData[{
 "Every row has ",
 Cell[BoxData[
 "Degenerate"], "InlineFormula",ExpressionUUID->
  "43ffc045-c1a6-4b9b-88ec-48ff1cf2183f"],
 " zero and ",
 Cell[BoxData[
 "Dimension"], "InlineFormula",ExpressionUUID->
  "19051fd0-69f8-4633-b461-305c959df0ad"],
 " equal to ",
 Cell[BoxData[
 "Quotient"], "InlineFormula",ExpressionUUID->
  "eb3d8eaf-eb0a-421b-b239-b6350e792c0f"],
 ": the model ",
 StyleBox["is", "TI"],
 " its own nondegenerate quotient, an eight-dimensional differential Poincar\
\[EAcute] duality algebra of degree ",
 Cell[BoxData[
  FormBox["3", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "28c4ffbb-93e3-47f2-aa0f-dc388b86a251"],
 ". The Betti numbers ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", ",", "2", ",", "2", ",", "1"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"723144d2-957a-415b-b304-fc6c45ccd31a"],
 " read off the ",
 Cell[BoxData[
 "Cohomology"], "InlineFormula",ExpressionUUID->
  "c5d2c82c-06d2-4f58-adb5-b221c938d57f"],
 " column and are symmetric, as Poincar\[EAcute] duality demands."
}], "Text",ExpressionUUID->"1e0dda81-ec72-4675-8bb4-3222f2e943e8"],

Cell[TextData[{
 "Unlike ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["CP",
     FontSlant->"Plain"], 
    StyleBox["m", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "42ba4c24-29be-4c2b-97d1-e39bd1614d19"],
 ", this quotient carries a nonzero differential, because the nilmanifold is \
not formal:"
}], "Text",ExpressionUUID->"301b0cdb-a155-4723-93eb-292912c5a12f"],

