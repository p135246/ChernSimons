   RowBox[{"heis", "[", "\"\<Orientation\>\"", "]"}], ",", " ", 
   RowBox[{"SullivanModelDifferential", "[", 
    RowBox[{"z", ",", " ", "heis"}], "]"}]}], "}"}]}], "Input",
 CellLabel->"In[9]:= ",ExpressionUUID->"684c84bd-4c7c-43bd-9178-b9fa163776a7"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"x", "\[Rule]", "1"}], ",", 
     RowBox[{"y", "\[Rule]", "1"}], ",", 
     RowBox[{"z", "\[Rule]", "1"}]}], "}"}], ",", 
   RowBox[{"\[LeftAssociation]", 
    RowBox[{
     RowBox[{"x", " ", "y", " ", "z"}], "\[Rule]", "1"}], 
    "\[RightAssociation]"}], ",", 
   RowBox[{"x", " ", "y"}]}], "}"}]], "Output",
 CellLabel->"Out[9]= ",ExpressionUUID->"6f72b8f9-0181-4fac-941a-f6257c4cb9c9"]
}, Open  ]],

