Notebook[{

Cell[CellGroupData[{
Cell["Hodge Type and the Nondegenerate Quotient", "Title",
 CellID->509267359,ExpressionUUID->"4ddb5767-1f00-4973-a411-49eacd07850d"],

Cell[TextData[{
 "An oriented PDGA ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     StyleBox["V", "TI"], ",", 
     StyleBox["d",
      FontSlant->"Plain"], ",", 
     StyleBox["O", "TI"]}], ")"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f5d06382-f90c-4bac-bb15-9202a4eb7c63"],
 " satisfies Poincar\[EAcute] duality on cohomology but almost never on chain \
level. The construction that repairs this divides out the part of ",
 Cell[BoxData[
  FormBox[
   StyleBox["V", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5e508701-7d6a-46f5-8935-90b7e6d047f5"],
 " that the pairing cannot see, and the question is whether the division \
loses cohomology. It does not exactly when ",
 Cell[BoxData[
  FormBox[
   StyleBox["V", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "000410bc-24ca-489a-9f12-02bc45337969"],
 " is ",
 StyleBox["of Hodge type", "TI"],
 ". This tutorial is about that test: what it computes, in which degrees, and \
what it looks like when it fails."
}], "Text",ExpressionUUID->"faae6687-e786-4ef5-a546-0ea07446c6be"],

Cell[TextData[{
 "The reference is ",
 ButtonBox["arXiv:2004.07362",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://arxiv.org/abs/2004.07362"], None}],
 ", ",
 StyleBox["Hodge decompositions and Poincar\[EAcute] duality models", "TI"],
 "."
}], "Text",ExpressionUUID->"e108c25d-935a-4338-a769-ce8ffbb6b5e9"],

Cell["Three subspaces", "Section",ExpressionUUID->"1e9b7369-346b-43d0-8d9a-eecd971e6d9c"],

Cell[TextData[{
 "Write ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{
      SubscriptBox[
       StyleBox["v", "TI"], "1"], ",", 
      SubscriptBox[
       StyleBox["v", "TI"], "2"]}], "\[RightAngleBracket]"}], "\[LongEqual]", 
    
    StyleBox["O", "TI"], 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox[
       StyleBox["v", "TI"], "1"], 
      SubscriptBox[
       StyleBox["v", "TI"], "2"]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fc4e933b-8d48-4fcb-949e-f526af4aa01b"],
 ". A ",
 StyleBox["Hodge decomposition", "TI"],
 " is a splitting"
}], "Text",ExpressionUUID->"684a1400-9a65-4ff9-97cc-1e1468bfce78"],

Cell[BoxData[
 PaneBox[
  FormBox[
   RowBox[{
    StyleBox["V", "TI"], "\[LongEqual]", 
    StyleBox["H", "TI"], "\[CirclePlus]", 
    StyleBox["im",
     FontSlant->"Plain"], " ", 
    StyleBox["d",
     FontSlant->"Plain"], "\[CirclePlus]", 
    StyleBox["C", "TI"], 
    RowBox[{",", "    "}], 
    StyleBox["C", "TI"], "\[Perpendicular]", 
    StyleBox["C", "TI"], "\[CirclePlus]", 
    StyleBox["H", "TI"], ","}],
   TraditionalForm],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",ExpressionUUID->"8efc4d34-4322-402e-\
a238-d5207d5d8966"],

Cell[TextData[{
 "with ",
 Cell[BoxData[
  FormBox[
   StyleBox["H", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7e94fe7b-9548-4151-b975-5784b41387a7"],
 " a complement of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["im",
     FontSlant->"Plain"], " ", 
    StyleBox["d",
     FontSlant->"Plain"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "628e95db-80e0-428e-831a-7a6bdce98a06"],
 " in ",
 Cell[BoxData[
  FormBox[
   RowBox[{"ker", 
    StyleBox["d",
     FontSlant->"Plain"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7fc6b3fb-3c0d-413f-90c2-ef2ca7c69b7e"],
 " and ",
 Cell[BoxData[
  FormBox[
   StyleBox["C", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "51cc6b52-b8e6-4c95-81cf-28307c25db29"],
 " a complement of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"ker", 
    StyleBox["d",
     FontSlant->"Plain"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "483929a2-3ae7-44d4-a187-cceb87a10823"],
 " in ",
 Cell[BoxData[
  FormBox[
   StyleBox["V", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "592faf28-2b7c-481d-a2ed-e2b5eee9b148"],
 ". Dropping the condition ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["C", "TI"], "\[Perpendicular]", 
    StyleBox["C", "TI"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b6dd58f1-077e-478a-bb4a-c1bb63a8b11f"],
 " leaves a ",
 StyleBox["pre-Hodge", "TI"],
 " decomposition, and one of those exists for any PDGA; the whole difficulty \
is the isotropy of ",
 Cell[BoxData[
  FormBox[
   StyleBox["C", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fce8a05b-8fdc-4d1d-b8ea-12e0bbcfcad6"],
 "."
}], "Text",ExpressionUUID->"32844d49-94aa-4fa2-a40d-a6c321da277f"],

Cell[TextData[{
 "The ",
 StyleBox["degenerate subspace", "TI"],
 " is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["V", "TI"], 
     StyleBox["deg",
      FontSlant->"Plain"]], "\[LongEqual]", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["v", "TI"], "|", 
      StyleBox["v", "TI"], "\[Perpendicular]", 
      StyleBox["V", "TI"]}], "}"}]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2da81190-1df9-42fc-af31-d70a92b5c89f"],
 " and the ",
 StyleBox["nondegenerate quotient", "TI"],
 " is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["Q", "TI"], 
    RowBox[{"(", 
     StyleBox["V", "TI"], ")"}], "\[LongEqual]", 
    StyleBox["V", "TI"], "/", 
    SubscriptBox[
     StyleBox["V", "TI"], 
     StyleBox["deg",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bf9fad57-f917-4b25-8fd5-d3c28812f2ed"],
 ". Because ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{
      StyleBox["d",
       FontSlant->"Plain"], 
      SubscriptBox[
       StyleBox["v", "TI"], "1"], ",", 
      SubscriptBox[
       StyleBox["v", "TI"], "2"]}], "\[RightAngleBracket]"}], "\[LongEqual]", 
    "\[PlusMinus]", 
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{
      SubscriptBox[
       StyleBox["v", "TI"], "1"], ",", 
      StyleBox["d",
       FontSlant->"Plain"], 
      SubscriptBox[
       StyleBox["v", "TI"], "2"]}], "\[RightAngleBracket]"}]}], 
   TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cb168f75-a2ab-4cf7-9c2d-1e61798dbbd2"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{
      SubscriptBox[
       StyleBox["v", "TI"], "1"], 
      SubscriptBox[
       StyleBox["v", "TI"], "2"], ",", 
      SubscriptBox[
       StyleBox["v", "TI"], "3"]}], "\[RightAngleBracket]"}], "\[LongEqual]", 
    
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{
      SubscriptBox[
       StyleBox["v", "TI"], "1"], ",", 
      SubscriptBox[
       StyleBox["v", "TI"], "2"], 
      SubscriptBox[
       StyleBox["v", "TI"], "3"]}], "\[RightAngleBracket]"}]}], 
   TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bc434c3d-0bbd-46a0-8476-25bce10c6585"],
 ", the degenerate subspace is a differential graded ideal, so the quotient \
is again a CDGA with an orientation, and the pairing on it is nondegenerate \
by construction."
}], "Text",ExpressionUUID->"d9ac2389-167a-4c9d-bce4-917729d3b57d"],

Cell["\<\
Two facts tie the notions together, both from the reference and both used \
here:\
\>", "Text",ExpressionUUID->"fe16a1ae-eb76-4948-828f-e542af14d8e3"],

Cell[TextData[{
 "if ",
 Cell[BoxData[
  FormBox[
   StyleBox["V", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "64e0e430-4c0e-4aae-b984-111ec48680a3"],
 " is of Hodge type and the pairing on ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["H", "TI"], "(", 
    StyleBox["V", "TI"], ")"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b5559488-ec55-410e-98ff-bb2005b8cdff"],
 " is nondegenerate, then ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Pi]", 
     StyleBox["Q", "TI"]], ":", 
    StyleBox["V", "TI"], "\[Rule]", 
    StyleBox["Q", "TI"], 
    RowBox[{"(", 
     StyleBox["V", "TI"], ")"}]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a6ec9a84-2a87-40da-bb7a-6773f63fe94c"],
 " is a quasi-isomorphism;"
}], "Item",ExpressionUUID->"1b1cdadf-bb63-4f1f-ba70-1787ba89ec3d"],

Cell[TextData[{
 "conversely, in characteristic ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[NotEqual]", "2"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "643e4dbf-5f04-4be5-a1f7-0a4c597bb16b"],
 ", if ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Pi]", 
    StyleBox["Q", "TI"]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bf75832e-22a0-4868-8e7d-62245d360776"],
 " is a quasi-isomorphism and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["Q", "TI"], "(", 
    StyleBox["V", "TI"], ")"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d66bb49b-7e0c-4e14-995a-12044f8c8c19"],
 " is of finite type, then ",
 Cell[BoxData[
  FormBox[
   StyleBox["V", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fbce81bd-a9f6-48b2-a090-2119a9ee942e"],
 " is of Hodge type."
}], "Item",ExpressionUUID->"670a9fc3-862b-4fbd-a827-c9d2f1ce68d5"],

Cell[TextData[{
 "And ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Pi]", 
    StyleBox["Q", "TI"]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "43b44102-7cf2-4384-9178-c0d0da74dffa"],
 " is a quasi-isomorphism exactly when its kernel ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["V", "TI"], 
    StyleBox["deg",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "eaf48e2d-a20b-4e88-9d34-836b04be03aa"],
 " is acyclic. So the computable form of \"of Hodge type\" is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["H", "TI"], 
    RowBox[{"(", 
     SubscriptBox[
      StyleBox["V", "TI"], 
      StyleBox["deg",
       FontSlant->"Plain"]], ")"}], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "57724378-0afd-4011-bf29-c01786daace2"],
 ". That is what ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["HodgeTypeQ"]], "paclet:ChernSimons/ref/HodgeTypeQ", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "9bb75bbe-588e-4af8-993f-c640299cf1a6"],
 " tests."
}], "Text",ExpressionUUID->"9f3b616d-33be-4a9c-beda-e0e5a96b66b8"],

Cell["In which degrees", "Section",ExpressionUUID->"46b7fb00-e7ac-4d52-b9ff-a5a94f63eeab"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["V", "TI"], 
    StyleBox["deg",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "29fc167f-a005-4878-a6a5-363d6a9c4134"],
 " is infinite-dimensional whenever ",
 Cell[BoxData[
  FormBox[
   StyleBox["V", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7a852164-562d-46fe-9bfa-4a8ee0e7c16c"],
 " is, so the test needs a degree range. It needs a short one. Above degree \
",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b4bb1ac1-42ba-4f0f-84bd-31fc5147c6ad"],
 " the orientation sees nothing, so ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["V", "TI"], 
     StyleBox["deg",
      FontSlant->"Plain"], 
     StyleBox["k", "TI"]], "\[LongEqual]", 
    SuperscriptBox[
     StyleBox["V", "TI"], 
     StyleBox["k", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "159f391d-687b-4255-b7cf-0e58e394a7cb"],
 " for every ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["k", "TI"], ">", 
    StyleBox["n", "TI"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b5722a7d-a84a-4433-a4e8-86c97e7b1af3"],
 "; hence for ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["k", "TI"], "\[GreaterEqual]", 
    StyleBox["n", "TI"], "+", "2"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "741fae7a-e474-429d-ae5a-d069dc0c4f0e"],
 " both ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["V", "TI"], 
    StyleBox["deg",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["k", "TI"], "-", "1"}]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5c1991b5-c1aa-41bc-8734-64033c73b0c6"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["V", "TI"], 
    StyleBox["deg",
     FontSlant->"Plain"], 
    StyleBox["k", "TI"]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f5efe537-2266-4373-8d30-406433267048"],
 " are the whole of ",
 Cell[BoxData[
  FormBox[
   StyleBox["V", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c9bcb566-3410-41de-b98a-c4ff85c7eb51"],
 " in their degrees, and"
}], "Text",ExpressionUUID->"62b2c0b2-aa14-4732-a28e-0197298f648e"],

Cell[BoxData[
 PaneBox[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["H", "TI"], 
     StyleBox["k", "TI"]], 
    RowBox[{"(", 
     SubscriptBox[
      StyleBox["V", "TI"], 
      StyleBox["deg",
       FontSlant->"Plain"]], ")"}], "\[LongEqual]", 
    SuperscriptBox[
     StyleBox["H", "TI"], 
     StyleBox["k", "TI"]], 
    RowBox[{"(", 
     StyleBox["V", "TI"], ")"}], "\[LongEqual]", 
    RowBox[{"0", "    "}], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["k", "TI"], "\[GreaterEqual]", 
      StyleBox["n", "TI"], "+", "2"}], ")"}], ","}],
   TraditionalForm],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",ExpressionUUID->"29605a6f-75a6-412f-\
a305-a60343613c80"],

Cell[TextData[{
 "the last equality because the cohomology of a PDGA of degree ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4b540674-85a4-4ec6-8dc4-68d42ecfa7ea"],
 " is concentrated in degrees ",
 Cell[BoxData[
  FormBox["0", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "380673d1-e07a-4cf7-b222-1c86421e302b"],
 " to ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "28fcd9a6-5871-4966-8954-588110065286"],
 ". Degree ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["n", "TI"], "+", "1"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0eac739c-9457-4ffd-8662-048ea88ac968"],
 " is the one degree where the two differ, since ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["V", "TI"], 
    StyleBox["deg",
     FontSlant->"Plain"], 
    StyleBox["n", "TI"]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6143f9c1-6c1f-4a88-aae4-4ae487f86cfe"],
 " is generally a proper subspace of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["V", "TI"], 
    StyleBox["n", "TI"]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "98800330-2287-4819-9357-5c068ffadbc5"],
 ". So checking degrees ",
 Cell[BoxData[
  FormBox["0", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "eb8775a7-c108-471e-bc40-66c1c0595293"],
 " through ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["n", "TI"], "+", "1"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3f838bdb-d024-44ac-bc16-73c426a2134b"],
 " settles it, and that is the default."
}], "Text",ExpressionUUID->"6dfad790-e9ae-4f5c-9db9-0917b7ce353a"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"model", " ", "=", " ", 
   RowBox[{"SullivanModel", "[", 
    RowBox[{"\"\<ComplexProjectiveSpace\>\"", "[", "3", "]"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"model", "[", "\"\<Degree\>\"", "]"}], ",", " ", 
   RowBox[{"HodgeTypeQ", "[", "model", "]"}], ",", " ", 
   RowBox[{"HodgeTypeQ", "[", 
    RowBox[{"model", ",", " ", 
     RowBox[{"\"\<MaxDegree\>\"", " ", "->", " ", "30"}]}], "]"}]}], 
  "}"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"0fd250f8-cc4f-4a31-bced-4cf351096dbe"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"6", ",", "True", ",", "True"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"73f2f4d6-0f67-4925-8fa6-876dad1d2562"]
}, Open  ]],

Cell[TextData[{
 "The report tells the same story in columns. ",
 Cell[BoxData["Degenerate"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "661a05d3-5c3b-4a99-b75f-a9e24f78e02e"],
 " grows to fill ",
 Cell[BoxData["Dimension"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7d8a5206-9ad5-40d8-b3e1-e2f0526cba90"],
 " past degree ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c77b0c74-f1ab-4661-b36c-fb7ff8a69e69"],
 ", and ",
 Cell[BoxData["DegenerateCohomology"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1ba10fa5-a74a-41d4-8ae4-228e048b104a"],
 " stays zero: that is the quasi-isomorphism. ",
 Cell[BoxData["Cohomology"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b28b3333-ec8d-4f2f-bf34-0da02246abe9"],
 " and ",
 Cell[BoxData["Quotient"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9f9e4882-8194-412d-ab62-d282637a6b27"],
 " also agree here, which is a further fact: the quotient carries no \
differential, so it is the cohomology. In general the quasi-isomorphism only \
gives ",
 Cell[BoxData["Cohomology"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b8474f13-5d01-4a6f-bb02-07cbd8a9aa24"],
 " ",
 Cell[BoxData[
  FormBox["\[LessEqual]", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f51f6081-dda9-4a05-8bea-ac0820b42526"],
 " ",
 Cell[BoxData["Quotient"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "889b4f36-f12a-42bd-9b35-1789c988b04e"],
 ", the two agreeing exactly when the quotient's differential vanishes."
}], "Text",ExpressionUUID->"9a9bb78f-d695-4d80-94cd-91c769bbc980"],

