Cell[TextData[{
 "The obstruction is visible in the report, in degree ",
 Cell[BoxData[
  FormBox["3", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2c598f8a-bdb9-40ca-ac54-48003eedf8a0"],
 ": the degenerate subspace is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["R",
     FontSlant->"Plain"], 
    RowBox[{"{", 
     StyleBox["c", "TI"], "}"}]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a4fd4311-4d90-4d63-8070-55a7b92da280"],
 ", and ",
 Cell[BoxData[
  FormBox[
   StyleBox["c", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "adebc512-4f07-45aa-93f2-bf157d735914"],
 " is closed and is not the differential of anything degenerate, so ",
 Cell[BoxData["DegenerateCohomology"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c5fc7948-dd2b-4ae3-ab7b-27ee332b8fca"],
 " is ",
 Cell[BoxData[
  FormBox["1", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1cd8a87b-4e7a-4b92-a9b1-0917a8518f52"],
 " there."
}], "Text",ExpressionUUID->"8190c146-b3c6-4d1a-b97f-56630ab77504"],

