 CellLabel->"Out[7]= ",ExpressionUUID->"bdcae95c-9b71-4bd3-91b5-71334f50040f"]
}, Open  ]],

Cell[TextData[{
 "The consequence is exactly what the theory predicts: the quotient is ",
 StyleBox["not", "TI"],
 " quasi-isomorphic to the model. It is three-dimensional with zero \
differential: the cohomology of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["CP",
     FontSlant->"Plain"], "2"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"1ecbb851-288e-4c2a-9e7a-28217c4db24a"],
 ", not of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["S", "TI"], "4"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"cda988da-c23b-4f2e-9278-167474a93934"],
 "."
}], "Text",ExpressionUUID->"fd0e8c6d-ff06-4196-ae76-b3c1530cfe45"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"quotient", " ", "=", " ", 
   RowBox[{"NondegenerateQuotient", "[", "bad", "]"}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"quotient", "[", "\"\<Basis\>\"", "]"}], ",", " ", 
   RowBox[{"quotient", "[", "\"\<Differential\>\"", "]"}], ",", " ", 
   RowBox[{"Total", "[", 
    RowBox[{"Values", "[", 
     RowBox[{
      RowBox[{"HodgeTypeReport", "[", "bad", "]"}], "[", 
      RowBox[{"All", ",", " ", "\"\<Cohomology\>\""}], "]"}], "]"}], "]"}]}], 
  "}"}]}], "Input",
 CellLabel->"In[8]:= ",ExpressionUUID->"3a30a82b-8e74-4600-b95a-66aa7ca1dc39"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", "a", ",", 
     SuperscriptBox["a", "2"]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", "0"}], "}"}]}], "}"}], ",", "2"}], 
  "}"}]], "Output",
 CellLabel->"Out[8]= ",ExpressionUUID->"bdc0fffe-062f-432c-ad15-fc19df661e7b"]
}, Open  ]],

Cell[TextData[{
 "Three against two: the quotient map has killed the class of ",
 Cell[BoxData[
  FormBox[
   StyleBox["c", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "dc9205a0-e737-4ad4-9696-6741999dc45d"],
 " but not the class ",
 Cell[BoxData[
  FormBox[
   RowBox[{"[", 
    StyleBox["a", "TI"], "]"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"533ca43b-8408-4250-a1f9-0d9ea9b0d12b"],
 " that ought to have died with it. The repair in the reference is to ",
 StyleBox["extend", "TI"],
 " ",
 Cell[BoxData[
  FormBox[
   StyleBox["V", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "e7f0c19b-c871-45e3-90d8-d2dfeb89b897"],
 " to a larger PDGA of Hodge type that retracts onto it; the extension \
adjoins a generator in degree ",
 Cell[BoxData[
  FormBox["1", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "5587ce8c-fd48-4899-ad4e-3a08df7296e6"],
 ", which is why this example also shows that no ",
 Cell[BoxData[
  FormBox["1", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "f331d0f3-7bb4-4781-ad97-cb41d3e5d410"],
 "-connected extension of Hodge type exists in degree ",
 Cell[BoxData[
  FormBox["4", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "c11aa7f5-8f4c-436a-8e28-350b17f887dc"],
 "."
}], "Text",ExpressionUUID->"4ae72abd-38f6-4741-9c2c-c0fd16c7eac3"],

Cell["When the model is already a dPD algebra", "Section",ExpressionUUID->"3eaf1b58-7725-43d4-82b7-106ee2cd38a3"],

Cell[TextData[{
 "At the other extreme are models whose pairing is already perfect on chain \
level, so ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["V", "TI"], 
     StyleBox["deg",
      FontSlant->"Plain"]], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"9041ead8-fc4b-426c-bb63-267b941fdcc1"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["Q", "TI"], 
    RowBox[{"(", 
     StyleBox["V", "TI"], ")"}], "\[LongEqual]", 
    StyleBox["V", "TI"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "5eb9f35d-c855-4466-b1dd-5d6e9213810a"],
 ". The minimal model of a nilmanifold is one: a finite-dimensional exterior \
algebra on generators of degree ",
 Cell[BoxData[
  FormBox["1", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "3e6b06a5-4353-4a2b-94d9-4c38cc65fb51"],
 ", with the differential of the nilpotent Lie algebra."
}], "Text",ExpressionUUID->"d9c8c5b4-ac04-46c7-b1bf-77b3a5233e66"],

Cell[TextData[{
 "The three-dimensional Heisenberg nilmanifold has ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalLambda]", "(", 
    RowBox[{
     StyleBox["x", "TI"], ",", 
     StyleBox["y", "TI"], ",", 
     StyleBox["z", "TI"]}], ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"253903fe-0278-4bb3-a45f-d7561ebfffb3"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["d",
     FontSlant->"Plain"], 
    StyleBox["z", "TI"], "\[LongEqual]", 
    StyleBox["x", "TI"], 
    StyleBox["y", "TI"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "6ea0ae9b-d3db-4b99-b84c-4514a2c88d3b"],
 ", and the orientation ",
 Cell[BoxData[
  FormBox["1", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "bf7386a6-c226-4c67-9abd-ec2c0c61230e"],
 " on ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"x", "y", "z"}], "TI"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"17cea7a6-ff4a-41cb-80d9-1854cd9960e6"],
 "."
}], "Text",ExpressionUUID->"5243256f-0449-408d-98c3-8e87db89c7c9"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"heis", " ", "=", " ", 
   RowBox[{"SullivanModel", "[", "\"\<HeisenbergNilmanifold\>\"", "]"}]}], 
  ";"}], "\n", 
 RowBox[{"{", 
