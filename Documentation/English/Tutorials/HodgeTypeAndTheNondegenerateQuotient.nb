    GridBoxAlignment->{"Columns" -> {{Center}}, "Rows" -> {{Baseline}}},
    GridBoxSpacings->{"Columns" -> {
        Offset[0.27999999999999997`], {
         Offset[0.7]}, 
        Offset[0.27999999999999997`]}, "Rows" -> {
        Offset[0.2], {
         Offset[0.4]}, 
        Offset[0.2]}}], "\[NoBreak]", ")"}],
  Function[BoxForm`e$, 
   MatrixForm[BoxForm`e$]]]], "Output",
 CellLabel->
  "Out[12]= ",ExpressionUUID->"07d195ae-572b-4f91-8b23-c987f0736450"]
}, Open  ]],

Cell[TextData[{
 "The one nonzero entry sends ",
 Cell[BoxData[
  FormBox[
   StyleBox["z", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "dd2146e4-b7e3-4d8c-81aa-8041b60e50a7"],
 " to ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"x", "y"}], "TI"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"a517d194-54b1-412a-94b6-8631a32362ce"],
 ". In the canonical dIBL structure of a cyclic cochain complex this \
differential is carried by the operation ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["q", "TI"], 
    RowBox[{"1", ",", "1", ",", "0"}]], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"c9c3290e-36eb-4323-ace6-075fa032d868"],
 ", and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CyclicHochschildDifferential"]], 
    "paclet:ChernSimons/ref/CyclicHochschildDifferential", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "ba54a0c9-3818-4fdc-a637-318d30dd1717"],
 " is that operation: dually to ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["d",
     FontSlant->"Plain"], 
    StyleBox["z", "TI"], "\[LongEqual]", 
    StyleBox["x", "TI"], 
    StyleBox["y", "TI"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "d22fb2f6-a17e-4d04-866a-c01c1a9e9f1f"],
 ", it replaces the letter ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"x", "y"}], "TI"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"d820b17b-bc54-4401-8d57-0d3857973f2d"],
 " by the letter ",
 Cell[BoxData[
  FormBox[
   StyleBox["z", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "6ec621fe-2b2a-440a-8960-ac4cf42f8eff"],
 ", with the running sign of the letters after the slot."
}], "Text",ExpressionUUID->"ed41ae5e-0f24-4690-82f6-ce4f0fdfef6a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"pr", " ", "=", " ", 
     RowBox[{"GradedPairing", "[", 
      RowBox[{"NondegenerateQuotient", "[", "heis", "]"}], "]"}]}], "}"}], ",",
    "\n", "   ", 
   RowBox[{"CyclicHochschildDifferential", "[", 
    RowBox[{
     RowBox[{"CyclicWord", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"x", "*", "y"}], ",", " ", "y"}], "}"}], "]"}], ",", " ", 
     "pr"}], "]"}]}], "]"}]], "Input",
 CellLabel->
  "In[13]:= ",ExpressionUUID->"b481ecf0-eab4-44ee-8455-e78fdfd68ff8"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"(", 
   RowBox[{"y", "\[ThinSpace]", "z"}], ")"}],
  ChernSimons`CyclicWord[{MTNB$caxtra6mvcue`y, MTNB$caxtra6mvcue`z}],
  Editable->False]], "Output",
 CellLabel->
  "Out[13]= ",ExpressionUUID->"233bb01e-4594-4ceb-a508-1a2c3c874d32"]
}, Open  ]],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CanonicalMaurerCartan"]], 
    "paclet:ChernSimons/ref/CanonicalMaurerCartan", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "7bbd5775-d517-4a55-98a7-917572ce8074"],
 " is unchanged by this: the element of the ",
 StyleBox["product", "TI"],
 " alone solves the Maurer-Cartan equation of the structure with ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["q", "TI"], 
    RowBox[{"1", ",", "1", ",", "0"}]], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"46ca8fb8-e9ed-4248-a31f-547f93dd2e29"],
 ", because the operation kills it. That is the Leibniz rule of the algebra, \
read on the element that carries its triple product. Twisting by the element \
then stacks the bracket on top of the differential, so ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["TwistedDifferential"]], 
    "paclet:ChernSimons/ref/TwistedDifferential", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "998f9339-870c-4112-8d70-135a70360f1d"],
 " is the differential of the dPD algebra with its ",
 Cell[BoxData[
  FormBox[
   StyleBox["d",
    FontSlant->"Plain"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "ff4107d1-9948-4a75-978b-0f41f80ea6fb"],
 ", not merely of the underlying Poincar\[EAcute] duality algebra."
}], "Text",ExpressionUUID->"83988122-f85c-4cc1-bf4c-782c9fc8f003"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"pr", " ", "=", " ", 
     RowBox[{"GradedPairing", "[", 
      RowBox[{"NondegenerateQuotient", "[", "heis", "]"}], "]"}]}], "}"}], ",",
    "\n", "   ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"m", " ", "=", " ", 
       RowBox[{"CanonicalMaurerCartan", "[", "pr", "]"}]}], "}"}], ",", "\n", 
     "     ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"CyclicHochschildDifferential", "[", 
        RowBox[{
         RowBox[{"m", "[", 
          RowBox[{"{", 
           RowBox[{"1", ",", " ", "0"}], "}"}], "]"}], ",", " ", "pr"}], 
        "]"}], ",", " ", 
       RowBox[{"RelationsQ", "[", "m", "]"}], ",", "\n", "      ", 
       RowBox[{"TwistedDifferential", "[", 
        RowBox[{"m", ",", " ", 
         RowBox[{"CyclicWord", "[", 
          RowBox[{"{", 
           RowBox[{"x", "*", "y"}], "}"}], "]"}]}], "]"}]}], "}"}]}], "]"}]}],
   "]"}]], "Input",
 CellLabel->
  "In[14]:= ",ExpressionUUID->"19ad6e95-5cb4-4987-b680-e1f6f77efe81"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0", ",", "True", ",", 
   InterpretationBox[
    RowBox[{"(", "z", ")"}],
    ChernSimons`CyclicWord[{MTNB$caxtra6mvcue`z}],
    Editable->False]}], "}"}]], "Output",
 CellLabel->
  "Out[14]= ",ExpressionUUID->"675190f7-4d34-4686-a346-0472767202bb"]
}, Open  ]],

