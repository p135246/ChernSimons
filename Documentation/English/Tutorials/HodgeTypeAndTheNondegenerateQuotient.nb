 RowBox[{"DegenerateSubspace", "[", 
  RowBox[{"bad", ",", " ", "3"}], "]"}]], "Input",
 CellLabel->"In[7]:= ",ExpressionUUID->"e44b1049-4ca2-4f2e-8ab0-86c3f76d8dc9"],

