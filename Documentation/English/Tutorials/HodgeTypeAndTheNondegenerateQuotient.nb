Cell[TextData[{
 "Every row has ",
 Cell[BoxData["Degenerate"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "22cf94a5-6b83-48d2-bde7-a4e99bda0c29"],
 " zero and ",
 Cell[BoxData["Dimension"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fae057ee-20ea-4a4c-a596-c702dd8ee219"],
 " equal to ",
 Cell[BoxData["Quotient"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "67df0419-5815-4dd7-9ed0-3cefaa036e26"],
 ": the model ",
 StyleBox["is", "TI"],
 " its own nondegenerate quotient, an eight-dimensional differential Poincar\
\[EAcute] duality algebra of degree ",
 Cell[BoxData[
  FormBox["3", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "aba9600c-e62a-43e4-b2a6-988cdd8eddf0"],
 ". The Betti numbers ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", ",", "2", ",", "2", ",", "1"}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "482e6a1e-d764-4eef-85ff-c8c7d9d5242d"],
 " read off the ",
 Cell[BoxData["Cohomology"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "05e1c0cd-f564-4caf-b18a-b3660628039e"],
 " column and are symmetric, as Poincar\[EAcute] duality demands."
}], "Text",ExpressionUUID->"6c35a707-1131-48dd-bf77-3b16af76163f"],

