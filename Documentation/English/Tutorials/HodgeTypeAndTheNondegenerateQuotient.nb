Cell[BoxData[
 RowBox[{"DegenerateSubspace", "[", 
  RowBox[{"bad", ",", " ", "3"}], "]"}]], "Input",
 CellLabel->"In[7]:= ",ExpressionUUID->"035fb7e2-1437-406f-8c81-d2420ef47401"],

Cell[BoxData[
