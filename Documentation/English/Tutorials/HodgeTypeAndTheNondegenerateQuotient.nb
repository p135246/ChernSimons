Notebook[{

Cell[CellGroupData[{
Cell["Hodge Type and the Nondegenerate Quotient", "Title",
 CellID->509267359,ExpressionUUID->"4ddb5767-1f00-4973-a411-49eacd07850d"],

Cell[TextData[{
 "An oriented PDGA ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     StyleBox["V", "TI"], ",", 
     StyleBox["d",
      FontSlant->"Plain"], ",", 
     StyleBox["O", "TI"]}], ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"28ade077-2837-4056-aa2e-28615506b0c1"],
 " satisfies Poincar\[EAcute] duality on cohomology but almost never on chain \
level. The construction that repairs this divides out the part of ",
 Cell[BoxData[
  FormBox[
   StyleBox["V", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "5f410bc2-ac7c-41fb-8983-c70691dc9ce8"],
 " that the pairing cannot see, and the question is whether the division \
loses cohomology. It does not exactly when ",
 Cell[BoxData[
  FormBox[
   StyleBox["V", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "58ff7775-4aee-4159-9af7-12590f24d0b9"],
 " is ",
 StyleBox["of Hodge type", "TI"],
 ". This tutorial is about that test: what it computes, in which degrees, and \
what it looks like when it fails."
}], "Text",ExpressionUUID->"4965b18a-5795-498b-963e-825273bcb03f"],

Cell[TextData[{
 "The reference is ",
 ButtonBox["arXiv:2004.07362",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://arxiv.org/abs/2004.07362"], None}],
 ", ",
 StyleBox["Hodge decompositions and Poincar\[EAcute] duality models", "TI"],
 "."
}], "Text",ExpressionUUID->"8e18b9b9-21ba-443e-9342-11358fabc113"],

Cell["Three subspaces", "Section",ExpressionUUID->"99d0817c-4795-4f11-a4f3-488346f1480d"],

Cell[TextData[{
 "Write ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{
      SubscriptBox[
       StyleBox["v", "TI"], "1"], ",", 
      SubscriptBox[
       StyleBox["v", "TI"], "2"]}], "\[RightAngleBracket]"}], "\[LongEqual]", 
    
    StyleBox["O", "TI"], 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox[
       StyleBox["v", "TI"], "1"], 
      SubscriptBox[
       StyleBox["v", "TI"], "2"]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"9a615eb1-48e9-4d35-acbb-a9817f3314ed"],
 ". A ",
 StyleBox["Hodge decomposition", "TI"],
 " is a splitting"
}], "Text",ExpressionUUID->"1236f9ed-67e9-4a8d-8d70-63f764e46657"],

Cell[BoxData[
 PaneBox[
  FormBox[
   RowBox[{
    RowBox[{
     StyleBox["V", "TI"], "\[LongEqual]", 
     RowBox[{
      StyleBox["H", "TI"], "\[CirclePlus]", 
      RowBox[{
       StyleBox["im",
        FontSlant->"Plain"], " ", 
       StyleBox["d",
        FontSlant->"Plain"]}], "\[CirclePlus]", 
      StyleBox["C", "TI"]}]}], ",", "    ", 
    RowBox[{
     StyleBox["C", "TI"], "\[Perpendicular]", 
     RowBox[{
      StyleBox["C", "TI"], "\[CirclePlus]", 
      StyleBox["H", "TI"]}]}], ","}],
   TraditionalForm],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",ExpressionUUID->"792795ce-2bec-4d97-\
995c-2a76a49cc00c"],

Cell[TextData[{
 "with ",
 Cell[BoxData[
  FormBox[
   StyleBox["H", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "1041ec7a-3e0f-4a97-96ce-f4faf334a3d6"],
 " a complement of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["im",
     FontSlant->"Plain"], " ", 
    StyleBox["d",
     FontSlant->"Plain"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "a47a068f-ae39-4c26-93a9-78bcfbc1de71"],
 " in ",
 Cell[BoxData[
  FormBox[
   RowBox[{"ker", 
    StyleBox["d",
     FontSlant->"Plain"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "ab464bfa-e14e-4cbd-9cf6-4caca5eb5c21"],
 " and ",
 Cell[BoxData[
  FormBox[
   StyleBox["C", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "2173a8b8-2041-4a15-86cd-0be1d450390b"],
 " a complement of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"ker", 
    StyleBox["d",
     FontSlant->"Plain"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "501480de-39c2-4272-8eff-383b431b0061"],
 " in ",
 Cell[BoxData[
  FormBox[
   StyleBox["V", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "64dc4263-b401-4e82-8619-141ce3c91460"],
 ". Dropping the condition ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["C", "TI"], "\[Perpendicular]", 
    StyleBox["C", "TI"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "ef26f19d-0119-4807-830a-2b6db2f9103f"],
 " leaves a ",
 StyleBox["pre-Hodge", "TI"],
 " decomposition, and one of those exists for any PDGA; the whole difficulty \
is the isotropy of ",
 Cell[BoxData[
  FormBox[
   StyleBox["C", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "5109e228-c273-4274-ab8e-0c9c5fea6dbe"],
 "."
}], "Text",ExpressionUUID->"202594fe-fc26-4232-97dd-2bcbfa554842"],

Cell[TextData[{
 "The ",
 StyleBox["degenerate subspace", "TI"],
 " is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["V", "TI"], 
     StyleBox["deg",
      FontSlant->"Plain"]], "\[LongEqual]", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["v", "TI"], "|", 
      StyleBox["v", "TI"], "\[Perpendicular]", 
      StyleBox["V", "TI"]}], "}"}]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"168b830c-6627-4efc-a694-f47117f12e15"],
 " and the ",
 StyleBox["nondegenerate quotient", "TI"],
 " is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["Q", "TI"], 
    RowBox[{"(", 
     StyleBox["V", "TI"], ")"}], "\[LongEqual]", 
    StyleBox["V", "TI"], "/", 
    SubscriptBox[
     StyleBox["V", "TI"], 
     StyleBox["deg",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"14f574a0-a5c9-4346-b6a8-b14a8ef0ac78"],
 ". Because ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{
      StyleBox["d",
       FontSlant->"Plain"], 
      SubscriptBox[
       StyleBox["v", "TI"], "1"], ",", 
      SubscriptBox[
       StyleBox["v", "TI"], "2"]}], "\[RightAngleBracket]"}], "\[LongEqual]", 
    "\[PlusMinus]", 
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{
      SubscriptBox[
       StyleBox["v", "TI"], "1"], ",", 
      StyleBox["d",
       FontSlant->"Plain"], 
      SubscriptBox[
       StyleBox["v", "TI"], "2"]}], "\[RightAngleBracket]"}]}], 
   TraditionalForm]], "InlineFormula",ExpressionUUID->
  "ce5d48f9-a9bf-4b9f-a99b-5686ee7d0654"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{
      SubscriptBox[
       StyleBox["v", "TI"], "1"], 
      SubscriptBox[
       StyleBox["v", "TI"], "2"], ",", 
      SubscriptBox[
       StyleBox["v", "TI"], "3"]}], "\[RightAngleBracket]"}], "\[LongEqual]", 
    
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{
      SubscriptBox[
       StyleBox["v", "TI"], "1"], ",", 
      SubscriptBox[
       StyleBox["v", "TI"], "2"], 
      SubscriptBox[
       StyleBox["v", "TI"], "3"]}], "\[RightAngleBracket]"}]}], 
   TraditionalForm]], "InlineFormula",ExpressionUUID->
  "f55a713a-2df7-45c9-ad0a-6356f522bc42"],
 ", the degenerate subspace is a differential graded ideal, so the quotient \
is again a CDGA with an orientation, and the pairing on it is nondegenerate \
by construction."
}], "Text",ExpressionUUID->"f7118c54-7429-4a11-a79f-a16ca898ebd1"],

Cell["\<\
Two facts tie the notions together, both from the reference and both used \
here:\
\>", "Text",ExpressionUUID->"8e7c99a3-2f8e-492c-bd35-978672251356"],

Cell[TextData[{
 "if ",
 Cell[BoxData[
  FormBox[
   StyleBox["V", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "2e266327-5428-422f-88bb-c98644890937"],
 " is of Hodge type and the pairing on ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["H", "TI"], "(", 
    StyleBox["V", "TI"], ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"cc73cc26-c5cf-47b5-9a75-0e717a6a76ed"],
 " is nondegenerate, then ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Pi]", 
     StyleBox["Q", "TI"]], ":", 
    StyleBox["V", "TI"], "\[Rule]", 
    StyleBox["Q", "TI"], 
    RowBox[{"(", 
     StyleBox["V", "TI"], ")"}]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"a28ec341-2f60-410f-a12a-91a796942dc3"],
 " is a quasi-isomorphism;"
}], "Item",ExpressionUUID->"f5807dd0-98ab-4abc-8665-76d9e762d37e"],

Cell[TextData[{
 "conversely, in characteristic ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[NotEqual]", "2"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"b456555e-1281-4bda-a6af-652aa54429c4"],
 ", if ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Pi]", 
    StyleBox["Q", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "867945cc-1b8a-44bb-8058-548cc2a74f88"],
 " is a quasi-isomorphism and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["Q", "TI"], "(", 
    StyleBox["V", "TI"], ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"98bfb205-d83f-4c11-bf7d-4ebc4429ad1a"],
 " is of finite type, then ",
 Cell[BoxData[
  FormBox[
   StyleBox["V", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "26495429-bf80-4bdb-b11e-811fec261da0"],
 " is of Hodge type."
}], "Item",ExpressionUUID->"d1263abb-471f-4ce8-9069-5624525b4b76"],

Cell[TextData[{
 "And ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Pi]", 
    StyleBox["Q", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "afa0ff1c-4896-44d9-b9f8-7e23f845acbf"],
 " is a quasi-isomorphism exactly when its kernel ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["V", "TI"], 
    StyleBox["deg",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "65758a91-d052-470c-a3ff-bab307fbd544"],
 " is acyclic. So the computable form of \"of Hodge type\" is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["H", "TI"], 
    RowBox[{"(", 
     SubscriptBox[
      StyleBox["V", "TI"], 
      StyleBox["deg",
       FontSlant->"Plain"]], ")"}], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"5fd1739c-4468-4f0d-9918-1c69b4d065c4"],
 ". That is what ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["HodgeTypeQ"]], "paclet:ChernSimons/ref/HodgeTypeQ", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "8d68bbde-e432-40c0-8327-0dc79843e33b"],
 " tests."
}], "Text",ExpressionUUID->"00bc09a7-2c3f-4f1e-8195-32a600517485"],

Cell["In which degrees", "Section",ExpressionUUID->"22a55c7c-41aa-40e4-89ba-410c605c3dc3"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["V", "TI"], 
    StyleBox["deg",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "3eae57bc-9402-4b7a-9873-2a25826262c1"],
 " is infinite-dimensional whenever ",
 Cell[BoxData[
  FormBox[
   StyleBox["V", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "091b5702-9eca-4a99-9294-930afd0e1220"],
 " is, so the test needs a degree range. It needs a short one. Above degree \
",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "7a7cce2d-0e3a-4ea0-b2ef-242bc8f5a15d"],
 " the orientation sees nothing, so ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["V", "TI"], 
     StyleBox["deg",
      FontSlant->"Plain"], 
     StyleBox["k", "TI"]], "\[LongEqual]", 
    SuperscriptBox[
     StyleBox["V", "TI"], 
     StyleBox["k", "TI"]]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"c53f2fb3-7a3a-4aea-b970-9ba08b29ff36"],
 " for every ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["k", "TI"], ">", 
    StyleBox["n", "TI"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "e06b8e04-197a-4a9b-aef7-9845cb97a7ae"],
 "; hence for ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["k", "TI"], "\[GreaterEqual]", 
    StyleBox["n", "TI"], "+", "2"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"2cfec22c-e4ff-41d3-92e9-7c753dada0ce"],
 " both ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["V", "TI"], 
    StyleBox["deg",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["k", "TI"], "-", "1"}]], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"ae54cdf9-8026-44a2-ab57-a8dc7b07b4bf"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["V", "TI"], 
    StyleBox["deg",
     FontSlant->"Plain"], 
    StyleBox["k", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "d0eee263-0555-4442-9d7f-6ed8c13c6efb"],
 " are the whole of ",
 Cell[BoxData[
  FormBox[
   StyleBox["V", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "7ce10134-b805-4159-967f-9be21f271290"],
 " in their degrees, and"
}], "Text",ExpressionUUID->"1ccac55c-afd1-4c7a-8ab9-dc5bd261f82c"],

Cell[BoxData[
 PaneBox[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      SuperscriptBox[
       StyleBox["H", "TI"], 
       StyleBox["k", "TI"]], 
      RowBox[{"(", 
       SubscriptBox[
        StyleBox["V", "TI"], 
        StyleBox["deg",
         FontSlant->"Plain"]], ")"}]}], "\[LongEqual]", 
     RowBox[{
      SuperscriptBox[
       StyleBox["H", "TI"], 
       StyleBox["k", "TI"]], 
      RowBox[{"(", 
       StyleBox["V", "TI"], ")"}]}], "\[LongEqual]", 
     RowBox[{"0", "    ", 
      RowBox[{"(", 
       RowBox[{
        StyleBox["k", "TI"], "\[GreaterEqual]", 
        StyleBox["n", "TI"], "+", "2"}], ")"}]}]}], ","}],
   TraditionalForm],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",ExpressionUUID->"6bcdc680-993f-4182-\
bfac-56eeada81e3c"],

Cell[TextData[{
 "the last equality because the cohomology of a PDGA of degree ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "8ee73daa-dd64-411d-867f-8a0100be429e"],
 " is concentrated in degrees ",
 Cell[BoxData[
  FormBox["0", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "c6d35222-9d3a-43f9-b75e-53d850923517"],
 " to ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "c5d7575b-6654-450f-9eb9-8b7c8b0cbc77"],
 ". Degree ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["n", "TI"], "+", "1"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"0fa2bea7-edab-4da0-a131-56d0f967686a"],
 " is the one degree where the two differ, since ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["V", "TI"], 
    StyleBox["deg",
     FontSlant->"Plain"], 
    StyleBox["n", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "138e9c11-0126-415b-b0cd-448ebcbdb952"],
 " is generally a proper subspace of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["V", "TI"], 
    StyleBox["n", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "463e0a17-c60c-4ef7-8163-98377eadff41"],
 ". So checking degrees ",
 Cell[BoxData[
  FormBox["0", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "8d5c7f43-3a97-4e6a-8c4e-225dd7248d41"],
 " through ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["n", "TI"], "+", "1"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"eb6bf36b-ad11-4cf3-8376-fdd58927d851"],
 " settles it, and that is the default."
}], "Text",ExpressionUUID->"1074c3a3-0959-49d0-aacf-8c11e1196757"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"model", " ", "=", " ", 
   RowBox[{"SullivanModel", "[", 
    RowBox[{"\"\<ComplexProjectiveSpace\>\"", "[", "3", "]"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"model", "[", "\"\<Degree\>\"", "]"}], ",", " ", 
   RowBox[{"HodgeTypeQ", "[", "model", "]"}], ",", " ", 
   RowBox[{"HodgeTypeQ", "[", 
    RowBox[{"model", ",", " ", 
     RowBox[{"\"\<MaxDegree\>\"", " ", "->", " ", "30"}]}], "]"}]}], 
  "}"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"dd50887a-822d-4c43-adf1-877be122ef85"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"6", ",", "True", ",", "True"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"93c069f8-3567-4697-94d7-fc8fb6a5c413"]
}, Open  ]],

Cell[TextData[{
 "The report tells the same story in columns. ",
 Cell[BoxData[
 "Degenerate"], "InlineFormula",ExpressionUUID->
  "cd18b4e2-bbd4-4e79-8a6d-db3149921a11"],
 " grows to fill ",
 Cell[BoxData[
 "Dimension"], "InlineFormula",ExpressionUUID->
  "a4e53b54-7bfe-4d68-a506-2a0ea5cf9c51"],
 " past degree ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "1e0b506f-d685-4e36-a6e6-fda4f8b98c1e"],
 ", and ",
 Cell[BoxData[
 "DegenerateCohomology"], "InlineFormula",ExpressionUUID->
  "c181cf25-4bbd-402d-992d-4363303e2c2c"],
 " stays zero: that is the quasi-isomorphism. ",
 Cell[BoxData[
 "Cohomology"], "InlineFormula",ExpressionUUID->
  "c1912ec4-9608-4890-b705-dae3e5b3375e"],
 " and ",
 Cell[BoxData[
 "Quotient"], "InlineFormula",ExpressionUUID->
  "762419fd-35eb-4308-83ea-13b0102e18fc"],
 " also agree here, which is a further fact: the quotient carries no \
differential, so it is the cohomology. In general the quasi-isomorphism only \
gives ",
 Cell[BoxData[
 "Cohomology"], "InlineFormula",ExpressionUUID->
  "8d3746e5-8fbe-404c-aaa0-10fb35ad4ed7"],
 " ",
 Cell[BoxData[
  FormBox["\[LessEqual]", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "2c36eae9-688e-4e69-b770-628dccee38f3"],
 " ",
 Cell[BoxData[
 "Quotient"], "InlineFormula",ExpressionUUID->
  "1b38b15b-807c-4d6b-b09f-9ba9416745fd"],
 ", the two agreeing exactly when the quotient's differential vanishes."
}], "Text",ExpressionUUID->"9544e631-a23f-4246-8e9a-45c33d44530e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"HodgeTypeReport", "[", "model", "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"de6189d3-55aa-4334-af10-9e6428b7e287"],

Cell[BoxData[
 TagBox[
  TagBox[
   DynamicModuleBox[{TypeSystem`NestedGrid`PackagePrivate`$state$$ = <|
    "InitialData" -> <|
      0 -> <|"Dimension" -> 1, "Cohomology" -> 1, "Degenerate" -> 0, 
         "DegenerateCohomology" -> 0, "Quotient" -> 1|>, 
       1 -> <|"Dimension" -> 0, "Cohomology" -> 0, "Degenerate" -> 0, 
         "DegenerateCohomology" -> 0, "Quotient" -> 0|>, 
       2 -> <|"Dimension" -> 1, "Cohomology" -> 1, "Degenerate" -> 0, 
         "DegenerateCohomology" -> 0, "Quotient" -> 1|>, 
       3 -> <|"Dimension" -> 0, "Cohomology" -> 0, "Degenerate" -> 0, 
         "DegenerateCohomology" -> 0, "Quotient" -> 0|>, 
       4 -> <|"Dimension" -> 1, "Cohomology" -> 1, "Degenerate" -> 0, 
         "DegenerateCohomology" -> 0, "Quotient" -> 1|>, 
       5 -> <|"Dimension" -> 0, "Cohomology" -> 0, "Degenerate" -> 0, 
         "DegenerateCohomology" -> 0, "Quotient" -> 0|>, 
       6 -> <|"Dimension" -> 1, "Cohomology" -> 1, "Degenerate" -> 0, 
         "DegenerateCohomology" -> 0, "Quotient" -> 1|>, 
       7 -> <|"Dimension" -> 1, "Cohomology" -> 0, "Degenerate" -> 1, 
         "DegenerateCohomology" -> 0, "Quotient" -> 0|>, 
       8 -> <|"Dimension" -> 1, "Cohomology" -> 0, "Degenerate" -> 1, 
