Cell["When it fails", "Section",ExpressionUUID->"22ca140e-a776-40e2-8a40-19c1ad6615b9"],

Cell[TextData[{
 "Example 6.3 of the reference is a ",
 Cell[BoxData[
  FormBox["1", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "784870cf-f6cf-49f1-a900-13bfd37026e7"],
 "-connected PDGA of degree ",
 Cell[BoxData[
  FormBox["4", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d937f3ef-0406-4bcf-bc44-43c07626cfe2"],
 " that is not of Hodge type. Take one generator ",
 Cell[BoxData[
  FormBox[
   StyleBox["a", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bfe86052-8214-4b81-893a-ce3edbb448f6"],
 " of degree ",
 Cell[BoxData[
  FormBox["2", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "61c2c9eb-10fa-4762-85e7-b8ec1a37ebbe"],
 " and one generator ",
 Cell[BoxData[
  FormBox[
   StyleBox["c", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1a4db1cd-c29d-4430-824a-0a5ecd87c943"],
 " of degree ",
 Cell[BoxData[
  FormBox["3", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d970c2b2-db8d-4859-a1bd-becae5eae7bc"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["d",
     FontSlant->"Plain"], 
    StyleBox["a", "TI"], "\[LongEqual]", 
    StyleBox["c", "TI"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "16a907a8-f054-4359-9dd2-e97bf0ec6b8b"],
 ", and truncate everything above degree ",
 Cell[BoxData[
  FormBox["4", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2e8b10e7-cf7e-4f96-829b-a681f44ead46"],
 "; the orientation is the coefficient of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["a", "TI"], "2"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "73c62fad-380a-40fc-8499-e4b95c07640d"],
 "."
}], "Text",ExpressionUUID->"30f6f735-56b1-4f24-9f83-c00e9cc4fa00"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"bad", " ", "=", " ", 
   RowBox[{"SullivanModel", "[", "\"\<Degree4Obstruction\>\"", "]"}]}], 
  ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Normal", "[", 
    RowBox[{"bad", "[", "\"\<Generators\>\"", "]"}], "]"}], ",", " ", 
   RowBox[{"bad", "[", "\"\<Volume\>\"", "]"}], ",", " ", 
   RowBox[{"bad", "[", "\"\<Truncation\>\"", "]"}]}], "}"}]}], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"a095f593-df07-42c6-b94f-2d4d7d5349a0"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a", "\[Rule]", "2"}], ",", 
     RowBox[{"c", "\[Rule]", "3"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"a", ",", "a"}], "}"}], ",", "4"}], "}"}]], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"1facd4d5-38bc-43fb-b342-b10421b3659a"]
}, Open  ]],

Cell[TextData[{
 "The truncation is what makes this finite: the ideal of monomials above \
degree ",
 Cell[BoxData[
  FormBox["4", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ae820f73-82f5-4055-9bb0-c8bf85069d63"],
 " is a differential graded ideal, so the quotient is a CDGA, and it is \
four-dimensional."
}], "Text",ExpressionUUID->"ac5d2e74-f40d-4e58-8df8-89f6be31a0da"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", 
  RowBox[{
   RowBox[{"SullivanModelBasis", "[", 
    RowBox[{"bad", ",", " ", "k"}], "]"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"k", ",", " ", "0", ",", " ", "5"}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[4]:= ",ExpressionUUID->"031719ef-1852-4353-8313-e466236177e4"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", "1", "}"}], ",", 
   RowBox[{"{", "}"}], ",", 
   RowBox[{"{", "a", "}"}], ",", 
   RowBox[{"{", "c", "}"}], ",", 
   RowBox[{"{", 
    SuperscriptBox["a", "2"], "}"}], ",", 
   RowBox[{"{", "}"}]}], "}"}]], "Output",
 CellLabel->"Out[4]= ",ExpressionUUID->"2b964876-b9ee-4758-a5b5-b935838c3190"]
}, Open  ]],

Cell[TextData[{
 "Its cohomology is ",
 Cell[BoxData[
  FormBox[
   StyleBox["R",
    FontSlant->"Plain"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e135054d-bbba-42dc-bf27-faaebb0fda62"],
 " in degree ",
 Cell[BoxData[
  FormBox["0", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "efb66efb-b976-4b10-b599-6d1518e7e708"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["R",
     FontSlant->"Plain"], 
    RowBox[{"{", 
     SuperscriptBox[
      StyleBox["a", "TI"], "2"], "}"}]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f06ce744-2c24-41db-86b4-11433a8c4d7d"],
 " in degree ",
 Cell[BoxData[
  FormBox["4", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5df3756d-b7d6-4da1-b577-706506af6418"],
 " \[LongDash] the cohomology of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["S", "TI"], "4"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b6d9c9bb-ec66-4e00-87f2-9f312cee1d98"],
 " \[LongDash] and the pairing on it is perfect, so this is an oriented PDGA \
of degree ",
 Cell[BoxData[
  FormBox["4", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "82fd2138-bc1f-446d-91f6-f87f5bf9b467"],
 ". But ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{
      StyleBox["a", "TI"], ",", 
      StyleBox["a", "TI"]}], "\[RightAngleBracket]"}], "\[LongEqual]", 
    StyleBox["O", "TI"], 
    RowBox[{"(", 
     SuperscriptBox[
      StyleBox["a", "TI"], "2"], ")"}], "\[LongEqual]", "1"}], 
   TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "76238eec-5c85-485e-a0f5-1e2ab8905524"],
 ", and ",
 Cell[BoxData[
  FormBox[
   StyleBox["a", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9dc644f4-0fe0-4502-bc86-723315f85f86"],
 " spans the whole of degree ",
 Cell[BoxData[
  FormBox["2", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e7eb0e60-19a7-4096-90f8-32558ca3172b"],
 ", so the coexact part in degree ",
 Cell[BoxData[
  FormBox["2", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d3101eb7-65a1-48ec-b868-763ed6a7351c"],
 " can only be ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["R",
     FontSlant->"Plain"], 
    RowBox[{"{", 
     StyleBox["a", "TI"], "}"}]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e2d5c1f9-656d-4735-b660-384cd503da04"],
 ", which is not isotropic. No Hodge decomposition exists."
}], "Text",ExpressionUUID->"9d4fa522-e117-4854-9fa9-4295c407baa2"],

