Cell[TextData[{
 "The obstruction is visible in the report, in degree ",
 Cell[BoxData[
  FormBox["3", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "26fd78ca-6fab-4dff-8f2a-38210414801d"],
 ": the degenerate subspace is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["R",
     FontSlant->"Plain"], 
    RowBox[{"{", 
     StyleBox["c", "TI"], "}"}]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6a1494cd-5dcb-47c2-9a46-0e584cf3228a"],
 ", and ",
 Cell[BoxData[
  FormBox[
   StyleBox["c", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4863fd34-6960-423d-a537-b3e8cae8939d"],
 " is closed and is not the differential of anything degenerate, so ",
 Cell[BoxData["DegenerateCohomology"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3b0a0d56-6f19-4ca4-b9d1-26875ee15e7c"],
 " is ",
 Cell[BoxData[
  FormBox["1", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "28a85781-c490-49cb-9bf5-694d8efea587"],
 " there."
}], "Text",ExpressionUUID->"00380956-3ed6-4cda-868c-2ecd9cf5fc78"],

