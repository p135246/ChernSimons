Cell[TextData[{
 "Every row has ",
 Cell[BoxData[
 "Degenerate"], "InlineFormula",ExpressionUUID->
  "51020d97-6a86-41ca-b776-3a55d48582d2"],
 " zero and ",
 Cell[BoxData[
 "Dimension"], "InlineFormula",ExpressionUUID->
  "459dbf7a-cfd8-442f-b5a1-73a063583e81"],
 " equal to ",
 Cell[BoxData[
 "Quotient"], "InlineFormula",ExpressionUUID->
  "b27cb095-d74b-495d-9099-2b39914f452e"],
 ": the model ",
 StyleBox["is", "TI"],
 " its own nondegenerate quotient, an eight-dimensional differential Poincar\
\[EAcute] duality algebra of degree ",
 Cell[BoxData[
  FormBox["3", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "3aa4d7dd-417e-4223-8424-9209b2f56030"],
 ". The Betti numbers ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", ",", "2", ",", "2", ",", "1"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"7d6d2837-0659-42d1-9988-e77983a2b504"],
 " read off the ",
 Cell[BoxData[
 "Cohomology"], "InlineFormula",ExpressionUUID->
  "9626f8fa-292b-499f-8667-2d31c1b40394"],
 " column and are symmetric, as Poincar\[EAcute] duality demands."
}], "Text",ExpressionUUID->"0f5b7ce2-8cb6-4c41-a810-1af7fb3cba75"],

Cell[TextData[{
 "Unlike ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["CP",
     FontSlant->"Plain"], 
    StyleBox["m", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "aec6d57b-fccc-47a9-8715-b933ee3a6184"],
 ", this quotient carries a nonzero differential, because the nilmanifold is \
not formal:"
}], "Text",ExpressionUUID->"4907cc1a-c80f-4dee-aad1-fbdd79474dc8"],

