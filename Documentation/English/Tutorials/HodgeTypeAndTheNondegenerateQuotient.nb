Cell["When it fails", "Section",ExpressionUUID->"25dcf148-e0f4-4f0a-8b04-e0342dfc59e9"],

Cell[TextData[{
 "Example 6.3 of the reference is a ",
 Cell[BoxData[
  FormBox["1", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "5974c79a-6e9b-433b-a106-c7145117debe"],
 "-connected PDGA of degree ",
 Cell[BoxData[
  FormBox["4", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "ec07fb87-a831-49ca-bdc0-a59a7ebba465"],
 " that is not of Hodge type. Take one generator ",
 Cell[BoxData[
  FormBox[
   StyleBox["a", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "b23973da-d0a9-4ef1-873f-84f438db6621"],
 " of degree ",
 Cell[BoxData[
  FormBox["2", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "f6afa388-53eb-4c07-9c89-5236274405c4"],
 " and one generator ",
 Cell[BoxData[
  FormBox[
   StyleBox["c", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "92dd522d-09ec-47b7-8f4b-45188ebfd0d8"],
 " of degree ",
 Cell[BoxData[
  FormBox["3", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "5ad03bc6-6be9-42dc-8f17-f4ce119b9f96"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["d",
     FontSlant->"Plain"], 
    StyleBox["a", "TI"], "\[LongEqual]", 
    StyleBox["c", "TI"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "8fc835e1-aa08-4c3e-9957-18d79c511397"],
 ", and truncate everything above degree ",
 Cell[BoxData[
  FormBox["4", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "8a18c584-d789-4b36-ac07-c44f902d3a03"],
 "; the orientation is the coefficient of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["a", "TI"], "2"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"c4612600-ffb7-4d51-a517-448e36510766"],
 "."
}], "Text",ExpressionUUID->"f7b47db0-512d-4092-bd0b-696eb92aff50"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"bad", " ", "=", " ", 
   RowBox[{"SullivanModel", "[", "\"\<Degree4Obstruction\>\"", "]"}]}], 
  ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Normal", "[", 
    RowBox[{"bad", "[", "\"\<Generators\>\"", "]"}], "]"}], ",", " ", 
   RowBox[{"bad", "[", "\"\<Orientation\>\"", "]"}], ",", " ", 
   RowBox[{"bad", "[", "\"\<Truncation\>\"", "]"}]}], "}"}]}], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"01461641-cd98-4c6e-bb25-eef3999a5054"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a", "\[Rule]", "2"}], ",", 
     RowBox[{"c", "\[Rule]", "3"}]}], "}"}], ",", 
   RowBox[{"\[LeftAssociation]", 
    RowBox[{
     SuperscriptBox["a", "2"], "\[Rule]", "1"}], "\[RightAssociation]"}], ",", 
   RowBox[{"\[LeftAssociation]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"a", ",", "c"}], "}"}], "\[Rule]", "4"}], 
    "\[RightAssociation]"}]}], "}"}]], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"dc0faffa-eaf0-4e11-920d-23c71e133243"]
}, Open  ]],

Cell[TextData[{
 "The truncation is what makes this finite: the ideal of monomials above \
degree ",
 Cell[BoxData[
  FormBox["4", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "262abec8-f2f5-466c-9f5b-532e5a56db3f"],
 " is a differential graded ideal, so the quotient is a CDGA, and it is \
four-dimensional."
}], "Text",ExpressionUUID->"0c122d27-fe13-4024-9b89-6ee67ac35cf6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", 
  RowBox[{
   RowBox[{"SullivanModelBasis", "[", 
    RowBox[{"bad", ",", " ", "k"}], "]"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"k", ",", " ", "0", ",", " ", "5"}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[4]:= ",ExpressionUUID->"bb8e1337-4f8e-4fd4-887e-26b0fb6af7c2"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", "1", "}"}], ",", 
   RowBox[{"{", "}"}], ",", 
   RowBox[{"{", "a", "}"}], ",", 
   RowBox[{"{", "c", "}"}], ",", 
   RowBox[{"{", 
    SuperscriptBox["a", "2"], "}"}], ",", 
   RowBox[{"{", "}"}]}], "}"}]], "Output",
 CellLabel->"Out[4]= ",ExpressionUUID->"c4afcf36-e922-4c11-aff3-95c3fb7bf2ac"]
}, Open  ]],

Cell[TextData[{
 "Its cohomology is ",
 Cell[BoxData[
  FormBox[
   StyleBox["R",
    FontSlant->"Plain"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "365a594e-b600-4b82-886c-d83b8ae79cb5"],
 " in degree ",
 Cell[BoxData[
  FormBox["0", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "e92db02b-1bd0-4bb1-89dc-72c47d7420ba"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["R",
     FontSlant->"Plain"], 
    RowBox[{"{", 
     SuperscriptBox[
      StyleBox["a", "TI"], "2"], "}"}]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"b8b9acbc-2184-42b1-b8df-5e08222cfade"],
 " in degree ",
 Cell[BoxData[
  FormBox["4", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "61071f6e-1aeb-4e6c-8090-8ad5108450b6"],
 ", the cohomology of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["S", "TI"], "4"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"b3059749-86bf-4b14-82a0-ab49e3c7ebf3"],
 ", and the pairing on it is perfect, so this is an oriented PDGA of degree \
",
 Cell[BoxData[
  FormBox["4", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "a923c3bc-69c0-42e3-a358-cabf39999711"],
 ". But ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{
      StyleBox["a", "TI"], ",", 
      StyleBox["a", "TI"]}], "\[RightAngleBracket]"}], "\[LongEqual]", 
    StyleBox["O", "TI"], 
    RowBox[{"(", 
     SuperscriptBox[
      StyleBox["a", "TI"], "2"], ")"}], "\[LongEqual]", "1"}], 
   TraditionalForm]], "InlineFormula",ExpressionUUID->
  "fa344271-3b43-42cc-9994-441207db1d47"],
 ", and ",
 Cell[BoxData[
  FormBox[
   StyleBox["a", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "4f2688de-59ef-4d37-b240-70b44d9bf595"],
 " spans the whole of degree ",
 Cell[BoxData[
  FormBox["2", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "ed7fe755-03d9-4ac3-8990-5011af70f8fc"],
 ", so the coexact part in degree ",
 Cell[BoxData[
  FormBox["2", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "4f3d37b3-7f85-4a85-a4df-2ab8ab09ef47"],
 " can only be ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["R",
     FontSlant->"Plain"], 
    RowBox[{"{", 
     StyleBox["a", "TI"], "}"}]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"0630e0fb-e576-43f9-97b0-a80f703a671b"],
 ", which is not isotropic. No Hodge decomposition exists."
}], "Text",ExpressionUUID->"339bfa48-470c-45d6-b329-289e1ee455d7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"SullivanModelPairing", "[", 
    RowBox[{"a", ",", " ", "a", ",", " ", "bad"}], "]"}], ",", " ", 
   RowBox[{"HodgeTypeQ", "[", "bad", "]"}]}], "}"}]], "Input",
 CellLabel->"In[5]:= ",ExpressionUUID->"b6fd35b7-2123-4f20-b3b6-fb5f65e103ac"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"1", ",", "False"}], "}"}]], "Output",
 CellLabel->"Out[5]= ",ExpressionUUID->"3d82ec62-a303-41a5-a57f-f88376c91d2e"]
}, Open  ]],

Cell[TextData[{
 "The obstruction is visible in the report, in degree ",
 Cell[BoxData[
  FormBox["3", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "0d5120de-2371-442c-a67e-6a56b97cb439"],
 ": the degenerate subspace is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["R",
     FontSlant->"Plain"], 
    RowBox[{"{", 
     StyleBox["c", "TI"], "}"}]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"7ed65cf4-075f-425f-bee7-92e97a313901"],
 ", and ",
 Cell[BoxData[
  FormBox[
   StyleBox["c", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "befd053e-0951-4849-83aa-a7dd0af30d70"],
 " is closed and is not the differential of anything degenerate, so ",
 Cell[BoxData[
 "DegenerateCohomology"], "InlineFormula",ExpressionUUID->
  "0f82d8d0-6f0d-4082-b491-ab6e3dbe8135"],
 " is ",
 Cell[BoxData[
  FormBox["1", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "9f85179a-4597-4dd9-8d19-4811313841df"],
 " there."
}], "Text",ExpressionUUID->"ed1f6b08-48fc-4b37-ab5d-096897f17403"],

