Cell[TextData[{
 "That entry is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{
      StyleBox["d",
       FontSlant->"Plain"], 
      StyleBox["z", "TI"], ",", 
      StyleBox["z", "TI"]}], "\[RightAngleBracket]"}], "\[LongEqual]", 
    StyleBox["O", "TI"], 
    RowBox[{"(", 
     StyleBox[
      RowBox[{"x", "y", "z"}], "TI"], ")"}], "\[LongEqual]", "1"}], 
   TraditionalForm]], "InlineFormula",ExpressionUUID->
  "1bd7f359-5ced-435d-bbc6-2fb64cea4606"],
 ", the second basis vector being ",
 Cell[BoxData[
  FormBox[
   StyleBox["z", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "5c0f9598-53b4-404a-bc14-3adcb15af118"],
 ". The differential of the quotient, in the basis, is the same information \
with the Gram matrix divided out:"
}], "Text",ExpressionUUID->"901a01a0-b7c9-4621-8656-a53dc4aae0b9"],

