Cell["When it fails", "Section",ExpressionUUID->"bf77d8de-a7f9-45f8-99b6-9ef61a91f4a0"],

Cell[TextData[{
 "Example 6.3 of the reference is a ",
 Cell[BoxData[
  FormBox["1", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "c09eb8dd-a930-4512-969a-fc35dc217b6f"],
 "-connected PDGA of degree ",
 Cell[BoxData[
  FormBox["4", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "fa6b0892-6124-4626-9aa1-b3b7140d4dcd"],
 " that is not of Hodge type. Take one generator ",
 Cell[BoxData[
  FormBox[
   StyleBox["a", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "002639ac-2ce1-49d2-be5b-b3858170e7c4"],
 " of degree ",
 Cell[BoxData[
  FormBox["2", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "ee18c67a-8bc2-4869-9881-c4494138759c"],
 " and one generator ",
 Cell[BoxData[
  FormBox[
   StyleBox["c", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "75c624fb-12bd-4e16-b193-8e37ec370c7e"],
 " of degree ",
 Cell[BoxData[
  FormBox["3", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "a1f14f0e-3945-4af9-81e5-21552d86997a"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["d",
     FontSlant->"Plain"], 
    StyleBox["a", "TI"], "\[LongEqual]", 
    StyleBox["c", "TI"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "1b7d7df6-fc4c-43a9-87e4-b670b3a664c4"],
 ", and truncate everything above degree ",
 Cell[BoxData[
  FormBox["4", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "a83b99a6-3cdb-4de6-a57a-b144de265f81"],
 "; the orientation is the coefficient of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["a", "TI"], "2"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"4fed64a2-a246-44bd-8572-2fc8a0e5dfbb"],
 "."
}], "Text",ExpressionUUID->"90a2c1fa-d829-444c-94e6-7d09d77816eb"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"bad", " ", "=", " ", 
   RowBox[{"SullivanModel", "[", "\"\<Degree4Obstruction\>\"", "]"}]}], 
  ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Normal", "[", 
    RowBox[{"bad", "[", "\"\<Generators\>\"", "]"}], "]"}], ",", " ", 
   RowBox[{"bad", "[", "\"\<Orientation\>\"", "]"}], ",", " ", 
   RowBox[{"bad", "[", "\"\<Truncation\>\"", "]"}]}], "}"}]}], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"3d3e3f11-8c6d-44f2-9a0e-747bde763a20"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a", "\[Rule]", "2"}], ",", 
     RowBox[{"c", "\[Rule]", "3"}]}], "}"}], ",", 
   RowBox[{"\[LeftAssociation]", 
    RowBox[{
     SuperscriptBox["a", "2"], "\[Rule]", "1"}], "\[RightAssociation]"}], ",", 
   RowBox[{"\[LeftAssociation]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"a", ",", "c"}], "}"}], "\[Rule]", "4"}], 
    "\[RightAssociation]"}]}], "}"}]], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"db5aa604-660b-4f7e-943a-d80d327dd599"]
}, Open  ]],

Cell[TextData[{
 "The truncation is what makes this finite: the ideal of monomials above \
degree ",
 Cell[BoxData[
  FormBox["4", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "307209cc-1621-4cac-83ba-235425cb1d05"],
 " is a differential graded ideal, so the quotient is a CDGA, and it is \
four-dimensional."
}], "Text",ExpressionUUID->"4da700df-b97e-4a0b-bf3f-fef313450a01"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", 
  RowBox[{
   RowBox[{"SullivanModelBasis", "[", 
    RowBox[{"bad", ",", " ", "k"}], "]"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"k", ",", " ", "0", ",", " ", "5"}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[4]:= ",ExpressionUUID->"a6fe4c27-d516-4f8a-8e3c-615e8c2bcdf4"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", "1", "}"}], ",", 
   RowBox[{"{", "}"}], ",", 
   RowBox[{"{", "a", "}"}], ",", 
   RowBox[{"{", "c", "}"}], ",", 
   RowBox[{"{", 
    SuperscriptBox["a", "2"], "}"}], ",", 
   RowBox[{"{", "}"}]}], "}"}]], "Output",
 CellLabel->"Out[4]= ",ExpressionUUID->"e4ad47a0-f9e9-4837-9717-ba91acf9690a"]
}, Open  ]],

Cell[TextData[{
 "Its cohomology is ",
 Cell[BoxData[
  FormBox[
   StyleBox["R",
    FontSlant->"Plain"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "f4cd2339-0019-4bea-ae66-7535196e8895"],
 " in degree ",
 Cell[BoxData[
  FormBox["0", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "9ab668df-7d49-4d10-b1cb-664d3cf9c360"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["R",
     FontSlant->"Plain"], 
    RowBox[{"{", 
     SuperscriptBox[
      StyleBox["a", "TI"], "2"], "}"}]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"84939684-f7d6-4aa8-a47e-e5ab25e72c87"],
 " in degree ",
 Cell[BoxData[
  FormBox["4", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "5ba836eb-3e97-4295-abe3-386943fd1aa4"],
 ", the cohomology of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["S", "TI"], "4"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"0462176a-a0cb-4d1d-86aa-ef904b5af05a"],
 ", and the pairing on it is perfect, so this is an oriented PDGA of degree \
",
 Cell[BoxData[
  FormBox["4", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "93d5d759-a4d7-4cec-b667-c5375e9d8b25"],
 ". But ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{
      StyleBox["a", "TI"], ",", 
      StyleBox["a", "TI"]}], "\[RightAngleBracket]"}], "\[LongEqual]", 
    StyleBox["O", "TI"], 
    RowBox[{"(", 
     SuperscriptBox[
      StyleBox["a", "TI"], "2"], ")"}], "\[LongEqual]", "1"}], 
   TraditionalForm]], "InlineFormula",ExpressionUUID->
  "dcf268a5-7bcd-47e2-9201-d4f7dbefe9a0"],
 ", and ",
 Cell[BoxData[
  FormBox[
   StyleBox["a", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "a3cf36fb-c540-41c2-a1dd-cccd853fbc3d"],
 " spans the whole of degree ",
 Cell[BoxData[
  FormBox["2", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "6fe6016c-267b-4de6-8e11-641c7a96fa97"],
 ", so the coexact part in degree ",
 Cell[BoxData[
  FormBox["2", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "0cbf64b4-4da5-4d38-8406-2dd933d2cfe1"],
 " can only be ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["R",
     FontSlant->"Plain"], 
    RowBox[{"{", 
     StyleBox["a", "TI"], "}"}]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"87ae1674-7a5e-4f40-b5f3-88256f3cb5b1"],
 ", which is not isotropic. No Hodge decomposition exists."
}], "Text",ExpressionUUID->"d61e7351-454f-4bc5-abf9-a8a9a6691c63"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"SullivanModelPairing", "[", 
    RowBox[{"a", ",", " ", "a", ",", " ", "bad"}], "]"}], ",", " ", 
   RowBox[{"HodgeTypeQ", "[", "bad", "]"}]}], "}"}]], "Input",
