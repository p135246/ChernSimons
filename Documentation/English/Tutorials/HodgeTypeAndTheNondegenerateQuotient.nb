Cell["When it fails", "Section",ExpressionUUID->"9ce86d1c-27c0-440f-a491-d7d3e53ef2d3"],

Cell[TextData[{
 "Example 6.3 of the reference is a ",
 Cell[BoxData[
  FormBox["1", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "023af0ab-5585-43b6-8572-3c4de8171593"],
 "-connected PDGA of degree ",
 Cell[BoxData[
  FormBox["4", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "67ca1200-a524-4d80-b5fa-35bcf10132e6"],
 " that is not of Hodge type. Take one generator ",
 Cell[BoxData[
  FormBox[
   StyleBox["a", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4c697442-0709-4cf2-92e1-c8d5b053dbe6"],
 " of degree ",
 Cell[BoxData[
  FormBox["2", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f02c00e6-f7b7-4e33-b3d4-5e0e178c6be0"],
 " and one generator ",
 Cell[BoxData[
  FormBox[
   StyleBox["c", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "74f965e9-beb5-4dcd-a6b3-bed5e70150ee"],
 " of degree ",
 Cell[BoxData[
  FormBox["3", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8066edd5-5dd5-4a28-846b-83e3e99b2c92"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["d",
     FontSlant->"Plain"], 
    StyleBox["a", "TI"], "\[LongEqual]", 
    StyleBox["c", "TI"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "02434b2e-0731-4f00-874f-dce923650d41"],
 ", and truncate everything above degree ",
 Cell[BoxData[
  FormBox["4", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a34417f4-6135-4b76-90b7-173abc5d27c4"],
 "; the orientation is the coefficient of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["a", "TI"], "2"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8cafe51f-2214-4e88-8597-5bcdc7298885"],
 "."
}], "Text",ExpressionUUID->"d4707480-14f5-4ea2-a745-fc43a31835a9"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"bad", " ", "=", " ", 
   RowBox[{"SullivanModel", "[", "\"\<Degree4Obstruction\>\"", "]"}]}], 
  ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Normal", "[", 
    RowBox[{"bad", "[", "\"\<Generators\>\"", "]"}], "]"}], ",", " ", 
   RowBox[{"bad", "[", "\"\<Orientation\>\"", "]"}], ",", " ", 
   RowBox[{"bad", "[", "\"\<Truncation\>\"", "]"}]}], "}"}]}], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"270621aa-28fd-41f1-8138-7546d2823322"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a", "\[Rule]", "2"}], ",", 
     RowBox[{"c", "\[Rule]", "3"}]}], "}"}], ",", 
   RowBox[{"\[LeftAssociation]", 
    RowBox[{
     SuperscriptBox["a", "2"], "\[Rule]", "1"}], "\[RightAssociation]"}], ",", 
   RowBox[{"\[LeftAssociation]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"a", ",", "c"}], "}"}], "\[Rule]", "4"}], 
    "\[RightAssociation]"}]}], "}"}]], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"2a9020bb-48f3-46ee-90a6-cc6b7fcb609f"]
}, Open  ]],

Cell[TextData[{
 "The truncation is what makes this finite: the ideal of monomials above \
degree ",
 Cell[BoxData[
  FormBox["4", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c187ea59-9dcb-4064-a4d7-de87bdf84b13"],
 " is a differential graded ideal, so the quotient is a CDGA, and it is \
four-dimensional."
}], "Text",ExpressionUUID->"752e1899-d53f-45f4-b3d0-9f7c881b1995"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", 
  RowBox[{
   RowBox[{"SullivanModelBasis", "[", 
    RowBox[{"bad", ",", " ", "k"}], "]"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"k", ",", " ", "0", ",", " ", "5"}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[4]:= ",ExpressionUUID->"f5eb69fe-81d0-4360-b9e7-2ca8bd02add8"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", "1", "}"}], ",", 
   RowBox[{"{", "}"}], ",", 
   RowBox[{"{", "a", "}"}], ",", 
   RowBox[{"{", "c", "}"}], ",", 
   RowBox[{"{", 
    SuperscriptBox["a", "2"], "}"}], ",", 
   RowBox[{"{", "}"}]}], "}"}]], "Output",
 CellLabel->"Out[4]= ",ExpressionUUID->"928373b0-d5e0-40ce-af32-325e75f290ce"]
}, Open  ]],

Cell[TextData[{
 "Its cohomology is ",
 Cell[BoxData[
  FormBox[
   StyleBox["R",
    FontSlant->"Plain"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c184559d-a713-4df6-9c12-ad6c23c07b5a"],
 " in degree ",
 Cell[BoxData[
  FormBox["0", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "88ab5b69-a58d-4592-b1a3-b4f6548d7e79"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["R",
     FontSlant->"Plain"], 
    RowBox[{"{", 
     SuperscriptBox[
      StyleBox["a", "TI"], "2"], "}"}]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1172bfd3-4efa-444e-966f-5896a6094493"],
 " in degree ",
 Cell[BoxData[
  FormBox["4", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "64eb4162-dd59-4db2-8f56-e9cbd2908951"],
 ", the cohomology of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["S", "TI"], "4"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "083983bf-9b2e-4f22-bb29-e5d4112de626"],
 ", and the pairing on it is perfect, so this is an oriented PDGA of degree \
",
 Cell[BoxData[
  FormBox["4", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cd4e9281-1cb0-4228-bd29-1531f6832acc"],
 ". But ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{
      StyleBox["a", "TI"], ",", 
      StyleBox["a", "TI"]}], "\[RightAngleBracket]"}], "\[LongEqual]", 
    StyleBox["O", "TI"], 
    RowBox[{"(", 
     SuperscriptBox[
      StyleBox["a", "TI"], "2"], ")"}], "\[LongEqual]", "1"}], 
   TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "82ce102e-3762-4136-880a-7cb2bb9e1d6c"],
 ", and ",
 Cell[BoxData[
  FormBox[
   StyleBox["a", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0ddb2089-f269-4fb4-a64a-4c7badaacb6f"],
 " spans the whole of degree ",
 Cell[BoxData[
  FormBox["2", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7cc81a82-8f82-42d0-a20c-0df2284ead43"],
 ", so the coexact part in degree ",
 Cell[BoxData[
  FormBox["2", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5bc59d54-6b8e-42e8-9758-c1fcaa8daa37"],
 " can only be ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["R",
     FontSlant->"Plain"], 
    RowBox[{"{", 
     StyleBox["a", "TI"], "}"}]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c6639474-2b13-4c18-a5b1-a3156fc956f3"],
 ", which is not isotropic. No Hodge decomposition exists."
}], "Text",ExpressionUUID->"b09989f9-dc5c-4729-a3b4-763ed895e22f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"SullivanModelPairing", "[", 
