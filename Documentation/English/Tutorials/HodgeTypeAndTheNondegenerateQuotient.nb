 CellLabel->"Out[7]= ",ExpressionUUID->"0b193978-7fb6-4531-99af-13df4c16a136"]
}, Open  ]],

Cell[TextData[{
 "The consequence is exactly what the theory predicts: the quotient is ",
 StyleBox["not", "TI"],
 " quasi-isomorphic to the model. It is three-dimensional with zero \
differential: the cohomology of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["CP",
     FontSlant->"Plain"], "2"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"b277989d-61d4-4c23-bf5a-fc834d33333e"],
 ", not of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["S", "TI"], "4"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"61798c25-8f47-4c35-89b6-14a30f3c93ac"],
 "."
}], "Text",ExpressionUUID->"b8cc5753-36fb-4014-b3cd-4f7d91798e61"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"quotient", " ", "=", " ", 
   RowBox[{"NondegenerateQuotient", "[", "bad", "]"}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"quotient", "[", "\"\<Basis\>\"", "]"}], ",", " ", 
   RowBox[{"quotient", "[", "\"\<Differential\>\"", "]"}], ",", " ", 
   RowBox[{"Total", "[", 
    RowBox[{"Values", "[", 
     RowBox[{
      RowBox[{"HodgeTypeReport", "[", "bad", "]"}], "[", 
      RowBox[{"All", ",", " ", "\"\<Cohomology\>\""}], "]"}], "]"}], "]"}]}], 
  "}"}]}], "Input",
 CellLabel->"In[8]:= ",ExpressionUUID->"26cbf222-2455-4a42-aede-1a3cbec78695"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", "a", ",", 
     SuperscriptBox["a", "2"]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", "0"}], "}"}]}], "}"}], ",", "2"}], 
  "}"}]], "Output",
 CellLabel->"Out[8]= ",ExpressionUUID->"056ebdda-1b8e-414a-9a2c-20accc0b0a9a"]
}, Open  ]],

Cell[TextData[{
 "Three against two: the quotient map has killed the class of ",
 Cell[BoxData[
  FormBox[
   StyleBox["c", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "debd50a1-9250-4be9-b685-1b8b99c8cca8"],
 " but not the class ",
 Cell[BoxData[
  FormBox[
   RowBox[{"[", 
    StyleBox["a", "TI"], "]"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"de803f1a-dafd-4625-8c22-f0d495e23618"],
 " that ought to have died with it. The repair in the reference is to ",
 StyleBox["extend", "TI"],
 " ",
 Cell[BoxData[
  FormBox[
   StyleBox["V", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "4a66073d-f0d0-44db-bd2e-7dde9e5cb1d0"],
 " to a larger PDGA of Hodge type that retracts onto it; the extension \
adjoins a generator in degree ",
 Cell[BoxData[
  FormBox["1", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "953ab6b1-03e2-4f63-9912-ce7d738d0275"],
 ", which is why this example also shows that no ",
 Cell[BoxData[
  FormBox["1", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "c3fa3e98-8e75-46cc-8b7e-19f61c89e622"],
 "-connected extension of Hodge type exists in degree ",
 Cell[BoxData[
  FormBox["4", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "00ce65df-1a5d-48e6-8f77-81a410be7609"],
 "."
}], "Text",ExpressionUUID->"b2b8fb66-934a-4c2b-8ab9-b6b324e9c781"],

Cell["When the model is already a dPD algebra", "Section",ExpressionUUID->"ba1802ea-b5de-4341-92b9-6fe30ddcdcd9"],

Cell[TextData[{
 "At the other extreme are models whose pairing is already perfect on chain \
level, so ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["V", "TI"], 
     StyleBox["deg",
      FontSlant->"Plain"]], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"6e3dad7c-18ff-4dfc-9bf7-abd010848bd5"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["Q", "TI"], 
    RowBox[{"(", 
     StyleBox["V", "TI"], ")"}], "\[LongEqual]", 
    StyleBox["V", "TI"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "d9f37824-ea3f-45d7-a002-099ed5412989"],
 ". The minimal model of a nilmanifold is one: a finite-dimensional exterior \
algebra on generators of degree ",
 Cell[BoxData[
  FormBox["1", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "7ec262fb-6d53-40fa-9f49-1cccc6cbbfd2"],
 ", with the differential of the nilpotent Lie algebra."
}], "Text",ExpressionUUID->"fcae282a-7e80-454b-9ef4-8f1160e3e44c"],

Cell[TextData[{
 "The three-dimensional Heisenberg nilmanifold has ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalLambda]", "(", 
    RowBox[{
     StyleBox["x", "TI"], ",", 
     StyleBox["y", "TI"], ",", 
     StyleBox["z", "TI"]}], ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"f9d35f0c-6e0b-4a69-aa4a-b3b4205d50ef"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["d",
     FontSlant->"Plain"], 
    StyleBox["z", "TI"], "\[LongEqual]", 
    StyleBox["x", "TI"], 
    StyleBox["y", "TI"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "966ec060-3b7e-41ca-b568-9851c180f3dc"],
 ", and the orientation ",
 Cell[BoxData[
  FormBox["1", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "63d5b7ec-1af5-4a2b-a580-b5a9f5426ec5"],
 " on ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"x", "y", "z"}], "TI"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"5e2f500f-24ee-4da5-9c58-db5c76903107"],
 "."
}], "Text",ExpressionUUID->"82e7ac1a-2cfd-4030-a2da-9337e218816f"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"heis", " ", "=", " ", 
