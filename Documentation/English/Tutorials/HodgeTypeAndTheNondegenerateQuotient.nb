Cell[BoxData[
 RowBox[{"DegenerateSubspace", "[", 
  RowBox[{"bad", ",", " ", "3"}], "]"}]], "Input",
 CellLabel->"In[7]:= ",ExpressionUUID->"b28525a1-dc0c-42dc-b6f3-ad020b21bad0"],

Cell[BoxData[
