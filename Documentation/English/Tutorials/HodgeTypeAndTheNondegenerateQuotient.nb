Notebook[{

Cell[CellGroupData[{
Cell["Hodge Type and the Nondegenerate Quotient", "Title",
 CellID->509267359,ExpressionUUID->"4ddb5767-1f00-4973-a411-49eacd07850d"],

Cell[TextData[{
 "An oriented PDGA ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     StyleBox["V", "TI"], ",", 
     StyleBox["d",
      FontSlant->"Plain"], ",", 
     StyleBox["O", "TI"]}], ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"a243dd45-fd40-4ad2-bc17-216041b4f705"],
 " satisfies Poincar\[EAcute] duality on cohomology but almost never on chain \
level. The construction that repairs this divides out the part of ",
 Cell[BoxData[
  FormBox[
   StyleBox["V", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "ee597053-94cd-43b2-b531-93677ef5875d"],
 " that the pairing cannot see, and the question is whether the division \
loses cohomology. It does not exactly when ",
 Cell[BoxData[
  FormBox[
   StyleBox["V", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "c60ba565-b33d-4ce4-bdb3-67949ebc3ed9"],
 " is ",
 StyleBox["of Hodge type", "TI"],
 ". This tutorial is about that test: what it computes, in which degrees, and \
what it looks like when it fails."
}], "Text",ExpressionUUID->"00243080-78b1-4699-a700-fd7196c7f218"],

Cell[TextData[{
 "The reference is ",
 ButtonBox["arXiv:2004.07362",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://arxiv.org/abs/2004.07362"], None}],
 ", ",
 StyleBox["Hodge decompositions and Poincar\[EAcute] duality models", "TI"],
 "."
}], "Text",ExpressionUUID->"d48dbd6a-5e62-4c2c-a823-e6fe5cee02c4"],

Cell["Three subspaces", "Section",ExpressionUUID->"9f81c30a-2663-4443-a5d6-b35f72bce795"],

Cell[TextData[{
 "Write ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{
      SubscriptBox[
       StyleBox["v", "TI"], "1"], ",", 
      SubscriptBox[
       StyleBox["v", "TI"], "2"]}], "\[RightAngleBracket]"}], "\[LongEqual]", 
    
    StyleBox["O", "TI"], 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox[
       StyleBox["v", "TI"], "1"], 
      SubscriptBox[
       StyleBox["v", "TI"], "2"]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"bdabcd45-753d-40d3-8469-2dbf8ad6195e"],
 ". A ",
 StyleBox["Hodge decomposition", "TI"],
 " is a splitting"
}], "Text",ExpressionUUID->"419042e9-5325-406d-b58d-79a0bacc023f"],

Cell[BoxData[
 PaneBox[
  FormBox[
   RowBox[{
    RowBox[{
     StyleBox["V", "TI"], "\[LongEqual]", 
     RowBox[{
      StyleBox["H", "TI"], "\[CirclePlus]", 
      RowBox[{
       StyleBox["im",
        FontSlant->"Plain"], " ", 
       StyleBox["d",
        FontSlant->"Plain"]}], "\[CirclePlus]", 
      StyleBox["C", "TI"]}]}], ",", "    ", 
    RowBox[{
     StyleBox["C", "TI"], "\[Perpendicular]", 
     RowBox[{
      StyleBox["C", "TI"], "\[CirclePlus]", 
      StyleBox["H", "TI"]}]}], ","}],
   TraditionalForm],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",ExpressionUUID->"37b7cf9b-875f-4244-\
8e0d-a022eebcbfc8"],

Cell[TextData[{
 "with ",
 Cell[BoxData[
  FormBox[
   StyleBox["H", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "cfa84944-eb72-4bb1-98f7-466eedfedcf3"],
 " a complement of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["im",
     FontSlant->"Plain"], " ", 
    StyleBox["d",
     FontSlant->"Plain"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "9dc19294-9fee-4045-9c6a-0441caa33833"],
 " in ",
 Cell[BoxData[
  FormBox[
   RowBox[{"ker", 
    StyleBox["d",
     FontSlant->"Plain"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "a09e2da1-87eb-4344-83d7-c0125b994c6d"],
 " and ",
 Cell[BoxData[
  FormBox[
   StyleBox["C", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "1a8f6e99-b99d-471e-a675-d08393ca53fe"],
 " a complement of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"ker", 
    StyleBox["d",
     FontSlant->"Plain"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "9421f9e0-19ff-4add-b5a8-19ed9888b767"],
 " in ",
 Cell[BoxData[
  FormBox[
   StyleBox["V", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "458556ee-259d-40bd-972f-38979f20b747"],
 ". Dropping the condition ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["C", "TI"], "\[Perpendicular]", 
    StyleBox["C", "TI"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "c05a5e4e-e958-49d3-a98c-fad16510bb96"],
 " leaves a ",
 StyleBox["pre-Hodge", "TI"],
 " decomposition, and one of those exists for any PDGA; the whole difficulty \
is the isotropy of ",
 Cell[BoxData[
  FormBox[
   StyleBox["C", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "dc59744b-eec9-4564-a2c5-73f67f23417f"],
 "."
}], "Text",ExpressionUUID->"e49ff346-5f58-4c6a-8b73-7fb5a017d21b"],

Cell[TextData[{
 "The ",
 StyleBox["degenerate subspace", "TI"],
 " is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["V", "TI"], 
     StyleBox["deg",
      FontSlant->"Plain"]], "\[LongEqual]", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["v", "TI"], "|", 
      StyleBox["v", "TI"], "\[Perpendicular]", 
      StyleBox["V", "TI"]}], "}"}]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"6d5efa27-df3a-4fa3-956c-6e959a412857"],
 " and the ",
 StyleBox["nondegenerate quotient", "TI"],
 " is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["Q", "TI"], 
    RowBox[{"(", 
     StyleBox["V", "TI"], ")"}], "\[LongEqual]", 
    StyleBox["V", "TI"], "/", 
    SubscriptBox[
     StyleBox["V", "TI"], 
     StyleBox["deg",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"0eceb58f-1335-4575-ba2c-9e0c91f499a3"],
 ". Because ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{
      StyleBox["d",
       FontSlant->"Plain"], 
      SubscriptBox[
       StyleBox["v", "TI"], "1"], ",", 
      SubscriptBox[
       StyleBox["v", "TI"], "2"]}], "\[RightAngleBracket]"}], "\[LongEqual]", 
    "\[PlusMinus]", 
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{
      SubscriptBox[
       StyleBox["v", "TI"], "1"], ",", 
      StyleBox["d",
       FontSlant->"Plain"], 
      SubscriptBox[
       StyleBox["v", "TI"], "2"]}], "\[RightAngleBracket]"}]}], 
   TraditionalForm]], "InlineFormula",ExpressionUUID->
  "ea11febd-e5af-4420-a21d-05c6ac11a795"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{
      SubscriptBox[
       StyleBox["v", "TI"], "1"], 
      SubscriptBox[
       StyleBox["v", "TI"], "2"], ",", 
      SubscriptBox[
       StyleBox["v", "TI"], "3"]}], "\[RightAngleBracket]"}], "\[LongEqual]", 
    
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{
      SubscriptBox[
       StyleBox["v", "TI"], "1"], ",", 
      SubscriptBox[
       StyleBox["v", "TI"], "2"], 
      SubscriptBox[
       StyleBox["v", "TI"], "3"]}], "\[RightAngleBracket]"}]}], 
   TraditionalForm]], "InlineFormula",ExpressionUUID->
  "545049fd-4336-42e2-a1fc-20d1bccb423f"],
 ", the degenerate subspace is a differential graded ideal, so the quotient \
is again a CDGA with an orientation, and the pairing on it is nondegenerate \
by construction."
}], "Text",ExpressionUUID->"7ab73f8e-abb4-4ad9-bdf0-a546373bea28"],

Cell["\<\
Two facts tie the notions together, both from the reference and both used \
here:\
\>", "Text",ExpressionUUID->"5c765a0b-dd5f-4284-9fd2-7e6990b6030c"],

Cell[TextData[{
 "if ",
 Cell[BoxData[
  FormBox[
   StyleBox["V", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "da2ac1e7-0da5-49dd-b1c6-72ec04d1195d"],
 " is of Hodge type and the pairing on ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["H", "TI"], "(", 
    StyleBox["V", "TI"], ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"56036a2c-07f2-4de6-ac3f-93f90b83ba7e"],
 " is nondegenerate, then ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Pi]", 
     StyleBox["Q", "TI"]], ":", 
    StyleBox["V", "TI"], "\[Rule]", 
    StyleBox["Q", "TI"], 
    RowBox[{"(", 
     StyleBox["V", "TI"], ")"}]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"ee1aecd6-7dbb-4246-984e-851d8d21dda9"],
 " is a quasi-isomorphism;"
}], "Item",ExpressionUUID->"9ea979dc-ab1c-46c3-9137-cd95a6cf6a14"],

Cell[TextData[{
 "conversely, in characteristic ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[NotEqual]", "2"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"8e4bdcdb-029f-4ea2-bb45-bd736442c283"],
 ", if ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Pi]", 
    StyleBox["Q", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "86f1f527-c096-4024-b4c6-2e54869b0160"],
 " is a quasi-isomorphism and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["Q", "TI"], "(", 
    StyleBox["V", "TI"], ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"5405acbc-053f-404d-8c0a-2b7b63c1b3e3"],
 " is of finite type, then ",
 Cell[BoxData[
  FormBox[
   StyleBox["V", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "cc394fb8-732b-456e-9662-2852f4a901db"],
 " is of Hodge type."
}], "Item",ExpressionUUID->"e1a6762e-cf2b-4cd3-90db-ac0488f58ef7"],

Cell[TextData[{
 "And ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Pi]", 
    StyleBox["Q", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "9e8b7fed-a1fe-4ba2-99c3-99320d2cfe7a"],
 " is a quasi-isomorphism exactly when its kernel ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["V", "TI"], 
    StyleBox["deg",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "dcfca9a8-e7ed-4ce6-b8bd-13aabbcab4ce"],
 " is acyclic. So the computable form of \"of Hodge type\" is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["H", "TI"], 
    RowBox[{"(", 
     SubscriptBox[
      StyleBox["V", "TI"], 
      StyleBox["deg",
       FontSlant->"Plain"]], ")"}], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"4b75dccd-7fe5-466f-9174-f461551c37d8"],
 ". That is what ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["HodgeTypeQ"]], "paclet:ChernSimons/ref/HodgeTypeQ", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "9e3310df-83a3-4c72-a4c8-d1361977faeb"],
 " tests."
}], "Text",ExpressionUUID->"43762f12-d6af-43d4-8d2c-bc11da143939"],

Cell["In which degrees", "Section",ExpressionUUID->"b7d4acbd-2f61-4e41-a063-0dac1cf819c0"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["V", "TI"], 
    StyleBox["deg",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "1ee6e532-d357-4e69-9621-fb68a5480ffc"],
 " is infinite-dimensional whenever ",
 Cell[BoxData[
  FormBox[
   StyleBox["V", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "950fbc3d-a3c7-4916-beb4-04a9e838bfe8"],
 " is, so the test needs a degree range. It needs a short one. Above degree \
",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "3761d684-ad04-43d0-9c16-c4c7d958c3d6"],
 " the orientation sees nothing, so ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["V", "TI"], 
     StyleBox["deg",
      FontSlant->"Plain"], 
     StyleBox["k", "TI"]], "\[LongEqual]", 
    SuperscriptBox[
     StyleBox["V", "TI"], 
     StyleBox["k", "TI"]]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"d713d600-edd4-4685-a045-c79e8a90f01d"],
 " for every ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["k", "TI"], ">", 
    StyleBox["n", "TI"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "7dc1db47-78c0-4657-a721-edea37fc46fd"],
 "; hence for ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["k", "TI"], "\[GreaterEqual]", 
    StyleBox["n", "TI"], "+", "2"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"efe9d24d-ce92-4541-a949-99f95b21a128"],
 " both ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["V", "TI"], 
    StyleBox["deg",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["k", "TI"], "-", "1"}]], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"d22b9635-e6d0-415a-b3ac-a59d9c1fc668"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["V", "TI"], 
    StyleBox["deg",
     FontSlant->"Plain"], 
    StyleBox["k", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "c5fbcd68-a983-4634-b486-d5286e33863e"],
 " are the whole of ",
 Cell[BoxData[
  FormBox[
   StyleBox["V", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "cca9cf30-671f-443b-94d1-b143c372d919"],
 " in their degrees, and"
}], "Text",ExpressionUUID->"c2342805-9d0b-4dce-a656-3573d6c4b126"],

Cell[BoxData[
 PaneBox[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      SuperscriptBox[
       StyleBox["H", "TI"], 
       StyleBox["k", "TI"]], 
      RowBox[{"(", 
       SubscriptBox[
        StyleBox["V", "TI"], 
        StyleBox["deg",
         FontSlant->"Plain"]], ")"}]}], "\[LongEqual]", 
     RowBox[{
      SuperscriptBox[
       StyleBox["H", "TI"], 
       StyleBox["k", "TI"]], 
      RowBox[{"(", 
       StyleBox["V", "TI"], ")"}]}], "\[LongEqual]", 
     RowBox[{"0", "    ", 
      RowBox[{"(", 
       RowBox[{
        StyleBox["k", "TI"], "\[GreaterEqual]", 
        StyleBox["n", "TI"], "+", "2"}], ")"}]}]}], ","}],
   TraditionalForm],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",ExpressionUUID->"40956682-691c-4e0e-\
a8f4-c943cea28d6d"],

Cell[TextData[{
 "the last equality because the cohomology of a PDGA of degree ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "662465e2-3a71-476f-a48c-efa018badad7"],
 " is concentrated in degrees ",
 Cell[BoxData[
  FormBox["0", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "43b6ea61-a9b4-482d-866f-5d06502547d3"],
 " to ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "a6b239ba-b50e-40de-9a2d-f48eee9c1ea8"],
 ". Degree ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["n", "TI"], "+", "1"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"5ae22f54-61aa-42e6-b2a2-a0eec8636993"],
 " is the one degree where the two differ, since ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["V", "TI"], 
    StyleBox["deg",
     FontSlant->"Plain"], 
    StyleBox["n", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "a90d8498-2f5c-4b72-b935-0f7d9c35ce8f"],
 " is generally a proper subspace of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["V", "TI"], 
    StyleBox["n", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "5fc26f36-7594-4d21-a55e-edb140805613"],
 ". So checking degrees ",
 Cell[BoxData[
  FormBox["0", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "3ca2e27e-9c08-44bd-aa18-da1efa966bc6"],
 " through ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["n", "TI"], "+", "1"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"ae5714e2-5269-4acc-951d-f10a28744170"],
 " settles it, and that is the default."
}], "Text",ExpressionUUID->"7fbe2be1-5df3-4d89-954a-be4eeb2500a4"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"model", " ", "=", " ", 
   RowBox[{"SullivanModel", "[", 
    RowBox[{"\"\<ComplexProjectiveSpace\>\"", "[", "3", "]"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"model", "[", "\"\<Degree\>\"", "]"}], ",", " ", 
   RowBox[{"HodgeTypeQ", "[", "model", "]"}], ",", " ", 
   RowBox[{"HodgeTypeQ", "[", 
    RowBox[{"model", ",", " ", 
     RowBox[{"\"\<MaxDegree\>\"", " ", "->", " ", "30"}]}], "]"}]}], 
  "}"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"f7bbf11a-afbd-4ca4-9e17-312e54a0b5a3"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"6", ",", "True", ",", "True"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"654b1d60-53f0-43cd-902c-0daa69483713"]
}, Open  ]],

Cell[TextData[{
 "The report tells the same story in columns. ",
 Cell[BoxData[
 "Degenerate"], "InlineFormula",ExpressionUUID->
  "bc0ad04b-4a99-4323-ac63-5c5bdf8b6dcd"],
 " grows to fill ",
 Cell[BoxData[
 "Dimension"], "InlineFormula",ExpressionUUID->
  "dc953f91-77d4-424c-bace-7006aa756d7a"],
 " past degree ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "b3c962e5-c6f5-498b-ac45-355ac7d3faae"],
 ", and ",
 Cell[BoxData[
 "DegenerateCohomology"], "InlineFormula",ExpressionUUID->
  "730e43e2-548c-47bf-b5e3-acde77e4dcfa"],
 " stays zero: that is the quasi-isomorphism. ",
 Cell[BoxData[
 "Cohomology"], "InlineFormula",ExpressionUUID->
  "098f969a-5cda-45f2-a38e-eb1408bb6cab"],
 " and ",
 Cell[BoxData[
 "Quotient"], "InlineFormula",ExpressionUUID->
  "eaa8a07d-b01f-4417-8fce-07133cec543b"],
 " also agree here, which is a further fact: the quotient carries no \
differential, so it is the cohomology. In general the quasi-isomorphism only \
gives ",
 Cell[BoxData[
 "Cohomology"], "InlineFormula",ExpressionUUID->
  "54624de7-be1c-4b0f-bf26-6ae2b246e8aa"],
 " ",
 Cell[BoxData[
  FormBox["\[LessEqual]", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "5f5be1d3-dfab-45fe-8c17-9b7146ec9328"],
 " ",
 Cell[BoxData[
 "Quotient"], "InlineFormula",ExpressionUUID->
  "65c076d4-ee39-47ad-8c4f-17bfcca03bdb"],
 ", the two agreeing exactly when the quotient's differential vanishes."
}], "Text",ExpressionUUID->"446a2746-e3ae-4301-b6db-b30f2fa7073b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"HodgeTypeReport", "[", "model", "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"078afb26-e36c-48c0-b957-45f59f044138"],

Cell[BoxData[
 TagBox[
  TagBox[
   DynamicModuleBox[{TypeSystem`NestedGrid`PackagePrivate`$state$$ = <|
    "InitialData" -> <|
      0 -> <|"Dimension" -> 1, "Cohomology" -> 1, "Degenerate" -> 0, 
         "DegenerateCohomology" -> 0, "Quotient" -> 1|>, 
       1 -> <|"Dimension" -> 0, "Cohomology" -> 0, "Degenerate" -> 0, 
         "DegenerateCohomology" -> 0, "Quotient" -> 0|>, 
       2 -> <|"Dimension" -> 1, "Cohomology" -> 1, "Degenerate" -> 0, 
         "DegenerateCohomology" -> 0, "Quotient" -> 1|>, 
       3 -> <|"Dimension" -> 0, "Cohomology" -> 0, "Degenerate" -> 0, 
         "DegenerateCohomology" -> 0, "Quotient" -> 0|>, 
       4 -> <|"Dimension" -> 1, "Cohomology" -> 1, "Degenerate" -> 0, 
         "DegenerateCohomology" -> 0, "Quotient" -> 1|>, 
       5 -> <|"Dimension" -> 0, "Cohomology" -> 0, "Degenerate" -> 0, 
         "DegenerateCohomology" -> 0, "Quotient" -> 0|>, 
       6 -> <|"Dimension" -> 1, "Cohomology" -> 1, "Degenerate" -> 0, 
         "DegenerateCohomology" -> 0, "Quotient" -> 1|>, 
       7 -> <|"Dimension" -> 1, "Cohomology" -> 0, "Degenerate" -> 1, 
         "DegenerateCohomology" -> 0, "Quotient" -> 0|>, 
