Notebook[{

Cell[CellGroupData[{
Cell["Hodge Type and the Nondegenerate Quotient", "Title",
 CellID->509267359,ExpressionUUID->"4ddb5767-1f00-4973-a411-49eacd07850d"],

Cell[TextData[{
 "An oriented PDGA ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     StyleBox["V", "TI"], ",", 
     StyleBox["d",
      FontSlant->"Plain"], ",", 
     StyleBox["O", "TI"]}], ")"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d2c46c2b-9e73-473b-921f-28995e97c686"],
 " satisfies Poincar\[EAcute] duality on cohomology but almost never on chain \
level. The construction that repairs this divides out the part of ",
 Cell[BoxData[
  FormBox[
   StyleBox["V", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "84e4ac50-e7eb-4469-9893-03621aa6f23f"],
 " that the pairing cannot see, and the question is whether the division \
loses cohomology. It does not exactly when ",
 Cell[BoxData[
  FormBox[
   StyleBox["V", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "86efd298-7556-4fbb-879e-27b236f0fe35"],
 " is ",
 StyleBox["of Hodge type", "TI"],
 ". This tutorial is about that test: what it computes, in which degrees, and \
what it looks like when it fails."
}], "Text",ExpressionUUID->"1ba59294-db31-458e-b509-247981439d3b"],

Cell[TextData[{
 "The reference is ",
 ButtonBox["arXiv:2004.07362",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://arxiv.org/abs/2004.07362"], None}],
 ", ",
 StyleBox["Hodge decompositions and Poincar\[EAcute] duality models", "TI"],
 "."
}], "Text",ExpressionUUID->"c6bd8958-f1d0-4a1f-a593-a3dc84d6e863"],

Cell["Three subspaces", "Section",ExpressionUUID->"00183384-553f-4f6c-b895-64dbee6b65a0"],

Cell[TextData[{
 "Write ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{
      SubscriptBox[
       StyleBox["v", "TI"], "1"], ",", 
      SubscriptBox[
       StyleBox["v", "TI"], "2"]}], "\[RightAngleBracket]"}], "\[LongEqual]", 
    
    StyleBox["O", "TI"], 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox[
       StyleBox["v", "TI"], "1"], 
      SubscriptBox[
       StyleBox["v", "TI"], "2"]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "773e4624-b193-4a08-b5e3-eabb936988f9"],
 ". A ",
 StyleBox["Hodge decomposition", "TI"],
 " is a splitting"
}], "Text",ExpressionUUID->"57c12c9d-4ea0-4010-b42b-498aed85f4ae"],

Cell[BoxData[
 PaneBox[
  FormBox[
   RowBox[{
    StyleBox["V", "TI"], "\[LongEqual]", 
    StyleBox["H", "TI"], "\[CirclePlus]", 
    StyleBox["im",
     FontSlant->"Plain"], " ", 
    StyleBox["d",
     FontSlant->"Plain"], "\[CirclePlus]", 
    StyleBox["C", "TI"], 
    RowBox[{",", "    "}], 
    StyleBox["C", "TI"], "\[Perpendicular]", 
    StyleBox["C", "TI"], "\[CirclePlus]", 
    StyleBox["H", "TI"], ","}],
   TraditionalForm],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",ExpressionUUID->"6503748f-6e06-464c-\
a6aa-d913ed17d6da"],

Cell[TextData[{
 "with ",
 Cell[BoxData[
  FormBox[
   StyleBox["H", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "79d618ca-b474-4a9a-a77f-8ad1834c6876"],
 " a complement of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["im",
     FontSlant->"Plain"], " ", 
    StyleBox["d",
     FontSlant->"Plain"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "75236478-dcab-4c6c-bd0a-32fef305f0e6"],
 " in ",
 Cell[BoxData[
  FormBox[
   RowBox[{"ker", 
    StyleBox["d",
     FontSlant->"Plain"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f2a7f16a-5e70-4939-9634-f31d3ba80dbd"],
 " and ",
 Cell[BoxData[
  FormBox[
   StyleBox["C", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "99cf7638-105e-494f-9604-f693c101029a"],
 " a complement of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"ker", 
    StyleBox["d",
     FontSlant->"Plain"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dca8876c-202c-432b-aaff-a8491586d57a"],
 " in ",
 Cell[BoxData[
  FormBox[
   StyleBox["V", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "edfc119f-7cff-4736-b08f-b7439b6795b9"],
 ". Dropping the condition ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["C", "TI"], "\[Perpendicular]", 
    StyleBox["C", "TI"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2a149c43-56f1-48ee-ad84-2e4fb893dad9"],
 " leaves a ",
 StyleBox["pre-Hodge", "TI"],
 " decomposition, and one of those exists for any PDGA; the whole difficulty \
is the isotropy of ",
 Cell[BoxData[
  FormBox[
   StyleBox["C", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b5bd2a04-57b1-43a2-b338-e3ec4ea7e9b2"],
 "."
}], "Text",ExpressionUUID->"fe242b78-8875-4326-8715-3e1b6c4fafea"],

Cell[TextData[{
 "The ",
 StyleBox["degenerate subspace", "TI"],
 " is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["V", "TI"], 
     StyleBox["deg",
      FontSlant->"Plain"]], "\[LongEqual]", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["v", "TI"], "|", 
      StyleBox["v", "TI"], "\[Perpendicular]", 
      StyleBox["V", "TI"]}], "}"}]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "90342711-cccc-4eb0-9c89-c68f41921ea8"],
 " and the ",
 StyleBox["nondegenerate quotient", "TI"],
 " is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["Q", "TI"], 
    RowBox[{"(", 
     StyleBox["V", "TI"], ")"}], "\[LongEqual]", 
    StyleBox["V", "TI"], "/", 
    SubscriptBox[
     StyleBox["V", "TI"], 
     StyleBox["deg",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ddbc92b7-32f5-416b-a87a-3bde8b00c732"],
 ". Because ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{
      StyleBox["d",
       FontSlant->"Plain"], 
      SubscriptBox[
       StyleBox["v", "TI"], "1"], ",", 
      SubscriptBox[
       StyleBox["v", "TI"], "2"]}], "\[RightAngleBracket]"}], "\[LongEqual]", 
    "\[PlusMinus]", 
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{
      SubscriptBox[
       StyleBox["v", "TI"], "1"], ",", 
      StyleBox["d",
       FontSlant->"Plain"], 
      SubscriptBox[
       StyleBox["v", "TI"], "2"]}], "\[RightAngleBracket]"}]}], 
   TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "167c516d-2a0d-4d27-95ba-67c7c7f6ee54"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{
      SubscriptBox[
       StyleBox["v", "TI"], "1"], 
      SubscriptBox[
       StyleBox["v", "TI"], "2"], ",", 
      SubscriptBox[
       StyleBox["v", "TI"], "3"]}], "\[RightAngleBracket]"}], "\[LongEqual]", 
    
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{
      SubscriptBox[
       StyleBox["v", "TI"], "1"], ",", 
      SubscriptBox[
       StyleBox["v", "TI"], "2"], 
      SubscriptBox[
       StyleBox["v", "TI"], "3"]}], "\[RightAngleBracket]"}]}], 
   TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "50526a75-b252-48c8-9efb-46f59208c3a4"],
 ", the degenerate subspace is a differential graded ideal, so the quotient \
is again a CDGA with an orientation, and the pairing on it is nondegenerate \
by construction."
}], "Text",ExpressionUUID->"481014e8-a689-4910-b46a-a5d4194eda1c"],

Cell["\<\
Two facts tie the notions together, both from the reference and both used \
here:\
\>", "Text",ExpressionUUID->"3505f344-b8c8-49c5-a8a2-15a31be8aa4c"],

Cell[TextData[{
 "if ",
 Cell[BoxData[
  FormBox[
   StyleBox["V", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5bd23d09-3e57-48d7-bd2f-b007373e623b"],
 " is of Hodge type and the pairing on ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["H", "TI"], "(", 
    StyleBox["V", "TI"], ")"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9f8281e7-af2a-4608-aad0-9997bf997962"],
 " is nondegenerate, then ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Pi]", 
     StyleBox["Q", "TI"]], ":", 
    StyleBox["V", "TI"], "\[Rule]", 
    StyleBox["Q", "TI"], 
    RowBox[{"(", 
     StyleBox["V", "TI"], ")"}]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "17b0a608-21f5-4950-8081-4dce0199bb4b"],
 " is a quasi-isomorphism;"
}], "Item",ExpressionUUID->"f5041fbb-16d9-4003-aa07-42891fe53837"],

Cell[TextData[{
 "conversely, in characteristic ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[NotEqual]", "2"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ec6c3e26-c0e9-4f03-8e18-9efe442c2a69"],
 ", if ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Pi]", 
    StyleBox["Q", "TI"]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "68e03676-9bd0-4401-b9fb-b1f72e75e847"],
 " is a quasi-isomorphism and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["Q", "TI"], "(", 
    StyleBox["V", "TI"], ")"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "88397fc6-a4e8-4db5-bfbc-551cd2726a21"],
 " is of finite type, then ",
 Cell[BoxData[
  FormBox[
   StyleBox["V", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fddf5a31-a75a-4544-b296-a5d583c62236"],
 " is of Hodge type."
}], "Item",ExpressionUUID->"2f32c993-917c-4306-b71d-231535cbdd04"],

Cell[TextData[{
 "And ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Pi]", 
    StyleBox["Q", "TI"]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1ec5c370-2148-48a2-ac14-3e442f851044"],
 " is a quasi-isomorphism exactly when its kernel ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["V", "TI"], 
    StyleBox["deg",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c050a90c-8bf1-4f17-bba9-501c6ce4f061"],
 " is acyclic. So the computable form of \"of Hodge type\" is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["H", "TI"], 
    RowBox[{"(", 
     SubscriptBox[
      StyleBox["V", "TI"], 
      StyleBox["deg",
       FontSlant->"Plain"]], ")"}], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ab07e205-474f-4a22-af2b-dc65e4bae6ae"],
 ". That is what ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["HodgeTypeQ"]], "paclet:ChernSimons/ref/HodgeTypeQ", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "94d52516-ee2a-4459-8b3e-f1d79fa11530"],
 " tests."
}], "Text",ExpressionUUID->"e1314aff-b496-415e-97a7-a448f4972739"],

Cell["In which degrees", "Section",ExpressionUUID->"a0944975-db60-4d75-af12-daf35ab5cb85"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["V", "TI"], 
    StyleBox["deg",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c6716a90-bc39-4ed7-9f8c-6b5249e3674a"],
 " is infinite-dimensional whenever ",
 Cell[BoxData[
  FormBox[
   StyleBox["V", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2de6b532-8d34-4620-8cff-4098d8ab6d4c"],
 " is, so the test needs a degree range. It needs a short one. Above degree \
",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "459c0f7c-1593-44ec-a5c6-4bc780987f46"],
 " the orientation sees nothing, so ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["V", "TI"], 
     StyleBox["deg",
      FontSlant->"Plain"], 
     StyleBox["k", "TI"]], "\[LongEqual]", 
    SuperscriptBox[
     StyleBox["V", "TI"], 
     StyleBox["k", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f70d2517-60d3-4225-9da9-3edc0c4f8da8"],
 " for every ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["k", "TI"], ">", 
    StyleBox["n", "TI"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c4770361-6077-4ee4-ae4e-4fc8d528d0a6"],
 "; hence for ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["k", "TI"], "\[GreaterEqual]", 
    StyleBox["n", "TI"], "+", "2"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b8fc8583-1ac5-42d6-8d8c-0ad0f4373c56"],
 " both ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["V", "TI"], 
    StyleBox["deg",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["k", "TI"], "-", "1"}]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f863cf4f-ca6f-4712-a840-68c071d6ce76"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["V", "TI"], 
    StyleBox["deg",
     FontSlant->"Plain"], 
    StyleBox["k", "TI"]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b576d662-385a-45d1-be22-dcd8f8aabfde"],
 " are the whole of ",
 Cell[BoxData[
  FormBox[
   StyleBox["V", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "927e2c0a-2611-468c-a8ed-d996ee2c4fda"],
 " in their degrees, and"
}], "Text",ExpressionUUID->"a68eba87-ebdb-44eb-a398-7d96cb408894"],

Cell[BoxData[
 PaneBox[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["H", "TI"], 
     StyleBox["k", "TI"]], 
    RowBox[{"(", 
     SubscriptBox[
      StyleBox["V", "TI"], 
      StyleBox["deg",
       FontSlant->"Plain"]], ")"}], "\[LongEqual]", 
    SuperscriptBox[
     StyleBox["H", "TI"], 
     StyleBox["k", "TI"]], 
    RowBox[{"(", 
     StyleBox["V", "TI"], ")"}], "\[LongEqual]", 
    RowBox[{"0", "    "}], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["k", "TI"], "\[GreaterEqual]", 
      StyleBox["n", "TI"], "+", "2"}], ")"}], ","}],
   TraditionalForm],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",ExpressionUUID->"130d53a0-6d85-475d-\
a3c4-c948deb94649"],

Cell[TextData[{
 "the last equality because the cohomology of a PDGA of degree ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c5838653-57e2-4e52-95a2-dcf290f335d2"],
 " is concentrated in degrees ",
 Cell[BoxData[
  FormBox["0", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "94884707-6084-438e-9194-eedb9ace32b3"],
 " to ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "75b07331-e619-40d3-8c82-b2422ca1238f"],
 ". Degree ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["n", "TI"], "+", "1"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4f01f214-3028-44aa-9501-b035fc13c8e3"],
 " is the one degree where the two differ, since ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["V", "TI"], 
    StyleBox["deg",
     FontSlant->"Plain"], 
    StyleBox["n", "TI"]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f25019aa-40c5-4f39-b270-65eb6d2ada70"],
 " is generally a proper subspace of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["V", "TI"], 
    StyleBox["n", "TI"]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2991500f-100e-4b1a-8ba0-07380dd7deb2"],
 ". So checking degrees ",
 Cell[BoxData[
  FormBox["0", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "39e5f5a2-57f0-40f8-92a4-e3db7240676e"],
 " through ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["n", "TI"], "+", "1"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5d428301-6c40-40a1-b626-59b6a291c0ed"],
 " settles it, and that is the default."
}], "Text",ExpressionUUID->"6d0449b5-eb24-4dc2-9d51-f852800ef4ac"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"model", " ", "=", " ", 
   RowBox[{"SullivanModel", "[", 
    RowBox[{"\"\<ComplexProjectiveSpace\>\"", "[", "3", "]"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"model", "[", "\"\<Degree\>\"", "]"}], ",", " ", 
   RowBox[{"HodgeTypeQ", "[", "model", "]"}], ",", " ", 
   RowBox[{"HodgeTypeQ", "[", 
    RowBox[{"model", ",", " ", 
     RowBox[{"\"\<MaxDegree\>\"", " ", "->", " ", "30"}]}], "]"}]}], 
  "}"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"aad5567b-a289-402a-85f1-3f474814eb03"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"6", ",", "True", ",", "True"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"463a1b99-b4be-47af-815e-1decbb4dad0d"]
}, Open  ]],

Cell[TextData[{
 "The report tells the same story in columns. ",
 Cell[BoxData["Degenerate"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c69ef7c7-e260-4624-868a-bd0fce0668c8"],
 " grows to fill ",
 Cell[BoxData["Dimension"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0d56c103-1056-495b-8e15-c9c5cffee2b7"],
 " past degree ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8680e29f-6d4f-4655-8a48-1a4a49c3cabe"],
 ", and ",
 Cell[BoxData["DegenerateCohomology"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f28a3228-f643-4dad-8141-0aafebea9196"],
 " stays zero: that is the quasi-isomorphism. ",
 Cell[BoxData["Cohomology"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5543e22e-5b60-402a-b7ce-3f167963c803"],
 " and ",
 Cell[BoxData["Quotient"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b249f72d-8307-470e-8bec-796e1ee43349"],
 " also agree here, which is a further fact: the quotient carries no \
differential, so it is the cohomology. In general the quasi-isomorphism only \
gives ",
 Cell[BoxData["Cohomology"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c2a93e6e-43ae-45ff-95a6-a1d1b07e3cb6"],
 " ",
 Cell[BoxData[
  FormBox["\[LessEqual]", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7904d1e7-d0df-4c33-a937-cb1a5af68ed2"],
 " ",
 Cell[BoxData["Quotient"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d2b5eba7-ce47-4608-bf15-7e765fd53a58"],
 ", the two agreeing exactly when the quotient's differential vanishes."
}], "Text",ExpressionUUID->"f6fdb460-2305-4dc6-9038-628b6fe8971e"],

