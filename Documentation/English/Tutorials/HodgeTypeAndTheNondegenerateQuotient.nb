Cell[TextData[{
 "The obstruction is visible in the report, in degree ",
 Cell[BoxData[
  FormBox["3", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e30d4aac-4a36-4337-ba1a-e38d5fd075ab"],
 ": the degenerate subspace is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["R",
     FontSlant->"Plain"], 
    RowBox[{"{", 
     StyleBox["c", "TI"], "}"}]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "65fea843-4247-48d0-8671-a7ceece0d7d8"],
 ", and ",
 Cell[BoxData[
  FormBox[
   StyleBox["c", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "36889ada-b68e-465f-affa-f571253edc15"],
 " is closed and is not the differential of anything degenerate, so ",
 Cell[BoxData["DegenerateCohomology"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "82b4e8d5-6871-4192-95e7-98dbc880bb06"],
 " is ",
 Cell[BoxData[
  FormBox["1", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8e6db49c-bc75-45d8-bd90-a8ab94a2508e"],
 " there."
}], "Text",ExpressionUUID->"f35a2fc3-5c47-4897-8d76-72e63b767872"],

