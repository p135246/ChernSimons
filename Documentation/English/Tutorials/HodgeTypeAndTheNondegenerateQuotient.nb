}, Open  ]],

Cell[TextData[{
 "The obstruction is visible in the report, in degree ",
 Cell[BoxData[
  FormBox["3", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "7c9ef3c3-8f8b-4cac-aa2c-525ca99c7f23"],
 ": the degenerate subspace is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["R",
     FontSlant->"Plain"], 
    RowBox[{"{", 
     StyleBox["c", "TI"], "}"}]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"e4a96514-b6d1-4763-828b-3fa9aab1cc6f"],
 ", and ",
 Cell[BoxData[
  FormBox[
   StyleBox["c", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "b53cca3c-b5ae-4cee-93cd-2ee52d0ae4a1"],
 " is closed and is not the differential of anything degenerate, so ",
 Cell[BoxData[
 "DegenerateCohomology"], "InlineFormula",ExpressionUUID->
  "06e1bd83-ecfa-4b11-9eec-a7e0832bad80"],
 " is ",
 Cell[BoxData[
  FormBox["1", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "ce6818f1-4b18-4906-af10-718a46650e47"],
 " there."
}], "Text",ExpressionUUID->"048055a4-8cb1-4384-956f-69e94db390eb"],

