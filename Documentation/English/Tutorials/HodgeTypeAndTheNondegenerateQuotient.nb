}, Open  ]],

Cell[TextData[{
 "The consequence is exactly what the theory predicts: the quotient is ",
 StyleBox["not", "TI"],
 " quasi-isomorphic to the model. It is three-dimensional with zero \
differential: the cohomology of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["CP",
     FontSlant->"Plain"], "2"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a58f2bd5-e928-4d38-b1ae-ab6dbf50215a"],
 ", not of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["S", "TI"], "4"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "36083034-112e-4f74-a4a7-e39770b31038"],
 "."
}], "Text",ExpressionUUID->"07e6d6f1-1da8-4a38-bd6d-aa605cf2b7d8"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"quotient", " ", "=", " ", 
   RowBox[{"NondegenerateQuotient", "[", "bad", "]"}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"quotient", "[", "\"\<Basis\>\"", "]"}], ",", " ", 
   RowBox[{"quotient", "[", "\"\<Differential\>\"", "]"}], ",", " ", 
   RowBox[{"Total", "[", 
    RowBox[{"Values", "[", 
     RowBox[{
      RowBox[{"HodgeTypeReport", "[", "bad", "]"}], "[", 
      RowBox[{"All", ",", " ", "\"\<Cohomology\>\""}], "]"}], "]"}], "]"}]}], 
  "}"}]}], "Input",
 CellLabel->"In[8]:= ",ExpressionUUID->"515457c4-6096-435b-8fb1-170a73f37705"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", "a", ",", 
     SuperscriptBox["a", "2"]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", "0"}], "}"}]}], "}"}], ",", "2"}], 
  "}"}]], "Output",
 CellLabel->"Out[8]= ",ExpressionUUID->"4af8174a-ae69-4a93-83e6-09d0c075a6da"]
}, Open  ]],

Cell[TextData[{
 "Three against two: the quotient map has killed the class of ",
 Cell[BoxData[
  FormBox[
   StyleBox["c", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "649d9df1-699f-4622-9510-c1919f41d393"],
 " but not the class ",
 Cell[BoxData[
  FormBox[
   RowBox[{"[", 
    StyleBox["a", "TI"], "]"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "15a7f6a9-2a3b-4792-af87-61ae57d1f2ba"],
 " that ought to have died with it. The repair in the reference is to ",
 StyleBox["extend", "TI"],
 " ",
 Cell[BoxData[
  FormBox[
   StyleBox["V", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cc39aae4-44c7-4fe2-b4d7-5302fdf1ebe0"],
 " to a larger PDGA of Hodge type that retracts onto it; the extension \
adjoins a generator in degree ",
 Cell[BoxData[
  FormBox["1", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3619246d-b976-4baa-b13e-8b766c25e471"],
 ", which is why this example also shows that no ",
 Cell[BoxData[
  FormBox["1", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1ab04123-43c6-4233-ad2f-38618180714a"],
 "-connected extension of Hodge type exists in degree ",
 Cell[BoxData[
  FormBox["4", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cc818d75-a4da-4597-b712-bbf98aa7b1ee"],
 "."
}], "Text",ExpressionUUID->"78e6cd04-681e-430c-b51c-a01c0c3fa2de"],

Cell["When the model is already a dPD algebra", "Section",ExpressionUUID->"ff6d8b7e-75b6-48c4-9451-595b0c8d937d"],

Cell[TextData[{
 "At the other extreme are models whose pairing is already perfect on chain \
level, so ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["V", "TI"], 
     StyleBox["deg",
      FontSlant->"Plain"]], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cbf0109b-2e3c-4d62-af8b-871ab9776a0f"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["Q", "TI"], 
    RowBox[{"(", 
     StyleBox["V", "TI"], ")"}], "\[LongEqual]", 
    StyleBox["V", "TI"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f4b68983-19b9-41f2-a138-49ed2440863d"],
 ". The minimal model of a nilmanifold is one: a finite-dimensional exterior \
algebra on generators of degree ",
 Cell[BoxData[
  FormBox["1", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "83ac5dcb-5f44-4637-9a03-c9e62c1b0287"],
 ", with the differential of the nilpotent Lie algebra."
}], "Text",ExpressionUUID->"c9cad6c9-6aa3-48e3-8dbf-d9698c69f165"],

Cell[TextData[{
 "The three-dimensional Heisenberg nilmanifold has ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalLambda]", "(", 
    RowBox[{
     StyleBox["x", "TI"], ",", 
     StyleBox["y", "TI"], ",", 
     StyleBox["z", "TI"]}], ")"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fe0a6263-0475-4834-a6e9-4e0b95e12461"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["d",
     FontSlant->"Plain"], 
    StyleBox["z", "TI"], "\[LongEqual]", 
    StyleBox["x", "TI"], 
    StyleBox["y", "TI"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "348a4a67-58fb-43d4-bde3-a4afc2382bf2"],
 ", and the orientation ",
 Cell[BoxData[
  FormBox["1", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a3260287-5b07-428b-b50d-ef8dffec99a6"],
 " on ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"x", "y", "z"}], "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9fa240f0-dc47-4e06-ac8a-82535e799cd2"],
 "."
}], "Text",ExpressionUUID->"beb13f6a-eb57-4d48-a536-a226e4b98530"],

