Notebook[{

Cell[CellGroupData[{
Cell["Hodge Type and the Nondegenerate Quotient", "Title",
 CellID->509267359,ExpressionUUID->"4ddb5767-1f00-4973-a411-49eacd07850d"],

Cell[TextData[{
 "An oriented PDGA ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     StyleBox["V", "TI"], ",", 
     StyleBox["d",
      FontSlant->"Plain"], ",", 
     StyleBox["O", "TI"]}], ")"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "20c6cb73-96e5-404e-86df-7815f9746d45"],
 " satisfies Poincar\[EAcute] duality on cohomology but almost never on chain \
level. The construction that repairs this divides out the part of ",
 Cell[BoxData[
  FormBox[
   StyleBox["V", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "80694531-0abd-4ad2-967a-33af2a92dc03"],
 " that the pairing cannot see, and the question is whether the division \
loses cohomology. It does not exactly when ",
 Cell[BoxData[
  FormBox[
   StyleBox["V", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7d83afe4-975e-41e1-832e-6aa376991242"],
 " is ",
 StyleBox["of Hodge type", "TI"],
 ". This tutorial is about that test: what it computes, in which degrees, and \
what it looks like when it fails."
}], "Text",ExpressionUUID->"a403d78a-c395-42a8-b7ff-882d981d5e42"],

Cell[TextData[{
 "The reference is ",
 ButtonBox["arXiv:2004.07362",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://arxiv.org/abs/2004.07362"], None}],
 ", ",
 StyleBox["Hodge decompositions and Poincar\[EAcute] duality models", "TI"],
 "."
}], "Text",ExpressionUUID->"f0ad4a65-025e-4646-8d7b-901223618113"],

Cell["Three subspaces", "Section",ExpressionUUID->"fa5bf865-677b-48c8-890e-56942fc14f06"],

Cell[TextData[{
 "Write ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{
      SubscriptBox[
       StyleBox["v", "TI"], "1"], ",", 
      SubscriptBox[
       StyleBox["v", "TI"], "2"]}], "\[RightAngleBracket]"}], "\[LongEqual]", 
    
    StyleBox["O", "TI"], 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox[
       StyleBox["v", "TI"], "1"], 
      SubscriptBox[
       StyleBox["v", "TI"], "2"]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "554d98fd-4518-461d-a8fa-3bef9e8abda8"],
 ". A ",
 StyleBox["Hodge decomposition", "TI"],
 " is a splitting"
}], "Text",ExpressionUUID->"48d5241f-e098-4686-b152-0be92c621c97"],

Cell[BoxData[
 PaneBox[
  FormBox[
   RowBox[{
    StyleBox["V", "TI"], "\[LongEqual]", 
    StyleBox["H", "TI"], "\[CirclePlus]", 
    StyleBox["im",
     FontSlant->"Plain"], " ", 
    StyleBox["d",
     FontSlant->"Plain"], "\[CirclePlus]", 
    StyleBox["C", "TI"], 
    RowBox[{",", "    "}], 
    StyleBox["C", "TI"], "\[Perpendicular]", 
    StyleBox["C", "TI"], "\[CirclePlus]", 
    StyleBox["H", "TI"], ","}],
   TraditionalForm],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",ExpressionUUID->"984948ce-7a07-4a4e-\
9214-91d407c8aaf9"],

Cell[TextData[{
 "with ",
 Cell[BoxData[
  FormBox[
   StyleBox["H", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3aaa993e-a913-4f41-a6de-72f651718b59"],
 " a complement of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["im",
     FontSlant->"Plain"], " ", 
    StyleBox["d",
     FontSlant->"Plain"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "91f26f62-c4e4-4846-8ef1-f11655c2ce58"],
 " in ",
 Cell[BoxData[
  FormBox[
   RowBox[{"ker", 
    StyleBox["d",
     FontSlant->"Plain"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2c5d43e0-df3f-4774-a865-c84c8d089c13"],
 " and ",
 Cell[BoxData[
  FormBox[
   StyleBox["C", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ae75815c-087a-404f-aaa4-5df24273d99d"],
 " a complement of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"ker", 
    StyleBox["d",
     FontSlant->"Plain"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2a15e4d9-e92a-4416-ae35-67c1ff97dcc9"],
 " in ",
 Cell[BoxData[
  FormBox[
   StyleBox["V", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6585bb0f-d348-4423-9536-47f2933c62cb"],
 ". Dropping the condition ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["C", "TI"], "\[Perpendicular]", 
    StyleBox["C", "TI"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3cefcfa5-b943-4ba0-8d98-0665f61a0c32"],
 " leaves a ",
 StyleBox["pre-Hodge", "TI"],
 " decomposition, and one of those exists for any PDGA; the whole difficulty \
is the isotropy of ",
 Cell[BoxData[
  FormBox[
   StyleBox["C", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c89cc969-be52-414a-9a60-ec583b658814"],
 "."
}], "Text",ExpressionUUID->"e6552a34-97dc-4b18-b34c-34c5a113cc49"],

Cell[TextData[{
 "The ",
 StyleBox["degenerate subspace", "TI"],
 " is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["V", "TI"], 
     StyleBox["deg",
      FontSlant->"Plain"]], "\[LongEqual]", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["v", "TI"], "|", 
      StyleBox["v", "TI"], "\[Perpendicular]", 
      StyleBox["V", "TI"]}], "}"}]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "41a099bf-61e9-49c7-beb9-4193be22a3cc"],
 " and the ",
 StyleBox["nondegenerate quotient", "TI"],
 " is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["Q", "TI"], 
    RowBox[{"(", 
     StyleBox["V", "TI"], ")"}], "\[LongEqual]", 
    StyleBox["V", "TI"], "/", 
    SubscriptBox[
     StyleBox["V", "TI"], 
     StyleBox["deg",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e4bc000f-ff87-41c0-bec6-9700b6eee56e"],
 ". Because ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{
      StyleBox["d",
       FontSlant->"Plain"], 
      SubscriptBox[
       StyleBox["v", "TI"], "1"], ",", 
      SubscriptBox[
       StyleBox["v", "TI"], "2"]}], "\[RightAngleBracket]"}], "\[LongEqual]", 
    "\[PlusMinus]", 
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{
      SubscriptBox[
       StyleBox["v", "TI"], "1"], ",", 
      StyleBox["d",
       FontSlant->"Plain"], 
      SubscriptBox[
       StyleBox["v", "TI"], "2"]}], "\[RightAngleBracket]"}]}], 
   TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1e43ddad-86bd-4f0a-997c-90a550d55934"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{
      SubscriptBox[
       StyleBox["v", "TI"], "1"], 
      SubscriptBox[
       StyleBox["v", "TI"], "2"], ",", 
      SubscriptBox[
       StyleBox["v", "TI"], "3"]}], "\[RightAngleBracket]"}], "\[LongEqual]", 
    
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{
      SubscriptBox[
       StyleBox["v", "TI"], "1"], ",", 
      SubscriptBox[
       StyleBox["v", "TI"], "2"], 
      SubscriptBox[
       StyleBox["v", "TI"], "3"]}], "\[RightAngleBracket]"}]}], 
   TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3a5fd34d-7f60-451c-bee5-d61852d1534e"],
 ", the degenerate subspace is a differential graded ideal, so the quotient \
is again a CDGA with an orientation, and the pairing on it is nondegenerate \
by construction."
}], "Text",ExpressionUUID->"ee29792f-749f-4d9a-a8ef-cb664daff018"],

Cell["\<\
Two facts tie the notions together, both from the reference and both used \
here:\
\>", "Text",ExpressionUUID->"7465b896-fe62-43b7-867a-88ed7a00a813"],

Cell[TextData[{
 "if ",
 Cell[BoxData[
  FormBox[
   StyleBox["V", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8a83e38e-8423-40f4-b426-bcc0d1442db6"],
 " is of Hodge type and the pairing on ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["H", "TI"], "(", 
    StyleBox["V", "TI"], ")"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ffb4b86f-252c-4a4c-ad3f-b191d72cb142"],
 " is nondegenerate, then ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Pi]", 
     StyleBox["Q", "TI"]], ":", 
    StyleBox["V", "TI"], "\[Rule]", 
    StyleBox["Q", "TI"], 
    RowBox[{"(", 
     StyleBox["V", "TI"], ")"}]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d90d2306-e8fd-4348-ae18-d3c52a8f1327"],
 " is a quasi-isomorphism;"
}], "Item",ExpressionUUID->"913508fa-7b76-400e-bc74-b308fc44c18b"],

Cell[TextData[{
 "conversely, in characteristic ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[NotEqual]", "2"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d1e3516e-7406-4506-85a8-78c62cdbd238"],
 ", if ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Pi]", 
    StyleBox["Q", "TI"]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e819c94e-b7d9-483d-9e45-e711b968a075"],
 " is a quasi-isomorphism and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["Q", "TI"], "(", 
    StyleBox["V", "TI"], ")"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "db853f2b-24b4-48ad-bb3f-41c88c744dd8"],
 " is of finite type, then ",
 Cell[BoxData[
  FormBox[
   StyleBox["V", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f4ed3800-4b98-442a-a148-f4b67ac8fa14"],
 " is of Hodge type."
}], "Item",ExpressionUUID->"a729cc8b-b98b-42b1-a8ea-7a582f8a81e6"],

Cell[TextData[{
 "And ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Pi]", 
    StyleBox["Q", "TI"]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "813832f3-0c3b-4bb1-a2df-98b508b90ca9"],
 " is a quasi-isomorphism exactly when its kernel ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["V", "TI"], 
    StyleBox["deg",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e5b620ab-ecac-4009-b8d6-171112f14b9a"],
 " is acyclic. So the computable form of \"of Hodge type\" is: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["H", "TI"], 
    RowBox[{"(", 
     SubscriptBox[
      StyleBox["V", "TI"], 
      StyleBox["deg",
       FontSlant->"Plain"]], ")"}], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,
  FontWeight->"Bold",ExpressionUUID->"8c599457-e9d0-4a20-8413-8436177905cd"],
 ". That is what ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["HodgeTypeQ"]], "paclet:ChernSimons/ref/HodgeTypeQ", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "6e3fe58f-bb03-4a26-9f9e-54f8e46b361a"],
 " tests."
}], "Text",ExpressionUUID->"acac584d-9062-429b-ba12-a749c2f208fb"],

Cell["In which degrees", "Section",ExpressionUUID->"bdba3caf-8cad-472a-9a55-aebabdb3c5bf"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["V", "TI"], 
    StyleBox["deg",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "555513bf-893b-47ab-900b-677fc37371da"],
 " is infinite-dimensional whenever ",
 Cell[BoxData[
  FormBox[
   StyleBox["V", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "80ad461f-3cd0-4c45-a1a8-d2debe8c0f29"],
 " is, so the test needs a degree range. It needs a short one. Above degree \
",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "49ac7c40-3521-47af-ba51-5c8f795a4f37"],
 " the orientation sees nothing, so ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["V", "TI"], 
     StyleBox["deg",
      FontSlant->"Plain"], 
     StyleBox["k", "TI"]], "\[LongEqual]", 
    SuperscriptBox[
     StyleBox["V", "TI"], 
     StyleBox["k", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e70c5140-daf9-4c1b-94b4-9292c7e99ffe"],
 " for every ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["k", "TI"], ">", 
    StyleBox["n", "TI"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "85b6fbed-304e-45d4-92a8-0accff89c44e"],
 "; hence for ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["k", "TI"], "\[GreaterEqual]", 
    StyleBox["n", "TI"], "+", "2"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "86381708-78a3-4076-a3d9-3d595e5e24d2"],
 " both ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["V", "TI"], 
    StyleBox["deg",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["k", "TI"], "-", "1"}]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "61c3d131-86f3-4aa5-8e09-8e393dd3efa6"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["V", "TI"], 
    StyleBox["deg",
     FontSlant->"Plain"], 
    StyleBox["k", "TI"]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7396e06b-5f71-479c-bfc8-c8d82083097f"],
 " are the whole of ",
 Cell[BoxData[
  FormBox[
   StyleBox["V", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "301ae200-1043-4ef1-918a-8a6e6847b0f0"],
 " in their degrees, and"
}], "Text",ExpressionUUID->"3b0ab00a-d47e-45ca-a295-cb8f758f77f2"],

Cell[BoxData[
 PaneBox[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["H", "TI"], 
     StyleBox["k", "TI"]], 
    RowBox[{"(", 
     SubscriptBox[
      StyleBox["V", "TI"], 
      StyleBox["deg",
       FontSlant->"Plain"]], ")"}], "\[LongEqual]", 
    SuperscriptBox[
     StyleBox["H", "TI"], 
     StyleBox["k", "TI"]], 
    RowBox[{"(", 
     StyleBox["V", "TI"], ")"}], "\[LongEqual]", 
    RowBox[{"0", "    "}], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["k", "TI"], "\[GreaterEqual]", 
      StyleBox["n", "TI"], "+", "2"}], ")"}], ","}],
   TraditionalForm],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",ExpressionUUID->"bfd8fa57-6df5-46bf-\
ada6-1ea85ac27252"],

Cell[TextData[{
 "the last equality because the cohomology of a PDGA of degree ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0ceec80a-c66a-4b74-916d-591b3ecfca97"],
 " is concentrated in degrees ",
 Cell[BoxData[
  FormBox["0", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d580445c-bce6-4935-8264-8fc64a3fef0e"],
 " to ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "09f5a350-bf39-47b5-9120-8cf7db6323e3"],
 ". Degree ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["n", "TI"], "+", "1"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4e399825-60a8-444a-9c74-f1c991d9d775"],
 " is the one degree where the two differ, since ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["V", "TI"], 
    StyleBox["deg",
     FontSlant->"Plain"], 
    StyleBox["n", "TI"]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "da51680f-c624-40f3-ab64-6692ff3660b8"],
 " is generally a proper subspace of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["V", "TI"], 
    StyleBox["n", "TI"]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c060dab6-51b7-494d-aca9-9a7e06c6524e"],
 ". So checking degrees ",
 Cell[BoxData[
  FormBox["0", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "620cd8f1-e593-4733-990f-660935584dd8"],
 " through ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["n", "TI"], "+", "1"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c619c10d-6e45-44c0-9c61-eccb531214a1"],
 " settles it, and that is the default."
}], "Text",ExpressionUUID->"632adba9-014d-4a06-8f61-814f3741c436"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"model", " ", "=", " ", 
   RowBox[{"SullivanModel", "[", 
    RowBox[{"\"\<ComplexProjectiveSpace\>\"", "[", "3", "]"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"model", "[", "\"\<Degree\>\"", "]"}], ",", " ", 
   RowBox[{"HodgeTypeQ", "[", "model", "]"}], ",", " ", 
   RowBox[{"HodgeTypeQ", "[", 
    RowBox[{"model", ",", " ", 
     RowBox[{"\"\<MaxDegree\>\"", " ", "->", " ", "30"}]}], "]"}]}], 
  "}"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"736adf41-995e-48d6-9ebd-365acc97a703"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"6", ",", "True", ",", "True"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"7e6ee1a4-24cd-4077-9e50-4f61b611d38a"]
}, Open  ]],

Cell[TextData[{
 "The report tells the same story in columns. ",
 Cell[BoxData["Degenerate"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "420f56c0-135f-4e10-9187-f727c08b8e2c"],
 " grows to fill ",
 Cell[BoxData["Dimension"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "38b18bc8-c7f2-4785-998a-8f535f3a143b"],
 " past degree ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "49773b08-8759-454b-9d90-7e04270445ee"],
 ", and ",
 Cell[BoxData["DegenerateCohomology"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "db58f66a-e96d-492e-ad03-12c49192d8f8"],
 " stays zero \[LongDash] that is the quasi-isomorphism. ",
 Cell[BoxData["Cohomology"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "446209dd-f73a-4b99-8ece-4c212e789292"],
 " and ",
 Cell[BoxData["Quotient"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "65e41ae8-ca0c-4b82-a5b2-b58c4bbd5e11"],
 " also agree here, which is a further fact: the quotient carries no \
differential, so it is the cohomology. In general the quasi-isomorphism only \
gives ",
 Cell[BoxData["Cohomology"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f2ec5b39-25b7-445e-92d7-6c07747dd232"],
 " ",
 Cell[BoxData[
  FormBox["\[LessEqual]", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dc6f2724-85e2-42a7-9975-ccf2eabcf3ca"],
 " ",
 Cell[BoxData["Quotient"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0731c7fb-3455-4d87-8976-3e7acc5ec441"],
 ", the two agreeing exactly when the quotient's differential vanishes."
