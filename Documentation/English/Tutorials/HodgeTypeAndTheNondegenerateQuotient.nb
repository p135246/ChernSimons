   RowBox[{"heis", "[", "\"\<Orientation\>\"", "]"}], ",", " ", 
   RowBox[{"SullivanModelDifferential", "[", 
    RowBox[{"z", ",", " ", "heis"}], "]"}]}], "}"}]}], "Input",
 CellLabel->"In[9]:= ",ExpressionUUID->"9efb8a27-c1d9-40b4-88c9-e10528c8e416"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"x", "\[Rule]", "1"}], ",", 
     RowBox[{"y", "\[Rule]", "1"}], ",", 
     RowBox[{"z", "\[Rule]", "1"}]}], "}"}], ",", 
   RowBox[{"\[LeftAssociation]", 
    RowBox[{
     RowBox[{"x", " ", "y", " ", "z"}], "\[Rule]", "1"}], 
    "\[RightAssociation]"}], ",", 
   RowBox[{"x", " ", "y"}]}], "}"}]], "Output",
 CellLabel->"Out[9]= ",ExpressionUUID->"fd5eac0f-4653-4423-a234-36c9a24c674c"]
}, Open  ]],

