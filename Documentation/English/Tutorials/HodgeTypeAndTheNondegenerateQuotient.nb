    GridBoxAlignment->{"Columns" -> {{Center}}, "Rows" -> {{Baseline}}},
    GridBoxSpacings->{"Columns" -> {
        Offset[0.27999999999999997`], {
         Offset[0.7]}, 
        Offset[0.27999999999999997`]}, "Rows" -> {
        Offset[0.2], {
         Offset[0.4]}, 
        Offset[0.2]}}], "\[NoBreak]", ")"}],
  Function[BoxForm`e$, 
   MatrixForm[BoxForm`e$]]]], "Output",
 CellLabel->
  "Out[12]= ",ExpressionUUID->"89df9acf-ed64-4c66-9299-a08d34f3ca36"]
}, Open  ]],

Cell[TextData[{
 "The one nonzero entry sends ",
 Cell[BoxData[
  FormBox[
   StyleBox["z", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "17c89cc2-1b92-4299-8e2f-45ce9bdf9050"],
 " to ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"x", "y"}], "TI"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"8d48c708-883b-411e-9191-8725d7a8f574"],
 ". In the canonical dIBL structure of a cyclic cochain complex this \
differential is carried by the operation ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["q", "TI"], 
    RowBox[{"1", ",", "1", ",", "0"}]], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"fe8d2c10-9e46-4237-8016-e7eefc001468"],
 ", and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CyclicHochschildDifferential"]], 
    "paclet:ChernSimons/ref/CyclicHochschildDifferential", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "324d7e65-5acd-4f2c-876e-14fffa5e817a"],
 " is that operation: dually to ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["d",
     FontSlant->"Plain"], 
    StyleBox["z", "TI"], "\[LongEqual]", 
    StyleBox["x", "TI"], 
    StyleBox["y", "TI"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "9d4bee0a-92dd-4346-89ca-02f592613f5e"],
 ", it replaces the letter ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"x", "y"}], "TI"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"3f784574-03c4-4684-b45a-776ea0a552dc"],
 " by the letter ",
 Cell[BoxData[
  FormBox[
   StyleBox["z", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "368df68e-d621-495a-a02c-60d7798dbf43"],
 ", with the running sign of the letters after the slot."
}], "Text",ExpressionUUID->"3d4f04ae-91c8-4925-91de-bf786d3392e1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"pr", " ", "=", " ", 
     RowBox[{"GradedPairing", "[", 
      RowBox[{"NondegenerateQuotient", "[", "heis", "]"}], "]"}]}], "}"}], ",",
    "\n", "   ", 
   RowBox[{"CyclicHochschildDifferential", "[", 
    RowBox[{
     RowBox[{"CyclicWord", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"x", "*", "y"}], ",", " ", "y"}], "}"}], "]"}], ",", " ", 
     "pr"}], "]"}]}], "]"}]], "Input",
 CellLabel->
  "In[13]:= ",ExpressionUUID->"74a4d8c2-b13c-473b-be51-0a5d30c5e15e"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"(", 
   RowBox[{"y", "\[ThinSpace]", "z"}], ")"}],
  ChernSimons`CyclicWord[{MTNB$caxtra6mvcue`y, MTNB$caxtra6mvcue`z}],
  Editable->False]], "Output",
 CellLabel->
  "Out[13]= ",ExpressionUUID->"f4f1aed1-a92f-4219-92d6-341218931a83"]
}, Open  ]],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CanonicalMaurerCartan"]], 
    "paclet:ChernSimons/ref/CanonicalMaurerCartan", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "b5122565-cf5f-42c4-94cd-f599311cd510"],
 " is unchanged by this: the element of the ",
 StyleBox["product", "TI"],
 " alone solves the Maurer-Cartan equation of the structure with ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["q", "TI"], 
    RowBox[{"1", ",", "1", ",", "0"}]], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"2d29f6a3-b9d4-4fb1-b266-abdf76b2b676"],
 ", because the operation kills it. That is the Leibniz rule of the algebra, \
read on the element that carries its triple product. Twisting by the element \
then stacks the bracket on top of the differential, so ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["TwistedDifferential"]], 
    "paclet:ChernSimons/ref/TwistedDifferential", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "37829c4c-abc9-476d-ac6e-5f8e070a8ce1"],
 " is the differential of the dPD algebra with its ",
 Cell[BoxData[
  FormBox[
   StyleBox["d",
    FontSlant->"Plain"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "b5cb9282-4a4b-499a-962b-1d624c96290b"],
 ", not merely of the underlying Poincar\[EAcute] duality algebra."
}], "Text",ExpressionUUID->"da258f06-9889-44ab-b395-60a079d5e8dc"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"pr", " ", "=", " ", 
     RowBox[{"GradedPairing", "[", 
      RowBox[{"NondegenerateQuotient", "[", "heis", "]"}], "]"}]}], "}"}], ",",
    "\n", "   ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"m", " ", "=", " ", 
       RowBox[{"CanonicalMaurerCartan", "[", "pr", "]"}]}], "}"}], ",", "\n", 
     "     ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"CyclicHochschildDifferential", "[", 
        RowBox[{
         RowBox[{"m", "[", 
          RowBox[{"{", 
           RowBox[{"1", ",", " ", "0"}], "}"}], "]"}], ",", " ", "pr"}], 
        "]"}], ",", " ", 
       RowBox[{"RelationsQ", "[", "m", "]"}], ",", "\n", "      ", 
       RowBox[{"TwistedDifferential", "[", 
        RowBox[{"m", ",", " ", 
         RowBox[{"CyclicWord", "[", 
          RowBox[{"{", 
           RowBox[{"x", "*", "y"}], "}"}], "]"}]}], "]"}]}], "}"}]}], "]"}]}],
   "]"}]], "Input",
 CellLabel->
  "In[14]:= ",ExpressionUUID->"544cf5be-1481-476d-a816-13e74cfd6fd8"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0", ",", "True", ",", 
   InterpretationBox[
    RowBox[{"(", "z", ")"}],
    ChernSimons`CyclicWord[{MTNB$caxtra6mvcue`z}],
    Editable->False]}], "}"}]], "Output",
 CellLabel->
  "Out[14]= ",ExpressionUUID->"1c5ce8aa-5f44-4273-b2fc-50fb69ac1189"]
}, Open  ]],

