Cell["When it fails", "Section",ExpressionUUID->"eb1a76ca-b516-4e79-a8a7-dd0799d1abbc"],

Cell[TextData[{
 "Example 6.3 of the reference is a ",
 Cell[BoxData[
  FormBox["1", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "da11a24a-0e84-4aae-94fd-707db70e7bc1"],
 "-connected PDGA of degree ",
 Cell[BoxData[
  FormBox["4", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "588a5c7b-a0ff-46b6-bddb-c0af36ebe46e"],
 " that is not of Hodge type. Take one generator ",
 Cell[BoxData[
  FormBox[
   StyleBox["a", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9f65ac3b-0ffc-4b16-ac6a-0243b749aa51"],
 " of degree ",
 Cell[BoxData[
  FormBox["2", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a4450fc8-b175-4205-8856-9a46c2071905"],
 " and one generator ",
 Cell[BoxData[
  FormBox[
   StyleBox["c", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "35629f0a-e932-4feb-a22b-6feb9ef61bb2"],
 " of degree ",
 Cell[BoxData[
  FormBox["3", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "899dd672-9d5a-48d2-9b6d-5d896bafc004"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["d",
     FontSlant->"Plain"], 
    StyleBox["a", "TI"], "\[LongEqual]", 
    StyleBox["c", "TI"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "85321c42-2420-4689-a5b3-35319f868813"],
 ", and truncate everything above degree ",
 Cell[BoxData[
  FormBox["4", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1735bcf7-1001-41e6-91d6-3c017f4ea7fa"],
 "; the orientation is the coefficient of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["a", "TI"], "2"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c97fb4e0-3cd7-4ab6-b39b-640b3a80ed0c"],
 "."
}], "Text",ExpressionUUID->"0438b858-b988-45e4-865c-10906278c36b"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"bad", " ", "=", " ", 
   RowBox[{"SullivanModel", "[", "\"\<Degree4Obstruction\>\"", "]"}]}], 
  ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Normal", "[", 
    RowBox[{"bad", "[", "\"\<Generators\>\"", "]"}], "]"}], ",", " ", 
   RowBox[{"bad", "[", "\"\<Orientation\>\"", "]"}], ",", " ", 
   RowBox[{"bad", "[", "\"\<Truncation\>\"", "]"}]}], "}"}]}], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"94a4d613-d8c4-4a15-b7ad-950944abad92"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a", "\[Rule]", "2"}], ",", 
     RowBox[{"c", "\[Rule]", "3"}]}], "}"}], ",", 
   RowBox[{"\[LeftAssociation]", 
    RowBox[{
     SuperscriptBox["a", "2"], "\[Rule]", "1"}], "\[RightAssociation]"}], ",", 
   RowBox[{"\[LeftAssociation]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"a", ",", "c"}], "}"}], "\[Rule]", "4"}], 
    "\[RightAssociation]"}]}], "}"}]], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"0cefd086-1c0d-4e79-818d-7e07df9d8cc5"]
}, Open  ]],

Cell[TextData[{
 "The truncation is what makes this finite: the ideal of monomials above \
degree ",
 Cell[BoxData[
  FormBox["4", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3a78968c-0365-4849-aa3b-e8729053016c"],
 " is a differential graded ideal, so the quotient is a CDGA, and it is \
four-dimensional."
}], "Text",ExpressionUUID->"ff86a111-13be-4920-9a0d-9bf52974c5d3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", 
  RowBox[{
   RowBox[{"SullivanModelBasis", "[", 
    RowBox[{"bad", ",", " ", "k"}], "]"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"k", ",", " ", "0", ",", " ", "5"}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[4]:= ",ExpressionUUID->"be7e5174-5e83-497b-b4ab-816d94c49690"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", "1", "}"}], ",", 
   RowBox[{"{", "}"}], ",", 
   RowBox[{"{", "a", "}"}], ",", 
   RowBox[{"{", "c", "}"}], ",", 
   RowBox[{"{", 
    SuperscriptBox["a", "2"], "}"}], ",", 
   RowBox[{"{", "}"}]}], "}"}]], "Output",
 CellLabel->"Out[4]= ",ExpressionUUID->"c08c0db2-1b6e-4155-8465-30a1e6447f4a"]
}, Open  ]],

Cell[TextData[{
 "Its cohomology is ",
 Cell[BoxData[
  FormBox[
   StyleBox["R",
    FontSlant->"Plain"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5693e2c4-1a8a-4fa1-b18d-e16dd029652e"],
 " in degree ",
 Cell[BoxData[
  FormBox["0", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c9b74f28-6abc-4e55-9591-e19fedaca179"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["R",
     FontSlant->"Plain"], 
    RowBox[{"{", 
     SuperscriptBox[
      StyleBox["a", "TI"], "2"], "}"}]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b036d810-2a69-49ff-96c9-ed792ba10c7f"],
 " in degree ",
 Cell[BoxData[
  FormBox["4", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "463fd73c-0407-4fe4-8b79-7165298a6203"],
 ", the cohomology of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["S", "TI"], "4"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "44d7c85b-68dd-4fa7-a5f4-a8861528a699"],
 ", and the pairing on it is perfect, so this is an oriented PDGA of degree \
",
 Cell[BoxData[
  FormBox["4", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9fac8373-c402-4715-99d0-e24183c01cbf"],
 ". But ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{
      StyleBox["a", "TI"], ",", 
      StyleBox["a", "TI"]}], "\[RightAngleBracket]"}], "\[LongEqual]", 
    StyleBox["O", "TI"], 
    RowBox[{"(", 
     SuperscriptBox[
      StyleBox["a", "TI"], "2"], ")"}], "\[LongEqual]", "1"}], 
   TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "546a8429-7d00-488b-8fdc-35bb0e4e821a"],
 ", and ",
 Cell[BoxData[
  FormBox[
   StyleBox["a", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9baf759b-2f3c-49f7-90f7-2ea3a1dc27ca"],
 " spans the whole of degree ",
 Cell[BoxData[
  FormBox["2", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "14c68d75-9f72-4847-9987-946aa2792e03"],
 ", so the coexact part in degree ",
 Cell[BoxData[
  FormBox["2", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fd180449-7140-4418-9e63-b647caa71596"],
 " can only be ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["R",
     FontSlant->"Plain"], 
    RowBox[{"{", 
     StyleBox["a", "TI"], "}"}]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "105a67ca-b753-4c65-81f9-bfc27ebf40f3"],
 ", which is not isotropic. No Hodge decomposition exists."
}], "Text",ExpressionUUID->"2ea8ab73-1175-417f-9465-5a411dfab52f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"SullivanModelPairing", "[", 
