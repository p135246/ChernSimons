Cell[BoxData[
 RowBox[{"StringCobracket", "[", 
  RowBox[{
   RowBox[{"CyclicWord", "[", 
    RowBox[{"{", 
     RowBox[{
     "x", ",", " ", "y", ",", " ", "y", ",", " ", "y", ",", " ", "y"}], "}"}],
     "]"}], ",", " ", "pairing"}], "]"}]], "Input",
 CellLabel->
  "In[13]:= ",ExpressionUUID->"b2f4c02b-1a8a-48de-847d-f7755fd20b89"],

Cell[BoxData[
 RowBox[{
  RowBox[{"-", "2"}], " ", 
  InterpretationBox[
   RowBox[{
    InterpretationBox[
     RowBox[{"(", "y", ")"}],
     ChernSimons`CyclicWord[{MTNB$zqhzetch4oan`y}],
     Editable->False], "\[CircleDot]", 
    InterpretationBox[
     RowBox[{"(", 
      RowBox[{"y", "\[ThinSpace]", "y"}], ")"}],
     ChernSimons`CyclicWord[{MTNB$zqhzetch4oan`y, MTNB$zqhzetch4oan`y}],
     Editable->False]}],
   ChernSimons`SymmetricProduct[
    ChernSimons`CyclicWord[{MTNB$zqhzetch4oan`y}], 
    ChernSimons`CyclicWord[{MTNB$zqhzetch4oan`y, MTNB$zqhzetch4oan`y}]],
   Editable->False]}]], "Output",
 CellLabel->
  "Out[13]= ",ExpressionUUID->"bd052a7a-b946-4753-86eb-52fb31bb4052"]
}, Open  ]],

Cell[TextData[{
 "Everything past this point, the Chern-Simons Maurer-Cartan element, the \
Bernoulli numbers and the gauge invariant ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Rho]", 
     RowBox[{"1", ",", "1"}]], "\[LongEqual]", 
    RowBox[{"-", "1"}], "/", "24"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7b93003d-48b6-449a-8c35-3a669d18c97f"],
 ", happens inside this alphabet, and is what the rest of the paclet computes."
}], "Text",ExpressionUUID->"9d546a49-f0de-42a9-80fa-445df318aa39"],

