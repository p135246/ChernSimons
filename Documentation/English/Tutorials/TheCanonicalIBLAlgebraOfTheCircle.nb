Cell[TextData[{
 StyleBox["The bracket.",
  FontWeight->"Bold"],
 " ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["q", "TI"], 
     RowBox[{"2", ",", "1", ",", "0"}]], 
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox[
       StyleBox["x", "TI"], 
       StyleBox["a", "TI"]], "\[CircleDot]", 
      SuperscriptBox[
       StyleBox["y", "TI"], 
       StyleBox["b", "TI"]]}], ")"}], "\[LongEqual]", "-", 
    StyleBox["a", "TI"], 
    StyleBox["b", "TI"], " ", 
    SuperscriptBox[
     StyleBox["x", "TI"], 
     RowBox[{
      StyleBox["a", "TI"], "-", "1"}]], 
    SuperscriptBox[
     StyleBox["y", "TI"], 
     RowBox[{
      StyleBox["b", "TI"], "-", "1"}]]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "56458c35-0750-4254-b294-20dfb9eb4328"],
 ", the deleted pair always being one ",
 Cell[BoxData[
  FormBox[
   StyleBox["x", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "34d4b230-b65c-4710-afc5-9ae9f7485197"],
 " and one ",
 Cell[BoxData[
  FormBox[
   StyleBox["y", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "78dca789-6f35-45fe-af3c-65f060dbd97b"],
 ":"
}], "Text",ExpressionUUID->"252e1d47-2bca-4644-b408-7bbd554e17c3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"InvolutiveBracket", "[", 
  RowBox[{
   RowBox[{"CyclicWord", "[", 
    RowBox[{"{", 
     RowBox[{"x", ",", " ", "x", ",", " ", "x"}], "}"}], "]"}], ",", " ", 
   RowBox[{"CyclicWord", "[", 
    RowBox[{"{", 
     RowBox[{"y", ",", " ", "y"}], "}"}], "]"}], ",", " ", "pairing"}], 
  "]"}]], "Input",
 CellLabel->
  "In[12]:= ",ExpressionUUID->"aa70a718-ce04-4576-abb2-46a659cb5d3b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"-", "6"}], " ", 
  InterpretationBox[
   RowBox[{"(", 
    RowBox[{"x", "\[ThinSpace]", "x", "\[ThinSpace]", "y"}], ")"}],
   ChernSimons`CyclicWord[{
    MTNB$cn55jhwrptkf`x, MTNB$cn55jhwrptkf`x, MTNB$cn55jhwrptkf`y}],
   Editable->False]}]], "Output",
 CellLabel->
  "Out[12]= ",ExpressionUUID->"a999cf51-6d08-418d-9389-19abd1d92116"]
}, Open  ]],

Cell[TextData[{
 StyleBox["The co-bracket.",
  FontWeight->"Bold"],
 " ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["q", "TI"], 
     RowBox[{"1", ",", "2", ",", "0"}]], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["x", "TI"], 
      SuperscriptBox[
       StyleBox["y", "TI"], 
       StyleBox["k", "TI"]]}], ")"}], "\[LongEqual]", "-", 
    UnderscriptBox["\[Sum]", 
     RowBox[{
      StyleBox["i", "TI"], "+", 
      StyleBox["j", "TI"], "\[LongEqual]", 
      StyleBox["k", "TI"], "-", "1", 
      RowBox[{",", " "}], 
      StyleBox["i", "TI"], ",", 
      StyleBox["j", "TI"], "\[GreaterEqual]", "1"}],
     LimitsPositioning->True], 
    SuperscriptBox[
     StyleBox["y", "TI"], 
     StyleBox["i", "TI"]], "\[CircleDot]", 
    SuperscriptBox[
     StyleBox["y", "TI"], 
     StyleBox["j", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "45f33f5a-eb96-4b96-81ca-b4a84c91a431"],
 ", so on ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["x", "TI"], 
    SuperscriptBox[
     StyleBox["y", "TI"], "4"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "654de73d-0996-4b1a-9887-5854d6af72e0"],
 " the two ordered pairs ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"1", ",", "2"}], ")"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "39c7c608-28f9-4bb9-be63-d47251c48ea8"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"2", ",", "1"}], ")"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b3c6171b-f202-4703-b69a-da01ec0edb03"],
 " give the same symmetric monomial twice:"
}], "Text",ExpressionUUID->"1a08591e-365f-422a-a6c6-23680b6bd97e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"InvolutiveCobracket", "[", 
  RowBox[{
   RowBox[{"CyclicWord", "[", 
    RowBox[{"{", 
     RowBox[{
     "x", ",", " ", "y", ",", " ", "y", ",", " ", "y", ",", " ", "y"}], "}"}],
     "]"}], ",", " ", "pairing"}], "]"}]], "Input",
 CellLabel->
  "In[13]:= ",ExpressionUUID->"bf07b489-7ea3-47de-9e55-153648deb97c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"-", "2"}], " ", 
  InterpretationBox[
   RowBox[{
    InterpretationBox[
     RowBox[{"(", "y", ")"}],
     ChernSimons`CyclicWord[{MTNB$cn55jhwrptkf`y}],
     Editable->False], "\[CircleDot]", 
    InterpretationBox[
     RowBox[{"(", 
      RowBox[{"y", "\[ThinSpace]", "y"}], ")"}],
     ChernSimons`CyclicWord[{MTNB$cn55jhwrptkf`y, MTNB$cn55jhwrptkf`y}],
     Editable->False]}],
   ChernSimons`SymmetricProduct[
    ChernSimons`CyclicWord[{MTNB$cn55jhwrptkf`y}], 
    ChernSimons`CyclicWord[{MTNB$cn55jhwrptkf`y, MTNB$cn55jhwrptkf`y}]],
   Editable->False]}]], "Output",
 CellLabel->
  "Out[13]= ",ExpressionUUID->"00452365-ac4f-4e47-9939-57a166ac6558"]
}, Open  ]],

Cell[TextData[{
 "Everything past this point \[LongDash] the Chern-Simons Maurer-Cartan \
element, the Bernoulli numbers, the gauge invariant ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Rho]", 
     RowBox[{"1", ",", "1"}]], "\[LongEqual]", 
    RowBox[{"-", "1"}], "/", "24"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4f1c0643-7d07-417d-999b-afb077acce99"],
 " \[LongDash] happens inside this alphabet, and is what the rest of the \
paclet computes."
}], "Text",ExpressionUUID->"2cfe8f3f-4a01-489e-8e7d-c4e30bf3ab61"],

