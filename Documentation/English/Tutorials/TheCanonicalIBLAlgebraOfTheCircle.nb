Cell[TextData[{
 "The bracket. ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["q", "TI"], 
     RowBox[{"2", ",", "1", ",", "0"}]], 
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox[
       StyleBox["x", "TI"], 
       StyleBox["a", "TI"]], "\[CircleDot]", 
      SuperscriptBox[
       StyleBox["y", "TI"], 
       StyleBox["b", "TI"]]}], ")"}], "\[LongEqual]", "-", 
    StyleBox["a", "TI"], 
    StyleBox["b", "TI"], " ", 
    SuperscriptBox[
     StyleBox["x", "TI"], 
     RowBox[{
      StyleBox["a", "TI"], "-", "1"}]], 
    SuperscriptBox[
     StyleBox["y", "TI"], 
     RowBox[{
      StyleBox["b", "TI"], "-", "1"}]]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3405449c-45ce-4602-9442-e0b498503004"],
 ", the deleted pair always being one ",
 Cell[BoxData[
  FormBox[
   StyleBox["x", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3faba71f-948e-4d35-a9fd-e20058ce54cd"],
 " and one ",
 Cell[BoxData[
  FormBox[
   StyleBox["y", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0cbdc430-05a6-4dc1-ae9f-2e29c24d548e"],
 ":"
}], "Text",ExpressionUUID->"cf2722d4-d8ea-4a00-9350-b86dc63af01d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"StringBracket", "[", 
  RowBox[{
   RowBox[{"CyclicWord", "[", 
    RowBox[{"{", 
     RowBox[{"x", ",", " ", "x", ",", " ", "x"}], "}"}], "]"}], ",", " ", 
   RowBox[{"CyclicWord", "[", 
    RowBox[{"{", 
     RowBox[{"y", ",", " ", "y"}], "}"}], "]"}], ",", " ", "pairing"}], 
  "]"}]], "Input",
 CellLabel->
  "In[12]:= ",ExpressionUUID->"200e2b28-fa8c-476f-a643-652a0371bc44"],

Cell[BoxData[
 RowBox[{
  RowBox[{"-", "6"}], " ", 
  InterpretationBox[
   RowBox[{"(", 
    RowBox[{"x", "\[ThinSpace]", "x", "\[ThinSpace]", "y"}], ")"}],
   ChernSimons`CyclicWord[{
    MTNB$zqhzetch4oan`x, MTNB$zqhzetch4oan`x, MTNB$zqhzetch4oan`y}],
   Editable->False]}]], "Output",
 CellLabel->
  "Out[12]= ",ExpressionUUID->"ff94549d-b754-436e-aa9b-32a8bf8b2be8"]
}, Open  ]],

Cell[TextData[{
 "The co-bracket. ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["q", "TI"], 
     RowBox[{"1", ",", "2", ",", "0"}]], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["x", "TI"], 
      SuperscriptBox[
       StyleBox["y", "TI"], 
       StyleBox["k", "TI"]]}], ")"}], "\[LongEqual]", "-", 
    UnderscriptBox["\[Sum]", 
     RowBox[{
      StyleBox["i", "TI"], "+", 
      StyleBox["j", "TI"], "\[LongEqual]", 
      StyleBox["k", "TI"], "-", "1", 
      RowBox[{",", " "}], 
      StyleBox["i", "TI"], ",", 
      StyleBox["j", "TI"], "\[GreaterEqual]", "1"}],
     LimitsPositioning->True], 
    SuperscriptBox[
     StyleBox["y", "TI"], 
     StyleBox["i", "TI"]], "\[CircleDot]", 
    SuperscriptBox[
     StyleBox["y", "TI"], 
     StyleBox["j", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1fa1d63d-e0ad-4211-8cc5-3f3009dabb56"],
 ", so on ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["x", "TI"], 
    SuperscriptBox[
     StyleBox["y", "TI"], "4"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "de647eaa-255a-48c8-8c3a-f5b880241451"],
 " the two ordered pairs ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"1", ",", "2"}], ")"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dc5639b5-4792-49d4-9330-67c91c60c2f5"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"2", ",", "1"}], ")"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "88a4ead2-8575-422b-985e-f7421f03df9b"],
 " give the same symmetric monomial twice:"
}], "Text",ExpressionUUID->"3f799421-2945-4b64-acca-ac28febfe667"],

