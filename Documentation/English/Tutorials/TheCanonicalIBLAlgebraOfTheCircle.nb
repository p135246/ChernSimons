Notebook[{

Cell[CellGroupData[{
Cell["The Canonical IBL Algebra of the Circle", "Title",
 CellID->509267359,ExpressionUUID->"4ddb5767-1f00-4973-a411-49eacd07850d"],

Cell[TextData[{
 "The alphabet the rest of this paclet is written against \[LongDash] a \
particle ",
 Cell[BoxData[
  FormBox[
   StyleBox["x", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4b4aa991-a2ba-4264-9df6-dc276b6f36f1"],
 " of degree ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", "1"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bb5ad71c-0e4f-4fd0-8244-254ad2821ba3"],
 ", a particle ",
 Cell[BoxData[
  FormBox[
   StyleBox["y", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e5496ad5-9e46-46a2-9b70-c9a12f69bc52"],
 " of degree ",
 Cell[BoxData[
  FormBox["0", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "534b4989-8dc0-4f1e-82ac-754ecc3aac80"],
 ", and the single pairing value ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{
      StyleBox["x", "TI"], ",", 
      StyleBox["y", "TI"]}], "\[RightAngleBracket]"}], "\[LongEqual]", "1"}], 
   TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f4861f11-15b7-486e-8915-3b789bd5c197"],
 " \[LongDash] is not an arbitrary choice of example. It is what the \
construction of the companion tutorial produces when it is fed the minimal \
model of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["S", "TI"], "1"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5437f78d-d55d-4783-ba17-cdb8fe9ad23b"],
 ". This tutorial runs it, and then checks the three facts about the circle \
that the paper's Section 2 proves."
}], "Text",ExpressionUUID->"524eaaff-6be4-480f-8a91-7dae07e7feec"],

Cell["The model of the circle", "Section",ExpressionUUID->"d02c625c-fcb5-4a99-8173-501862f726d9"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["H", "TI"], "*"], "(", 
    SuperscriptBox[
     StyleBox["S", "TI"], "1"], ")"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1973ec8f-4273-449c-a8b7-e853355eb50b"],
 " is free on one generator of degree ",
 Cell[BoxData[
  FormBox["1", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "621c6078-6da1-403b-83e3-24dddf3c8b2e"],
 ", so the minimal model is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalLambda]", "(", 
    StyleBox["v", "TI"], ")"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "091582a7-ec82-4e10-abea-9d622719443b"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{"|", 
    StyleBox["v", "TI"], "|", "\[LongEqual]", "1"}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "58bcddb0-c48c-4f1c-9b76-84612ee29e1d"],
 " and zero differential. Since ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{
     RowBox[{
       StyleBox["v", "TI"]}]},
    "Abs"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f7aca397-b2ba-4b17-b57c-706f88bcfec9"],
 " is odd, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["v", "TI"], "2"], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "668cc33f-2544-48f4-bb5d-c947bfd5240e"],
 ", and the algebra is two-dimensional to begin with."
}], "Text",ExpressionUUID->"56ab6725-01ed-4081-b58a-255ac83cc7a2"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"circle", " ", "=", " ", 
   RowBox[{"SullivanModel", "[", "\"\<Circle\>\"", "]"}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Normal", "[", 
    RowBox[{"circle", "[", "\"\<Generators\>\"", "]"}], "]"}], ",", " ", 
   RowBox[{"circle", "[", "\"\<Volume\>\"", "]"}], ",", " ", 
   RowBox[{"circle", "[", "\"\<Degree\>\"", "]"}]}], "}"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"503cb41b-1b1d-4c5c-9d8d-2bef2b339dcc"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"v", "\[Rule]", "1"}], "}"}], ",", 
   RowBox[{"{", "v", "}"}], ",", "1"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"b72815cd-a217-4255-a969-95cc23a63fd9"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", 
  RowBox[{
   RowBox[{"SullivanModelBasis", "[", 
    RowBox[{"circle", ",", " ", "k"}], "]"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"k", ",", " ", "0", ",", " ", "3"}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"fd2be2c3-dfae-45b7-8f08-e0790540b83b"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", "1", "}"}], ",", 
   RowBox[{"{", "v", "}"}], ",", 
   RowBox[{"{", "}"}], ",", 
   RowBox[{"{", "}"}]}], "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"e08d3f17-a6fc-47ca-89cd-21eba8a7c838"]
}, Open  ]],

Cell[TextData[{
 "The volume form is ",
 Cell[BoxData[
  FormBox[
   StyleBox["v", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c1cb35e5-9b7f-43b1-a561-4bea589dbd5f"],
 " itself, so the orientation is \"the coefficient of ",
 Cell[BoxData[
  FormBox[
   StyleBox["v", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d3af4627-dc41-4a28-a71e-c6ed0aae7852"],
 "\" \[LongDash] on the circle, integration. The pairing ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{
      SubscriptBox[
       StyleBox["v", "TI"], "1"], ",", 
      SubscriptBox[
       StyleBox["v", "TI"], "2"]}], "\[RightAngleBracket]"}], "\[LongEqual]", 
    
    StyleBox["O", "TI"], 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox[
       StyleBox["v", "TI"], "1"], 
      SubscriptBox[
       StyleBox["v", "TI"], "2"]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ca0f2c12-cb0b-4ff0-9846-f14651fed672"],
 " is already perfect: nothing is degenerate, and the model is its own \
nondegenerate quotient."
}], "Text",ExpressionUUID->"01cc3fcd-b942-4e0f-9775-32ce22eb6c72"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"quotient", " ", "=", " ", 
   RowBox[{"NondegenerateQuotient", "[", "circle", "]"}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"quotient", "[", "\"\<Basis\>\"", "]"}], ",", " ", 
   RowBox[{"quotient", "[", "\"\<Degrees\>\"", "]"}], ",", " ", 
   RowBox[{"quotient", "[", "\"\<Pairing\>\"", "]"}]}], "}"}]}], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"5d91e5a4-b641-4058-bc54-17f10d2bcc32"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", "v"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", "1"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"1", ",", "0"}], "}"}]}], "}"}]}], "}"}]], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"81d395aa-ebbf-4e27-bcef-7fa092218012"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"HodgeTypeQ", "[", "circle", "]"}]], "Input",
 CellLabel->"In[4]:= ",ExpressionUUID->"68e50296-c002-4e05-a6eb-c512c551bafe"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[4]= ",ExpressionUUID->"1ab00e60-4912-4350-b353-33d03cc8ef32"]
}, Open  ]],

Cell["The alphabet, named", "Section",ExpressionUUID->"65da5a3a-4c17-4338-ac7b-65dc6546c7ac"],

Cell[TextData[{
 "Shifting down by one and naming the two basis vectors ",
 Cell[BoxData[
  FormBox[
   StyleBox["x", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2e86f1a0-8b74-47b7-b55c-bbe24e1baa28"],
 " and ",
 Cell[BoxData[
  FormBox[
   StyleBox["y", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0af3301b-284b-476e-a617-7f1805bd5678"],
 " gives the alphabet. The shift turns the graded symmetric pairing of degree \
",
 Cell[BoxData[
  FormBox["1", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ff97677e-af0c-4fe3-ad09-0a7ae2c470e3"],
 " into a graded antisymmetric pairing of degree ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", "1"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "49f4534d-0683-490c-86c9-12bf48782034"],
 ", which is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["n", "TI"], "-", "2"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "07c2fe84-518c-4abf-ad8b-de44af179b65"],
 "."
}], "Text",ExpressionUUID->"95c1d11e-2993-4223-9241-a7ae4b2a26db"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"pairing", " ", "=", " ", 
   RowBox[{"GradedPairing", "[", 
    RowBox[{"quotient", ",", " ", 
     RowBox[{"{", 
      RowBox[{"x", ",", " ", "y"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Normal", "[", 
    RowBox[{"pairing", "[", "\"\<Degrees\>\"", "]"}], "]"}], ",", " ", 
   RowBox[{"pairing", "[", "\"\<Degree\>\"", "]"}]}], "}"}]}], "Input",
 CellLabel->"In[5]:= ",ExpressionUUID->"92a95622-492c-42f0-be32-67f83b10274f"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"x", "\[Rule]", 
      RowBox[{"-", "1"}]}], ",", 
     RowBox[{"y", "\[Rule]", "0"}]}], "}"}], ",", 
   RowBox[{"-", "1"}]}], "}"}]], "Output",
 CellLabel->"Out[5]= ",ExpressionUUID->"616ab7a7-55f7-4e6d-8986-e1d9789462a5"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Normal", "[", 
  RowBox[{"pairing", "[", "\"\<Values\>\"", "]"}], "]"}]], "Input",
 CellLabel->"In[6]:= ",ExpressionUUID->"d7904f6e-2e9a-452a-af60-61944df285a9"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{"x", ",", "x"}], "}"}], "\[Rule]", "0"}], ",", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"x", ",", "y"}], "}"}], "\[Rule]", "1"}], ",", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"y", ",", "x"}], "}"}], "\[Rule]", 
    RowBox[{"-", "1"}]}], ",", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"y", ",", "y"}], "}"}], "\[Rule]", "0"}]}], "}"}]], "Output",
 CellLabel->"Out[6]= ",ExpressionUUID->"19879d53-2557-409b-aafb-4e4a4ffd60d0"]
}, Open  ]],

Cell["\<\
This is the running example of every reference page in the paclet, on the \
nose:\
\>", "Text",ExpressionUUID->"f811fbf7-4005-4351-a737-8fa06817aef5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"KeyDrop", "[", 
   RowBox[{"pairing", ",", " ", "\"\<Algebra\>\""}], "]"}], " ", "===", " ", 
  RowBox[{"GradedPairing", "[", 
   RowBox[{
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"x", " ", "->", " ", 
       RowBox[{"-", "1"}]}], ",", " ", 
      RowBox[{"y", " ", "->", " ", "0"}]}], "|>"}], ",", " ", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"x", ",", " ", "y"}], "}"}], " ", "->", " ", "1"}], "|>"}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[7]:= ",ExpressionUUID->"dd985f0a-617a-49b4-9b3b-3733df534805"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[7]= ",ExpressionUUID->"cbefb242-8793-4623-86bc-04364269fb04"]
}, Open  ]],

Cell[TextData[{
 "The one thing the derived object carries that the hand-written one does not \
is the algebra it came from, under the key ",
 Cell[BoxData["\"\<Algebra\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fedf3b68-b44f-4967-bf6f-e404a4106378"],
 "; that is what lets ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CanonicalMaurerCartan"]], 
    "paclet:ChernSimons/ref/CanonicalMaurerCartan", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "89cdc61e-94f4-4405-a0b7-e7924823db4a"],
 " work from it."
}], "Text",ExpressionUUID->"19792ff0-8a4d-4f7d-8519-9fab25841dfe"],

Cell[TextData[{
 "The element ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["x", "TI"], "2"], 
    StyleBox["y", "TI"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6b3498a6-5245-427e-92cf-83621a11ffde"]
}], "Section",ExpressionUUID->"6557891f-fc92-4bf4-8097-a4017368dad2"],

Cell[TextData[{
 "The triple product of the two-dimensional algebra has one value up to \
symmetry, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["O", "TI"], 
    RowBox[{"(", 
     RowBox[{"1", "\[CenterDot]", "1", "\[CenterDot]", 
      StyleBox["v", "TI"]}], ")"}], "\[LongEqual]", "1"}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cab1e45d-2436-4708-b50f-e568ea967994"],
 ", so the canonical Maurer-Cartan element is a single cyclic word of length \
three."
}], "Text",ExpressionUUID->"1021097d-1e5e-480a-9dbd-1b32f6e5b6e3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"m", " ", "=", " ", 
  RowBox[{"CanonicalMaurerCartan", "[", "pairing", "]"}]}]], "Input",
 CellLabel->"In[8]:= ",ExpressionUUID->"9a1c1800-d950-4f69-b9e7-83ac53eb2ad1"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"(", 
   RowBox[{"x", "\[ThinSpace]", "x", "\[ThinSpace]", "y"}], ")"}],
  ChernSimons`CyclicWord[{
   MTNB$cn55jhwrptkf`x, MTNB$cn55jhwrptkf`x, MTNB$cn55jhwrptkf`y}],
  Editable->False]], "Output",
 CellLabel->"Out[8]= ",ExpressionUUID->"23d44149-7194-4154-bc8f-6138ab7bdae0"]
}, Open  ]],

Cell[TextData[{
 "That is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["m", "TI"], 
     RowBox[{"1", ",", "0"}], 
     StyleBox["can",
      FontSlant->"Plain"]], "\[LongEqual]", 
    SuperscriptBox[
     StyleBox["x", "TI"], "2"], 
    StyleBox["y", "TI"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8d2faea2-ab51-4452-9cff-8c6bab85a06c"],
 ", coefficient and all \[LongDash] the element the paper's Section 2 starts \
from. The general formula sums over all ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["3", "3"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b29e51a0-9428-4540-a8da-7ef1bba65f98"],
 " index triples with the reversal sign and a factor ",
 Cell[BoxData[
  FormBox[
   FractionBox["1", "3"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cdfae769-7f5f-4a9b-a95e-8a297d401629"],
 "; here three of them are nonzero, they agree after the cyclic rotations are \
normalised, and the ",
 Cell[BoxData[
  FormBox[
   FractionBox["1", "3"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b67e53e6-64b5-46cc-811d-44fb759ec5b8"],
 " cancels."
}], "Text",ExpressionUUID->"13e8a53d-e6da-42b3-8767-c05ebee4c56b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"MaurerCartanQ", "[", 
  RowBox[{"m", ",", " ", "pairing"}], "]"}]], "Input",
 CellLabel->"In[9]:= ",ExpressionUUID->"8381a712-84cd-45e3-a677-3c334e294ad0"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[9]= ",ExpressionUUID->"60235668-03b0-486c-9aaa-ea5af41e8a0a"]
}, Open  ]],

Cell["The three facts", "Section",ExpressionUUID->"ad39e873-918d-4baa-b011-ee2594238c6b"],

Cell[TextData[{
 StyleBox["The Hochschild differential.",
  FontWeight->"Bold"],
 " Twisting ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["q", "TI"], 
    RowBox[{"2", ",", "1", ",", "0"}]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b80eeca5-63d4-492b-9075-6f34b2c0cb8e"],
 " by ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["m", "TI"], 
    StyleBox["can",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f362bfc4-5d1a-42c1-b439-932b6ad74a04"],
 " gives ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["q", "TI"], 
     RowBox[{"1", ",", "1", ",", "0"}], 
     StyleBox["m", "TI"]], "\[LongEqual]", 
    StyleBox["H",
     FontSlant->"Plain"], 
    SuperscriptBox[
     StyleBox["d", "TI"], "*"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2cb7b2a3-d41a-4565-a902-3d4e0815d1e5"],
 ", which inserts one letter ",
 Cell[BoxData[
  FormBox[
   StyleBox["x", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2b9ac1e9-cfa8-4cb8-a9db-e13752b6af10"],
 ": on the words ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["x", "TI"], 
     StyleBox["a", "TI"]], 
    SuperscriptBox[
     StyleBox["y", "TI"], 
     StyleBox["b", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "40eba27f-f187-4d01-98d1-8dc479d1b6d2"],
 " it is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["x", "TI"], 
     RowBox[{
      StyleBox["a", "TI"], "+", "1"}]], 
    SuperscriptBox[
     StyleBox["y", "TI"], 
     StyleBox["b", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7a18371c-4143-4ab6-978d-586f3964e67f"],
 " for ",
 Cell[BoxData[
  FormBox[
   StyleBox["a", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b1e41aff-6a7a-4bc9-9079-d40e6181990a"],
 " odd and ",
 Cell[BoxData[
  FormBox["0", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e0db52e1-3764-4a45-92ec-d5ea31306231"],
 " for ",
 Cell[BoxData[
  FormBox[
   StyleBox["a", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "49b7c9b0-fd9c-422f-a1a2-d3bcd5c5615a"],
 " even."
}], "Text",ExpressionUUID->"420f1507-42e7-4f86-a9fd-a02e6abaa8b3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"TwistedDifferential", "[", 
    RowBox[{"m", ",", " ", 
     RowBox[{"CyclicWord", "[", 
      RowBox[{"{", 
       RowBox[{"x", ",", " ", "y", ",", " ", "y"}], "}"}], "]"}], ",", " ", 
     "pairing"}], "]"}], ",", "\n", " ", 
   RowBox[{"TwistedDifferential", "[", 
    RowBox[{"m", ",", " ", 
     RowBox[{"CyclicWord", "[", 
      RowBox[{"{", 
       RowBox[{"x", ",", " ", "x", ",", " ", "x", ",", " ", "y"}], "}"}], 
      "]"}], ",", " ", "pairing"}], "]"}]}], "}"}]], "Input",
 CellLabel->
