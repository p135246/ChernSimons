Notebook[{

Cell[CellGroupData[{
Cell["The Canonical IBL Algebra of the Circle", "Title",
 CellID->509267359,ExpressionUUID->"4ddb5767-1f00-4973-a411-49eacd07850d"],

Cell[TextData[{
 "The alphabet the rest of this paclet is written against, a particle ",
 Cell[BoxData[
  FormBox[
   StyleBox["x", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c68ed232-66dc-49fb-a56d-644810ec49d8"],
 " of degree ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", "1"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9e7414dc-6ba2-4915-94c7-3cdc32d64270"],
 ", a particle ",
 Cell[BoxData[
  FormBox[
   StyleBox["y", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cd42a9b1-83df-4de3-ab5f-c6ac1e00f2bb"],
 " of degree ",
 Cell[BoxData[
  FormBox["0", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cb396e39-26f3-4dcc-97de-c6f482daaaf6"],
 " and the single pairing value ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{
      StyleBox["x", "TI"], ",", 
      StyleBox["y", "TI"]}], "\[RightAngleBracket]"}], "\[LongEqual]", "1"}], 
   TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "92621073-63f5-4e8d-9558-9858e8c8c85f"],
 ", is not an arbitrary choice of example. It is what the construction of the \
companion tutorial produces when it is fed the minimal model of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["S", "TI"], "1"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0406b792-5174-4eb6-bcc9-7d6456d7aff5"],
 ". This tutorial runs it, and then checks the three facts about the circle \
that the paper's Section 2 proves."
}], "Text",ExpressionUUID->"472ac169-86d7-4459-9ea6-4666b68efd5d"],

Cell["The model of the circle", "Section",ExpressionUUID->"626ca5cd-d530-43dc-9d35-7c45a0925ad4"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["H", "TI"], "*"], "(", 
    SuperscriptBox[
     StyleBox["S", "TI"], "1"], ")"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f49877d4-fb94-43d1-8ff2-27919f44c59d"],
 " is free on one generator of degree ",
 Cell[BoxData[
  FormBox["1", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "46102f40-ac6b-4405-9ed1-4536353a4760"],
 ", so the minimal model is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalLambda]", "(", 
    StyleBox["v", "TI"], ")"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0aab8605-438e-4018-9155-a77ff0c39777"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{"|", 
    StyleBox["v", "TI"], "|", "\[LongEqual]", "1"}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "43a126a5-a060-4a02-95c5-bd8a80b38001"],
 " and zero differential. Since ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{
     RowBox[{
       StyleBox["v", "TI"]}]},
    "Abs"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a25687f3-8f9c-4437-81ac-f878fed97c9b"],
 " is odd, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["v", "TI"], "2"], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f23a2315-a648-4917-a2c6-5551e274964f"],
 ", and the algebra is two-dimensional to begin with."
}], "Text",ExpressionUUID->"f7b45d7f-d923-4c76-91c5-7aba431f5fbb"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"circle", " ", "=", " ", 
   RowBox[{"SullivanModel", "[", "\"\<Circle\>\"", "]"}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Normal", "[", 
    RowBox[{"circle", "[", "\"\<Generators\>\"", "]"}], "]"}], ",", " ", 
   RowBox[{"circle", "[", "\"\<Orientation\>\"", "]"}], ",", " ", 
   RowBox[{"circle", "[", "\"\<Degree\>\"", "]"}]}], "}"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"2d6f79f8-f185-407f-a3b8-7c30dcb77045"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"v", "\[Rule]", "1"}], "}"}], ",", 
   RowBox[{"\[LeftAssociation]", 
    RowBox[{"v", "\[Rule]", "1"}], "\[RightAssociation]"}], ",", "1"}], 
  "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"04ed8e2a-53fc-489b-8874-57a83169175b"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", 
  RowBox[{
   RowBox[{"SullivanModelBasis", "[", 
    RowBox[{"circle", ",", " ", "k"}], "]"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"k", ",", " ", "0", ",", " ", "3"}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"f0512517-e72f-4880-bd91-e9ef760dc15b"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", "1", "}"}], ",", 
   RowBox[{"{", "v", "}"}], ",", 
   RowBox[{"{", "}"}], ",", 
   RowBox[{"{", "}"}]}], "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"2a469bd6-901d-42a9-8ce2-1df23fb0b10b"]
}, Open  ]],

Cell[TextData[{
 "The orientation is ",
 Cell[BoxData[
  FormBox["1", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a2f6ab47-6500-4c63-88ac-c9af3298135d"],
 " on ",
 Cell[BoxData[
  FormBox[
   StyleBox["v", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e38a9153-78b5-4718-8747-09ad509e2165"],
 " itself, so it is \"the coefficient of ",
 Cell[BoxData[
  FormBox[
   StyleBox["v", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4ff133b7-4704-4579-becb-d5f3b1dd61f4"],
 "\": on the circle, integration. The pairing ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{
      SubscriptBox[
       StyleBox["v", "TI"], "1"], ",", 
      SubscriptBox[
       StyleBox["v", "TI"], "2"]}], "\[RightAngleBracket]"}], "\[LongEqual]", 
    
    StyleBox["O", "TI"], 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox[
       StyleBox["v", "TI"], "1"], 
      SubscriptBox[
       StyleBox["v", "TI"], "2"]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "171bad9f-317b-4c2b-8782-7fe29484e1a8"],
 " is already perfect: nothing is degenerate, and the model is its own \
nondegenerate quotient."
}], "Text",ExpressionUUID->"dcae829a-248d-482e-95a4-7913316ed205"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"quotient", " ", "=", " ", 
   RowBox[{"NondegenerateQuotient", "[", "circle", "]"}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"quotient", "[", "\"\<Basis\>\"", "]"}], ",", " ", 
   RowBox[{"quotient", "[", "\"\<Degrees\>\"", "]"}], ",", " ", 
   RowBox[{"quotient", "[", "\"\<Pairing\>\"", "]"}]}], "}"}]}], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"2c9d5456-0fa6-4df7-925f-7fe5ec1a0da6"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", "v"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", "1"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"1", ",", "0"}], "}"}]}], "}"}]}], "}"}]], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"f8ced83f-b7fb-47fb-b339-2641f27b6c3c"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"HodgeTypeQ", "[", "circle", "]"}]], "Input",
 CellLabel->"In[4]:= ",ExpressionUUID->"26ed73f7-d4a5-4e77-aea3-403d07384242"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[4]= ",ExpressionUUID->"6c0de74c-5fca-4041-9d40-df83c28c557b"]
}, Open  ]],

Cell["The alphabet, named", "Section",ExpressionUUID->"7b694400-3781-4cae-a1ba-025f43e1f80f"],

Cell[TextData[{
 "Shifting down by one and naming the two basis vectors ",
 Cell[BoxData[
  FormBox[
   StyleBox["x", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3d93b831-bb05-440f-be7a-ad728122ffa9"],
 " and ",
 Cell[BoxData[
  FormBox[
   StyleBox["y", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9922e6bb-6aeb-4470-84b7-8a16916403ae"],
 " gives the alphabet. The shift turns the graded symmetric pairing of degree \
",
 Cell[BoxData[
  FormBox["1", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0a4ba87f-e50e-44af-b732-66f382e012dc"],
 " into a graded antisymmetric pairing of degree ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", "1"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fce13b8f-3299-4544-9f19-663dd2644eb1"],
 ", which is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["n", "TI"], "-", "2"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b700faf4-8a24-4d9c-9a2d-daf5e1d52ca8"],
 "."
}], "Text",ExpressionUUID->"e8b6126f-bed3-425a-ab73-e03d1eb7b507"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"pairing", " ", "=", " ", 
   RowBox[{"GradedPairing", "[", 
    RowBox[{"quotient", ",", " ", 
     RowBox[{"{", 
      RowBox[{"x", ",", " ", "y"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Normal", "[", 
    RowBox[{"pairing", "[", "\"\<Degrees\>\"", "]"}], "]"}], ",", " ", 
   RowBox[{"pairing", "[", "\"\<Degree\>\"", "]"}]}], "}"}]}], "Input",
 CellLabel->"In[5]:= ",ExpressionUUID->"55deda77-40a9-4e6a-bb47-a1162c15c86c"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"x", "\[Rule]", 
      RowBox[{"-", "1"}]}], ",", 
     RowBox[{"y", "\[Rule]", "0"}]}], "}"}], ",", 
   RowBox[{"-", "1"}]}], "}"}]], "Output",
 CellLabel->"Out[5]= ",ExpressionUUID->"779634d9-7e3f-4019-98a6-c7886a237b39"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Normal", "[", 
  RowBox[{"pairing", "[", "\"\<Values\>\"", "]"}], "]"}]], "Input",
 CellLabel->"In[6]:= ",ExpressionUUID->"4f08758d-0ac2-4067-8109-dfbe6f9df503"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{"x", ",", "x"}], "}"}], "\[Rule]", "0"}], ",", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"x", ",", "y"}], "}"}], "\[Rule]", "1"}], ",", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"y", ",", "x"}], "}"}], "\[Rule]", 
    RowBox[{"-", "1"}]}], ",", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"y", ",", "y"}], "}"}], "\[Rule]", "0"}]}], "}"}]], "Output",
 CellLabel->"Out[6]= ",ExpressionUUID->"feb477d7-9c5f-41bf-a26e-1647f338de82"]
}, Open  ]],

Cell["\<\
This is the running example of every reference page in the paclet, on the \
nose:\
\>", "Text",ExpressionUUID->"902eb25b-a15c-4b48-bfc5-74ab67f67174"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"KeyDrop", "[", 
   RowBox[{"pairing", ",", " ", "\"\<Algebra\>\""}], "]"}], " ", "===", " ", 
  RowBox[{"GradedPairing", "[", 
   RowBox[{
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"x", " ", "->", " ", 
       RowBox[{"-", "1"}]}], ",", " ", 
      RowBox[{"y", " ", "->", " ", "0"}]}], "|>"}], ",", " ", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"x", ",", " ", "y"}], "}"}], " ", "->", " ", "1"}], "|>"}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[7]:= ",ExpressionUUID->"5f58cbb1-c48f-41e9-9781-58cf9fd5d106"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[7]= ",ExpressionUUID->"ec53a1d8-4749-4ba0-9dc0-bfef508dc989"]
}, Open  ]],

Cell[TextData[{
 "The one thing the derived object carries that the hand-written one does not \
is the algebra it came from, under the key ",
 Cell[BoxData["\"\<Algebra\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "959aa53c-3743-4fdb-b074-e9cefb189e59"],
 "; that is what lets ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CanonicalMaurerCartan"]], 
    "paclet:ChernSimons/ref/CanonicalMaurerCartan", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "240f8b75-e2a3-4c7c-b9e7-3b9e35e58354"],
 " work from it."
}], "Text",ExpressionUUID->"6e6569d9-5549-4998-92ad-9caa1d026825"],

Cell[TextData[{
 "The element ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["x", "TI"], "2"], 
    StyleBox["y", "TI"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5b91bb9b-ac82-40c0-a267-fdeecf211904"]
}], "Section",ExpressionUUID->"6541429f-1131-467e-a347-889c3b5d8cec"],

Cell[TextData[{
 "The triple product of the two-dimensional algebra has one value up to \
symmetry, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["O", "TI"], 
    RowBox[{"(", 
     RowBox[{"1", "\[CenterDot]", "1", "\[CenterDot]", 
      StyleBox["v", "TI"]}], ")"}], "\[LongEqual]", "1"}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "893585e6-cb4b-48ef-a912-a7261a9a7c12"],
 ", so the canonical Maurer-Cartan element is a single cyclic word of length \
three. The element is a ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["MaurerCartanElement"]], 
    "paclet:ChernSimons/ref/MaurerCartanElement", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "9fbbc879-e848-4060-bce1-4a93fcd3f2a0"],
 " whose one part ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["m", "TI"], 
    RowBox[{"1", ",", "0"}]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2faf00ce-f849-4d94-8d90-4e7eefaf66b1"],
 " is that word."
}], "Text",ExpressionUUID->"3d70b048-c1d7-4652-b5f6-469a63d20855"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"m", " ", "=", " ", 
   RowBox[{"CanonicalMaurerCartan", "[", "pairing", "]"}]}], ";"}], "\n", 
 RowBox[{"m", "[", 
  RowBox[{"{", 
   RowBox[{"1", ",", " ", "0"}], "}"}], "]"}]}], "Input",
 CellLabel->"In[8]:= ",ExpressionUUID->"aa96c070-f420-489c-9263-2e5eda726448"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"(", 
   RowBox[{"x", "\[ThinSpace]", "x", "\[ThinSpace]", "y"}], ")"}],
  ChernSimons`CyclicWord[{
   MTNB$zqhzetch4oan`x, MTNB$zqhzetch4oan`x, MTNB$zqhzetch4oan`y}],
  Editable->False]], "Output",
 CellLabel->"Out[8]= ",ExpressionUUID->"090bb00f-f61f-4392-9e76-80bbfa10dad1"]
}, Open  ]],

Cell[TextData[{
 "That is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["m", "TI"], 
     RowBox[{"1", ",", "0"}], 
     StyleBox["can",
      FontSlant->"Plain"]], "\[LongEqual]", 
    SuperscriptBox[
     StyleBox["x", "TI"], "2"], 
    StyleBox["y", "TI"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9e03c6c1-ee34-421d-ac77-ba9437e16d91"],
 ", coefficient and all. It is the element the paper's Section 2 starts from. \
The general formula sums over all ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["3", "3"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "41ed94eb-815f-40c8-b4c0-85c5052af26c"],
 " index triples with the reversal sign and a factor ",
 Cell[BoxData[
  FormBox[
   FractionBox["1", "3"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "191f3fd4-a311-4893-a85c-0b0f54881aef"],
 "; here three of them are nonzero, they agree after the cyclic rotations are \
normalised, and the ",
 Cell[BoxData[
  FormBox[
   FractionBox["1", "3"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fb8de622-0a1c-4b96-a4e7-b9a808e9a7af"],
 " cancels."
}], "Text",ExpressionUUID->"a562ff89-a456-4803-9803-682e5884b375"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"RelationsQ", "[", "m", "]"}]], "Input",
 CellLabel->"In[9]:= ",ExpressionUUID->"c449199f-cfcd-4ca1-8674-f5a63ef1e4a9"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[9]= ",ExpressionUUID->"8c08ac72-c51c-4cb8-851b-cb2f63b1db04"]
}, Open  ]],

Cell["The three facts", "Section",ExpressionUUID->"c665a111-d8c6-439a-b54c-fa41c990903c"],

Cell[TextData[{
 "The Hochschild differential. Twisting ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["q", "TI"], 
    RowBox[{"2", ",", "1", ",", "0"}]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9ea4c4bb-7531-4d70-8a24-dffe6cee6f7a"],
 " by ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["m", "TI"], 
    StyleBox["can",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a48e83ef-8536-441e-b4c5-552ca024aa87"],
 " gives ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["q", "TI"], 
     RowBox[{"1", ",", "1", ",", "0"}], 
     StyleBox["m", "TI"]], "\[LongEqual]", 
    StyleBox["H",
     FontSlant->"Plain"], 
    SuperscriptBox[
     StyleBox["d", "TI"], "*"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dd793b5b-5947-4445-a7f6-ec65eeaabea4"],
 ", which inserts one letter ",
 Cell[BoxData[
  FormBox[
   StyleBox["x", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3fe8fffc-1df1-4d31-8fc1-d15357279a08"],
 ": on the words ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["x", "TI"], 
     StyleBox["a", "TI"]], 
    SuperscriptBox[
     StyleBox["y", "TI"], 
     StyleBox["b", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1625f362-1f5d-4ff2-8389-ee846e041e42"],
 " it is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["x", "TI"], 
     RowBox[{
      StyleBox["a", "TI"], "+", "1"}]], 
    SuperscriptBox[
     StyleBox["y", "TI"], 
     StyleBox["b", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "905067b0-75e2-458c-a1a2-54edcb5d4557"],
 " for ",
 Cell[BoxData[
  FormBox[
   StyleBox["a", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "450c0d14-3e73-4fba-ba96-d4f45640e9b1"],
 " odd and ",
 Cell[BoxData[
  FormBox["0", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b9769f89-3201-4be1-8331-71fc1f07040a"],
 " for ",
 Cell[BoxData[
  FormBox[
   StyleBox["a", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
