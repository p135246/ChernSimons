Cell["AInfinityAlgebraQ", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"e25686d3-177c-4f9e-b54a-4134b7222909"],
