Cell["\<\
The first nonzero co-bracket over the alphabet of the circle:\
\>", "ExampleText",ExpressionUUID->"1568c826-72e1-429a-89e8-da584f3b51e1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"StringCobracket", "[", 
  RowBox[{
   RowBox[{"CyclicWord", "[", 
    RowBox[{"{", 
     RowBox[{"x", ",", " ", "y", ",", " ", "y", ",", " ", "y"}], "}"}], "]"}],
    ",", " ", 
   RowBox[{"GradedPairing", "[", 
    RowBox[{
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"x", " ", "->", " ", 
        RowBox[{"-", "1"}]}], ",", " ", 
       RowBox[{"y", " ", "->", " ", "0"}]}], "|>"}], ",", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "y"}], "}"}], " ", "->", " ", "1"}], "|>"}]}], 
    "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"8d466e23-66ef-4ff5-9056-91feddb05755"],

Cell[BoxData[
 RowBox[{"-", 
  InterpretationBox[
   RowBox[{
    InterpretationBox[
     RowBox[{"(", "y", ")"}],
     ChernSimons`CyclicWord[{MTNB$7c9738l9n68o`y}],
     Editable->False], "\[CircleDot]", 
    InterpretationBox[
     RowBox[{"(", "y", ")"}],
     ChernSimons`CyclicWord[{MTNB$7c9738l9n68o`y}],
     Editable->False]}],
   ChernSimons`SymmetricProduct[
    ChernSimons`CyclicWord[{MTNB$7c9738l9n68o`y}], 
    ChernSimons`CyclicWord[{MTNB$7c9738l9n68o`y}]],
   Editable->False]}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"2caab8dd-0d3f-452f-86d1-b7751a36fc0e"]
}, Open  ]],

