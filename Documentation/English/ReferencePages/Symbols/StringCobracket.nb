   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "cb25ca40-5df9-4484-b75f-e0de3e0a0302"],
 " over every ordered pair of distinct positions."
}], "Notes",ExpressionUUID->"bf00ab50-308b-4a6e-9712-162ef7c98996"],

Cell[TextData[{
 "The convention of ",
 StyleBox["pairing", "TI"],
 " selects the picture: the result is a ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SymmetricProduct"]], "paclet:ChernSimons/ref/SymmetricProduct",
     "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "64def3f1-9321-4edf-bfef-c25817c0675a"],
 " under ",
 Cell[BoxData["\"\<Symmetric\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "79904feb-9fe2-40a1-b6c0-74d50239d722"],
 " and an ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ExteriorProduct"]], "paclet:ChernSimons/ref/ExteriorProduct", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "74c50eb3-3404-4909-b699-3ccb3d4b4c5a"],
