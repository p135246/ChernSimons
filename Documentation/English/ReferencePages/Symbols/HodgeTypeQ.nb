Cell["\<\
Everything in the catalogue but the last name is of Hodge type:\
\>", "ExampleText",ExpressionUUID->"409fe958-72a4-4b79-807f-0518d7085e77"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Map", "[", 
  RowBox[{
   RowBox[{"name", " ", "|->", " ", 
    RowBox[{"name", " ", "->", " ", 
     RowBox[{"HodgeTypeQ", "[", 
      RowBox[{"SullivanModel", "[", "name", "]"}], "]"}]}]}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"\"\<Circle\>\"", ",", " ", 
     RowBox[{"\"\<Sphere\>\"", "[", "2", "]"}], ",", " ", 
     RowBox[{"\"\<Sphere\>\"", "[", "3", "]"}], ",", " ", 
     RowBox[{"\"\<ComplexProjectiveSpace\>\"", "[", "2", "]"}], ",", "\n", 
     "   ", 
     RowBox[{"\"\<QuaternionicProjectiveSpace\>\"", "[", "2", "]"}], ",", " ", 
     RowBox[{"\"\<Torus\>\"", "[", "3", "]"}], ",", " ", 
     RowBox[{"\"\<SpecialUnitaryGroup\>\"", "[", "3", "]"}], ",", "\n", 
     "   ", "\"\<HeisenbergNilmanifold\>\"", ",", 
     " ", "\"\<KodairaThurston\>\"", ",", " ", "\"\<Degree4Obstruction\>\""}],
     "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"bb4ef787-faa1-4f1e-b333-076b9db6276a"],

