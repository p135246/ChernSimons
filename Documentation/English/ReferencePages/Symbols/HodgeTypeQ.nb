Cell[TextData[{
 "A Hodge decomposition of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     StyleBox["V", "TI"], ",", 
     StyleBox["d",
      FontSlant->"Plain"], ",", 
     RowBox[{"\[LeftAngleBracket]", 
      RowBox[{"-", ",", "-"}], "\[RightAngleBracket]"}]}], ")"}], 
   TraditionalForm]], "InlineFormula",ExpressionUUID->
  "162befd4-2e6f-415d-9c0b-087b7862c945"],
 " is a splitting ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["V", "TI"], "\[LongEqual]", 
    StyleBox["H", "TI"], "\[CirclePlus]", 
    StyleBox["im",
     FontSlant->"Plain"], " ", 
    StyleBox["d",
     FontSlant->"Plain"], "\[CirclePlus]", 
    StyleBox["C", "TI"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "3c91f418-afc8-4957-a83d-dcc3cdda1297"],
 " with ",
 Cell[BoxData[
  FormBox[
   StyleBox["H", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "300a2087-c7c9-456c-b771-941d483ee20e"],
 " a complement of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["im",
     FontSlant->"Plain"], " ", 
    StyleBox["d",
     FontSlant->"Plain"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "71211ea0-fa8f-49cb-a42c-df1f331fa814"],
 " in ",
 Cell[BoxData[
  FormBox[
   RowBox[{"ker", 
    StyleBox["d",
     FontSlant->"Plain"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "649c1fa3-cb75-47a7-9ad3-e86b37ad01c3"],
 ", ",
 Cell[BoxData[
  FormBox[
   StyleBox["C", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "bc3fdf9f-7788-47ce-8464-99a11e59cc0c"],
 " a complement of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"ker", 
    StyleBox["d",
     FontSlant->"Plain"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "1303555a-6aaa-4da1-9287-0a03c13ce59c"],
 " in ",
 Cell[BoxData[
  FormBox[
   StyleBox["V", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "b80b82a0-8c90-4f07-800f-71b0029b5605"],
 ", and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["C", "TI"], "\[Perpendicular]", 
    StyleBox["C", "TI"], "\[CirclePlus]", 
    StyleBox["H", "TI"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "7c8d4eac-c04b-48c1-9e95-8193fa6baf65"],
 ". A space admitting one is of Hodge type."
}], "Notes",
 CellFrameLabels->{{Inherited, Inherited}, {Inherited, 
    Cell[
     TextData[{
      "26.09.30: Design review - HodgeTypeQ is a test on the space, not a \
search: it computes the cohomology of the degenerate subspace degree by \
degree, by the criterion of Lemma 3.14 of arXiv:2004.07362, which needs no \
choice of harmonic subspace and no linear system for a twist; \
FindHodgeDecomposition is the search. The criterion assumes that the pairing \
on cohomology is perfect, and without it a degenerate cohomology pairing \
gives a false negative, so since HodgeDecompositions H2 the function first \
asks PoincareDualityQ with the same \"MaxDegree\", and when the answer is \
False it issues the one message HodgeTypeQ::duality and returns unevaluated, \
the rule of the paclet for a predicate that cannot decide. Example 4.3 of \
arXiv:2609.14221 received False for the wrong reason before H2. For a model \
the default range 0 to n+1 is complete once the model is a PDGA of degree n, \
so the option exists only to look further, and since R7 (Pavel, 2026-10-01) a \
value below n returns unevaluated, as in PoincareDualityQ, where it used to \
test fewer degrees and could miss a failure; T17 checks that the verdict does \
not change out to degree 4n+8 on the catalogue. A complex is finite, so every \
degree is tested and that form takes no option. Prior art: the Wolfram \
Language has no test for Hodge type. The engine of the verification suites \
has the same test, and T17 pins the function against it on the thirteen \
catalogue models and the Kodaira-Thurston model.", "\n\n", 
       Cell[
        BoxData[
         GridBox[{{
            Cell[
             BoxData[
              ButtonBox[
               DynamicBox[
                FEPrivate`FrontEndResource[
                "DocumentationToolsStrings", "Edit"]], BaseStyle -> 
               "TextAnnotationButton"]]], 
            StyleBox[
             RowBox[{
               DynamicBox[
                FEPrivate`FrontEndResource[
                "DocumentationToolsStrings", "LastAnnotator"]], "pavel"}], 
             "TextAnnotator"], 
            Cell[
             BoxData[
              ButtonBox[
               DynamicBox[
                FEPrivate`FrontEndResource[
                "DocumentationToolsStrings", "Delete"]], BaseStyle -> 
               "TextAnnotationRemoveButton"]]], ""}}, 
          GridBoxAlignment -> {
           "Columns" -> {Left, Left, Right, Right}, "Rows" -> {{Automatic}}}, 
          GridBoxItemSize -> {"Columns" -> {
              Scaled[0.15], 
              Scaled[0.68], 
              Scaled[0.15], 
              Scaled[0.02]}}]]], "\n"}], "TextAnnotation", 
     CellSize -> {590, Inherited}]}},
 CellTags->"TextAnnotation",
 CellID->198206934,ExpressionUUID->"6044897f-7af0-4304-8aba-f8d870691d54"],

Cell[TextData[{
 "The test is not a search for a decomposition; ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindHodgeDecomposition"]], 
    "paclet:ChernSimons/ref/FindHodgeDecomposition", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "e46ab47e-edf5-4575-9907-9684c76e4298"],
 " finds one."
}], "Notes",ExpressionUUID->"f123372a-319f-4dce-afa3-eb61bcecfe44"],

Cell[TextData[{
 "Over a field of characteristic ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[NotEqual]", "2"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"57652316-f1c8-40f8-a191-bcb19ba5e1aa"],
 ", and for a nondegenerate quotient of finite type, being of Hodge type is \
equivalent to the degenerate subspace being acyclic, and to the quotient map ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Pi]", 
     StyleBox["Q", "TI"]], ":", 
    StyleBox["V", "TI"], "\[Rule]", 
    StyleBox["Q", "TI"], 
    RowBox[{"(", 
     StyleBox["V", "TI"], ")"}]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"e7e7d108-a64b-4cfc-a218-8ae5d6e42735"],
 " being a quasi-isomorphism."
}], "Notes",ExpressionUUID->"52bbf576-d43d-420d-9137-be7431405f29"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["HodgeTypeQ"]], "paclet:ChernSimons/ref/HodgeTypeQ", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "bc5cbca3-b230-4735-9b24-cae183fade06"],
 " computes ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["H", "TI"], 
     StyleBox["k", "TI"]], "(", 
    SubscriptBox[
     StyleBox["V", "TI"], 
     StyleBox["deg",
      FontSlant->"Plain"]], ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"05238593-b83f-47c9-8793-ed69df873318"],
 " degree by degree and gives True when it vanishes in every degree tested."
}], "Notes",ExpressionUUID->"aa54b663-afdd-4a60-83a4-3aead024129a"],

Cell[TextData[{
 "The equivalence needs Poincar\[EAcute] duality on cohomology. When ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["PoincareDualityQ"]], "paclet:ChernSimons/ref/PoincareDualityQ",
     "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "c7e76a76-88b1-4578-97f7-1638b68a14be"],
 " is False, the message ",
 Cell[BoxData[
  RowBox[{"HodgeTypeQ", "::", "duality"}]], "InlineFormula",ExpressionUUID->
  "537decd9-0b03-4c82-887e-1871ec0c6f45"],
 " is issued and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["HodgeTypeQ"]], "paclet:ChernSimons/ref/HodgeTypeQ", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "8729fa75-f6e4-4931-b5b2-1dcea1218562"],
 " returns unevaluated."
}], "Notes",ExpressionUUID->"58b4a513-2e04-4800-9b09-027d2d51ff61"],

Cell[TextData[{
 "For a model the degrees ",
 Cell[BoxData[
  FormBox["0", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "307d6732-814b-47be-83f1-fda0ffac24d1"],
 " to ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["n", "TI"], "+", "1"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"d1171d50-d2bd-482a-9f2f-9e7667ab377d"],
 " are tested by default. The range is complete provided the cohomology of \
the model vanishes above degree ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "825a7572-0ae7-4283-a453-16f9645df629"],
 ", which is part of being a PDGA of degree ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "cd213bbc-e616-4206-8c3a-99d2369b6de2"],
 "."
}], "Notes",ExpressionUUID->"33f38208-5e2a-4921-86e8-8d89dae46d0d"],

Cell[TextData[{
 "Above degree ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "d6f544b2-15c6-4f13-b2f5-9d3c860076fa"],
 " the degenerate subspace is the whole of the model, so for ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["k", "TI"], "\[GreaterEqual]", 
    StyleBox["n", "TI"], "+", "2"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"f53db7fa-5d14-4580-83b0-371d8a3d2919"],
 " both ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["V", "TI"], 
    StyleBox["deg",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["k", "TI"], "-", "1"}]], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"56415fe8-d43b-4791-b9fc-655f047f87c1"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["V", "TI"], 
    StyleBox["deg",
     FontSlant->"Plain"], 
    StyleBox["k", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "f85295a9-02d7-4f81-a88c-488cafb17c6c"],
 " are everything and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["H", "TI"], 
     StyleBox["k", "TI"]], 
    RowBox[{"(", 
     SubscriptBox[
      StyleBox["V", "TI"], 
      StyleBox["deg",
       FontSlant->"Plain"]], ")"}], "\[LongEqual]", 
    SuperscriptBox[
     StyleBox["H", "TI"], 
     StyleBox["k", "TI"]], 
    RowBox[{"(", 
     StyleBox["V", "TI"], ")"}], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"b1329c0c-9e74-4618-b2fd-8cfb301eb9b7"],
 ". Degree ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["n", "TI"], "+", "1"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"ab09649d-210d-43ad-b932-b13468fda9e7"],
 " is the one degree above ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "aef015b7-b691-4ba9-94e1-53978f863684"],
 " where the two can differ, and it is tested."
}], "Notes",ExpressionUUID->"7e9f89a8-8412-4742-a3c5-ed467f94d3eb"],

