Notebook[{

Cell[CellGroupData[{
Cell["HodgeTypeQ", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"3a8781e3-6d88-49bf-b360-538119d20ede"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["HodgeTypeQ"]], "paclet:ChernSimons/ref/HodgeTypeQ", 
     "ChernSimons Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["model", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "09ed79d2-7ee0-47f2-bdc3-9dd7514d518f"],
 "\[LineSeparator]",
 "tests whether the oriented model is of Hodge type.",
 "\n"
}], "Usage",ExpressionUUID->"972be861-b416-499e-8587-c8ddcacc9ccc"],

Cell[TextData[{
 "A ",
 StyleBox["Hodge decomposition", "TI"],
 " of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     StyleBox["V", "TI"], ",", 
     StyleBox["d",
      FontSlant->"Plain"], ",", 
     RowBox[{"\[LeftAngleBracket]", 
      RowBox[{"-", ",", "-"}], "\[RightAngleBracket]"}]}], ")"}], 
   TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f6f7f636-732e-41e7-af77-4d2c9367ece9"],
 " is a splitting ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["V", "TI"], "\[LongEqual]", 
    StyleBox["H", "TI"], "\[CirclePlus]", 
    StyleBox["im",
     FontSlant->"Plain"], " ", 
    StyleBox["d",
     FontSlant->"Plain"], "\[CirclePlus]", 
    StyleBox["C", "TI"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b6ea6e9e-06b9-4a76-bc44-249685de32fe"],
 " with ",
 Cell[BoxData[
  FormBox[
   StyleBox["H", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d121e794-e239-481e-ae1e-5566c7f0742c"],
 " a complement of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["im",
     FontSlant->"Plain"], " ", 
    StyleBox["d",
     FontSlant->"Plain"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "902a3962-3ef1-4ceb-86a9-210d97aff0df"],
 " in ",
 Cell[BoxData[
  FormBox[
   RowBox[{"ker", 
    StyleBox["d",
     FontSlant->"Plain"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "121751ad-d8bc-4dc0-a30d-5fa759278fd3"],
 ", ",
 Cell[BoxData[
  FormBox[
   StyleBox["C", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3819c556-eadb-4810-b5b5-0786479aaad6"],
 " a complement of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"ker", 
    StyleBox["d",
     FontSlant->"Plain"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "54f19add-016f-4159-b0c7-b3f97b40b561"],
 " in ",
 Cell[BoxData[
  FormBox[
   StyleBox["V", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3996f8b9-60cb-42ce-97ae-4a5415081968"],
 ", and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["C", "TI"], "\[Perpendicular]", 
    StyleBox["C", "TI"], "\[CirclePlus]", 
    StyleBox["H", "TI"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "34e210e0-30a7-479b-a03f-7f74039ca34d"],
 ". A model admitting one is ",
 StyleBox["of Hodge type", "TI"],
 "."
}], "Notes",ExpressionUUID->"2bbf741c-f61a-431e-b884-36750a513ea8"],

Cell[TextData[{
 "The test is not a search for a decomposition. Over a field of \
characteristic ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[NotEqual]", "2"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "026849c2-a054-4d20-8e9b-d6c35b8102bc"],
 ", and for a nondegenerate quotient of finite type, being of Hodge type is \
equivalent to the degenerate subspace being acyclic \[LongDash] equivalently, \
to the quotient map ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Pi]", 
     StyleBox["Q", "TI"]], ":", 
    StyleBox["V", "TI"], "\[Rule]", 
    StyleBox["Q", "TI"], 
    RowBox[{"(", 
     StyleBox["V", "TI"], ")"}]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1a558247-5dec-497e-8be2-46872c3a2372"],
 " being a quasi-isomorphism. So what is computed is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["H", "TI"], 
     StyleBox["k", "TI"]], "(", 
    SubscriptBox[
     StyleBox["V", "TI"], 
     StyleBox["deg",
      FontSlant->"Plain"]], ")"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "68f4d957-0519-4750-8c20-d09752904160"],
 ", degree by degree."
}], "Notes",ExpressionUUID->"4a972dbf-2309-48b6-8d03-fb30d110d171"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "b3952067-e6da-4f68-943c-68be1bd803d3"], Cell["option", "TableText",
     FontWeight->Bold,ExpressionUUID->"862dcb9d-b2cf-4fd5-b807-9634dc75c4d5"],
     Cell["default", "TableText",
     FontWeight->Bold,ExpressionUUID->"338a57a7-b1be-48fc-93ac-bc455007fe69"],
     Cell["", "TableText",
     FontWeight->Bold,ExpressionUUID->"7cda4004-687e-48c1-aa1f-0fb932f6b98f"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "54440575-ff25-483f-aef1-885f46e070ba"], Cell[TextData[Cell[
    BoxData["\"\<MaxDegree\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "50438559-89fa-4588-814e-669a9079cbe7"]], "TableText",ExpressionUUID->
     "11b39585-e6f6-4855-ade3-423d54805a4f"], Cell[TextData[Cell[BoxData[
     TemplateBox[{
       Cell[
        TextData["Automatic"]], "paclet:ref/Automatic"},
      "RefLink",
      BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
     "8de3a1ab-4f95-432b-b1f5-41b7902329f8"]], "TableText",ExpressionUUID->
     "5b60b3d5-9c3d-4a16-b0b9-7cf5171db324"], Cell[TextData[{
     "the last degree tested; ",
     Cell[BoxData["Automatic"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "c67e714b-e505-4e0d-beb5-f4e9fc8bb3c5"],
     " is ",
     Cell[BoxData[
      FormBox[
       RowBox[{
        StyleBox["n", "TI"], "+", "1"}], TraditionalForm]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "1f818670-f29e-4c7e-b762-c2c68685bd3c"]
    }], "TableText",ExpressionUUID->"572fddff-3c48-4d33-9c30-903112117ddb"]}
  }]], "3ColumnTableMod",ExpressionUUID->"f1992b38-5ff3-496b-acf0-\
fa785e2294aa"],

Cell[TextData[{
 "The default range is complete, not a truncation, provided the cohomology of \
the model vanishes above degree ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "76c30038-7de2-486c-bd50-32c030f049a8"],
 " \[LongDash] which is part of being a PDGA of degree ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "453ed683-46b9-4023-8f1f-f8438cc2b402"],
 ". Above degree ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "08eab0c4-6213-4102-b148-6dfb543eb2fa"],
 " the degenerate subspace is the whole of the model, so for ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["k", "TI"], "\[GreaterEqual]", 
    StyleBox["n", "TI"], "+", "2"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "df6fdb6d-213d-46cd-8025-f7c0b1313e7b"],
 " both ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["V", "TI"], 
    StyleBox["deg",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["k", "TI"], "-", "1"}]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d7701c1c-1d4e-4978-8b6a-8a40a59e264b"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["V", "TI"], 
    StyleBox["deg",
     FontSlant->"Plain"], 
    StyleBox["k", "TI"]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6e637cb8-26e9-49fa-af4c-488ae0bcb401"],
 " are everything and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["H", "TI"], 
     StyleBox["k", "TI"]], 
    RowBox[{"(", 
     SubscriptBox[
      StyleBox["V", "TI"], 
      StyleBox["deg",
       FontSlant->"Plain"]], ")"}], "\[LongEqual]", 
    SuperscriptBox[
     StyleBox["H", "TI"], 
     StyleBox["k", "TI"]], 
    RowBox[{"(", 
     StyleBox["V", "TI"], ")"}], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "24b2d4e5-484b-49c9-84e0-99bc364268af"],
 ". Degree ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["n", "TI"], "+", "1"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5e1b55af-55cd-4f67-8bbf-eb3158df81f1"],
 " is the one degree above ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8f780f97-851f-4a3c-86d8-9032fab3d518"],
 " where the two can differ, and it is tested."
}], "Notes",ExpressionUUID->"283d68a8-a8f4-4f2c-9731-7d7fb6791bc1"]
}, Open  ]],

