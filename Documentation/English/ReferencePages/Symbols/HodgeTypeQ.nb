Cell[TextData[{
 "A Hodge decomposition of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     StyleBox["V", "TI"], ",", 
     StyleBox["d",
      FontSlant->"Plain"], ",", 
     RowBox[{"\[LeftAngleBracket]", 
      RowBox[{"-", ",", "-"}], "\[RightAngleBracket]"}]}], ")"}], 
   TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c3e86952-2db1-414d-a2a9-f65394a88d02"],
 " is a splitting ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["V", "TI"], "\[LongEqual]", 
    StyleBox["H", "TI"], "\[CirclePlus]", 
    StyleBox["im",
     FontSlant->"Plain"], " ", 
    StyleBox["d",
     FontSlant->"Plain"], "\[CirclePlus]", 
    StyleBox["C", "TI"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7c704e84-77f1-4772-9f35-0d0929b796f4"],
 " with ",
 Cell[BoxData[
  FormBox[
   StyleBox["H", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "070dcc19-ea94-44a1-b3eb-18ad9f7731e4"],
 " a complement of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["im",
     FontSlant->"Plain"], " ", 
    StyleBox["d",
     FontSlant->"Plain"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b6ce9472-032b-40be-a03b-27e9b516b477"],
 " in ",
 Cell[BoxData[
  FormBox[
   RowBox[{"ker", 
    StyleBox["d",
     FontSlant->"Plain"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a4e1b717-42af-46cf-8c44-f709b112f7a4"],
 ", ",
 Cell[BoxData[
  FormBox[
   StyleBox["C", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ff706d56-55db-40ac-88b3-0d35d64a7f19"],
 " a complement of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"ker", 
    StyleBox["d",
     FontSlant->"Plain"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a053be50-766b-4f0e-bfa6-5b8a302b3e14"],
 " in ",
 Cell[BoxData[
  FormBox[
   StyleBox["V", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4ec569dd-2db8-4f7a-abcb-6ef88ff6a5ab"],
 ", and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["C", "TI"], "\[Perpendicular]", 
    StyleBox["C", "TI"], "\[CirclePlus]", 
    StyleBox["H", "TI"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "407b7a8b-0e7c-41e2-8486-0343e32fbdfa"],
 ". A space admitting one is of Hodge type."
}], "Notes",
 CellFrameLabels->{{Inherited, Inherited}, {Inherited, 
    Cell[
     TextData[{
      "26.09.30: Design review - HodgeTypeQ is a test on the space, not a \
search: it computes the cohomology of the degenerate subspace degree by \
degree, by the criterion of Lemma 3.14 of arXiv:2004.07362, which needs no \
choice of harmonic subspace and no linear system for a twist; \
FindHodgeDecomposition is the search. The criterion assumes that the pairing \
on cohomology is perfect, and without it a degenerate cohomology pairing \
gives a false negative, so since HodgeDecompositions H2 the function first \
asks PoincareDualityQ with the same \"MaxDegree\", and when the answer is \
False it issues the one message HodgeTypeQ::duality and returns unevaluated, \
the rule of the paclet for a predicate that cannot decide. Example 4.3 of \
arXiv:2609.14221 received False for the wrong reason before H2. For a model \
the default range 0 to n+1 is complete once the model is a PDGA of degree n, \
so the option exists only to look further, and since R7 (Pavel, 2026-10-01) a \
value below n returns unevaluated, as in PoincareDualityQ, where it used to \
test fewer degrees and could miss a failure; T17 checks that the verdict does \
not change out to degree 4n+8 on the catalogue. A complex is finite, so every \
degree is tested and that form takes no option. Prior art: the Wolfram \
Language has no test for Hodge type. The engine of the verification suites \
has the same test, and T17 pins the function against it on the thirteen \
catalogue models and the Kodaira-Thurston model.", "\n\n", 
       Cell[
        BoxData[
         GridBox[{{
            Cell[
             BoxData[
              ButtonBox[
               DynamicBox[
                FEPrivate`FrontEndResource[
                "DocumentationToolsStrings", "Edit"]], BaseStyle -> 
               "TextAnnotationButton"]]], 
            StyleBox[
             RowBox[{
               DynamicBox[
                FEPrivate`FrontEndResource[
                "DocumentationToolsStrings", "LastAnnotator"]], "pavel"}], 
             "TextAnnotator"], 
            Cell[
             BoxData[
              ButtonBox[
               DynamicBox[
                FEPrivate`FrontEndResource[
                "DocumentationToolsStrings", "Delete"]], BaseStyle -> 
               "TextAnnotationRemoveButton"]]], ""}}, 
          GridBoxAlignment -> {
           "Columns" -> {Left, Left, Right, Right}, "Rows" -> {{Automatic}}}, 
          GridBoxItemSize -> {"Columns" -> {
              Scaled[0.15], 
              Scaled[0.68], 
              Scaled[0.15], 
              Scaled[0.02]}}]]], "\n"}], "TextAnnotation", 
     CellSize -> {590, Inherited}]}},
 CellTags->"TextAnnotation",
 CellID->929586826,ExpressionUUID->"2ab67657-d01b-4506-a178-9fd4ea8a3647"],

Cell[TextData[{
 "The test is not a search for a decomposition; ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindHodgeDecomposition"]], 
    "paclet:ChernSimons/ref/FindHodgeDecomposition", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "b343a8f7-7398-4921-a3a8-dd0b97ce1ce0"],
 " finds one."
}], "Notes",ExpressionUUID->"1101e518-e2a0-4e32-a822-e83767f81cf2"],

Cell[TextData[{
 "Over a field of characteristic ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[NotEqual]", "2"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dc6eb74b-d1d2-480a-95a9-c18990eea547"],
 ", and for a nondegenerate quotient of finite type, being of Hodge type is \
equivalent to the degenerate subspace being acyclic, and to the quotient map ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Pi]", 
     StyleBox["Q", "TI"]], ":", 
    StyleBox["V", "TI"], "\[Rule]", 
    StyleBox["Q", "TI"], 
    RowBox[{"(", 
     StyleBox["V", "TI"], ")"}]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4ebeabd2-b2dc-44b2-a465-dae7c73a950c"],
 " being a quasi-isomorphism."
}], "Notes",ExpressionUUID->"7b34b77b-e093-4504-bc01-5c0d26945e0f"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["HodgeTypeQ"]], "paclet:ChernSimons/ref/HodgeTypeQ", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "baf4101f-4f14-4aa8-b604-a6fde151787b"],
 " computes ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["H", "TI"], 
     StyleBox["k", "TI"]], "(", 
    SubscriptBox[
     StyleBox["V", "TI"], 
     StyleBox["deg",
      FontSlant->"Plain"]], ")"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b1c98a0a-6b3f-44fc-b264-16caed743dc5"],
 " degree by degree and gives True when it vanishes in every degree tested."
}], "Notes",ExpressionUUID->"a7cef2c5-6b3b-4df6-a024-39b197d82923"],

Cell[TextData[{
 "The equivalence needs Poincar\[EAcute] duality on cohomology. When ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["PoincareDualityQ"]], "paclet:ChernSimons/ref/PoincareDualityQ",
     "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "90236320-601a-4185-84f6-885a52cfad0d"],
 " is False, the message ",
 Cell[BoxData[
  RowBox[{"HodgeTypeQ", "::", "duality"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f68ac0ac-be8f-4967-931b-7f3d716d8503"],
 " is issued and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["HodgeTypeQ"]], "paclet:ChernSimons/ref/HodgeTypeQ", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "610a6a09-b14f-412c-8acc-86fa62d1b50e"],
 " returns unevaluated."
}], "Notes",ExpressionUUID->"c5ce9647-2eda-4770-8eba-d9ac1ecb2825"],

Cell[TextData[{
 "For a model the degrees ",
 Cell[BoxData[
  FormBox["0", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ab34f6ee-be03-4dee-a19e-48b066281594"],
 " to ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["n", "TI"], "+", "1"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "76c40527-4cac-4e04-8625-96b1713939b6"],
 " are tested by default. The range is complete provided the cohomology of \
the model vanishes above degree ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9076f5d2-803a-4167-b38a-e82628338c6c"],
 ", which is part of being a PDGA of degree ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ce60e91f-9133-4264-894c-96e29c74dee1"],
 "."
}], "Notes",ExpressionUUID->"e622d780-7969-442b-8d02-bd90e3583f6c"],

Cell[TextData[{
 "Above degree ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "716dbb6e-fe30-40ad-9df9-4617dd3b838d"],
 " the degenerate subspace is the whole of the model, so for ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["k", "TI"], "\[GreaterEqual]", 
    StyleBox["n", "TI"], "+", "2"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1af05df6-de40-4ba0-b90e-27d9d4c98f3f"],
 " both ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["V", "TI"], 
    StyleBox["deg",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["k", "TI"], "-", "1"}]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bf81fe3e-651b-4d4c-a0ba-2ef68b074147"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["V", "TI"], 
    StyleBox["deg",
     FontSlant->"Plain"], 
    StyleBox["k", "TI"]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4a08a8b8-1c40-4279-b5b6-89561e0724a3"],
 " are everything and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["H", "TI"], 
     StyleBox["k", "TI"]], 
    RowBox[{"(", 
     SubscriptBox[
      StyleBox["V", "TI"], 
      StyleBox["deg",
       FontSlant->"Plain"]], ")"}], "\[LongEqual]", 
    SuperscriptBox[
     StyleBox["H", "TI"], 
     StyleBox["k", "TI"]], 
    RowBox[{"(", 
     StyleBox["V", "TI"], ")"}], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cb914e3c-c884-4050-b21b-98d842512b49"],
 ". Degree ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["n", "TI"], "+", "1"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d13b270b-d6b8-455f-bbf9-24a625989354"],
 " is the one degree above ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "da048cd3-f6e4-455d-b927-34bc7590a253"],
 " where the two can differ, and it is tested."
}], "Notes",ExpressionUUID->"e4a468fb-97b0-44b4-b1d7-d711ac83f1e8"],

