Cell[TextData[{
 "When the test fails, the quotient map has lost cohomology and the quotient \
is no longer a model of the algebra it came from. For the degree-",
 Cell[BoxData[
  FormBox["4", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a8502629-2a2c-4bbf-bbb5-cd668f3ab20e"],
 " obstruction the quotient is three-dimensional where the cohomology is \
two-dimensional:"
}], "ExampleText",ExpressionUUID->"e91f8196-b73e-401d-93c7-fdebe2e511e6"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"model", " ", "=", " ", 
   RowBox[{"SullivanModel", "[", "\"\<Degree4Obstruction\>\"", "]"}]}], 
  ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Total", "[", 
    RowBox[{"Values", "[", 
     RowBox[{
      RowBox[{"HodgeTypeReport", "[", "model", "]"}], "[", 
      RowBox[{"All", ",", " ", "\"\<Cohomology\>\""}], "]"}], "]"}], "]"}], ",",
    "\n", " ", 
   RowBox[{"Length", "[", 
    RowBox[{
     RowBox[{"NondegenerateQuotient", "[", "model", "]"}], 
     "[", "\"\<Basis\>\"", "]"}], "]"}]}], "}"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"ab8a619f-ed16-4b2e-b47b-4e061f60e36b"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"2", ",", "3"}], "}"}]], "Output",
