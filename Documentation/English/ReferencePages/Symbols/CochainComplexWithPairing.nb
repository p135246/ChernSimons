Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"algebra", " ", "=", " ", 
  RowBox[{"CochainComplexWithPairing", "[", 
   RowBox[{
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"1", " ", "->", " ", "0"}], ",", " ", 
      RowBox[{"a", " ", "->", " ", "1"}], ",", " ", 
      RowBox[{"b", " ", "->", " ", "1"}], ",", " ", 
      RowBox[{"alpha", " ", "->", " ", "2"}], ",", " ", 
      RowBox[{"beta", " ", "->", " ", "2"}], ",", " ", 
      RowBox[{"w", " ", "->", " ", "3"}]}], "|>"}], ",", " ", 
    RowBox[{"<|", "|>"}], ",", "\n", "   ", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"a", ",", " ", "alpha"}], "}"}], " ", "->", " ", "w"}], ",", 
      " ", 
