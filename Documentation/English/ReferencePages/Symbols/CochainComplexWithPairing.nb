Cell[TextData[{
 "The basis elements are monomials: ",
 Cell[BoxData[
  FormBox["1", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "ae9c10a7-72a4-45a5-938e-5a6301f9ea36"],
 ", symbols, and products of powers of symbols. An element is a linear \
combination of them."
}], "Notes",ExpressionUUID->"c37dabc6-2061-40c5-98b7-53530c3a2f79"],

Cell[TextData[{
 "A product such as ",
 Cell[BoxData[
  RowBox[{"a", " ", "b"}]], "InlineFormula",ExpressionUUID->
  "adc39fe3-fa6e-49cc-95b7-2467efc8f34e"],
 " is the name of one basis element, and its product with other elements is \
whatever ",
 StyleBox["product", "TI"],
 " says."
}], "Notes",ExpressionUUID->"48bb2e5d-8af0-45d3-877c-f0410ffb6460"],

Cell[TextData[{
 "The pairing has degree ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "d337429c-dc3b-4cf2-9f22-2527c5880454"],
 ": ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{
      SuperscriptBox[
       StyleBox["V", "TI"], 
       StyleBox["i", "TI"]], ",", 
      SuperscriptBox[
       StyleBox["V", "TI"], 
       StyleBox["j", "TI"]]}], "\[RightAngleBracket]"}], "\[LongEqual]", 
    "0"}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "8557e874-37f3-42f1-9f43-48afff090925"],
 " unless ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["i", "TI"], "+", 
    StyleBox["j", "TI"], "\[LongEqual]", 
    StyleBox["n", "TI"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "a33121a8-9b7f-4e01-b4da-020ed1308701"],
 "."
}], "Notes",ExpressionUUID->"767fc099-25d7-4027-b338-5901282c662e"],

Cell[TextData[{
 "The pairing is graded symmetric, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{
      StyleBox["y", "TI"], ",", 
      StyleBox["x", "TI"]}], "\[RightAngleBracket]"}], "\[LongEqual]", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"-", "1"}], ")"}], 
     TemplateBox[{
       RowBox[{
         StyleBox["x", "TI"], "||", 
         StyleBox["y", "TI"]}]},
      "Abs"]], 
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{
      StyleBox["x", "TI"], ",", 
      StyleBox["y", "TI"]}], "\[RightAngleBracket]"}]}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"760b4d5b-ed0a-4572-9bc6-ecbdcb7f7c2d"],
 ", and compatible with the differential, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{
      StyleBox["d",
       FontSlant->"Plain"], 
      StyleBox["x", "TI"], ",", 
      StyleBox["y", "TI"]}], "\[RightAngleBracket]"}], "\[LongEqual]", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"-", "1"}], ")"}], 
     RowBox[{"|", 
      StyleBox["x", "TI"], "|", "+", "1"}]], 
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{
      StyleBox["x", "TI"], ",", 
      StyleBox["d",
       FontSlant->"Plain"], 
      StyleBox["y", "TI"]}], "\[RightAngleBracket]"}]}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"891817f7-9a46-48e6-b348-93806b9c7978"],
 "."
}], "Notes",ExpressionUUID->"caef8970-e1fc-43b4-9cb5-68b2aaa1802b"],

Cell[TextData[{
 StyleBox["pairing", "TI"],
 " needs each pair in one order only; the other order follows from graded \
symmetry."
}], "Notes",ExpressionUUID->"5c1ed602-2f8e-47cc-8cd5-fe2f68d0f63b"],

Cell[TextData[{
 StyleBox["product", "TI"],
 " likewise needs each pair in one order, and the other follows from graded \
commutativity. When ",
 Cell[BoxData[
  FormBox["1", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "3cce7f3f-3f44-4e67-ad9d-4bc390fbb934"],
 " is a basis element it is the unit."
}], "Notes",ExpressionUUID->"13c2d285-5e9b-42e9-b73e-6a36a9eaf04b"],

Cell[TextData[{
 StyleBox["orientation", "TI"],
 " is a basis element of degree ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "fe89fac3-0193-46a7-96ea-c497c7f76f79"],
 ", meaning the value ",
 Cell[BoxData[
  FormBox["1", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "e31a5bb9-b66d-4955-b472-f57d51fd4ff0"],
 " on it, or an Association of values on the basis of degree ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "83561571-0ccc-4873-8504-866c7126c9af"],
 "."
}], "Notes",ExpressionUUID->"573a9dbd-f8a3-45a1-87a7-fe029aaf3f05"],

Cell[TextData[{
 "The result is a ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Failure"]], "paclet:ref/Failure"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "a6970b2f-37f1-4cda-b335-1da4d2dea7f9"],
 " when the data do not satisfy the axioms, and when the values do not define \
an orientation."
}], "Notes",ExpressionUUID->"6ae1d36e-0334-4c0a-89cd-18bea23a1986"],

Cell[TextData[{
 "The axioms are the relations of the complex: ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Relations"]], "paclet:ChernSimons/ref/Relations", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "fce3ea22-6f84-4c45-a23b-1a9a1c9617a5"],
 " names them, ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Obstruction"]], "paclet:ChernSimons/ref/Obstruction", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "b565c795-f97a-43fd-ad85-f9c56b2cf0d2"],
 " gives each one on elements, and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RelationsQ"]], "paclet:ChernSimons/ref/RelationsQ", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "d57eea8d-2234-4f2d-8038-a10c4593c9f3"],
 " tests them all."
}], "Notes",ExpressionUUID->"ca3cd858-2ff1-45b9-b4f0-c0752d26f707"],

Cell[TextData[{
 "A Sullivan model is infinite-dimensional, but its Poincar\[EAcute] duality \
and its Hodge type are decided in degrees ",
 Cell[BoxData[
  FormBox["0", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "2ba09dee-f8cc-4f6c-a13f-c3e4c683c1c5"],
 " to ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["n", "TI"], "+", "1"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"f829dfc8-d529-431b-8822-9f842f007f95"],
 "."
}], "Notes",ExpressionUUID->"d2acf244-065c-4a82-b7e2-8065b56ebf10"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["CochainComplexWithPairing"]], 
     "paclet:ChernSimons/ref/CochainComplexWithPairing", 
     "ChernSimons Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["model", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "ea256ebd-cf10-4731-869a-e8753f90cb01"],
 " divides out everything above degree ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["n", "TI"], "+", "2"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"72f5f9bf-5b78-4836-b302-4c26750043ad"],
 " and the monomials of degree ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["n", "TI"], "+", "2"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"736ed7ef-8f66-428c-8748-115c08f2f784"],
 " that the image of the differential does not need. The quotient is a \
differential graded algebra, agrees with the model up to degree ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["n", "TI"], "+", "1"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"4667f750-22bf-416d-92e9-ffc2502c90fd"],
 " and has no cohomology above."
}], "Notes",ExpressionUUID->"49693887-e1a5-463e-a8f5-fe5f3f35b9c3"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["CochainComplexWithPairing"]], 
     "paclet:ChernSimons/ref/CochainComplexWithPairing", 
     "ChernSimons Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["algebra", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "5f84f06f-07fe-4f97-92ec-e2e4d34b0963"],
 " keeps the basis of the algebra, reads the differential off its matrix and \
the product off its triple products."
}], "Notes",ExpressionUUID->"30d5202b-163d-4645-a687-e36c3a475660"]
}, Open  ]],

