 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["k", "TI"], "\[LongEqual]", "3"}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0e2327f8-78ee-4e2c-9e5c-635c85b15579"],
 " in Example 6.1, ",
