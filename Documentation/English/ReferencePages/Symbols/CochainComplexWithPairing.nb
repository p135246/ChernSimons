  FormBox[
   StyleBox["b", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "15b8b133-7634-40bc-8f76-be47264d2511"],
 " has odd degree and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{
      StyleBox["b", "TI"], ",", 
      StyleBox["b", "TI"]}], "\[RightAngleBracket]"}], "\[LongEqual]", "1"}], 
   TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a491ab03-b2b2-4309-82c3-7a0482b07481"],
 " is impossible, so the result is a ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Failure"]], "paclet:ref/Failure"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "7f66aa75-d29c-44f6-ab77-fb373e2be154"],
 ", whose message says so:"
}], "ExampleText",ExpressionUUID->"c24dc378-bdef-43c5-9e23-733197929650"],

