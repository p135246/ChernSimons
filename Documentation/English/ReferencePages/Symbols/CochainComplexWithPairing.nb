Cell[TextData[{
 "The basis elements are monomials: ",
 Cell[BoxData[
  FormBox["1", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "2791f5d5-cb52-48e8-8621-311421b199aa"],
 ", symbols, and products of powers of symbols. An element is a linear \
combination of them."
}], "Notes",ExpressionUUID->"75b9deeb-e76b-4436-9b64-e91318b50b80"],

Cell[TextData[{
 "A product such as ",
 Cell[BoxData[
  RowBox[{"a", " ", "b"}]], "InlineFormula",ExpressionUUID->
  "a208b427-66f5-4e7a-a317-bbf7c4ec7ddb"],
 " is the name of one basis element, and its product with other elements is \
whatever ",
 StyleBox["product", "TI"],
 " says."
}], "Notes",ExpressionUUID->"7af19d66-ee62-4da0-b6f0-4f19452663d6"],

Cell[TextData[{
 "The pairing has degree ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "f14aacc9-d3ac-4a06-8129-c4e03fa12058"],
 ": ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{
      SuperscriptBox[
       StyleBox["V", "TI"], 
       StyleBox["i", "TI"]], ",", 
      SuperscriptBox[
       StyleBox["V", "TI"], 
       StyleBox["j", "TI"]]}], "\[RightAngleBracket]"}], "\[LongEqual]", 
    "0"}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "4fe3fedb-2a29-4a3e-b6ae-35812c44ebe2"],
 " unless ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["i", "TI"], "+", 
    StyleBox["j", "TI"], "\[LongEqual]", 
    StyleBox["n", "TI"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "718e01a6-1a35-4086-baf3-12b2855dd79b"],
 "."
}], "Notes",ExpressionUUID->"7ce5160b-6e59-44be-8fad-3d1ec9e0126d"],

Cell[TextData[{
 "The pairing is graded symmetric, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{
      StyleBox["y", "TI"], ",", 
      StyleBox["x", "TI"]}], "\[RightAngleBracket]"}], "\[LongEqual]", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"-", "1"}], ")"}], 
     TemplateBox[{
       RowBox[{
         StyleBox["x", "TI"], "||", 
         StyleBox["y", "TI"]}]},
      "Abs"]], 
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{
      StyleBox["x", "TI"], ",", 
      StyleBox["y", "TI"]}], "\[RightAngleBracket]"}]}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"f6dca6ec-5500-4f7d-ba30-27fdf8de2eab"],
 ", and compatible with the differential, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{
      StyleBox["d",
       FontSlant->"Plain"], 
      StyleBox["x", "TI"], ",", 
      StyleBox["y", "TI"]}], "\[RightAngleBracket]"}], "\[LongEqual]", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"-", "1"}], ")"}], 
     RowBox[{"|", 
      StyleBox["x", "TI"], "|", "+", "1"}]], 
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{
      StyleBox["x", "TI"], ",", 
      StyleBox["d",
       FontSlant->"Plain"], 
      StyleBox["y", "TI"]}], "\[RightAngleBracket]"}]}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"b6fa6cf5-ec22-4a40-926a-25145f25d45b"],
 "."
}], "Notes",ExpressionUUID->"5748a230-e95e-4d25-9481-888295fb9e01"],

Cell[TextData[{
 StyleBox["pairing", "TI"],
 " needs each pair in one order only; the other order follows from graded \
symmetry."
}], "Notes",ExpressionUUID->"e8c41355-3a9b-4836-9b39-44e5c9798d0b"],

Cell[TextData[{
 StyleBox["product", "TI"],
 " likewise needs each pair in one order, and the other follows from graded \
commutativity. When ",
 Cell[BoxData[
  FormBox["1", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "c0a3e730-8f04-4cd8-a467-3495d369d342"],
 " is a basis element it is the unit."
}], "Notes",ExpressionUUID->"80329cd0-4932-4ce1-a35e-97a8b82a7cfb"],

Cell[TextData[{
 StyleBox["orientation", "TI"],
 " is a basis element of degree ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "23829c9e-a6ca-4ad3-96da-90c6f87a71b4"],
 ", meaning the value ",
 Cell[BoxData[
  FormBox["1", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "3280feae-1589-43fd-b08e-74e75c614a36"],
 " on it, or an Association of values on the basis of degree ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "8f9ab565-4196-488e-9cc5-77f4e5ef61bf"],
 "."
}], "Notes",ExpressionUUID->"22e05866-e1c3-48f5-b69d-b9807343c829"],

Cell[TextData[{
 "The result is a ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Failure"]], "paclet:ref/Failure"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "9880585b-c2e5-4cb8-88e1-f0f4713b269e"],
 " when the data do not satisfy the axioms, and when the values do not define \
an orientation."
}], "Notes",ExpressionUUID->"5ed72285-a491-4f13-a3ca-f77aab061de6"],

Cell[TextData[{
 "The axioms are the relations of the complex: ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Relations"]], "paclet:ChernSimons/ref/Relations", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "f9fc24b8-6ddb-4e31-ab26-0f687fc73c54"],
 " names them, ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Obstruction"]], "paclet:ChernSimons/ref/Obstruction", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "cafad457-adeb-4097-b6b5-62f3ffbd5768"],
 " gives each one on elements, and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RelationsQ"]], "paclet:ChernSimons/ref/RelationsQ", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "a6dff2b9-34fc-4cb6-a8e0-25d27e9d643e"],
 " tests them all."
}], "Notes",ExpressionUUID->"4e0e3367-4b39-49b1-b58a-200cc722a20e"],

Cell[TextData[{
 "A Sullivan model is infinite-dimensional, but its Poincar\[EAcute] duality \
and its Hodge type are decided in degrees ",
 Cell[BoxData[
  FormBox["0", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "da31f3df-16a7-4c41-8498-f911c5b14ebe"],
 " to ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["n", "TI"], "+", "1"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"cc6b94f7-8323-4141-9cfa-6fdfc6710f16"],
 "."
}], "Notes",ExpressionUUID->"6dc8bcc3-2aab-41e6-a5fd-96cba663c598"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["CochainComplexWithPairing"]], 
     "paclet:ChernSimons/ref/CochainComplexWithPairing", 
     "ChernSimons Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["model", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "60f383d7-061d-4e41-b110-aa23ebbbb6ab"],
 " divides out everything above degree ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["n", "TI"], "+", "2"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"44936455-75c8-4523-bd30-b6c769440c3d"],
 " and the monomials of degree ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["n", "TI"], "+", "2"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"989cdb1c-2877-4c99-ba64-d1eafbe89242"],
 " that the image of the differential does not need. The quotient is a \
differential graded algebra, agrees with the model up to degree ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["n", "TI"], "+", "1"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"b2f3d05c-45dc-43b4-8dfb-99dfe466ec78"],
 " and has no cohomology above."
}], "Notes",ExpressionUUID->"70864e2a-fac2-4132-a5e1-8c349b240b17"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["CochainComplexWithPairing"]], 
     "paclet:ChernSimons/ref/CochainComplexWithPairing", 
     "ChernSimons Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["algebra", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "395911c6-eeab-4865-b545-80aa508c3302"],
 " keeps the basis of the algebra, reads the differential off its matrix and \
the product off its triple products."
}], "Notes",ExpressionUUID->"ac5b746a-07af-411f-b69d-ca867a6def76"]
}, Open  ]],

