  RowBox[{"CochainComplexWithPairing", "[", "\n", "   ", 
   RowBox[{
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"1", " ", "->", " ", "0"}], ",", " ", 
      RowBox[{"a", " ", "->", " ", "1"}], ",", " ", 
      RowBox[{"b", " ", "->", " ", "1"}], ",", " ", 
      RowBox[{"c", " ", "->", " ", "1"}], ",", " ", 
      RowBox[{
       RowBox[{"a", " ", "b"}], " ", "->", " ", "2"}], ",", " ", 
      RowBox[{"eta", " ", "->", " ", "2"}], ",", " ", 
      RowBox[{"alpha", " ", "->", " ", "3"}], ",", " ", 
      RowBox[{"beta", " ", "->", " ", "3"}], ",", " ", 
      RowBox[{"gamma", " ", "->", " ", "3"}], ",", " ", 
      RowBox[{"w", " ", "->", " ", "4"}]}], "|>"}], ",", "\n", "   ", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"c", " ", "->", " ", 
       RowBox[{"a", " ", "b"}]}], ",", " ", 
      RowBox[{"eta", " ", "->", " ", "gamma"}]}], "|>"}], ",", "\n", "   ", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"a", ",", " ", "b"}], "}"}], " ", "->", " ", 
       RowBox[{"a", " ", "b"}]}], ",", " ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"a", ",", " ", "alpha"}], "}"}], " ", "->", " ", "w"}], ",", 
      " ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"b", ",", " ", "beta"}], "}"}], " ", "->", " ", "w"}], ",", 
      " ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"c", ",", " ", "gamma"}], "}"}], " ", "->", " ", "w"}], ",", 
      " ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"a", " ", "b"}], ",", " ", "eta"}], "}"}], " ", "->", " ", 
       "w"}], ",", "\n", "     ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"a", ",", " ", "eta"}], "}"}], " ", "->", " ", 
       RowBox[{"-", "beta"}]}], ",", " ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"b", ",", " ", "eta"}], "}"}], " ", "->", " ", "alpha"}]}], 
     "|>"}], ",", " ", "w"}], "]"}]}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"3bc67157-5f43-4704-a83c-c7b9444e9044"],

