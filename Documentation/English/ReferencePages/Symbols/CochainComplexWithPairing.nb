      RowBox[{"beta", " ", "->", " ", "2"}], ",", " ", 
      RowBox[{"w", " ", "->", " ", "3"}]}], "|>"}], ",", " ", 
    RowBox[{"<|", "|>"}], ",", "\n", "   ", 
