Cell[TextData[{
 "The basis elements are monomials: ",
 Cell[BoxData[
  FormBox["1", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d9e22f43-6c5c-4111-b48d-1c1dc532322d"],
 ", symbols, and products of powers of symbols. An element is a linear \
combination of them."
}], "Notes",ExpressionUUID->"b9f16b48-aaa8-4b85-9208-45263acf40bd"],

Cell[TextData[{
 "A product such as ",
 Cell[BoxData[
  RowBox[{"a", " ", "b"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cdd912e8-d6b0-4ae3-b004-ef05d55e1ae5"],
 " is the name of one basis element, and its product with other elements is \
whatever ",
 StyleBox["product", "TI"],
 " says."
}], "Notes",ExpressionUUID->"df9c1602-38b8-4b0b-868d-34824b0517eb"],

Cell[TextData[{
 "The pairing has degree ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "612f38af-2c5f-4b47-b0ea-121bf175dd30"],
 ": ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{
      SuperscriptBox[
       StyleBox["V", "TI"], 
       StyleBox["i", "TI"]], ",", 
      SuperscriptBox[
       StyleBox["V", "TI"], 
       StyleBox["j", "TI"]]}], "\[RightAngleBracket]"}], "\[LongEqual]", 
    "0"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a1d62944-f828-4322-81cc-66735f47201f"],
 " unless ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["i", "TI"], "+", 
    StyleBox["j", "TI"], "\[LongEqual]", 
    StyleBox["n", "TI"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c6bd6322-9222-4153-bcad-c5b80201a7f3"],
 "."
}], "Notes",ExpressionUUID->"95027232-dc02-4443-9642-84a7985f649a"],

Cell[TextData[{
 "The pairing is graded symmetric, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{
      StyleBox["y", "TI"], ",", 
      StyleBox["x", "TI"]}], "\[RightAngleBracket]"}], "\[LongEqual]", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"-", "1"}], ")"}], 
     TemplateBox[{
       RowBox[{
         StyleBox["x", "TI"], "||", 
         StyleBox["y", "TI"]}]},
      "Abs"]], 
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{
      StyleBox["x", "TI"], ",", 
      StyleBox["y", "TI"]}], "\[RightAngleBracket]"}]}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a47d6232-a5b8-4704-8df7-fa0772dcbcdd"],
 ", and compatible with the differential, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{
      StyleBox["d",
       FontSlant->"Plain"], 
      StyleBox["x", "TI"], ",", 
      StyleBox["y", "TI"]}], "\[RightAngleBracket]"}], "\[LongEqual]", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"-", "1"}], ")"}], 
     RowBox[{"|", 
      StyleBox["x", "TI"], "|", "+", "1"}]], 
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{
      StyleBox["x", "TI"], ",", 
      StyleBox["d",
       FontSlant->"Plain"], 
      StyleBox["y", "TI"]}], "\[RightAngleBracket]"}]}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d2b8a431-cf28-4754-8aef-5d0b6c7c7002"],
 "."
}], "Notes",ExpressionUUID->"dfaf71fc-e4f3-4eb1-bae8-77d58b359f78"],

Cell[TextData[{
 StyleBox["pairing", "TI"],
 " needs each pair in one order only; the other order follows from graded \
symmetry."
}], "Notes",ExpressionUUID->"fd25c952-94fe-414a-b7e2-c6cf504f6ba8"],

Cell[TextData[{
 StyleBox["product", "TI"],
 " likewise needs each pair in one order, and the other follows from graded \
commutativity. When ",
 Cell[BoxData[
  FormBox["1", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ac31655b-c574-48cf-b823-83193160fd12"],
 " is a basis element it is the unit."
}], "Notes",ExpressionUUID->"e2e7a88a-7cf0-439d-947d-b5ecf815b9e2"],

Cell[TextData[{
 StyleBox["orientation", "TI"],
 " is a basis element of degree ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "15eb0a07-175f-4ec7-958c-8ea8e95ff6d7"],
 ", meaning the value ",
 Cell[BoxData[
  FormBox["1", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0e3f4e87-0bcf-4de4-9520-a57526754426"],
 " on it, or an Association of values on the basis of degree ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1ff62ade-6821-498d-9406-f39097815f2a"],
 "."
}], "Notes",ExpressionUUID->"a28bb9b6-c4fd-4760-9a56-113b068f51d9"],

Cell[TextData[{
 "The result is a ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Failure"]], "paclet:ref/Failure"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "98dde07f-b82c-462c-a5bb-1331b85a99ce"],
 " when the data do not satisfy the axioms, and when the values do not define \
an orientation."
}], "Notes",ExpressionUUID->"34a4b43d-ff42-4a8e-a539-0fa0049ff06b"],

Cell[TextData[{
 "The axioms are the relations of the complex: ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Relations"]], "paclet:ChernSimons/ref/Relations", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "80b41720-570e-4fc5-ab15-f2242fee9d7b"],
 " names them, ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Obstruction"]], "paclet:ChernSimons/ref/Obstruction", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "ccaa17c5-5ae6-44f3-be39-729b96ff1152"],
 " gives each one on elements, and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RelationsQ"]], "paclet:ChernSimons/ref/RelationsQ", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "dbae0c18-89e3-458f-a16e-f35093a5bf4a"],
 " tests them all."
}], "Notes",ExpressionUUID->"ff627d7f-0c4a-4a53-b526-566701289748"],

Cell[TextData[{
 "A Sullivan model is infinite-dimensional, but its Poincar\[EAcute] duality \
and its Hodge type are decided in degrees ",
 Cell[BoxData[
  FormBox["0", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d2047eba-3f5e-40a8-b68b-592d257e8ce5"],
 " to ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["n", "TI"], "+", "1"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "40d9691c-8b66-46a9-9723-3da737514b08"],
 "."
}], "Notes",ExpressionUUID->"e48a559c-0fb8-48df-b736-232a697fa00a"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["CochainComplexWithPairing"]], 
     "paclet:ChernSimons/ref/CochainComplexWithPairing", 
     "ChernSimons Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["model", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b17af8e3-c892-4841-96eb-32d5087c4591"],
 " divides out everything above degree ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["n", "TI"], "+", "2"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9348fce9-f1b1-4bd5-aa87-84678caec494"],
 " and the monomials of degree ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["n", "TI"], "+", "2"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8841c4fe-0cf8-4041-8997-671a29e7a9d2"],
 " that the image of the differential does not need. The quotient is a \
differential graded algebra, agrees with the model up to degree ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["n", "TI"], "+", "1"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c734edde-a9e6-4beb-b754-8eddc94d82ae"],
 " and has no cohomology above."
}], "Notes",ExpressionUUID->"35ff41a1-4a4f-4f5a-8f93-764761fc87a5"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["CochainComplexWithPairing"]], 
     "paclet:ChernSimons/ref/CochainComplexWithPairing", 
     "ChernSimons Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["algebra", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "79278219-7f4f-4764-93bd-92bdaea9e831"],
 " keeps the basis of the algebra, reads the differential off its matrix and \
the product off its triple products."
}], "Notes",ExpressionUUID->"fc5e130c-1056-4a47-9cfa-b8ed429eaab7"]
}, Open  ]],

