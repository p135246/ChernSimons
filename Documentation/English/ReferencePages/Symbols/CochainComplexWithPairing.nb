  FormBox[
   RowBox[{
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{
      StyleBox["b", "TI"], ",", 
      StyleBox["b", "TI"]}], "\[RightAngleBracket]"}], "\[LongEqual]", "1"}], 
   TraditionalForm]], "InlineFormula",ExpressionUUID->
  "e383ef18-f487-4f4c-b88b-4d8c6846b032"],
