Cell[TextData[{
 "The basis elements are monomials: ",
 Cell[BoxData[
  FormBox["1", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ae67f29f-6a2f-4525-a229-f0b051d6a499"],
 ", symbols, and products of powers of symbols. An element is a linear \
combination of them."
}], "Notes",ExpressionUUID->"1c29e6e1-8b89-45fd-876d-44f7318f00d4"],

Cell[TextData[{
 "A product such as ",
 Cell[BoxData[
  RowBox[{"a", " ", "b"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b7130159-5fa7-4a3a-b601-3dd35a790d95"],
 " is the name of one basis element, and its product with other elements is \
whatever ",
 StyleBox["product", "TI"],
 " says."
}], "Notes",ExpressionUUID->"13895502-bc38-46af-9b83-e037fe46dc9b"],

Cell[TextData[{
 "The pairing has degree ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "44b4fdf4-be31-4176-a539-baf10e1ce087"],
 ": ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{
      SuperscriptBox[
       StyleBox["V", "TI"], 
       StyleBox["i", "TI"]], ",", 
      SuperscriptBox[
       StyleBox["V", "TI"], 
       StyleBox["j", "TI"]]}], "\[RightAngleBracket]"}], "\[LongEqual]", 
    "0"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3a877f81-7b76-4c34-9dad-b62207545a87"],
 " unless ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["i", "TI"], "+", 
    StyleBox["j", "TI"], "\[LongEqual]", 
    StyleBox["n", "TI"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a6b4eb21-76eb-427f-b0dc-2425b3ad945a"],
 "."
}], "Notes",ExpressionUUID->"abe47e1e-d9bf-4d59-b23c-e44b9f09bd7c"],

Cell[TextData[{
 "The pairing is graded symmetric, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{
      StyleBox["y", "TI"], ",", 
      StyleBox["x", "TI"]}], "\[RightAngleBracket]"}], "\[LongEqual]", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"-", "1"}], ")"}], 
     TemplateBox[{
       RowBox[{
         StyleBox["x", "TI"], "||", 
         StyleBox["y", "TI"]}]},
      "Abs"]], 
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{
      StyleBox["x", "TI"], ",", 
      StyleBox["y", "TI"]}], "\[RightAngleBracket]"}]}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bcfba5c8-7c3d-405f-b52e-3204a301078f"],
 ", and compatible with the differential, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{
      StyleBox["d",
       FontSlant->"Plain"], 
      StyleBox["x", "TI"], ",", 
      StyleBox["y", "TI"]}], "\[RightAngleBracket]"}], "\[LongEqual]", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"-", "1"}], ")"}], 
     RowBox[{"|", 
      StyleBox["x", "TI"], "|", "+", "1"}]], 
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{
      StyleBox["x", "TI"], ",", 
      StyleBox["d",
       FontSlant->"Plain"], 
      StyleBox["y", "TI"]}], "\[RightAngleBracket]"}]}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a4d12e1f-3304-4b3b-bd5a-bf58538ea870"],
 "."
}], "Notes",ExpressionUUID->"0644f883-f1b1-4b90-9f09-69ca8c483d9c"],

Cell[TextData[{
 StyleBox["pairing", "TI"],
 " needs each pair in one order only; the other order follows from graded \
symmetry."
}], "Notes",ExpressionUUID->"9ae91c8f-6f34-4ba0-a5cd-a23b4e6b9419"],

Cell[TextData[{
 StyleBox["product", "TI"],
 " likewise needs each pair in one order, and the other follows from graded \
commutativity. When ",
 Cell[BoxData[
  FormBox["1", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0ffddab3-94fb-4d8d-9bf5-20f1b4019b88"],
 " is a basis element it is the unit."
}], "Notes",ExpressionUUID->"a6fe3686-236b-4671-afce-db7910179202"],

Cell[TextData[{
 StyleBox["orientation", "TI"],
 " is a basis element of degree ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "219dac82-dc9a-44b6-9428-a499ea5c7f49"],
 ", meaning the value ",
 Cell[BoxData[
  FormBox["1", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8ac7fc1c-d34c-414f-bbfe-cd18f3ee5054"],
 " on it, or an Association of values on the basis of degree ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b0871140-352b-43d9-a48c-d00c5ef1167a"],
 "."
}], "Notes",ExpressionUUID->"2cf5c1f9-e22e-41f7-85cd-fc38977d1708"],

Cell[TextData[{
 "The result is a ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Failure"]], "paclet:ref/Failure"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "b17b1b80-78ca-40a7-954c-3e89342d299e"],
 " when the data do not satisfy the axioms, and when the values do not define \
an orientation."
}], "Notes",ExpressionUUID->"0e855f67-1ac6-442b-821f-5fd0762ae85a"],

Cell[TextData[{
 "The axioms are the relations of the complex: ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Relations"]], "paclet:ChernSimons/ref/Relations", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "b578d707-d416-44da-bab6-fbd1d63dfa05"],
 " names them, ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Obstruction"]], "paclet:ChernSimons/ref/Obstruction", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "94d27378-fb91-4d57-bf2b-a13c7a219d68"],
 " gives each one on elements, and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RelationsQ"]], "paclet:ChernSimons/ref/RelationsQ", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "281df4cd-d182-46e4-af3e-144f65fa60b4"],
 " tests them all."
}], "Notes",ExpressionUUID->"5e714d15-9722-40d0-ad6e-7aec04cc90b2"],

Cell[TextData[{
 "A Sullivan model is infinite-dimensional, but its Poincar\[EAcute] duality \
and its Hodge type are decided in degrees ",
 Cell[BoxData[
  FormBox["0", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e0f0314d-3921-4129-b70d-5e84f3b1ccc8"],
 " to ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["n", "TI"], "+", "1"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5c0570ae-5830-459e-b224-7dab3606baea"],
 "."
}], "Notes",ExpressionUUID->"5ce05811-8851-4cd6-9eb5-ffc57a8630b0"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["CochainComplexWithPairing"]], 
     "paclet:ChernSimons/ref/CochainComplexWithPairing", 
     "ChernSimons Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["model", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a4e313da-12fe-4856-aa10-9129fbb1bcbb"],
 " divides out everything above degree ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["n", "TI"], "+", "2"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "73ac3582-074f-401a-a2e5-8b423bb206c9"],
 " and the monomials of degree ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["n", "TI"], "+", "2"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a8e33725-2ab7-4a5c-821b-c412a672735b"],
 " that the image of the differential does not need. The quotient is a \
differential graded algebra, agrees with the model up to degree ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["n", "TI"], "+", "1"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1714d454-cd09-4933-b2d2-e59e88df6986"],
 " and has no cohomology above."
}], "Notes",ExpressionUUID->"bc7bef65-3844-41b6-b5fe-5af1c38f8b2b"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["CochainComplexWithPairing"]], 
     "paclet:ChernSimons/ref/CochainComplexWithPairing", 
     "ChernSimons Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["algebra", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "afa21433-fdff-458f-ac31-aea0ab8406c2"],
 " keeps the basis of the algebra, reads the differential off its matrix and \
the product off its triple products."
}], "Notes",ExpressionUUID->"819d5d11-1205-434e-9253-72fd32127317"]
}, Open  ]],

