Cell["On three factors the shift costs a sign:", "ExampleText",ExpressionUUID->"3cc0386b-6edd-451a-baf7-a889c1310473"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ExteriorToSymmetric", "[", 
  RowBox[{
   RowBox[{"ExteriorProduct", "[", 
    RowBox[{
     RowBox[{"CyclicWord", "[", 
      RowBox[{"{", "x", "}"}], "]"}], ",", " ", 
     RowBox[{"CyclicWord", "[", 
      RowBox[{"{", "y", "}"}], "]"}], ",", " ", 
     RowBox[{"CyclicWord", "[", 
      RowBox[{"{", 
       RowBox[{"y", ",", " ", "y"}], "}"}], "]"}]}], "]"}], ",", " ", 
   RowBox[{"GradedPairing", "[", 
    RowBox[{
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"x", " ", "->", " ", 
        RowBox[{"-", "1"}]}], ",", " ", 
       RowBox[{"y", " ", "->", " ", "0"}]}], "|>"}], ",", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "y"}], "}"}], " ", "->", " ", "1"}], "|>"}]}], 
    "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"0f568e25-ecd4-434d-aaca-95b40b7c81c0"],

Cell[BoxData[
 RowBox[{"-", 
  InterpretationBox[
   RowBox[{
    InterpretationBox[
     RowBox[{"(", "x", ")"}],
     ChernSimons`CyclicWord[{MTNB$117om4pm5k88p`x}],
     Editable->False], "\[CircleDot]", 
    InterpretationBox[
     RowBox[{"(", "y", ")"}],
     ChernSimons`CyclicWord[{MTNB$117om4pm5k88p`y}],
     Editable->False], "\[CircleDot]", 
    InterpretationBox[
     RowBox[{"(", 
      RowBox[{"y", "\[ThinSpace]", "y"}], ")"}],
     ChernSimons`CyclicWord[{MTNB$117om4pm5k88p`y, MTNB$117om4pm5k88p`y}],
     Editable->False]}],
