Cell["A two-factor exterior product in the symmetric picture:", "ExampleText",ExpressionUUID->"85701ad2-ac9c-4e81-9ecd-9fda5bbea68d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ExteriorToSymmetric", "[", 
  RowBox[{
   RowBox[{"ExteriorProduct", "[", 
    RowBox[{
     RowBox[{"CyclicWord", "[", 
      RowBox[{"{", "x", "}"}], "]"}], ",", " ", 
     RowBox[{"CyclicWord", "[", 
      RowBox[{"{", "y", "}"}], "]"}]}], "]"}], ",", " ", 
   RowBox[{"GradedPairing", "[", 
    RowBox[{
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"x", " ", "->", " ", 
        RowBox[{"-", "1"}]}], ",", " ", 
       RowBox[{"y", " ", "->", " ", "0"}]}], "|>"}], ",", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "y"}], "}"}], " ", "->", " ", "1"}], "|>"}]}], 
    "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"0f9d5c76-4fc7-4daa-bec8-231822ac8668"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{
   InterpretationBox[
    RowBox[{"(", "x", ")"}],
    ChernSimons`CyclicWord[{MTNB$117om4pm5k88p`x}],
    Editable->False], "\[CircleDot]", 
   InterpretationBox[
    RowBox[{"(", "y", ")"}],
    ChernSimons`CyclicWord[{MTNB$117om4pm5k88p`y}],
    Editable->False]}],
  ChernSimons`SymmetricProduct[
   ChernSimons`CyclicWord[{MTNB$117om4pm5k88p`x}], 
   ChernSimons`CyclicWord[{MTNB$117om4pm5k88p`y}]],
  Editable->False]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"6fdb2dbb-3816-4200-9685-c646dfde2649"]
}, Open  ]],

