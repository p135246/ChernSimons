Cell["On three factors the shift costs a sign:", "ExampleText",ExpressionUUID->"b5c53e02-8ab7-4b71-bbe9-35714ec229d1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ExteriorToSymmetric", "[", 
  RowBox[{
   RowBox[{"ExteriorProduct", "[", 
    RowBox[{
     RowBox[{"CyclicWord", "[", 
      RowBox[{"{", "x", "}"}], "]"}], ",", " ", 
     RowBox[{"CyclicWord", "[", 
      RowBox[{"{", "y", "}"}], "]"}], ",", " ", 
     RowBox[{"CyclicWord", "[", 
      RowBox[{"{", 
       RowBox[{"y", ",", " ", "y"}], "}"}], "]"}]}], "]"}], ",", " ", 
   RowBox[{"GradedPairing", "[", 
    RowBox[{
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"x", " ", "->", " ", 
        RowBox[{"-", "1"}]}], ",", " ", 
       RowBox[{"y", " ", "->", " ", "0"}]}], "|>"}], ",", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "y"}], "}"}], " ", "->", " ", "1"}], "|>"}]}], 
    "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"2cf1bd44-c3ea-428b-955c-0e959089d237"],

Cell[BoxData[
 RowBox[{"-", 
  InterpretationBox[
   RowBox[{
