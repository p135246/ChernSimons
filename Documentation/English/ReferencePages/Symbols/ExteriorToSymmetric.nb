Cell["A two-factor exterior product in the symmetric picture:", "ExampleText",ExpressionUUID->"42b7f03c-2eda-41c8-b2eb-704abb15ed5d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ExteriorToSymmetric", "[", 
  RowBox[{
   RowBox[{"ExteriorProduct", "[", 
    RowBox[{
     RowBox[{"CyclicWord", "[", 
      RowBox[{"{", "x", "}"}], "]"}], ",", " ", 
     RowBox[{"CyclicWord", "[", 
      RowBox[{"{", "y", "}"}], "]"}]}], "]"}], ",", " ", 
   RowBox[{"GradedPairing", "[", 
    RowBox[{
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"x", " ", "->", " ", 
        RowBox[{"-", "1"}]}], ",", " ", 
       RowBox[{"y", " ", "->", " ", "0"}]}], "|>"}], ",", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "y"}], "}"}], " ", "->", " ", "1"}], "|>"}]}], 
    "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"edd6ebe4-cf97-4d42-8ff4-b528883f4576"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{
   InterpretationBox[
    RowBox[{"(", "x", ")"}],
    ChernSimons`CyclicWord[{MTNB$117om4pm5k88p`x}],
    Editable->False], "\[CircleDot]", 
   InterpretationBox[
    RowBox[{"(", "y", ")"}],
    ChernSimons`CyclicWord[{MTNB$117om4pm5k88p`y}],
    Editable->False]}],
  ChernSimons`SymmetricProduct[
   ChernSimons`CyclicWord[{MTNB$117om4pm5k88p`x}], 
   ChernSimons`CyclicWord[{MTNB$117om4pm5k88p`y}]],
  Editable->False]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"2f399648-4bf3-4969-a928-f06d967eb3c0"]
}, Open  ]],

