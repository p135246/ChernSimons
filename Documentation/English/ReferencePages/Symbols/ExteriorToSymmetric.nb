Cell[TextData[{
 "The map sends ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["f", "TI"], "1"], "\[Wedge]", "\[CenterEllipsis]", "\[Wedge]", 
    SubscriptBox[
     StyleBox["f", "TI"], 
     StyleBox["k", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0c2d0672-d79a-42bb-ae89-c0fbc007834c"],
 " to ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[PlusMinus]", 
    SubscriptBox[
     StyleBox["f", "TI"], "1"], "\[CircleDot]", "\[CenterEllipsis]", "\[CircleDot]", 
    SubscriptBox[
     StyleBox["f", "TI"], 
     StyleBox["k", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6f615598-a6be-48cf-80d0-959dae1c9825"],
 ", with the sign ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"-", "1"}], ")"}], 
    RowBox[{
     UnderscriptBox["\[Sum]", 
      StyleBox["i", "TI"],
      LimitsPositioning->True], 
     RowBox[{"(", 
      RowBox[{
       StyleBox["k", "TI"], "-", 
       StyleBox["i", "TI"]}], ")"}], 
     RowBox[{"[", 
      SubscriptBox[
       StyleBox["f", "TI"], 
       StyleBox["i", "TI"]], "]"}]}]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6e5a855b-7e79-4738-85b1-2d54214ea9cd"],
 " of the reversal rule or ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"-", "1"}], ")"}], 
    RowBox[{
     UnderscriptBox["\[Sum]", 
      StyleBox["i", "TI"],
      LimitsPositioning->True], 
     StyleBox["i", "TI"], 
     RowBox[{"[", 
      SubscriptBox[
       StyleBox["f", "TI"], 
       StyleBox["i", "TI"]], "]"}]}]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d3992061-0581-48b8-b4d0-30173e52bb13"],
 " of the position rule, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"[", 
    StyleBox["f", "TI"], "]"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fb392b0f-767d-4d0f-bbd9-1ab56d5f43dc"],
 " being the exterior degree of ",
 Cell[BoxData[
  FormBox[
   StyleBox["f", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "23859fb2-6967-4dc9-8e3b-2f82e504bce5"],
 "."
}], "Notes",
 CellFrameLabels->{{Inherited, Inherited}, {Inherited, 
    Cell[
     TextData[{
      "26.09.30: Design review - ExteriorToSymmetric is what ShiftIsomorphism \
did with \"Inverse\" -> True, and SymmetricToExterior what it did by default; \
the split (Pavel, 2026-09-30) lets each name say which way it converts, \
instead of an option. Both carry their own linearity rules and the option \
\"Rule\", with the positional third argument kept as a shortcut. The \
direction is set by the function, never by the \"Convention\" key of the \
pairing, and a product of the other head returns unevaluated. The rules are \
\"Reversal\" and \"Position\", in the third argument and in the option; since \
R7 (Pavel, 2026-10-01) any other value returns unevaluated, where before \
every string but \"Position\" gave the reversal sign. Alternative name \
considered: ShiftIsomorphism with \"Inverse\" -> True. Prior art: the Wolfram \
Language has Wedge and TensorWedge but no graded symmetric algebra of cyclic \
words and no decalage isomorphism; the engine the verification suites load \
pins both rules on every tuple of words to length 3.", "\n\n", 
       Cell[
        BoxData[
         GridBox[{{
            Cell[
             BoxData[
              ButtonBox[
               DynamicBox[
                FEPrivate`FrontEndResource[
                "DocumentationToolsStrings", "Edit"]], BaseStyle -> 
               "TextAnnotationButton"]]], 
            StyleBox[
             RowBox[{
               DynamicBox[
                FEPrivate`FrontEndResource[
                "DocumentationToolsStrings", "LastAnnotator"]], "pavel"}], 
             "TextAnnotator"], 
            Cell[
             BoxData[
              ButtonBox[
               DynamicBox[
                FEPrivate`FrontEndResource[
                "DocumentationToolsStrings", "Delete"]], BaseStyle -> 
               "TextAnnotationRemoveButton"]]], ""}}, 
          GridBoxAlignment -> {
           "Columns" -> {Left, Left, Right, Right}, "Rows" -> {{Automatic}}}, 
          GridBoxItemSize -> {"Columns" -> {
              Scaled[0.15], 
              Scaled[0.68], 
              Scaled[0.15], 
              Scaled[0.02]}}]]], "\n"}], "TextAnnotation", 
     CellSize -> {590, Inherited}]}},
 CellTags->"TextAnnotation",
 CellID->654528396,ExpressionUUID->"4c3cf32c-d3e0-427b-a7a6-836706aacce7"],

