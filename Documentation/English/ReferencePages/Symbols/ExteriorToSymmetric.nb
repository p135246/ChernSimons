Cell["On three factors the shift costs a sign:", "ExampleText",ExpressionUUID->"b054f18c-b261-4988-af80-6282022428bd"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ExteriorToSymmetric", "[", 
  RowBox[{
   RowBox[{"ExteriorProduct", "[", 
    RowBox[{
     RowBox[{"CyclicWord", "[", 
      RowBox[{"{", "x", "}"}], "]"}], ",", " ", 
     RowBox[{"CyclicWord", "[", 
      RowBox[{"{", "y", "}"}], "]"}], ",", " ", 
     RowBox[{"CyclicWord", "[", 
      RowBox[{"{", 
       RowBox[{"y", ",", " ", "y"}], "}"}], "]"}]}], "]"}], ",", " ", 
   RowBox[{"GradedPairing", "[", 
    RowBox[{
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"x", " ", "->", " ", 
        RowBox[{"-", "1"}]}], ",", " ", 
       RowBox[{"y", " ", "->", " ", "0"}]}], "|>"}], ",", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "y"}], "}"}], " ", "->", " ", "1"}], "|>"}]}], 
    "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"026c7326-0c5a-46b8-ae28-c1f514ca407f"],

Cell[BoxData[
 RowBox[{"-", 
  InterpretationBox[
   RowBox[{
    InterpretationBox[
     RowBox[{"(", "x", ")"}],
     ChernSimons`CyclicWord[{MTNB$117om4pm5k88p`x}],
     Editable->False], "\[CircleDot]", 
    InterpretationBox[
     RowBox[{"(", "y", ")"}],
     ChernSimons`CyclicWord[{MTNB$117om4pm5k88p`y}],
     Editable->False], "\[CircleDot]", 
    InterpretationBox[
     RowBox[{"(", 
      RowBox[{"y", "\[ThinSpace]", "y"}], ")"}],
     ChernSimons`CyclicWord[{MTNB$117om4pm5k88p`y, MTNB$117om4pm5k88p`y}],
     Editable->False]}],
