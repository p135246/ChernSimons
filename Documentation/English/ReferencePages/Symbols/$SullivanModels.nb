Cell[TextData[{
 "Each model carries its orientation: the product of the odd generators for \
an exterior algebra, and the power of ",
 Cell[BoxData[
  FormBox[
   StyleBox["a", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cf692997-4057-477e-a222-782fe473680b"],
 " or ",
 Cell[BoxData[
  FormBox[
   StyleBox["v", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a9475190-ddfb-470f-9f52-5c5ca31cdd50"],
 " of top degree otherwise."
}], "Notes",ExpressionUUID->"bc89e378-23fe-43c6-b7f6-437984ce575f"],

