Cell[TextData[{
 "Each model carries its orientation: the product of the odd generators for \
an exterior algebra, and the power of ",
 Cell[BoxData[
  FormBox[
   StyleBox["a", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ef6f453b-e795-4aed-bdf0-c0cb104d063f"],
 " or ",
 Cell[BoxData[
  FormBox[
   StyleBox["v", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c19fe7b3-2f02-47ae-82cb-c56294c0e4cf"],
 " of top degree otherwise."
}], "Notes",ExpressionUUID->"6f2e7cd6-c6a7-4f0b-b93c-1df86e6ddd2b"],

