Cell[TextData[{
 "Each model carries its orientation: the product of the odd generators for \
an exterior algebra, and the power of ",
 Cell[BoxData[
  FormBox[
   StyleBox["a", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "c2cc9c22-2038-42ed-81f3-29df88eee4fb"],
 " or ",
 Cell[BoxData[
  FormBox[
   StyleBox["v", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "05550cf6-d296-4fac-ad20-64e1c3a6a191"],
 " of top degree otherwise."
}], "Notes",ExpressionUUID->"4cce9cee-3fc1-4059-bc3c-a514228dd260"],

Cell[TextData[{
 Cell[BoxData["\"\<Degree4Obstruction\>\""], "InlineFormula",ExpressionUUID->
  "a3a13946-3faf-40c7-96a6-3a7f515543a8"],
 " is Example 6.3 of ",
 ButtonBox["arXiv:2004.07362",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://arxiv.org/abs/2004.07362"], None}],
 ", a ",
 Cell[BoxData[
  FormBox["1", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "923af2ef-5421-4abd-ba5a-e01839fcbf43"],
 "-connected PDGA of degree ",
 Cell[BoxData[
  FormBox["4", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "9a1fa88c-54d9-4230-90ad-d85e9b5f0037"],
 " that admits no Hodge decomposition. All the other models are of Hodge type."
}], "Notes",ExpressionUUID->"a8647f16-59c2-4936-8b83-49f73d56531f"]
}, Open  ]],

