Cell[TextData[{
 "All of them are of Hodge type except the last, which is Example 6.3 of ",
 ButtonBox["arXiv:2004.07362",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://arxiv.org/abs/2004.07362"], None}],
 " \[LongDash] a ",
 Cell[BoxData[
  FormBox["1", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "56b626b5-5f80-4d27-a311-865a9b917802"],
 "-connected PDGA of degree ",
 Cell[BoxData[
  FormBox["4", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0bb932b1-ba71-4be8-9c73-7896d36cbb3a"],
 " that admits no Hodge decomposition."
}], "Notes",ExpressionUUID->"78bc5485-bf18-41af-976d-d2ecf7fd7b2e"]
