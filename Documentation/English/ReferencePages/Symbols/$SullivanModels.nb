  "9c642395-e31e-4ced-bea9-a56694f744dd"],
 " is Example 6.3 of ",
 ButtonBox["arXiv:2004.07362",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://arxiv.org/abs/2004.07362"], None}],
 ", a ",
 Cell[BoxData[
  FormBox["1", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8a65a9fc-9379-42be-90be-18f84137dd68"],
 "-connected PDGA of degree ",
 Cell[BoxData[
  FormBox["4", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fc76aedb-3601-4168-a42d-a9f34f4af7a6"],
 " that admits no Hodge decomposition. All the other models are of Hodge type."
}], "Notes",ExpressionUUID->"46599505-088c-4659-b69b-e7c4784396b2"]
}, Open  ]],

