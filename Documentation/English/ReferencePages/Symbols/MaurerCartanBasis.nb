Cell["\<\
Every one of them has the same symmetric degree, which is why they can be \
summed:\
\>", "ExampleText",ExpressionUUID->"2a083706-4322-4e3d-9532-6c963c3694a5"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"pairing", " ", "=", " ", 
   RowBox[{"GradedPairing", "[", 
    RowBox[{
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"x", " ", "->", " ", 
        RowBox[{"-", "1"}]}], ",", " ", 
       RowBox[{"y", " ", "->", " ", "0"}]}], "|>"}], ",", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "y"}], "}"}], " ", "->", " ", "1"}], "|>"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"PlanckDegree", "[", "pairing", "]"}], ",", " ", 
   RowBox[{"DeleteDuplicates", "[", 
    RowBox[{"Map", "[", 
     RowBox[{
      RowBox[{"b", " ", "|->", " ", 
       RowBox[{"WordDegree", "[", 
        RowBox[{
         RowBox[{"First", "[", "b", "]"}], ",", " ", "pairing", ",", 
         " ", "\"\<Symmetric\>\""}], "]"}]}], ",", " ", 
      RowBox[{"Select", "[", 
       RowBox[{
        RowBox[{"MaurerCartanBasis", "[", 
         RowBox[{"pairing", ",", " ", "4"}], "]"}], ",", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"Head", "[", "#", "]"}], " ", "===", " ", "CyclicWord"}], 
         " ", "&"}]}], "]"}]}], "]"}], "]"}]}], "}"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"4fb323d3-edf1-418a-9e97-201113643d96"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"-", "4"}], ",", 
