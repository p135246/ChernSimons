Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"MaurerCartanAnsatz", "[", 
    RowBox[{"c", ",", " ", "pairing", ",", " ", "4"}], "]"}], 
   "[", "\"\<BDAction\>\"", "]"}], " ", "===", " ", 
  RowBox[{"Total", "[", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"b", " ", "|->", " ", 
      RowBox[{
       RowBox[{"c", "[", 
        RowBox[{"Replace", "[", 
         RowBox[{"b", ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"CyclicWord", "[", "w_", "]"}], " ", ":>", " ", "w"}], ",",
             " ", 
            RowBox[{
             RowBox[{"SymmetricProduct", "[", "f__", "]"}], " ", ":>", " ", 
             RowBox[{"First", " ", "/@", " ", 
              RowBox[{"{", "f", "}"}]}]}]}], "}"}]}], "]"}], "]"}], " ", 
       "b"}]}], ")"}], " ", "/@", " ", 
    RowBox[{"MaurerCartanBasis", "[", 
     RowBox[{"pairing", ",", " ", "4"}], "]"}]}], "]"}]}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"df2ef068-efb9-4184-916c-50f9c144032d"],

