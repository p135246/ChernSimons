Cell[CellGroupData[{
Cell["MaurerCartanBasis", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"f159fe22-468f-48c8-a383-fea44c98f9f6"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["MaurerCartanBasis"]], 
     "paclet:ChernSimons/ref/MaurerCartanBasis", "ChernSimons Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["pairing", "TI"], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "de6e6c8c-01dc-4ac7-81c3-e6fc6ecf5203"],
 "\[LineSeparator]",
 "lists the normalized products of cyclic words of total length at most ",
 StyleBox["n", "TI"],
 " whose symmetric degree is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["PlanckDegree"]], "paclet:ChernSimons/ref/PlanckDegree", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "005dae72-b907-4b52-ab13-550e12cf34e2"],
 "[",
 StyleBox["pairing", "TI"],
 "].",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"69e88ce7-d245-4918-b193-2143cf59c405"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["MaurerCartanBasis"]], 
     "paclet:ChernSimons/ref/MaurerCartanBasis", "ChernSimons Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["degree", "TI"], ",", " ", 
    StyleBox["pairing", "TI"], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2f794cd5-e489-44ff-b895-9f4dc03bfb69"],
 "\[LineSeparator]",
 "uses the given degree instead."
}], "Usage",ExpressionUUID->"d6756b43-2717-4097-b7b2-051e1a2e8376"],

Cell[TextData[{
 "These are the monomials a genus-zero BD action of that degree is built \
from. One-factor monomials are returned as bare cyclic words, matching how \
the paper writes ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["m", "TI"], 
    RowBox[{"1", ",", "0"}]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8b63f5dc-e136-416a-879c-96db2a92331c"],
 "; monomials of two or more factors are symmetric products."
}], "Notes",ExpressionUUID->"f7397251-494c-4866-b45c-a13844c75c50"],

Cell["\<\
The list is sign-normalized and duplicate-free: each monomial appears once, \
in the canonical order the products sort into, without the scalar sign that \
reordering would produce.\
\>", "Notes",ExpressionUUID->"2c0981a3-8e8d-4ad7-977e-c840512559d0"],

Cell[TextData[{
 "The truncation is by ",
 StyleBox["total",
  FontWeight->"Bold"],
 " word length, so a two-factor monomial of lengths ",
 Cell[BoxData[
  FormBox["2", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "94a4923a-81b4-4833-9973-d85e50f17966"],
 " and ",
 Cell[BoxData[
  FormBox["3", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "590de50a-9d68-4b49-8e37-9299a137894f"],
 " counts as ",
 Cell[BoxData[
  FormBox["5", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "47399fda-692f-419a-b4d7-da443bd92c61"],
 "."
}], "Notes",ExpressionUUID->"25cfc4fe-bd8f-4904-a38b-e56c9a71d853"]
}, Open  ]],

