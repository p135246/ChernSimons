Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"pairing", " ", "=", " ", 
  RowBox[{"GradedPairing", "[", 
   RowBox[{
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"x", " ", "->", " ", 
