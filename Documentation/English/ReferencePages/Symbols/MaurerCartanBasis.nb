Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"MaurerCartanAnsatz", "[", 
    RowBox[{"c", ",", " ", "pairing", ",", " ", "4"}], "]"}], 
   "[", "\"\<BDAction\>\"", "]"}], " ", "===", " ", 
  RowBox[{"Total", "[", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"b", " ", "|->", " ", 
      RowBox[{
       RowBox[{"c", "[", 
        RowBox[{"Replace", "[", 
         RowBox[{"b", ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"CyclicWord", "[", "w_", "]"}], " ", ":>", " ", "w"}], ",",
             " ", 
            RowBox[{
             RowBox[{"SymmetricProduct", "[", "f__", "]"}], " ", ":>", " ", 
             RowBox[{"First", " ", "/@", " ", 
              RowBox[{"{", "f", "}"}]}]}]}], "}"}]}], "]"}], "]"}], " ", 
       "b"}]}], ")"}], " ", "/@", " ", 
    RowBox[{"MaurerCartanBasis", "[", 
     RowBox[{"pairing", ",", " ", "4"}], "]"}]}], "]"}]}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"3d3caeb5-c2c2-46e7-b148-ba9aac1ddb6f"],

