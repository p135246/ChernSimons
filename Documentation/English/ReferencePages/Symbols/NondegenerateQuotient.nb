}, Open  ]],

Cell[TextData[{
 "The quotient is still taken, and is still a Poincar\[EAcute] duality \
algebra. It is the cohomology of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["CP",
     FontSlant->"Plain"], "2"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"9a505651-7ca9-4000-9e06-52c6f39c7d48"],
 ":"
}], "ExampleText",ExpressionUUID->"3c83a48f-9031-4664-b762-93e12d1d7050"],

