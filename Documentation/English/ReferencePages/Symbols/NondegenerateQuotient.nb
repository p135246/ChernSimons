Cell["It is not of Hodge type:", "ExampleText",ExpressionUUID->"c0633ded-3b63-41e9-95bf-7efa4d889b1f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"HodgeTypeQ", "[", "model", "]"}]], "Input",
