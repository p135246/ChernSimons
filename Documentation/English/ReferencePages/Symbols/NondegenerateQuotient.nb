Cell[TextData[{
 "The minimal model of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["S", "TI"], "4"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "565c45ad-392b-4d87-a95b-101fd7eada3c"],
 " is infinite-dimensional; its quotient is two-dimensional:"
}], "ExampleText",ExpressionUUID->"361fb50b-0fbf-4948-ac3d-cfb999d5a8e4"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"quotient", " ", "=", " ", 
   RowBox[{"NondegenerateQuotient", "[", 
    RowBox[{"SullivanModel", "[", 
     RowBox[{"\"\<Sphere\>\"", "[", "4", "]"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"quotient", "[", "\"\<Basis\>\"", "]"}], ",", " ", 
   RowBox[{"quotient", "[", "\"\<Degrees\>\"", "]"}], ",", " ", 
   RowBox[{"quotient", "[", "\"\<Degree\>\"", "]"}]}], "}"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"ab67c6e0-39f2-4ac5-962c-ba2ed19904ad"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", "v"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "4"}], "}"}], ",", "4"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"c352ec44-ae30-4eb9-8889-63c80f2d721f"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 InterpretationBox[Cell[
  "\t", "ExampleDelimiter",ExpressionUUID->
   "a20b2c1d-ef40-4f8f-9b75-e4896e417733"],
  $Line = 0; Null]], "ExampleDelimiter",ExpressionUUID->"54ebbb63-eaa7-4c77-\
91d1-128c7c5d4016"],

Cell[TextData[{
 "The quotient of a nilmanifold model carries a nonzero differential, the \
model not being formal \[LongDash] the data that ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CyclicDifferential"]], 
    "paclet:ChernSimons/ref/CyclicDifferential", "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "939b7229-db93-4f5e-ba58-a83890b2f939"],
 " turns into the operation ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["q", "TI"], 
    RowBox[{"1", ",", "1", ",", "0"}]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a0ffd25a-222c-4806-a987-639c545f0bc1"],
 " of the alphabet. Here ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["d",
     FontSlant->"Plain"], 
    StyleBox["z", "TI"], "\[LongEqual]", 
    StyleBox["x", "TI"], 
    StyleBox["y", "TI"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "51a0d229-b5f5-4c86-be07-dbe04d137486"],
 ", ",
 Cell[BoxData[
  FormBox[
   StyleBox["z", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "59430be1-1ca4-44ee-a6e2-8aae6540f738"],
 " being the second basis vector and ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"x", "y"}], "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "769579ba-d324-4493-a3cc-2a704a4e5931"],
 " the seventh:"
}], "ExampleText",ExpressionUUID->"07ba504f-078a-4bb7-b6e4-749d44937cdd"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"quotient", " ", "=", " ", 
   RowBox[{"NondegenerateQuotient", "[", 
    RowBox[{"SullivanModel", "[", "\"\<HeisenbergNilmanifold\>\"", "]"}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"quotient", "[", "\"\<Basis\>\"", "]"}], ",", " ", 
   RowBox[{"Normal", "[", 
    RowBox[{"quotient", "[", "\"\<DifferentialPairing\>\"", "]"}], "]"}]}], 
  "}"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"bd33d372-9434-4d70-b1fa-3e1e350c17bb"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", "z", ",", "y", ",", "x", ",", 
     RowBox[{"y", " ", "z"}], ",", 
     RowBox[{"x", " ", "z"}], ",", 
     RowBox[{"x", " ", "y"}], ",", 
     RowBox[{"x", " ", "y", " ", "z"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"2", ",", "2"}], "}"}], "\[Rule]", "1"}], "}"}]}], 
  "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"3fe77eb3-5309-47fe-8a99-10e9976c176a"]
}, Open  ]]
}, Open  ]]
}, Open  ]],

