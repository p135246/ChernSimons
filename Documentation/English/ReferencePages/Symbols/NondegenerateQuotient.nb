Cell[TextData[{
 "The representatives of degree ",
 Cell[BoxData[
  FormBox[
   StyleBox["k", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "18108826-4fd5-4924-beaf-76e6a37b8b9d"],
 " are the first monomials of degree ",
 Cell[BoxData[
  FormBox[
   StyleBox["k", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2971ea23-044d-4593-a7f1-96235d075167"],
 " whose rows of the pairing matrix against degree ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["n", "TI"], "-", 
    StyleBox["k", "TI"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7a27d242-8a4a-4d81-b62d-6da05aff7af2"],
 " are independent."
}], "Notes",ExpressionUUID->"1392b842-3627-4035-b7af-75fa3c018b93"],

Cell[TextData[{
 "The quotient is nonzero only in degrees ",
 Cell[BoxData[
  FormBox["0", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2634efc8-3291-4549-9e76-8e07094d26b5"],
 " to ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "eed91263-eba3-494e-b013-afaf6aecb67f"],
 ", and the pairing on it is perfect, so it is a differential \
Poincar\[EAcute] duality algebra."
}], "Notes",ExpressionUUID->"8e84d277-73cd-4065-902b-19136c0fbda2"],

Cell[TextData[{
 "When the model is of Hodge type the quotient map is a quasi-isomorphism, \
and the quotient is then a differential Poincar\[EAcute] duality model of the \
model; see ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["HodgeTypeQ"]], "paclet:ChernSimons/ref/HodgeTypeQ", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "40a43c29-c057-479c-82d9-d1914ef593a6"],
 "."
}], "Notes",ExpressionUUID->"b043a5a1-f876-474f-b2fb-2658bd97d111"],

Cell[TextData[{
 "The triple products are well defined on the quotient because the degenerate \
subspace is an ideal for the pairing. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CanonicalMaurerCartan"]], 
    "paclet:ChernSimons/ref/CanonicalMaurerCartan", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "2d19bf7b-f03b-41a9-bb09-7b6634f1c10c"],
 " is built from them."
}], "Notes",ExpressionUUID->"278459d5-6ae2-41af-8dfe-b4b8104299e3"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["GradedPairing"]], "paclet:ChernSimons/ref/GradedPairing", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "b4be48a1-75fb-4eba-84e3-b317b499ba9a"],
 " attaches the quotient to the alphabet as its ",
 Cell[BoxData["\"\<Algebra\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a6dd407a-d344-45dc-8cdc-8902a27ae801"],
 " key, and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CyclicHochschildDifferential"]], 
    "paclet:ChernSimons/ref/CyclicHochschildDifferential", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "3333e9c7-9c21-45bb-8637-714e2c6c9b60"],
 " reads the matrix of the differential from there, the operation ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["q", "TI"], 
    RowBox[{"1", ",", "1", ",", "0"}]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7a100ded-b2c6-4805-b14a-a6fba4ebc906"],
 "."
}], "Notes",ExpressionUUID->"cb30339e-377a-4460-a4e3-b87303247a06"],

Cell[TextData[{
 "For a complex, the result is a ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CochainComplexWithPairing"]], 
    "paclet:ChernSimons/ref/CochainComplexWithPairing", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "20d9b16c-1a06-40f9-b9e8-9e7c4c26d907"],
 " on representative basis elements. It keeps the pairing, gives the \
differential of each element as its class in the quotient, and keeps the \
product when the complex has one."
}], "Notes",ExpressionUUID->"3709d986-106a-4a5e-8c24-767f14bd8c9d"],

Cell["\<\
The quotient is taken whether or not the space is of Hodge type.\
\>", "Notes",ExpressionUUID->"e246159b-9205-461f-b365-33b7d2a012e0"]
}, Open  ]],

