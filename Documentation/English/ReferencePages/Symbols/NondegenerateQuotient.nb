Cell[TextData[{
 "The quotient is nonzero only in degrees ",
 Cell[BoxData[
  FormBox["0", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "71ccc7cf-e85b-45d1-b61e-d2eb14380bf8"],
 " to ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e20d6e43-a9e6-43de-8c2b-3b9ce1ea866c"],
 ", and the pairing on it is perfect, so it is a differential \
Poincar\[EAcute] duality algebra. When the model is of Hodge type the \
quotient map is a quasi-isomorphism, and the quotient is then a ",
 StyleBox["differential Poincar\[EAcute] duality model",
  FontWeight->"Bold"],
 " of the model \[LongDash] see ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["HodgeTypeQ"]], "paclet:ChernSimons/ref/HodgeTypeQ", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "35c786b3-e220-4a76-a4d5-4afc3de2829a"],
 "."
}], "Notes",ExpressionUUID->"74184766-940f-4465-88ef-c237d63bfe8c"],

Cell[TextData[{
 "The triple products are what ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CanonicalMaurerCartan"]], 
    "paclet:ChernSimons/ref/CanonicalMaurerCartan", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "30fac394-f1d9-4a18-8ef6-41524feb931a"],
 " is built from, and they are well defined on the quotient because the \
degenerate subspace is an ideal for the pairing. The differential data is \
what ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CyclicDifferential"]], 
    "paclet:ChernSimons/ref/CyclicDifferential", "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "398b017b-2e5e-4725-ad85-9affdc3cd017"],
 " consumes: ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["GradedPairing"]], "paclet:ChernSimons/ref/GradedPairing", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "60bd910e-be53-4b4a-85c3-9026924b9558"],
 " attaches the quotient to the alphabet as its ",
 Cell[BoxData["\"\<Algebra\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c668ff77-74a7-418f-9a36-ebbe8c5f3a24"],
 " key, and the operation ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["q", "TI"], 
    RowBox[{"1", ",", "1", ",", "0"}]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7f265dcd-44f3-4752-9e50-34a450c96676"],
 " reads the matrix from there."
}], "Notes",ExpressionUUID->"7f5240bb-0f24-469b-9892-3cf30623a581"]
}, Open  ]],

