}, Open  ]],

Cell[TextData[{
 "The quotient is still taken, and is still a Poincar\[EAcute] duality \
algebra. It is the cohomology of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["CP",
     FontSlant->"Plain"], "2"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"78a89ecb-326a-4d30-b726-6b3009e1ebff"],
 ":"
}], "ExampleText",ExpressionUUID->"dc0262c1-18a1-4aba-bde4-52fc03adb8d3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"NondegenerateQuotient", "[", "model", "]"}], "[", "\"\<Basis\>\"", 
  "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"21032930-375d-44cf-bc58-56a967d09cfa"],

Cell[BoxData[
 RowBox[{"{", 
