Cell[TextData[{
 "The quotient is the input to the IBL layer: ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["GradedPairing"]], "paclet:ChernSimons/ref/GradedPairing", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "512048a7-270a-43b2-9cc6-eb6b726f8013"],
 " reads the alphabet off it, and the element follows."
}], "ExampleText",ExpressionUUID->"626c51a6-5893-426d-980e-ab7c16025624"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"pairing", " ", "=", " ", 
   RowBox[{"GradedPairing", "[", 
    RowBox[{"NondegenerateQuotient", "[", 
     RowBox[{"SullivanModel", "[", 
      RowBox[{"\"\<ComplexProjectiveSpace\>\"", "[", "2", "]"}], "]"}], "]"}],
     "]"}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Normal", "[", 
    RowBox[{"pairing", "[", "\"\<Degrees\>\"", "]"}], "]"}], ",", " ", 
   RowBox[{"CanonicalMaurerCartan", "[", "pairing", "]"}]}], "}"}]}], "Input",\

 CellLabel->"In[1]:= ",ExpressionUUID->"f9d98bc3-2106-4146-88c4-7c0854d0f897"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"1", "\[Rule]", 
      RowBox[{"-", "1"}]}], ",", 
     RowBox[{"a", "\[Rule]", "1"}], ",", 
     RowBox[{
      SuperscriptBox["a", "2"], "\[Rule]", "3"}]}], "}"}], ",", 
   RowBox[{
    RowBox[{"-", 
     InterpretationBox[
      RowBox[{"(", 
       RowBox[{"1", "\[ThinSpace]", "1", "\[ThinSpace]", 
        SuperscriptBox["a", "2"]}], ")"}],
      ChernSimons`CyclicWord[{1, 1, MTNB$h1xxviacxxrg`a^2}],
      Editable->False]}], "-", 
    InterpretationBox[
     RowBox[{"(", 
      RowBox[{"1", "\[ThinSpace]", "a", "\[ThinSpace]", "a"}], ")"}],
     ChernSimons`CyclicWord[{1, MTNB$h1xxviacxxrg`a, MTNB$h1xxviacxxrg`a}],
     Editable->False]}]}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"a4ee7e50-0347-4f30-b4a5-4678027fd4e6"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 InterpretationBox[Cell[
  "Possible Issues", "ExampleSection",ExpressionUUID->
   "dda06a82-eb41-4b48-8510-6cb821647761"],
  $Line = 0; Null]], "ExampleSection",
 CellID->1305812373,ExpressionUUID->"9397dd0b-9de4-443a-9371-be2b75148f2f"],

Cell[TextData[{
 "The quotient is taken whether or not the model is of Hodge type. When it is \
not, the quotient is still a Poincar\[EAcute] duality algebra but is ",
 StyleBox["not",
  FontWeight->"Bold"],
 " quasi-isomorphic to the model \[LongDash] for the degree-",
 Cell[BoxData[
  FormBox["4", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c8029428-1c4b-48e5-8f8d-3b262c6be691"],
 " obstruction it is the cohomology of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["CP",
     FontSlant->"Plain"], "2"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "84451270-ef20-4954-bacc-ad70fe72dc54"],
 " where the model has the cohomology of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["S", "TI"], "4"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ae60b50b-fa09-4f60-a0da-98884744635c"],
 "."
}], "ExampleText",ExpressionUUID->"944d8fd0-2abc-4917-8541-04babb651e07"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"model", " ", "=", " ", 
   RowBox[{"SullivanModel", "[", "\"\<Degree4Obstruction\>\"", "]"}]}], 
  ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"HodgeTypeQ", "[", "model", "]"}], ",", " ", 
   RowBox[{
    RowBox[{"NondegenerateQuotient", "[", "model", "]"}], "[", "\"\<Basis\>\"",
     "]"}], ",", "\n", " ", 
   RowBox[{"Total", "[", 
    RowBox[{"Values", "[", 
     RowBox[{
      RowBox[{"HodgeTypeReport", "[", "model", "]"}], "[", 
      RowBox[{"All", ",", " ", "\"\<Cohomology\>\""}], "]"}], "]"}], "]"}]}], 
  "}"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"3603ea20-ab03-47bc-8e7c-e1f305e3a317"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"False", ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "a", ",", 
     SuperscriptBox["a", "2"]}], "}"}], ",", "2"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"ce3d950e-43a8-403d-a834-4718dfcc880e"]
}, Open  ]]
}, Open  ]],

