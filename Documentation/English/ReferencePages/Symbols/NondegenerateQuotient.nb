Cell["It is not of Hodge type:", "ExampleText",ExpressionUUID->"270994f8-284d-474c-a205-6efa4dca8dc8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"HodgeTypeQ", "[", "model", "]"}]], "Input",
