Cell["It is not of Hodge type:", "ExampleText",ExpressionUUID->"8c420c06-f054-464b-9674-d52f2350060c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"HodgeTypeQ", "[", "model", "]"}]], "Input",
