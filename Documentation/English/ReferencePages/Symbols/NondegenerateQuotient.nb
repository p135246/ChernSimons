Cell[BoxData[
 RowBox[{
  RowBox[{"NondegenerateQuotient", "[", "model", "]"}], "[", "\"\<Basis\>\"", 
  "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"b80aef9e-cd08-4b90-9142-6e8a26cba61f"],

