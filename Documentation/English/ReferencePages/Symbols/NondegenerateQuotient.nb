Cell["It is not of Hodge type:", "ExampleText",ExpressionUUID->"61250b0c-c647-4542-9d68-5dca71beca7a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"HodgeTypeQ", "[", "model", "]"}]], "Input",
