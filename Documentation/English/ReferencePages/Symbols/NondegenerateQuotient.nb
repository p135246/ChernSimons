   SuperscriptBox["a", "2"]}], "}"}]], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"eaa53182-473e-45e8-b14f-d9f076daae6e"]
}, Open  ]],

Cell[TextData[{
 "The model has the cohomology of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["S", "TI"], "4"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"77c676c0-115f-49e5-91d2-a94ecaaacf83"],
 ", so the quotient is not quasi-isomorphic to it:"
}], "ExampleText",ExpressionUUID->"f9cfc1e0-f96c-4af4-99f1-54148f295c92"],

