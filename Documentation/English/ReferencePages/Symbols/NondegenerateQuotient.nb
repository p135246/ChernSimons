}, Open  ]],

Cell[TextData[{
 "The quotient is still taken, and is still a Poincar\[EAcute] duality \
algebra. It is the cohomology of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["CP",
     FontSlant->"Plain"], "2"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4665dfe7-2f3e-4c55-a313-46840fc94d18"],
 ":"
}], "ExampleText",ExpressionUUID->"838dc13f-3fd9-4705-b7fb-24e5a332dba5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"NondegenerateQuotient", "[", "model", "]"}], "[", "\"\<Basis\>\"", 
  "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"1283fe3a-6fd9-4af1-8b51-4251e99747b9"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"1", ",", "a", ",", 
   SuperscriptBox["a", "2"]}], "}"}]], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"a569333a-0731-4b4b-9cfa-bf9444dd2862"]
}, Open  ]],

Cell[TextData[{
 "The model has the cohomology of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["S", "TI"], "4"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cc279efd-2102-4432-8aa1-3d71e93c3b3a"],
 ", so the quotient is not quasi-isomorphic to it:"
}], "ExampleText",ExpressionUUID->"69c5fa36-df0e-432e-920e-d0d4a71b5aba"],

