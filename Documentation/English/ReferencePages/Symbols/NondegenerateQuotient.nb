Cell[BoxData["False"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"26dbb7fc-93a2-4cb2-b26e-6c20d207a050"]
}, Open  ]],

Cell[TextData[{
 "The quotient is still taken, and is still a Poincar\[EAcute] duality \
algebra. It is the cohomology of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["CP",
     FontSlant->"Plain"], "2"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e77e9a5a-3764-46e0-a4e0-06926c2adcf8"],
 ":"
}], "ExampleText",ExpressionUUID->"b9fe8829-cfa0-4f1a-bbc9-4e548e6b20c7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"NondegenerateQuotient", "[", "model", "]"}], "[", "\"\<Basis\>\"", 
  "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"52fbc650-0bb6-41c8-85dd-7041f6fbe19d"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"1", ",", "a", ",", 
   SuperscriptBox["a", "2"]}], "}"}]], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"30c9c1b4-2dc6-4411-9343-c170afa7af04"]
}, Open  ]],

Cell[TextData[{
 "The model has the cohomology of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["S", "TI"], "4"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7d0ca9d4-56b7-4387-bd6e-e6ebfcd969e5"],
 ", so the quotient is not quasi-isomorphic to it:"
}], "ExampleText",ExpressionUUID->"f20f6069-dc8e-4205-9907-eb2a21367028"],

