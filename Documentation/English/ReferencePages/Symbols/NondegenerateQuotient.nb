Cell[TextData[{
 "The representatives of degree ",
 Cell[BoxData[
  FormBox[
   StyleBox["k", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "d441f644-0124-4177-8ef6-c6ca2b84c1f0"],
 " are the first monomials of degree ",
 Cell[BoxData[
  FormBox[
   StyleBox["k", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "4ab6dea4-be4c-473f-9b14-f8bcef243a37"],
 " whose rows of the pairing matrix against degree ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["n", "TI"], "-", 
    StyleBox["k", "TI"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "8bec6f17-b82f-4c51-bf39-47ddb8b18d1f"],
 " are independent."
}], "Notes",ExpressionUUID->"83bb24af-7d8a-44ac-aca4-ae226e74c178"],

Cell[TextData[{
 "The quotient is nonzero only in degrees ",
 Cell[BoxData[
  FormBox["0", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "ec8a4dcd-e1e5-4ffb-abe3-4c7d8c1d1597"],
 " to ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "f091faea-557f-4ac8-8d46-a9dd248959c9"],
 ", and the pairing on it is perfect, so it is a differential \
Poincar\[EAcute] duality algebra."
}], "Notes",ExpressionUUID->"6ff92275-c64d-4621-aa21-aebd0bf0db5c"],

Cell[TextData[{
 "When the model is of Hodge type the quotient map is a quasi-isomorphism, \
and the quotient is then a differential Poincar\[EAcute] duality model of the \
model; see ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["HodgeTypeQ"]], "paclet:ChernSimons/ref/HodgeTypeQ", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "4158ce1f-27cc-4467-afc9-1a32cc1eee19"],
 "."
}], "Notes",ExpressionUUID->"5332ef2a-c15b-4fbf-9573-a15913516d44"],

Cell[TextData[{
 "The triple products are well defined on the quotient because the degenerate \
subspace is an ideal for the pairing. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CanonicalMaurerCartan"]], 
    "paclet:ChernSimons/ref/CanonicalMaurerCartan", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "045760de-6342-48e1-9d10-8ee76d1af8cc"],
 " is built from them."
}], "Notes",ExpressionUUID->"bc8def14-7742-446e-a974-d48540d25ac6"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["GradedPairing"]], "paclet:ChernSimons/ref/GradedPairing", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "0eef768d-5b92-45d1-9dfc-b88a436985e5"],
 " attaches the quotient to the alphabet as its ",
 Cell[BoxData["\"\<Algebra\>\""], "InlineFormula",ExpressionUUID->
  "d1c80ca6-5205-4421-8530-4f1076561133"],
 " key, and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CyclicHochschildDifferential"]], 
    "paclet:ChernSimons/ref/CyclicHochschildDifferential", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "962cc431-37ad-4eed-9451-3d9feae307ed"],
 " reads the matrix of the differential from there, the operation ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["q", "TI"], 
    RowBox[{"1", ",", "1", ",", "0"}]], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"7d394fe1-ccbf-48eb-b24b-1ae06bc50c75"],
 "."
}], "Notes",ExpressionUUID->"1c5512c0-80d3-48da-82ab-62ba643a1382"],

Cell[TextData[{
 "For a complex, the result is a ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CochainComplexWithPairing"]], 
    "paclet:ChernSimons/ref/CochainComplexWithPairing", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "cba53388-269e-4ee9-a55d-fd4ce4cc732f"],
 " on representative basis elements. It keeps the pairing, gives the \
differential of each element as its class in the quotient, and keeps the \
product when the complex has one."
}], "Notes",ExpressionUUID->"cc9cafdd-8550-4444-9926-a2b96c519c14"],

Cell["\<\
The quotient is taken whether or not the space is of Hodge type.\
\>", "Notes",ExpressionUUID->"704aeacf-9955-41ba-83d5-bb721babf576"]
}, Open  ]],

