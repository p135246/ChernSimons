Cell[TextData[{
 "The representatives of degree ",
 Cell[BoxData[
  FormBox[
   StyleBox["k", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ebfb283e-39d3-46d9-95d6-1b74f1a64323"],
 " are the first monomials of degree ",
 Cell[BoxData[
  FormBox[
   StyleBox["k", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5194da73-cad6-41ff-bc56-93fc427f9e6a"],
 " whose rows of the pairing matrix against degree ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["n", "TI"], "-", 
    StyleBox["k", "TI"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3b7a08a1-f252-4681-9b88-ca421667fb30"],
 " are independent."
}], "Notes",ExpressionUUID->"ee1ee597-2c12-4ef5-a06b-951e5a623e9f"],

Cell[TextData[{
 "The quotient is nonzero only in degrees ",
 Cell[BoxData[
  FormBox["0", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bba1d6fe-ab92-452f-9bf6-9a6fa440b68b"],
 " to ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9dcc1585-89d8-4091-a91a-a43c7d7c1471"],
 ", and the pairing on it is perfect, so it is a differential \
Poincar\[EAcute] duality algebra."
}], "Notes",ExpressionUUID->"99d15712-f6b4-46fd-88d6-1dc1660b39ee"],

Cell[TextData[{
 "When the model is of Hodge type the quotient map is a quasi-isomorphism, \
and the quotient is then a differential Poincar\[EAcute] duality model of the \
model; see ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["HodgeTypeQ"]], "paclet:ChernSimons/ref/HodgeTypeQ", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "94d9c699-51cc-42a4-b0a8-f59a136223a9"],
 "."
}], "Notes",ExpressionUUID->"500c9f86-37a7-4a70-93d9-b63b5e71ae84"],

Cell[TextData[{
 "The triple products are well defined on the quotient because the degenerate \
subspace is an ideal for the pairing. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CanonicalMaurerCartan"]], 
    "paclet:ChernSimons/ref/CanonicalMaurerCartan", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "3f2279b1-cd49-4916-a2ba-f949b6f9d967"],
 " is built from them."
}], "Notes",ExpressionUUID->"b67c3d4f-c30a-4f22-bed0-326339aab25c"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["GradedPairing"]], "paclet:ChernSimons/ref/GradedPairing", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "ae855c21-13da-4d3b-be88-d6ffdb4fc8e9"],
 " attaches the quotient to the alphabet as its ",
 Cell[BoxData["\"\<Algebra\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1848f678-ed6c-488a-8243-643d742df1c7"],
 " key, and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CyclicHochschildDifferential"]], 
    "paclet:ChernSimons/ref/CyclicHochschildDifferential", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "e2c49273-0de3-4055-bd9d-daaa6177ceaf"],
 " reads the matrix of the differential from there, the operation ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["q", "TI"], 
    RowBox[{"1", ",", "1", ",", "0"}]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "06394c1c-6ad4-4e50-969d-298fae4134ed"],
 "."
}], "Notes",ExpressionUUID->"05427021-7d89-4502-81b0-3b0a613a9f6b"],

Cell[TextData[{
 "For a complex, the result is a ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CochainComplexWithPairing"]], 
    "paclet:ChernSimons/ref/CochainComplexWithPairing", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "e8005bed-1e9f-4bc4-a3ea-3ecd436a05c2"],
 " on representative basis elements. It keeps the pairing, gives the \
differential of each element as its class in the quotient, and keeps the \
product when the complex has one."
}], "Notes",ExpressionUUID->"d4908a4a-ef50-46ed-8942-32c5cf45ed27"],

Cell["\<\
The quotient is taken whether or not the space is of Hodge type.\
\>", "Notes",ExpressionUUID->"e38afe90-cfc2-46db-afff-8d1158c32b21"]
}, Open  ]],

