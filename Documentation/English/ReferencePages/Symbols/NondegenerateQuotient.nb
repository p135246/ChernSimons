 CellLabel->"Out[3]= ",ExpressionUUID->"c7d9cd05-bcbd-4598-8755-bdfe8e9347ef"]
}, Open  ]],

Cell[TextData[{
 "The model has the cohomology of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["S", "TI"], "4"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"3192aa5e-e062-4596-9fd6-a00a6a1801c8"],
 ", so the quotient is not quasi-isomorphic to it:"
}], "ExampleText",ExpressionUUID->"9bd7d770-f2e0-46e7-b3b6-5cc632c8e652"],

