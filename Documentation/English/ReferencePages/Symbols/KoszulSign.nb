Cell["\<\
The whole sign table of the transpositions of a three-element list:\
\>", "ExampleText",ExpressionUUID->"92501aff-f0a1-4f01-ae4b-20866dd032ab"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Map", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"#", " ", "->", " ", 
     RowBox[{"KoszulSign", "[", 
      RowBox[{"#", ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "1"}], ",", " ", "0", ",", " ", 
         RowBox[{"-", "1"}]}], "}"}], ",", " ", "0"}], "]"}]}], " ", "&"}], ",",
    " ", 
   RowBox[{"Permutations", "[", 
    RowBox[{"Range", "[", "3", "]"}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"40ea8ac5-cbde-47df-b0c0-cfd61211b882"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{"1", ",", "2", ",", "3"}], "}"}], "\[Rule]", "1"}], ",", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"1", ",", "3", ",", "2"}], "}"}], "\[Rule]", "1"}], ",", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"2", ",", "1", ",", "3"}], "}"}], "\[Rule]", "1"}], ",", 
   RowBox[{
    RowBox[{"{", 
