Cell[TextData[{
 "The sign the products apply when sorting is this one, at the grading and \
parity of the picture: ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ExteriorProduct"]], "paclet:IBLInfinity/ref/ExteriorProduct", 
    "IBLInfinity Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "cb2fbc3f-cd01-4333-b273-2cb33ea59faa"],
 " sorts at the exterior degree with ",
 StyleBox["parity", "TI"],
 " ",
 Cell[BoxData["1"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6fb49f3e-f501-4f42-869b-6f0c92e3f7ea"],
 ", ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SymmetricProduct"]], "paclet:IBLInfinity/ref/SymmetricProduct",
     "IBLInfinity Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "532e62d1-4b52-4677-8a63-6be13937e4e8"],
 " at the symmetric degree with ",
 StyleBox["parity", "TI"],
 " ",
 Cell[BoxData["0"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4e7687cc-6130-47d7-838a-b1d1c1321495"],
 "."
}], "ExampleText",ExpressionUUID->"8b247d11-aa71-4a17-ad6c-d0b980a5a5e5"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"pairing", " ", "=", " ", 
   RowBox[{"Pairing", "[", 
    RowBox[{
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"x", " ", "->", " ", 
        RowBox[{"-", "1"}]}], ",", " ", 
       RowBox[{"y", " ", "->", " ", "0"}]}], "|>"}], ",", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "y"}], "}"}], " ", "->", " ", "1"}], "|>"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"ExteriorProduct", "[", 
    RowBox[{
     RowBox[{"CyclicWord", "[", 
