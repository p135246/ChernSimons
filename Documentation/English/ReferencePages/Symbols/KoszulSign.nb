Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Map", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"#", " ", "->", " ", 
     RowBox[{"KoszulSign", "[", 
      RowBox[{"#", ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "1"}], ",", " ", "0", ",", " ", 
         RowBox[{"-", "1"}]}], "}"}], ",", " ", "0"}], "]"}]}], " ", "&"}], ",",
    " ", 
   RowBox[{"Permutations", "[", 
    RowBox[{"Range", "[", "3", "]"}], "]"}]}], "]"}]], "Input",
