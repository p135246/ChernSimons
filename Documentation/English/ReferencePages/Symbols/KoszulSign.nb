Cell[TextData[{
 "The sign the products apply when sorting is this one, at the grading and \
parity of the picture: ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ExteriorProduct"]], "paclet:ChernSimons/ref/ExteriorProduct", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "899b2807-155e-49b4-ba06-dd5ef61806d9"],
 " sorts at the exterior degree with ",
 StyleBox["parity", "TI"],
 " ",
 Cell[BoxData[
  FormBox["1", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b13c3f52-2d27-44e1-a79e-450e872d98ab"],
 ", ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SymmetricProduct"]], "paclet:ChernSimons/ref/SymmetricProduct",
     "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "1628cdc8-f225-4e70-8a43-e27ffb634001"],
 " at the symmetric degree with ",
 StyleBox["parity", "TI"],
 " ",
 Cell[BoxData[
  FormBox["0", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8f233442-53d3-493d-b75a-3a2e93175a18"],
 "."
}], "ExampleText",ExpressionUUID->"c0e03ad0-e868-4d8e-9252-9f98ba46f038"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"pairing", " ", "=", " ", 
   RowBox[{"GradedPairing", "[", 
    RowBox[{
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"x", " ", "->", " ", 
