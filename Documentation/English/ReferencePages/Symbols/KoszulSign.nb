Cell[CellGroupData[{
Cell["KoszulSign", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"c5e3e5d4-f3d0-426f-b106-8e9dc5f8898a"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["KoszulSign"]], "paclet:ChernSimons/ref/KoszulSign", 
     "ChernSimons Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["perm", "TI"], ",", " ", 
    StyleBox["degrees", "TI"], ",", " ", 
    StyleBox["parity", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "197bdb55-a1da-4fb0-89e5-d85bd67df956"],
 "\[LineSeparator]",
 "gives the sign of bringing objects of the given ",
 StyleBox["degrees", "TI"],
 " into the order ",
 StyleBox["perm", "TI"],
 ", each pair that crosses contributing the product of their degrees plus ",
 StyleBox["parity", "TI"],
 " to the exponent of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", "1"}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "775ba450-f189-4452-84ee-bbd7420a2182"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"92220acd-98a1-423c-8556-14448184f5e8"],

Cell[TextData[{
 StyleBox["perm", "TI"],
 " is a permutation given as a list of positions: the objects are brought \
into the order ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["o", "TI"], 
     SubscriptBox[
      StyleBox["perm",
       FontSlant->"Italic"], "1"]], ",", 
    SubscriptBox[
     StyleBox["o", "TI"], 
     SubscriptBox[
      StyleBox["perm",
       FontSlant->"Italic"], "2"]], ",", "\[Ellipsis]"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"6738142e-df32-4a56-9633-7d55af507d31"],
 "."
}], "Notes",
 CellFrameLabels->{{Inherited, Inherited}, {Inherited, 
    Cell[
     TextData[{
      "26.09.30: Design review - the sign is exported because the products \
and the derivation extensions all sort with it, and the rule of the rewrite \
shares between exports only functions that are themselves exports with a \
mathematical name. One function with a parity argument serves both pictures, \
parity 0 for the graded symmetric sign of the symmetric product and parity 1 \
for the graded antisymmetric sign of the exterior product, rather than two \
functions; the signature is that of the engine's koszulSign[perm, degs, \
parity], which follows the Hypergraph clone. Before the tests were rewritten \
in R1 it was checked against the engine the verification suites load on every \
permutation to length 5, and T12/paclet-products-and-shift pins the two \
products that sort with it against the engine's odot and wedge. Prior art: \
the Wolfram Language has Signature, the sign of a permutation, which is the \
case of degrees 0 and parity 1; it has no graded version.", "\n\n", 
       Cell[
        BoxData[
         GridBox[{{
            Cell[
             BoxData[
              ButtonBox[
               DynamicBox[
                FEPrivate`FrontEndResource[
                "DocumentationToolsStrings", "Edit"]], BaseStyle -> 
               "TextAnnotationButton"]]], 
            StyleBox[
             RowBox[{
               DynamicBox[
                FEPrivate`FrontEndResource[
                "DocumentationToolsStrings", "LastAnnotator"]], "pavel"}], 
             "TextAnnotator"], 
            Cell[
             BoxData[
              ButtonBox[
               DynamicBox[
                FEPrivate`FrontEndResource[
                "DocumentationToolsStrings", "Delete"]], BaseStyle -> 
               "TextAnnotationRemoveButton"]]], ""}}, 
          GridBoxAlignment -> {
           "Columns" -> {Left, Left, Right, Right}, "Rows" -> {{Automatic}}}, 
          GridBoxItemSize -> {"Columns" -> {
              Scaled[0.15], 
              Scaled[0.68], 
              Scaled[0.15], 
              Scaled[0.02]}}]]], "\n"}], "TextAnnotation", 
     CellSize -> {590, Inherited}]}},
 CellTags->"TextAnnotation",
 CellID->668758808,ExpressionUUID->"208430f9-d5e3-49e5-a9e2-529ad780a459"],

Cell[TextData[{
 "The sign is ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"-", "1"}], ")"}], 
    StyleBox["N", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "5c062162-cc7f-4afa-922a-e2a86726c378"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["N", "TI"], "\[LongEqual]", "\[Sum]", 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox[
       StyleBox["d", "TI"], 
       SubscriptBox[
        StyleBox["perm",
         FontSlant->"Italic"], 
        StyleBox["i", "TI"]]], 
      SubscriptBox[
       StyleBox["d", "TI"], 
       SubscriptBox[
        StyleBox["perm",
         FontSlant->"Italic"], 
        StyleBox["j", "TI"]]], "+", 
      StyleBox["parity",
       FontSlant->"Italic"]}], ")"}]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"45fda67f-ec5e-4a33-b83e-966667f7a4fb"],
 ", the sum over the pairs ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["i", "TI"], "<", 
    StyleBox["j", "TI"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "e791610b-f3e3-4a42-893b-b113e9a5f662"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["perm",
      FontSlant->"Italic"], 
     StyleBox["i", "TI"]], ">", 
    SubscriptBox[
     StyleBox["perm",
      FontSlant->"Italic"], 
     StyleBox["j", "TI"]]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"827d7280-75b8-47b7-9278-417ce5d2c56a"],
 ", where ",
 Cell[BoxData[
  FormBox[
   StyleBox["d", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "17b61b18-73bb-4c07-ad97-5e4ffc000ce8"],
 " is the list ",
 StyleBox["degrees", "TI"],
 "."
}], "Notes",ExpressionUUID->"34ad1a9e-caba-4b00-8a8b-c5da833f95f6"],

Cell[TextData[{
 "With ",
 StyleBox["parity", "TI"],
 " ",
 Cell[BoxData[
  FormBox["0", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "0b1345b5-27c5-469c-a775-435dd79f7a9e"],
 " this is the graded symmetric Koszul sign. With ",
 StyleBox["parity", "TI"],
 " ",
 Cell[BoxData[
  FormBox["1", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "43ae7d7b-084b-4db3-8fed-4da18509f956"],
 " it is the graded antisymmetric sign, the Koszul sign times the signature \
of the permutation."
}], "Notes",ExpressionUUID->"4b5a18fc-8db7-4a47-a097-9852831a6c8e"],

Cell[TextData[{
 StyleBox["degrees", "TI"],
 " may be longer than ",
 StyleBox["perm", "TI"],
 "; only the entries that ",
 StyleBox["perm", "TI"],
 " addresses take part."
}], "Notes",ExpressionUUID->"8012b222-2bef-442d-8f0e-7c396181a8fb"],

