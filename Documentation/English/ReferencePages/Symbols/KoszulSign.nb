Cell["The signs of all the permutations of three objects:", "ExampleText",ExpressionUUID->"4726a6c1-bf6f-44a9-b80c-2f74f65b2bea"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"#", " ", "->", " ", 
    RowBox[{"KoszulSign", "[", 
     RowBox[{"#", ",", " ", 
