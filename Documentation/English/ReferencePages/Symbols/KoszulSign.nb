Cell["The signs of all the permutations of three objects:", "ExampleText",ExpressionUUID->"11ff7454-85fb-4f2b-a310-abcdcb3c7314"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"#", " ", "->", " ", 
    RowBox[{"KoszulSign", "[", 
     RowBox[{"#", ",", " ", 
