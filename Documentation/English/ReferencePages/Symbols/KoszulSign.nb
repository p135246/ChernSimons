Notebook[{

Cell[CellGroupData[{
Cell["KoszulSign", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"a6ff88ab-c7c4-483a-95c2-eb306a0d6467"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["KoszulSign"]], "paclet:ChernSimons/ref/KoszulSign", 
     "ChernSimons Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["perm", "TI"], ",", " ", 
    StyleBox["degrees", "TI"], ",", " ", 
    StyleBox["parity", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4b055f7a-86b4-412f-8eb4-27711093f906"],
 "\[LineSeparator]",
 "gives the sign of the permutation ",
 StyleBox["perm", "TI"],
 " of a list of objects of the given ",
 StyleBox["degrees", "TI"],
 ", counting ",
 StyleBox["parity", "TI"],
 " for each transposition in addition to the product of the degrees.",
 "\n"
}], "Usage",ExpressionUUID->"f1843f60-c571-4fab-b4c2-5861b54a25f8"],

Cell[TextData[{
 StyleBox["perm", "TI"],
 " is a permutation given as a list of positions, ",
 StyleBox["degrees", "TI"],
 " the list of degrees of the objects being permuted, and ",
 StyleBox["parity", "TI"],
 " an integer, in practice ",
 Cell[BoxData[
  FormBox["0", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1e1758d7-b8c4-43da-82be-ecce9646857a"],
 " or ",
 Cell[BoxData[
  FormBox["1", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a94e597c-1db0-462b-bad6-fc4be3f7f057"],
 "."
}], "Notes",ExpressionUUID->"c97a0ab8-d0e5-4890-ab3e-8bc439553bee"],

Cell[TextData[{
 "Each transposition of neighbouring objects of degrees ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["d", "TI"], "1"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bb2e6d90-e927-4421-ac84-fa92ccf96e5e"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["d", "TI"], "2"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5dd6cbe7-009c-41d6-84ec-b3b5810f1777"],
 " contributes ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"-", "1"}], ")"}], 
    RowBox[{
     SubscriptBox[
      StyleBox["d", "TI"], "1"], 
     SubscriptBox[
      StyleBox["d", "TI"], "2"], "+", 
     StyleBox["parity", "TI"]}]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0febd77a-62a9-4f8a-b8a1-e7ff608ce7bb"],
 ". With ",
 StyleBox["parity", "TI"],
 " ",
 Cell[BoxData[
  FormBox["0", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "37335c1f-d3c5-428b-b554-741698e569cb"],
 " this is the plain Koszul sign; with ",
 StyleBox["parity", "TI"],
 " ",
 Cell[BoxData[
  FormBox["1", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9ca682de-9236-4e99-b2d9-b05cfd5ba387"],
 " it is the Koszul sign of the shifted grading, which is what the exterior \
picture uses."
}], "Notes",ExpressionUUID->"9f5020b1-81a6-4ccd-aa79-73a469858ea6"],

Cell[TextData[{
 StyleBox["degrees", "TI"],
 " may be longer than ",
 StyleBox["perm", "TI"],
 "; only the entries that ",
 StyleBox["perm", "TI"],
 " addresses take part."
}], "Notes",ExpressionUUID->"c50e5021-7b36-4c80-9f45-5e6d8577cb5e"],

Cell[TextData[{
 "This is the primitive underneath the sorting done by ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ExteriorProduct"]], "paclet:ChernSimons/ref/ExteriorProduct", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "bdccb8df-1003-4dce-b53c-b31bf56b3da8"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SymmetricProduct"]], "paclet:ChernSimons/ref/SymmetricProduct",
     "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "9cbe5599-0f42-4614-bb4c-1063e13a4649"],
 " and underneath the shuffle sums of the derivation extensions. It is \
exported so that a sign convention can be checked directly rather than \
inferred from a result."
}], "Notes",ExpressionUUID->"6c360107-0fad-482e-90f8-b818fb636842"]
}, Open  ]],

