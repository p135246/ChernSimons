Notebook[{

Cell[CellGroupData[{
Cell["KoszulSign", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"5cc3a231-70e2-4e4a-ab89-dd3c81622ea4"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["KoszulSign"]], "paclet:IBLInfinity/ref/KoszulSign", 
     "IBLInfinity Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["perm", "TI"], ",", " ", 
    StyleBox["degrees", "TI"], ",", " ", 
    StyleBox["parity", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "09de8f45-f9e2-4290-aae9-56b64a1bb143"],
 "\[LineSeparator]",
 "gives the sign of the permutation ",
 StyleBox["perm", "TI"],
 " of a list of objects of the given ",
 StyleBox["degrees", "TI"],
 ", counting ",
 StyleBox["parity", "TI"],
 " for each transposition in addition to the product of the degrees.",
 "\n"
}], "Usage",ExpressionUUID->"51797fec-8ef9-4af6-a067-49873f0dbec9"],

Cell[TextData[{
 StyleBox["perm", "TI"],
 " is a permutation given as a list of positions, ",
 StyleBox["degrees", "TI"],
 " the list of degrees of the objects being permuted, and ",
 StyleBox["parity", "TI"],
 " an integer, in practice ",
 Cell[BoxData["0"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4f81d3eb-74c0-44d8-9849-4faaa810d17a"],
 " or ",
 Cell[BoxData["1"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "404e5d6f-ae4e-4da8-b3a4-77090f46ed9b"],
 "."
}], "Notes",ExpressionUUID->"9b5ddb9f-fa5a-4b8a-b352-df6cdb3d7659"],

Cell[TextData[{
 "Each transposition of neighbouring objects of degrees ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["d", "TI"], "1"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "71211648-c19a-4de4-b902-eda4c463d5d4"],
 " and ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["d", "TI"], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "194cebb1-b739-4e68-a115-9e8b9b9f3906"],
 " contributes ",
 Cell[BoxData[
  SuperscriptBox[
   RowBox[{
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{"-", "1"}], 
    StyleBox[")",
     SpanMaxSize->1]}], 
   RowBox[{
    SubscriptBox[
     StyleBox["d", "TI"], "1"], 
    SubscriptBox[
     StyleBox["d", "TI"], "2"], "+", 
    StyleBox[
     StyleBox[
      RowBox[{"p", "a", "r", "i", "t", "y"}], "TI"],
     FontSlant->"Italic"]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f1ede366-6a8e-4e78-b6fe-e770c02cfb1c"],
 ". With ",
 StyleBox["parity", "TI"],
 " ",
 Cell[BoxData["0"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "47a0855a-74c4-4486-aee0-90ca041a9d8c"],
 " this is the plain Koszul sign; with ",
 StyleBox["parity", "TI"],
 " ",
 Cell[BoxData["1"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "17c02319-1b31-45ca-8a99-a093d8256669"],
 " it is the Koszul sign of the shifted grading, which is what the exterior \
picture uses."
}], "Notes",ExpressionUUID->"0e4313eb-7c59-416f-8bf0-fc33911484ba"],

Cell[TextData[{
 StyleBox["degrees", "TI"],
 " may be longer than ",
 StyleBox["perm", "TI"],
 "; only the entries that ",
 StyleBox["perm", "TI"],
 " addresses take part."
}], "Notes",ExpressionUUID->"14f97986-3ff2-4ffb-a694-819ceaa7b682"],

Cell[TextData[{
 "This is the primitive underneath the sorting done by ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ExteriorProduct"]], "paclet:IBLInfinity/ref/ExteriorProduct", 
    "IBLInfinity Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "f966524a-2d59-4598-84c5-ca25660fc79b"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SymmetricProduct"]], "paclet:IBLInfinity/ref/SymmetricProduct",
     "IBLInfinity Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "3a0b0d4f-88f5-4c58-bf9f-e416aeefdd53"],
 " and underneath the shuffle sums of the derivation extensions. It is \
exported so that a sign convention can be checked directly rather than \
inferred from a result."
}], "Notes",ExpressionUUID->"f1325706-4276-48e3-80f4-4f82cac01124"]
}, Open  ]],

