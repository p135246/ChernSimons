     RowBox[{"{", 
      RowBox[{"1", ",", " ", "1"}], "}"}], ",", " ", "0"}], "]"}], ",", " ", 
   RowBox[{"KoszulSign", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"2", ",", " ", "1"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "1"}], "}"}], ",", " ", "1"}], "]"}]}], 
