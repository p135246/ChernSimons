Cell[CellGroupData[{
Cell["KoszulSign", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"f4342200-582d-4840-bfe7-c1414f3e427e"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["KoszulSign"]], "paclet:ChernSimons/ref/KoszulSign", 
     "ChernSimons Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["perm", "TI"], ",", " ", 
    StyleBox["degrees", "TI"], ",", " ", 
    StyleBox["parity", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a496ad3b-784b-45ce-9010-674a1f22cbfa"],
 "\[LineSeparator]",
 "gives the sign of bringing objects of the given ",
 StyleBox["degrees", "TI"],
 " into the order ",
 StyleBox["perm", "TI"],
 ", each pair that crosses contributing the product of their degrees plus ",
 StyleBox["parity", "TI"],
 " to the exponent of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", "1"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "33e2d0ca-2379-4622-92be-3d54d3901bfb"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"7aafbdb6-7d64-4b97-b3e3-14d86b71528d"],

Cell[TextData[{
 StyleBox["perm", "TI"],
 " is a permutation given as a list of positions: the objects are brought \
into the order ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["o", "TI"], 
     SubscriptBox[
      StyleBox["perm",
       FontSlant->"Italic"], "1"]], ",", 
    SubscriptBox[
     StyleBox["o", "TI"], 
     SubscriptBox[
      StyleBox["perm",
       FontSlant->"Italic"], "2"]], ",", "\[Ellipsis]"}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "005aa2f9-b4fa-482c-a084-07dfc68ad69c"],
 "."
}], "Notes",
 CellFrameLabels->{{Inherited, Inherited}, {Inherited, 
    Cell[
     TextData[{
      "26.09.30: Design review - the sign is exported because the products \
and the derivation extensions all sort with it, and the rule of the rewrite \
shares between exports only functions that are themselves exports with a \
mathematical name. One function with a parity argument serves both pictures, \
parity 0 for the graded symmetric sign of the symmetric product and parity 1 \
for the graded antisymmetric sign of the exterior product, rather than two \
functions; the signature is that of the engine's koszulSign[perm, degs, \
parity], which follows the Hypergraph clone. Before the tests were rewritten \
in R1 it was checked against the engine the verification suites load on every \
permutation to length 5, and T12/paclet-products-and-shift pins the two \
products that sort with it against the engine's odot and wedge. Prior art: \
the Wolfram Language has Signature, the sign of a permutation, which is the \
case of degrees 0 and parity 1; it has no graded version.", "\n\n", 
       Cell[
        BoxData[
         GridBox[{{
            Cell[
             BoxData[
              ButtonBox[
               DynamicBox[
                FEPrivate`FrontEndResource[
                "DocumentationToolsStrings", "Edit"]], BaseStyle -> 
               "TextAnnotationButton"]]], 
            StyleBox[
             RowBox[{
               DynamicBox[
                FEPrivate`FrontEndResource[
                "DocumentationToolsStrings", "LastAnnotator"]], "pavel"}], 
             "TextAnnotator"], 
            Cell[
             BoxData[
              ButtonBox[
               DynamicBox[
                FEPrivate`FrontEndResource[
                "DocumentationToolsStrings", "Delete"]], BaseStyle -> 
               "TextAnnotationRemoveButton"]]], ""}}, 
          GridBoxAlignment -> {
           "Columns" -> {Left, Left, Right, Right}, "Rows" -> {{Automatic}}}, 
          GridBoxItemSize -> {"Columns" -> {
              Scaled[0.15], 
              Scaled[0.68], 
              Scaled[0.15], 
              Scaled[0.02]}}]]], "\n"}], "TextAnnotation", 
     CellSize -> {590, Inherited}]}},
 CellTags->"TextAnnotation",
 CellID->549308192,ExpressionUUID->"29b025b3-bcfd-4240-b855-62332464c41f"],

Cell[TextData[{
 "The sign is ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"-", "1"}], ")"}], 
    StyleBox["N", "TI"]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "198dce69-4711-4b46-9255-b1ed2c604469"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["N", "TI"], "\[LongEqual]", "\[Sum]", 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox[
       StyleBox["d", "TI"], 
       SubscriptBox[
        StyleBox["perm",
         FontSlant->"Italic"], 
        StyleBox["i", "TI"]]], 
      SubscriptBox[
       StyleBox["d", "TI"], 
       SubscriptBox[
        StyleBox["perm",
         FontSlant->"Italic"], 
        StyleBox["j", "TI"]]], "+", 
      StyleBox["parity",
       FontSlant->"Italic"]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b5c066c5-9e2a-48a0-be63-ad3d2e2a5548"],
 ", the sum over the pairs ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["i", "TI"], "<", 
    StyleBox["j", "TI"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fa4008eb-ece8-457f-b735-740b146f944b"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["perm",
      FontSlant->"Italic"], 
     StyleBox["i", "TI"]], ">", 
    SubscriptBox[
     StyleBox["perm",
      FontSlant->"Italic"], 
     StyleBox["j", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7ae32c74-4849-459b-8978-6c60d8d4f5d3"],
 ", where ",
 Cell[BoxData[
  FormBox[
   StyleBox["d", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e1df9593-80d2-4d33-a711-b50368195bf0"],
 " is the list ",
 StyleBox["degrees", "TI"],
 "."
}], "Notes",ExpressionUUID->"e9c74afe-5acc-4de1-9f3d-39da860e07be"],

Cell[TextData[{
 "With ",
 StyleBox["parity", "TI"],
 " ",
 Cell[BoxData[
  FormBox["0", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "18504f1f-2c7f-4bbd-851a-6bdccadf8318"],
 " this is the graded symmetric Koszul sign. With ",
 StyleBox["parity", "TI"],
 " ",
 Cell[BoxData[
  FormBox["1", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ec5aff8e-8ee6-4635-a25a-fda649fd0598"],
 " it is the graded antisymmetric sign, the Koszul sign times the signature \
of the permutation."
}], "Notes",ExpressionUUID->"eb1d2668-74ab-4993-893b-a026c9cd956d"],

Cell[TextData[{
 StyleBox["degrees", "TI"],
 " may be longer than ",
 StyleBox["perm", "TI"],
 "; only the entries that ",
 StyleBox["perm", "TI"],
 " addresses take part."
}], "Notes",ExpressionUUID->"f3547641-f6da-4715-b025-904bc1ddb7d2"],

