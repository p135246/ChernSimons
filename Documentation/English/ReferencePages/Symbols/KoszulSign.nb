Cell[CellGroupData[{
Cell["KoszulSign", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"6b5f0a81-6617-482f-bdde-5682db4998e2"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["KoszulSign"]], "paclet:ChernSimons/ref/KoszulSign", 
     "ChernSimons Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["perm", "TI"], ",", " ", 
    StyleBox["degrees", "TI"], ",", " ", 
    StyleBox["parity", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "feb1432f-63c5-4d2c-96ab-20acd1b1e815"],
 "\[LineSeparator]",
 "gives the sign of bringing objects of the given ",
 StyleBox["degrees", "TI"],
 " into the order ",
 StyleBox["perm", "TI"],
 ", each pair that crosses contributing the product of their degrees plus ",
 StyleBox["parity", "TI"],
 " to the exponent of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", "1"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e98e2e3a-e84d-4042-9afa-a800ecfe1e36"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"a3442c92-61d5-437a-94a6-be68c5b15995"],

Cell[TextData[{
 StyleBox["perm", "TI"],
 " is a permutation given as a list of positions: the objects are brought \
into the order ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["o", "TI"], 
     SubscriptBox[
      StyleBox["perm",
       FontSlant->"Italic"], "1"]], ",", 
    SubscriptBox[
     StyleBox["o", "TI"], 
     SubscriptBox[
      StyleBox["perm",
       FontSlant->"Italic"], "2"]], ",", "\[Ellipsis]"}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "236eca5c-0513-41df-97b7-cee625bf62ba"],
 "."
}], "Notes",
 CellFrameLabels->{{Inherited, Inherited}, {Inherited, 
    Cell[
     TextData[{
      "26.09.30: Design review - the sign is exported because the products \
and the derivation extensions all sort with it, and the rule of the rewrite \
shares between exports only functions that are themselves exports with a \
mathematical name. One function with a parity argument serves both pictures, \
parity 0 for the graded symmetric sign of the symmetric product and parity 1 \
for the graded antisymmetric sign of the exterior product, rather than two \
functions; the signature is that of the engine's koszulSign[perm, degs, \
parity], which follows the Hypergraph clone. Before the tests were rewritten \
in R1 it was checked against the engine the verification suites load on every \
permutation to length 5, and T12/paclet-products-and-shift pins the two \
products that sort with it against the engine's odot and wedge. Prior art: \
the Wolfram Language has Signature, the sign of a permutation, which is the \
case of degrees 0 and parity 1; it has no graded version.", "\n\n", 
       Cell[
        BoxData[
         GridBox[{{
            Cell[
             BoxData[
              ButtonBox[
               DynamicBox[
                FEPrivate`FrontEndResource[
                "DocumentationToolsStrings", "Edit"]], BaseStyle -> 
               "TextAnnotationButton"]]], 
            StyleBox[
             RowBox[{
               DynamicBox[
                FEPrivate`FrontEndResource[
                "DocumentationToolsStrings", "LastAnnotator"]], "pavel"}], 
             "TextAnnotator"], 
            Cell[
             BoxData[
              ButtonBox[
               DynamicBox[
                FEPrivate`FrontEndResource[
                "DocumentationToolsStrings", "Delete"]], BaseStyle -> 
               "TextAnnotationRemoveButton"]]], ""}}, 
          GridBoxAlignment -> {
           "Columns" -> {Left, Left, Right, Right}, "Rows" -> {{Automatic}}}, 
          GridBoxItemSize -> {"Columns" -> {
              Scaled[0.15], 
              Scaled[0.68], 
              Scaled[0.15], 
              Scaled[0.02]}}]]], "\n"}], "TextAnnotation", 
     CellSize -> {590, Inherited}]}},
 CellTags->"TextAnnotation",
 CellID->478602312,ExpressionUUID->"3c0b9f7d-7608-4c49-8dff-a0383c2162d3"],

Cell[TextData[{
 "The sign is ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"-", "1"}], ")"}], 
    StyleBox["N", "TI"]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "882b0672-61a7-4487-ae6b-bb2fd222f398"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["N", "TI"], "\[LongEqual]", "\[Sum]", 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox[
       StyleBox["d", "TI"], 
       SubscriptBox[
        StyleBox["perm",
         FontSlant->"Italic"], 
        StyleBox["i", "TI"]]], 
      SubscriptBox[
       StyleBox["d", "TI"], 
       SubscriptBox[
        StyleBox["perm",
         FontSlant->"Italic"], 
        StyleBox["j", "TI"]]], "+", 
      StyleBox["parity",
       FontSlant->"Italic"]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "60731290-657c-4b08-8655-e2a0c2dec804"],
 ", the sum over the pairs ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["i", "TI"], "<", 
    StyleBox["j", "TI"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ae36c312-4155-4b0a-878b-fb7ca2f52aa2"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["perm",
      FontSlant->"Italic"], 
     StyleBox["i", "TI"]], ">", 
    SubscriptBox[
     StyleBox["perm",
      FontSlant->"Italic"], 
     StyleBox["j", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4dae8f3c-2e81-4d85-8d82-d4c203722481"],
 ", where ",
 Cell[BoxData[
  FormBox[
   StyleBox["d", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a9bb9488-f100-4909-a407-0c93b1e38d4d"],
 " is the list ",
 StyleBox["degrees", "TI"],
 "."
}], "Notes",ExpressionUUID->"20cb3aff-d042-47ca-9a65-8adaeb9f1958"],

Cell[TextData[{
 "With ",
 StyleBox["parity", "TI"],
 " ",
 Cell[BoxData[
  FormBox["0", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "49c6e08d-2709-4c3d-92da-de607c650886"],
 " this is the graded symmetric Koszul sign. With ",
 StyleBox["parity", "TI"],
 " ",
 Cell[BoxData[
  FormBox["1", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "04eef5ef-a818-4323-8bc6-12d4a2796154"],
 " it is the graded antisymmetric sign, the Koszul sign times the signature \
of the permutation."
}], "Notes",ExpressionUUID->"9892849e-a092-4336-b2a0-00d7748d6fd7"],

Cell[TextData[{
 StyleBox["degrees", "TI"],
 " may be longer than ",
 StyleBox["perm", "TI"],
 "; only the entries that ",
 StyleBox["perm", "TI"],
 " addresses take part."
}], "Notes",ExpressionUUID->"848eee05-7439-495e-9072-c086528374a1"],

