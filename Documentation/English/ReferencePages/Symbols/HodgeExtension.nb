  TemplateBox[{
    Cell[
     TextData["Failure"]], "paclet:ref/Failure"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "e15cb1bc-dadf-4ca5-b640-224cde8fd17d"],
 " naming the degree:"
}], "ExampleText",ExpressionUUID->"b9c92d39-2613-4591-adad-beaf4beb31c7"],

