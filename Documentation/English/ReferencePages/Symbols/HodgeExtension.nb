     StyleBox["V", "TI"], "1"], 
    SuperscriptBox[
     StyleBox["H", "TI"], "2"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5e9df7a2-14b2-4e4f-94ad-f3e33e3a8df1"],
