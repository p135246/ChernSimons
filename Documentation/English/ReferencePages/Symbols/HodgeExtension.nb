    Cell[
     TextData["SullivanModel"]], "paclet:ChernSimons/ref/SullivanModel", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "7f12ec95-2d9e-492e-b3ec-479876a10afe"],
 " \[FilledVerySmallSquare] ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CochainComplexWithPairing"]], 
