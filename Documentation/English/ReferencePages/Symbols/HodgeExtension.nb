Cell[TextData[{
 "On the model of the Kodaira-Thurston nilmanifold every element of degree ",
 Cell[BoxData[
  FormBox["3", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "f88f750e-1d71-419a-b87e-195ad242cf42"],
 " is closed, so no coexact part of degree ",
 Cell[BoxData[
  FormBox["3", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "0585f4f7-9643-48bb-991e-b6b2697f6d61"],
 " contains ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["V", "TI"], "1"], 
    SuperscriptBox[
     StyleBox["H", "TI"], "2"]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"f31d41ab-ea0d-49eb-bac7-f35ca6e5c8a8"],
 ", and the step in the middle degree gives a ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Failure"]], "paclet:ref/Failure"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "b49721db-a9f0-48e6-8e8e-fab8d5cf5dbc"],
 " naming the degree:"
}], "ExampleText",ExpressionUUID->"434945b3-81da-412d-a3fb-f8ab63ddd9a8"],

