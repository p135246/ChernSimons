Cell[TextData[{
 "The coexact part of degree ",
 Cell[BoxData[
  FormBox["2", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "06296a45-9e46-4410-8e54-efb54e44b721"],
 " of its Hodge decomposition is the graph of ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{"\[Mu]", 
     RowBox[{"(", 
      StyleBox["a", "TI"], ")"}], "\[LongEqual]", 
     RowBox[{"-", "1"}]}], 
    RowBox[{"2", 
     RowBox[{"\[LeftAngleBracket]", 
      RowBox[{
       StyleBox["a", "TI"], ",", 
       StyleBox["a", "TI"]}], "\[RightAngleBracket]"}], 
     SubscriptBox[
      StyleBox["y", "TI"], "1"]}]], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"8df377fe-74e8-4004-88c4-1753b1f0fcf8"],
 ":"
}], "ExampleText",ExpressionUUID->"cc1bcf66-b4ed-4a62-aeaf-7f2e1cdb7dfa"],

