  "578bff8a-41e4-4ed0-bd95-24cfd8ba485c"],
 " in that order, and the truncation of the model."
}], "Notes",ExpressionUUID->"61a64d46-38eb-413d-a204-43a1060bd0fc"],

Cell[TextData[{
 "A ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CochainComplexWithPairing"]], 
    "paclet:ChernSimons/ref/CochainComplexWithPairing", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "6efe6f5a-069c-4901-be27-95722a811cad"],
 " with a product comes back as the complex of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["V", "TI"], "\[CircleTimes]", "\[CapitalLambda]"}], 
   TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fc7917ca-a84d-4720-8060-1adfc2c6bd8a"],
 " up to degree ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["n", "TI"], "+", "1"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "aecea690-e527-41d0-986d-3bfe0f613069"],
 " with the image of ",
 Cell[BoxData[
  FormBox[
   StyleBox["d",
    FontSlant->"Plain"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fa4ae080-2ba2-4582-a6b0-006daab92030"],
 " in degree ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["n", "TI"], "+", "2"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9c88eede-646c-4886-8571-694b56941a5d"],
 ", as ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["CochainComplexWithPairing"]], 
     "paclet:ChernSimons/ref/CochainComplexWithPairing", 
     "ChernSimons Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["model", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7c4bd057-a386-4e81-a90f-3bd4133e847e"],
 " is for a model."
}], "Notes",ExpressionUUID->"583aa6cc-7a47-46e2-9094-60657995d0b5"],

Cell[TextData[{
 "A ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CochainComplexWithPairing"]], 
    "paclet:ChernSimons/ref/CochainComplexWithPairing", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "5a78d329-de37-40d8-97bb-e6f6d4f46ea5"],
 " without a product comes back as ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["V", "TI"], "\[CirclePlus]", 
    StyleBox["span",
     FontSlant->"Plain"], 
    RowBox[{"{", 
     RowBox[{
      SubscriptBox[
       StyleBox["x", "TI"], "\[Alpha]"], ",", 
      SubscriptBox[
       StyleBox["y", "TI"], "\[Alpha]"]}], "}"}]}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bd12a58a-288f-4898-856d-f467f875b178"],
 ", the pairing of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["x", "TI"], "\[Alpha]"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a87c6b31-dccc-451a-b4ab-4caa2490df8c"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["y", "TI"], "\[Alpha]"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bea19102-99e4-4704-80b4-de543bdc4086"],
 " with ",
 Cell[BoxData[
  FormBox[
   StyleBox["V", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5df6e2c6-cf70-40be-a240-16f52fa4ae27"],
 " given by the same formulas with ",
 Cell[BoxData[
  FormBox[
   StyleBox["v", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d1b174e2-f0c0-47d0-870f-dd3ab3907ae7"],
 " in place of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["x", "TI"], "\[Alpha]"], 
    StyleBox["v", "TI"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ccf11f53-aa61-4291-91d1-fac1043f70fa"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["y", "TI"], "\[Alpha]"], 
    StyleBox["v", "TI"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9eb42707-2b67-4b21-8b73-4db214a65376"],
 "."
}], "Notes",ExpressionUUID->"ae51c15d-0a2a-44e2-8014-25542ab23be1"],

Cell[TextData[{
 "Above the middle degree, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["k", "TI"], ">", 
    StyleBox["n", "TI"], "/", "2"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2668e269-575b-4a3d-92c2-425a3a04ab67"],
 ", the map ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Mu]", 
    RowBox[{"(", 
     StyleBox["u", "TI"], ")"}], "\[LongEqual]", "-", 
    UnderscriptBox["\[Sum]", "\[Alpha]",
     LimitsPositioning->True], 
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{
      StyleBox["u", "TI"], ",", 
      SubscriptBox[
       StyleBox["c", "TI"], "\[Alpha]"]}], "\[RightAngleBracket]"}], 
    SubscriptBox[
     StyleBox["y", "TI"], "\[Alpha]"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d9a43ec6-7f60-47e7-b2da-a4f6a336a1cc"],
 " on the coexact part of degree ",
 Cell[BoxData[
  FormBox[
   StyleBox["k", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d31b251f-8c46-4551-aa63-0d3392d37ad8"],
 " satisfies the Hodge twist condition ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{
      StyleBox["u", "TI"], "+", "\[Mu]", 
      StyleBox["u", "TI"], ",", 
      SubscriptBox[
       StyleBox["c", "TI"], "\[Beta]"]}], "\[RightAngleBracket]"}], "\[LongEqual]",
     "0"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1e698270-84a3-4d86-8703-f672ea5ddd35"],
 " (arXiv:2609.14221, Remark 2.2). If ",
 StyleBox["space", "TI"],
 " is of Hodge type in the degrees ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["n", "TI"], "-", 
    StyleBox["k", "TI"], "+", "1"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4ed2de84-85b2-447b-b534-c2b6289b1ae3"],
 " to ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["k", "TI"], "-", "1"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f1828cb7-77d4-449a-b467-c32078420cd1"],
 ", the extension is of Hodge type in the degrees ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["n", "TI"], "-", 
    StyleBox["k", "TI"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d237dc68-409f-48e7-9f5b-a7af2e2070ba"],
 " to ",
 Cell[BoxData[
  FormBox[
   StyleBox["k", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2395ba4b-61ff-40c9-9bb1-ad87dec4fbce"],
 " (arXiv:2004.07362, Lemma 4.8)."
}], "Notes",ExpressionUUID->"ba2cc252-a225-4302-97e9-4fc913e4483b"],

Cell[TextData[{
 "The step in degree ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["n", "TI"], "/", "2", "+", "1"}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "50aa3f8b-bf66-44ee-aa5b-dc9859e4c8e5"],
 " reads the middle degree through its Hodge decomposition, the graph of the \
twist ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindHodgeDecomposition"]], 
    "paclet:ChernSimons/ref/FindHodgeDecomposition", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "308826a9-d9bb-4ebe-bca6-c95cff0c832c"],
 " finds there (arXiv:2004.07362, Lemma 4.8), and gives the ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Failure"]], "paclet:ref/Failure"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "a34e1d0d-17e8-4f8c-957a-6b4b648ebc43"],
 " of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindHodgeDecomposition"]], 
    "paclet:ChernSimons/ref/FindHodgeDecomposition", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "0aeef204-cf31-4913-9505-1d749566c97e"],
 " when there is none."
}], "Notes",ExpressionUUID->"0274faf1-ea9b-4ce5-9106-f5002d1c2a81"],

Cell[TextData[{
 "In the middle degree, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["n", "TI"], "\[LongEqual]", "2", 
    StyleBox["m", "TI"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "90aa3dfc-0ff6-42c6-871c-7cb27dd5df80"],
 ", the map ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Mu]", 
    RowBox[{"(", 
     RowBox[{
      StyleBox["c", "TI"], "+", 
      StyleBox["z", "TI"]}], ")"}], "\[LongEqual]", "-", 
    UnderscriptBox["\[Sum]", "\[Alpha]",
     LimitsPositioning->True], 
    RowBox[{"\[LeftAngleBracket]", 
     FractionBox["1", 
      RowBox[{"2", 
       StyleBox["c", "TI"], "+", 
       StyleBox["z", "TI"], ",", 
       SubscriptBox[
        StyleBox["c", "TI"], "\[Alpha]"]}]], "\[RightAngleBracket]"}], 
    SubscriptBox[
     StyleBox["y", "TI"], "\[Alpha]"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ced5fdac-79e9-4c55-8c5f-8d83a161233e"],
 " on ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     OverscriptBox[
      StyleBox["C", "TI"], "^"], 
     StyleBox["m", "TI"]], "\[LongEqual]", 
    SuperscriptBox[
     StyleBox["C", "TI"], 
     StyleBox["m", "TI"]], "\[CirclePlus]", 
    StyleBox["Z", "TI"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "94c51a79-bd6e-4867-b99c-11776d5144a9"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["Z", "TI"], "\[LongEqual]", 
    StyleBox["X", "TI"], "\[CenterDot]", 
    SuperscriptBox[
     StyleBox["V", "TI"], "1"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2628ce1d-3b45-4c4f-8115-88fce8d86f1b"],
 ", satisfies the middle-degree twist condition, so the extension is of Hodge \
type in degree ",
 Cell[BoxData[
  FormBox[
   StyleBox["m", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "31791f50-798b-4722-84b5-aeeffe5952bd"],
 " (arXiv:2609.14221, Proposition 2.1)."
}], "Notes",ExpressionUUID->"c2deb54c-0eb6-4691-acdc-623a83c3f9ab"],

Cell[TextData[{
 "The middle step needs the adaptedness condition ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["V", "TI"], "1"], 
    SuperscriptBox[
     StyleBox["H", "TI"], 
     StyleBox["m", "TI"]], "\[Subset]", 
    SuperscriptBox[
     StyleBox["C", "TI"], 
     RowBox[{
      StyleBox["m", "TI"], "+", "1"}]]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d2f987d6-c2fd-4b73-b02d-b891474c467b"],
 ". It takes a coexact part of degree ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["m", "TI"], "+", "1"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cbdcca9a-c7e4-46a7-8a96-cb622ddf07ba"],
 " that contains ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["V", "TI"], "1"], 
    SuperscriptBox[
     StyleBox["H", "TI"], 
     StyleBox["m", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9e56a3a7-38d4-45b3-bd92-657f6acf7265"],
 ", which exists exactly when ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["V", "TI"], "1"], 
    SuperscriptBox[
     StyleBox["H", "TI"], 
     StyleBox["m", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cd299cd2-8651-4e46-93e0-d3b5934c9297"],
 " meets the cocycles only in ",
 Cell[BoxData[
  FormBox["0", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a79901ef-dc00-4d07-9675-d7817a311c23"],
 " and is perpendicular to ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["H", "TI"], 
    RowBox[{
     StyleBox["m", "TI"], "-", "1"}]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "19138590-38a6-4adc-bf4b-43c0c8ea6827"],
 ". Otherwise the result is a ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Failure"]], "paclet:ref/Failure"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "213729b9-2771-49ad-b596-ea59fd85139d"],
 " whose ",
 Cell[BoxData["\"\<Degrees\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7cf8d63e-3939-4f2e-aff2-eacca2bd6c3f"],
 " are ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    StyleBox["m", "TI"], "}"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d5e0bb96-36fd-4b48-a5ee-8fa0bf758242"],
 ". When ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["V", "TI"], "1"], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cd19ee75-ffb6-4e1f-a652-c018425066e4"],
 " the condition is empty."
}], "Notes",ExpressionUUID->"43428f3d-09bf-42a5-be88-b901cc48e26b"],

Cell[TextData[{
 "When ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["C", "TI"], 
     RowBox[{
      StyleBox["n", "TI"], "-", 
      StyleBox["k", "TI"]}]], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bbd98f05-d355-4b33-9b9b-88f0e59334f0"],
 " the step adjoins nothing, and ",
 StyleBox["space", "TI"],
 " comes back unchanged."
}], "Notes",ExpressionUUID->"0422947a-73be-4bdb-a493-64db7bf38810"],

Cell[TextData[{
 "The full extension takes the middle step when ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b482dd45-29ed-40d9-b906-db1dda54b810"],
 " is even and the middle degree has no Hodge decomposition, and then the \
steps ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["k", "TI"], "\[LongEqual]", 
    RowBox[{"\[LeftFloor]", 
     RowBox[{
      StyleBox["n", "TI"], "/", "2"}], "\[RightFloor]"}], "+", "1", ",", 
    "\[Ellipsis]", ",", 
    StyleBox["n", "TI"], "-", "1"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f4a1edba-1e7d-4ce0-8eaa-c41fd875bbe7"],
 " in this order, each on the result of the one before. For a connected space \
of finite type with Poincare duality on cohomology the result is of Hodge \
type (arXiv:2609.14221, Proposition 2.1 and Remark 2.2; arXiv:2004.07362, \
Proposition 4.13)."
}], "Notes",ExpressionUUID->"7c36411a-ca98-4024-8ec8-2c8c3328d978"],

Cell[TextData[{
 "A space of Hodge type is extended too. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["HodgeTypeQ"]], "paclet:ChernSimons/ref/HodgeTypeQ", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "a8ee55d5-7840-4e95-9340-fada517ce4c9"],
 " decides Hodge type without extending."
}], "Notes",ExpressionUUID->"8f91ff90-6593-4011-9312-1605d964eb62"],

Cell[TextData[{
 "When ",
 StyleBox["space", "TI"],
 " has no pre-Hodge decomposition, the result is the ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Failure"]], "paclet:ref/Failure"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "b0b81af7-06a7-4aa2-858b-f62de60df02c"],
 " of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindPreHodgeDecomposition"]], 
    "paclet:ChernSimons/ref/FindPreHodgeDecomposition", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "eeb59ef7-d579-4b8d-8595-5d5e276c4999"],
 ", with its tag."
}], "Notes",ExpressionUUID->"ce1f336a-6bc6-421a-b6cd-9cb2ac6d0ea5"],

Cell[TextData[{
 "For ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["n", "TI"], "\[LongEqual]", "2"}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "34d17acb-8924-4bad-906f-0691ec6ce467"],
 " there is no middle step, and a space whose degree ",
 Cell[BoxData[
  FormBox["1", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a8ed8109-86aa-4192-8d81-280b3fc4d05c"],
 " has no Hodge decomposition gives the ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Failure"]], "paclet:ref/Failure"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "2b836cd1-cc7a-41dd-815a-7c28015773cd"],
 " of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindHodgeDecomposition"]], 
    "paclet:ChernSimons/ref/FindHodgeDecomposition", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "6235adb0-d9bc-4e81-9b77-57cda66c1bff"],
 "."
}], "Notes",ExpressionUUID->"1968cb75-2bcf-449b-9c04-d49b70966171"],

Cell[TextData[{
 "A degree ",
 Cell[BoxData[
  FormBox[
   StyleBox["k", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "978670a7-c9ea-4692-a32d-b70c1f79293f"],
 " below ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["n", "TI"], "/", "2"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1b3b4ef0-80fe-4d79-8465-04ca2295e6f8"],
 " or above ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f5526e67-b669-410c-bacd-4b2b837d0827"],
 ", or ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["k", "TI"], "\[LongEqual]", "1"}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e38b884c-7619-4e14-8dab-ba3e2ddf15fb"],
 ", returns unevaluated, and so does a complex with a product but without the \
unit ",
 Cell[BoxData[
  FormBox["1", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f796c1eb-af00-4f54-9217-79d27915f598"],
 "."
}], "Notes",ExpressionUUID->"cb9aeee0-95d0-4945-a3cd-c1d76b62d1ae"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "See Also",
 Cell[BoxData[
  TemplateBox[{"SeeAlso", 
    Cell[
     BoxData[
      FrameBox[
       Cell[
       "Insert links to any related reference (function) pages.", 
        "MoreInfoText"], BaseStyle -> "IFrameBox"]], "MoreInfoTextOuter"]},
   "MoreInfoOpenerButtonTemplate"]],ExpressionUUID->
  "b7caa910-e086-4d39-871e-e78bfb02a4b9"]
}], "SeeAlsoSection",
 CellID->1559318232,ExpressionUUID->"6019c63b-8124-433f-bd7e-253812d6da0e"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["HodgeTypeQ"]], "paclet:ChernSimons/ref/HodgeTypeQ", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "0a0e0501-e93f-40fc-8b84-0ff43ab05026"],
 " \[FilledVerySmallSquare] ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindHodgeDecomposition"]], 
    "paclet:ChernSimons/ref/FindHodgeDecomposition", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "bbde730f-00cc-49e9-aae1-8f4a1dbf3125"],
 " \[FilledVerySmallSquare] ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindPreHodgeDecomposition"]], 
    "paclet:ChernSimons/ref/FindPreHodgeDecomposition", 
    "ChernSimons Package Symbol"},
   "PackageLink",
