       StyleBox["a", "TI"], "-", "1"}], 
      RowBox[{"2", 
       SubscriptBox[
        StyleBox["y", "TI"], "1"]}]], ")"}], "+", 
    StyleBox["d",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     FractionBox["1", 
      RowBox[{"2", 
       SubscriptBox[
        StyleBox["x", "TI"], "1"]}]], ")"}]}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"cb369ebd-6aaf-46de-91d5-1c554817fe05"],
 " through the Hodge decomposition of the middle degree:"
}], "ExampleText",ExpressionUUID->"98ce46b5-90c5-472a-ace5-38477ef81308"],

