Cell[TextData[{
 "The coexact part of degree ",
 Cell[BoxData[
  FormBox["2", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ddb62652-1cb2-4b72-bb2d-0dbb55b99b20"],
 " of its Hodge decomposition is the graph of ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{"\[Mu]", 
     RowBox[{"(", 
      StyleBox["a", "TI"], ")"}], "\[LongEqual]", 
     RowBox[{"-", "1"}]}], 
    RowBox[{"2", 
     RowBox[{"\[LeftAngleBracket]", 
      RowBox[{
       StyleBox["a", "TI"], ",", 
       StyleBox["a", "TI"]}], "\[RightAngleBracket]"}], 
     SubscriptBox[
      StyleBox["y", "TI"], "1"]}]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f32bc15a-d234-42a0-af61-dc41066511ac"],
 ":"
}], "ExampleText",ExpressionUUID->"15b7ce28-f180-4de5-99ca-3507934d45fe"],

