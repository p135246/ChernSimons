 Cell[BoxData[
  FormBox["3", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "c60ffe51-3959-4b58-a4d6-fdf22e88dd6e"],
 " is closed, so no coexact part of degree ",
 Cell[BoxData[
  FormBox["3", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "256eb51c-cf35-4222-94a0-121a9078c7a9"],
 " contains ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["V", "TI"], "1"], 
    SuperscriptBox[
     StyleBox["H", "TI"], "2"]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"c5fefb73-3f6f-4e3d-9202-116be3de13e9"],
 ", and the step in the middle degree gives a ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Failure"]], "paclet:ref/Failure"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "c2012e0c-87eb-467f-bae7-05b25a34fca6"],
 " naming the degree:"
}], "ExampleText",ExpressionUUID->"32fabf59-67ec-4c55-9fc1-bf02935fe2c2"],

