Cell[TextData[{
 "The second step reads ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["a", "TI"], "\[LongEqual]", 
    RowBox[{"(", 
     FractionBox[
      RowBox[{
       StyleBox["a", "TI"], "-", "1"}], 
