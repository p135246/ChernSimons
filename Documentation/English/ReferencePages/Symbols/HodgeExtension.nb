Cell[TextData[{
 "The coexact part of degree ",
 Cell[BoxData[
  FormBox["2", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "291eb3be-6d45-41ba-926d-6b901fda873e"],
 " of its Hodge decomposition is the graph of ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{"\[Mu]", 
     RowBox[{"(", 
      StyleBox["a", "TI"], ")"}], "\[LongEqual]", 
     RowBox[{"-", "1"}]}], 
    RowBox[{"2", 
     RowBox[{"\[LeftAngleBracket]", 
      RowBox[{
       StyleBox["a", "TI"], ",", 
       StyleBox["a", "TI"]}], "\[RightAngleBracket]"}], 
     SubscriptBox[
      StyleBox["y", "TI"], "1"]}]], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"4defb9cb-4fc6-4058-8f69-50cbbabd1c03"],
 ":"
}], "ExampleText",ExpressionUUID->"3669d431-e55f-4fa0-9b7e-3d94a6810280"],

