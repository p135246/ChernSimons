    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["model", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "aa9a894b-634e-4405-bc4c-cbbcb2141b73"],
 " is for a model."
}], "Notes",ExpressionUUID->"84685d92-4fa9-4b6f-a41f-36e3c66a1637"],

Cell[TextData[{
 "A ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CochainComplexWithPairing"]], 
    "paclet:ChernSimons/ref/CochainComplexWithPairing", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "c907ecdd-c0e5-4f90-878c-609d5d5880aa"],
 " without a product comes back as ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["V", "TI"], "\[CirclePlus]", 
    StyleBox["span",
     FontSlant->"Plain"], 
    RowBox[{"{", 
     RowBox[{
      SubscriptBox[
       StyleBox["x", "TI"], "\[Alpha]"], ",", 
      SubscriptBox[
       StyleBox["y", "TI"], "\[Alpha]"]}], "}"}]}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"ea43fe45-92a4-420d-b96c-f347d139f3ec"],
 ", the pairing of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["x", "TI"], "\[Alpha]"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"1e151949-896a-4ad2-8b2e-a0c34a6a5408"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["y", "TI"], "\[Alpha]"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"96a2f873-ed7d-4dcd-a4ce-fcc031f0d2f4"],
 " with ",
 Cell[BoxData[
  FormBox[
   StyleBox["V", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "f318c9dc-6d16-443b-b1ae-8551b39bc2ac"],
 " given by the same formulas with ",
 Cell[BoxData[
  FormBox[
   StyleBox["v", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "dda3d81d-8cf9-421a-b36b-9e0e036e0bd6"],
 " in place of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["x", "TI"], "\[Alpha]"], 
    StyleBox["v", "TI"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "9e1f8a37-42e1-43e6-8fbc-76509dba497d"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["y", "TI"], "\[Alpha]"], 
    StyleBox["v", "TI"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "14a833d1-20d7-4334-9528-ba2056e1a00d"],
 "."
}], "Notes",ExpressionUUID->"bcce2a1b-e6b0-4d5f-9da6-cd872781cd83"],

Cell[TextData[{
 "Above the middle degree, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["k", "TI"], ">", 
    StyleBox["n", "TI"], "/", "2"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"e6735884-fcfd-426b-aa23-0f32a643eced"],
 ", the map ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Mu]", 
    RowBox[{"(", 
     StyleBox["u", "TI"], ")"}], "\[LongEqual]", "-", 
    UnderscriptBox["\[Sum]", "\[Alpha]",
     LimitsPositioning->True], 
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{
      StyleBox["u", "TI"], ",", 
      SubscriptBox[
       StyleBox["c", "TI"], "\[Alpha]"]}], "\[RightAngleBracket]"}], 
    SubscriptBox[
     StyleBox["y", "TI"], "\[Alpha]"]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"f365f77e-6bac-4a23-ab05-b68ef0bce897"],
 " on the coexact part of degree ",
 Cell[BoxData[
  FormBox[
   StyleBox["k", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "795d1d41-b2d6-489b-9e63-bc42235f4068"],
 " satisfies the Hodge twist condition ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{
      StyleBox["u", "TI"], "+", "\[Mu]", 
      StyleBox["u", "TI"], ",", 
      SubscriptBox[
       StyleBox["c", "TI"], "\[Beta]"]}], "\[RightAngleBracket]"}], "\[LongEqual]",
     "0"}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "a00f7609-aa34-4d67-a452-73335ffba252"],
 " (arXiv:2609.14221, Remark 2.2). If ",
 StyleBox["space", "TI"],
 " is of Hodge type in the degrees ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["n", "TI"], "-", 
    StyleBox["k", "TI"], "+", "1"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"2aedfc14-8621-454b-b516-a4b22131d295"],
 " to ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["k", "TI"], "-", "1"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"0812012c-89d9-4a50-81f3-7829be0f6afe"],
 ", the extension is of Hodge type in the degrees ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["n", "TI"], "-", 
    StyleBox["k", "TI"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "1a51d76e-90d9-4f80-98aa-ce48b25e36ff"],
 " to ",
 Cell[BoxData[
  FormBox[
   StyleBox["k", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "0a720f9b-b735-4ae0-9875-c58bcda2f986"],
 " (arXiv:2004.07362, Lemma 4.8)."
}], "Notes",ExpressionUUID->"3273f371-5b49-4bd8-b28e-dc5c327c15e5"],

Cell[TextData[{
 "The step in degree ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["n", "TI"], "/", "2", "+", "1"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"a2f491eb-df19-4231-8a96-c80ab8084360"],
 " reads the middle degree through its Hodge decomposition, the graph of the \
twist ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindHodgeDecomposition"]], 
    "paclet:ChernSimons/ref/FindHodgeDecomposition", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "67ad9866-9fd1-4872-a41b-2bccfe1386a3"],
 " finds there (arXiv:2004.07362, Lemma 4.8), and gives the ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Failure"]], "paclet:ref/Failure"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "acfd69f8-59fb-476a-9ec0-9bfdbd729f2d"],
 " of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindHodgeDecomposition"]], 
    "paclet:ChernSimons/ref/FindHodgeDecomposition", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "6c8fff6d-d0af-4af4-b5bb-e5c87c6454ab"],
 " when there is none."
}], "Notes",ExpressionUUID->"1cabdfd1-17d8-4f98-a6f8-b4ad99ed5576"],

Cell[TextData[{
 "In the middle degree, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["n", "TI"], "\[LongEqual]", "2", 
    StyleBox["m", "TI"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "e16233dc-c532-420c-81f0-c3718509b4b1"],
 ", the map ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Mu]", 
    RowBox[{"(", 
     RowBox[{
      StyleBox["c", "TI"], "+", 
      StyleBox["z", "TI"]}], ")"}], "\[LongEqual]", "-", 
    UnderscriptBox["\[Sum]", "\[Alpha]",
     LimitsPositioning->True], 
    RowBox[{"\[LeftAngleBracket]", 
     FractionBox["1", 
      RowBox[{"2", 
       StyleBox["c", "TI"], "+", 
       StyleBox["z", "TI"], ",", 
       SubscriptBox[
        StyleBox["c", "TI"], "\[Alpha]"]}]], "\[RightAngleBracket]"}], 
    SubscriptBox[
     StyleBox["y", "TI"], "\[Alpha]"]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"cd51f11b-2dc0-4462-af84-2b3424f58367"],
 " on ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     OverscriptBox[
      StyleBox["C", "TI"], "^"], 
     StyleBox["m", "TI"]], "\[LongEqual]", 
    SuperscriptBox[
     StyleBox["C", "TI"], 
     StyleBox["m", "TI"]], "\[CirclePlus]", 
    StyleBox["Z", "TI"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "33d76bc2-178f-4e1e-8349-3fa7cc95fcdb"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["Z", "TI"], "\[LongEqual]", 
    StyleBox["X", "TI"], "\[CenterDot]", 
    SuperscriptBox[
     StyleBox["V", "TI"], "1"]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"8d952af5-6793-471f-ac3d-ca5422a90919"],
 ", satisfies the middle-degree twist condition, so the extension is of Hodge \
type in degree ",
 Cell[BoxData[
  FormBox[
   StyleBox["m", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "6f0b686e-1c86-4cd5-82ad-a87f82c942cb"],
 " (arXiv:2609.14221, Proposition 2.1)."
}], "Notes",ExpressionUUID->"f3d8453f-a075-43e9-af90-7a2051df84f3"],

Cell[TextData[{
 "The middle step needs the adaptedness condition ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["V", "TI"], "1"], 
    SuperscriptBox[
     StyleBox["H", "TI"], 
     StyleBox["m", "TI"]], "\[Subset]", 
    SuperscriptBox[
     StyleBox["C", "TI"], 
     RowBox[{
      StyleBox["m", "TI"], "+", "1"}]]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"c3ae4525-b272-4bb2-bb67-3123323d68d6"],
 ". It takes a coexact part of degree ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["m", "TI"], "+", "1"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"94d852de-cbdd-4f30-bde9-062984499191"],
 " that contains ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["V", "TI"], "1"], 
    SuperscriptBox[
     StyleBox["H", "TI"], 
     StyleBox["m", "TI"]]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"e53acac7-cc71-422c-975a-f084ea1baa45"],
 ", which exists exactly when ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["V", "TI"], "1"], 
    SuperscriptBox[
     StyleBox["H", "TI"], 
     StyleBox["m", "TI"]]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"f183dd23-f62e-4c4a-a4f0-c980336e276b"],
 " meets the cocycles only in ",
 Cell[BoxData[
  FormBox["0", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "7fe9fa31-3fba-4ddb-ace6-91bbbcb203ca"],
 " and is perpendicular to ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["H", "TI"], 
    RowBox[{
     StyleBox["m", "TI"], "-", "1"}]], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"341dca46-6364-454b-be16-59a1b2e7b8b8"],
 ". Otherwise the result is a ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Failure"]], "paclet:ref/Failure"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "1166cc2b-98c1-47a9-bf81-6cf7aaddec79"],
 " whose ",
 Cell[BoxData["\"\<Degrees\>\""], "InlineFormula",ExpressionUUID->
  "f2bb71f7-0405-4c21-a8e8-ce3e47833c54"],
 " are ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    StyleBox["m", "TI"], "}"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"6d135438-9b58-4dcf-b882-df4ec44fa2c5"],
 ". When ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["V", "TI"], "1"], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"f98460d7-445a-4cbb-a5e1-c15c95405db8"],
 " the condition is empty."
}], "Notes",ExpressionUUID->"c6e2a041-052e-41cc-b0c8-d116c303b21e"],

Cell[TextData[{
 "When ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["C", "TI"], 
     RowBox[{
      StyleBox["n", "TI"], "-", 
      StyleBox["k", "TI"]}]], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"1e21d2e4-6e29-4e74-b8a6-e8dc185749ee"],
 " the step adjoins nothing, and ",
 StyleBox["space", "TI"],
 " comes back unchanged."
}], "Notes",ExpressionUUID->"637a5d14-ecf0-48b1-8159-27ca693550a1"],

Cell[TextData[{
 "The full extension takes the middle step when ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "11061a36-3a81-4d20-977c-92d98ed46cb8"],
 " is even and the middle degree has no Hodge decomposition, and then the \
steps ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["k", "TI"], "\[LongEqual]", 
    RowBox[{"\[LeftFloor]", 
     RowBox[{
      StyleBox["n", "TI"], "/", "2"}], "\[RightFloor]"}], "+", "1", ",", 
    "\[Ellipsis]", ",", 
    StyleBox["n", "TI"], "-", "1"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"1dc73c59-e648-4b8d-9d72-5e0c91a073ef"],
 " in this order, each on the result of the one before. For a connected space \
of finite type with Poincare duality on cohomology the result is of Hodge \
type (arXiv:2609.14221, Proposition 2.1 and Remark 2.2; arXiv:2004.07362, \
Proposition 4.13)."
}], "Notes",ExpressionUUID->"a4448fba-480d-4479-a92a-c8de7c01cc6e"],

Cell[TextData[{
 "A space of Hodge type is extended too. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["HodgeTypeQ"]], "paclet:ChernSimons/ref/HodgeTypeQ", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "de67bd1a-8c2b-42e0-920f-6d04d0e5c974"],
 " decides Hodge type without extending."
}], "Notes",ExpressionUUID->"cd01d946-11d1-4bf5-9cd1-458875590ccb"],

Cell[TextData[{
 "When ",
 StyleBox["space", "TI"],
 " has no pre-Hodge decomposition, the result is the ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Failure"]], "paclet:ref/Failure"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "4c82e959-c1b3-473c-a909-a87b5d1c00a8"],
 " of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindPreHodgeDecomposition"]], 
    "paclet:ChernSimons/ref/FindPreHodgeDecomposition", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "dc965522-3bdd-4c7a-b4ab-a9f1470ae779"],
 ", with its tag."
}], "Notes",ExpressionUUID->"82ef3b71-f51d-401e-99cf-41c2b4557bb3"],

Cell[TextData[{
 "For ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["n", "TI"], "\[LongEqual]", "2"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"40e2e505-1712-4f9f-b7eb-9c9a53b4d294"],
 " there is no middle step, and a space whose degree ",
 Cell[BoxData[
  FormBox["1", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "4de0c1b1-64db-4a0e-b914-283b34990c0e"],
 " has no Hodge decomposition gives the ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Failure"]], "paclet:ref/Failure"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "46b9a6b2-fee8-4d1b-bab3-ee22df30efdd"],
 " of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindHodgeDecomposition"]], 
    "paclet:ChernSimons/ref/FindHodgeDecomposition", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "71ffc375-89d2-4aca-a2fd-5722ceae8437"],
 "."
}], "Notes",ExpressionUUID->"342f44be-df4f-443d-a4d1-c81512893a78"],

Cell[TextData[{
 "A degree ",
 Cell[BoxData[
  FormBox[
   StyleBox["k", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "026b47fb-e23d-4ad0-a47e-42789fca0599"],
 " below ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["n", "TI"], "/", "2"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"a6380e68-096a-4285-bada-4de2493e9e59"],
 " or above ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "1b3cf83c-5ada-4a59-b021-5356b3be1e00"],
 ", or ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["k", "TI"], "\[LongEqual]", "1"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"fee91c0c-b5b6-4062-a106-5fa7f4d70427"],
 ", returns unevaluated, and so does a complex with a product but without the \
unit ",
 Cell[BoxData[
  FormBox["1", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "a94462ca-8f7e-406f-990f-f3a73c2b1ab1"],
 "."
}], "Notes",ExpressionUUID->"f516b84c-3b0e-416c-a5f1-b6fe26f903fb"]
}, Open  ]],

