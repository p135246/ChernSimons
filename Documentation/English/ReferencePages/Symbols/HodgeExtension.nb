      TextData["CochainComplexWithPairing"]], 
     "paclet:ChernSimons/ref/CochainComplexWithPairing", 
     "ChernSimons Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["model", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "a5c6b493-7dee-4659-aa13-0390d92c1c11"],
 " is for a model."
}], "Notes",ExpressionUUID->"1d8256b8-e394-4b72-8dcc-08f0e969e69c"],

Cell[TextData[{
 "A ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CochainComplexWithPairing"]], 
    "paclet:ChernSimons/ref/CochainComplexWithPairing", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "0ce12c77-d083-4c25-a9ec-c242ed942309"],
 " without a product comes back as ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["V", "TI"], "\[CirclePlus]", 
    StyleBox["span",
     FontSlant->"Plain"], 
    RowBox[{"{", 
     RowBox[{
      SubscriptBox[
       StyleBox["x", "TI"], "\[Alpha]"], ",", 
      SubscriptBox[
       StyleBox["y", "TI"], "\[Alpha]"]}], "}"}]}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"cca11686-a2e9-44c9-ada4-d5256f50c453"],
 ", the pairing of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["x", "TI"], "\[Alpha]"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"5753614b-895f-4385-968d-096d8c38c110"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["y", "TI"], "\[Alpha]"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"6014a6c5-a252-419c-8439-b44d9aea0a44"],
 " with ",
 Cell[BoxData[
  FormBox[
   StyleBox["V", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "fd35fc45-f3be-473d-b19a-b8c15c76e0b4"],
 " given by the same formulas with ",
 Cell[BoxData[
  FormBox[
   StyleBox["v", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "1f1b43d1-da08-4878-9ddc-a5f674c74a8f"],
 " in place of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["x", "TI"], "\[Alpha]"], 
    StyleBox["v", "TI"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "4d28c683-ca38-4644-951e-9357615770cb"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["y", "TI"], "\[Alpha]"], 
    StyleBox["v", "TI"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "2f3e308f-aa18-4d6f-a774-0aeb5667b4b8"],
 "."
}], "Notes",ExpressionUUID->"681f4a7b-6d94-4ea6-8105-890d83b83224"],

Cell[TextData[{
 "Above the middle degree, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["k", "TI"], ">", 
    StyleBox["n", "TI"], "/", "2"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"76140eb7-b585-47ce-85ef-6748cbc5305f"],
 ", the map ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Mu]", 
    RowBox[{"(", 
     StyleBox["u", "TI"], ")"}], "\[LongEqual]", "-", 
    UnderscriptBox["\[Sum]", "\[Alpha]",
     LimitsPositioning->True], 
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{
      StyleBox["u", "TI"], ",", 
      SubscriptBox[
       StyleBox["c", "TI"], "\[Alpha]"]}], "\[RightAngleBracket]"}], 
    SubscriptBox[
     StyleBox["y", "TI"], "\[Alpha]"]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"10eea973-5902-46cb-a96a-fb806785b9d7"],
 " on the coexact part of degree ",
 Cell[BoxData[
  FormBox[
   StyleBox["k", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "9cf3fe05-421c-4386-bd36-8064fcf65e67"],
 " satisfies the Hodge twist condition ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{
      StyleBox["u", "TI"], "+", "\[Mu]", 
      StyleBox["u", "TI"], ",", 
      SubscriptBox[
       StyleBox["c", "TI"], "\[Beta]"]}], "\[RightAngleBracket]"}], "\[LongEqual]",
     "0"}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "2da2ed31-c0c3-456d-a8dc-2348ca14de9f"],
 " (arXiv:2609.14221, Remark 2.2). If ",
 StyleBox["space", "TI"],
 " is of Hodge type in the degrees ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["n", "TI"], "-", 
    StyleBox["k", "TI"], "+", "1"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"831f1f5e-39d4-4886-895b-646fc9d073dd"],
 " to ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["k", "TI"], "-", "1"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"8122314c-634a-4632-8196-fcf285304948"],
 ", the extension is of Hodge type in the degrees ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["n", "TI"], "-", 
    StyleBox["k", "TI"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "acc94b50-809e-481e-8070-8406003717ce"],
 " to ",
 Cell[BoxData[
  FormBox[
   StyleBox["k", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "5e056cda-d71e-49d3-b15a-64a8efa02cc5"],
 " (arXiv:2004.07362, Lemma 4.8)."
}], "Notes",ExpressionUUID->"d2698aba-4424-4c6f-a5d1-b7662934c113"],

Cell[TextData[{
 "The step in degree ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["n", "TI"], "/", "2", "+", "1"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"4befdd20-f9c6-482b-bd4a-9e60f0a3d52f"],
 " reads the middle degree through its Hodge decomposition, the graph of the \
twist ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindHodgeDecomposition"]], 
    "paclet:ChernSimons/ref/FindHodgeDecomposition", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "248284f2-7227-44eb-86b2-790423a0d918"],
 " finds there (arXiv:2004.07362, Lemma 4.8), and gives the ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Failure"]], "paclet:ref/Failure"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "9d5e5fb2-388b-40e6-a60d-0b8c3bad2c3c"],
 " of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindHodgeDecomposition"]], 
    "paclet:ChernSimons/ref/FindHodgeDecomposition", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "93e3a5da-a480-49ba-a361-4c79161e0520"],
 " when there is none."
}], "Notes",ExpressionUUID->"604f66a1-570d-496a-bc7c-a42315d80559"],

Cell[TextData[{
 "In the middle degree, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["n", "TI"], "\[LongEqual]", "2", 
    StyleBox["m", "TI"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "96955108-43cb-4c98-80a3-70bfc4c1198a"],
 ", the map ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Mu]", 
    RowBox[{"(", 
     RowBox[{
      StyleBox["c", "TI"], "+", 
      StyleBox["z", "TI"]}], ")"}], "\[LongEqual]", "-", 
    UnderscriptBox["\[Sum]", "\[Alpha]",
     LimitsPositioning->True], 
    RowBox[{"\[LeftAngleBracket]", 
     FractionBox["1", 
      RowBox[{"2", 
       StyleBox["c", "TI"], "+", 
       StyleBox["z", "TI"], ",", 
       SubscriptBox[
        StyleBox["c", "TI"], "\[Alpha]"]}]], "\[RightAngleBracket]"}], 
    SubscriptBox[
     StyleBox["y", "TI"], "\[Alpha]"]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"45184082-83a5-46f7-8dbe-d8e875f1266a"],
 " on ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     OverscriptBox[
      StyleBox["C", "TI"], "^"], 
     StyleBox["m", "TI"]], "\[LongEqual]", 
    SuperscriptBox[
     StyleBox["C", "TI"], 
     StyleBox["m", "TI"]], "\[CirclePlus]", 
    StyleBox["Z", "TI"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "10731f68-d915-44b4-b640-33760354cc98"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["Z", "TI"], "\[LongEqual]", 
    StyleBox["X", "TI"], "\[CenterDot]", 
    SuperscriptBox[
     StyleBox["V", "TI"], "1"]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"030a935b-eb90-44fe-888d-8d43d5374fa9"],
 ", satisfies the middle-degree twist condition, so the extension is of Hodge \
type in degree ",
 Cell[BoxData[
  FormBox[
   StyleBox["m", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "3935da11-7d76-4c9c-b4af-26be04799f6d"],
 " (arXiv:2609.14221, Proposition 2.1)."
}], "Notes",ExpressionUUID->"eba0f0b4-c82c-4ea2-911d-738dbb4cd48b"],

Cell[TextData[{
 "The middle step needs the adaptedness condition ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["V", "TI"], "1"], 
    SuperscriptBox[
     StyleBox["H", "TI"], 
     StyleBox["m", "TI"]], "\[Subset]", 
    SuperscriptBox[
     StyleBox["C", "TI"], 
     RowBox[{
      StyleBox["m", "TI"], "+", "1"}]]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"8bf25945-ab2d-46a5-92e4-4d580581823a"],
 ". It takes a coexact part of degree ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["m", "TI"], "+", "1"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"144dc6c5-9c2f-4050-995a-6a4086290eb5"],
 " that contains ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["V", "TI"], "1"], 
    SuperscriptBox[
     StyleBox["H", "TI"], 
     StyleBox["m", "TI"]]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"01ce40ad-95a8-4417-9e16-e72c2a70fe53"],
 ", which exists exactly when ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["V", "TI"], "1"], 
    SuperscriptBox[
     StyleBox["H", "TI"], 
     StyleBox["m", "TI"]]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"ce5ae1ea-0baf-4ba4-8b3d-5cc958345c5d"],
 " meets the cocycles only in ",
 Cell[BoxData[
  FormBox["0", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "1666edbf-bcbd-4cb3-9a15-c6299f7e4f1e"],
 " and is perpendicular to ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["H", "TI"], 
    RowBox[{
     StyleBox["m", "TI"], "-", "1"}]], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"8ac41387-edf2-4836-94c7-adeebaa517f8"],
 ". Otherwise the result is a ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Failure"]], "paclet:ref/Failure"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "43a65d33-4f86-4eee-99ae-086486676f0a"],
 " whose ",
 Cell[BoxData["\"\<Degrees\>\""], "InlineFormula",ExpressionUUID->
  "329b772f-066c-48eb-bcea-bb40fd43b03a"],
 " are ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    StyleBox["m", "TI"], "}"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"7cea70ab-bb51-4ebd-8e3f-6bc678316b41"],
 ". When ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["V", "TI"], "1"], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"4b94e706-04ad-4213-8d46-7785516d6fb1"],
 " the condition is empty."
}], "Notes",ExpressionUUID->"12dc59e6-dbed-4fd4-add9-4ab6731c19a6"],

Cell[TextData[{
 "When ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["C", "TI"], 
     RowBox[{
      StyleBox["n", "TI"], "-", 
      StyleBox["k", "TI"]}]], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"732f7696-4977-45cf-aeda-9962a0f34fd8"],
 " the step adjoins nothing, and ",
 StyleBox["space", "TI"],
 " comes back unchanged."
}], "Notes",ExpressionUUID->"9d3ef97d-a4e3-494b-a182-87e9e7694482"],

Cell[TextData[{
 "The full extension takes the middle step when ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "f15f4b43-3780-45af-acf8-14f76d08b73e"],
 " is even and the middle degree has no Hodge decomposition, and then the \
steps ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["k", "TI"], "\[LongEqual]", 
    RowBox[{"\[LeftFloor]", 
     RowBox[{
      StyleBox["n", "TI"], "/", "2"}], "\[RightFloor]"}], "+", "1", ",", 
    "\[Ellipsis]", ",", 
    StyleBox["n", "TI"], "-", "1"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"bc24f6d6-4a63-4ad1-9b0d-ee3e749e0dc6"],
 " in this order, each on the result of the one before. For a connected space \
of finite type with Poincare duality on cohomology the result is of Hodge \
type (arXiv:2609.14221, Proposition 2.1 and Remark 2.2; arXiv:2004.07362, \
Proposition 4.13)."
}], "Notes",ExpressionUUID->"b41585ca-bfbf-44f5-8fa2-5ecc28c75dcb"],

Cell[TextData[{
 "A space of Hodge type is extended too. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["HodgeTypeQ"]], "paclet:ChernSimons/ref/HodgeTypeQ", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "e1e7d984-7750-41e3-ae5a-15393cb10ec4"],
 " decides Hodge type without extending."
}], "Notes",ExpressionUUID->"d5f6aade-ae95-46c6-96df-3bfd42f3a3d5"],

Cell[TextData[{
 "When ",
 StyleBox["space", "TI"],
 " has no pre-Hodge decomposition, the result is the ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Failure"]], "paclet:ref/Failure"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "d4f97d68-2c87-4eb3-86d6-628c16072a55"],
 " of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindPreHodgeDecomposition"]], 
    "paclet:ChernSimons/ref/FindPreHodgeDecomposition", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "8b371a56-eee3-4c41-8c18-288825b3a221"],
 ", with its tag."
}], "Notes",ExpressionUUID->"35d7c424-02dd-4448-b340-c17621e2e82c"],

Cell[TextData[{
 "For ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["n", "TI"], "\[LongEqual]", "2"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"73cad780-2509-4452-9227-4f69ce54b909"],
 " there is no middle step, and a space whose degree ",
 Cell[BoxData[
  FormBox["1", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "e2efb670-91a5-48b8-a9d1-fa9df8989753"],
 " has no Hodge decomposition gives the ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Failure"]], "paclet:ref/Failure"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "33b071de-6a27-43bd-bb45-c62582aead04"],
 " of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindHodgeDecomposition"]], 
    "paclet:ChernSimons/ref/FindHodgeDecomposition", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "78548061-17bc-436e-889e-4228eec6e7a8"],
 "."
}], "Notes",ExpressionUUID->"574c618d-d228-4590-af6d-e67dd0573515"],

Cell[TextData[{
 "A degree ",
 Cell[BoxData[
  FormBox[
   StyleBox["k", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "733d6cad-023a-4cc2-bef0-c9e580030bb3"],
 " below ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["n", "TI"], "/", "2"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"7a17d751-0c17-45ce-90e2-85a409a20171"],
 " or above ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "08c5c951-5a3e-488d-8018-9469466926a9"],
 ", or ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["k", "TI"], "\[LongEqual]", "1"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"63a8be94-a01c-43e8-b91f-a40a95da59c8"],
 ", returns unevaluated, and so does a complex with a product but without the \
unit ",
 Cell[BoxData[
  FormBox["1", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "44e93479-6dff-4bbb-ba6f-1c28f2e4016d"],
 "."
}], "Notes",ExpressionUUID->"1cd06343-ea78-4540-994b-9c1eefe830b6"]
}, Open  ]],

