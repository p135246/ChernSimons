  "296d267c-9939-4bfa-94a3-bbfe50f793c9"],
 " in that order, and the truncation of the model."
}], "Notes",ExpressionUUID->"093581fd-cc92-4bd3-b349-09b75daf9ac1"],

Cell[TextData[{
 "A ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CochainComplexWithPairing"]], 
    "paclet:ChernSimons/ref/CochainComplexWithPairing", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "35a2b9c3-10a2-4ab7-bd72-0336bd2b7407"],
 " with a product comes back as the complex of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["V", "TI"], "\[CircleTimes]", "\[CapitalLambda]"}], 
   TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "41e37ad3-4290-4aab-81ea-69dde21f5573"],
 " up to degree ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["n", "TI"], "+", "1"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1f52f89d-0754-43f0-9ce8-5996ca57cdbe"],
 " with the image of ",
 Cell[BoxData[
  FormBox[
   StyleBox["d",
    FontSlant->"Plain"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3d21291c-17e8-4c0d-9020-9a6a4e744bf9"],
 " in degree ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["n", "TI"], "+", "2"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ff773af8-184d-44c5-bbf9-8baed2cbd459"],
 ", as ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["CochainComplexWithPairing"]], 
     "paclet:ChernSimons/ref/CochainComplexWithPairing", 
     "ChernSimons Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["model", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bc395ed7-febe-431d-8306-790a5f613935"],
 " is for a model."
}], "Notes",ExpressionUUID->"29e250cf-304a-44db-bea1-cd06f2cf6617"],

Cell[TextData[{
 "A ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CochainComplexWithPairing"]], 
    "paclet:ChernSimons/ref/CochainComplexWithPairing", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "768ffd56-2f9f-4fec-90f7-b5fed8ee7cdc"],
 " without a product comes back as ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["V", "TI"], "\[CirclePlus]", 
    StyleBox["span",
     FontSlant->"Plain"], 
    RowBox[{"{", 
     RowBox[{
      SubscriptBox[
       StyleBox["x", "TI"], "\[Alpha]"], ",", 
      SubscriptBox[
       StyleBox["y", "TI"], "\[Alpha]"]}], "}"}]}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "862a82e3-ee37-447c-8aaa-3b6863bfe48b"],
 ", the pairing of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["x", "TI"], "\[Alpha]"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "42905e13-d2a7-4e23-a69c-3d9148f146af"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["y", "TI"], "\[Alpha]"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f297164d-c54f-4715-b56a-38c38bba152e"],
 " with ",
 Cell[BoxData[
  FormBox[
   StyleBox["V", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6b8693e7-8ae3-4a83-ade0-2279473a8720"],
 " given by the same formulas with ",
 Cell[BoxData[
  FormBox[
   StyleBox["v", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f1db6d2c-b5a1-4073-a76d-1524fe4090ee"],
 " in place of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["x", "TI"], "\[Alpha]"], 
    StyleBox["v", "TI"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "24823bf1-0e4f-444f-9439-64403579d74a"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["y", "TI"], "\[Alpha]"], 
    StyleBox["v", "TI"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ed7c323a-8ca4-4a4e-a8a9-19dc6f4806da"],
 "."
}], "Notes",ExpressionUUID->"c98f887b-af57-437c-9016-1246580cb47b"],

Cell[TextData[{
 "Above the middle degree, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["k", "TI"], ">", 
    StyleBox["n", "TI"], "/", "2"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "84204d9a-04a7-46d4-9b21-bf38f812b82c"],
 ", the map ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Mu]", 
    RowBox[{"(", 
     StyleBox["u", "TI"], ")"}], "\[LongEqual]", "-", 
    UnderscriptBox["\[Sum]", "\[Alpha]",
     LimitsPositioning->True], 
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{
      StyleBox["u", "TI"], ",", 
      SubscriptBox[
       StyleBox["c", "TI"], "\[Alpha]"]}], "\[RightAngleBracket]"}], 
    SubscriptBox[
     StyleBox["y", "TI"], "\[Alpha]"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "22df55d4-ee67-4b5d-8f65-e8c99b90b4df"],
 " on the coexact part of degree ",
 Cell[BoxData[
  FormBox[
   StyleBox["k", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c60b69c5-91d2-4337-ab2d-db0936af9bfa"],
 " satisfies the Hodge twist condition ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{
      StyleBox["u", "TI"], "+", "\[Mu]", 
      StyleBox["u", "TI"], ",", 
      SubscriptBox[
       StyleBox["c", "TI"], "\[Beta]"]}], "\[RightAngleBracket]"}], "\[LongEqual]",
     "0"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "83c2d6ee-a62b-4707-a70c-679b7dbe17bb"],
 " (arXiv:2609.14221, Remark 2.2). If ",
 StyleBox["space", "TI"],
 " is of Hodge type in the degrees ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["n", "TI"], "-", 
    StyleBox["k", "TI"], "+", "1"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b79a298b-656c-416f-b3d4-69efd1794f8c"],
 " to ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["k", "TI"], "-", "1"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6908fd72-75a2-41c9-8fea-e3177119f4bf"],
 ", the extension is of Hodge type in the degrees ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["n", "TI"], "-", 
    StyleBox["k", "TI"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8b4fe7c1-f545-44d9-98b5-2a67cf23217c"],
 " to ",
 Cell[BoxData[
  FormBox[
   StyleBox["k", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9780074d-cee8-440a-9e0c-bbdb4d3374b6"],
 " (arXiv:2004.07362, Lemma 4.8)."
}], "Notes",ExpressionUUID->"b51c47a2-f570-464b-92cd-ab78c49a875a"],

Cell[TextData[{
 "The step in degree ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["n", "TI"], "/", "2", "+", "1"}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9171960d-c433-47d5-be6a-8124fcfd8bde"],
 " reads the middle degree through its Hodge decomposition, the graph of the \
twist ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindHodgeDecomposition"]], 
    "paclet:ChernSimons/ref/FindHodgeDecomposition", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "922eceb4-456b-4094-a462-030f8b1a89bd"],
 " finds there (arXiv:2004.07362, Lemma 4.8), and gives the ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Failure"]], "paclet:ref/Failure"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "1a908061-67dd-4160-bc4a-0909872f868c"],
 " of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindHodgeDecomposition"]], 
    "paclet:ChernSimons/ref/FindHodgeDecomposition", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "5807f760-da0d-44a6-b9cd-e1d6cc557155"],
 " when there is none."
}], "Notes",ExpressionUUID->"c31a6580-e0fb-4bf6-8507-4636ecd29e38"],

Cell[TextData[{
 "In the middle degree, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["n", "TI"], "\[LongEqual]", "2", 
    StyleBox["m", "TI"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fba3768c-84a1-4ea7-b31a-121f92de41ee"],
 ", the map ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Mu]", 
    RowBox[{"(", 
     RowBox[{
      StyleBox["c", "TI"], "+", 
      StyleBox["z", "TI"]}], ")"}], "\[LongEqual]", "-", 
    UnderscriptBox["\[Sum]", "\[Alpha]",
     LimitsPositioning->True], 
    RowBox[{"\[LeftAngleBracket]", 
     FractionBox["1", 
      RowBox[{"2", 
       StyleBox["c", "TI"], "+", 
       StyleBox["z", "TI"], ",", 
       SubscriptBox[
        StyleBox["c", "TI"], "\[Alpha]"]}]], "\[RightAngleBracket]"}], 
    SubscriptBox[
     StyleBox["y", "TI"], "\[Alpha]"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f6eb497a-8ceb-4fc9-b86c-9026267dbcb2"],
 " on ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     OverscriptBox[
      StyleBox["C", "TI"], "^"], 
     StyleBox["m", "TI"]], "\[LongEqual]", 
    SuperscriptBox[
     StyleBox["C", "TI"], 
     StyleBox["m", "TI"]], "\[CirclePlus]", 
    StyleBox["Z", "TI"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d198bb63-5fcf-44ff-92a3-07c424ee1eff"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["Z", "TI"], "\[LongEqual]", 
    StyleBox["X", "TI"], "\[CenterDot]", 
    SuperscriptBox[
     StyleBox["V", "TI"], "1"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9e103483-a0e6-412e-8db7-b565a5fc7aa6"],
 ", satisfies the middle-degree twist condition, so the extension is of Hodge \
type in degree ",
 Cell[BoxData[
  FormBox[
   StyleBox["m", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "06ca4654-f212-4b61-b027-e394b6d4fdaf"],
 " (arXiv:2609.14221, Proposition 2.1)."
}], "Notes",ExpressionUUID->"c5abf198-6371-4be0-bdcf-3b777ca9b10a"],

Cell[TextData[{
 "The middle step needs the adaptedness condition ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["V", "TI"], "1"], 
    SuperscriptBox[
     StyleBox["H", "TI"], 
     StyleBox["m", "TI"]], "\[Subset]", 
    SuperscriptBox[
     StyleBox["C", "TI"], 
     RowBox[{
      StyleBox["m", "TI"], "+", "1"}]]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "246d0a45-2220-4522-b352-a353efe530f5"],
 ". It takes a coexact part of degree ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["m", "TI"], "+", "1"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "25b811f9-ecad-4285-9d49-0dbcfa4b4cf5"],
 " that contains ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["V", "TI"], "1"], 
    SuperscriptBox[
     StyleBox["H", "TI"], 
     StyleBox["m", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c1766ddd-98da-47ee-a06e-2a501d309769"],
 ", which exists exactly when ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["V", "TI"], "1"], 
    SuperscriptBox[
     StyleBox["H", "TI"], 
     StyleBox["m", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0fd45b9e-1126-4e53-9fa3-8c06c46111a3"],
 " meets the cocycles only in ",
 Cell[BoxData[
  FormBox["0", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7754e8a3-375a-4d2d-865b-53a12c241055"],
 " and is perpendicular to ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["H", "TI"], 
    RowBox[{
     StyleBox["m", "TI"], "-", "1"}]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4a1634f2-5439-4028-8f0e-ba02bd55ace0"],
 ". Otherwise the result is a ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Failure"]], "paclet:ref/Failure"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "e2fd7612-4302-4d7b-87a1-6683007be3e0"],
 " whose ",
 Cell[BoxData["\"\<Degrees\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c8dbc64e-f31c-4d55-be11-82d30b19271b"],
 " are ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    StyleBox["m", "TI"], "}"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "06a3c107-db8d-434e-9b73-890ef57d401e"],
 ". When ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["V", "TI"], "1"], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2a2b1f02-403f-4afd-bea1-ed36fa56e1c9"],
 " the condition is empty."
}], "Notes",ExpressionUUID->"a812346b-e4b3-47d3-b0ca-968553faca86"],

Cell[TextData[{
 "When ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["C", "TI"], 
     RowBox[{
      StyleBox["n", "TI"], "-", 
      StyleBox["k", "TI"]}]], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7502b2dc-7f36-4c6b-9b94-b43167b4d312"],
 " the step adjoins nothing, and ",
 StyleBox["space", "TI"],
 " comes back unchanged."
}], "Notes",ExpressionUUID->"b07b43da-fa40-4f72-9625-0de67b6b75d7"],

Cell[TextData[{
 "The full extension takes the middle step when ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "896ba07b-4bb3-47c2-9051-c27c5b9af6f0"],
 " is even and the middle degree has no Hodge decomposition, and then the \
steps ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["k", "TI"], "\[LongEqual]", 
    RowBox[{"\[LeftFloor]", 
     RowBox[{
      StyleBox["n", "TI"], "/", "2"}], "\[RightFloor]"}], "+", "1", ",", 
    "\[Ellipsis]", ",", 
    StyleBox["n", "TI"], "-", "1"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8184ea74-8967-4c95-84f7-1c2685143f74"],
 " in this order, each on the result of the one before. For a connected space \
of finite type with Poincare duality on cohomology the result is of Hodge \
type (arXiv:2609.14221, Proposition 2.1 and Remark 2.2; arXiv:2004.07362, \
Proposition 4.13)."
}], "Notes",ExpressionUUID->"7353dac9-59ad-472f-858e-7ac76085ec29"],

Cell[TextData[{
 "A space of Hodge type is extended too. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["HodgeTypeQ"]], "paclet:ChernSimons/ref/HodgeTypeQ", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "3080d71f-1353-4e62-917f-cf8b8a801591"],
 " decides Hodge type without extending."
}], "Notes",ExpressionUUID->"86ae8a50-af39-452f-bc74-1eaf5ea733a9"],

Cell[TextData[{
 "When ",
 StyleBox["space", "TI"],
 " has no pre-Hodge decomposition, the result is the ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Failure"]], "paclet:ref/Failure"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "7b080e60-ca45-4751-ae83-893b5ff3bb11"],
 " of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindPreHodgeDecomposition"]], 
    "paclet:ChernSimons/ref/FindPreHodgeDecomposition", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "27a15df0-6773-4894-9b7e-410c30dea08f"],
 ", with its tag."
}], "Notes",ExpressionUUID->"ed926a7f-5f36-494e-ac99-7b692f5a63aa"],

Cell[TextData[{
 "For ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["n", "TI"], "\[LongEqual]", "2"}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "424783ae-9d93-4654-aa61-c5b4832484cb"],
 " there is no middle step, and a space whose degree ",
 Cell[BoxData[
  FormBox["1", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f4265e8f-3471-47bd-a9c8-9f396c3fae1a"],
 " has no Hodge decomposition gives the ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Failure"]], "paclet:ref/Failure"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "b5e33a71-44b1-4eea-b936-5ef245521101"],
 " of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindHodgeDecomposition"]], 
    "paclet:ChernSimons/ref/FindHodgeDecomposition", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "09326a0c-c3e3-4206-b356-39be9035dd95"],
 "."
}], "Notes",ExpressionUUID->"80fffa57-1f28-41cb-8e73-421ed4033b71"],

Cell[TextData[{
 "A degree ",
 Cell[BoxData[
  FormBox[
   StyleBox["k", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4ad48bc6-a5fd-46dc-b966-30fe6e8f70d6"],
 " below ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["n", "TI"], "/", "2"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cf55d6cf-2d5d-434d-9919-bc13d92fd99a"],
 " or above ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f59f414a-d341-478d-a861-f2b3c61fd0da"],
 ", or ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["k", "TI"], "\[LongEqual]", "1"}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e28952ef-9402-489c-8271-579f5ca3e490"],
 ", returns unevaluated, and so does a complex with a product but without the \
unit ",
 Cell[BoxData[
  FormBox["1", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d7d99955-1300-4ae6-830d-fde5dbd3ac94"],
 "."
}], "Notes",ExpressionUUID->"500e0ce4-c60a-44b2-8ed9-539df50f96ae"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "See Also",
 Cell[BoxData[
  TemplateBox[{"SeeAlso", 
    Cell[
     BoxData[
      FrameBox[
       Cell[
       "Insert links to any related reference (function) pages.", 
        "MoreInfoText"], BaseStyle -> "IFrameBox"]], "MoreInfoTextOuter"]},
   "MoreInfoOpenerButtonTemplate"]],ExpressionUUID->
  "b7caa910-e086-4d39-871e-e78bfb02a4b9"]
}], "SeeAlsoSection",
 CellID->1559318232,ExpressionUUID->"6019c63b-8124-433f-bd7e-253812d6da0e"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["HodgeTypeQ"]], "paclet:ChernSimons/ref/HodgeTypeQ", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "a10af618-c25f-49d5-804b-b8ac9582da0d"],
 " \[FilledVerySmallSquare] ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindHodgeDecomposition"]], 
    "paclet:ChernSimons/ref/FindHodgeDecomposition", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "54a8824b-fff3-4b08-a37e-726e0236394a"],
 " \[FilledVerySmallSquare] ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindPreHodgeDecomposition"]], 
    "paclet:ChernSimons/ref/FindPreHodgeDecomposition", 
    "ChernSimons Package Symbol"},
   "PackageLink",
