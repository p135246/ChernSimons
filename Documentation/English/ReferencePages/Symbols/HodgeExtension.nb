Cell[TextData[{
 "The coexact part of degree ",
 Cell[BoxData[
  FormBox["2", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2370e610-d0d2-4164-83cc-8df50d2f1650"],
 " of its Hodge decomposition is the graph of ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{"\[Mu]", 
     RowBox[{"(", 
      StyleBox["a", "TI"], ")"}], "\[LongEqual]", 
     RowBox[{"-", "1"}]}], 
    RowBox[{"2", 
     RowBox[{"\[LeftAngleBracket]", 
      RowBox[{
       StyleBox["a", "TI"], ",", 
       StyleBox["a", "TI"]}], "\[RightAngleBracket]"}], 
     SubscriptBox[
      StyleBox["y", "TI"], "1"]}]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "30e98ddb-20f3-4909-9f0e-ce0b79aee437"],
 ":"
}], "ExampleText",ExpressionUUID->"ed32fc94-c063-4bf5-8afc-ad9f1860f37a"],

