Cell[TextData[{
 "The second step reads ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["a", "TI"], "\[LongEqual]", 
    RowBox[{"(", 
     FractionBox[
      RowBox[{
       StyleBox["a", "TI"], "-", "1"}], 
      RowBox[{"2", 
       SubscriptBox[
        StyleBox["y", "TI"], "1"]}]], ")"}], "+", 
    StyleBox["d",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     FractionBox["1", 
      RowBox[{"2", 
       SubscriptBox[
        StyleBox["x", "TI"], "1"]}]], ")"}]}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"4d39cfd5-d847-425d-8f96-c93900a2cca8"],
 " through the Hodge decomposition of the middle degree:"
}], "ExampleText",ExpressionUUID->"d34e38d8-d35d-4500-8429-c00f0154df46"],

