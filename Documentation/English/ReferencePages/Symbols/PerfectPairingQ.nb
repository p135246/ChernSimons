Cell[TextData[{
 "A truncation can make a polynomial algebra finite-dimensional. The \
truncated algebra ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["K",
     FontSlant->"Plain"], 
    RowBox[{"[", 
     StyleBox["u", "TI"], "]"}], "/", 
    RowBox[{"(", 
     SuperscriptBox[
      StyleBox["u", "TI"], "3"], ")"}]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4155782c-d481-4b87-8b11-3de5c52a241e"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{"|", 
    StyleBox["u", "TI"], "|", "\[LongEqual]", "2"}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "326532e0-9143-435a-9183-45d54bb1df19"],
 ", the cohomology of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["CP",
     FontSlant->"Plain"], "2"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d5e2f802-a2a5-4c51-9c97-23fe748de00d"],
 ", has a perfect pairing:"
}], "ExampleText",ExpressionUUID->"005938c5-e7a4-45ca-a026-7e940ee243af"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"PerfectPairingQ", "[", 
  RowBox[{"SullivanModel", "[", 
   RowBox[{
    RowBox[{"<|", 
     RowBox[{"u", " ", "->", " ", "2"}], "|>"}], ",", " ", 
    RowBox[{"<|", "|>"}], ",", " ", 
    RowBox[{"u", "^", "2"}], ",", " ", "4"}], "]"}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"d88aaaf7-1f4a-4aff-9e31-c3d80a199b54"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"cc3c52d5-bdbd-40b2-8fd4-67b312fef7d5"]
}, Open  ]],

