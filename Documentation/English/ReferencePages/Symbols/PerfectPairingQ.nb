Cell[TextData[{
 "A truncation can make a polynomial algebra finite-dimensional. The \
truncated algebra ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["K",
     FontSlant->"Plain"], 
    RowBox[{"[", 
     StyleBox["u", "TI"], "]"}], "/", 
    RowBox[{"(", 
     SuperscriptBox[
      StyleBox["u", "TI"], "3"], ")"}]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9169684b-0870-41aa-a54c-21133245c366"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{"|", 
    StyleBox["u", "TI"], "|", "\[LongEqual]", "2"}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "de712ab5-23e5-4053-b266-60d935a27f0e"],
 ", the cohomology of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["CP",
     FontSlant->"Plain"], "2"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a8983712-45a3-41ce-8f38-1291df9c48b5"],
 ", has a perfect pairing:"
}], "ExampleText",ExpressionUUID->"1ec6d8f1-5133-477f-adbb-310d7b4dc534"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"PerfectPairingQ", "[", 
  RowBox[{"SullivanModel", "[", 
   RowBox[{
    RowBox[{"<|", 
     RowBox[{"u", " ", "->", " ", "2"}], "|>"}], ",", " ", 
    RowBox[{"<|", "|>"}], ",", " ", 
    RowBox[{"u", "^", "2"}], ",", " ", "4"}], "]"}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"3f1f0e7b-dff5-4cc6-933e-19211bac651a"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"e6e415aa-a0b6-43d8-bc96-28c245d8d3b4"]
}, Open  ]],

