Cell[TextData[{
 "A truncation can make a polynomial algebra finite-dimensional. The \
truncated algebra ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["K",
     FontSlant->"Plain"], 
    RowBox[{"[", 
     StyleBox["u", "TI"], "]"}], "/", 
    RowBox[{"(", 
     SuperscriptBox[
      StyleBox["u", "TI"], "3"], ")"}]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"4fad91ee-5497-4595-be0e-b2f19a1cc8e5"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{"|", 
    StyleBox["u", "TI"], "|", "\[LongEqual]", "2"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"11d505a1-1033-42e4-87a5-453a6282ee12"],
 ", the cohomology of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["CP",
     FontSlant->"Plain"], "2"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"0ab3f72c-e097-4f86-828f-d011b3c7c553"],
 ", has a perfect pairing:"
}], "ExampleText",ExpressionUUID->"9a3ec0b7-57cb-4b25-aabd-eb952cf3a532"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"PerfectPairingQ", "[", 
  RowBox[{"SullivanModel", "[", 
   RowBox[{
    RowBox[{"<|", 
     RowBox[{"u", " ", "->", " ", "2"}], "|>"}], ",", " ", 
    RowBox[{"<|", "|>"}], ",", " ", 
    RowBox[{"u", "^", "2"}], ",", " ", "4"}], "]"}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"688c7de0-6444-4639-b4ab-a244690fd2c6"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"b91c110a-40ca-4b15-a9c4-c8ef562c9663"]
}, Open  ]],

