Cell[TextData[{
 "A truncation can make a polynomial algebra finite-dimensional. The \
truncated algebra ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["K",
     FontSlant->"Plain"], 
    RowBox[{"[", 
     StyleBox["u", "TI"], "]"}], "/", 
    RowBox[{"(", 
     SuperscriptBox[
      StyleBox["u", "TI"], "3"], ")"}]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"782e1e10-ff8e-45de-a131-8cdefb5cd1a3"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{"|", 
    StyleBox["u", "TI"], "|", "\[LongEqual]", "2"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"7883a805-35f9-4dd1-86c5-7bfd5fc6c54f"],
 ", the cohomology of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["CP",
     FontSlant->"Plain"], "2"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"7dc60e2e-263f-4c4d-a818-529baf9da4e9"],
 ", has a perfect pairing:"
}], "ExampleText",ExpressionUUID->"76a19fbf-5b31-4830-bd56-bcc5f50a7a1e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"PerfectPairingQ", "[", 
  RowBox[{"SullivanModel", "[", 
   RowBox[{
    RowBox[{"<|", 
     RowBox[{"u", " ", "->", " ", "2"}], "|>"}], ",", " ", 
    RowBox[{"<|", "|>"}], ",", " ", 
    RowBox[{"u", "^", "2"}], ",", " ", "4"}], "]"}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"6615a25e-9b26-4f38-8b58-632b0122659d"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"c6b84fe6-e55c-42e2-9258-b8561975fc77"]
}, Open  ]],

