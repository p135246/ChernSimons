 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"287e117f-279d-4611-8d45-0215df067a7c"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["PerfectPairingQ"]], "paclet:ChernSimons/ref/PerfectPairingQ", 
     "ChernSimons Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
