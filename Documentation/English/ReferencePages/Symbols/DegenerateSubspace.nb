Notebook[{

Cell[CellGroupData[{
Cell["DegenerateSubspace", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"102a3286-98b0-4a73-9e6b-4371e1c2574b"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["DegenerateSubspace"]], 
     "paclet:ChernSimons/ref/DegenerateSubspace", 
     "ChernSimons Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["model", "TI"], ",", " ", 
    StyleBox["k", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0a660de0-2b16-41f0-b3d5-2bef39e5c2f4"],
 "\[LineSeparator]",
 "gives a basis of the degree-",
 StyleBox["k", "TI"],
 " part of the degenerate subspace ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["V", "TI"], 
     StyleBox["deg",
      FontSlant->"Plain"]], "\[LongEqual]", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["v", "TI"], "|", 
      StyleBox["v", "TI"], "\[Perpendicular]", 
      StyleBox["V", "TI"]}], "}"}]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3fece032-b015-4d94-a516-6ec3e598947d"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"7349a7d7-2870-41c7-8248-d87f12da18ce"],

Cell[TextData[{
 "An element is degenerate when it pairs to zero with everything. Since the \
pairing has degree ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "93dffb94-2d9f-4179-a662-48f7fd81b3f4"],
 ", only degree ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["n", "TI"], "-", 
    StyleBox["k", "TI"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7702a924-567a-4bc6-83df-d2d7f7dae341"],
 " can test degree ",
 Cell[BoxData[
  FormBox[
   StyleBox["k", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2fc0ba44-f329-44b6-9f67-3bcd657591b4"],
 ", so the computation is the kernel of one matrix per degree."
}], "Notes",ExpressionUUID->"1dbb54c8-4aa0-49a3-9031-13e94bc8c85b"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["V", "TI"], 
    StyleBox["deg",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7c787179-5ee0-4789-8ed9-75790aca6642"],
 " is a differential graded ideal \[LongDash] it is closed under the \
differential because ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{
      StyleBox["d",
       FontSlant->"Plain"], 
      SubscriptBox[
       StyleBox["v", "TI"], "1"], ",", 
      SubscriptBox[
       StyleBox["v", "TI"], "2"]}], "\[RightAngleBracket]"}], "\[LongEqual]", 
    "\[PlusMinus]", 
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{
      SubscriptBox[
       StyleBox["v", "TI"], "1"], ",", 
      StyleBox["d",
       FontSlant->"Plain"], 
      SubscriptBox[
       StyleBox["v", "TI"], "2"]}], "\[RightAngleBracket]"}]}], 
   TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e28e8800-cddb-4e10-8305-0c5c1e5f7321"],
 ", and under multiplication because ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{
      SubscriptBox[
       StyleBox["v", "TI"], "1"], 
      SubscriptBox[
       StyleBox["v", "TI"], "2"], ",", 
      SubscriptBox[
       StyleBox["v", "TI"], "3"]}], "\[RightAngleBracket]"}], "\[LongEqual]", 
    
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{
      SubscriptBox[
       StyleBox["v", "TI"], "1"], ",", 
      SubscriptBox[
       StyleBox["v", "TI"], "2"], 
      SubscriptBox[
       StyleBox["v", "TI"], "3"]}], "\[RightAngleBracket]"}]}], 
   TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b56a785b-972f-402f-84ba-e5e4c40076d5"],
 " \[LongDash] so the quotient by it is again a CDGA. That quotient is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["NondegenerateQuotient"]], 
    "paclet:ChernSimons/ref/NondegenerateQuotient", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "1fb5b2bc-aeee-44ec-b304-16999fd56e1e"],
 "."
}], "Notes",ExpressionUUID->"df433a0f-d6ae-4b2f-9647-953b9826df29"],

Cell["\<\
Above the model's degree the orientation sees nothing, so the whole of each \
degree is degenerate.\
\>", "Notes",ExpressionUUID->"86ece21e-4fd2-46eb-8dc5-2226ca759a9c"]
}, Open  ]],

