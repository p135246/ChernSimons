Cell[TextData[{
 "Nothing is degenerate up to degree ",
 Cell[BoxData[
  FormBox["4", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8ea5df83-ef38-4611-91e9-aca589bbe8bc"],
