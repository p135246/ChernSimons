Cell[TextData[{
 "Nothing is degenerate up to degree ",
 Cell[BoxData[
  FormBox["4", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e1b37d79-571b-4b4d-be16-bf3bb04ec5ce"],
