Cell["And in the exterior picture:", "ExampleText",ExpressionUUID->"79a14f23-f6ee-489e-8cac-b3c466e5ba57"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"exterior", " ", "=", " ", 
   RowBox[{"Append", "[", 
    RowBox[{
     RowBox[{"GradedPairing", "[", 
      RowBox[{
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"x", " ", "->", " ", 
          RowBox[{"-", "1"}]}], ",", " ", 
         RowBox[{"y", " ", "->", " ", "0"}]}], "|>"}], ",", " ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"x", ",", " ", "y"}], "}"}], " ", "->", " ", "1"}], 
        "|>"}]}], "]"}], ",", " ", 
     RowBox[{"\"\<Convention\>\"", " ", "->", " ", "\"\<Exterior\>\""}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{"DrinfeldObstruction", "[", 
  RowBox[{
   RowBox[{"CyclicWord", "[", 
    RowBox[{"{", 
     RowBox[{"x", ",", " ", "y"}], "}"}], "]"}], ",", " ", 
   RowBox[{"CyclicWord", "[", 
    RowBox[{"{", 
     RowBox[{"x", ",", " ", "y", ",", " ", "y"}], "}"}], "]"}], ",", " ", 
   "exterior"}], "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"c47667ff-ae21-4ab3-81c2-d76cb39ee157"],

Cell[BoxData["0"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"e62ed637-583f-434c-87a5-67b5bd0775d8"]
}, Open  ]]
}, Open  ]]
}, Open  ]],

