Cell["\<\
Sweeping it over an enumerated range of words, every value is zero:\
\>", "ExampleText",ExpressionUUID->"d233620f-0ecc-4334-b631-b6bc39b2bc35"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"words", "[", "n_", "]"}], " ", ":=", " ", 
   RowBox[{"CyclicWords", "[", 
    RowBox[{"n", ",", " ", 
     RowBox[{"GradedPairing", "[", 
      RowBox[{
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"x", " ", "->", " ", 
          RowBox[{"-", "1"}]}], ",", " ", 
         RowBox[{"y", " ", "->", " ", "0"}]}], "|>"}], ",", " ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"x", ",", " ", "y"}], "}"}], " ", "->", " ", "1"}], 
        "|>"}]}], "]"}], ",", " ", 
     RowBox[{"\"\<UpTo\>\"", " ", "->", " ", "True"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"DeleteDuplicates", "[", 
  RowBox[{"Map", "[", 
   RowBox[{
    RowBox[{"t", " ", "|->", " ", 
     RowBox[{"Expand", "[", 
      RowBox[{"DrinfeldObstruction", "[", 
       RowBox[{
        RowBox[{"t", "[", 
         RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
        RowBox[{"t", "[", 
         RowBox[{"[", "2", "]"}], "]"}], ",", " ", 
        RowBox[{"GradedPairing", "[", 
         RowBox[{
          RowBox[{"<|", 
           RowBox[{
            RowBox[{"x", " ", "->", " ", 
             RowBox[{"-", "1"}]}], ",", " ", 
            RowBox[{"y", " ", "->", " ", "0"}]}], "|>"}], ",", " ", 
          RowBox[{"<|", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"x", ",", " ", "y"}], "}"}], " ", "->", " ", "1"}], 
           "|>"}]}], "]"}]}], "]"}], "]"}]}], ",", " ", 
    RowBox[{"Tuples", "[", 
     RowBox[{
      RowBox[{"words", "[", "3", "]"}], ",", " ", "2"}], "]"}]}], "]"}], 
  "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"0c9dd948-13cc-448a-baaf-62678914ed9a"],

Cell[BoxData[
 RowBox[{"{", "0", "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"fdfd6701-4ec9-4ee1-9f67-96b1733f9421"]
}, Open  ]],

