Notebook[{

Cell[CellGroupData[{
Cell["DrinfeldObstruction", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"c4a802cc-5d1c-4ccc-9fca-0e0841b3cf4a"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["DrinfeldObstruction"]], 
     "paclet:ChernSimons/ref/DrinfeldObstruction", 
     "ChernSimons Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["u", "TI"], ",", " ", 
    StyleBox["v", "TI"], ",", " ", 
    StyleBox["pairing", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fa1b54db-f4e8-4186-a742-2dc26e2b49db"],
 "\[LineSeparator]",
 "gives the Drinfeld compatibility obstruction of two cyclic words; ",
 Cell[BoxData[
  FormBox["0", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "75aab3ae-a0d0-4817-92b0-c810a5acc7ce"],
 " means the identity holds there.",
 "\n"
}], "Usage",ExpressionUUID->"06fa754d-d432-41d5-bfbe-90309bd0449d"],

Cell[TextData[{
 "The obstruction is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     OverscriptBox[
      StyleBox["q", "TI"], "^"], 
     RowBox[{"1", ",", "2", ",", "0"}]], "\[EmptySmallCircle]", 
    SubscriptBox[
     OverscriptBox[
      StyleBox["q", "TI"], "^"], 
     RowBox[{"2", ",", "1", ",", "0"}]], "+", 
    SubscriptBox[
     OverscriptBox[
      StyleBox["q", "TI"], "^"], 
     RowBox[{"2", ",", "1", ",", "0"}]], "\[EmptySmallCircle]", 
    SubscriptBox[
     OverscriptBox[
      StyleBox["q", "TI"], "^"], 
     RowBox[{"1", ",", "2", ",", "0"}]]}], TraditionalForm]], "InlineFormula",
  
  FontSize->0.9 Inherited,ExpressionUUID->
  "f9613df7-9ecc-48f5-913c-44ca62e089e2"],
 " applied to the product ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["u", "TI"], "\[CircleDot]", 
    StyleBox["v", "TI"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0fad9fd4-9bc1-4ca5-845d-98309739cf03"],
 " \[LongDash] the statement that the co-bracket is a derivation for the \
bracket, which is what makes the two operations a bi-Lie structure rather \
than two unrelated ones."
}], "Notes",ExpressionUUID->"00be59b4-a9d1-4294-83b8-f4d98da50d9f"],

Cell[TextData[{
 "The convention key of ",
 StyleBox["pairing", "TI"],
 " selects the picture."
}], "Notes",ExpressionUUID->"c3fde92f-eac1-4014-b57c-0e5e087b4029"],

Cell["\<\
Both composites raise and lower the number of factors by one, so the \
obstruction lives in the same two-factor space as the input product, and the \
identity is the vanishing of their sum rather than of either term.\
\>", "Notes",ExpressionUUID->"7c00a337-7ba3-4970-8caf-be1c6f1594f6"],

