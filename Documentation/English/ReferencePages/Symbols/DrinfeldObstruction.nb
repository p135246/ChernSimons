Cell[TextData[{
 "Over every pair of words of length at most ",
 Cell[BoxData[
  FormBox["3", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b9915bc2-dc76-48b0-a412-984be62e6010"],
 ":"
}], "ExampleText",ExpressionUUID->"e77dbf98-b175-4093-9c5a-66259ab01351"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"pairing", " ", "=", " ", 
   RowBox[{"GradedPairing", "[", 
    RowBox[{
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"x", " ", "->", " ", 
        RowBox[{"-", "1"}]}], ",", " ", 
       RowBox[{"y", " ", "->", " ", "0"}]}], "|>"}], ",", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "y"}], "}"}], " ", "->", " ", "1"}], "|>"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"words", " ", "=", " ", 
   RowBox[{"CyclicWords", "[", 
    RowBox[{"3", ",", " ", "pairing", ",", " ", 
     RowBox[{"\"\<UpTo\>\"", " ", "->", " ", "True"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"Union", "[", 
  RowBox[{"Flatten", "[", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"DrinfeldObstruction", "[", 
      RowBox[{"u", ",", " ", "v", ",", " ", "pairing"}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"u", ",", " ", "words"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"v", ",", " ", "words"}], "}"}]}], "]"}], "]"}], 
  "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"4ae6e1b5-e3bf-4f2a-ac2d-2e8b456957ff"],

Cell[BoxData[
 RowBox[{"{", "0", "}"}]], "Output",
