Cell["\<\
The four defining identities together, each on its own arity:\
\>", "ExampleText",ExpressionUUID->"910baf5d-c44a-4852-bfec-74e9caba274e"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"pairing", " ", "=", " ", 
   RowBox[{"GradedPairing", "[", 
    RowBox[{
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"x", " ", "->", " ", 
        RowBox[{"-", "1"}]}], ",", " ", 
       RowBox[{"y", " ", "->", " ", "0"}]}], "|>"}], ",", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "y"}], "}"}], " ", "->", " ", "1"}], "|>"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{"Normal", "[", 
  RowBox[{"Map", "[", 
   RowBox[{
    RowBox[{"e", " ", "|->", " ", 
     RowBox[{"DeleteDuplicates", "[", 
      RowBox[{"Map", "[", 
       RowBox[{
        RowBox[{"t", " ", "|->", " ", 
         RowBox[{"Expand", "[", 
          RowBox[{
           RowBox[{"e", "[", "\"\<Function\>\"", "]"}], " ", "@@", " ", 
           RowBox[{"Append", "[", 
            RowBox[{"t", ",", " ", "pairing"}], "]"}]}], "]"}]}], ",", "\n", 
        "   ", 
        RowBox[{"Tuples", "[", 
         RowBox[{
          RowBox[{"CyclicWords", "[", 
           RowBox[{"3", ",", " ", "pairing", ",", " ", 
            RowBox[{"\"\<UpTo\>\"", " ", "->", " ", "True"}]}], "]"}], ",", 
          " ", 
          RowBox[{"e", "[", "\"\<Arity\>\"", "]"}]}], "]"}]}], "]"}], "]"}]}],
     ",", " ", "$DefiningIdentities"}], "]"}], "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"4ff00695-13f1-4b05-9ede-3b49abe55887"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\<\"JacobiObstruction\"\>", "\[Rule]", 
    RowBox[{"{", "0", "}"}]}], ",", 
   RowBox[{"\<\"CoJacobiObstruction\"\>", "\[Rule]", 
