   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "6df163a4-389f-4a3d-b0f3-b5b422897d00"],
 " is the inverse map, with either rule."
}], "Notes",ExpressionUUID->"da087704-1185-48bc-9aeb-bc3050b06cd6"],

