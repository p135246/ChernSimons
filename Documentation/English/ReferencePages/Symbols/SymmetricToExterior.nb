Cell["A two-factor symmetric product in the exterior picture:", "ExampleText",ExpressionUUID->"7cdd1bbb-258d-4453-bd31-ce4e8e10172a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"SymmetricToExterior", "[", 
  RowBox[{
   RowBox[{"SymmetricProduct", "[", 
    RowBox[{
     RowBox[{"CyclicWord", "[", 
      RowBox[{"{", "x", "}"}], "]"}], ",", " ", 
     RowBox[{"CyclicWord", "[", 
      RowBox[{"{", "y", "}"}], "]"}]}], "]"}], ",", " ", 
   RowBox[{"GradedPairing", "[", 
    RowBox[{
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"x", " ", "->", " ", 
        RowBox[{"-", "1"}]}], ",", " ", 
       RowBox[{"y", " ", "->", " ", "0"}]}], "|>"}], ",", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "y"}], "}"}], " ", "->", " ", "1"}], "|>"}]}], 
    "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"4bba6f1c-47cb-4d63-80a9-b4cf10c2e2a2"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{
   InterpretationBox[
    RowBox[{"(", "x", ")"}],
    ChernSimons`CyclicWord[{MTNB$sy3bmw54lvpi`x}],
    Editable->False], "\[Wedge]", 
   InterpretationBox[
    RowBox[{"(", "y", ")"}],
    ChernSimons`CyclicWord[{MTNB$sy3bmw54lvpi`y}],
    Editable->False]}],
  ChernSimons`ExteriorProduct[
   ChernSimons`CyclicWord[{MTNB$sy3bmw54lvpi`x}], 
   ChernSimons`CyclicWord[{MTNB$sy3bmw54lvpi`y}]],
  Editable->False]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"92076c98-4ba7-4fad-a42c-d68cfef67a28"]
}, Open  ]],

