Cell[CellGroupData[{
Cell["SymmetricToExterior", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"e47fda25-6b18-423c-9926-9dd73686f99e"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["SymmetricToExterior"]], 
     "paclet:ChernSimons/ref/SymmetricToExterior", 
     "ChernSimons Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["e", "TI"], ",", " ", 
    StyleBox["pairing", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "d37f7f78-2670-47e2-9b5b-fcf4ec78aac3"],
 "\[LineSeparator]",
 "gives the exterior product that corresponds to the symmetric product ",
 StyleBox["e", "TI"],
 ", with the sign of the reversal rule.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"bda4bbed-5212-453a-9ed0-eefbe6106b81"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["SymmetricToExterior"]], 
     "paclet:ChernSimons/ref/SymmetricToExterior", 
     "ChernSimons Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["e", "TI"], ",", " ", 
    StyleBox["pairing", "TI"], ",", " ", 
    StyleBox["rule", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "082cc6f5-3814-45e3-be36-371d0fc95c51"],
 "\[LineSeparator]",
 "gives it with the sign of ",
 StyleBox["rule", "TI"],
 ", ",
 Cell[BoxData["\"\<Reversal\>\""], "InlineFormula",ExpressionUUID->
  "f9d8563d-16bc-46b7-ba16-f1570e4d5454"],
 " or ",
 Cell[BoxData["\"\<Position\>\""], "InlineFormula",ExpressionUUID->
  "6fd6db65-c1eb-419a-b727-7f831e5c3891"],
 "."
}], "Usage",ExpressionUUID->"6214fefe-f2a4-487c-9442-2c9b6ab4aa08"],

Cell[TextData[{
 "The symmetric and the exterior products are graded by ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    RowBox[{"[", "-", "]"}], "1"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"c2b2e50e-2989-4830-bb96-1a17e646d243"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"[", "-", "]"}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "ebf330fc-7f17-46f1-8a86-22f16e2e338b"],
 ", one apart, and the decalage isomorphism between them carries a sign."
}], "Notes",
 CellFrameLabels->{{Inherited, Inherited}, {Inherited, 
    Cell[
     TextData[{
      "26.09.30: Design review - SymmetricToExterior and ExteriorToSymmetric \
replace ShiftIsomorphism and its \"Inverse\" option (Pavel, 2026-09-30), so \
that each name says which way it converts. The direction is set by the \
function, never by the \"Convention\" key of the pairing, so both take any \
pairing, and a product of the other head returns unevaluated. The sign rule \
is the option \"Rule\", and the positional third argument of ShiftIsomorphism \
stays as a shortcut for it. The reversal rule is the default because it is \
the rule that intertwines CanonicalLieBracket and CanonicalLieCobracket in \
every arity; the position rule is kept so that the difference between the two \
can be examined rather than assumed. The rules are \"Reversal\" and \
\"Position\", in the third argument and in the option; since R7 (Pavel, \
2026-10-01) any other value returns unevaluated, where before every string \
but \"Position\" gave the reversal sign. A cyclic word is a product of one \
factor, the rule every product of the paclet follows. Alternative name \
considered: ShiftIsomorphism. Prior art: the Wolfram Language has Wedge and \
TensorWedge but no graded symmetric algebra of cyclic words and no decalage \
isomorphism; the engine the verification suites load pins both rules on every \
tuple of words to length 3.", "\n\n", 
       Cell[
        BoxData[
         GridBox[{{
            Cell[
             BoxData[
              ButtonBox[
               DynamicBox[
                FEPrivate`FrontEndResource[
                "DocumentationToolsStrings", "Edit"]], BaseStyle -> 
               "TextAnnotationButton"]]], 
            StyleBox[
             RowBox[{
               DynamicBox[
                FEPrivate`FrontEndResource[
                "DocumentationToolsStrings", "LastAnnotator"]], "pavel"}], 
             "TextAnnotator"], 
            Cell[
             BoxData[
              ButtonBox[
               DynamicBox[
                FEPrivate`FrontEndResource[
                "DocumentationToolsStrings", "Delete"]], BaseStyle -> 
               "TextAnnotationRemoveButton"]]], ""}}, 
          GridBoxAlignment -> {
           "Columns" -> {Left, Left, Right, Right}, "Rows" -> {{Automatic}}}, 
          GridBoxItemSize -> {"Columns" -> {
              Scaled[0.15], 
              Scaled[0.68], 
              Scaled[0.15], 
              Scaled[0.02]}}]]], "\n"}], "TextAnnotation", 
     CellSize -> {590, Inherited}]}},
 CellTags->"TextAnnotation",
 CellID->471643182,ExpressionUUID->"76ba8e19-2d88-4b7f-bc71-2acf5b4723a3"],

Cell[TextData[{
 "The map sends ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["f", "TI"], "1"], "\[CircleDot]", "\[CenterEllipsis]", "\[CircleDot]", 
    SubscriptBox[
     StyleBox["f", "TI"], 
     StyleBox["k", "TI"]]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"8b0108e6-eac5-4e38-95e8-8b1c8596e325"],
 " to ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[PlusMinus]", 
    SubscriptBox[
     StyleBox["f", "TI"], "1"], "\[Wedge]", "\[CenterEllipsis]", "\[Wedge]", 
    SubscriptBox[
     StyleBox["f", "TI"], 
     StyleBox["k", "TI"]]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"eeb7f7fd-b785-497e-a3c3-ba4f388ba95f"],
 ", with the sign ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"-", "1"}], ")"}], 
    RowBox[{
     UnderscriptBox["\[Sum]", 
      StyleBox["i", "TI"],
      LimitsPositioning->True], 
     RowBox[{"(", 
      RowBox[{
       StyleBox["k", "TI"], "-", 
       StyleBox["i", "TI"]}], ")"}], 
     RowBox[{"[", 
      SubscriptBox[
       StyleBox["f", "TI"], 
       StyleBox["i", "TI"]], "]"}]}]], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"d5b4e52b-88cc-47fd-9210-9c47d4597a2a"],
 " of the reversal rule or ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"-", "1"}], ")"}], 
    RowBox[{
     UnderscriptBox["\[Sum]", 
      StyleBox["i", "TI"],
      LimitsPositioning->True], 
     StyleBox["i", "TI"], 
     RowBox[{"[", 
      SubscriptBox[
       StyleBox["f", "TI"], 
       StyleBox["i", "TI"]], "]"}]}]], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"8b8d31aa-2f94-439b-b3b7-e0a71d58894f"],
 " of the position rule, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"[", 
    StyleBox["f", "TI"], "]"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"c5e2cfe1-2654-4a69-bc5d-7e1f82a7c033"],
 " being the exterior degree of ",
 Cell[BoxData[
  FormBox[
   StyleBox["f", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "2f74d5ee-222b-4362-87c5-908c076e68fa"],
 "."
}], "Notes",ExpressionUUID->"f2f1c41d-f54b-4788-84f0-0d189e067c7f"],

Cell[TextData[{
 "The reversal rule intertwines ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CanonicalLieBracket"]], 
    "paclet:ChernSimons/ref/CanonicalLieBracket", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "f96bc545-aab9-4e21-a1cc-251a9ac679f2"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CanonicalLieCobracket"]], 
    "paclet:ChernSimons/ref/CanonicalLieCobracket", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "a943e37d-33f5-4683-851d-b173c29e58ba"],
 " in every arity; the position rule does not."
}], "Notes",ExpressionUUID->"d094bc96-3657-41dc-8c8c-2c52d67af4b3"],

Cell[TextData[{
 "The two rules differ by the sign ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"-", "1"}], ")"}], 
    RowBox[{
     StyleBox["k", "TI"], 
     UnderscriptBox["\[Sum]", 
      StyleBox["i", "TI"],
      LimitsPositioning->True], 
     RowBox[{"[", 
      SubscriptBox[
       StyleBox["f", "TI"], 
       StyleBox["i", "TI"]], "]"}]}]], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"2337d771-22c3-4044-94a6-b0f24e9f13da"],
 ". They agree on every product of an even number of factors, and on an odd \
number of factors they differ exactly when the total exterior degree is odd."
}], "Notes",ExpressionUUID->"f77a9475-0bc6-4258-b737-af51a8d9c6e0"],

Cell[TextData[{
 "The map is linear, and ",
 Cell[BoxData[
 "HBar"], "InlineFormula",ExpressionUUID->
  "c349c7e3-264f-4a89-b6bd-81bf53513f86"],
 " is a scalar to it."
}], "Notes",ExpressionUUID->"5daa58c1-704c-4d5a-8a75-bbc45ac985f0"],

Cell["\<\
A cyclic word is taken as a product of one factor, and a word may be given as \
the list of its letters.\
\>", "Notes",ExpressionUUID->"bfe21a88-a819-4bc0-917d-fdf1e0177d8e"],

Cell[TextData[{
 "The direction is set by the function alone, not by the ",
 Cell[BoxData["\"\<Convention\>\""], "InlineFormula",ExpressionUUID->
  "e465edd9-c529-4ca4-9e36-e4be39339383"],
 " key of ",
 StyleBox["pairing", "TI"],
 ". An ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ExteriorProduct"]], "paclet:ChernSimons/ref/ExteriorProduct", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "3e01175a-5e79-43ef-b16b-8382b4c0e12d"],
 " returns unevaluated."
}], "Notes",ExpressionUUID->"b18a44d1-18b6-42a4-ab81-4d364a9f6c73"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ExteriorToSymmetric"]], 
    "paclet:ChernSimons/ref/ExteriorToSymmetric", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "e98a31ce-0587-47e7-8311-dfd1617af172"],
 " is the inverse map, with either rule."
}], "Notes",ExpressionUUID->"2ab78a75-93a5-4a80-9909-fb5a42a65a1f"],

