 Cell[BoxData[
 "HBar"], "InlineFormula",ExpressionUUID->
  "efbb2154-d5b9-4245-9bf7-6a582837686e"],
 " among them, is sent term by term:"
}], "ExampleText",ExpressionUUID->"fb520dbb-92ce-4802-bcf5-fc3554749e5c"],

