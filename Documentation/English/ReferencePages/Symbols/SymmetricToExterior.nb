Cell[CellGroupData[{
Cell["SymmetricToExterior", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"e835039d-c14e-4587-912d-24978360de8d"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["SymmetricToExterior"]], 
     "paclet:ChernSimons/ref/SymmetricToExterior", 
     "ChernSimons Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["e", "TI"], ",", " ", 
    StyleBox["pairing", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9dd94607-9403-4148-8f58-dfaec3ca6839"],
 "\[LineSeparator]",
 "gives the exterior product that corresponds to the symmetric product ",
 StyleBox["e", "TI"],
 ", with the sign of the reversal rule.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"bc4ac514-812a-46ec-bd6c-5b45e6ff94c6"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["SymmetricToExterior"]], 
     "paclet:ChernSimons/ref/SymmetricToExterior", 
     "ChernSimons Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["e", "TI"], ",", " ", 
    StyleBox["pairing", "TI"], ",", " ", 
    StyleBox["rule", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5774664c-582d-42d6-be40-71d3cd0b5444"],
 "\[LineSeparator]",
 "gives it with the sign of ",
 StyleBox["rule", "TI"],
 ", ",
 Cell[BoxData["\"\<Reversal\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "add6378b-6583-4732-8f7e-fb70807b9c5b"],
 " or ",
 Cell[BoxData["\"\<Position\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "691f0c68-27e8-4f30-a39a-5729381a6e25"],
 "."
}], "Usage",ExpressionUUID->"6125597b-4d65-4885-91fb-3ceaa3841729"],

Cell[TextData[{
 "The symmetric and the exterior products are graded by ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    RowBox[{"[", "-", "]"}], "1"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3e43ad60-4cc8-4de6-ade1-47dbc85d0950"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"[", "-", "]"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c6b19555-40b5-4338-a854-aadf7e66158c"],
 ", one apart, and the decalage isomorphism between them carries a sign."
}], "Notes",
 CellFrameLabels->{{Inherited, Inherited}, {Inherited, 
    Cell[
     TextData[{
      "26.09.30: Design review - SymmetricToExterior and ExteriorToSymmetric \
replace ShiftIsomorphism and its \"Inverse\" option (Pavel, 2026-09-30), so \
that each name says which way it converts. The direction is set by the \
function, never by the \"Convention\" key of the pairing, so both take any \
pairing, and a product of the other head returns unevaluated. The sign rule \
is the option \"Rule\", and the positional third argument of ShiftIsomorphism \
stays as a shortcut for it. The reversal rule is the default because it is \
the rule that intertwines StringBracket and StringCobracket in every arity; \
the position rule is kept so that the difference between the two can be \
examined rather than assumed. The rules are \"Reversal\" and \"Position\", in \
the third argument and in the option; since R7 (Pavel, 2026-10-01) any other \
value returns unevaluated, where before every string but \"Position\" gave \
the reversal sign. A cyclic word is a product of one factor, the rule every \
product of the paclet follows. Alternative name considered: ShiftIsomorphism. \
Prior art: the Wolfram Language has Wedge and TensorWedge but no graded \
symmetric algebra of cyclic words and no decalage isomorphism; the engine the \
verification suites load pins both rules on every tuple of words to length \
3.", "\n\n", 
       Cell[
        BoxData[
         GridBox[{{
            Cell[
             BoxData[
              ButtonBox[
               DynamicBox[
                FEPrivate`FrontEndResource[
                "DocumentationToolsStrings", "Edit"]], BaseStyle -> 
               "TextAnnotationButton"]]], 
            StyleBox[
             RowBox[{
               DynamicBox[
                FEPrivate`FrontEndResource[
                "DocumentationToolsStrings", "LastAnnotator"]], "pavel"}], 
             "TextAnnotator"], 
            Cell[
             BoxData[
              ButtonBox[
               DynamicBox[
                FEPrivate`FrontEndResource[
                "DocumentationToolsStrings", "Delete"]], BaseStyle -> 
               "TextAnnotationRemoveButton"]]], ""}}, 
          GridBoxAlignment -> {
           "Columns" -> {Left, Left, Right, Right}, "Rows" -> {{Automatic}}}, 
          GridBoxItemSize -> {"Columns" -> {
              Scaled[0.15], 
              Scaled[0.68], 
              Scaled[0.15], 
              Scaled[0.02]}}]]], "\n"}], "TextAnnotation", 
     CellSize -> {590, Inherited}]}},
 CellTags->"TextAnnotation",
 CellID->812005225,ExpressionUUID->"7ec8ace7-3c77-422b-9aa1-998e0010e465"],

Cell[TextData[{
 "The map sends ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["f", "TI"], "1"], "\[CircleDot]", "\[CenterEllipsis]", "\[CircleDot]", 
    SubscriptBox[
     StyleBox["f", "TI"], 
     StyleBox["k", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e68938d5-6f95-4daf-a329-55a8d8f155fb"],
 " to ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[PlusMinus]", 
    SubscriptBox[
     StyleBox["f", "TI"], "1"], "\[Wedge]", "\[CenterEllipsis]", "\[Wedge]", 
    SubscriptBox[
     StyleBox["f", "TI"], 
     StyleBox["k", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0e4e3f40-31bd-47fa-a12b-0eb4cee5e6db"],
 ", with the sign ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"-", "1"}], ")"}], 
    RowBox[{
     UnderscriptBox["\[Sum]", 
      StyleBox["i", "TI"],
      LimitsPositioning->True], 
     RowBox[{"(", 
      RowBox[{
       StyleBox["k", "TI"], "-", 
       StyleBox["i", "TI"]}], ")"}], 
     RowBox[{"[", 
      SubscriptBox[
       StyleBox["f", "TI"], 
       StyleBox["i", "TI"]], "]"}]}]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "62f2791b-d3ab-4712-ac7c-7e11941fca40"],
 " of the reversal rule or ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"-", "1"}], ")"}], 
    RowBox[{
     UnderscriptBox["\[Sum]", 
      StyleBox["i", "TI"],
      LimitsPositioning->True], 
     StyleBox["i", "TI"], 
     RowBox[{"[", 
      SubscriptBox[
       StyleBox["f", "TI"], 
       StyleBox["i", "TI"]], "]"}]}]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ab616e12-604c-48b3-b570-62c2506fd69f"],
 " of the position rule, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"[", 
    StyleBox["f", "TI"], "]"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7edea4ac-148f-411b-acfc-a52705498866"],
 " being the exterior degree of ",
 Cell[BoxData[
  FormBox[
   StyleBox["f", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "03b58c81-f998-4edc-bc38-84edf8d1d2cc"],
 "."
}], "Notes",ExpressionUUID->"aa043c83-8ad5-4736-8db0-4bbe0c36a919"],

Cell[TextData[{
 "The reversal rule intertwines ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["StringBracket"]], "paclet:ChernSimons/ref/StringBracket", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "8591d3c3-30ac-48e2-945b-9faaba6262b9"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["StringCobracket"]], "paclet:ChernSimons/ref/StringCobracket", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "97256064-f810-4ec7-b3e7-cd54848215a6"],
 " in every arity; the position rule does not."
}], "Notes",ExpressionUUID->"dd3f48c8-4784-4349-86de-820a0c6395d8"],

Cell[TextData[{
 "The two rules differ by the sign ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"-", "1"}], ")"}], 
    RowBox[{
     StyleBox["k", "TI"], 
     UnderscriptBox["\[Sum]", 
      StyleBox["i", "TI"],
      LimitsPositioning->True], 
     RowBox[{"[", 
      SubscriptBox[
       StyleBox["f", "TI"], 
       StyleBox["i", "TI"]], "]"}]}]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d76c03f4-c63e-4078-8be8-d86c18b343e7"],
 ". They agree on every product of an even number of factors, and on an odd \
number of factors they differ exactly when the total exterior degree is odd."
}], "Notes",ExpressionUUID->"dcf8ca0c-841b-49c0-99c3-8ddac8d751b7"],

Cell[TextData[{
 "The map is linear, and ",
 Cell[BoxData["HBar"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e1ea8f6f-9984-46f1-a94a-37b852084e70"],
 " is a scalar to it."
}], "Notes",ExpressionUUID->"189862e4-69f1-4061-92e1-8bf3dde69989"],

Cell["\<\
A cyclic word is taken as a product of one factor, and a word may be given as \
the list of its particles.\
\>", "Notes",ExpressionUUID->"8133720a-017f-4a92-92a4-3c40d22e4617"],

Cell[TextData[{
 "The direction is set by the function alone, not by the ",
 Cell[BoxData["\"\<Convention\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "87e6d3b0-283e-4399-b520-433b36e5f262"],
 " key of ",
 StyleBox["pairing", "TI"],
 ". An ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ExteriorProduct"]], "paclet:ChernSimons/ref/ExteriorProduct", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "b9646c53-36d6-4721-9f77-62682d9b8db3"],
 " returns unevaluated."
}], "Notes",ExpressionUUID->"bf2cef1f-b988-4b8a-97bb-c7b969305606"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ExteriorToSymmetric"]], 
    "paclet:ChernSimons/ref/ExteriorToSymmetric", 
