Cell[CellGroupData[{
Cell["SymmetricToExterior", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"4d57c4a3-62ef-499a-a3cb-6b6556a87591"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["SymmetricToExterior"]], 
     "paclet:ChernSimons/ref/SymmetricToExterior", 
     "ChernSimons Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["e", "TI"], ",", " ", 
    StyleBox["pairing", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4f01620e-9b07-4044-a0c6-525267239413"],
 "\[LineSeparator]",
 "gives the exterior product that corresponds to the symmetric product ",
 StyleBox["e", "TI"],
 ", with the sign of the reversal rule.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"35b9f91d-4fb0-4e00-bb14-fed4c66fee8d"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["SymmetricToExterior"]], 
     "paclet:ChernSimons/ref/SymmetricToExterior", 
     "ChernSimons Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["e", "TI"], ",", " ", 
    StyleBox["pairing", "TI"], ",", " ", 
    StyleBox["rule", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ffbb1153-e632-4e4d-ae1e-9dea5f4893c0"],
 "\[LineSeparator]",
 "gives it with the sign of ",
 StyleBox["rule", "TI"],
 ", ",
 Cell[BoxData["\"\<Reversal\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "df6e6409-d147-4433-964c-cfacc5bd187d"],
 " or ",
 Cell[BoxData["\"\<Position\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "097cf0b1-d9db-4462-8e92-b5d1ba175862"],
 "."
}], "Usage",ExpressionUUID->"3104a4e3-90dc-4568-8560-fb00dd3509cb"],

Cell[TextData[{
 "The symmetric and the exterior products are graded by ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    RowBox[{"[", "-", "]"}], "1"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "280fbeb5-8ea5-48b9-9cf6-f58f2476a03a"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"[", "-", "]"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8a85405a-e5f4-456b-a8b9-6b96f0c58a69"],
 ", one apart, and the decalage isomorphism between them carries a sign."
}], "Notes",
 CellFrameLabels->{{Inherited, Inherited}, {Inherited, 
    Cell[
     TextData[{
      "26.09.30: Design review - SymmetricToExterior and ExteriorToSymmetric \
replace ShiftIsomorphism and its \"Inverse\" option (Pavel, 2026-09-30), so \
that each name says which way it converts. The direction is set by the \
function, never by the \"Convention\" key of the pairing, so both take any \
pairing, and a product of the other head returns unevaluated. The sign rule \
is the option \"Rule\", and the positional third argument of ShiftIsomorphism \
stays as a shortcut for it. The reversal rule is the default because it is \
the rule that intertwines CanonicalLieBracket and CanonicalLieCobracket in \
every arity; the position rule is kept so that the difference between the two \
can be examined rather than assumed. The rules are \"Reversal\" and \
\"Position\", in the third argument and in the option; since R7 (Pavel, \
2026-10-01) any other value returns unevaluated, where before every string \
but \"Position\" gave the reversal sign. A cyclic word is a product of one \
factor, the rule every product of the paclet follows. Alternative name \
considered: ShiftIsomorphism. Prior art: the Wolfram Language has Wedge and \
TensorWedge but no graded symmetric algebra of cyclic words and no decalage \
isomorphism; the engine the verification suites load pins both rules on every \
tuple of words to length 3.", "\n\n", 
       Cell[
        BoxData[
         GridBox[{{
            Cell[
             BoxData[
              ButtonBox[
               DynamicBox[
                FEPrivate`FrontEndResource[
                "DocumentationToolsStrings", "Edit"]], BaseStyle -> 
               "TextAnnotationButton"]]], 
            StyleBox[
             RowBox[{
               DynamicBox[
                FEPrivate`FrontEndResource[
                "DocumentationToolsStrings", "LastAnnotator"]], "pavel"}], 
             "TextAnnotator"], 
            Cell[
             BoxData[
              ButtonBox[
               DynamicBox[
                FEPrivate`FrontEndResource[
                "DocumentationToolsStrings", "Delete"]], BaseStyle -> 
               "TextAnnotationRemoveButton"]]], ""}}, 
          GridBoxAlignment -> {
           "Columns" -> {Left, Left, Right, Right}, "Rows" -> {{Automatic}}}, 
          GridBoxItemSize -> {"Columns" -> {
              Scaled[0.15], 
              Scaled[0.68], 
              Scaled[0.15], 
              Scaled[0.02]}}]]], "\n"}], "TextAnnotation", 
     CellSize -> {590, Inherited}]}},
 CellTags->"TextAnnotation",
 CellID->712399213,ExpressionUUID->"911e1524-9784-481d-9df1-cbc7a94da054"],

Cell[TextData[{
 "The map sends ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["f", "TI"], "1"], "\[CircleDot]", "\[CenterEllipsis]", "\[CircleDot]", 
    SubscriptBox[
     StyleBox["f", "TI"], 
     StyleBox["k", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1ab2be56-161b-46e5-87ca-a26fb04f97cb"],
 " to ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[PlusMinus]", 
    SubscriptBox[
     StyleBox["f", "TI"], "1"], "\[Wedge]", "\[CenterEllipsis]", "\[Wedge]", 
    SubscriptBox[
     StyleBox["f", "TI"], 
     StyleBox["k", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ede30a27-d326-450b-9bcc-645a8bff18c6"],
 ", with the sign ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"-", "1"}], ")"}], 
    RowBox[{
     UnderscriptBox["\[Sum]", 
      StyleBox["i", "TI"],
      LimitsPositioning->True], 
     RowBox[{"(", 
      RowBox[{
       StyleBox["k", "TI"], "-", 
       StyleBox["i", "TI"]}], ")"}], 
     RowBox[{"[", 
      SubscriptBox[
       StyleBox["f", "TI"], 
       StyleBox["i", "TI"]], "]"}]}]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f5ce5d1a-955e-4a56-99dc-d35cac131a6b"],
 " of the reversal rule or ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"-", "1"}], ")"}], 
    RowBox[{
     UnderscriptBox["\[Sum]", 
      StyleBox["i", "TI"],
      LimitsPositioning->True], 
     StyleBox["i", "TI"], 
     RowBox[{"[", 
      SubscriptBox[
       StyleBox["f", "TI"], 
       StyleBox["i", "TI"]], "]"}]}]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "98b8b7b4-c84e-4fb3-995b-1574d3c256f1"],
 " of the position rule, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"[", 
    StyleBox["f", "TI"], "]"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "831d3410-cdf1-4219-9f35-60d07482131d"],
 " being the exterior degree of ",
 Cell[BoxData[
  FormBox[
   StyleBox["f", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "03a12f17-43f1-46c6-b99c-a89ae0f2f27f"],
 "."
}], "Notes",ExpressionUUID->"f21b5a35-540a-4d10-a0de-3c11faf6f2dd"],

Cell[TextData[{
 "The reversal rule intertwines ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CanonicalLieBracket"]], 
    "paclet:ChernSimons/ref/CanonicalLieBracket", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "d9585032-9fa7-4855-b7f2-4898fa98fc8e"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CanonicalLieCobracket"]], 
    "paclet:ChernSimons/ref/CanonicalLieCobracket", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "135ddeca-382d-46be-aa47-0b08a9a4e832"],
 " in every arity; the position rule does not."
}], "Notes",ExpressionUUID->"b753652e-c6c6-4948-b992-23d211ca1269"],

Cell[TextData[{
 "The two rules differ by the sign ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"-", "1"}], ")"}], 
    RowBox[{
     StyleBox["k", "TI"], 
     UnderscriptBox["\[Sum]", 
      StyleBox["i", "TI"],
      LimitsPositioning->True], 
     RowBox[{"[", 
      SubscriptBox[
       StyleBox["f", "TI"], 
       StyleBox["i", "TI"]], "]"}]}]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "35cc62f4-936a-4ba1-b4e3-af9d0321fda0"],
 ". They agree on every product of an even number of factors, and on an odd \
number of factors they differ exactly when the total exterior degree is odd."
}], "Notes",ExpressionUUID->"99739a2c-d4f5-49c8-9ca2-da2f855e9229"],

Cell[TextData[{
 "The map is linear, and ",
 Cell[BoxData["HBar"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "46548b56-a586-4723-97ad-1cf916da6d33"],
 " is a scalar to it."
}], "Notes",ExpressionUUID->"ea827ff6-78bc-4a8e-9672-94691c64fcda"],

Cell["\<\
A cyclic word is taken as a product of one factor, and a word may be given as \
the list of its particles.\
\>", "Notes",ExpressionUUID->"4d115ad8-36e1-43f4-a570-8add74af64b8"],

Cell[TextData[{
 "The direction is set by the function alone, not by the ",
 Cell[BoxData["\"\<Convention\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "49ad78b0-6ff3-48f4-9135-6062884dc3f8"],
 " key of ",
 StyleBox["pairing", "TI"],
 ". An ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ExteriorProduct"]], "paclet:ChernSimons/ref/ExteriorProduct", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "c24645ff-8cc4-495f-88d4-7770131325a1"],
 " returns unevaluated."
}], "Notes",ExpressionUUID->"3815f81c-600f-4912-be61-3138333b3cb0"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
