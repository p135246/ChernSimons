Cell["A two-factor symmetric product in the exterior picture:", "ExampleText",ExpressionUUID->"22b67532-75c7-4409-8cd6-fbf5f7d7c33a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"SymmetricToExterior", "[", 
  RowBox[{
   RowBox[{"SymmetricProduct", "[", 
    RowBox[{
     RowBox[{"CyclicWord", "[", 
      RowBox[{"{", "x", "}"}], "]"}], ",", " ", 
     RowBox[{"CyclicWord", "[", 
      RowBox[{"{", "y", "}"}], "]"}]}], "]"}], ",", " ", 
   RowBox[{"GradedPairing", "[", 
    RowBox[{
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"x", " ", "->", " ", 
        RowBox[{"-", "1"}]}], ",", " ", 
       RowBox[{"y", " ", "->", " ", "0"}]}], "|>"}], ",", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "y"}], "}"}], " ", "->", " ", "1"}], "|>"}]}], 
    "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"20b8cbfc-3de4-40cf-b4e0-c0e467af9828"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{
   InterpretationBox[
    RowBox[{"(", "x", ")"}],
    ChernSimons`CyclicWord[{MTNB$sy3bmw54lvpi`x}],
    Editable->False], "\[Wedge]", 
   InterpretationBox[
    RowBox[{"(", "y", ")"}],
    ChernSimons`CyclicWord[{MTNB$sy3bmw54lvpi`y}],
    Editable->False]}],
  ChernSimons`ExteriorProduct[
   ChernSimons`CyclicWord[{MTNB$sy3bmw54lvpi`x}], 
   ChernSimons`CyclicWord[{MTNB$sy3bmw54lvpi`y}]],
  Editable->False]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"180f9e61-a069-47d4-8b5a-fa1cca35483c"]
}, Open  ]],

