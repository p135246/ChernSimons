   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "4b2f4a04-5c94-439f-8f2b-a50ca9299763"],
 " is the inverse map, with either rule."
}], "Notes",ExpressionUUID->"bcbc158c-3363-4af9-bcc7-8673dca1a23e"],

