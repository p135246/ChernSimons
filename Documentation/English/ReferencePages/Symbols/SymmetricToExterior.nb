Cell["A two-factor symmetric product in the exterior picture:", "ExampleText",ExpressionUUID->"6f3323c6-de47-4dba-8a95-2bcfc1148259"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"SymmetricToExterior", "[", 
  RowBox[{
   RowBox[{"SymmetricProduct", "[", 
    RowBox[{
     RowBox[{"CyclicWord", "[", 
      RowBox[{"{", "x", "}"}], "]"}], ",", " ", 
     RowBox[{"CyclicWord", "[", 
      RowBox[{"{", "y", "}"}], "]"}]}], "]"}], ",", " ", 
   RowBox[{"GradedPairing", "[", 
    RowBox[{
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"x", " ", "->", " ", 
        RowBox[{"-", "1"}]}], ",", " ", 
       RowBox[{"y", " ", "->", " ", "0"}]}], "|>"}], ",", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "y"}], "}"}], " ", "->", " ", "1"}], "|>"}]}], 
    "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"cf33cc32-2558-4d55-aaa4-2e85a7ed6309"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{
   InterpretationBox[
    RowBox[{"(", "x", ")"}],
    ChernSimons`CyclicWord[{MTNB$sy3bmw54lvpi`x}],
    Editable->False], "\[Wedge]", 
   InterpretationBox[
