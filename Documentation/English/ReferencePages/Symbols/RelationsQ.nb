Cell["\<\
A strictly associative algebra is an A-infinity algebra in the shifted \
convention:\
\>", "ExampleText",ExpressionUUID->"48b45131-3caa-4dad-8e49-5f791fb79c5e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"RelationsQ", "[", 
  RowBox[{
   RowBox[{"AInfinityAlgebra", "[", 
    RowBox[{
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"u", " ", "->", " ", 
        RowBox[{"-", "1"}]}], ",", " ", 
       RowBox[{"v", " ", "->", " ", 
        RowBox[{"-", "1"}]}]}], "|>"}], ",", " ", 
     RowBox[{"t", " ", "|->", " ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Length", "[", "t", "]"}], " ", "===", " ", "2"}], ",", " ", 
        
        RowBox[{"Switch", "[", 
         RowBox[{"t", ",", " ", 
          RowBox[{"{", 
           RowBox[{"u", ",", " ", "u"}], "}"}], ",", " ", "u", ",", " ", 
          RowBox[{"{", 
           RowBox[{"u", ",", " ", "v"}], "}"}], ",", " ", "v", ",", " ", 
          RowBox[{"{", 
           RowBox[{"v", ",", " ", "u"}], "}"}], ",", " ", "v", ",", " ", "_", 
          ",", " ", "0"}], "]"}], ",", " ", "0"}], "]"}]}]}], "]"}], ",", " ",
    "4"}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"8195713b-ff1d-453b-8fd6-cca2e1723a59"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"ac3de7e3-7950-4acb-bbb8-890ac9b25b1e"]
}, Open  ]]
}, Open  ]]
}, Open  ]],

