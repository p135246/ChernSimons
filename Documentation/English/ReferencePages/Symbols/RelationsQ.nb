Cell["\<\
A strictly associative algebra is an A-infinity algebra in the shifted \
convention:\
\>", "ExampleText",ExpressionUUID->"acb737df-7a97-4249-9c33-ea5300b5d250"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"RelationsQ", "[", 
  RowBox[{
   RowBox[{"AInfinityAlgebra", "[", 
    RowBox[{
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"u", " ", "->", " ", 
        RowBox[{"-", "1"}]}], ",", " ", 
       RowBox[{"v", " ", "->", " ", 
        RowBox[{"-", "1"}]}]}], "|>"}], ",", " ", 
     RowBox[{"t", " ", "|->", " ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Length", "[", "t", "]"}], " ", "===", " ", "2"}], ",", " ", 
        
        RowBox[{"Switch", "[", 
         RowBox[{"t", ",", " ", 
          RowBox[{"{", 
           RowBox[{"u", ",", " ", "u"}], "}"}], ",", " ", "u", ",", " ", 
          RowBox[{"{", 
           RowBox[{"u", ",", " ", "v"}], "}"}], ",", " ", "v", ",", " ", 
          RowBox[{"{", 
           RowBox[{"v", ",", " ", "u"}], "}"}], ",", " ", "v", ",", " ", "_", 
          ",", " ", "0"}], "]"}], ",", " ", "0"}], "]"}]}]}], "]"}], ",", " ",
    "4"}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"79b106dd-0f5c-4fd2-8a9f-3f4fffad74ac"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"65125390-e3cd-490a-addd-9290a6788aca"]
}, Open  ]]
}, Open  ]]
}, Open  ]],

