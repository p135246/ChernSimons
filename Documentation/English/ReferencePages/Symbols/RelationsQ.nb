Cell["\<\
A strictly associative algebra is an A-infinity algebra in the shifted \
convention:\
\>", "ExampleText",ExpressionUUID->"9772ce60-7e5a-40fa-8845-a1c5670651c9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"RelationsQ", "[", 
  RowBox[{
   RowBox[{"AInfinityAlgebra", "[", 
    RowBox[{
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"u", " ", "->", " ", 
        RowBox[{"-", "1"}]}], ",", " ", 
       RowBox[{"v", " ", "->", " ", 
        RowBox[{"-", "1"}]}]}], "|>"}], ",", " ", 
     RowBox[{"t", " ", "|->", " ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Length", "[", "t", "]"}], " ", "===", " ", "2"}], ",", " ", 
        
        RowBox[{"Switch", "[", 
         RowBox[{"t", ",", " ", 
          RowBox[{"{", 
           RowBox[{"u", ",", " ", "u"}], "}"}], ",", " ", "u", ",", " ", 
          RowBox[{"{", 
           RowBox[{"u", ",", " ", "v"}], "}"}], ",", " ", "v", ",", " ", 
          RowBox[{"{", 
           RowBox[{"v", ",", " ", "u"}], "}"}], ",", " ", "v", ",", " ", "_", 
          ",", " ", "0"}], "]"}], ",", " ", "0"}], "]"}]}]}], "]"}], ",", " ",
    "4"}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"281a2d28-437f-48d0-adfa-b3fb0f83ddbd"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"f3ea8737-d2a9-4953-a101-394edb4fd399"]
}, Open  ]]
}, Open  ]]
}, Open  ]],

