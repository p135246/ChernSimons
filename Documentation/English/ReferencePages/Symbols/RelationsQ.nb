Cell["\<\
A strictly associative algebra is an A-infinity algebra in the shifted \
convention:\
\>", "ExampleText",ExpressionUUID->"21a314a8-6b3b-4d2b-88ca-216b9c6e19ec"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"RelationsQ", "[", 
  RowBox[{
   RowBox[{"AInfinityAlgebra", "[", 
    RowBox[{
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"u", " ", "->", " ", 
        RowBox[{"-", "1"}]}], ",", " ", 
       RowBox[{"v", " ", "->", " ", 
        RowBox[{"-", "1"}]}]}], "|>"}], ",", " ", 
     RowBox[{"t", " ", "|->", " ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Length", "[", "t", "]"}], " ", "===", " ", "2"}], ",", " ", 
        
        RowBox[{"Switch", "[", 
         RowBox[{"t", ",", " ", 
          RowBox[{"{", 
           RowBox[{"u", ",", " ", "u"}], "}"}], ",", " ", "u", ",", " ", 
          RowBox[{"{", 
           RowBox[{"u", ",", " ", "v"}], "}"}], ",", " ", "v", ",", " ", 
          RowBox[{"{", 
           RowBox[{"v", ",", " ", "u"}], "}"}], ",", " ", "v", ",", " ", "_", 
          ",", " ", "0"}], "]"}], ",", " ", "0"}], "]"}]}]}], "]"}], ",", " ",
    "4"}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"9fafd347-6725-40e9-b791-4d2fd0d757aa"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"2531ea56-5e9b-47dc-82c5-404108b89d76"]
}, Open  ]]
}, Open  ]]
}, Open  ]],

