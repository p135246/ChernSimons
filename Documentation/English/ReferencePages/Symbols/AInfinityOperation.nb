       StyleBox["e", "TI"], 
       StyleBox["k", "TI"]]}], "}"}]}], "]"}]], "InlineFormula",
  ExpressionUUID->"7af26d5a-c732-4947-9bf1-b8e57b0db049"],
 "\[LineSeparator]",
 "gives the operation ",
