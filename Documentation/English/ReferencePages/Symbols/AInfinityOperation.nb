  "e7c6c336-b8c0-4b4a-abc5-7d514bcb4b5c"],
 " of ",
 StyleBox["algebra", "TI"],
 " applied to the elements ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["e", "TI"], "1"], ",", "\[Ellipsis]", ",", 
    SubscriptBox[
     StyleBox["e", "TI"], 
