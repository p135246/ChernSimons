Cell["\<\
Sweeping it over an enumerated range of words, every value is zero:\
\>", "ExampleText",ExpressionUUID->"10c9033c-7e8e-4fc7-8bd8-324958f02f28"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"words", "[", "n_", "]"}], " ", ":=", " ", 
   RowBox[{"CyclicWords", "[", 
    RowBox[{"n", ",", " ", 
     RowBox[{"GradedPairing", "[", 
      RowBox[{
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"x", " ", "->", " ", 
          RowBox[{"-", "1"}]}], ",", " ", 
         RowBox[{"y", " ", "->", " ", "0"}]}], "|>"}], ",", " ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"x", ",", " ", "y"}], "}"}], " ", "->", " ", "1"}], 
        "|>"}]}], "]"}], ",", " ", 
     RowBox[{"\"\<UpTo\>\"", " ", "->", " ", "True"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"DeleteDuplicates", "[", 
  RowBox[{"Map", "[", 
   RowBox[{
    RowBox[{"w", " ", "|->", " ", 
     RowBox[{"Expand", "[", 
      RowBox[{"InvolutivityObstruction", "[", 
       RowBox[{"w", ",", " ", 
        RowBox[{"GradedPairing", "[", 
         RowBox[{
          RowBox[{"<|", 
           RowBox[{
            RowBox[{"x", " ", "->", " ", 
             RowBox[{"-", "1"}]}], ",", " ", 
            RowBox[{"y", " ", "->", " ", "0"}]}], "|>"}], ",", " ", 
          RowBox[{"<|", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"x", ",", " ", "y"}], "}"}], " ", "->", " ", "1"}], 
           "|>"}]}], "]"}]}], "]"}], "]"}]}], ",", " ", 
    RowBox[{"words", "[", "5", "]"}]}], "]"}], "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"ae11f7a7-f745-4f51-a8b8-85c6c16c25ea"],

Cell[BoxData[
 RowBox[{"{", "0", "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"3b71f82d-df9c-49db-a1d0-0f864957037e"]
}, Open  ]],

