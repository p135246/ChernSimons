Notebook[{

Cell[CellGroupData[{
Cell["InvolutivityObstruction", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"e444cea4-b011-4801-af69-72e10d12c8c1"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InvolutivityObstruction"]], 
     "paclet:ChernSimons/ref/InvolutivityObstruction", 
     "ChernSimons Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["w", "TI"], ",", " ", 
    StyleBox["pairing", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2ea47ff1-b868-42be-b906-89bf1b2df0f2"],
 "\[LineSeparator]",
 "gives the involutivity obstruction of a cyclic word; ",
 Cell[BoxData[
  FormBox["0", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e6bb81e9-4f9f-4dc6-abcc-3173122d9ad1"],
 " means the identity holds there.",
 "\n"
}], "Usage",ExpressionUUID->"e33be33a-285b-46d2-af0e-fdfbfa166fb6"],

Cell[TextData[{
 "The obstruction is the composite ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     OverscriptBox[
      StyleBox["q", "TI"], "^"], 
     RowBox[{"2", ",", "1", ",", "0"}]], "\[EmptySmallCircle]", 
    SubscriptBox[
     OverscriptBox[
      StyleBox["q", "TI"], "^"], 
     RowBox[{"1", ",", "2", ",", "0"}]]}], TraditionalForm]], "InlineFormula",
  
  FontSize->0.9 Inherited,ExpressionUUID->
  "c3c4e0ff-d6b3-49c1-afd7-ee080f2a5c81"],
 " applied to ",
 StyleBox["w", "TI"],
 " \[LongDash] cut the word in two with ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InvolutiveCobracket"]], 
    "paclet:ChernSimons/ref/InvolutiveCobracket", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "70edba10-4ff2-46eb-ac4b-89f91caf198b"],
 ", then bracket the two pieces back together. Its vanishing is the ",
 StyleBox["involutive", "TI"],
 " in involutive bi-Lie algebra, and it is the identity that fails for a \
general bi-Lie structure."
}], "Notes",ExpressionUUID->"c1f82036-2007-4ef1-9a73-f5a98e349574"],

Cell[TextData[{
 "The convention key of ",
 StyleBox["pairing", "TI"],
 " selects the picture."
}], "Notes",ExpressionUUID->"8f33c02d-9d3d-48d1-992c-4897f1877cd3"],

Cell["\<\
The composite lands back where it started, on a single cyclic word, so the \
obstruction is a word rather than a product.\
\>", "Notes",ExpressionUUID->"17c23d39-4832-4990-b252-18e2f881eddf"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InvolutivityObstruction"]], 
    "paclet:ChernSimons/ref/InvolutivityObstruction", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "fa7131eb-5d27-433f-b4b3-81ecb67162ea"],
 " is the arity-",
 Cell[BoxData[
  FormBox["1", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0f7cd095-d231-4db5-b41f-9cfc54b4f145"],
 " entry of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["$DefiningIdentities"]], 
    "paclet:ChernSimons/ref/$DefiningIdentities", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "c691901a-8f36-4d92-bc97-c8d315113d0d"],
 "."
}], "Notes",ExpressionUUID->"6c50befa-5f87-4dcc-bead-bc0e833b16c0"],

Cell[TextData[{
 "Words with vanishing ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InvolutiveCobracket"]], 
    "paclet:ChernSimons/ref/InvolutiveCobracket", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "92784726-c678-4075-9d08-9898995ac303"],
 " have vanishing obstruction for trivial reasons; over the alphabet of the \
circle the first informative test is at length ",
 Cell[BoxData[
  FormBox["4", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5ddd72dd-04c8-4752-a500-08661346b2d3"],
 "."
}], "Notes",ExpressionUUID->"e15b6982-5e76-479b-8617-ba0cd4140546"]
}, Open  ]],

