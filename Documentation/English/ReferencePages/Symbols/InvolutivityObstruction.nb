    RowBox[{"CyclicWords", "[", 
     RowBox[{"5", ",", " ", "pairing", ",", " ", 
      RowBox[{"\"\<UpTo\>\"", " ", "->", " ", "True"}]}], "]"}]}], "]"}], 
  "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"7a767f3e-6bdb-4bca-aa25-733260d3cefe"],

