Cell["\<\
The identity holds on the shortest word with a nonzero co-bracket:\
\>", "ExampleText",ExpressionUUID->"4bfec729-7f91-46d0-bc07-a9a2babb1681"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"InvolutivityObstruction", "[", 
  RowBox[{
   RowBox[{"CyclicWord", "[", 
    RowBox[{"{", 
     RowBox[{"x", ",", " ", "y", ",", " ", "y", ",", " ", "y"}], "}"}], "]"}],
    ",", " ", 
   RowBox[{"GradedPairing", "[", 
    RowBox[{
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"x", " ", "->", " ", 
        RowBox[{"-", "1"}]}], ",", " ", 
       RowBox[{"y", " ", "->", " ", "0"}]}], "|>"}], ",", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "y"}], "}"}], " ", "->", " ", "1"}], "|>"}]}], 
    "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"9039d11a-f581-4bc0-9fe5-04af0eb6974c"],

Cell[BoxData["0"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"540cb25a-d03c-4bc8-8291-afe65746d940"]
}, Open  ]],

