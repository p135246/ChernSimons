 Cell[BoxData[
  FormBox["0", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "be31418e-b991-4705-9810-756a88847ec4"],
 ", and zero values are ignored."
}], "Notes",ExpressionUUID->"29dfc3d5-59bc-449e-b5e7-4ba312aef1c0"],

Cell[TextData[{
