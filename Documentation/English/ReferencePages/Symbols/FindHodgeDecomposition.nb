Cell[TextData[{
 "The coexact element ",
 Cell[BoxData[
  FormBox[
   StyleBox["b", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d8149751-2f5f-4296-8984-64559cda182c"],
 " has ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{
      StyleBox["b", "TI"], ",", 
      StyleBox["b", "TI"]}], "\[RightAngleBracket]"}], "\[LongEqual]", "1"}], 
   TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "75e7c1a8-c7fa-4ba1-bcf0-af253e172136"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{
      StyleBox["d",
       FontSlant->"Plain"], 
      StyleBox["a", "TI"], ",", 
      StyleBox["b", "TI"]}], "\[RightAngleBracket]"}], "\[LongEqual]", "1"}], 
   TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0a7bea5a-39fe-4800-8349-e904cef9ee7d"],
 ", so the twist is ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{"\[Rho]", 
     RowBox[{"(", 
      StyleBox["b", "TI"], ")"}], "\[LongEqual]", 
     RowBox[{"-", "1"}]}], 
    RowBox[{"2", 
     StyleBox["d",
      FontSlant->"Plain"], 
     StyleBox["a", "TI"]}]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "de86e830-4590-4a23-b671-dff564863578"],
 " and the decomposition replaces ",
 Cell[BoxData[
  FormBox[
   StyleBox["b", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "59cfc3bb-8371-490b-8b03-56bf624ddfd3"],
 " by ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{
     StyleBox["b", "TI"], "-", "1"}], 
    RowBox[{"2", 
     StyleBox["d",
      FontSlant->"Plain"], 
     StyleBox["a", "TI"]}]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b2da932f-b3e4-4800-9607-b4a5b50ae0e5"],
 ":"
}], "ExampleText",ExpressionUUID->"e1e93af9-ec68-4c3e-a1e3-5e8aaa72b140"],

