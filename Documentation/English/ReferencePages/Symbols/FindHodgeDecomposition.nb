Cell[TextData[{
 "The coexact element ",
 Cell[BoxData[
  FormBox[
   StyleBox["b", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "4ffea099-17a7-4134-b980-9aa9c8569a20"],
 " has ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{
      StyleBox["b", "TI"], ",", 
      StyleBox["b", "TI"]}], "\[RightAngleBracket]"}], "\[LongEqual]", "1"}], 
   TraditionalForm]], "InlineFormula",ExpressionUUID->
  "02f78663-923c-4000-b9de-74ec0ac46903"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{
      StyleBox["d",
       FontSlant->"Plain"], 
      StyleBox["a", "TI"], ",", 
      StyleBox["b", "TI"]}], "\[RightAngleBracket]"}], "\[LongEqual]", "1"}], 
   TraditionalForm]], "InlineFormula",ExpressionUUID->
  "d3a0bd53-3129-4853-a03f-5062a5bf3600"],
 ", so the twist is ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{"\[Rho]", 
     RowBox[{"(", 
      StyleBox["b", "TI"], ")"}], "\[LongEqual]", 
     RowBox[{"-", "1"}]}], 
    RowBox[{"2", 
     StyleBox["d",
      FontSlant->"Plain"], 
     StyleBox["a", "TI"]}]], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"08db63a9-1d4c-44e7-b3a4-829bf65fcda2"],
 " and the decomposition replaces ",
 Cell[BoxData[
  FormBox[
   StyleBox["b", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "064ae6e1-6723-4f6f-abdc-a28c126a6cd4"],
 " by ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{
     StyleBox["b", "TI"], "-", "1"}], 
    RowBox[{"2", 
     StyleBox["d",
      FontSlant->"Plain"], 
     StyleBox["a", "TI"]}]], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"83ec1eeb-46dc-4c1c-832d-6e14af1a641d"],
 ":"
}], "ExampleText",ExpressionUUID->"3886e921-d440-4c87-91e3-4ff59551d480"],

