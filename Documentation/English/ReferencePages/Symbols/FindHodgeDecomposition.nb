Cell[TextData[{
 "The coexact element ",
 Cell[BoxData[
  FormBox[
   StyleBox["b", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "49c22afa-6dfc-4c61-b261-64a429e81978"],
 " has ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{
      StyleBox["b", "TI"], ",", 
      StyleBox["b", "TI"]}], "\[RightAngleBracket]"}], "\[LongEqual]", "1"}], 
   TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5582ff65-c0be-465f-80e3-d590f541617f"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{
      StyleBox["d",
       FontSlant->"Plain"], 
      StyleBox["a", "TI"], ",", 
      StyleBox["b", "TI"]}], "\[RightAngleBracket]"}], "\[LongEqual]", "1"}], 
   TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6e955cd8-49b8-4b78-98d3-09cdbedf5368"],
 ", so the twist is ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{"\[Rho]", 
     RowBox[{"(", 
      StyleBox["b", "TI"], ")"}], "\[LongEqual]", 
     RowBox[{"-", "1"}]}], 
    RowBox[{"2", 
     StyleBox["d",
      FontSlant->"Plain"], 
     StyleBox["a", "TI"]}]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e8ba74fe-70ad-4157-95da-7be19ef8eaf6"],
 " and the decomposition replaces ",
 Cell[BoxData[
  FormBox[
   StyleBox["b", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "54e7da6e-d85f-456e-8257-93b8fc72334d"],
 " by ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{
     StyleBox["b", "TI"], "-", "1"}], 
    RowBox[{"2", 
     StyleBox["d",
      FontSlant->"Plain"], 
     StyleBox["a", "TI"]}]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1cea631f-78c8-4c7c-991e-580309d66daa"],
 ":"
}], "ExampleText",ExpressionUUID->"5d8b9859-f712-4844-b945-5b5d7010b638"],

