  FormBox["4", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "7da71b7c-84dc-46e3-860e-038029e9477e"],
 " obstruction of Example 6.3 of arXiv:2004.07362 has ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{
      StyleBox["a", "TI"], ",", 
      StyleBox["a", "TI"]}], "\[RightAngleBracket]"}], "\[LongEqual]", "1"}], 
   TraditionalForm]], "InlineFormula",ExpressionUUID->
  "04de4e0f-104f-4415-9007-12479427d902"],
 " with ",
 Cell[BoxData[
  FormBox[
   StyleBox["a", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "3fd21b49-d69b-45e3-9b33-a1b919151089"],
