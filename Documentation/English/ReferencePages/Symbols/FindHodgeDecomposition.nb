Cell[TextData[{
 "Each pair of degrees is one exact linear system, and the twist is the \
solution ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["LinearSolve"]], "paclet:ref/LinearSolve"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "416bc9a9-8cf1-4cd0-bb40-81b6d3334f26"],
 " gives."
}], "Notes",ExpressionUUID->"067ce0f1-03e2-4867-bf7e-b9ff59a0ed29"],

Cell["\<\
When the pairing on cohomology is perfect, a twist exists exactly when the \
space is of Hodge type, since any harmonic subspace then extends to a Hodge \
decomposition (arXiv:2004.07362, Remark 3.13).\
\>", "Notes",ExpressionUUID->"de30497d-65b9-4593-906a-4cb98af9c358"],

