Cell[TextData[{
 "The coexact element ",
 Cell[BoxData[
  FormBox[
   StyleBox["b", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "e6efd67e-ea6b-409f-beae-70bb7ebb8afa"],
 " has ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{
      StyleBox["b", "TI"], ",", 
      StyleBox["b", "TI"]}], "\[RightAngleBracket]"}], "\[LongEqual]", "1"}], 
   TraditionalForm]], "InlineFormula",ExpressionUUID->
  "c329dcfc-5abb-4fd7-a01d-de7e79c8c5f6"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{
      StyleBox["d",
       FontSlant->"Plain"], 
      StyleBox["a", "TI"], ",", 
      StyleBox["b", "TI"]}], "\[RightAngleBracket]"}], "\[LongEqual]", "1"}], 
   TraditionalForm]], "InlineFormula",ExpressionUUID->
  "bf33183a-d84f-46ad-b87c-05f1cd047fc5"],
 ", so the twist is ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{"\[Rho]", 
     RowBox[{"(", 
      StyleBox["b", "TI"], ")"}], "\[LongEqual]", 
     RowBox[{"-", "1"}]}], 
    RowBox[{"2", 
     StyleBox["d",
      FontSlant->"Plain"], 
     StyleBox["a", "TI"]}]], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"94a4d7b8-6b15-43f4-995f-fe59d69e79a0"],
 " and the decomposition replaces ",
 Cell[BoxData[
  FormBox[
   StyleBox["b", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "2a3d3fc1-0c39-428e-8d84-1ef5296bf068"],
 " by ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{
     StyleBox["b", "TI"], "-", "1"}], 
    RowBox[{"2", 
     StyleBox["d",
      FontSlant->"Plain"], 
     StyleBox["a", "TI"]}]], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"a9b43fb6-2062-486c-9b83-690b34aeada7"],
 ":"
}], "ExampleText",ExpressionUUID->"432781b1-a711-486e-9527-35f54d23d570"],

