Cell[CellGroupData[{
Cell["BeilinsonDrinfeldOperator", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"97b934a2-b790-4b8b-b1a4-4035149123ed"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["BeilinsonDrinfeldOperator"]], 
     "paclet:ChernSimons/ref/BeilinsonDrinfeldOperator", 
     "ChernSimons Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["e", "TI"], ",", " ", 
    StyleBox["pairing", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d4dfd9dd-54f8-4983-aa17-4a8082733b96"],
 "\[LineSeparator]",
 "gives the operator ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalDelta]", "\[LongEqual]", 
    SubscriptBox[
     OverscriptBox[
      StyleBox["q", "TI"], "^"], 
     RowBox[{"1", ",", "1", ",", "0"}]], "+", 
    SubscriptBox[
     OverscriptBox[
      StyleBox["q", "TI"], "^"], 
     RowBox[{"1", ",", "2", ",", "0"}]], 
    RowBox[{"+", " "}], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["q", "TI"], "^"], 
     RowBox[{"2", ",", "1", ",", "0"}]]}], TraditionalForm]], "InlineFormula",
  
  FontSize->0.9 Inherited,ExpressionUUID->
  "096ad6c2-1a4b-49bc-9b3f-3668d106dd13"],
 " of the Beilinson-Drinfeld algebra, applied to ",
 StyleBox["e", "TI"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"dfa7e87b-e13c-4cc1-811a-601a808784ce"],

Cell[TextData[{
 Cell[BoxData[
  FormBox["\[CapitalDelta]", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8e4166fd-ee19-4263-bdd3-1407a64c3ac1"],
 " acts on the symmetric powers of cyclic words completed over ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["R",
     FontSlant->"Plain"], 
    RowBox[{"[", 
     RowBox[{"[", "]"}], "]"}]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ffe06965-e07f-420c-b3df-fe77f4515df3"],
 ". It is a derivative of order at most ",
 Cell[BoxData[
  FormBox["2", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "05bb8a58-e16e-4770-a450-12d900c53ca9"],
 " and of symmetric degree ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", "1"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "21833cb7-e42c-4cfd-b82e-9019cb484669"],
 ", and it squares to zero exactly when the underlying structure is \
involutive bi-Lie."
}], "Notes",ExpressionUUID->"4c892317-3850-41a1-b138-2ac3c5df422c"],

Cell[TextData[{
 "The first summand is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CyclicDifferential"]], 
    "paclet:ChernSimons/ref/CyclicDifferential", "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "18f7712e-7c4a-4fa8-ba5a-a4c9c32d82c1"],
 " extended as a derivation \[LongDash] identically zero unless the pairing \
carries a Poincare duality algebra with a differential, so on a formal \
alphabet it drops out. The second is the co-bracket extended as a \
co-derivation, the third the bracket extended as a derivation and weighted by \
",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["HBar"]], "paclet:ChernSimons/ref/HBar", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "e1019f74-f3ad-4ea2-937d-7f23a147d989"],
 ". Only the second carries ",
 Cell[BoxData[
  FormBox["\[Null]", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "72605804-58f1-444e-af3e-692a3b8998c8"],
 ", which is why the algebra is a BD algebra and not the BD algebra of a BV \
algebra: ",
 Cell[BoxData[
  FormBox["\[CapitalDelta]", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ebe231ab-b97a-4d1c-8d1f-d03f3061fa7a"],
 " is not divisible by ",
 Cell[BoxData[
  FormBox["\[Null]", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5e4faaee-b11e-4ed0-bc97-dce659dea1c8"],
 "."
}], "Notes",ExpressionUUID->"4dd88aeb-3c38-42cf-9035-7c586cbf8ddb"],

Cell["It obeys the BD axiom", "Notes",ExpressionUUID->"322b682a-a5a8-4d92-95c1-654a871dd8d5"],

Cell[BoxData[
 PaneBox[
  FormBox[
   RowBox[{"\[CapitalDelta]", 
    RowBox[{"(", 
     RowBox[{
      StyleBox["f", "TI"], 
      SuperscriptBox[
       StyleBox["f", "TI"], "\[Prime]"]}], ")"}], "\[LongEqual]", 
    "\[CapitalDelta]", 
    RowBox[{"(", 
     StyleBox["f", "TI"], ")"}], 
    SuperscriptBox[
     StyleBox["f", "TI"], "\[Prime]"], "+", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"-", "1"}], ")"}], 
     RowBox[{"|", 
      StyleBox["f", "TI"], 
      SubscriptBox["|", "\[CircleDot]"]}]], 
    StyleBox["f", "TI"], "\[CapitalDelta]", 
    RowBox[{"(", 
     SuperscriptBox[
      StyleBox["f", "TI"], "\[Prime]"], ")"}], "+", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"-", "1"}], ")"}], 
     RowBox[{"|", 
      StyleBox["f", "TI"], 
      SubscriptBox["|", "\[CircleDot]"]}]], " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["f", "TI"], ",", 
      SuperscriptBox[
       StyleBox["f", "TI"], "\[Prime]"]}], "}"}], ","}],
   TraditionalForm],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",ExpressionUUID->"b756dd3b-b4cb-4495-\
876c-196aff48d439"],

Cell[TextData[{
 "whose bracket is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["BeilinsonDrinfeldBracket"]], 
    "paclet:ChernSimons/ref/BeilinsonDrinfeldBracket", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "1ff2e006-c21b-44b0-b7f5-369405d022bf"],
 " and carries no ",
 Cell[BoxData[
  FormBox["\[Null]", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7e37a301-1fb8-4a3f-aa22-a9f51e75d2c2"],
 " of its own."
}], "Notes",ExpressionUUID->"6034675f-99f0-49ee-836a-015fc1e2662d"],

Cell[TextData[{
 StyleBox["pairing", "TI"],
 " fixes the alphabet; nothing here is tied to any particular one."
}], "Notes",ExpressionUUID->"46e30013-004b-4517-9fa1-fd9a3e178ce8"]
}, Open  ]],

