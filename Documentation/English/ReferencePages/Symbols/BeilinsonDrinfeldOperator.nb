Cell["The operator on a product of two cyclic words of the circle:", \
"ExampleText",ExpressionUUID->"56268dc1-5201-4520-9979-e1a07d22ebc1"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"pairing", " ", "=", " ", 
   RowBox[{"GradedPairing", "[", 
    RowBox[{
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"x", " ", "->", " ", 
        RowBox[{"-", "1"}]}], ",", " ", 
       RowBox[{"y", " ", "->", " ", "0"}]}], "|>"}], ",", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "y"}], "}"}], " ", "->", " ", "1"}], "|>"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{"BeilinsonDrinfeldOperator", "[", 
  RowBox[{
   RowBox[{"SymmetricProduct", "[", 
    RowBox[{
     RowBox[{"CyclicWord", "[", 
      RowBox[{"{", 
       RowBox[{"x", ",", " ", "y", ",", " ", "y", ",", " ", "y"}], "}"}], 
      "]"}], ",", " ", 
     RowBox[{"CyclicWord", "[", 
      RowBox[{"{", 
       RowBox[{"x", ",", " ", "y"}], "}"}], "]"}], ",", " ", "pairing"}], 
    "]"}], ",", " ", "pairing"}], "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"62a84543-8e62-4e6a-913b-fd2135c05c70"],

Cell[BoxData[
 RowBox[{
  RowBox[{"2", " ", 
   InterpretationBox["\[HBar]",
    ChernSimons`HBar,
    Editable->False], " ", 
