    RowBox[{"(", 
     StyleBox["f", "TI"], ")"}], 
    StyleBox["g", "TI"], "+", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"-", "1"}], ")"}], 
     TemplateBox[{
       RowBox[{
         StyleBox["f", "TI"]}]},
      "Abs"]], 
    StyleBox["f", "TI"], "\[CapitalDelta]", 
    RowBox[{"(", 
     StyleBox["g", "TI"], ")"}], "+", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"-", "1"}], ")"}], 
     TemplateBox[{
       RowBox[{
         StyleBox["f", "TI"]}]},
      "Abs"]], 
    RowBox[{"\[HBar]", " "}], 
    RowBox[{"{", 
     RowBox[{
      StyleBox["f", "TI"], ",", 
      StyleBox["g", "TI"]}], "}"}], ","}],
   TraditionalForm],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",ExpressionUUID->"b6ee3759-c214-4a59-\
bddb-38206235f624"],

