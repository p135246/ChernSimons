  FontSize->0.9 Inherited,ExpressionUUID->
  "f0c05c02-6a99-4a1e-a7cf-c4fbd147c456"],
 " to the front, times ",
 Cell[BoxData[
  FormBox[
   RowBox[{"[", 
    RowBox[{
     SubscriptBox[
      StyleBox["u", "TI"], 
      StyleBox["i", "TI"]], ",", 
     SubscriptBox[
      StyleBox["v", "TI"], 
