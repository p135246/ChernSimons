Cell["The bracket of two cyclic words of the circle:", "ExampleText",ExpressionUUID->"bb6fc810-c547-4b58-8f08-1b65bdb30a06"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"StringBeilinsonDrinfeldBracket", "[", 
  RowBox[{
   RowBox[{"CyclicWord", "[", 
    RowBox[{"{", 
     RowBox[{"x", ",", " ", "y", ",", " ", "y", ",", " ", "y"}], "}"}], "]"}],
    ",", " ", 
   RowBox[{"CyclicWord", "[", 
    RowBox[{"{", 
     RowBox[{"x", ",", " ", "y"}], "}"}], "]"}], ",", " ", 
   RowBox[{"GradedPairing", "[", 
    RowBox[{
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"x", " ", "->", " ", 
        RowBox[{"-", "1"}]}], ",", " ", 
       RowBox[{"y", " ", "->", " ", "0"}]}], "|>"}], ",", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "y"}], "}"}], " ", "->", " ", "1"}], "|>"}]}], 
    "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"a18cd57d-0c48-4de5-a9fd-628c846552ee"],

Cell[BoxData[
 RowBox[{
  RowBox[{"-", "2"}], " ", 
  InterpretationBox[
   RowBox[{"(", 
    RowBox[{
    "x", "\[ThinSpace]", "y", "\[ThinSpace]", "y", "\[ThinSpace]", "y"}], 
    ")"}],
   ChernSimons`CyclicWord[{
    MTNB$19kiajbuk8t7d`x, MTNB$19kiajbuk8t7d`y, MTNB$19kiajbuk8t7d`y, 
