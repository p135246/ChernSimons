   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "132e0da8-2948-4ff1-9249-2911ec6612a5"],
 " times the product of the other factors."
}], "Notes",ExpressionUUID->"454799ec-bca0-4b0c-a9c7-6d593275a121"],

