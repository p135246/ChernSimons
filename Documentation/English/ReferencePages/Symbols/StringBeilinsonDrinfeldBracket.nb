Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"u", " ", "=", " ", 
      RowBox[{"CyclicWord", "[", 
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "y", ",", " ", "y", ",", " ", "y"}], "}"}], 
       "]"}]}], ",", " ", 
     RowBox[{"v", " ", "=", " ", 
      RowBox[{"CyclicWord", "[", 
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "y"}], "}"}], "]"}]}]}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"s", " ", "=", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"-", "1"}], ")"}], "^", 
      RowBox[{"ElementDegree", "[", 
       RowBox[{"u", ",", " ", "pairing", ",", " ", "\"\<Symmetric\>\""}], 
       "]"}]}]}], "}"}], ",", " ", 
   RowBox[{"Expand", "[", 
    RowBox[{
     RowBox[{"StringBeilinsonDrinfeldOperator", "[", 
      RowBox[{
       RowBox[{"SymmetricProduct", "[", 
        RowBox[{"u", ",", " ", "v", ",", " ", "pairing"}], "]"}], ",", " ", 
       "pairing"}], "]"}], " ", "-", " ", 
     RowBox[{"SymmetricProduct", "[", 
      RowBox[{
       RowBox[{"StringBeilinsonDrinfeldOperator", "[", 
        RowBox[{"u", ",", " ", "pairing"}], "]"}], ",", " ", "v", ",", " ", 
       "pairing"}], "]"}], " ", "-", " ", 
     RowBox[{"s", " ", 
      RowBox[{"SymmetricProduct", "[", 
       RowBox[{"u", ",", " ", 
        RowBox[{"StringBeilinsonDrinfeldOperator", "[", 
         RowBox[{"v", ",", " ", "pairing"}], "]"}], ",", " ", "pairing"}], 
       "]"}]}], " ", "-", " ", 
     RowBox[{"s", " ", "HBar", " ", 
      RowBox[{"StringBeilinsonDrinfeldBracket", "[", 
       RowBox[{"u", ",", " ", "v", ",", " ", "pairing"}], "]"}]}]}], "]"}]}], 
