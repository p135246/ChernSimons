  FontSize->0.9 Inherited,ExpressionUUID->
  "7ee84a62-8ac0-40f4-8ab3-90fd648b78a7"],
 "."
}], "Notes",ExpressionUUID->"9df69e93-112c-4d4f-9e04-dde65e6f96b4"],

Cell[TextData[{
 "For products ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["f", "TI"], "\[LongEqual]", 
    SubscriptBox[
     StyleBox["u", "TI"], "1"], "\[CircleDot]", "\[CenterEllipsis]", "\[CircleDot]", 
    SubscriptBox[
     StyleBox["u", "TI"], 
     StyleBox["k", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "07c1c222-abe1-42b3-a7dd-9e7bd0113681"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["g", "TI"], "\[LongEqual]", 
    SubscriptBox[
     StyleBox["v", "TI"], "1"], "\[CircleDot]", "\[CenterEllipsis]", "\[CircleDot]", 
    SubscriptBox[
     StyleBox["v", "TI"], 
     StyleBox["l", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "93544cff-1c5c-47b7-aa77-e91f35bec5ec"],
 " it is ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"-", "1"}], ")"}], 
    TemplateBox[{
      RowBox[{
        StyleBox["f", "TI"]}]},
     "Abs"]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a3b354ad-be15-47b8-a8aa-61b47c294614"],
 " times the sum over a factor ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["u", "TI"], 
    StyleBox["i", "TI"]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3d0841a5-beed-46a1-bb48-08befdac9965"],
 " of ",
 Cell[BoxData[
  FormBox[
