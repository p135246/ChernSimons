}], "SeeAlsoSection",
 CellID->1559318232,ExpressionUUID->"6019c63b-8124-433f-bd7e-253812d6da0e"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Relations"]], "paclet:ChernSimons/ref/Relations", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "42a60f8a-c2d7-49c0-a35f-e1b4c164aac7"],
 " \[FilledVerySmallSquare] ",
