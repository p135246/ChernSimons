    }], "TableText",ExpressionUUID->"fd4771de-0974-41e6-a39e-20c015bfad07"], 
    Cell[TextData[{
     Cell[
     BoxData["\"\<Harmonic\>\""], "InlineFormula",ExpressionUUID->
      "4f08bd89-21ea-42a9-a306-2d2abf07ec9f"],
     ", ",
