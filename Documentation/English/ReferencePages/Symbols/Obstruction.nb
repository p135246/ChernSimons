Cell["\<\
The Jacobi obstruction is the composite of the extensions of the bracket:\
\>", "ExampleText",ExpressionUUID->"140e1945-c64c-444c-8234-d631f2c56fef"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Obstruction", "[", 
   RowBox[{
    RowBox[{"CanonicalLieBialgebra", "[", "pairing", "]"}], ",", 
    " ", "\"\<Jacobi\>\"", ",", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"CyclicWord", "[", 
       RowBox[{"{", "x", "}"}], "]"}], ",", " ", 
      RowBox[{"CyclicWord", "[", 
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "y"}], "}"}], "]"}], ",", " ", 
      RowBox[{"CyclicWord", "[", 
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "y", ",", " ", "y"}], "}"}], "]"}]}], "}"}]}], 
   "]"}], " ", "===", " ", 
  RowBox[{"Expand", "[", 
   RowBox[{"CanonicalLieBracket", "[", 
    RowBox[{
     RowBox[{"CanonicalLieBracket", "[", 
      RowBox[{
       RowBox[{"SymmetricProduct", "[", 
        RowBox[{
         RowBox[{"CyclicWord", "[", 
