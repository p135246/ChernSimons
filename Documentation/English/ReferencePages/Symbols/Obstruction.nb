      "ff6b511e-0a16-44a4-bbe5-695787d412c7"]
    }], "TableText",ExpressionUUID->"e5e785fd-960e-442a-a5ff-984a1651f5eb"], 
    Cell[TextData[Cell[BoxData[
     FormBox[
      RowBox[{
       RowBox[{"\[LeftAngleBracket]", 
        RowBox[{
         StyleBox["x", "TI"], ",", 
         StyleBox["y", "TI"]}], "\[RightAngleBracket]"}], "-", 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"-", "1"}], ")"}], 
        TemplateBox[{
          RowBox[{
            StyleBox["x", "TI"], "||", 
            StyleBox["y", "TI"]}]},
         "Abs"]], 
       RowBox[{"\[LeftAngleBracket]", 
        RowBox[{
         StyleBox["y", "TI"], ",", 
         StyleBox["x", "TI"]}], "\[RightAngleBracket]"}]}], TraditionalForm]],
      "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "cece54ed-7280-433b-ab63-efbb6240801e"]], "TableText",ExpressionUUID->
     "8282a17f-d23c-4829-93d6-9906d25a019d"]},
   {Cell[TextData[Cell[BoxData[
     TemplateBox[{
       Cell[
        TextData["CochainComplexWithPairing"]], 
       "paclet:ChernSimons/ref/CochainComplexWithPairing", 
       "ChernSimons Package Symbol"},
      "PackageLink",
      BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
     "9c785916-408d-4639-92da-3cf73881daf5"]], "TableText",ExpressionUUID->
     "56950ec8-a48d-4573-963e-6f9482022e0e"], Cell[TextData[Cell[
    BoxData["\"\<Leibniz\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "03a6d6ae-65ef-4a33-b09f-7dba008c741e"]], "TableText",ExpressionUUID->
     "12472d80-1df3-4266-ab0c-fbc04fec380b"], Cell[TextData[{
     "two elements ",
     Cell[BoxData[
      FormBox[
       RowBox[{
        StyleBox["x", "TI"], ",", 
        StyleBox["y", "TI"]}], TraditionalForm]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "642464af-69e1-495d-b5c1-fa0412179d12"]
    }], "TableText",ExpressionUUID->"026741eb-d08c-4050-8d8f-db85abf60e8b"], 
    Cell[TextData[Cell[BoxData[
     FormBox[
      RowBox[{
       StyleBox["d",
        FontSlant->"Plain"], 
       RowBox[{"(", 
        StyleBox[
         RowBox[{"x", "y"}], "TI"], ")"}], "-", 
       RowBox[{"(", 
        RowBox[{
         StyleBox["d",
          FontSlant->"Plain"], 
         StyleBox["x", "TI"]}], ")"}], 
       StyleBox["y", "TI"], "-", 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"-", "1"}], ")"}], 
        TemplateBox[{
          RowBox[{
            StyleBox["x", "TI"]}]},
         "Abs"]], 
       StyleBox["x", "TI"], " ", 
       StyleBox["d",
        FontSlant->"Plain"], 
       StyleBox["y", "TI"]}], TraditionalForm]], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "9663333b-dd29-4761-8a76-c8a8813bae73"]], "TableText",ExpressionUUID->
     "b901d34f-5ea5-4f61-92c1-8ecd52f564d9"]},
   {Cell[TextData[Cell[BoxData[
     TemplateBox[{
       Cell[
        TextData["CochainComplexWithPairing"]], 
       "paclet:ChernSimons/ref/CochainComplexWithPairing", 
       "ChernSimons Package Symbol"},
      "PackageLink",
      BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
     "3d3261a9-ff2a-4866-b434-e5fcc17dfa24"]], "TableText",ExpressionUUID->
     "e1b5b313-f72d-4428-aedf-a5f26589c19a"], Cell[
    "the other axioms", "TableText",ExpressionUUID->
     "b24e3dfb-befd-4df8-96a9-707a7f2090ab"], Cell[
    "one to three elements", "TableText",ExpressionUUID->
     "edfef6e0-ec4d-4712-8fb7-b98d16a0d5bd"], Cell[
    "the difference of the two sides", "TableText",ExpressionUUID->
     "dacbbfce-3029-4018-bab0-21ac21d24563"]},
   {Cell[TextData[{
     Cell[BoxData[
      TemplateBox[{
        Cell[
         TextData["PreHodgeDecomposition"]], 
        "paclet:ChernSimons/ref/PreHodgeDecomposition", 
        "ChernSimons Package Symbol"},
       "PackageLink",
       BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
      "a155d8b7-7204-4e28-a7d8-815eacff1272"],
     ", ",
     Cell[BoxData[
      TemplateBox[{
        Cell[
         TextData["HodgeDecomposition"]], 
        "paclet:ChernSimons/ref/HodgeDecomposition", 
        "ChernSimons Package Symbol"},
       "PackageLink",
       BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
      "4e27b07e-631b-45c3-97d5-2003183a29b1"]
    }], "TableText",ExpressionUUID->"005da746-ee57-4002-8cdc-8c1b7b4b88d9"], 
    Cell[TextData[{
     Cell[BoxData["\"\<Harmonic\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "1c22e370-e87c-409b-8e8e-12537b5b306b"],
     ", ",
     Cell[BoxData["\"\<Coexact\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "f0df5e5e-dfd1-4939-9cce-b79f9b69bf2f"],
     ", ",
     Cell[BoxData["\"\<Perpendicular\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "5061248f-8f9c-49c7-9c7c-8a64de3f5a17"],
     ", ",
     Cell[BoxData["\"\<Isotropic\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "6eb522c9-a437-4bdf-b8f9-17962c9c4202"]
    }], "TableText",ExpressionUUID->"9a291764-3b8c-448a-af20-f9d5977ae7eb"], 
