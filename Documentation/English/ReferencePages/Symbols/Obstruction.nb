Cell["\<\
The Jacobi obstruction is the composite of the extensions of the bracket:\
\>", "ExampleText",ExpressionUUID->"fb3c62f8-1c66-461e-9772-a1918f53daf4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Obstruction", "[", 
   RowBox[{
    RowBox[{"CanonicalLieBialgebra", "[", "pairing", "]"}], ",", 
    " ", "\"\<Jacobi\>\"", ",", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"CyclicWord", "[", 
       RowBox[{"{", "x", "}"}], "]"}], ",", " ", 
      RowBox[{"CyclicWord", "[", 
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "y"}], "}"}], "]"}], ",", " ", 
      RowBox[{"CyclicWord", "[", 
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "y", ",", " ", "y"}], "}"}], "]"}]}], "}"}]}], 
   "]"}], " ", "===", " ", 
  RowBox[{"Expand", "[", 
   RowBox[{"CanonicalLieBracket", "[", 
    RowBox[{
     RowBox[{"CanonicalLieBracket", "[", 
      RowBox[{
       RowBox[{"SymmetricProduct", "[", 
        RowBox[{
         RowBox[{"CyclicWord", "[", 
          RowBox[{"{", "x", "}"}], "]"}], ",", " ", 
         RowBox[{"CyclicWord", "[", 
          RowBox[{"{", 
           RowBox[{"x", ",", " ", "y"}], "}"}], "]"}], ",", " ", 
         RowBox[{"CyclicWord", "[", 
          RowBox[{"{", 
           RowBox[{"x", ",", " ", "y", ",", " ", "y"}], "}"}], "]"}], ",", 
         " ", "pairing"}], "]"}], ",", " ", "pairing"}], "]"}], ",", " ", 
     "pairing"}], "]"}], "]"}]}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"8f761a73-a89f-4723-8ff9-1ef7a4ad92c7"],

