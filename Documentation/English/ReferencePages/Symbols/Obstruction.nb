        StyleBox["y", "TI"]}], TraditionalForm]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "1b89deb9-354b-462d-921a-0f2cfa75ae95"]
    }], "TableText",ExpressionUUID->"8d0104ab-6590-48b6-b3f2-959ea5d0a29e"], 
    Cell[TextData[Cell[BoxData[
     FormBox[
      RowBox[{
       RowBox[{"\[LeftAngleBracket]", 
        RowBox[{
         StyleBox["x", "TI"], ",", 
         StyleBox["y", "TI"]}], "\[RightAngleBracket]"}], "-", 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"-", "1"}], ")"}], 
        TemplateBox[{
          RowBox[{
            StyleBox["x", "TI"], "||", 
            StyleBox["y", "TI"]}]},
         "Abs"]], 
       RowBox[{"\[LeftAngleBracket]", 
        RowBox[{
         StyleBox["y", "TI"], ",", 
         StyleBox["x", "TI"]}], "\[RightAngleBracket]"}]}], TraditionalForm]],
      "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "6d447b96-d5cd-48c2-b56f-99d4adf8bcbc"]], "TableText",ExpressionUUID->
     "1890076f-a808-4a86-881c-998dc12832f8"]},
   {Cell[TextData[Cell[BoxData[
     TemplateBox[{
       Cell[
        TextData["CochainComplexWithPairing"]], 
       "paclet:ChernSimons/ref/CochainComplexWithPairing", 
       "ChernSimons Package Symbol"},
      "PackageLink",
      BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
     "f0b91e46-2c41-42d2-b4e2-8d00047a1601"]], "TableText",ExpressionUUID->
     "adff4d69-c201-4377-950c-043eadb2949e"], Cell[TextData[Cell[
    BoxData["\"\<Leibniz\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "d3db99c3-e332-4d52-8454-0bf621933841"]], "TableText",ExpressionUUID->
     "55a296ac-16eb-4a85-81f2-9cf976bbf012"], Cell[TextData[{
     "two elements ",
     Cell[BoxData[
      FormBox[
       RowBox[{
        StyleBox["x", "TI"], ",", 
        StyleBox["y", "TI"]}], TraditionalForm]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "b39823dd-a48a-4aee-afb9-42646b07cc9f"]
    }], "TableText",ExpressionUUID->"839366c7-cd8d-4ac4-b93a-064a148865b5"], 
    Cell[TextData[Cell[BoxData[
     FormBox[
      RowBox[{
       StyleBox["d",
        FontSlant->"Plain"], 
       RowBox[{"(", 
        StyleBox[
         RowBox[{"x", "y"}], "TI"], ")"}], "-", 
       RowBox[{"(", 
        RowBox[{
         StyleBox["d",
          FontSlant->"Plain"], 
         StyleBox["x", "TI"]}], ")"}], 
       StyleBox["y", "TI"], "-", 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"-", "1"}], ")"}], 
        TemplateBox[{
          RowBox[{
            StyleBox["x", "TI"]}]},
         "Abs"]], 
       StyleBox["x", "TI"], " ", 
       StyleBox["d",
        FontSlant->"Plain"], 
       StyleBox["y", "TI"]}], TraditionalForm]], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "71052e74-b544-4e18-9de3-dbe66217bb5c"]], "TableText",ExpressionUUID->
     "163a8c8a-f047-4991-8a20-688fd95b7f9d"]},
   {Cell[TextData[Cell[BoxData[
     TemplateBox[{
       Cell[
        TextData["CochainComplexWithPairing"]], 
       "paclet:ChernSimons/ref/CochainComplexWithPairing", 
       "ChernSimons Package Symbol"},
      "PackageLink",
      BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
     "ac76dc58-c14f-4248-8f6f-5b5fa0a0453a"]], "TableText",ExpressionUUID->
     "6813ff57-3716-4d8f-b73c-87a516d3b316"], Cell[
    "the other axioms", "TableText",ExpressionUUID->
     "22f89416-97a0-4485-9fd9-b1fbbbc08ed4"], Cell[
    "one to three elements", "TableText",ExpressionUUID->
     "d9f3e0c4-a684-4773-8dc9-dfb4e6609d57"], Cell[
    "the difference of the two sides", "TableText",ExpressionUUID->
     "d827f824-4d2f-404a-bdd8-82a4726ae856"]},
   {Cell[TextData[{
     Cell[BoxData[
      TemplateBox[{
        Cell[
         TextData["PreHodgeDecomposition"]], 
        "paclet:ChernSimons/ref/PreHodgeDecomposition", 
        "ChernSimons Package Symbol"},
       "PackageLink",
       BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
      "9fa636e4-23c3-462b-ad92-ce2aa64b748d"],
     ", ",
     Cell[BoxData[
      TemplateBox[{
        Cell[
         TextData["HodgeDecomposition"]], 
        "paclet:ChernSimons/ref/HodgeDecomposition", 
        "ChernSimons Package Symbol"},
       "PackageLink",
       BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
      "97236b96-c126-4fd6-a997-c59c081af5a1"]
    }], "TableText",ExpressionUUID->"5bfb00c7-edc4-45a0-b12f-9d55c357aa32"], 
    Cell[TextData[{
     Cell[BoxData["\"\<Harmonic\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "8b3eca70-6e1f-4614-8dbc-06659f813dae"],
     ", ",
     Cell[BoxData["\"\<Coexact\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "18ec770e-ca7f-4d02-ad00-66cc9a17c91c"],
     ", ",
     Cell[BoxData["\"\<Perpendicular\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "9c77e29e-b2c4-43c8-9a40-576140630696"],
     ", ",
     Cell[BoxData["\"\<Isotropic\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "25d35dec-95d8-4777-8ed3-b160d2c2864d"]
    }], "TableText",ExpressionUUID->"9ec7e70a-542e-442b-bc17-6db33e2eafa2"], 
