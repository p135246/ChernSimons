ionUUID->"6e72e3c9-ad17-44a6-b5ef-3c55a21779e2"],

Cell[TextData[{
 "On a canonical Lie bialgebra the operations are ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CanonicalLieBracket"]], 
    "paclet:ChernSimons/ref/CanonicalLieBracket", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "5ffbb2d5-152a-4aee-9496-8a60d8a87c81"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CanonicalLieCobracket"]], 
    "paclet:ChernSimons/ref/CanonicalLieCobracket", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "6626803b-c721-49b0-b6ab-e05cb02e2b2b"],
 " with their extensions to products, in the convention of the pairing, and \
with the empty word when the algebra has it."
}], "Notes",ExpressionUUID->"9af56087-2248-4869-b177-274471e927cc"],

Cell["\<\
In the exterior convention the products in the string relations are exterior \
products.\
\>", "Notes",ExpressionUUID->"23944e32-d621-426c-a227-10b3cf726888"],

Cell["A cyclic word may be given as the list of its particles.", "Notes",ExpressionUUID->"c8352799-e209-4750-9371-c684e7cb7943"],

Cell["\<\
On a canonical Lie bialgebra a nonzero value is a counterexample to the \
identity for that pairing.\
\>", "Notes",ExpressionUUID->"c0bb7c46-9720-49bc-b013-ab8f4134ce91"],

Cell[TextData[{
 "On an A-infinity algebra the convention is the shifted one: the term whose \
inner operation takes the arguments ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["r", "TI"], "+", "1"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "79060d50-1302-47aa-ba8f-2329ef0d475c"],
 " through ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["r", "TI"], "+", 
    StyleBox["s", "TI"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a9775b06-0e4b-4432-8d5c-7b73b32fcf29"],
 " carries the sign of the sum of the shifted degrees of the first ",
 Cell[BoxData[
  FormBox[
   StyleBox["r", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a384cff0-8e2e-4842-90f7-45ac5732efdf"],
 " arguments, and the relation on ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["e", "TI"], "1"], ",", "\[Ellipsis]", ",", 
    SubscriptBox[
     StyleBox["e", "TI"], 
     StyleBox["n", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3b82f751-d2f4-435c-90d4-34ae2826c194"],
 " is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    UnderscriptBox["\[Sum]", 
     RowBox[{
      StyleBox["r", "TI"], "+", 
      StyleBox["s", "TI"], "+", 
      StyleBox["t", "TI"], "\[LongEqual]", 
      StyleBox["n", "TI"]}],
     LimitsPositioning->True], 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"-", "1"}], ")"}], 
     TemplateBox[{
       RowBox[{
         SubscriptBox[
          StyleBox["e", "TI"], "1"], "|", "+", "\[CenterEllipsis]", "+", "|", 
         
         SubscriptBox[
          StyleBox["e", "TI"], 
          StyleBox["r", "TI"]]}]},
      "Abs"]], " ", 
    SubscriptBox[
     StyleBox["m", "TI"], 
     RowBox[{
      StyleBox["r", "TI"], "+", "1", "+", 
      StyleBox["t", "TI"]}]], 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox[
       StyleBox["e", "TI"], "1"], ",", "\[Ellipsis]", ",", 
      SubscriptBox[
       StyleBox["e", "TI"], 
       StyleBox["r", "TI"]], ",", 
      SubscriptBox[
       StyleBox["m", "TI"], 
       StyleBox["s", "TI"]], 
      RowBox[{"(", 
       RowBox[{
        SubscriptBox[
         StyleBox["e", "TI"], 
         RowBox[{
          StyleBox["r", "TI"], "+", "1"}]], ",", "\[Ellipsis]", ",", 
        SubscriptBox[
         StyleBox["e", "TI"], 
         RowBox[{
          StyleBox["r", "TI"], "+", 
          StyleBox["s", "TI"]}]]}], ")"}], ",", "\[Ellipsis]", ",", 
      SubscriptBox[
       StyleBox["e", "TI"], 
       StyleBox["n", "TI"]]}], ")"}], "\[LongEqual]", "0"}], 
   TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "312b45dd-676f-4f69-9423-879a7013b4ba"],
 "."
}], "Notes",ExpressionUUID->"6bf225b1-9db9-41bd-9279-dfe81b36727e"],

Cell[TextData[{
 "On an A-infinity morphism the left-hand side carries the same signs with \
the components ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["f", "TI"], 
    StyleBox["k", "TI"]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ad59280c-4340-4423-883a-3bc1f5caf414"],
 " outside, and the right-hand side sums over all compositions of the \
arguments into blocks, so a target with operations beyond ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["m", "TI"], "2"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dc0e4b1b-f592-44ae-adac-61c01b6d5dad"],
 " is handled."
}], "Notes",ExpressionUUID->"b320a456-45a3-469f-9833-d107bc18ccab"],

Cell["\<\
The two A-infinity obstructions are multilinear in the elements, each a \
linear combination of basis elements, and an argument outside the span of the \
basis returns unevaluated.\
\>", "Notes",ExpressionUUID->"9f05ac8b-0138-460e-a41c-eedd7c5afc86"],

Cell[TextData[{
 "On a Maurer-Cartan element the equation is the BD master equation over ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["R",
     FontSlant->"Plain"], 
    RowBox[{"[", 
     RowBox[{"[", "\[HBar]", "]"}], "]"}]}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "aab0b5d8-ec15-459b-aded-1310aaed093f"],
 ", without inverting ",
 Cell[BoxData[
  FormBox["\[HBar]", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d556b326-0989-4317-8c8a-982f6e1a895b"],
 ". The bracket is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CanonicalBeilinsonDrinfeldBracket"]], 
    "paclet:ChernSimons/ref/CanonicalBeilinsonDrinfeldBracket", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "abce3e19-6715-42e5-8e03-2c6d827c8afd"],
 ", so no negative power of ",
 Cell[BoxData[
  FormBox["\[HBar]", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0f1d4527-31b4-491a-8e6d-ac0c86191ba4"],
 " appears."
}], "Notes",ExpressionUUID->"0e70bed6-6f7b-4757-8edd-770f52f90c11"],

Cell[TextData[{
 "The coefficient of the obstruction in ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["S",
      FontSlant->"Plain"], "\[ScriptL]"], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["C", "TI"], 
      RowBox[{"[", "1", "]"}]}], ")"}], 
    SuperscriptBox["\[HBar]", 
     StyleBox["g", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4d648a1f-bce8-4648-ae24-1ebdb6e2f0a2"],
 " is the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"\[ScriptL]", ",", 
     StyleBox["g", "TI"]}], ")"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b7457d5c-57f2-44c2-9f5d-7356ed70b1e5"],
 " Maurer-Cartan equation."
}], "Notes",ExpressionUUID->"6ed4c911-1089-4b15-84a9-3068edd7dd3c"],

Cell[TextData[{
 "In the ",
 Cell[BoxData["\"\<Equations\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bf28dab1-aa30-4580-bc7c-545d2a6a50ce"],
 " form the keys are the monomials, a power of ",
 Cell[BoxData[
  FormBox["\[HBar]", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "52556bee-e367-42ec-af4b-7d13d09626bf"],
 " times a product of cyclic words, and the values the scalar coefficients, \
each of which must vanish. It is the form to give to ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Solve"]], "paclet:ref/Solve"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0614ce1a-e3cd-4830-811d-2890629f5d54"],
 "."
}], "Notes",ExpressionUUID->"d8ba5593-9b74-443d-915e-dcaf05e84edf"],

Cell[TextData[{
 "An element that solves the equation gives the empty Association in the ",
 Cell[BoxData["\"\<Equations\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e659b7a3-bc48-4898-9b30-bf18bc81b516"],
 " form."
}], "Notes",ExpressionUUID->"bfb36c9f-818d-47b0-87f8-283a6fdb8af6"],

Cell[TextData[{
 "On an element whose pairing is in the exterior convention, ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Obstruction"]], "paclet:ChernSimons/ref/Obstruction", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "b3c4ab02-dc73-4f9c-ad2f-f4b5b54edce0"],
 " returns unevaluated."
}], "Notes",ExpressionUUID->"aa0ca182-873f-41be-8d24-559d8c1484fe"],

Cell["\<\
On a cochain complex with a pairing each relation is an identity, and the \
obstruction is the difference of its two sides, multilinear in the elements, \
each a linear combination of basis elements.\
\>", "Notes",ExpressionUUID->"0a2d7d3d-ca82-401f-8279-d215d63dae77"],

Cell[TextData[{
 "For ",
 Cell[BoxData["\"\<DifferentialDegree\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c99aee85-e496-4ca2-915b-32c20fea0bea"],
 " and ",
 Cell[BoxData["\"\<ProductDegree\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "810b601d-ef9f-4f27-9eed-b07ca6a19809"],
 " the obstruction is the part of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["d",
     FontSlant->"Plain"], 
    StyleBox["x", "TI"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "71cf9768-5f50-442b-aaff-976aeb429609"],
 " or ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"x", "y"}], "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c14a241d-6840-43b5-add3-09f0ac07725b"],
 " outside the degree required."
}], "Notes",ExpressionUUID->"c9396e19-44af-4342-9390-58bb1f5923d5"],

Cell["\<\
On a decomposition a relation of its complex has the obstruction it has on \
the complex.\
\>", "Notes",ExpressionUUID->"fa6f4c41-26fb-45c9-9eb2-f6dfba88adca"],

Cell[TextData[{
 "The own axioms of a decomposition are conditions on its parts in every \
degree, so they take the empty tuple of arguments, and the obstruction is ",
 Cell[BoxData[
  FormBox["0", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "af9ec4fd-fc19-4f30-9491-8faa4df76fa6"],
 " when the axiom holds and otherwise the list of the degrees where it \
fails."
}], "Notes",ExpressionUUID->"406efb90-92c8-4a24-b377-5a8cb931df22"],

Cell["\<\
A relation the structure does not have, or a tuple whose length is not the \
arity of the relation, returns unevaluated.\
\>", "Notes",ExpressionUUID->"7e6837b1-caad-48a5-a2ff-164e594135a8"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Obstruction"]], "paclet:ChernSimons/ref/Obstruction", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "8e74e6ff-2543-4837-97f1-e161b2037b28"],
 " has the following option:"
}], "Notes",ExpressionUUID->"b5e39e41-ec91-4dbd-a768-1e6200325c2e"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "3aab7d61-0546-4255-b6af-4fe5bb1339e4"], Cell["Option", "TableText",
     FontWeight->Bold,ExpressionUUID->"5fe5517f-94e4-451e-814d-59de37205834"],
     Cell["Default", "TableText",
     FontWeight->Bold,ExpressionUUID->"7b6592d2-270c-448f-97b5-cc0fe8ddc3ae"],
     Cell["Description", "TableText",
     FontWeight->Bold,ExpressionUUID->"a1502a8e-eff1-425f-bba1-c03bcf8e8717"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "c095a618-ca75-41a8-9d52-78899a2dff5a"], Cell[TextData[Cell[
    BoxData["\"\<EmptyWord\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "5a16f9c2-6422-4f28-8b2e-ace6b119c7bd"]], "TableText",ExpressionUUID->
     "718030b0-a067-4c77-b244-6333fdffdd1b"], Cell[TextData[Cell[BoxData[
     TemplateBox[{
       Cell[
        TextData["False"]], "paclet:ref/False"},
      "RefLink",
      BaseStyle->"InlineFormula"]], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "41a2d36b-44c2-43c5-aec4-121a69a8d565"]], "TableText",ExpressionUUID->
     "af495ea9-c723-44e0-901b-6df5e93ffb69"], Cell["\<\
whether the operator and the bracket of the Maurer-Cartan equation of an \
element include the empty word\
\>", "TableText",ExpressionUUID->"d841d188-97d1-49f7-8b4b-a803214e4ea7"]}
  }]], "3ColumnTableMod",ExpressionUUID->"41b7eb5e-4373-463a-95a9-\
292332020587"],

Cell[TextData[{
 "The option applies to a Maurer-Cartan element and is given to ",
 Cell[BoxData[
