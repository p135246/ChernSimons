     "c5ea817e-c8dd-4165-988d-afde541238a8"]], "TableText",ExpressionUUID->
     "5610dfaf-0389-41e3-9911-e0efd0589e01"]},
   {Cell[TextData[Cell[BoxData[
     TemplateBox[{
       Cell[
        TextData["CochainComplexWithPairing"]], 
       "paclet:ChernSimons/ref/CochainComplexWithPairing", 
       "ChernSimons Package Symbol"},
      "PackageLink",
      BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
     "7a1162d2-5ba5-4967-a4da-d77681ff5c5e"]], "TableText",ExpressionUUID->
     "437358a7-f450-4032-8830-11659527cccd"], Cell[TextData[Cell[
    BoxData["\"\<Leibniz\>\""], "InlineFormula",ExpressionUUID->
     "15305634-9da9-4325-9abe-8a4e0a70a9f0"]], "TableText",ExpressionUUID->
     "1e2fe603-dc13-488f-993f-f2463d3c5ba4"], Cell[TextData[{
     "two elements ",
     Cell[BoxData[
      FormBox[
       RowBox[{
        StyleBox["x", "TI"], ",", 
        StyleBox["y", "TI"]}], TraditionalForm]], "InlineFormula",
      ExpressionUUID->"36e81148-5a40-45ff-a11e-e20944b7376d"]
    }], "TableText",ExpressionUUID->"a568facc-b3a8-4e34-9a18-4e346fd923ed"], 
    Cell[TextData[Cell[BoxData[
     FormBox[
      RowBox[{
       StyleBox["d",
        FontSlant->"Plain"], 
       RowBox[{"(", 
        StyleBox[
         RowBox[{"x", "y"}], "TI"], ")"}], "-", 
       RowBox[{"(", 
        RowBox[{
         StyleBox["d",
          FontSlant->"Plain"], 
         StyleBox["x", "TI"]}], ")"}], 
       StyleBox["y", "TI"], "-", 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"-", "1"}], ")"}], 
        TemplateBox[{
          RowBox[{
            StyleBox["x", "TI"]}]},
         "Abs"]], 
       StyleBox["x", "TI"], " ", 
       StyleBox["d",
        FontSlant->"Plain"], 
       StyleBox["y", "TI"]}], TraditionalForm]], "InlineFormula",
     ExpressionUUID->"36ce9fae-794d-43df-a5be-df712658eaa1"]], "TableText",
     ExpressionUUID->"a36cecec-1212-4798-9ff9-50e6d3da8fff"]},
   {Cell[TextData[Cell[BoxData[
     TemplateBox[{
       Cell[
        TextData["CochainComplexWithPairing"]], 
       "paclet:ChernSimons/ref/CochainComplexWithPairing", 
       "ChernSimons Package Symbol"},
      "PackageLink",
      BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
     "d35abd47-ed2d-4eee-bbc5-771ff3f45061"]], "TableText",ExpressionUUID->
     "44664e50-d117-47fa-b7ef-033995db56ef"], Cell[
    "the other axioms", "TableText",ExpressionUUID->
     "6660be27-c521-4bd8-bed9-5751351f76a2"], Cell[
    "one to three elements", "TableText",ExpressionUUID->
     "f81efcab-998b-41ec-8636-dd571577d7d9"], Cell[
    "the difference of the two sides", "TableText",ExpressionUUID->
     "7091d574-af3e-4d38-9a12-c3af22814440"]},
   {Cell[TextData[{
