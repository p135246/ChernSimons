  GridBoxSpacings->{"Columns" -> {{1.5}}, "Rows" -> {{0.7}}}]], "Text",Express\
ionUUID->"0453ee03-3df9-44be-a4ca-5ae60e5620b4"],

Cell[TextData[{
 "On a string algebra the operations are ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["StringBracket"]], "paclet:ChernSimons/ref/StringBracket", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "b6c47897-f7cb-4e82-8dfc-dadcbf7a5771"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["StringCobracket"]], "paclet:ChernSimons/ref/StringCobracket", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "e1639b3d-d28a-40c3-b875-f2a556c0188f"],
 " with their extensions to products, in the convention of the pairing, and \
with the empty word when the algebra has it."
}], "Notes",ExpressionUUID->"151028cd-3e12-4e5a-9ecc-76a5589affba"],

Cell["\<\
In the exterior convention the products in the string relations are exterior \
products.\
\>", "Notes",ExpressionUUID->"6ae9e31d-5638-44b3-80ef-03cf544ff7bc"],

Cell["A cyclic word may be given as the list of its particles.", "Notes",ExpressionUUID->"6c654317-7acb-4701-903c-93ebf1a0559f"],

Cell["\<\
On a string algebra a nonzero value is a counterexample to the identity for \
that pairing.\
\>", "Notes",ExpressionUUID->"da36a2fa-0217-4cad-853b-94fd23a3f04f"],

Cell[TextData[{
 "On an A-infinity algebra the convention is the shifted one: the term whose \
inner operation takes the arguments ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["r", "TI"], "+", "1"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e2c63014-36ec-47d1-8973-1284684fad12"],
 " through ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["r", "TI"], "+", 
    StyleBox["s", "TI"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6c26181d-b5cf-4338-b4f8-44accefa6627"],
 " carries the sign of the sum of the shifted degrees of the first ",
 Cell[BoxData[
  FormBox[
   StyleBox["r", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e721a920-0717-43bd-8efb-593570524d95"],
 " arguments, and the relation on ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["e", "TI"], "1"], ",", "\[Ellipsis]", ",", 
    SubscriptBox[
     StyleBox["e", "TI"], 
     StyleBox["n", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9df7124d-36d1-4a7e-9cd4-30983cd32ac2"],
 " is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    UnderscriptBox["\[Sum]", 
     RowBox[{
      StyleBox["r", "TI"], "+", 
      StyleBox["s", "TI"], "+", 
      StyleBox["t", "TI"], "\[LongEqual]", 
      StyleBox["n", "TI"]}],
     LimitsPositioning->True], 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"-", "1"}], ")"}], 
     TemplateBox[{
       RowBox[{
         SubscriptBox[
          StyleBox["e", "TI"], "1"], "|", "+", "\[CenterEllipsis]", "+", "|", 
         
         SubscriptBox[
          StyleBox["e", "TI"], 
          StyleBox["r", "TI"]]}]},
      "Abs"]], " ", 
    SubscriptBox[
     StyleBox["m", "TI"], 
     RowBox[{
      StyleBox["r", "TI"], "+", "1", "+", 
      StyleBox["t", "TI"]}]], 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox[
       StyleBox["e", "TI"], "1"], ",", "\[Ellipsis]", ",", 
      SubscriptBox[
       StyleBox["e", "TI"], 
       StyleBox["r", "TI"]], ",", 
      SubscriptBox[
       StyleBox["m", "TI"], 
       StyleBox["s", "TI"]], 
      RowBox[{"(", 
       RowBox[{
        SubscriptBox[
         StyleBox["e", "TI"], 
         RowBox[{
          StyleBox["r", "TI"], "+", "1"}]], ",", "\[Ellipsis]", ",", 
        SubscriptBox[
         StyleBox["e", "TI"], 
         RowBox[{
          StyleBox["r", "TI"], "+", 
          StyleBox["s", "TI"]}]]}], ")"}], ",", "\[Ellipsis]", ",", 
      SubscriptBox[
       StyleBox["e", "TI"], 
       StyleBox["n", "TI"]]}], ")"}], "\[LongEqual]", "0"}], 
   TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d2c38026-9354-454a-bd00-902c69213db1"],
 "."
}], "Notes",ExpressionUUID->"45135b1f-a4e1-4320-b0d3-f7ed1c50e50b"],

Cell[TextData[{
 "On an A-infinity morphism the left-hand side carries the same signs with \
the components ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["f", "TI"], 
    StyleBox["k", "TI"]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e11cd1c5-2087-4bf8-81d8-410c0a5c5e03"],
 " outside, and the right-hand side sums over all compositions of the \
arguments into blocks, so a target with operations beyond ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["m", "TI"], "2"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c734aba4-f667-43e1-afb1-25e2c2f0d81a"],
 " is handled."
}], "Notes",ExpressionUUID->"1d4a9898-0724-48c1-aff8-34d69b6f1f55"],

Cell["\<\
The two A-infinity obstructions are multilinear in the elements, each a \
linear combination of basis elements, and an argument outside the span of the \
basis returns unevaluated.\
\>", "Notes",ExpressionUUID->"6ef18495-1215-4f1b-8488-75aa78fb2908"],

Cell[TextData[{
 "On a Maurer-Cartan element the equation is the BD master equation over ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["R",
     FontSlant->"Plain"], 
    RowBox[{"[", 
     RowBox[{"[", "\[HBar]", "]"}], "]"}]}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "39f89b85-c172-4598-9d60-90d7ab28b4d0"],
 ", without inverting ",
 Cell[BoxData[
  FormBox["\[HBar]", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3f93df07-ce9b-4c7e-93b9-4a9ededef3fe"],
 ". The bracket is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["StringBeilinsonDrinfeldBracket"]], 
    "paclet:ChernSimons/ref/StringBeilinsonDrinfeldBracket", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "84088e36-7d9e-4dfc-8c86-c7ec53b72fa0"],
 ", so no negative power of ",
 Cell[BoxData[
  FormBox["\[HBar]", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "74413706-d0cb-4d1d-8e02-005ffaeb6974"],
 " appears."
}], "Notes",ExpressionUUID->"f4846822-1ed2-4d7d-9e47-de006eb5779b"],

Cell[TextData[{
 "The coefficient of the obstruction in ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["S",
      FontSlant->"Plain"], "\[ScriptL]"], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["C", "TI"], 
      RowBox[{"[", "1", "]"}]}], ")"}], 
    SuperscriptBox["\[HBar]", 
     StyleBox["g", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a0499da3-d2cb-4ede-80ef-49bae044c4f1"],
 " is the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"\[ScriptL]", ",", 
     StyleBox["g", "TI"]}], ")"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3485c501-727b-44d5-a8bd-a5203ee54039"],
 " Maurer-Cartan equation."
}], "Notes",ExpressionUUID->"51666b7f-6eec-4ae0-b90f-ddcb96952f91"],

Cell[TextData[{
 "In the ",
 Cell[BoxData["\"\<Equations\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "87071dcd-df51-4433-9808-ad688272f210"],
 " form the keys are the monomials, a power of ",
 Cell[BoxData[
  FormBox["\[HBar]", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "57396562-014c-4ed3-8f80-9e5d35228aef"],
 " times a product of cyclic words, and the values the scalar coefficients, \
each of which must vanish. It is the form to give to ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Solve"]], "paclet:ref/Solve"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9885b451-24a9-4966-8862-59f0f36117ae"],
 "."
}], "Notes",ExpressionUUID->"2ee85aba-a7cb-4454-a934-91d6c8617520"],

Cell[TextData[{
 "An element that solves the equation gives the empty Association in the ",
 Cell[BoxData["\"\<Equations\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "af5f68fc-3b4f-4bfa-8668-5cdbbbe72e1a"],
 " form."
}], "Notes",ExpressionUUID->"b13ab4a6-3112-4888-808a-4adf8e44433b"],

Cell[TextData[{
 "On an element whose pairing is in the exterior convention, ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Obstruction"]], "paclet:ChernSimons/ref/Obstruction", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "9d4d74c7-33f4-4f05-9803-39ad931d77f6"],
 " returns unevaluated."
}], "Notes",ExpressionUUID->"c73cad2e-2428-4aec-ac41-0ea039e86911"],

Cell["\<\
On a cochain complex with a pairing each relation is an identity, and the \
obstruction is the difference of its two sides, multilinear in the elements, \
each a linear combination of basis elements.\
\>", "Notes",ExpressionUUID->"8b8fdfe2-91e8-47f9-9132-d8542d8a34dd"],

Cell[TextData[{
 "For ",
 Cell[BoxData["\"\<DifferentialDegree\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "afab679a-5d6a-4014-b29d-4c7c52a185f8"],
 " and ",
 Cell[BoxData["\"\<ProductDegree\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6f6ec098-238a-46a1-9381-f23fad945df7"],
 " the obstruction is the part of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["d",
     FontSlant->"Plain"], 
    StyleBox["x", "TI"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "376b2db3-cc78-4343-8f26-722455c5a0b1"],
 " or ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"x", "y"}], "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d8f94069-d466-45c2-a428-076c7e103a40"],
 " outside the degree required."
}], "Notes",ExpressionUUID->"53e3aa20-359b-428f-b60b-ba78463ec7b9"],

Cell["\<\
On a decomposition a relation of its complex has the obstruction it has on \
the complex.\
\>", "Notes",ExpressionUUID->"2133c9d9-7753-45ac-9528-535cc7d39325"],

Cell[TextData[{
 "The own axioms of a decomposition are conditions on its parts in every \
degree, so they take the empty tuple of arguments, and the obstruction is ",
 Cell[BoxData[
  FormBox["0", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "919ddeb7-2abd-4ac8-b4d5-3a2b59703787"],
 " when the axiom holds and otherwise the list of the degrees where it \
fails."
}], "Notes",ExpressionUUID->"002de08d-b809-4031-9e84-85b845f6e311"],

Cell["\<\
A relation the structure does not have, or a tuple whose length is not the \
arity of the relation, returns unevaluated.\
\>", "Notes",ExpressionUUID->"4ce1b8a7-8bb5-4a33-b3ec-080ef5597f8c"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Obstruction"]], "paclet:ChernSimons/ref/Obstruction", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "b297c749-7868-4f16-8920-c39eb2209f1d"],
 " has the following option:"
}], "Notes",ExpressionUUID->"88410e0c-626d-4bf8-b268-f22ac1804197"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "78d5c027-a754-4615-9e64-bdeae306d317"], Cell["Option", "TableText",
     FontWeight->Bold,ExpressionUUID->"5cf0723f-045d-4010-b420-a57d423ef31c"],
     Cell["Default", "TableText",
     FontWeight->Bold,ExpressionUUID->"e6177670-3920-464d-8f11-45e3eefc3e3f"],
     Cell["Description", "TableText",
     FontWeight->Bold,ExpressionUUID->"2f4e99f6-08b1-4599-8279-c85a988035d6"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "72595fa5-ead6-45be-9c06-d06016ccc000"], Cell[TextData[Cell[
    BoxData["\"\<EmptyWord\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "f5ee0eb6-eb8e-4bab-8521-5ebcdb9e44d3"]], "TableText",ExpressionUUID->
     "22081e67-b6fa-4174-9d43-d48e7a575723"], Cell[TextData[Cell[BoxData[
     TemplateBox[{
       Cell[
        TextData["False"]], "paclet:ref/False"},
      "RefLink",
      BaseStyle->"InlineFormula"]], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "1a6e9cfe-eaf8-4794-a1fd-0a6f0a43ffb4"]], "TableText",ExpressionUUID->
     "4e902bcf-50a7-4c50-9279-4e26f3d502de"], Cell["\<\
whether the operator and the bracket of the Maurer-Cartan equation of an \
element include the empty word\
\>", "TableText",ExpressionUUID->"8c9442e9-2509-4fb3-a82c-79a5f7f9e1e0"]}
  }]], "3ColumnTableMod",ExpressionUUID->"1697683a-1bd5-49e9-937a-\
a808d0c14c0a"],

Cell[TextData[{
 "The option applies to a Maurer-Cartan element and is given to ",
 Cell[BoxData[
  TemplateBox[{
