Cell["\<\
The Jacobi obstruction is the composite of the extensions of the bracket:\
\>", "ExampleText",ExpressionUUID->"e978a1e1-b90f-4e5c-9a88-b07c43aca0b5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Obstruction", "[", 
   RowBox[{
    RowBox[{"CanonicalLieBialgebra", "[", "pairing", "]"}], ",", 
    " ", "\"\<Jacobi\>\"", ",", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"CyclicWord", "[", 
       RowBox[{"{", "x", "}"}], "]"}], ",", " ", 
      RowBox[{"CyclicWord", "[", 
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "y"}], "}"}], "]"}], ",", " ", 
      RowBox[{"CyclicWord", "[", 
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "y", ",", " ", "y"}], "}"}], "]"}]}], "}"}]}], 
   "]"}], " ", "===", " ", 
  RowBox[{"Expand", "[", 
   RowBox[{"CanonicalLieBracket", "[", 
    RowBox[{
