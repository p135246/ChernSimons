      "3f2dfd7d-460d-4722-ae68-fca35c092fbf"],
     ", ",
     Cell[BoxData["\"\<Square\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "ef20f46f-3599-40ff-88f8-1ca4f6b775c3"],
     ", ",
     Cell[BoxData["\"\<Symmetry\>\""], "InlineFormula",
