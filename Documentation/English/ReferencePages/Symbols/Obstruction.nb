ionUUID->"d344f804-a440-43fe-b4fb-7f84dcdb830c"],

Cell[TextData[{
 "On a canonical Lie bialgebra the operations are ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CanonicalLieBracket"]], 
    "paclet:ChernSimons/ref/CanonicalLieBracket", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "9502de7a-d669-472a-a229-63ab4b91db69"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CanonicalLieCobracket"]], 
    "paclet:ChernSimons/ref/CanonicalLieCobracket", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "733798c4-f1d7-4263-b7c5-5fe9d38d3069"],
 " with their extensions to products, in the convention of the pairing, and \
with the empty word when the algebra has it."
}], "Notes",ExpressionUUID->"362be00c-6b2e-439e-9870-07f47bf39944"],

Cell["\<\
In the exterior convention the products in the string relations are exterior \
products.\
\>", "Notes",ExpressionUUID->"22331114-1d85-4562-9cfc-603d171285db"],

Cell["A cyclic word may be given as the list of its letters.", "Notes",ExpressionUUID->"36b47c16-dd35-4629-83a0-333624be8b37"],

Cell["\<\
On a canonical Lie bialgebra a nonzero value is a counterexample to the \
identity for that pairing.\
\>", "Notes",ExpressionUUID->"8de74907-28d5-4c37-be57-ba52f2d32d4b"],

Cell[TextData[{
 "On an A-infinity algebra the convention is the shifted one: the term whose \
inner operation takes the arguments ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["r", "TI"], "+", "1"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"b715866d-8770-4249-a2ac-53d8edf2710f"],
 " through ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["r", "TI"], "+", 
    StyleBox["s", "TI"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "52b7411e-f29b-4f8d-bfee-d862e5ae4f92"],
 " carries the sign of the sum of the shifted degrees of the first ",
 Cell[BoxData[
  FormBox[
   StyleBox["r", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "de4d5688-3743-4734-895e-eb96757c447a"],
 " arguments, and the relation on ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["e", "TI"], "1"], ",", "\[Ellipsis]", ",", 
    SubscriptBox[
     StyleBox["e", "TI"], 
     StyleBox["n", "TI"]]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"e6ccfa2e-1f44-4e1e-ad80-fb98551609c0"],
 " is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    UnderscriptBox["\[Sum]", 
     RowBox[{
      StyleBox["r", "TI"], "+", 
      StyleBox["s", "TI"], "+", 
      StyleBox["t", "TI"], "\[LongEqual]", 
      StyleBox["n", "TI"]}],
     LimitsPositioning->True], 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"-", "1"}], ")"}], 
     TemplateBox[{
       RowBox[{
         SubscriptBox[
          StyleBox["e", "TI"], "1"], "|", "+", "\[CenterEllipsis]", "+", "|", 
         
         SubscriptBox[
          StyleBox["e", "TI"], 
          StyleBox["r", "TI"]]}]},
      "Abs"]], " ", 
    SubscriptBox[
     StyleBox["m", "TI"], 
     RowBox[{
      StyleBox["r", "TI"], "+", "1", "+", 
      StyleBox["t", "TI"]}]], 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox[
       StyleBox["e", "TI"], "1"], ",", "\[Ellipsis]", ",", 
      SubscriptBox[
       StyleBox["e", "TI"], 
       StyleBox["r", "TI"]], ",", 
      SubscriptBox[
       StyleBox["m", "TI"], 
       StyleBox["s", "TI"]], 
      RowBox[{"(", 
       RowBox[{
        SubscriptBox[
         StyleBox["e", "TI"], 
         RowBox[{
          StyleBox["r", "TI"], "+", "1"}]], ",", "\[Ellipsis]", ",", 
        SubscriptBox[
         StyleBox["e", "TI"], 
         RowBox[{
          StyleBox["r", "TI"], "+", 
          StyleBox["s", "TI"]}]]}], ")"}], ",", "\[Ellipsis]", ",", 
      SubscriptBox[
       StyleBox["e", "TI"], 
       StyleBox["n", "TI"]]}], ")"}], "\[LongEqual]", "0"}], 
   TraditionalForm]], "InlineFormula",ExpressionUUID->
  "3c702877-5e24-4d9c-80b4-4cdcfc33ef29"],
 "."
}], "Notes",ExpressionUUID->"3f3f87f1-bfb5-4bbe-b550-09cb02050b9a"],

Cell[TextData[{
 "On an A-infinity morphism the left-hand side carries the same signs with \
the components ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["f", "TI"], 
    StyleBox["k", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "0f2b5582-8879-4583-a6d3-e51b951a2fc5"],
 " outside, and the right-hand side sums over all compositions of the \
arguments into blocks, so a target with operations beyond ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["m", "TI"], "2"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"d46f33c1-1a1d-4ebb-b96a-e4684b768e70"],
 " is handled."
}], "Notes",ExpressionUUID->"d6edb093-65a0-4daa-a00d-0c0b70dc2f4a"],

Cell["\<\
The two A-infinity obstructions are multilinear in the elements, each a \
linear combination of basis elements, and an argument outside the span of the \
basis returns unevaluated.\
\>", "Notes",ExpressionUUID->"c316ca11-0ac5-47f9-8760-d534d5b53cf0"],

Cell[TextData[{
 "On a Maurer-Cartan element the equation is the BD master equation over ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["R",
     FontSlant->"Plain"], 
    RowBox[{"[", 
     RowBox[{"[", "\[HBar]", "]"}], "]"}]}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"be7d6eb2-179d-4c37-9e19-30b2939fa861"],
 ", without inverting ",
 Cell[BoxData[
  FormBox["\[HBar]", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "271350a8-2fbe-4617-8b66-9036fc13e00d"],
 ". The bracket is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CanonicalBeilinsonDrinfeldBracket"]], 
    "paclet:ChernSimons/ref/CanonicalBeilinsonDrinfeldBracket", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "71abd102-0353-4eeb-bf94-4a0bd15b15a7"],
 ", so no negative power of ",
 Cell[BoxData[
  FormBox["\[HBar]", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "120739ac-e66d-40c7-a1c2-4b98b33c632d"],
 " appears."
}], "Notes",ExpressionUUID->"1f601094-f42a-4427-9662-0ebfad231dc1"],

Cell[TextData[{
 "The coefficient of the obstruction in ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["S",
      FontSlant->"Plain"], "\[ScriptL]"], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["C", "TI"], 
      RowBox[{"[", "1", "]"}]}], ")"}], 
    SuperscriptBox["\[HBar]", 
     StyleBox["g", "TI"]]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"e2b05af1-5327-46af-b4de-8b8a8beed4b6"],
 " is the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"\[ScriptL]", ",", 
     StyleBox["g", "TI"]}], ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"43b56b2e-d4b2-4218-a7a5-f9660af0082f"],
 " Maurer-Cartan equation."
}], "Notes",ExpressionUUID->"c120e0ea-8ea6-4a6c-8618-8120df43b53c"],

Cell[TextData[{
 "In the ",
 Cell[BoxData["\"\<Equations\>\""], "InlineFormula",ExpressionUUID->
  "236670be-c4df-48ab-b746-70eb117ea508"],
 " form the keys are the monomials, a power of ",
 Cell[BoxData[
  FormBox["\[HBar]", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "b0508a54-39de-4e31-9e58-a6d2b96b50eb"],
 " times a product of cyclic words, and the values the scalar coefficients, \
each of which must vanish. It is the form to give to ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Solve"]], "paclet:ref/Solve"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "029c1dd2-c2a4-4c4a-915c-82962ff793f0"],
 "."
}], "Notes",ExpressionUUID->"9d3ef5d9-410b-464c-8053-d22c5e588806"],

Cell[TextData[{
 "An element that solves the equation gives the empty Association in the ",
 Cell[BoxData["\"\<Equations\>\""], "InlineFormula",ExpressionUUID->
  "a3e241cf-80fb-468b-8b83-5716edd9ed88"],
 " form."
}], "Notes",ExpressionUUID->"ffded044-fa53-4f82-beb1-e35673c7f272"],

Cell[TextData[{
 "On an element whose pairing is in the exterior convention, ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Obstruction"]], "paclet:ChernSimons/ref/Obstruction", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "aea545af-2fca-4cf8-af87-2771184d875d"],
 " returns unevaluated."
}], "Notes",ExpressionUUID->"c6b3cd00-b94e-42d9-9557-ab80d2437e08"],

Cell["\<\
On a cochain complex with a pairing each relation is an identity, and the \
obstruction is the difference of its two sides, multilinear in the elements, \
each a linear combination of basis elements.\
\>", "Notes",ExpressionUUID->"3e8655bb-cc74-4289-8893-3772c3e0769b"],

Cell[TextData[{
 "For ",
 Cell[BoxData["\"\<DifferentialDegree\>\""], "InlineFormula",ExpressionUUID->
  "d9e89156-bbe7-48a5-9909-75320dacb15f"],
 " and ",
 Cell[BoxData["\"\<ProductDegree\>\""], "InlineFormula",ExpressionUUID->
  "da2b6f37-27ab-45b4-99ed-b9722d3e09cb"],
 " the obstruction is the part of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["d",
     FontSlant->"Plain"], 
    StyleBox["x", "TI"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "bb27c8db-a6d1-4ce1-9862-6f035d6d4451"],
 " or ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"x", "y"}], "TI"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"edaa927b-c364-49ce-8bb0-cadbf2ee84a7"],
 " outside the degree required."
}], "Notes",ExpressionUUID->"ba186390-f668-4be9-a5df-1000f7ce0d2f"],

Cell["\<\
On a decomposition a relation of its complex has the obstruction it has on \
the complex.\
\>", "Notes",ExpressionUUID->"2ab8bfd9-3c61-4121-a323-47d61821d9f5"],

Cell[TextData[{
 "The own axioms of a decomposition are conditions on its parts in every \
degree, so they take the empty tuple of arguments, and the obstruction is ",
 Cell[BoxData[
  FormBox["0", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "5939cb6e-d0bd-4cba-a051-2a5502e9f7c8"],
 " when the axiom holds and otherwise the list of the degrees where it \
fails."
}], "Notes",ExpressionUUID->"0640e263-04f0-4767-a874-d112ed51bbea"],

Cell["\<\
A relation the structure does not have, or a tuple whose length is not the \
arity of the relation, returns unevaluated.\
\>", "Notes",ExpressionUUID->"7a142694-25dd-4311-857a-99afeb1d20a8"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Obstruction"]], "paclet:ChernSimons/ref/Obstruction", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "9406d57e-acd6-43e6-970b-68c1f54ce521"],
 " has the following option:"
}], "Notes",ExpressionUUID->"b671704d-40a5-4fbf-bc76-c772af48334e"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "6ad00201-5cba-40a9-96e3-99a2f94ebe0f"], Cell["Option", "TableText",
     FontWeight->Bold,ExpressionUUID->"12e5d24e-0c00-42cd-b5cf-36ab85dde2ac"],
     Cell["Default", "TableText",
     FontWeight->Bold,ExpressionUUID->"515e5605-7113-4ef4-90d3-8472f4b60cd7"],
     Cell["Description", "TableText",
     FontWeight->Bold,ExpressionUUID->"3c9e8f38-07ac-4f53-8bb9-382dcdf82126"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "6efb143b-81cf-4d60-84ef-224774e15b37"], Cell[TextData[Cell[
    BoxData["\"\<EmptyWord\>\""], "InlineFormula",ExpressionUUID->
     "f1b3a420-1e56-443f-995c-03267e47bc83"]], "TableText",ExpressionUUID->
     "cf7a9d4c-ca35-42d1-a364-d76959bd51f6"], Cell[TextData[Cell[BoxData[
     TemplateBox[{
       Cell[
        TextData["False"]], "paclet:ref/False"},
      "RefLink",
      BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
     "18c07e0c-487f-4086-9b45-5fe4445d3e0b"]], "TableText",ExpressionUUID->
     "6bd99984-d17f-4e05-8405-d8c77c73561c"], Cell["\<\
whether the operator and the bracket of the Maurer-Cartan equation of an \
element include the empty word\
\>", "TableText",ExpressionUUID->"956cf8fc-2fba-4430-8c0d-0218c09fd6f7"]}
  }]], "3ColumnTableMod",ExpressionUUID->"9e89234b-9fbe-40b7-ae4f-\
9a6f8f1d481a"],

Cell[TextData[{
 "The option applies to a Maurer-Cartan element and is given to ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CanonicalBeilinsonDrinfeldOperator"]], 
    "paclet:ChernSimons/ref/CanonicalBeilinsonDrinfeldOperator", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "0d66829a-1cb2-4e16-8cc3-d732b62e18f6"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CanonicalBeilinsonDrinfeldBracket"]], 
    "paclet:ChernSimons/ref/CanonicalBeilinsonDrinfeldBracket", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "e6934edb-fd09-45a2-bb5e-90f38469e476"],
 "."
}], "Notes",ExpressionUUID->"47867ccf-e6b3-48c7-bef8-1061817febfa"],

Cell["\<\
A canonical Lie bialgebra carries its own empty-word setting, and the option \
given with a canonical Lie bialgebra returns unevaluated.\
\>", "Notes",ExpressionUUID->"6e6da983-5946-40dd-aa6c-1a2e45e42f1a"]
}, Open  ]],

