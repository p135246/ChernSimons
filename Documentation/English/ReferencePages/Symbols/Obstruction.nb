     "062dc82c-04b2-430d-b17a-432d9131740a"]], "TableText",ExpressionUUID->
     "e19e72e2-ba65-44e1-884a-b0c153704fcb"]},
   {Cell[TextData[Cell[BoxData[
     TemplateBox[{
       Cell[
        TextData["CochainComplexWithPairing"]], 
       "paclet:ChernSimons/ref/CochainComplexWithPairing", 
       "ChernSimons Package Symbol"},
      "PackageLink",
      BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
     "56f681fa-c09c-4246-a8f6-26aa4b40471c"]], "TableText",ExpressionUUID->
     "f6c14b78-0ec7-4d6a-b975-1e4da956501e"], Cell[TextData[Cell[
    BoxData["\"\<Leibniz\>\""], "InlineFormula",ExpressionUUID->
     "390de8dc-3094-429e-b3d8-2eff3690b931"]], "TableText",ExpressionUUID->
     "678bccd8-7ed2-4e46-b25f-534e2fadfd33"], Cell[TextData[{
     "two elements ",
     Cell[BoxData[
      FormBox[
       RowBox[{
        StyleBox["x", "TI"], ",", 
        StyleBox["y", "TI"]}], TraditionalForm]], "InlineFormula",
      ExpressionUUID->"f7bcddaa-6710-46c5-92fc-8c27e6b831a3"]
    }], "TableText",ExpressionUUID->"a78037df-e3a4-4b68-821a-9ed567aed2ab"], 
    Cell[TextData[Cell[BoxData[
     FormBox[
      RowBox[{
       StyleBox["d",
        FontSlant->"Plain"], 
       RowBox[{"(", 
        StyleBox[
         RowBox[{"x", "y"}], "TI"], ")"}], "-", 
       RowBox[{"(", 
        RowBox[{
         StyleBox["d",
          FontSlant->"Plain"], 
         StyleBox["x", "TI"]}], ")"}], 
       StyleBox["y", "TI"], "-", 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"-", "1"}], ")"}], 
        TemplateBox[{
          RowBox[{
            StyleBox["x", "TI"]}]},
         "Abs"]], 
       StyleBox["x", "TI"], " ", 
       StyleBox["d",
        FontSlant->"Plain"], 
       StyleBox["y", "TI"]}], TraditionalForm]], "InlineFormula",
     ExpressionUUID->"cab38ec1-491c-491f-ba60-745aac663a88"]], "TableText",
     ExpressionUUID->"59b2bd92-816b-48b7-ac28-5de36f993948"]},
   {Cell[TextData[Cell[BoxData[
     TemplateBox[{
       Cell[
        TextData["CochainComplexWithPairing"]], 
       "paclet:ChernSimons/ref/CochainComplexWithPairing", 
       "ChernSimons Package Symbol"},
      "PackageLink",
      BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
     "7a13f45b-2df6-4174-a6e1-8b3410d77a6f"]], "TableText",ExpressionUUID->
     "e9c07329-a8b6-4f38-934a-e998f848405f"], Cell[
    "the other axioms", "TableText",ExpressionUUID->
     "fb3102f8-7b0b-4c5c-b23a-aca4ced15adc"], Cell[
    "one to three elements", "TableText",ExpressionUUID->
     "8cc8137c-caa8-46f9-99c5-e92f061c6ef8"], Cell[
    "the difference of the two sides", "TableText",ExpressionUUID->
     "e71f1f89-cd1c-4345-8b3d-ab241922e550"]},
   {Cell[TextData[{
     Cell[BoxData[
      TemplateBox[{
