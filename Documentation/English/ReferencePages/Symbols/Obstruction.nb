    "the degrees where the axiom fails", "TableText",ExpressionUUID->
     "c56dfb57-5595-4173-bb0a-17b723a21a3b"]},
   {Cell[TextData[Cell[BoxData[
     TemplateBox[{
       Cell[
        TextData["SpecialPropagator"]], 
       "paclet:ChernSimons/ref/SpecialPropagator", 
       "ChernSimons Package Symbol"},
      "PackageLink",
      BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
     "00c96bdb-5465-41bb-84f3-57b194b97fd8"]], "TableText",ExpressionUUID->
     "961d71d8-999a-4d76-b03a-36d7f23f16ac"], Cell[TextData[{
     Cell[BoxData["\"\<Chain\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "66580afd-36d4-433e-9159-efcd4cb4d6fa"],
     ", ",
     Cell[BoxData["\"\<Projector\>\""], "InlineFormula",
