ionUUID->"e3f6b43f-a991-422f-a0a2-71af3ab1371b"],

Cell[TextData[{
 "On a canonical Lie bialgebra the operations are ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CanonicalLieBracket"]], 
    "paclet:ChernSimons/ref/CanonicalLieBracket", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "844bbdaa-49fb-4f1f-acc0-05894224383c"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CanonicalLieCobracket"]], 
    "paclet:ChernSimons/ref/CanonicalLieCobracket", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "2822ea4e-1272-4c2c-be3a-6265d3312d17"],
 " with their extensions to products, in the convention of the pairing, and \
with the empty word when the algebra has it."
}], "Notes",ExpressionUUID->"73d96673-dfb5-44f4-9d4a-fa3967df9993"],

Cell["\<\
In the exterior convention the products in the string relations are exterior \
products.\
\>", "Notes",ExpressionUUID->"87c2f6cd-136d-4faf-bdf1-3eca7977f387"],

Cell["A cyclic word may be given as the list of its particles.", "Notes",ExpressionUUID->"880bbd36-53b0-4914-b104-24dfe35e5401"],

Cell["\<\
On a canonical Lie bialgebra a nonzero value is a counterexample to the \
identity for that pairing.\
\>", "Notes",ExpressionUUID->"5bf78e2f-86a7-428d-8052-f26a43b701a7"],

Cell[TextData[{
 "On an A-infinity algebra the convention is the shifted one: the term whose \
inner operation takes the arguments ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["r", "TI"], "+", "1"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"f793a9c6-8093-4b1c-9513-5aecc97c1744"],
 " through ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["r", "TI"], "+", 
    StyleBox["s", "TI"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "7972b1f8-22d8-422f-8b13-001cbf756d24"],
 " carries the sign of the sum of the shifted degrees of the first ",
 Cell[BoxData[
  FormBox[
   StyleBox["r", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "f481b64c-80d6-49c5-b584-9ec13ff2c367"],
 " arguments, and the relation on ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["e", "TI"], "1"], ",", "\[Ellipsis]", ",", 
    SubscriptBox[
     StyleBox["e", "TI"], 
     StyleBox["n", "TI"]]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"4b48b3f6-3d1c-45ba-9d73-11a352714866"],
 " is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    UnderscriptBox["\[Sum]", 
     RowBox[{
      StyleBox["r", "TI"], "+", 
      StyleBox["s", "TI"], "+", 
      StyleBox["t", "TI"], "\[LongEqual]", 
      StyleBox["n", "TI"]}],
     LimitsPositioning->True], 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"-", "1"}], ")"}], 
     TemplateBox[{
       RowBox[{
         SubscriptBox[
          StyleBox["e", "TI"], "1"], "|", "+", "\[CenterEllipsis]", "+", "|", 
         
         SubscriptBox[
          StyleBox["e", "TI"], 
          StyleBox["r", "TI"]]}]},
      "Abs"]], " ", 
    SubscriptBox[
     StyleBox["m", "TI"], 
     RowBox[{
      StyleBox["r", "TI"], "+", "1", "+", 
      StyleBox["t", "TI"]}]], 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox[
       StyleBox["e", "TI"], "1"], ",", "\[Ellipsis]", ",", 
      SubscriptBox[
       StyleBox["e", "TI"], 
       StyleBox["r", "TI"]], ",", 
      SubscriptBox[
       StyleBox["m", "TI"], 
       StyleBox["s", "TI"]], 
      RowBox[{"(", 
       RowBox[{
        SubscriptBox[
         StyleBox["e", "TI"], 
         RowBox[{
          StyleBox["r", "TI"], "+", "1"}]], ",", "\[Ellipsis]", ",", 
        SubscriptBox[
         StyleBox["e", "TI"], 
         RowBox[{
          StyleBox["r", "TI"], "+", 
          StyleBox["s", "TI"]}]]}], ")"}], ",", "\[Ellipsis]", ",", 
      SubscriptBox[
       StyleBox["e", "TI"], 
       StyleBox["n", "TI"]]}], ")"}], "\[LongEqual]", "0"}], 
   TraditionalForm]], "InlineFormula",ExpressionUUID->
  "b6f74478-04d8-411c-8ec7-e7f27de97b78"],
 "."
}], "Notes",ExpressionUUID->"8ee115b8-7a30-4057-835b-f351b40b0fb8"],

Cell[TextData[{
 "On an A-infinity morphism the left-hand side carries the same signs with \
the components ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["f", "TI"], 
    StyleBox["k", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "ed50f560-6bf3-4a47-ad19-0d36b856966b"],
 " outside, and the right-hand side sums over all compositions of the \
arguments into blocks, so a target with operations beyond ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["m", "TI"], "2"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"4e816306-70f3-4ba6-9851-25157bd8bcac"],
 " is handled."
}], "Notes",ExpressionUUID->"b6fa38cf-1ab9-402c-a14e-931cb8f6ba17"],

Cell["\<\
The two A-infinity obstructions are multilinear in the elements, each a \
linear combination of basis elements, and an argument outside the span of the \
basis returns unevaluated.\
\>", "Notes",ExpressionUUID->"9d5a9a00-7554-42d2-867d-3088f9c2fe61"],

Cell[TextData[{
 "On a Maurer-Cartan element the equation is the BD master equation over ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["R",
     FontSlant->"Plain"], 
    RowBox[{"[", 
     RowBox[{"[", "\[HBar]", "]"}], "]"}]}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"be5d5b77-d566-461c-962c-3ab0def5bf68"],
 ", without inverting ",
 Cell[BoxData[
  FormBox["\[HBar]", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "108c0762-9a6f-41f9-9cf9-444d69eb0ac3"],
 ". The bracket is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CanonicalBeilinsonDrinfeldBracket"]], 
    "paclet:ChernSimons/ref/CanonicalBeilinsonDrinfeldBracket", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "3dac8d3b-4f1d-4603-946f-abdb0ea11e67"],
 ", so no negative power of ",
 Cell[BoxData[
  FormBox["\[HBar]", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "bea41fc2-db2e-4e12-ba9d-78aedba4e104"],
 " appears."
}], "Notes",ExpressionUUID->"3104f502-c063-4294-85d4-ba70657db2b5"],

Cell[TextData[{
 "The coefficient of the obstruction in ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["S",
      FontSlant->"Plain"], "\[ScriptL]"], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["C", "TI"], 
      RowBox[{"[", "1", "]"}]}], ")"}], 
    SuperscriptBox["\[HBar]", 
     StyleBox["g", "TI"]]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"885364c6-46fe-46c7-a0b0-2096b22cbae5"],
 " is the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"\[ScriptL]", ",", 
     StyleBox["g", "TI"]}], ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"24d50018-901b-4237-9a64-36427a88841a"],
 " Maurer-Cartan equation."
}], "Notes",ExpressionUUID->"98fb3a3d-2f0a-45a1-b777-9b1b08c016cf"],

Cell[TextData[{
 "In the ",
 Cell[BoxData["\"\<Equations\>\""], "InlineFormula",ExpressionUUID->
  "9bfab440-f84b-4f5e-bc97-99b1bcc98eb3"],
 " form the keys are the monomials, a power of ",
 Cell[BoxData[
  FormBox["\[HBar]", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "6f67f9c9-da6a-4c38-8cac-5f0066ecbe82"],
 " times a product of cyclic words, and the values the scalar coefficients, \
each of which must vanish. It is the form to give to ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Solve"]], "paclet:ref/Solve"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "3e532574-29fc-487b-aaad-1a8e925b3213"],
 "."
}], "Notes",ExpressionUUID->"cf83c88c-9748-48b7-80ed-13af6c4a7215"],

Cell[TextData[{
 "An element that solves the equation gives the empty Association in the ",
 Cell[BoxData["\"\<Equations\>\""], "InlineFormula",ExpressionUUID->
  "bf07f711-0d6c-4b0d-9176-8e6c3c8ba5b9"],
 " form."
}], "Notes",ExpressionUUID->"e7b497ab-c89e-4e68-af32-38a7f4c8974f"],

Cell[TextData[{
 "On an element whose pairing is in the exterior convention, ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Obstruction"]], "paclet:ChernSimons/ref/Obstruction", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "9086438c-f70b-43d1-8e36-69086c8d72ab"],
 " returns unevaluated."
}], "Notes",ExpressionUUID->"3a7f1b71-15e7-4f14-bb1d-64b4e5176592"],

Cell["\<\
On a cochain complex with a pairing each relation is an identity, and the \
obstruction is the difference of its two sides, multilinear in the elements, \
each a linear combination of basis elements.\
\>", "Notes",ExpressionUUID->"4e249326-ab90-4526-8091-b51b0d142aab"],

Cell[TextData[{
 "For ",
 Cell[BoxData["\"\<DifferentialDegree\>\""], "InlineFormula",ExpressionUUID->
  "888d6afa-c629-4381-b0df-25e4250c550c"],
 " and ",
 Cell[BoxData["\"\<ProductDegree\>\""], "InlineFormula",ExpressionUUID->
  "f509a9a3-9022-4c0c-90f2-165ea4f7c38c"],
 " the obstruction is the part of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["d",
     FontSlant->"Plain"], 
    StyleBox["x", "TI"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "99f926f4-e557-441b-a475-ca51799caf80"],
 " or ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"x", "y"}], "TI"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"39730787-3a3b-4956-9a7c-30d5f026799b"],
 " outside the degree required."
}], "Notes",ExpressionUUID->"23b060c5-ce11-42e7-8bad-f3cb82ec7ea8"],

Cell["\<\
On a decomposition a relation of its complex has the obstruction it has on \
the complex.\
\>", "Notes",ExpressionUUID->"0319fcab-a456-407d-8f60-1108f3e2f13a"],

Cell[TextData[{
 "The own axioms of a decomposition are conditions on its parts in every \
degree, so they take the empty tuple of arguments, and the obstruction is ",
 Cell[BoxData[
  FormBox["0", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "4e23963d-9ced-4402-8348-b7a02bc5e77f"],
 " when the axiom holds and otherwise the list of the degrees where it \
fails."
}], "Notes",ExpressionUUID->"712ec056-5e90-49fd-8d16-dd5635fd3aa0"],

Cell["\<\
A relation the structure does not have, or a tuple whose length is not the \
arity of the relation, returns unevaluated.\
\>", "Notes",ExpressionUUID->"8e617218-c75d-46cb-8769-0b52a9260258"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Obstruction"]], "paclet:ChernSimons/ref/Obstruction", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "44ab690a-4ab8-4fb2-83cb-3bfa39613419"],
 " has the following option:"
}], "Notes",ExpressionUUID->"02210edf-0ea8-4c01-8ec9-e950393423a1"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "b1d1a4cc-3430-4417-9139-7a5507b59f5d"], Cell["Option", "TableText",
     FontWeight->Bold,ExpressionUUID->"1082ad87-45ca-4955-a94a-2ee9c669cef4"],
     Cell["Default", "TableText",
     FontWeight->Bold,ExpressionUUID->"09aa7801-d09a-4b69-bd84-73febe7e8455"],
     Cell["Description", "TableText",
     FontWeight->Bold,ExpressionUUID->"392860e9-9c40-4264-ae92-04c3e1e8495f"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "338e61ae-4753-41e1-be98-a75fd78cc3ce"], Cell[TextData[Cell[
    BoxData["\"\<EmptyWord\>\""], "InlineFormula",ExpressionUUID->
     "0efbd4e0-eae3-48d2-95fd-f09229fdf3c4"]], "TableText",ExpressionUUID->
     "fc17d56f-75b8-45ec-acc8-f334ffba2869"], Cell[TextData[Cell[BoxData[
     TemplateBox[{
       Cell[
        TextData["False"]], "paclet:ref/False"},
      "RefLink",
      BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
     "11254917-6d40-4a58-a1ff-90b920c7139b"]], "TableText",ExpressionUUID->
     "dd1fbab4-5dfe-43dc-9f93-9b4eaabf544d"], Cell["\<\
whether the operator and the bracket of the Maurer-Cartan equation of an \
element include the empty word\
\>", "TableText",ExpressionUUID->"4a848c05-cedc-4f2a-bab2-c7fdcc4b4ec3"]}
  }]], "3ColumnTableMod",ExpressionUUID->"00fb895f-7ff2-4035-8c30-\
d6d4b3e6037a"],

Cell[TextData[{
 "The option applies to a Maurer-Cartan element and is given to ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CanonicalBeilinsonDrinfeldOperator"]], 
    "paclet:ChernSimons/ref/CanonicalBeilinsonDrinfeldOperator", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "84202ac8-7a09-4084-8faf-c7cbfdf9d25a"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CanonicalBeilinsonDrinfeldBracket"]], 
    "paclet:ChernSimons/ref/CanonicalBeilinsonDrinfeldBracket", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "8c82ac9c-2640-470f-a198-a5fe000578bc"],
 "."
}], "Notes",ExpressionUUID->"488bc1ec-299c-4d9b-bc72-20090ab7f6b1"],

Cell["\<\
A canonical Lie bialgebra carries its own empty-word setting, and the option \
given with a canonical Lie bialgebra returns unevaluated.\
\>", "Notes",ExpressionUUID->"7a8b1aee-e973-4448-9e1c-7eb3998bb573"]
}, Open  ]],

Cell[CellGroupData[{

