  }]], "3ColumnTableMod",ExpressionUUID->"9ac22e60-8b23-4e81-9621-\
b35019019598"],

Cell[TextData[{
 "The rule may also be given positionally as a third argument, which is the \
same as setting the ",
 Cell[BoxData["\"\<Rule\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "49f5238b-a436-49b3-8489-55febdee1002"],
 " option."
}], "Notes",ExpressionUUID->"5d972c18-2360-47b8-a852-e3d1a96ec513"],

Cell[TextData[{
 StyleBox["The reversal rule is the one that matters.",
  FontWeight->"Bold"],
 " It is the convention that intertwines ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Bracket"]], "paclet:IBLInfinity/ref/Bracket", 
    "IBLInfinity Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "f1defbed-561d-41bb-b776-b14fd8988c76"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Cobracket"]], "paclet:IBLInfinity/ref/Cobracket", 
    "IBLInfinity Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "305fdb1a-ee09-49ab-9c1d-e56749e8022e"],
 " in every arity; the position rule does not, and is provided so that the \
difference between the two can be examined rather than assumed."
}], "Notes",ExpressionUUID->"afb4d04a-d44b-4fd6-9f25-72fbd04c71e3"],

Cell["\<\
The two rules differ by a sign that depends on the degrees of the factors and \
on how many there are. Over the alphabet of the circle they coincide on every \
product of an even number of factors, and differ on some products of every \
odd number \[LongDash] including on a single factor, where they disagree \
exactly when its symmetric degree is even.\
\>", "Notes",ExpressionUUID->"689f18a4-69b0-4d70-9c82-9e902a6701e7"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{"\"\<Inverse\>\"", " ", "->", " ", "True"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4d81f75a-d8d9-4bb7-9f62-27821de7e5dd"],
 " the map runs the other way, from ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ExteriorProduct"]], "paclet:IBLInfinity/ref/ExteriorProduct", 
    "IBLInfinity Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "444fec85-87ff-4dd2-8be8-db6c46e5f02c"],
 " to ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SymmetricProduct"]], "paclet:IBLInfinity/ref/SymmetricProduct",
     "IBLInfinity Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "0cb1024a-b9ea-46f5-a71c-2ff898a9d938"],
 "."
}], "Notes",ExpressionUUID->"1b8e983d-6581-4a03-834e-68126dc24343"]
}, Open  ]],

