      FontSize->0.9 Inherited,ExpressionUUID->
      "6d623ced-b373-4a57-81df-cf89028f2140"]
    }], "TableText",ExpressionUUID->"2f40cd98-c436-4279-97df-7b4808c0aa98"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "f87941c3-7e34-47b5-b4bb-6d6e77f17ce8"], Cell[TextData[Cell[
