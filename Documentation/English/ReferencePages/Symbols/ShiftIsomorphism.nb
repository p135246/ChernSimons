af90e0a680f7"],

Cell[TextData[{
 "The rule may also be given positionally as a third argument, which is the \
same as setting the ",
 Cell[BoxData["\"\<Rule\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "070653c1-9a16-48a0-bc9a-0b2609f91dcb"],
 " option."
}], "Notes",ExpressionUUID->"2d32abea-ddd5-45d6-af0a-8935d5aacc82"],

Cell[TextData[{
 StyleBox["The reversal rule is the one that matters.",
  FontWeight->"Bold"],
 " It is the convention that intertwines ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InvolutiveBracket"]], 
    "paclet:ChernSimons/ref/InvolutiveBracket", "ChernSimons Package Symbol"},
   
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "16835ac9-e0d3-46b5-b235-44180a06a297"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InvolutiveCobracket"]], 
    "paclet:ChernSimons/ref/InvolutiveCobracket", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "a20da4ae-7478-46bb-9976-00e388171bee"],
 " in every arity; the position rule does not, and is provided so that the \
difference between the two can be examined rather than assumed."
}], "Notes",ExpressionUUID->"ed6b957f-b868-4c46-8760-a1b30ec33f3f"],

Cell["\<\
The two rules differ by a sign that depends on the degrees of the factors and \
on how many there are. Over the alphabet of the circle they coincide on every \
product of an even number of factors, and differ on some products of every \
odd number \[LongDash] including on a single factor, where they disagree \
exactly when its symmetric degree is even.\
\>", "Notes",ExpressionUUID->"7c10c4c0-a863-47b3-a4f0-a77ace33031e"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{"\"\<Inverse\>\"", " ", "->", " ", "True"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "081c5fdd-f773-45dd-9f36-43d9e3cc7ebf"],
 " the map runs the other way, from ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ExteriorProduct"]], "paclet:ChernSimons/ref/ExteriorProduct", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "3d4cdcab-48f8-44d2-bbeb-d92cdea084db"],
 " to ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SymmetricProduct"]], "paclet:ChernSimons/ref/SymmetricProduct",
     "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "254f6aa5-b620-4f42-bd79-7e51e30dfdce"],
 "."
}], "Notes",ExpressionUUID->"dfcf4f36-7cf6-4b0c-9467-37effc9254dc"]
}, Open  ]],

