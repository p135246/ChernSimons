     FontWeight->Bold,ExpressionUUID->"596d0fd5-a264-4243-a93a-e9c52e61ec5c"],
     Cell["effect", "TableText",
     FontWeight->Bold,ExpressionUUID->"eafc697d-60f2-424e-9025-fcf3cf4a6d0e"]},
