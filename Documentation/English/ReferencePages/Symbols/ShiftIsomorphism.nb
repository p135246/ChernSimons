Cell[TextData[{
 "The direction is set by the ",
 Cell[BoxData["\"\<Inverse\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dcb16480-9efc-4702-8ed5-2c407e4aef69"],
 " option alone, never by the ",
 Cell[BoxData["\"\<Convention\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "045c4079-f64b-46bb-beec-c4ecc2d0b46b"],
 " key of the pairing object. The inverse of an ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ExteriorProduct"]], "paclet:ChernSimons/ref/ExteriorProduct", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "309d7a1c-4753-45c1-97b6-940cc67e7222"],
 " is taken against the same pairing object as the forward map."
}], "ExampleText",ExpressionUUID->"12f7b49a-bf0a-469c-8090-1313d7867df4"],

