Cell[TextData[{
 "The direction is set by the ",
 Cell[BoxData["\"\<Inverse\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3f21274e-b161-4566-8dc1-df1503f79753"],
 " option alone, never by the ",
