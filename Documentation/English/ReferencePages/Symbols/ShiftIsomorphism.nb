Cell[CellGroupData[{
Cell["ShiftIsomorphism", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"e6443c8c-ab01-4e12-9695-99631d13dbdf"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["ShiftIsomorphism"]], 
     "paclet:IBLInfinity/ref/ShiftIsomorphism", "IBLInfinity Package Symbol"},
    
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["e", "TI"], ",", " ", 
    StyleBox["pairing", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bc6f2eac-85d8-4b5d-b0f7-a92ba94268a6"],
 "\[LineSeparator]",
 "sends a symmetric product ",
 StyleBox["e", "TI"],
 " to an exterior one by the reversal rule.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"cbea7f8d-9ea2-4734-a056-053f24825391"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["ShiftIsomorphism"]], 
     "paclet:IBLInfinity/ref/ShiftIsomorphism", "IBLInfinity Package Symbol"},
    
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["e", "TI"], ",", " ", 
    StyleBox["pairing", "TI"], ",", " ", "\"\<Position\>\""}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b6f0b2aa-ff55-4a60-83f1-c400cecc2e7f"],
 "\[LineSeparator]",
 "uses the position rule instead."
}], "Usage",ExpressionUUID->"7d6c98ca-ba7c-4677-a146-d9a8c94a5957"],

Cell[TextData[{
 "The symmetric and exterior products are graded by ",
 Cell[BoxData[
  SubscriptBox[
   RowBox[{
    StyleBox["[",
     SpanMaxSize->1], "-", 
    StyleBox["]",
     SpanMaxSize->1]}], "1"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0dcf64cf-df13-439c-abe3-3aa101826291"],
 " and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["[",
    SpanMaxSize->1], "-", 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6f36822a-2b00-47e5-8319-a8a040760701"],
 ", one apart, so a product of ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9661daa1-a453-43ec-8613-bfdd58d3859f"],
 " factors picks up a sign under the shift that depends on the degrees and on \
",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5a585350-d85e-4202-a9ee-4ba0173c0ddf"],
 ". The map that implements this is the d\[EAcute]calage isomorphism, and \
there is more than one sign convention for it."
}], "Notes",ExpressionUUID->"1769cab5-da7e-498c-9454-ff9a475de026"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "2199c59c-23f1-4e8d-b845-d141ab58656e"], Cell["option", "TableText",
     FontWeight->Bold,ExpressionUUID->"c4656dfc-ec4d-4210-b2d8-dc1f823c9482"],
     Cell["default", "TableText",
     FontWeight->Bold,ExpressionUUID->"dfc4292d-1f48-4a63-9176-92b886278db1"],
     Cell["effect", "TableText",
     FontWeight->Bold,ExpressionUUID->"d1ab579a-c908-4739-929b-affa5628507d"]},
