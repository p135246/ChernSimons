Cell[TextData[{
 "Over every product of at most four words of length at most ",
 Cell[BoxData[
  FormBox["3", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "20d5d465-fa8f-4b8d-b5dd-261e723b4217"],
 ", the two rules agree on all the even numbers of factors and disagree on \
some of the odd ones:"
}], "ExampleText",ExpressionUUID->"3a3bb438-ec26-4f80-aaf2-4b985666ef92"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"pairing", " ", "=", " ", 
   RowBox[{"GradedPairing", "[", 
    RowBox[{
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"x", " ", "->", " ", 
        RowBox[{"-", "1"}]}], ",", " ", 
       RowBox[{"y", " ", "->", " ", "0"}]}], "|>"}], ",", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "y"}], "}"}], " ", "->", " ", "1"}], "|>"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"words", " ", "=", " ", 
   RowBox[{"CyclicWords", "[", 
    RowBox[{"3", ",", " ", "pairing", ",", " ", 
     RowBox[{"\"\<UpTo\>\"", " ", "->", " ", "True"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"Table", "[", 
  RowBox[{
   RowBox[{"k", " ", "->", " ", 
    RowBox[{"Tally", "[", 
     RowBox[{"Table", "[", "\n", "     ", 
      RowBox[{
       RowBox[{"SameQ", "[", 
        RowBox[{
         RowBox[{"ShiftIsomorphism", "[", 
          RowBox[{
           RowBox[{"SymmetricProduct", " ", "@@", " ", 
            RowBox[{"Append", "[", 
             RowBox[{"tuple", ",", " ", "pairing"}], "]"}]}], ",", " ", 
           "pairing"}], "]"}], ",", "\n", "       ", 
         RowBox[{"ShiftIsomorphism", "[", 
          RowBox[{
           RowBox[{"SymmetricProduct", " ", "@@", " ", 
            RowBox[{"Append", "[", 
             RowBox[{"tuple", ",", " ", "pairing"}], "]"}]}], ",", " ", 
           "pairing", ",", " ", "\"\<Position\>\""}], "]"}]}], "]"}], ",", 
       "\n", "     ", 
       RowBox[{"{", 
        RowBox[{"tuple", ",", " ", 
         RowBox[{"Tuples", "[", 
          RowBox[{"words", ",", " ", "k"}], "]"}]}], "}"}]}], "]"}], "]"}]}], 
   ",", " ", 
   RowBox[{"{", 
    RowBox[{"k", ",", " ", "4"}], "}"}]}], "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"91f0bac2-cd2c-478c-a3f9-23eb952e433b"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"1", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"True", ",", "4"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"False", ",", "4"}], "}"}]}], "}"}]}], ",", 
   RowBox[{"2", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"{", 
      RowBox[{"True", ",", "64"}], "}"}], "}"}]}], ",", 
   RowBox[{"3", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"True", ",", "304"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"False", ",", "208"}], "}"}]}], "}"}]}], ",", 
   RowBox[{"4", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"{", 
      RowBox[{"True", ",", "4096"}], "}"}], "}"}]}]}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"7d921b10-2fe3-45c8-92d9-c777d30266c4"]
}, Open  ]]
}, Open  ]],

