     RowBox[{"CyclicWord", "[", 
      RowBox[{"{", 
       RowBox[{"y", ",", " ", "y"}], "}"}], "]"}], ",", " ", "pairing"}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
