Cell[TextData[{
 "Over every product of at most four words of length at most ",
 Cell[BoxData["3"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "97b57474-0132-4ff5-8c25-a62856260e21"],
 ", the two rules agree on all the even numbers of factors and disagree on \
some of the odd ones:"
}], "ExampleText",ExpressionUUID->"8cbc84c9-c0b9-46bd-9020-908cf594cf39"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"pairing", " ", "=", " ", 
   RowBox[{"Pairing", "[", 
    RowBox[{
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"x", " ", "->", " ", 
        RowBox[{"-", "1"}]}], ",", " ", 
       RowBox[{"y", " ", "->", " ", "0"}]}], "|>"}], ",", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "y"}], "}"}], " ", "->", " ", "1"}], "|>"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"words", " ", "=", " ", 
   RowBox[{"CyclicWords", "[", 
    RowBox[{"3", ",", " ", "pairing", ",", " ", 
