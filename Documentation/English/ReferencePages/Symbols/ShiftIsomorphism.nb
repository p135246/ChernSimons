      FontSize->0.9 Inherited,ExpressionUUID->
      "ebc2171b-4d0d-4aed-a199-a029a73e8d69"]
    }], "TableText",ExpressionUUID->"24cf42f1-22f5-43b8-952b-d6bb8aed8ba8"]},
