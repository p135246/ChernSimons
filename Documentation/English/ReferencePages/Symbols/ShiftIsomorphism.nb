Cell["\<\
Sending a two-factor symmetric product to the exterior picture:\
\>", "ExampleText",ExpressionUUID->"f487279d-4cbf-4ff6-8adc-0443f0fb9771"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"pairing", " ", "=", " ", 
   RowBox[{"GradedPairing", "[", 
    RowBox[{
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"x", " ", "->", " ", 
        RowBox[{"-", "1"}]}], ",", " ", 
       RowBox[{"y", " ", "->", " ", "0"}]}], "|>"}], ",", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "y"}], "}"}], " ", "->", " ", "1"}], "|>"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{"ShiftIsomorphism", "[", 
  RowBox[{
   RowBox[{"SymmetricProduct", "[", 
    RowBox[{
     RowBox[{"CyclicWord", "[", 
      RowBox[{"{", "x", "}"}], "]"}], ",", " ", 
     RowBox[{"CyclicWord", "[", 
      RowBox[{"{", "y", "}"}], "]"}], ",", " ", "pairing"}], "]"}], ",", " ", 
   "pairing"}], "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"86ac6e61-7890-4f5b-bab8-913612f1e61e"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{
   InterpretationBox[
    RowBox[{"(", "x", ")"}],
    ChernSimons`CyclicWord[{MTNB$9az1n12o1ort`x}],
    Editable->False], "\[Wedge]", 
   InterpretationBox[
    RowBox[{"(", "y", ")"}],
    ChernSimons`CyclicWord[{MTNB$9az1n12o1ort`y}],
    Editable->False]}],
  ChernSimons`ExteriorProduct[
   ChernSimons`CyclicWord[{MTNB$9az1n12o1ort`x}], 
   ChernSimons`CyclicWord[{MTNB$9az1n12o1ort`y}]],
  Editable->False]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"fb9fc9f6-7391-4771-b971-c58e876274e7"]
}, Open  ]],

