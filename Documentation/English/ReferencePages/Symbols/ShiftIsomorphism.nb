    RowBox[{"ShiftIsomorphism", "[", 
     RowBox[{"e", ",", " ", "pairing"}], "]"}], ",", " ", "pairing", ",", " ", 
    RowBox[{"\"\<Inverse\>\"", " ", "->", " ", "True"}]}], "]"}], " ", "===", 
