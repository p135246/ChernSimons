      RowBox[{"{", 
       RowBox[{"x", ",", " ", "y", ",", " ", "y", ",", " ", "y"}], "}"}], 
      "]"}], ",", " ", "exterior"}], "]"}]}], "}"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"72e0c915-4f38-4444-80e0-ecdda816e2b0"],

