Cell["The two rules agree on this two-factor product:", "ExampleText",ExpressionUUID->"f91867da-a028-4a91-94b0-7c843289e626"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"pairing", " ", "=", " ", 
   RowBox[{"Pairing", "[", 
    RowBox[{
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"x", " ", "->", " ", 
        RowBox[{"-", "1"}]}], ",", " ", 
       RowBox[{"y", " ", "->", " ", "0"}]}], "|>"}], ",", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "y"}], "}"}], " ", "->", " ", "1"}], "|>"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"e", " ", "=", " ", 
   RowBox[{"SymmetricProduct", "[", 
    RowBox[{
     RowBox[{"CyclicWord", "[", 
      RowBox[{"{", "x", "}"}], "]"}], ",", " ", 
     RowBox[{"CyclicWord", "[", 
      RowBox[{"{", "y", "}"}], "]"}], ",", " ", "pairing"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"ShiftIsomorphism", "[", 
   RowBox[{"e", ",", " ", "pairing"}], "]"}], " ", "===", " ", 
  RowBox[{"ShiftIsomorphism", "[", 
   RowBox[{"e", ",", " ", "pairing", ",", " ", "\"\<Position\>\""}], 
   "]"}]}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"4e2034e1-4821-46a3-a415-e98b9e0cb911"],

