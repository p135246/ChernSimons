Cell[CellGroupData[{
Cell["ShiftIsomorphism", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"35e1afa8-5778-4da2-b673-4c21c58b406f"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["ShiftIsomorphism"]], 
     "paclet:ChernSimons/ref/ShiftIsomorphism", "ChernSimons Package Symbol"},
    
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["e", "TI"], ",", " ", 
    StyleBox["pairing", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "25553847-f4bd-4adb-aaaf-ba0158df0ec8"],
 "\[LineSeparator]",
 "sends a symmetric product ",
 StyleBox["e", "TI"],
 " to an exterior one by the reversal rule.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"8f66e0dd-b70c-48f6-a25a-cedacac09481"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["ShiftIsomorphism"]], 
     "paclet:ChernSimons/ref/ShiftIsomorphism", "ChernSimons Package Symbol"},
    
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["e", "TI"], ",", " ", 
    StyleBox["pairing", "TI"], ",", " ", "\"\<Position\>\""}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8792edec-33e1-4c9c-9d28-e8e5862d2d57"],
 "\[LineSeparator]",
 "uses the position rule instead."
}], "Usage",ExpressionUUID->"2a3149a1-4cfa-4311-b27d-e68c267820e6"],

Cell[TextData[{
 "The symmetric and exterior products are graded by ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    RowBox[{"[", "-", "]"}], "1"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fcbaaced-164f-462a-b29c-5abb76819483"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"[", "-", "]"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1a0ce4f7-69b9-4668-9aa6-23d315a35379"],
 ", one apart, so a product of ",
 Cell[BoxData[
  FormBox[
   StyleBox["k", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ec111eaa-6dc4-483b-be5e-b0affc4216c5"],
 " factors picks up a sign under the shift that depends on the degrees and on \
",
 Cell[BoxData[
  FormBox[
   StyleBox["k", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "09cdf879-a175-478c-97a3-1ce3a85a87eb"],
 ". The map that implements this is the d\[EAcute]calage isomorphism, and \
there is more than one sign convention for it."
}], "Notes",ExpressionUUID->"5797d6d0-8cf4-4423-9814-d4372ac79a9c"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "815eef58-94d8-4b7e-bc34-d35effcf35e3"], Cell["option", "TableText",
