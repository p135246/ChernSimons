}], "Notes",ExpressionUUID->"aa7f1903-c679-4780-89d9-05f9b4f85786"],

Cell[TextData[{
 "In the forms with an element, ",
 StyleBox["e", "TI"],
 " is a linear combination of basis elements of the complex, and anything \
else returns unevaluated."
}], "Notes",ExpressionUUID->"32c20411-d09c-4570-9724-70741e1497cc"],

