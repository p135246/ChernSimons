          GridBoxItemSize -> {"Columns" -> {
              Scaled[0.15], 
              Scaled[0.68], 
              Scaled[0.15], 
              Scaled[0.02]}}]]], "\n"}], "TextAnnotation", 
     CellSize -> {590, Inherited}]}},
 CellTags->"TextAnnotation",
 CellID->344343781,ExpressionUUID->"c8630dca-a5de-4e0c-b71f-1345143fba37"],

Cell[TextData[{
 "For a decomposition ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["V", "TI"], "\[LongEqual]", 
    StyleBox["H", "TI"], "\[CirclePlus]", 
    StyleBox["im",
     FontSlant->"Plain"], " ", 
    StyleBox["d",
     FontSlant->"Plain"], "\[CirclePlus]", 
    StyleBox["C", "TI"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "97f424f0-1508-43e9-b038-4f9f77f47989"],
 " the projection onto ",
 Cell[BoxData[
  FormBox[
   StyleBox["H", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c1405207-90cd-43ed-9e42-a8821cb08da0"],
 " along ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["im",
     FontSlant->"Plain"], " ", 
    StyleBox["d",
     FontSlant->"Plain"], "\[CirclePlus]", 
    StyleBox["C", "TI"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "21f3feed-6586-487c-8b00-6c8915f567c0"],
 " is a harmonic projection, the orthogonal projection onto ",
 Cell[BoxData[
  FormBox[
   StyleBox["H", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b205968c-e9f8-45bc-a789-9f8399ec18ae"],
 ", since ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["im",
     FontSlant->"Plain"], " ", 
    StyleBox["d",
     FontSlant->"Plain"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f3581424-c3ca-4077-b01c-212acb5131ec"],
 " and ",
 Cell[BoxData[
  FormBox[
   StyleBox["C", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a00018cb-6b15-40a5-b235-cf19daedf3af"],
 " are perpendicular to ",
 Cell[BoxData[
  FormBox[
   StyleBox["H", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "244ee720-556c-4275-8541-176cfa514265"],
 "."
}], "Notes",ExpressionUUID->"377829a2-b84e-4497-81f3-7fc159330342"],

Cell[TextData[{
 "When the pairing on cohomology is perfect, ",
 Cell[BoxData[
  FormBox[
   StyleBox["H", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4c68f729-1429-46f2-8e41-1501feb69885"],
 " has exactly one harmonic projection onto it (arXiv:2004.07362, Lemma 4.3), \
so a pre-Hodge and a Hodge decomposition with the same harmonic subspace have \
the same projection."
}], "Notes",ExpressionUUID->"52bd9cb2-05c8-44db-a909-f923c67f9333"],

Cell[TextData[{
 "For a special propagator ",
 Cell[BoxData[
  FormBox[
   StyleBox["P", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8ed06aa7-d7f1-4391-95e2-10dcd4dcd4a5"],
 " the map ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["Id",
     FontSlant->"Plain"], "+", 
    StyleBox["d",
     FontSlant->"Plain"], 
    StyleBox["P", "TI"], "+", 
    StyleBox["P", "TI"], 
    StyleBox["d",
     FontSlant->"Plain"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7fc532bd-4063-4517-b9d4-f5cf785a6eb9"],
 " is a harmonic projection with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["P", "TI"], "\[Pi]", "\[LongEqual]", "\[Pi]", 
    StyleBox["P", "TI"], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b137f02f-9b42-43c0-a125-1727a9a92884"],
 ", and for the propagator of a Hodge decomposition it is the projection of \
that decomposition (arXiv:2004.07362, Lemma 3.18)."
}], "Notes",ExpressionUUID->"b0d137dd-f081-4ed0-8385-43e749c434e4"],

Cell[TextData[{
 "The result is an Association from degrees to Associations from basis \
elements to their images, the shape of the ",
 Cell[BoxData["\"\<Images\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7b024d2f-abac-4152-9955-29e387b4c482"],
