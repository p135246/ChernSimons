 "."
}], "Notes",ExpressionUUID->"9d6361db-288c-46fb-b733-458361af9683"],

Cell[TextData[{
 "In the forms with an element, ",
 StyleBox["e", "TI"],
 " is a linear combination of basis elements of the complex, and anything \
else returns unevaluated."
}], "Notes",ExpressionUUID->"12efff02-58ad-49bc-8a16-8b96ef4c8cb8"],

