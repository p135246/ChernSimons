Cell[TextData[{
 "A harmonic projection of a cochain complex with a pairing ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     StyleBox["V", "TI"], ",", 
     StyleBox["d",
      FontSlant->"Plain"], ",", 
     RowBox[{"\[LeftAngleBracket]", 
      RowBox[{"-", ",", "-"}], "\[RightAngleBracket]"}]}], ")"}], 
   TraditionalForm]], "InlineFormula",ExpressionUUID->
  "a181bd7b-d951-4972-95c3-bab36a3bc5ed"],
 " is a linear projection ",
 Cell[BoxData[
  FormBox["\[Pi]", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "c4c23334-14ec-4f48-88da-379f2a1dae72"],
 " of degree ",
 Cell[BoxData[
  FormBox["0", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "89c939b3-84b7-44b9-9ccc-623e985b332b"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{"ker", 
    StyleBox["d",
     FontSlant->"Plain"], "\[LongEqual]", 
    StyleBox["im",
     FontSlant->"Plain"], " ", "\[Pi]", "\[CirclePlus]", 
    StyleBox["im",
     FontSlant->"Plain"], " ", 
    StyleBox["d",
     FontSlant->"Plain"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "346b5c47-fabb-4f21-b5fc-e69d835dc709"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["im",
     FontSlant->"Plain"], " ", 
    StyleBox["d",
     FontSlant->"Plain"], "\[Subset]", "ker", "\[Pi]"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"f8f69b19-1463-4d86-84c1-cfe4a54c37c2"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{"\[Pi]", 
      StyleBox["v", "TI"], ",", 
      StyleBox["w", "TI"]}], "\[RightAngleBracket]"}], "\[LongEqual]", 
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{
      StyleBox["v", "TI"], ",", "\[Pi]", 
      StyleBox["w", "TI"]}], "\[RightAngleBracket]"}]}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"314d1722-19bd-4d88-b6ad-3809fedd2166"],
 " (arXiv:2004.07362, Definition 3.16)."
}], "Notes",
 CellFrameLabels->{{Inherited, Inherited}, {Inherited, 
    Cell[
     TextData[{
      "26.10.01: Design review - built in HodgeDecompositions H5 from the \
blueprint of H4, whose ten choices Pavel kept in H4a. The projection is \
returned in the shape of the \"Images\" of a SpecialPropagator, degree to \
basis element to image, so the two read alike; the forms with an element \
apply it. It takes a pre-Hodge decomposition as well as a Hodge one, beyond \
the Spec's blueprint, which names decompositions and propagators: the \
projection onto H along im d + C is the orthogonal projection onto H for \
both, since C and im d are perpendicular to H, and when the pairing on \
cohomology is perfect it is the unique harmonic projection with image H \
(arXiv:2004.07362, Lemma 4.3), so the Hodge twist does not change it. For a \
propagator it is Id + d P + P d, which is the same map as for its \
decomposition by Lemma 3.18. No form takes a space: the projection depends on \
the harmonic subspace, which FindHarmonicSubspace chooses, so it is read off \
a decomposition, and HarmonicProjection[space] returns unevaluated. The \
harmonic subspace of a propagator is FindHodgeDecomposition[p][\"Harmonic\"], \
so there is no HarmonicSubspace of a propagator. Prior art: the Wolfram \
Language has Projection onto a vector, not a projection of a cochain complex \
onto its harmonic subspace. The engine of the verification suites has no \
counterpart.", "\n\n", 
       Cell[
        BoxData[
         GridBox[{{
            Cell[
             BoxData[
              ButtonBox[
               DynamicBox[
                FEPrivate`FrontEndResource[
                "DocumentationToolsStrings", "Edit"]], BaseStyle -> 
               "TextAnnotationButton"]]], 
            StyleBox[
             RowBox[{
               DynamicBox[
                FEPrivate`FrontEndResource[
                "DocumentationToolsStrings", "LastAnnotator"]], "pavel"}], 
             "TextAnnotator"], 
            Cell[
             BoxData[
              ButtonBox[
               DynamicBox[
                FEPrivate`FrontEndResource[
                "DocumentationToolsStrings", "Delete"]], BaseStyle -> 
               "TextAnnotationRemoveButton"]]], ""}}, 
          GridBoxAlignment -> {
           "Columns" -> {Left, Left, Right, Right}, "Rows" -> {{Automatic}}}, 
          GridBoxItemSize -> {"Columns" -> {
              Scaled[0.15], 
              Scaled[0.68], 
              Scaled[0.15], 
              Scaled[0.02]}}]]], "\n"}], "TextAnnotation", 
     CellSize -> {590, Inherited}]}},
 CellTags->"TextAnnotation",
 CellID->920010041,ExpressionUUID->"431a730c-60b8-408c-a7ad-820f0bee5a68"],

Cell[TextData[{
 "For a decomposition ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["V", "TI"], "\[LongEqual]", 
    StyleBox["H", "TI"], "\[CirclePlus]", 
    StyleBox["im",
     FontSlant->"Plain"], " ", 
    StyleBox["d",
     FontSlant->"Plain"], "\[CirclePlus]", 
    StyleBox["C", "TI"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "fe0addf8-5656-4045-85ab-d4b9c8d1df75"],
 " the projection onto ",
 Cell[BoxData[
  FormBox[
   StyleBox["H", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "99160964-9e31-43eb-9274-b8ead99791d7"],
 " along ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["im",
     FontSlant->"Plain"], " ", 
    StyleBox["d",
     FontSlant->"Plain"], "\[CirclePlus]", 
    StyleBox["C", "TI"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "fd038b1d-b745-49aa-af8d-ce9de73b16b5"],
 " is a harmonic projection, the orthogonal projection onto ",
 Cell[BoxData[
  FormBox[
   StyleBox["H", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "26529913-9be0-4cf1-885d-43e52d53bd55"],
 ", since ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["im",
     FontSlant->"Plain"], " ", 
    StyleBox["d",
     FontSlant->"Plain"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "fb22a92d-0390-4ad1-9053-93eb752e3557"],
 " and ",
 Cell[BoxData[
  FormBox[
   StyleBox["C", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "63e8d591-e76f-4a03-b0b0-823960948c7b"],
 " are perpendicular to ",
 Cell[BoxData[
  FormBox[
   StyleBox["H", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "40e73546-a9cb-4382-96f2-ce533f73d2c8"],
 "."
}], "Notes",ExpressionUUID->"ab2524b1-efc9-4cfa-b74c-382f7d0477be"],

Cell[TextData[{
 "When the pairing on cohomology is perfect, ",
 Cell[BoxData[
  FormBox[
   StyleBox["H", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "d226a6cc-a3a7-43b1-a894-ba648368ed94"],
 " has exactly one harmonic projection onto it (arXiv:2004.07362, Lemma 4.3), \
so a pre-Hodge and a Hodge decomposition with the same harmonic subspace have \
the same projection."
}], "Notes",ExpressionUUID->"1b36ed05-ec04-4852-a17c-f3201a56f5d7"],

Cell[TextData[{
 "For a special propagator ",
 Cell[BoxData[
  FormBox[
   StyleBox["P", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "4b30416e-1472-4587-a314-91bb52550eee"],
 " the map ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["Id",
     FontSlant->"Plain"], "+", 
    StyleBox["d",
     FontSlant->"Plain"], 
    StyleBox["P", "TI"], "+", 
    StyleBox["P", "TI"], 
    StyleBox["d",
     FontSlant->"Plain"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "103af53f-0200-45da-b263-1ae2b7348b41"],
 " is a harmonic projection with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["P", "TI"], "\[Pi]", "\[LongEqual]", "\[Pi]", 
    StyleBox["P", "TI"], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"e6cfedbb-6d25-4099-a1f1-bde69ba5ee6c"],
 ", and for the propagator of a Hodge decomposition it is the projection of \
that decomposition (arXiv:2004.07362, Lemma 3.18)."
}], "Notes",ExpressionUUID->"0bb9f2df-ceb7-4e7f-a9c5-efb40ed4fda9"],

