  "29ec64f0-d009-4201-aaad-02141cded0a3"],
 "."
}], "Notes",ExpressionUUID->"3a9be07a-2a52-4124-908b-7ea36d166d23"],

Cell[TextData[{
 "In the forms with an element, ",
 StyleBox["e", "TI"],
 " is a linear combination of basis elements of the complex, and anything \
else returns unevaluated."
}], "Notes",ExpressionUUID->"e9d1aeaa-2385-4385-9ffb-4378b070ad11"],

