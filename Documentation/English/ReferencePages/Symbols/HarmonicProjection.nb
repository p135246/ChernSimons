Cell[TextData[{
 "Example 6.1 of arXiv:2004.07362 over ",
 Cell[BoxData[
  FormBox[
   StyleBox["Q",
    FontSlant->"Plain"], TraditionalForm]], "InlineFormula",ExpressionUUID->
