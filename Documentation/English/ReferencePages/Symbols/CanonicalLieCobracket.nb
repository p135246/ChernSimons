Cell["\<\
The first nonzero co-bracket over the alphabet of the circle:\
\>", "ExampleText",ExpressionUUID->"3fb30cb2-9525-4ae8-b25b-9ba2e0470c26"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"CanonicalLieCobracket", "[", 
  RowBox[{
   RowBox[{"CyclicWord", "[", 
    RowBox[{"{", 
     RowBox[{"x", ",", " ", "y", ",", " ", "y", ",", " ", "y"}], "}"}], "]"}],
    ",", " ", 
   RowBox[{"GradedPairing", "[", 
    RowBox[{
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"x", " ", "->", " ", 
        RowBox[{"-", "1"}]}], ",", " ", 
       RowBox[{"y", " ", "->", " ", "0"}]}], "|>"}], ",", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "y"}], "}"}], " ", "->", " ", "1"}], "|>"}]}], 
    "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"2f4141e2-0ee2-4135-b7c6-82327b02953d"],

Cell[BoxData[
 RowBox[{"-", 
  InterpretationBox[
   RowBox[{
    InterpretationBox[
     RowBox[{"(", "y", ")"}],
     ChernSimons`CyclicWord[{MTNB$1pyrjk8fjzqrn`y}],
     Editable->False], "\[CircleDot]", 
    InterpretationBox[
     RowBox[{"(", "y", ")"}],
     ChernSimons`CyclicWord[{MTNB$1pyrjk8fjzqrn`y}],
     Editable->False]}],
   ChernSimons`SymmetricProduct[
    ChernSimons`CyclicWord[{MTNB$1pyrjk8fjzqrn`y}], 
    ChernSimons`CyclicWord[{MTNB$1pyrjk8fjzqrn`y}]],
   Editable->False]}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"840dc68e-09fb-4ef1-b825-aa03111860a2"]
