Cell[CellGroupData[{
Cell["CanonicalLieCobracket", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"e8191380-c98a-40ad-b9f2-130a86dd4463"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["CanonicalLieCobracket"]], 
     "paclet:ChernSimons/ref/CanonicalLieCobracket", 
     "ChernSimons Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["w", "TI"], ",", " ", 
    StyleBox["pairing", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "617d37a0-7f2a-4b6b-ad55-dfcd132ab6bd"],
 "\[LineSeparator]",
 "gives the co-bracket of the cyclic word ",
 StyleBox["w", "TI"],
 ", a product of two cyclic words, in the convention of ",
 StyleBox["pairing", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"18ee343e-df71-4e7e-985d-48fe1caf17b2"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["CanonicalLieCobracket"]], 
     "paclet:ChernSimons/ref/CanonicalLieCobracket", 
     "ChernSimons Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["p", "TI"], ",", " ", 
    StyleBox["pairing", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "bca55d3c-5ed0-4ea1-9fb7-bd2894d50538"],
 "\[LineSeparator]",
 "gives the extension of the co-bracket as a co-derivation, applied to a \
product ",
 StyleBox["p", "TI"],
 " of cyclic words."
}], "Usage",ExpressionUUID->"6131c023-a601-4f41-9d87-c2fda8373897"],

Cell[TextData[{
 "The co-bracket is the operation ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["q", "TI"], 
    RowBox[{"1", ",", "2", ",", "0"}]], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"2439bb27-7e0a-40dc-956c-3d357b78fd43"],
 " of the involutive bi-Lie structure. It takes one cyclic word to a product \
of two, cutting the word at a pair of particles and contracting the two \
particles against the pairing."
}], "Notes",
 CellFrameLabels->{{Inherited, Inherited}, {Inherited, 
    Cell[
     TextData[{
      "26.09.30: Design review - the co-bracket is one half of the sum of \
ChordContraction over every ordered pair of distinct positions, so each chord \
is counted once in each orientation, and ChordContraction is exported as the \
term it shares with the bracket. The function reads the degrees, the pairing \
values and the convention off the GradedPairing object and carries its own \
linearity rules, so the co-bracket of a signed product, the natural output of \
the products, composes with itself without a wrapper. On a single cyclic word \
the extension is the co-bracket itself, so there is one function and not two. \
A product whose head disagrees with the convention of the pairing returns \
unevaluated rather than being coerced, since the \"Convention\" key is the \
one switch between the pictures (decision of 2026-09-21). Alternative name \
considered: InvolutiveCobracket, the name until 2026-09-30. Prior art: the \
Wolfram Language has no cyclic words or involutive bi-Lie structures; the \
engine the verification suites load computes the same co-bracket from letter \
strings and pins this function on every word to length 7, and the empty-word \
extension against the empty-word engine on every word to length 7.", "\n\n", 
       Cell[
        BoxData[
         GridBox[{{
            Cell[
             BoxData[
              ButtonBox[
               DynamicBox[
                FEPrivate`FrontEndResource[
                "DocumentationToolsStrings", "Edit"]], BaseStyle -> 
               "TextAnnotationButton"]]], 
            StyleBox[
             RowBox[{
               DynamicBox[
                FEPrivate`FrontEndResource[
                "DocumentationToolsStrings", "LastAnnotator"]], "pavel"}], 
             "TextAnnotator"], 
            Cell[
             BoxData[
              ButtonBox[
               DynamicBox[
                FEPrivate`FrontEndResource[
                "DocumentationToolsStrings", "Delete"]], BaseStyle -> 
               "TextAnnotationRemoveButton"]]], ""}}, 
          GridBoxAlignment -> {
           "Columns" -> {Left, Left, Right, Right}, "Rows" -> {{Automatic}}}, 
          GridBoxItemSize -> {"Columns" -> {
              Scaled[0.15], 
              Scaled[0.68], 
              Scaled[0.15], 
              Scaled[0.02]}}]]], "\n"}], "TextAnnotation", 
     CellSize -> {590, Inherited}]}},
 CellTags->"TextAnnotation",
 CellID->910540027,ExpressionUUID->"4c9d7b99-8160-40d4-aebd-a7bd4483dd21"],

Cell[TextData[{
 "The co-bracket is one half of the sum of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ChordContraction"]], "paclet:ChernSimons/ref/ChordContraction",
     "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "0ca8243f-5baf-48ec-9ef7-7522b489c07e"],
 " over every ordered pair of distinct positions."
}], "Notes",ExpressionUUID->"1c671967-2439-4c83-bf43-437cb5b46511"],

Cell[TextData[{
 "The convention of ",
 StyleBox["pairing", "TI"],
 " selects the picture: the result is a ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SymmetricProduct"]], "paclet:ChernSimons/ref/SymmetricProduct",
     "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "36dba23a-0023-4320-973a-586d31ca7ad2"],
 " under ",
 Cell[BoxData["\"\<Symmetric\>\""], "InlineFormula",ExpressionUUID->
  "08fe2eed-5cad-49c3-b2c1-e413b26a95ff"],
 " and an ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ExteriorProduct"]], "paclet:ChernSimons/ref/ExteriorProduct", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "d1e26e8b-348c-426b-8d4e-784db6f4a8ec"],
 " under ",
 Cell[BoxData["\"\<Exterior\>\""], "InlineFormula",ExpressionUUID->
  "40b8ccc6-7980-4a6e-9c3f-c70b9fbe0542"],
 "."
}], "Notes",ExpressionUUID->"514fcf3e-143f-4546-b23b-22c9d48aa377"],

Cell[TextData[{
 "A word too short to be cut in two, or one whose cuts all cancel, has \
co-bracket ",
 Cell[BoxData[
  FormBox["0", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "ef97ca7d-c063-4a76-9f9a-a327ad8b941d"],
 ". Over the alphabet of the circle the first nonzero co-bracket is in length \
",
 Cell[BoxData[
  FormBox["4", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "d2fb2d18-7ec5-463b-bea8-777e3a57616c"],
 "."
}], "Notes",ExpressionUUID->"ebfed673-182f-45bc-b788-344a348466d7"],

Cell[TextData[{
 "In the second form the co-bracket is applied to each factor of ",
 StyleBox["p", "TI"],
 " in turn, with the Koszul sign of the shuffle that brings it to the front, \
and the other factors are carried along. The extension raises the number of \
factors by one."
}], "Notes",ExpressionUUID->"8fc951be-5177-4bf3-a47c-0ac645cb50c0"],

Cell["\<\
Both forms are linear: they distribute over sums and pull out scalars.\
\>", "Notes",ExpressionUUID->"e0c548d6-a953-4195-9f98-fb1087f35bde"],

Cell["A word may be given as the list of its particles.", "Notes",ExpressionUUID->"3d34f767-6b0d-4ca2-9ef3-ec3797f68479"],

Cell[TextData[{
 "A product whose head disagrees with the convention of ",
 StyleBox["pairing", "TI"],
 " returns unevaluated."
}], "Notes",ExpressionUUID->"4c42dc2b-0056-4be8-aac8-9e8e53ba6f56"],

