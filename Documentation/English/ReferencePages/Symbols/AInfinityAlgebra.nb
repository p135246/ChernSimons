        RowBox[{
         RowBox[{"Length", "[", "t", "]"}], " ", "===", " ", "2"}], ",", " ", 
        
        RowBox[{"Switch", "[", 
         RowBox[{"t", ",", " ", 
          RowBox[{"{", 
           RowBox[{"u", ",", " ", "u"}], "}"}], ",", " ", "u", ",", " ", 
          RowBox[{"{", 
           RowBox[{"u", ",", " ", "v"}], "}"}], ",", " ", "v", ",", " ", 
          RowBox[{"{", 
           RowBox[{"v", ",", " ", "u"}], "}"}], ",", " ", "v", ",", " ", "_", 
          ",", " ", "0"}], "]"}], ",", " ", "0"}], "]"}]}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"AInfinityOperation", "[", 
    RowBox[{"assoc", ",", " ", 
     RowBox[{"{", 
      RowBox[{"u", ",", " ", "v"}], "}"}]}], "]"}], ",", " ", 
   RowBox[{"AInfinityOperation", "[", 
    RowBox[{"assoc", ",", " ", 
     RowBox[{"{", 
      RowBox[{"u", ",", " ", "v", ",", " ", "u"}], "}"}]}], "]"}]}], 
  "}"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"9c4f72a9-99c9-4282-9b1f-1817e0c82c08"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"v", ",", "0"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"8b17dc2f-0a9d-4b17-8c12-ec7b685a00a7"]
}, Open  ]]
}, Open  ]]
