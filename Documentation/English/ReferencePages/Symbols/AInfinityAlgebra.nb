Cell["\<\
A strictly associative algebra on two generators, as an A-infinity algebra:\
\>", "ExampleText",ExpressionUUID->"22d812ff-2cdf-480d-81be-dcf72298e5f8"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"assoc", " ", "=", " ", 
   RowBox[{"AInfinityAlgebra", "[", 
    RowBox[{
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"u", " ", "->", " ", 
        RowBox[{"-", "1"}]}], ",", " ", 
       RowBox[{"v", " ", "->", " ", 
        RowBox[{"-", "1"}]}]}], "|>"}], ",", "\n", "   ", 
     RowBox[{"t", " ", "|->", " ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Length", "[", "t", "]"}], " ", "===", " ", "2"}], ",", " ", 
        
        RowBox[{"Switch", "[", 
         RowBox[{"t", ",", " ", 
          RowBox[{"{", 
           RowBox[{"u", ",", " ", "u"}], "}"}], ",", " ", "u", ",", " ", 
          RowBox[{"{", 
           RowBox[{"u", ",", " ", "v"}], "}"}], ",", " ", "v", ",", " ", 
          RowBox[{"{", 
           RowBox[{"v", ",", " ", "u"}], "}"}], ",", " ", "v", ",", " ", "_", 
          ",", " ", "0"}], "]"}], ",", " ", "0"}], "]"}]}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{"Keys", "[", "assoc", "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"6bc3ef6f-99ab-4fb8-a052-2fc2bb5668d6"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"Degrees\"\>", ",", "\<\"Basis\"\>", ",", "\<\"Products\"\>"}], 
  "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"c1e98146-64fd-4fb0-9ac2-cef7de43f521"]
}, Open  ]],

