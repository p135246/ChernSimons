Notebook[{

Cell[CellGroupData[{
Cell["AInfinityAlgebra", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"e9fbcb43-8126-4251-ad72-9c70105173cf"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["AInfinityAlgebra"]], 
     "paclet:ChernSimons/ref/AInfinityAlgebra", "ChernSimons Package Symbol"},
    
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["degrees", "TI"], ",", " ", 
    StyleBox["products", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4d18c156-fe5b-4501-bf40-5566b35e73ee"],
 "\[LineSeparator]",
 "builds an A-infinity algebra on a finite-dimensional graded space.",
 "\n"
}], "Usage",ExpressionUUID->"ef829740-d7ba-4dee-bfe8-396ec1f4bbeb"],

Cell[TextData[{
 StyleBox["degrees", "TI"],
 " is an Association from basis elements to their ",
 StyleBox["shifted",
  FontWeight->"Bold"],
 " degrees. ",
 StyleBox["products", "TI"],
 " is a function of a list of basis elements giving ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["m", "TI"], 
    StyleBox["k", "TI"]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "30e1873e-4fdd-4028-9332-a1857d6ee839"],
 " on it, as a linear combination of basis elements, and ",
 Cell[BoxData[
  FormBox["0", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bd392021-041f-4119-8847-bb13b10ba3c2"],
 " on the arities it does not define."
}], "Notes",ExpressionUUID->"3a24838f-5b4f-450d-8917-29ed2c73e441"],

Cell[TextData[{
 "The result is a plain Association with keys ",
 Cell[BoxData["\"\<Degrees\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "55d65636-fc64-4d64-823a-88064d886064"],
 ", ",
 Cell[BoxData["\"\<Basis\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e4c3cdb1-3489-458d-ae12-dc80cb5794ac"],
 " and ",
 Cell[BoxData["\"\<Products\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "74366792-b0d1-4748-ac1d-98f687843e2c"],
 ", so it can be inspected and edited like any other expression."
}], "Notes",ExpressionUUID->"0825038f-a301-4b10-8676-22362dd72516"],

Cell[TextData[{
 "Unlike the Maurer-Cartan and BD layer, which takes a pairing and works over \
an arbitrary alphabet without assuming finite dimensions, an A-infinity \
algebra here is its own object and ",
 StyleBox["is",
  FontWeight->"Bold"],
 " finite-dimensional: its operations are structure constants on a basis."
}], "Notes",ExpressionUUID->"f6e73375-52f9-4722-802a-4ca95332aa5d"],

Cell[TextData[{
 "The convention is the shifted one throughout. A strictly associative \
algebra concentrated in degree ",
 Cell[BoxData[
  FormBox["0", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b4e2d68f-130b-47b7-9a41-b1265025253e"],
 " becomes, after the shift, one whose basis elements have degree ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", "1"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "002d022e-1c56-46d8-aa66-9e452ac03c07"],
 "; at that degree the relation reads as associativity, whereas at degree ",
 Cell[BoxData[
  FormBox["0", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e3aab07a-ae73-4191-b1e9-2b324a318d29"],
 " it would demand anti-associativity."
}], "Notes",ExpressionUUID->"48051792-1b13-4ad0-ac57-7297ca8bb338"],

Cell["\<\
The algebra displays as a summary box: its basis with the shifted degrees, \
and the products under the opener.\
\>", "Notes",ExpressionUUID->"67f4a793-a0b0-4473-ad5b-3d340434bc02"]
}, Open  ]],

