Cell[TextData[{
 "The degrees are shifted. A strictly associative algebra concentrated in \
degree ",
 Cell[BoxData[
  FormBox["0", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2362c1b3-19e8-45c8-971a-14d5d4c67360"],
 " becomes, after the shift, one whose basis elements have degree ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", "1"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "447d4c02-9e43-4898-81c7-37ff04f527e5"],
 ", and at that degree the relation reads as associativity. At degree ",
 Cell[BoxData[
  FormBox["0", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "65be0431-99a6-4db7-bd17-4569f553c5a0"],
 " it demands anti-associativity."
}], "Notes",ExpressionUUID->"fa20fb02-0ba9-4441-97fc-d91c11ae4741"],

