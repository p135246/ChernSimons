Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"assoc", " ", "=", " ", 
   RowBox[{"AInfinityAlgebra", "[", 
    RowBox[{
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"u", " ", "->", " ", 
        RowBox[{"-", "1"}]}], ",", " ", 
       RowBox[{"v", " ", "->", " ", 
        RowBox[{"-", "1"}]}]}], "|>"}], ",", "\n", "   ", 
     RowBox[{"t", " ", "|->", " ", 
      RowBox[{"If", "[", 
