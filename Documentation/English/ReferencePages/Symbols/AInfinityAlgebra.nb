  FontSize->0.9 Inherited,ExpressionUUID->
  "40c73364-7088-4874-af4a-7c86e4585edb"],
 ", and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["algebra", "TI"], "[", "\"\<\!\(\*StyleBox[\"key\", \"TI\"]\)\>\"",
