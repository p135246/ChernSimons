Cell["\<\
A strictly associative algebra on two generators, as an A-infinity algebra:\
\>", "ExampleText",ExpressionUUID->"da0b6e88-2c31-4e0c-b27a-d4afd45876fe"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"assoc", " ", "=", " ", 
  RowBox[{"AInfinityAlgebra", "[", 
   RowBox[{
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"u", " ", "->", " ", 
       RowBox[{"-", "1"}]}], ",", " ", 
      RowBox[{"v", " ", "->", " ", 
       RowBox[{"-", "1"}]}]}], "|>"}], ",", " ", 
    RowBox[{"t", " ", "|->", " ", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", "t", "]"}], " ", "===", " ", "2"}], ",", " ", 
       RowBox[{"Switch", "[", 
        RowBox[{"t", ",", " ", 
         RowBox[{"{", 
          RowBox[{"u", ",", " ", "u"}], "}"}], ",", " ", "u", ",", " ", 
         RowBox[{"{", 
          RowBox[{"u", ",", " ", "v"}], "}"}], ",", " ", "v", ",", " ", 
         RowBox[{"{", 
          RowBox[{"v", ",", " ", "u"}], "}"}], ",", " ", "v", ",", " ", "_", ",",
          " ", "0"}], "]"}], ",", " ", "0"}], "]"}]}]}], "]"}]}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"7f4228bb-1bf0-42f3-99f9-80255a764e87"],

