Cell[CellGroupData[{
Cell["AInfinityAlgebra", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"a271ef81-3c98-4167-8c9a-9e5e0b76682c"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["AInfinityAlgebra"]], 
     "paclet:ChernSimons/ref/AInfinityAlgebra", "ChernSimons Package Symbol"},
    
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["degrees", "TI"], ",", " ", 
    StyleBox["products", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "10b2a996-c8e4-4417-a168-e79821d8cd28"],
 "\[LineSeparator]",
 "is the A-infinity algebra with the basis elements and shifted degrees of ",
 StyleBox["degrees", "TI"],
 " and the operations ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["m", "TI"], 
    StyleBox["k", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "a452ff80-e182-4c46-b41d-4cd8dc714916"],
 " given by ",
 StyleBox["products", "TI"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"5aa8db71-14ad-4b50-a803-de30deff783d"],

Cell[TextData[{
 StyleBox["degrees", "TI"],
 " is an Association from the basis elements to their shifted degrees, which \
are integers."
}], "Notes",
 CellFrameLabels->{{Inherited, Inherited}, {Inherited, 
    Cell[
     TextData[{
      "26.09.30: Design review - the algebra is finite-dimensional and given \
by its structure constants: an Association from the basis elements to their \
shifted degrees, and one function of a list of basis elements that gives \
every m_k, 0 on the arities it does not define, so an algebra with operations \
of any arity takes no further argument. The records give no alternative to \
the function, such as arrays of structure constants. The built algebra is \
AInfinityAlgebra around one Association with the keys \"Degrees\", \"Basis\" \
and \"Products\", with the Association upvalues of the other objects of the \
paclet, and an input with a degree that is not an integer or a basis element \
that is not a monomial returns unevaluated, so a construction that built \
nothing never looks like an algebra. The basis elements are monomials because \
the coordinates of an element are read with CoefficientRules in the variables \
of the basis, as in the Hodge decompositions; so 1 and products of symbols \
are basis elements too (R3, 2026-09-29). The degrees are the shifted ones, \
and the relation of Obstruction is in the shifted convention. No alternative \
name was recorded. Prior art: the Wolfram Language has no A-infinity \
algebras; the verification suites build the engine's twisted A-infinity \
structure of the circle as an AInfinityAlgebra and pin its relation and its \
morphism relation against the engine's on every tuple of length at most 4.", 
       "\n\n", 
       Cell[
        BoxData[
         GridBox[{{
            Cell[
             BoxData[
              ButtonBox[
               DynamicBox[
                FEPrivate`FrontEndResource[
                "DocumentationToolsStrings", "Edit"]], BaseStyle -> 
               "TextAnnotationButton"]]], 
            StyleBox[
             RowBox[{
               DynamicBox[
                FEPrivate`FrontEndResource[
                "DocumentationToolsStrings", "LastAnnotator"]], "pavel"}], 
             "TextAnnotator"], 
            Cell[
             BoxData[
              ButtonBox[
               DynamicBox[
                FEPrivate`FrontEndResource[
                "DocumentationToolsStrings", "Delete"]], BaseStyle -> 
               "TextAnnotationRemoveButton"]]], ""}}, 
          GridBoxAlignment -> {
           "Columns" -> {Left, Left, Right, Right}, "Rows" -> {{Automatic}}}, 
          GridBoxItemSize -> {"Columns" -> {
              Scaled[0.15], 
              Scaled[0.68], 
              Scaled[0.15], 
              Scaled[0.02]}}]]], "\n"}], "TextAnnotation", 
     CellSize -> {590, Inherited}]}},
 CellTags->"TextAnnotation",
 CellID->644300702,ExpressionUUID->"106a2ed2-c02d-4be5-a5f9-dc2b06321768"],

Cell[TextData[{
 "A basis element is a monomial: a symbol, ",
 Cell[BoxData[
  FormBox["1", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "700d0a40-e5e1-4c8a-98da-e1bcb8d01864"],
 ", or a product of powers of symbols."
}], "Notes",ExpressionUUID->"4365c823-f2d6-4012-b096-dfe5efe7150e"],

Cell[TextData[{
 StyleBox["products", "TI"],
 " is a function of a list of basis elements that gives ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["m", "TI"], 
    StyleBox["k", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "69491c02-d7cd-48b6-a8e0-dcf5c5780066"],
 " on it, as a linear combination of basis elements, and ",
 Cell[BoxData[
  FormBox["0", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "38ea513a-9b82-47f9-9f59-d6fcf41d6cf2"],
 " on the arities it does not define."
}], "Notes",ExpressionUUID->"720d90fc-f4b0-4926-bbba-8028ddd09a7b"],

Cell["\<\
The algebra is finite-dimensional: its operations are structure constants on \
the basis.\
\>", "Notes",ExpressionUUID->"5a350438-4189-48af-8f29-f23699b3b010"],

Cell[TextData[{
 "An element is a linear combination of basis elements, and its coordinates \
are its coefficients on the basis monomials. With ",
 Cell[BoxData[
  FormBox["1", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "a19602e9-4e0f-4d57-ba4c-570f7327e31e"],
 " in the basis, the constant term of an element is its coordinate on ",
 Cell[BoxData[
  FormBox["1", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "3754ec0a-af56-4ec1-8a20-c1e33923d4c6"],
 "."
}], "Notes",ExpressionUUID->"0421c87a-6649-443e-b987-4975841e3d48"],

Cell[TextData[{
 "The result is an ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["AInfinityAlgebra"]], "paclet:ChernSimons/ref/AInfinityAlgebra",
     "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "771bdbcf-9771-4b8b-b9ec-ef264f9559bf"],
 " object with the keys ",
 Cell[BoxData["\"\<Degrees\>\""], "InlineFormula",ExpressionUUID->
  "10f1e408-a21f-4208-9308-0bd7e2eefbcf"],
 ", ",
 Cell[BoxData["\"\<Basis\>\""], "InlineFormula",ExpressionUUID->
  "34479148-e22f-4128-8617-9073e8ff68fd"],
 " and ",
 Cell[BoxData["\"\<Products\>\""], "InlineFormula",ExpressionUUID->
  "20da6ddd-a45b-45e2-86b2-03815dceaa16"],
 ", and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["algebra", "TI"], "[", "\"\<\!\(\*StyleBox[\"key\", \"TI\"]\)\>\"",
    "]"}]], "InlineFormula",ExpressionUUID->
  "a294ff27-b882-49c7-af9c-273ce0614b50"],
 " gives the value of a key."
}], "Notes",ExpressionUUID->"d9a46600-8ccc-4f2e-9283-2edbf29b26d3"],

