Cell[TextData[{
 "The degrees are shifted. A strictly associative algebra concentrated in \
degree ",
 Cell[BoxData[
  FormBox["0", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "eb3b1d5a-cb2d-4f91-bddd-d2897c2b478b"],
 " becomes, after the shift, one whose basis elements have degree ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", "1"}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "bae629b3-fee1-4e93-a993-e8c454fcbe63"],
 ", and at that degree the relation reads as associativity. At degree ",
 Cell[BoxData[
  FormBox["0", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "9ad377ef-6386-4029-aed6-050cd72a1da9"],
 " it demands anti-associativity."
}], "Notes",ExpressionUUID->"e5c6628f-6df7-4da8-92e2-c32328cc043e"],

