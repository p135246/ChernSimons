  FontSize->0.9 Inherited,ExpressionUUID->
  "9b0c8ab8-13a0-48b8-bee1-2e25ff3e8b7e"],
 ", and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["algebra", "TI"], "[", "\"\<\!\(\*StyleBox[\"key\", \"TI\"]\)\>\"",
