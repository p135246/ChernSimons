Cell["\<\
A strictly associative algebra on two generators, as an A-infinity algebra:\
\>", "ExampleText",ExpressionUUID->"7119e76f-643d-4396-b28b-7f3bca33613e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"assoc", " ", "=", " ", 
  RowBox[{"AInfinityAlgebra", "[", 
   RowBox[{
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"u", " ", "->", " ", 
       RowBox[{"-", "1"}]}], ",", " ", 
      RowBox[{"v", " ", "->", " ", 
       RowBox[{"-", "1"}]}]}], "|>"}], ",", " ", 
    RowBox[{"t", " ", "|->", " ", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", "t", "]"}], " ", "===", " ", "2"}], ",", " ", 
       RowBox[{"Switch", "[", 
        RowBox[{"t", ",", " ", 
         RowBox[{"{", 
          RowBox[{"u", ",", " ", "u"}], "}"}], ",", " ", "u", ",", " ", 
         RowBox[{"{", 
          RowBox[{"u", ",", " ", "v"}], "}"}], ",", " ", "v", ",", " ", 
         RowBox[{"{", 
          RowBox[{"v", ",", " ", "u"}], "}"}], ",", " ", "v", ",", " ", "_", ",",
          " ", "0"}], "]"}], ",", " ", "0"}], "]"}]}]}], "]"}]}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"691300b3-d830-41b7-b281-9141b86edd2f"],

