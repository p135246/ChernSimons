      "4bbfd168-9a56-4f03-9f8c-90842fcdf8ec"],
     ", present only in the four-argument form"
    }], "TableText",ExpressionUUID->"81f48299-079d-4f28-a454-6d8d9f318bf1"]}
  }]], "2ColumnTableMod",ExpressionUUID->"c8267241-9985-4926-88e7-\
93740e815e88"],

Cell[TextData[{
 "The convention is what selects the picture every later operation works in: ",
 Cell[BoxData["\"\<Symmetric\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e705d8cc-dd11-422a-af93-e3e987038cda"],
 " uses the ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SymmetricProduct"]], "paclet:IBLInfinity/ref/SymmetricProduct",
     "IBLInfinity Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "065b76d7-b28f-4066-b701-d748c22e2357"],
 " grading ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    RowBox[{
     StyleBox["[",
      SpanMaxSize->1], "-", 
     StyleBox["]",
      SpanMaxSize->1]}], "1"], "=", 
   StyleBox["[",
    SpanMaxSize->1], "-", 
   StyleBox["]",
    SpanMaxSize->1], "-", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "99ba1e84-e954-403b-bcc3-56c6c9621cd5"],
 ", ",
 Cell[BoxData["\"\<Exterior\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "43fa6e56-d0af-435a-abff-2688c01c0ef9"],
 " the ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ExteriorProduct"]], "paclet:IBLInfinity/ref/ExteriorProduct", 
    "IBLInfinity Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "28f4f84c-1634-4dc0-a175-1716fd746e34"],
 " grading ",
 Cell[BoxData[
  RowBox[{
   StyleBox["[",
    SpanMaxSize->1], "-", 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fc151b9f-8214-4686-bd7d-c58201ca6fbf"],
 ". Change it by resetting the key \[LongDash] ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["Append",
    BaseStyle->"Link"], "[", 
   RowBox[{
    StyleBox["pairing", "TI"], ",", " ", 
    RowBox[{"\"\<Convention\>\"", " ", "->", " ", "\"\<Exterior\>\""}]}], 
   "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "89bbb553-712f-4c05-950f-2e68a6602e5f"],
 "."
}], "Notes",ExpressionUUID->"eacb74da-532e-4894-b265-a2e7b3e9f0d2"],

Cell[TextData[{
 "The pairing must be homogeneous: if the nonzero values do not all have one \
degree ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     StyleBox["p", "TI"]},
    "Abs"], "+", 
   TemplateBox[{
     StyleBox["q", "TI"]},
    "Abs"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "870a7ebd-5430-43a5-b416-42f467d2e3a3"],
 ", ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Pairing"]], "paclet:IBLInfinity/ref/Pairing", 
    "IBLInfinity Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "3c53e636-a30c-40f1-8b67-e9df85a9240b"],
 " issues ",
 Cell[BoxData[
  RowBox[{"Pairing", "::", "degree"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ee5218c7-d58b-42df-954a-6fa72e9d41ec"],
 " and aborts."
}], "Notes",ExpressionUUID->"51d759bc-8bf6-4e60-aee9-e584ce66a2b6"],

Cell[TextData[{
 StyleBox["evaluation", "TI"],
 " in the four-argument form gives ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["p", "TI"], ",", 
    StyleBox["\[Alpha]", "TI"]}], "\[VeryThinSpace]", 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "267c8322-fc92-4fc7-b362-34a0db1339b8"],
 " for a particle ",
 StyleBox["p", "TI"],
 " and a dual particle ",
 Cell[BoxData[
  StyleBox["\[Alpha]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f997d500-1c46-4e80-af73-5e8965157b5a"],
 "; it is read by ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DualPairing"]], "paclet:IBLInfinity/ref/DualPairing", 
    "IBLInfinity Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "aa700c57-b651-46b1-a5f3-cd3d478c2682"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ProductPairing"]], "paclet:IBLInfinity/ref/ProductPairing", 
    "IBLInfinity Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "380cc1db-4da9-4c9e-9242-a0f4859dc3f2"],
 ", which abort without it."
}], "Notes",ExpressionUUID->"f2dd7ab0-e7a1-4500-8a21-0b1f6535e5d6"]
}, Open  ]],

