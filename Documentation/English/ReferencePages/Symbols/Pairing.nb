Notebook[{

Cell[CellGroupData[{
Cell["Pairing", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"01c202a8-1275-4253-bdf0-e5876e12ac95"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["Pairing"]], "paclet:IBLInfinity/ref/Pairing", 
     "IBLInfinity Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["degrees", "TI"], ",", " ", 
    StyleBox["spec", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "62ab7e05-b0c3-4065-a43b-d50b27a1b4ab"],
 "\[LineSeparator]",
 "builds the pairing object of a graded alphabet, from an association ",
 StyleBox["degrees", "TI"],
 " of particles to their degrees and a specification ",
 StyleBox["spec", "TI"],
 " of the pairing values.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"fd8fec51-a4f3-4176-afe3-31071c1b9943"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["Pairing"]], "paclet:IBLInfinity/ref/Pairing", 
     "IBLInfinity Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["degrees", "TI"], ",", " ", 
    StyleBox["spec", "TI"], ",", " ", 
    StyleBox["dualDegrees", "TI"], ",", " ", 
    StyleBox["evaluation", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a42729af-3fc9-49be-a7f5-f71b4b6ddd74"],
 "\[LineSeparator]",
 "attaches a dual alphabet, so that the resulting object also carries the \
evaluation of words on dual words."
}], "Usage",ExpressionUUID->"28bcb568-57e8-465b-8894-927321a48c4c"],

Cell[TextData[{
 "The pairing object is the single piece of data every other operation in the \
paclet takes as its last argument. It is a plain ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Association"]], "paclet:ref/Association"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "63a8ea0d-cebf-4085-9f9c-86d7735b296e"],
 ", not an opaque object, so it can be inspected, edited and stored like any \
other expression."
}], "Notes",ExpressionUUID->"b4b42280-6cd2-464d-874a-e1c0776714a8"],

Cell[TextData[{
 StyleBox["degrees", "TI"],
 " is an association from particles to integer degrees. A particle is an \
arbitrary expression, usually a symbol; multi-character names are fine."
}], "Notes",ExpressionUUID->"fcefd3eb-6776-4196-a61c-4f49b230fccb"],

Cell[TextData[{
 StyleBox["spec", "TI"],
 " is either a function of two particles, or an association giving some of \
the values. In the association form the remaining values are completed by \
graded antisymmetry, ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["\[LeftAngleBracket]",
     SpanMaxSize->1], 
    RowBox[{
     StyleBox["q", "TI"], ",", 
     StyleBox["p", "TI"]}], "\[VeryThinSpace]", 
    StyleBox["\[RightAngleBracket]",
     SpanMaxSize->1]}], "=", 
   RowBox[{
    RowBox[{"-", 
     SuperscriptBox[
      RowBox[{
       StyleBox["(",
        SpanMaxSize->1], 
       RowBox[{"-", "1"}], 
       StyleBox[")",
        SpanMaxSize->1]}], 
      RowBox[{
       TemplateBox[{
         StyleBox["p", "TI"]},
        "Abs"], 
       TemplateBox[{
         StyleBox["q", "TI"]},
        "Abs"]}]]}], 
    RowBox[{
     StyleBox["\[LeftAngleBracket]",
      SpanMaxSize->1], 
     RowBox[{
      StyleBox["p", "TI"], ",", 
      StyleBox["q", "TI"]}], "\[VeryThinSpace]", 
     StyleBox["\[RightAngleBracket]",
      SpanMaxSize->1]}]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7ff2102d-c3b9-45ac-9ecb-b366bad99b1f"],
 ", and every pair left unmentioned is ",
 Cell[BoxData["0"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b63e56e8-1fe9-490a-af37-64d4218533fb"],
 "."
}], "Notes",ExpressionUUID->"6879ad7d-22f3-4af3-ab47-f0c9df72ee6c"],

Cell[TextData[{
 "The result has the keys ",
 Cell[BoxData["\"\<Degrees\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a6691ae2-b25e-4fc0-8b79-eaa25ae34a3c"],
 ", ",
 Cell[BoxData["\"\<Values\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8e53defb-b568-4f8f-8bb3-73c69a1e8ac6"],
 ", ",
 Cell[BoxData["\"\<Degree\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7426313f-c665-4c0f-8df7-4fde63b7c5a9"],
 " and ",
 Cell[BoxData["\"\<Convention\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "37abd604-49d7-40a1-bcd9-722a3a37b7e4"],
 ", plus ",
 Cell[BoxData["\"\<Dual\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ac5d11c5-da66-47d5-addc-8027cf734983"],
 " in the four-argument form."
}], "Notes",ExpressionUUID->"0f507745-2c66-44ec-9712-56be9ef65377"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "39a90487-6a4a-4d2d-8141-210745f945fb"], Cell["key", "TableText",
