     FontSize->0.9 Inherited,ExpressionUUID->
     "9f47ba63-bd5c-4dd1-8ebc-7f5d4c8ff03a"]], "TableText",ExpressionUUID->
     "4ca50d4a-d995-4497-88f1-bf0bcd990257"], Cell[TextData[{
     "the common degree ",
     Cell[BoxData[
      RowBox[{
       TemplateBox[{
         StyleBox["p", "TI"]},
        "Abs"], "+", 
       TemplateBox[{
         StyleBox["q", "TI"]},
        "Abs"]}]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "7738d299-6ce1-4640-864b-b361baadf7e3"],
     " over all pairs with ",
     Cell[BoxData[
      RowBox[{
       StyleBox["\[LeftAngleBracket]",
        SpanMaxSize->1], 
       RowBox[{
        StyleBox["p", "TI"], ",", 
        StyleBox["q", "TI"]}], "\[VeryThinSpace]", 
       StyleBox["\[RightAngleBracket]",
        SpanMaxSize->1], "\[NotEqual]", "0"}]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "27b46f0a-3df1-450c-ac80-8cdd53d8eee8"]
    }], "TableText",ExpressionUUID->"f6f6379a-f9fc-436e-aa84-b835f1ebe55c"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "ceab1840-aabf-4506-8351-ccd85120e1ef"], Cell[TextData[Cell[
    BoxData["\"\<Convention\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "5601563b-a899-4cda-90af-1a9f7a91ceee"]], "TableText",ExpressionUUID->
     "8b1a45cf-7ec1-4efc-a783-0bbd623d57db"], Cell[TextData[{
     Cell[BoxData["\"\<Symmetric\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "9b49b6d4-f8d6-43ed-bc7f-c32586e80b23"],
     " by default, ",
     Cell[BoxData["\"\<Exterior\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "2aff4255-f9a4-42f2-a2fc-ed8c7319b239"],
     " to work in the exterior picture"
    }], "TableText",ExpressionUUID->"3750785b-2360-4b7c-b644-ffc1efcd2e6e"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "94632c73-ed48-497c-9ca8-a3da9cde9992"], Cell[TextData[Cell[
    BoxData["\"\<Dual\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "8426f131-44fc-4854-b43b-2baf6e30b14c"]], "TableText",ExpressionUUID->
     "804e7b58-591f-4c61-80e9-fb8d202b65c2"], Cell[TextData[{
     "an association with its own ",
     Cell[BoxData["\"\<Degrees\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "f956e605-e81c-44bc-bda0-db8675d5992e"],
     " and ",
     Cell[BoxData["\"\<Values\>\""], "InlineFormula",
