    RowBox[{"\[ScriptL]", ",", "0"}]], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"5ae10d1f-6468-4516-bd25-cede5a9e5079"],
 "."
}], "Notes",ExpressionUUID->"379193ba-ca97-48bf-bc98-dada2874f53f"],

