Cell[BoxData[
 RowBox[{"m", " ", "=", " ", 
  RowBox[{"MaurerCartanAnsatz", "[", 
   RowBox[{"c", ",", " ", 
    RowBox[{"GradedPairing", "[", 
     RowBox[{
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"x", " ", "->", " ", 
         RowBox[{"-", "1"}]}], ",", " ", 
        RowBox[{"y", " ", "->", " ", "0"}]}], "|>"}], ",", " ", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"x", ",", " ", "y"}], "}"}], " ", "->", " ", "1"}], "|>"}]}],
      "]"}], ",", " ", "4"}], "]"}]}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"c72590d7-2996-4779-a328-4ed93916831a"],

