Cell[BoxData[
 RowBox[{"m", " ", "=", " ", 
  RowBox[{"MaurerCartanAnsatz", "[", 
   RowBox[{"c", ",", " ", 
    RowBox[{"GradedPairing", "[", 
     RowBox[{
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"x", " ", "->", " ", 
         RowBox[{"-", "1"}]}], ",", " ", 
        RowBox[{"y", " ", "->", " ", "0"}]}], "|>"}], ",", " ", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"x", ",", " ", "y"}], "}"}], " ", "->", " ", "1"}], "|>"}]}],
      "]"}], ",", " ", "4"}], "]"}]}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"5b69113d-4d0f-4338-a5f2-6311f90218e2"],

