Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"566ff382-8b13-446f-a6ed-bc8d1c8c86b5"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["MaurerCartanAnsatz"]], 
     "paclet:ChernSimons/ref/MaurerCartanAnsatz", 
     "ChernSimons Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["coefficient", "TI"], ",", " ", 
    StyleBox["pairing", "TI"], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d4e20608-009a-47fc-8bc5-64ceb25ca079"],
 "\[LineSeparator]",
 "gives the general genus-zero BD action over ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["MaurerCartanBasis"]], 
     "paclet:ChernSimons/ref/MaurerCartanBasis", "ChernSimons Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["pairing", "TI"], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f6630be9-8e45-44e8-a9b6-7ec1f8f1cce4"],
 ", with ",
 StyleBox["coefficient", "TI"],
 "[",
 StyleBox["k", "TI"],
 "] the unknown on the ",
 StyleBox["k", "TI"],
 "-th basis monomial.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"7d18eae1-673b-4ec6-96d1-c6fea01d770d"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["MaurerCartanAnsatz"]], 
     "paclet:ChernSimons/ref/MaurerCartanAnsatz", 
     "ChernSimons Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["coefficient", "TI"], ",", " ", 
    StyleBox["degree", "TI"], ",", " ", 
    StyleBox["pairing", "TI"], ",", " ", 
