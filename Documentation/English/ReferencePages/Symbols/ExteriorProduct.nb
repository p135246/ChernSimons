Cell["Two factors already in order:", "ExampleText",ExpressionUUID->"00b4e0f7-495b-4f55-bec0-c44dc2b164be"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ExteriorProduct", "[", 
  RowBox[{
   RowBox[{"CyclicWord", "[", 
    RowBox[{"{", "x", "}"}], "]"}], ",", " ", 
   RowBox[{"CyclicWord", "[", 
    RowBox[{"{", "y", "}"}], "]"}], ",", " ", 
   RowBox[{"GradedPairing", "[", 
    RowBox[{
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"x", " ", "->", " ", 
        RowBox[{"-", "1"}]}], ",", " ", 
       RowBox[{"y", " ", "->", " ", "0"}]}], "|>"}], ",", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "y"}], "}"}], " ", "->", " ", "1"}], "|>"}]}], 
    "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"27c1f44f-ec42-4c6b-916a-9de7cd6d20bf"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{
   InterpretationBox[
    RowBox[{"(", "x", ")"}],
    ChernSimons`CyclicWord[{MTNB$78a41avfvdo6`x}],
    Editable->False], "\[Wedge]", 
   InterpretationBox[
    RowBox[{"(", "y", ")"}],
    ChernSimons`CyclicWord[{MTNB$78a41avfvdo6`y}],
    Editable->False]}],
  ChernSimons`ExteriorProduct[
   ChernSimons`CyclicWord[{MTNB$78a41avfvdo6`x}], 
   ChernSimons`CyclicWord[{MTNB$78a41avfvdo6`y}]],
  Editable->False]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"4d193e18-1347-496e-82b2-e87355efcfd9"]
}, Open  ]],

