Notebook[{

Cell[CellGroupData[{
Cell["ExteriorProduct", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"99855b28-84be-4405-a867-c432662936ed"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["ExteriorProduct"]], "paclet:IBLInfinity/ref/ExteriorProduct", 
     "IBLInfinity Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["u", "TI"], ",", " ", 
    StyleBox["v", "TI"], ",", " ", "\[Ellipsis]", ",", " ", 
    StyleBox["pairing", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0d95f56e-6eaa-4d5e-a45b-1e9402a67c12"],
 "\[LineSeparator]",
 "gives the graded exterior product ",
 Cell[BoxData[
  RowBox[{
   StyleBox["u", "TI"], "\[Wedge]", 
   StyleBox["v", "TI"], "\[Wedge]", "\[CenterDot]", 
   StyleBox["s", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f771fe34-0b63-497b-b73d-19396fec4477"],
 " of cyclic words, sorted into canonical order with the Koszul sign of the \
exterior grading.",
 "\n"
}], "Usage",ExpressionUUID->"d8eeb774-caab-43ac-a6af-578c708cc3be"],

Cell["\<\
The factors are cyclic words; the last argument is always the pairing object.\
\
\>", "Notes",ExpressionUUID->"db36e3f6-8a0e-41fb-8dc9-adad29a7c590"],

Cell[TextData[{
 "Sorting uses the exterior grading ",
 Cell[BoxData[
  RowBox[{
   StyleBox["[",
    SpanMaxSize->1], "-", 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bb99a058-e4e0-47f1-85b6-85a945e2ae7b"],
 ", the one ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["WordDegree"]], "paclet:IBLInfinity/ref/WordDegree", 
    "IBLInfinity Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "3427d7d2-aa4e-4906-be20-e4d1cb66d225"],
 " returns under ",
 Cell[BoxData["\"\<Exterior\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "79891321-e3c2-4eb7-9ac6-5ec6cff913cb"],
 ". Exchanging two factors costs ",
 Cell[BoxData[
  SuperscriptBox[
   RowBox[{
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{"-", "1"}], 
    StyleBox[")",
     SpanMaxSize->1]}], 
   RowBox[{
    StyleBox["[",
     SpanMaxSize->1], 
    StyleBox["u", "TI"], 
    StyleBox["]",
     SpanMaxSize->1], 
    StyleBox["[",
     SpanMaxSize->1], 
    StyleBox["v", "TI"], 
    StyleBox["]",
     SpanMaxSize->1]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "33af5618-854d-44b1-acbf-b7505971eb8b"],
 "."
}], "Notes",ExpressionUUID->"889cc777-5692-4a25-b43d-5b83a0a49b60"],

Cell[TextData[{
 "The normalized result carries only its factors \[LongDash] the pairing \
argument is consumed, so ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["ExteriorProduct"]], "paclet:IBLInfinity/ref/ExteriorProduct", 
     "IBLInfinity Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["u", "TI"], ",", " ", 
    StyleBox["v", "TI"], ",", " ", 
    StyleBox["pairing", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "531bd8bd-e4ff-438f-a332-c9516640f967"],
 " returns an expression of the form ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["ExteriorProduct"]], "paclet:IBLInfinity/ref/ExteriorProduct", 
     "IBLInfinity Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    RowBox[{
     StyleBox["u", "TI"], "'"}], ",", " ", 
    RowBox[{
     StyleBox["v", "TI"], "'"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ded55358-7791-4053-93b1-e7c2c2626aa8"],
 ", possibly with a scalar sign in front."
}], "Notes",ExpressionUUID->"92195981-40f8-4062-9dca-7bcc365f7acc"],

Cell[TextData[{
 "A product with a repeated factor of odd exterior degree is ",
 Cell[BoxData["0"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5ff9e798-1ad4-495d-a692-64fea37e1a5b"],
 "."
}], "Notes",ExpressionUUID->"8966a652-137e-4d0b-955b-64225cb62507"],

Cell[TextData[{
 "The product of a single factor is a legitimate one-factor product, not the \
bare word: the arities of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Bracket"]], "paclet:IBLInfinity/ref/Bracket", 
    "IBLInfinity Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "4e946ad8-fe54-4e51-8de5-2c2fe9f3df8c"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Cobracket"]], "paclet:IBLInfinity/ref/Cobracket", 
    "IBLInfinity Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "ee595975-efef-4cda-8c17-c4ee8fdcd97b"],
 " as a derivation and a co-derivation are counted in factors."
}], "Notes",ExpressionUUID->"582ee94a-c6e8-4fa3-92eb-a96b86a532a6"],

Cell[TextData[{
 "This is the exterior half of the pair of pictures the paclet works in. Use \
it when the pairing object carries ",
 Cell[BoxData[
  RowBox[{"\"\<Convention\>\"", " ", "->", " ", "\"\<Exterior\>\""}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8cf62069-a71f-4430-8382-e8af6a25cacd"],
 "; the symmetric picture is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SymmetricProduct"]], "paclet:IBLInfinity/ref/SymmetricProduct",
     "IBLInfinity Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "ae3507d0-5cfa-41b9-8246-1c9b1c544e29"],
 "."
}], "Notes",ExpressionUUID->"84aaa121-6c6e-41a5-90c1-3826225ab11d"]
}, Open  ]],

