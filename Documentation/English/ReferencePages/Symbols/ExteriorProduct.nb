Cell["Two factors already in order:", "ExampleText",ExpressionUUID->"6481e68f-6d7d-4674-baed-820fd8b70032"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ExteriorProduct", "[", 
  RowBox[{
   RowBox[{"CyclicWord", "[", 
    RowBox[{"{", "x", "}"}], "]"}], ",", " ", 
   RowBox[{"CyclicWord", "[", 
    RowBox[{"{", "y", "}"}], "]"}], ",", " ", 
   RowBox[{"GradedPairing", "[", 
    RowBox[{
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"x", " ", "->", " ", 
        RowBox[{"-", "1"}]}], ",", " ", 
       RowBox[{"y", " ", "->", " ", "0"}]}], "|>"}], ",", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "y"}], "}"}], " ", "->", " ", "1"}], "|>"}]}], 
    "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"7e572c97-e9bc-475a-984e-3cd58aa7019a"],

