Cell["ExteriorProduct", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"fb388a98-8796-41ea-a86f-61357d817ba9"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["ExteriorProduct"]], "paclet:ChernSimons/ref/ExteriorProduct", 
     "ChernSimons Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["u", "TI"], ",", " ", 
    StyleBox["v", "TI"], ",", " ", "\[Ellipsis]", ",", " ", 
    StyleBox["pairing", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "0d8a4034-ddb2-4830-afdb-a4fd8635dfc4"],
 "\[LineSeparator]",
 "gives the graded exterior product ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["u", "TI"], "\[Wedge]", 
    StyleBox["v", "TI"], "\[Wedge]", "\[CenterEllipsis]"}], TraditionalForm]],
   "InlineFormula",ExpressionUUID->"fe1a6b89-f1e2-46c2-8f4d-9c6fee3cce53"],
 " of the cyclic words ",
 StyleBox["u", "TI"],
 ", ",
 StyleBox["v", "TI"],
 ", \[Ellipsis], in canonical order with the Koszul sign of the exterior \
grading.",
 "\n"
}], "Usage",ExpressionUUID->"93a598cc-7b34-4975-95fe-9033571551f6"],

Cell["\<\
The factors are cyclic words or lists of letters, and the last argument is \
the pairing object.\
\>", "Notes",
 CellFrameLabels->{{Inherited, Inherited}, {Inherited, 
    Cell[
     TextData[{
      "26.09.30: Design review - the exterior product is one of the two \
pictures the paper works in, and the sign translation between it and the \
symmetric product is the heart of the project, so both products are exported \
and SymmetricToExterior and ExteriorToSymmetric carry one to the other. The \
pairing is the last positional argument, because the sort needs the exterior \
degrees and they depend on the pairing degree; it is consumed, and the result \
ExteriorProduct[u, v, ...] carries only its factors, so an expression without \
a pairing is inert and is the normal form. A single remaining factor is the \
word itself, never a one-factor product, the rule every product of the paclet \
follows; the engine keeps a one-factor wedge instead, which is why the \
comparison with it starts at two factors. The product carries its own \
linearity rules and accepts lists of letters, so a sum or a scalar multiple \
composes without a wrapper. Prior art: the Wolfram Language has Wedge, an \
operator with no built-in meaning, and TensorWedge, the antisymmetric product \
of arrays; neither sorts graded words. The engine the verification suites \
load builds its odot and wedge from one constructor, and \
T12/paclet-products-and-shift pins this product against its wedge on all \
products of two and three words to length 3.", "\n\n", 
       Cell[
        BoxData[
         GridBox[{{
            Cell[
             BoxData[
              ButtonBox[
               DynamicBox[
                FEPrivate`FrontEndResource[
                "DocumentationToolsStrings", "Edit"]], BaseStyle -> 
               "TextAnnotationButton"]]], 
            StyleBox[
             RowBox[{
               DynamicBox[
                FEPrivate`FrontEndResource[
                "DocumentationToolsStrings", "LastAnnotator"]], "pavel"}], 
             "TextAnnotator"], 
            Cell[
             BoxData[
              ButtonBox[
               DynamicBox[
                FEPrivate`FrontEndResource[
                "DocumentationToolsStrings", "Delete"]], BaseStyle -> 
               "TextAnnotationRemoveButton"]]], ""}}, 
          GridBoxAlignment -> {
           "Columns" -> {Left, Left, Right, Right}, "Rows" -> {{Automatic}}}, 
          GridBoxItemSize -> {"Columns" -> {
              Scaled[0.15], 
              Scaled[0.68], 
              Scaled[0.15], 
              Scaled[0.02]}}]]], "\n"}], "TextAnnotation", 
     CellSize -> {590, Inherited}]}},
 CellTags->"TextAnnotation",
 CellID->869792266,ExpressionUUID->"85eb1192-ab58-4d64-8fef-107786067937"],

Cell[TextData[{
 "The factors are brought into canonical rotation and sorted in the exterior \
grading ",
 Cell[BoxData[
  FormBox[
   RowBox[{"[", "-", "]"}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "fa4c1d7b-92c4-4142-954e-197834f6f657"],
 ", the one ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ElementDegree"]], "paclet:ChernSimons/ref/ElementDegree", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "0ae8c876-909c-4fb2-a977-4cdb59fdad67"],
 " gives under ",
 Cell[BoxData["\"\<Exterior\>\""], "InlineFormula",ExpressionUUID->
  "01c5fd3a-9e18-44fa-b4b0-ef96b1eec170"],
 ". Exchanging two factors ",
 Cell[BoxData[
  FormBox[
   StyleBox["u", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "3d4e0342-7a17-4cb6-87ef-b5a3477af275"],
 " and ",
 Cell[BoxData[
  FormBox[
   StyleBox["v", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "2bb3adfa-d553-40bb-9e24-f06d7b0b5759"],
 " costs ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"-", "1"}], ")"}], 
    RowBox[{
     RowBox[{"[", 
      StyleBox["u", "TI"], "]"}], 
     RowBox[{"[", 
      StyleBox["v", "TI"], "]"}], "+", "1"}]], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"35670087-e8b8-469c-b668-ec2724134bc9"],
 ", the sign ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["KoszulSign"]], "paclet:ChernSimons/ref/KoszulSign", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "60626a20-7a3f-4ea0-b192-bf208ff06029"],
 " gives with ",
 StyleBox["parity", "TI"],
 " ",
 Cell[BoxData[
  FormBox["1", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "c8b89367-a865-4500-98d9-558225964c56"],
 "."
}], "Notes",ExpressionUUID->"50f40e79-5d7f-42ee-bcab-7fb1634381ae"],

Cell[TextData[{
 "The pairing is consumed: the result is an expression ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["ExteriorProduct"]], "paclet:ChernSimons/ref/ExteriorProduct", 
     "ChernSimons Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    RowBox[{
     StyleBox["u", "TI"], "'"}], ",", " ", 
    RowBox[{
     StyleBox["v", "TI"], "'"}], ",", " ", "\[Ellipsis]"}], "]"}]], 
  "InlineFormula",ExpressionUUID->"40819c51-6c60-49cf-b2b2-9d3341e96a37"],
 " of the sorted factors, possibly with a scalar sign in front."
}], "Notes",ExpressionUUID->"664f48a6-27f2-417b-921f-a49bc94c7dfc"],

Cell[TextData[{
 "A product with a repeated factor of even exterior degree is ",
 Cell[BoxData[
  FormBox["0", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "bdeb2454-09f4-4e77-85b8-aba1c199ad0c"],
 "."
}], "Notes",ExpressionUUID->"ef25c1d6-c1bc-4386-ad1c-f042c67f0527"],

Cell["The product of a single factor is the word itself.", "Notes",ExpressionUUID->"2a1f9cbe-c670-407e-bd7c-1d4933f4a8d0"],

Cell["\<\
The product is linear in every factor, and a nested product is flattened.\
\>", "Notes",ExpressionUUID->"3986eb1c-5b8b-4cd7-80a0-acd8d6949144"],

Cell["A factor given as the empty list is the empty word.", "Notes",ExpressionUUID->"18dfbdb0-8f3e-4f57-bd8f-7091f8f472cd"],

Cell[TextData[{
 "The operations of a pairing object in the exterior convention give their \
products as ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
