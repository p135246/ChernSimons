    Editable->False], "\[Wedge]", 
   InterpretationBox[
    RowBox[{"(", "y", ")"}],
    ChernSimons`CyclicWord[{MTNB$dvmpxw3j9tc0`y}],
    Editable->False]}],
  ChernSimons`ExteriorProduct[
