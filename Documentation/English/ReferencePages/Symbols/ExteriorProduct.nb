  FormBox["\[Wedge]", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "e7ceaf7d-21f7-49fc-bbb8-00b400c7d7eb"],
 ", each word in its own parentheses."
}], "Notes",ExpressionUUID->"8f528b55-dcd7-42c3-b8fe-ed9e066361f0"]
