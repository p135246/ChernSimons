   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "0bdfe2bb-01ce-436c-b76b-d56151ca448c"],
 "; the symmetric picture is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SymmetricProduct"]], "paclet:ChernSimons/ref/SymmetricProduct",
     "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "9dbcd1df-8eb0-45d1-a840-eae886453078"],
 "."
}], "Notes",ExpressionUUID->"a82b15eb-1bfb-4565-93dd-0853147a90b9"],

Cell[TextData[{
 "The arities of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CanonicalLieBracket"]], 
    "paclet:ChernSimons/ref/CanonicalLieBracket", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "245a4a5d-fe80-4506-99cc-94a8b365be99"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CanonicalLieCobracket"]], 
    "paclet:ChernSimons/ref/CanonicalLieCobracket", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "46c9aeb1-8ccc-44c3-81ab-87c1d2223c62"],
 " as a derivation and a co-derivation are counted in factors, a single word \
counting as one."
}], "Notes",ExpressionUUID->"a5424c50-c8b4-495a-8276-96ea4a6f3e39"],

Cell[TextData[{
 "A sorted product displays as its factors joined by ",
