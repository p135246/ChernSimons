Cell[CellGroupData[{
Cell["ExteriorProduct", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"79488eb4-b168-4594-b79c-e53a805f4234"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["ExteriorProduct"]], "paclet:ChernSimons/ref/ExteriorProduct", 
     "ChernSimons Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["u", "TI"], ",", " ", 
    StyleBox["v", "TI"], ",", " ", "\[Ellipsis]", ",", " ", 
    StyleBox["pairing", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ac2c9f46-d0a1-4192-8253-716ff7e7428e"],
 "\[LineSeparator]",
 "gives the graded exterior product ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["u", "TI"], "\[Wedge]", 
    StyleBox["v", "TI"], "\[Wedge]", "\[CenterEllipsis]"}], TraditionalForm]],
   "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b9b1cc42-d04d-4af4-971a-806ace974977"],
 " of the cyclic words ",
 StyleBox["u", "TI"],
 ", ",
 StyleBox["v", "TI"],
 ", \[Ellipsis], in canonical order with the Koszul sign of the exterior \
grading.",
 "\n"
}], "Usage",ExpressionUUID->"aa795247-65e9-409d-98df-9264b940eb20"],

Cell["\<\
The factors are cyclic words or lists of particles, and the last argument is \
the pairing object.\
\>", "Notes",
 CellFrameLabels->{{Inherited, Inherited}, {Inherited, 
    Cell[
     TextData[{
      "26.09.30: Design review - the exterior product is one of the two \
pictures the paper works in, and the sign translation between it and the \
symmetric product is the heart of the project, so both products are exported \
and SymmetricToExterior and ExteriorToSymmetric carry one to the other. The \
pairing is the last positional argument, because the sort needs the exterior \
degrees and they depend on the pairing degree; it is consumed, and the result \
ExteriorProduct[u, v, ...] carries only its factors, so an expression without \
a pairing is inert and is the normal form. A single remaining factor is the \
word itself, never a one-factor product, the rule every product of the paclet \
follows; the engine keeps a one-factor wedge instead, which is why the \
comparison with it starts at two factors. The product carries its own \
linearity rules and accepts lists of particles, so a sum or a scalar multiple \
composes without a wrapper. Prior art: the Wolfram Language has Wedge, an \
operator with no built-in meaning, and TensorWedge, the antisymmetric product \
of arrays; neither sorts graded words. The engine the verification suites \
load builds its odot and wedge from one constructor, and \
T12/paclet-products-and-shift pins this product against its wedge on all \
products of two and three words to length 3.", "\n\n", 
       Cell[
        BoxData[
         GridBox[{{
            Cell[
             BoxData[
              ButtonBox[
               DynamicBox[
                FEPrivate`FrontEndResource[
                "DocumentationToolsStrings", "Edit"]], BaseStyle -> 
               "TextAnnotationButton"]]], 
            StyleBox[
             RowBox[{
               DynamicBox[
                FEPrivate`FrontEndResource[
                "DocumentationToolsStrings", "LastAnnotator"]], "pavel"}], 
             "TextAnnotator"], 
            Cell[
             BoxData[
              ButtonBox[
               DynamicBox[
                FEPrivate`FrontEndResource[
                "DocumentationToolsStrings", "Delete"]], BaseStyle -> 
               "TextAnnotationRemoveButton"]]], ""}}, 
          GridBoxAlignment -> {
           "Columns" -> {Left, Left, Right, Right}, "Rows" -> {{Automatic}}}, 
          GridBoxItemSize -> {"Columns" -> {
              Scaled[0.15], 
              Scaled[0.68], 
              Scaled[0.15], 
              Scaled[0.02]}}]]], "\n"}], "TextAnnotation", 
     CellSize -> {590, Inherited}]}},
 CellTags->"TextAnnotation",
 CellID->253016082,ExpressionUUID->"4b56241a-5e6b-49ef-8e67-fb066d20a834"],

Cell[TextData[{
 "The factors are brought into canonical rotation and sorted in the exterior \
grading ",
 Cell[BoxData[
  FormBox[
   RowBox[{"[", "-", "]"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9cff35a1-20bf-45fe-850a-5de6f956ac69"],
 ", the one ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ElementDegree"]], "paclet:ChernSimons/ref/ElementDegree", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "0eb882c4-1cb7-4e10-bb1d-3a6dbbf9c3e7"],
 " gives under ",
 Cell[BoxData["\"\<Exterior\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "30ec11b2-539d-4ce0-93c1-e4623b487646"],
 ". Exchanging two factors ",
 Cell[BoxData[
  FormBox[
   StyleBox["u", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dc7c33b5-bd1d-4a4c-96b1-442f1fc176ce"],
 " and ",
 Cell[BoxData[
  FormBox[
   StyleBox["v", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c166ee8b-d392-4821-9459-d0d38eb6347f"],
 " costs ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"-", "1"}], ")"}], 
    RowBox[{
     RowBox[{"[", 
      StyleBox["u", "TI"], "]"}], 
     RowBox[{"[", 
      StyleBox["v", "TI"], "]"}], "+", "1"}]], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2964fcf5-29a7-47c5-88fb-308f4ac4061b"],
 ", the sign ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["KoszulSign"]], "paclet:ChernSimons/ref/KoszulSign", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "a4bfef09-cf3b-4327-bcf0-8308d58f557b"],
 " gives with ",
 StyleBox["parity", "TI"],
 " ",
 Cell[BoxData[
  FormBox["1", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8ce6f65a-bce9-4ffb-8b5c-36e17667df49"],
 "."
}], "Notes",ExpressionUUID->"68a7a591-3478-4782-91f4-037fe5df11db"],

Cell[TextData[{
 "The pairing is consumed: the result is an expression ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["ExteriorProduct"]], "paclet:ChernSimons/ref/ExteriorProduct", 
     "ChernSimons Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    RowBox[{
     StyleBox["u", "TI"], "'"}], ",", " ", 
    RowBox[{
     StyleBox["v", "TI"], "'"}], ",", " ", "\[Ellipsis]"}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2f72f46f-da42-4f3a-b01f-93c774708e06"],
 " of the sorted factors, possibly with a scalar sign in front."
}], "Notes",ExpressionUUID->"9c65411e-3341-445b-b66b-07164541a067"],

Cell[TextData[{
 "A product with a repeated factor of even exterior degree is ",
 Cell[BoxData[
  FormBox["0", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "733d5ca2-0fcf-4f15-a65d-842f8c8f4ed9"],
 "."
}], "Notes",ExpressionUUID->"c8ec11eb-14d0-4b4f-b3d6-a03a31251a0a"],

Cell["The product of a single factor is the word itself.", "Notes",ExpressionUUID->"768cb6dc-c860-42b6-91ef-e4fed81ee05a"],

Cell["\<\
The product is linear in every factor, and a nested product is flattened.\
\>", "Notes",ExpressionUUID->"918eb944-fc73-48c5-a587-1fa66c4f0d35"],

Cell["A factor given as the empty list is the empty word.", "Notes",ExpressionUUID->"63cb0d62-0d78-42a9-8c70-9d09bcf0ad0b"],

