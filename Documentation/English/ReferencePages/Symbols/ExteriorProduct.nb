Cell[CellGroupData[{
Cell["ExteriorProduct", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"932e09d6-4256-4854-b161-9a43167f6ad9"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["ExteriorProduct"]], "paclet:ChernSimons/ref/ExteriorProduct", 
     "ChernSimons Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["u", "TI"], ",", " ", 
    StyleBox["v", "TI"], ",", " ", "\[Ellipsis]", ",", " ", 
    StyleBox["pairing", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "89b1105c-628b-4a18-bb47-de8eeca9676f"],
 "\[LineSeparator]",
 "gives the graded exterior product ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["u", "TI"], "\[Wedge]", 
    StyleBox["v", "TI"], "\[Wedge]", "\[CenterEllipsis]"}], TraditionalForm]],
   "InlineFormula",ExpressionUUID->"7bfa50b2-f2fa-4698-a554-5d22a1b91deb"],
 " of the cyclic words ",
 StyleBox["u", "TI"],
 ", ",
 StyleBox["v", "TI"],
 ", \[Ellipsis], in canonical order with the Koszul sign of the exterior \
grading.",
 "\n"
}], "Usage",ExpressionUUID->"2a829e39-ccd3-4708-bfe9-e7ae09b3585a"],

Cell["\<\
The factors are cyclic words or lists of particles, and the last argument is \
the pairing object.\
\>", "Notes",
 CellFrameLabels->{{Inherited, Inherited}, {Inherited, 
    Cell[
     TextData[{
      "26.09.30: Design review - the exterior product is one of the two \
pictures the paper works in, and the sign translation between it and the \
symmetric product is the heart of the project, so both products are exported \
and SymmetricToExterior and ExteriorToSymmetric carry one to the other. The \
pairing is the last positional argument, because the sort needs the exterior \
degrees and they depend on the pairing degree; it is consumed, and the result \
ExteriorProduct[u, v, ...] carries only its factors, so an expression without \
a pairing is inert and is the normal form. A single remaining factor is the \
word itself, never a one-factor product, the rule every product of the paclet \
follows; the engine keeps a one-factor wedge instead, which is why the \
comparison with it starts at two factors. The product carries its own \
linearity rules and accepts lists of particles, so a sum or a scalar multiple \
composes without a wrapper. Prior art: the Wolfram Language has Wedge, an \
operator with no built-in meaning, and TensorWedge, the antisymmetric product \
of arrays; neither sorts graded words. The engine the verification suites \
load builds its odot and wedge from one constructor, and \
T12/paclet-products-and-shift pins this product against its wedge on all \
products of two and three words to length 3.", "\n\n", 
       Cell[
        BoxData[
         GridBox[{{
            Cell[
             BoxData[
              ButtonBox[
               DynamicBox[
                FEPrivate`FrontEndResource[
                "DocumentationToolsStrings", "Edit"]], BaseStyle -> 
               "TextAnnotationButton"]]], 
            StyleBox[
             RowBox[{
               DynamicBox[
                FEPrivate`FrontEndResource[
                "DocumentationToolsStrings", "LastAnnotator"]], "pavel"}], 
             "TextAnnotator"], 
            Cell[
             BoxData[
              ButtonBox[
               DynamicBox[
                FEPrivate`FrontEndResource[
                "DocumentationToolsStrings", "Delete"]], BaseStyle -> 
               "TextAnnotationRemoveButton"]]], ""}}, 
          GridBoxAlignment -> {
           "Columns" -> {Left, Left, Right, Right}, "Rows" -> {{Automatic}}}, 
          GridBoxItemSize -> {"Columns" -> {
              Scaled[0.15], 
              Scaled[0.68], 
              Scaled[0.15], 
              Scaled[0.02]}}]]], "\n"}], "TextAnnotation", 
     CellSize -> {590, Inherited}]}},
 CellTags->"TextAnnotation",
 CellID->165931761,ExpressionUUID->"a7b595ad-a47e-4e2a-a819-317a7438896e"],

Cell[TextData[{
 "The factors are brought into canonical rotation and sorted in the exterior \
grading ",
 Cell[BoxData[
  FormBox[
   RowBox[{"[", "-", "]"}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "cc72fbc4-47d2-4ed6-8e87-e53a7f7eb4ec"],
 ", the one ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ElementDegree"]], "paclet:ChernSimons/ref/ElementDegree", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "43428e66-3495-4cae-804d-1b53a2d7b3c2"],
 " gives under ",
 Cell[BoxData["\"\<Exterior\>\""], "InlineFormula",ExpressionUUID->
  "eacb4b17-8d1d-4d46-bd0e-e39bd27f4121"],
 ". Exchanging two factors ",
 Cell[BoxData[
  FormBox[
   StyleBox["u", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "9d308bf4-d33a-49d9-8d42-49b9b204908c"],
 " and ",
 Cell[BoxData[
  FormBox[
   StyleBox["v", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "d7eb3324-b3a7-445a-80a8-d996c8c92810"],
 " costs ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"-", "1"}], ")"}], 
    RowBox[{
     RowBox[{"[", 
      StyleBox["u", "TI"], "]"}], 
     RowBox[{"[", 
      StyleBox["v", "TI"], "]"}], "+", "1"}]], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"12a04c92-229c-44b9-afe5-b4baf93a4a55"],
 ", the sign ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["KoszulSign"]], "paclet:ChernSimons/ref/KoszulSign", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "c85e3dd8-e9f3-4af8-a2f5-39f99d37f31b"],
 " gives with ",
 StyleBox["parity", "TI"],
 " ",
 Cell[BoxData[
  FormBox["1", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "8c40f9b3-9ef7-499a-8563-a06b669401d9"],
 "."
}], "Notes",ExpressionUUID->"fb7dedb5-454f-4351-84fe-2ad82e1142a5"],

Cell[TextData[{
 "The pairing is consumed: the result is an expression ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["ExteriorProduct"]], "paclet:ChernSimons/ref/ExteriorProduct", 
     "ChernSimons Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    RowBox[{
     StyleBox["u", "TI"], "'"}], ",", " ", 
    RowBox[{
     StyleBox["v", "TI"], "'"}], ",", " ", "\[Ellipsis]"}], "]"}]], 
  "InlineFormula",ExpressionUUID->"7da2fa33-8a0d-4c79-898f-3a0c8b51d14d"],
 " of the sorted factors, possibly with a scalar sign in front."
}], "Notes",ExpressionUUID->"f7f58112-e80b-4ad9-88e8-c16c00b98843"],

Cell[TextData[{
 "A product with a repeated factor of even exterior degree is ",
 Cell[BoxData[
  FormBox["0", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "7f6de041-2007-4ae8-bd01-c7c1d321f600"],
 "."
}], "Notes",ExpressionUUID->"c54c0a7a-252a-4daa-8493-091801d6f480"],

Cell["The product of a single factor is the word itself.", "Notes",ExpressionUUID->"1a1d826f-c1cf-4374-8c08-3dc8f00b7c8d"],

Cell["\<\
The product is linear in every factor, and a nested product is flattened.\
\>", "Notes",ExpressionUUID->"2e4dae6d-4030-4310-abc2-8948a72ba686"],

Cell["A factor given as the empty list is the empty word.", "Notes",ExpressionUUID->"59f18541-e8b1-455d-8ea7-aa4006d59e85"],

Cell[TextData[{
 "The operations of a pairing object in the exterior convention give their \
products as ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ExteriorProduct"]], "paclet:ChernSimons/ref/ExteriorProduct", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "3b373c0c-f632-4d5f-9a37-720d89423afc"],
 "; the symmetric picture is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SymmetricProduct"]], "paclet:ChernSimons/ref/SymmetricProduct",
     "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "e563d187-e096-4ffc-842a-46ad1872bfe9"],
 "."
}], "Notes",ExpressionUUID->"7b8105ab-c961-4d81-8369-909fd28dbfe9"],

Cell[TextData[{
 "The arities of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CanonicalLieBracket"]], 
    "paclet:ChernSimons/ref/CanonicalLieBracket", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "0f331def-ae15-4fc4-890a-30d5d48ba177"],
