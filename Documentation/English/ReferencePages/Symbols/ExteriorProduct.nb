Cell["Two factors already in order:", "ExampleText",ExpressionUUID->"a00a5e81-e085-4e3d-ae9f-f6d94f0eae42"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ExteriorProduct", "[", 
  RowBox[{
   RowBox[{"CyclicWord", "[", 
    RowBox[{"{", "x", "}"}], "]"}], ",", " ", 
   RowBox[{"CyclicWord", "[", 
    RowBox[{"{", "y", "}"}], "]"}], ",", " ", 
   RowBox[{"GradedPairing", "[", 
    RowBox[{
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"x", " ", "->", " ", 
        RowBox[{"-", "1"}]}], ",", " ", 
       RowBox[{"y", " ", "->", " ", "0"}]}], "|>"}], ",", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "y"}], "}"}], " ", "->", " ", "1"}], "|>"}]}], 
    "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"5df89668-b4b1-4445-95dd-3769303131cd"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{
   InterpretationBox[
    RowBox[{"(", "x", ")"}],
    ChernSimons`CyclicWord[{MTNB$1v3fzwkfdyys5`x}],
    Editable->False], "\[Wedge]", 
   InterpretationBox[
    RowBox[{"(", "y", ")"}],
    ChernSimons`CyclicWord[{MTNB$1v3fzwkfdyys5`y}],
    Editable->False]}],
  ChernSimons`ExteriorProduct[
   ChernSimons`CyclicWord[{MTNB$1v3fzwkfdyys5`x}], 
   ChernSimons`CyclicWord[{MTNB$1v3fzwkfdyys5`y}]],
  Editable->False]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"7b89896f-ef5a-48b1-9427-8fd145bdb64c"]
}, Open  ]],

