Notebook[{

Cell[CellGroupData[{
Cell["ExteriorProduct", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"28512c3b-58c7-48cc-a8e9-3696bdde4f82"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["ExteriorProduct"]], "paclet:ChernSimons/ref/ExteriorProduct", 
     "ChernSimons Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["u", "TI"], ",", " ", 
    StyleBox["v", "TI"], ",", " ", "\[Ellipsis]", ",", " ", 
    StyleBox["pairing", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f9703055-5f52-40cb-8f9b-3f53d12d741d"],
 "\[LineSeparator]",
 "gives the graded exterior product ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["u", "TI"], "\[Wedge]", 
    StyleBox["v", "TI"], "\[Wedge]", "\[CenterEllipsis]"}], TraditionalForm]],
   "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "45d16d83-c69b-404c-a635-0d487bd3cea1"],
 " of cyclic words, sorted into canonical order with the Koszul sign of the \
exterior grading.",
 "\n"
}], "Usage",ExpressionUUID->"15b45ad7-e5f1-4bef-b13c-1feb65f0b030"],

Cell["\<\
The factors are cyclic words; the last argument is always the pairing object.\
\
\>", "Notes",ExpressionUUID->"95005be1-e2fc-45ae-b3af-be9b37866853"],

Cell[TextData[{
 "Sorting uses the exterior grading ",
 Cell[BoxData[
  FormBox[
   RowBox[{"[", "-", "]"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9758b41c-92f3-435a-a74f-e3410db390b5"],
 ", the one ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["WordDegree"]], "paclet:ChernSimons/ref/WordDegree", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "09422dcd-b090-4ec5-978c-095d6fc6d50a"],
 " returns under ",
 Cell[BoxData["\"\<Exterior\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8f95fb52-5b31-4a98-be37-d93caf93a92f"],
 ". Exchanging two factors costs ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"-", "1"}], ")"}], 
    RowBox[{
     RowBox[{"[", 
      StyleBox["u", "TI"], "]"}], 
     RowBox[{"[", 
      StyleBox["v", "TI"], "]"}]}]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3561ecf7-0115-42a8-9045-1f46ac4973aa"],
 "."
}], "Notes",ExpressionUUID->"bff9623c-b371-4a6a-bff0-3566f8157b9a"],

Cell[TextData[{
 "The normalized result carries only its factors \[LongDash] the pairing \
argument is consumed, so ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["ExteriorProduct"]], "paclet:ChernSimons/ref/ExteriorProduct", 
     "ChernSimons Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["u", "TI"], ",", " ", 
    StyleBox["v", "TI"], ",", " ", 
    StyleBox["pairing", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "337d94c4-ecc7-422f-a2df-ee4f94376487"],
 " returns an expression of the form ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["ExteriorProduct"]], "paclet:ChernSimons/ref/ExteriorProduct", 
     "ChernSimons Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    RowBox[{
     StyleBox["u", "TI"], "'"}], ",", " ", 
    RowBox[{
     StyleBox["v", "TI"], "'"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "aa2a6e08-acb1-4639-8479-e75421df5f1e"],
 ", possibly with a scalar sign in front."
}], "Notes",ExpressionUUID->"77b91217-c8ce-43c0-bbb6-a948b1b15afa"],

Cell[TextData[{
 "A product with a repeated factor of odd exterior degree is ",
 Cell[BoxData[
  FormBox["0", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4203cda9-f962-47fd-b0b5-ad09db300c2f"],
 "."
}], "Notes",ExpressionUUID->"ba9c1ce7-df4b-48e9-9770-b2097ae2c24b"],

Cell[TextData[{
 "The product of a single factor is the word itself. The arities of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InvolutiveBracket"]], 
    "paclet:ChernSimons/ref/InvolutiveBracket", "ChernSimons Package Symbol"},
   
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "1f83524a-dc70-4133-aee2-a491713bc0d3"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InvolutiveCobracket"]], 
    "paclet:ChernSimons/ref/InvolutiveCobracket", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "679871a8-472e-4d80-9698-8aa4a2ffaa6d"],
 " as a derivation and a co-derivation are counted in factors, a bare word \
counting as one. The factors may be given as lists of particles, and the \
product is linear in every factor."
}], "Notes",ExpressionUUID->"f7f83847-4c76-43e1-b2e7-38846238ecbd"],

Cell[TextData[{
 "This is the exterior half of the pair of pictures the paclet works in. Use \
it when the pairing object carries ",
 Cell[BoxData[
  RowBox[{"\"\<Convention\>\"", " ", "->", " ", "\"\<Exterior\>\""}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4994c74f-f8f5-4435-9486-6fbdbf9a6dd4"],
 "; the symmetric picture is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SymmetricProduct"]], "paclet:ChernSimons/ref/SymmetricProduct",
     "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "2bc307c6-b891-4f5c-ac35-8d7f4be88058"],
 "."
}], "Notes",ExpressionUUID->"f8bb3204-6572-4741-857c-5a47db0bdcfb"],

Cell[TextData[{
 "A normalized product displays as its factors joined by ",
 Cell[BoxData[
  FormBox["\[Wedge]", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "da745936-701a-44db-a022-d1f9d1a034ba"],
 ", each word in its own parentheses."
}], "Notes",ExpressionUUID->"fce389a9-74b5-4269-8163-700de79fe54f"]
}, Open  ]],

