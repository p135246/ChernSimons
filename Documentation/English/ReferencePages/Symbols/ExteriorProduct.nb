 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CanonicalLieCobracket"]], 
    "paclet:ChernSimons/ref/CanonicalLieCobracket", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "a6a81b8d-708a-402a-9fd3-2fbbe29c9f11"],
 " as a derivation and a co-derivation are counted in factors, a single word \
counting as one."
}], "Notes",ExpressionUUID->"1b47f891-a2a3-4064-bfd7-a897f6aaa372"],

Cell[TextData[{
 "A sorted product displays as its factors joined by ",
