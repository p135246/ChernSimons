 "."
}], "Notes",ExpressionUUID->"84dfba5c-6008-445f-b540-da8ffa81515d"],

Cell[TextData[{
 "Only the part ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["m", "TI"], 
    RowBox[{"1", ",", "0"}]], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"ed1e6c30-e371-46d9-8a29-7a58a40a2d63"],
 " enters. The part ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["m", "TI"], 
    RowBox[{"2", ",", "0"}]], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"be4ff768-5ff1-4d56-8539-cd416107298f"],
 " is what ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["TwistedCobracket"]], "paclet:ChernSimons/ref/TwistedCobracket",
     "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "344f2a76-0d53-4407-8de6-155c0ebae3e1"],
 " reads."
}], "Notes",ExpressionUUID->"5fd7e015-8e7e-4d3d-852d-b976f2774c40"],

Cell[TextData[{
 "When the pairing carries no differential, ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CyclicHochschildDifferential"]], 
    "paclet:ChernSimons/ref/CyclicHochschildDifferential", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "ca7578fa-8294-4bbc-a24a-c3017531b7b4"],
 " is ",
 Cell[BoxData[
  FormBox["0", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "7be921f9-2bde-4f21-b757-3954c6497d12"],
 " and the twist is the bracket alone."
}], "Notes",ExpressionUUID->"f73dc201-f9ee-46c7-9a09-53bab6cd6ec8"],

Cell["On a cyclic word the result is the same in both conventions.", "Notes",ExpressionUUID->"3f5adb94-0eac-495e-98d8-349eb7801f29"],

Cell[TextData[{
 "On a product the twisted differential acts on each factor in turn, with the \
Koszul sign of the shuffle, in the picture the convention of the pairing \
selects: a ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SymmetricProduct"]], "paclet:ChernSimons/ref/SymmetricProduct",
     "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "64f6c32f-41b8-4422-96cf-9ba8e797225d"],
 " under ",
 Cell[BoxData["\"\<Symmetric\>\""], "InlineFormula",ExpressionUUID->
  "57f2272b-890c-4b11-a3fc-0d830e6a73cc"],
 ", an ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ExteriorProduct"]], "paclet:ChernSimons/ref/ExteriorProduct", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "0e0de063-e2db-488a-b735-2135e431930e"],
 " under ",
 Cell[BoxData["\"\<Exterior\>\""], "InlineFormula",ExpressionUUID->
  "53f36896-8c5a-4a4f-a3f5-1ad551d45c40"],
 "."
}], "Notes",ExpressionUUID->"5066ad5e-1a66-4239-84d2-6a3001004285"],

Cell["A product of the other kind returns unevaluated.", "Notes",ExpressionUUID->"ad225160-d071-47f4-812c-0457e598c586"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["TwistedDifferential"]], 
    "paclet:ChernSimons/ref/TwistedDifferential", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "11322c70-bea4-4d42-a664-1ff453547b1d"],
 " is linear in its second argument, and a word may be given as the list of \
its particles."
}], "Notes",ExpressionUUID->"73c73d66-ce17-4744-bf8a-2edfdf6a4e07"],

Cell[TextData[{
 "When ",
 StyleBox["m", "TI"],
 " solves the Maurer-Cartan equation, the twisted differential squares to \
zero."
}], "Notes",ExpressionUUID->"01341274-92e8-481b-a14a-08c2263056b5"],

Cell[TextData[{
 "For the element ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["CanonicalMaurerCartan"]], 
     "paclet:ChernSimons/ref/CanonicalMaurerCartan", 
     "ChernSimons Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["pairing", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "1ed0cbbc-48d1-4aaf-ab22-2054dc984210"],
 " of a Poincar\[EAcute] duality algebra it is the dual of the cyclic \
Hochschild differential of the algebra, whose homology is Connes' cyclic \
cohomology."
}], "Notes",ExpressionUUID->"ceb4da48-8252-4921-acb5-818a783bd264"],

