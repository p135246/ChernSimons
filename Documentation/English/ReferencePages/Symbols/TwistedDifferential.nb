Cell["Twisting by the canonical element of the circle:", "ExampleText",ExpressionUUID->"30a7e469-e4ae-4974-936a-bcc4787cb33a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"TwistedDifferential", "[", 
  RowBox[{
   RowBox[{"MaurerCartanElement", "[", 
    RowBox[{
     RowBox[{"CyclicWord", "[", 
      RowBox[{"{", 
       RowBox[{"x", ",", " ", "x", ",", " ", "y"}], "}"}], "]"}], ",", " ", 
     RowBox[{"GradedPairing", "[", 
      RowBox[{
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"x", " ", "->", " ", 
          RowBox[{"-", "1"}]}], ",", " ", 
         RowBox[{"y", " ", "->", " ", "0"}]}], "|>"}], ",", " ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"x", ",", " ", "y"}], "}"}], " ", "->", " ", "1"}], 
        "|>"}]}], "]"}]}], "]"}], ",", " ", 
   RowBox[{"CyclicWord", "[", 
    RowBox[{"{", 
     RowBox[{"x", ",", " ", "y", ",", " ", "y"}], "}"}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"d272fd63-395f-4b34-9d00-712769abac2b"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"(", 
   RowBox[{
   "x", "\[ThinSpace]", "x", "\[ThinSpace]", "y", "\[ThinSpace]", "y"}], ")"}],
  ChernSimons`CyclicWord[{
   MTNB$1k0j4dbi58zje`x, MTNB$1k0j4dbi58zje`x, MTNB$1k0j4dbi58zje`y, 
    MTNB$1k0j4dbi58zje`y}],
  Editable->False]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"8a1772e8-1e70-42fa-91e3-6415a7669b00"]
}, Open  ]],

