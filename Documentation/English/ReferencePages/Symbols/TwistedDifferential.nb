Cell["The alphabet of the circle:", "ExampleText",ExpressionUUID->"acb163ed-9030-4ec9-b813-4bc4ff20635e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"pairing", " ", "=", " ", 
  RowBox[{"GradedPairing", "[", 
   RowBox[{
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"x", " ", "->", " ", 
       RowBox[{"-", "1"}]}], ",", " ", 
      RowBox[{"y", " ", "->", " ", "0"}]}], "|>"}], ",", " ", 
    RowBox[{"<|", 
