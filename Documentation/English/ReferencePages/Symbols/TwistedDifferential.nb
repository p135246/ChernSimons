Cell[TextData[{
 "The twisted differential is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["q", "TI"], 
     RowBox[{"1", ",", "1", ",", "0"}], 
     StyleBox["m", "TI"]], "\[LongEqual]", 
    SubscriptBox[
     StyleBox["q", "TI"], 
     RowBox[{"1", ",", "1", ",", "0"}]], "+", 
    SubscriptBox[
     StyleBox["q", "TI"], 
     RowBox[{"2", ",", "1", ",", "0"}]], 
    SubscriptBox["\[EmptySmallCircle]", "1"], 
    SubscriptBox[
     StyleBox["m", "TI"], 
     RowBox[{"1", ",", "0"}]]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f0d206cd-2c9a-491b-8e27-eec2bb0c0763"],
 ": ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CyclicHochschildDifferential"]], 
    "paclet:ChernSimons/ref/CyclicHochschildDifferential", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "8d3c1029-d46b-470f-b4c3-ef8e1d0a1aef"],
 " of ",
 StyleBox["w", "TI"],
 " plus ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["StringBracket"]], "paclet:ChernSimons/ref/StringBracket", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "281a41cb-1a45-474e-826c-fa04f21135ff"],
 " of the part ",
 Cell[BoxData[
  RowBox[{
   StyleBox["m", "TI"], "[", 
   RowBox[{"{", 
    RowBox[{"1", ",", " ", "0"}], "}"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7f3c0eaa-e999-41d8-b300-d6b93d7d9875"],
 " with ",
 StyleBox["w", "TI"],
 "."
}], "Notes",
 CellFrameLabels->{{Inherited, Inherited}, {Inherited, 
    Cell[
     TextData[{
      "26.09.30: Design review - the twisted differential takes the whole \
MaurerCartanElement and reads its part m_{1,0} and its pairing from it, so it \
takes no pairing argument (design 2 of the names doc, R5d, kept by Pavel); \
before R5d it took a BD action and a pairing, and a BD action in place of the \
element now returns unevaluated. Only m_{1,0} enters, as in q^m_{110} = \
q_{110} + q_{210} o_1 m_{10}. On a word the result is the same in both \
conventions, because the sign exponents of the two pictures differ by 2|m|; \
on a product the head must be that of the convention, and a product of the \
other kind returns unevaluated rather than being coerced, as for \
StringBracket. The extension to products is the derivation extension \
CyclicHochschildDifferential and StringBracket use. Prior art: the Wolfram \
Language has no twisted string operations; the engine the verification suites \
load computes the same differential as q110Twisted[mcCanonical, -], a \
function of the bare BD action, and T12/paclet-twisted-operations pins this \
function against it on every word to length 5 in both conventions, \
T12/paclet-twisted-operations-on-products on products of two words. No \
alternative interface was recorded.", "\n\n", 
       Cell[
        BoxData[
         GridBox[{{
            Cell[
             BoxData[
              ButtonBox[
               DynamicBox[
                FEPrivate`FrontEndResource[
                "DocumentationToolsStrings", "Edit"]], BaseStyle -> 
               "TextAnnotationButton"]]], 
            StyleBox[
             RowBox[{
               DynamicBox[
                FEPrivate`FrontEndResource[
                "DocumentationToolsStrings", "LastAnnotator"]], "pavel"}], 
             "TextAnnotator"], 
            Cell[
             BoxData[
              ButtonBox[
               DynamicBox[
                FEPrivate`FrontEndResource[
                "DocumentationToolsStrings", "Delete"]], BaseStyle -> 
               "TextAnnotationRemoveButton"]]], ""}}, 
          GridBoxAlignment -> {
           "Columns" -> {Left, Left, Right, Right}, "Rows" -> {{Automatic}}}, 
          GridBoxItemSize -> {"Columns" -> {
              Scaled[0.15], 
              Scaled[0.68], 
              Scaled[0.15], 
              Scaled[0.02]}}]]], "\n"}], "TextAnnotation", 
     CellSize -> {590, Inherited}]}},
 CellTags->"TextAnnotation",
 CellID->302193444,ExpressionUUID->"f82babfa-57b0-40be-b3e9-b0e01a737ae1"],

Cell[TextData[{
 "The pairing is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["m", "TI"], "[", "\"\<Pairing\>\"", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b9270fb1-bfe3-4305-a0af-d3f962e2cc68"],
 "."
}], "Notes",ExpressionUUID->"e1d38fd7-9873-437f-8f70-508b066575d2"],

Cell[TextData[{
 "Only the part ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["m", "TI"], 
    RowBox[{"1", ",", "0"}]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f02c6057-ccbf-45f0-b4de-497701c205cc"],
 " enters. The part ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["m", "TI"], 
    RowBox[{"2", ",", "0"}]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9ea96bb3-d734-4b9c-aac4-e2e315187826"],
 " is what ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["TwistedCobracket"]], "paclet:ChernSimons/ref/TwistedCobracket",
     "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "d84191a9-4906-4a1f-8ce1-ee5e691a196d"],
 " reads."
}], "Notes",ExpressionUUID->"77bc9fbc-b2e7-42bb-a377-8cade10bb8aa"],

Cell[TextData[{
 "When the pairing carries no differential, ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CyclicHochschildDifferential"]], 
    "paclet:ChernSimons/ref/CyclicHochschildDifferential", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "6d2f6bd8-7254-47f4-b7b2-f483ce6866c2"],
 " is ",
 Cell[BoxData[
  FormBox["0", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "866f9374-517e-4509-a18f-caf185bc3c73"],
 " and the twist is the bracket alone."
}], "Notes",ExpressionUUID->"b9e6f65e-29c5-4fe2-8b85-cd1a0d151c0f"],

Cell["On a cyclic word the result is the same in both conventions.", "Notes",ExpressionUUID->"f6060547-eb72-4aab-ae24-5a720a756e83"],

Cell[TextData[{
 "On a product the twisted differential acts on each factor in turn, with the \
Koszul sign of the shuffle, in the picture the convention of the pairing \
selects: a ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SymmetricProduct"]], "paclet:ChernSimons/ref/SymmetricProduct",
     "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "0a2d7b93-5d6d-4c50-984b-4346145516b2"],
 " under ",
 Cell[BoxData["\"\<Symmetric\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0ff722f2-04c6-4c53-a2aa-933df71da72e"],
 ", an ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ExteriorProduct"]], "paclet:ChernSimons/ref/ExteriorProduct", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "ffba6bc4-9ecd-4443-8e75-5cd09bdac8b4"],
 " under ",
 Cell[BoxData["\"\<Exterior\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e0c5e8ea-fe8c-44be-aaae-e73df7b53fc9"],
 "."
}], "Notes",ExpressionUUID->"2d68c6d1-8618-4b49-86a4-709692466e80"],

Cell["A product of the other kind returns unevaluated.", "Notes",ExpressionUUID->"38866311-dff0-4fae-ae80-b632fe10def6"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["TwistedDifferential"]], 
    "paclet:ChernSimons/ref/TwistedDifferential", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "2695b963-773c-48c4-8cc7-ed2d3952a88a"],
 " is linear in its second argument, and a word may be given as the list of \
its particles."
}], "Notes",ExpressionUUID->"2bb737ee-065c-45e4-80eb-87ddeaf17aa3"],

Cell[TextData[{
 "When ",
 StyleBox["m", "TI"],
 " solves the Maurer-Cartan equation, the twisted differential squares to \
zero."
}], "Notes",ExpressionUUID->"f3b81074-7407-48d2-b473-7dcc37c46c7f"],

Cell[TextData[{
 "For the element ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["CanonicalMaurerCartan"]], 
     "paclet:ChernSimons/ref/CanonicalMaurerCartan", 
     "ChernSimons Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["pairing", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fee07b2d-7eff-4263-9f8f-e263386481f5"],
 " of a Poincar\[EAcute] duality algebra it is the dual of the cyclic \
Hochschild differential of the algebra, whose homology is Connes' cyclic \
cohomology."
}], "Notes",ExpressionUUID->"8425d3e9-12e0-4651-92d3-9ae82abe159d"],

