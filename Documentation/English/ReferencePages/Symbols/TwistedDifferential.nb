 InterpretationBox[
  RowBox[{"(", 
   RowBox[{
   "x", "\[ThinSpace]", "x", "\[ThinSpace]", "y", "\[ThinSpace]", "y"}], ")"}],
  ChernSimons`CyclicWord[{
   MTNB$9p2q39rw5g0i`x, MTNB$9p2q39rw5g0i`x, MTNB$9p2q39rw5g0i`y, 
    MTNB$9p2q39rw5g0i`y}],
  Editable->False]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"d161b324-7cb8-4adc-b51b-d3f54fe24eea"]
}, Open  ]],

