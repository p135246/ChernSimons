 RowBox[{"Map", "[", 
  RowBox[{
   RowBox[{"w", " ", "|->", " ", 
    RowBox[{"TwistedDifferential", "[", 
     RowBox[{
      RowBox[{"CyclicWord", "[", 
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "x", ",", " ", "y"}], "}"}], "]"}], ",", " ", 
      "w", ",", " ", "pairing"}], "]"}]}], ",", " ", 
   RowBox[{"CyclicWords", "[", 
    RowBox[{"2", ",", " ", "pairing"}], "]"}]}], "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"5c407b0d-13b7-4510-9eae-ce128e2be938"],

