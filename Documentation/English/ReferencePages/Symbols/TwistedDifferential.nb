 Cell[BoxData[
  RowBox[{
   StyleBox["m", "TI"], "[", "\"\<Pairing\>\"", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "61088a89-a4a8-49c5-844d-b7d4acff8dce"],
 "."
}], "Notes",ExpressionUUID->"e2f9aa2a-a647-43ce-9ff3-d06ec0f77f8a"],

Cell[TextData[{
 "Only the part ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["m", "TI"], 
    RowBox[{"1", ",", "0"}]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4c451663-39cf-4c85-818c-e6af49e2e510"],
 " enters. The part ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["m", "TI"], 
    RowBox[{"2", ",", "0"}]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b228e0bb-a7d4-45d4-b58d-bb1650d9f011"],
 " is what ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["TwistedCobracket"]], "paclet:ChernSimons/ref/TwistedCobracket",
     "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "5349af26-92ae-4d7e-b9ac-2b308d580434"],
 " reads."
}], "Notes",ExpressionUUID->"4e922d21-f0c4-4d87-925b-9112c72aa2ae"],

Cell[TextData[{
 "When the pairing carries no differential, ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CyclicHochschildDifferential"]], 
    "paclet:ChernSimons/ref/CyclicHochschildDifferential", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "2c03bbe9-eefe-46f7-b43f-71d6f432a818"],
 " is ",
 Cell[BoxData[
  FormBox["0", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ade84871-f6c4-4fc7-bdff-f30f8f44ca39"],
 " and the twist is the bracket alone."
}], "Notes",ExpressionUUID->"ca4f2abd-9899-4425-8649-9a17d849c632"],

Cell["On a cyclic word the result is the same in both conventions.", "Notes",ExpressionUUID->"1fce888f-b5a5-446b-b0a5-b739443e2837"],

Cell[TextData[{
 "On a product the twisted differential acts on each factor in turn, with the \
Koszul sign of the shuffle, in the picture the convention of the pairing \
selects: a ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SymmetricProduct"]], "paclet:ChernSimons/ref/SymmetricProduct",
     "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "6e687c8a-847a-4a07-853a-2e58fce176cb"],
 " under ",
 Cell[BoxData["\"\<Symmetric\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fd5ebdd2-7bd3-4d42-a865-99e43a9f2af3"],
 ", an ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ExteriorProduct"]], "paclet:ChernSimons/ref/ExteriorProduct", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "3f451374-c8f2-4a86-aa62-86e2014693eb"],
 " under ",
 Cell[BoxData["\"\<Exterior\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f9b630b2-f971-4dea-8e8b-506aa1057b21"],
 "."
}], "Notes",ExpressionUUID->"ffbb03dd-89db-4bee-b680-627c33a5f325"],

Cell["A product of the other kind returns unevaluated.", "Notes",ExpressionUUID->"11769671-613f-4f04-8c34-85c9a9402bbf"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["TwistedDifferential"]], 
    "paclet:ChernSimons/ref/TwistedDifferential", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "ee10e346-b084-47da-b098-5b5f81fea050"],
 " is linear in its second argument, and a word may be given as the list of \
its particles."
}], "Notes",ExpressionUUID->"e2d2cf64-be7c-4c47-bd4a-208cf73fc686"],

Cell[TextData[{
 "When ",
 StyleBox["m", "TI"],
 " solves the Maurer-Cartan equation, the twisted differential squares to \
zero."
}], "Notes",ExpressionUUID->"0c6ccfc2-d8fe-402c-a49f-107ea1a95bb0"],

Cell[TextData[{
 "For the element ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["CanonicalMaurerCartan"]], 
     "paclet:ChernSimons/ref/CanonicalMaurerCartan", 
     "ChernSimons Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["pairing", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6b4c0732-df8b-449e-b198-4a9c89f26b7e"],
 " of a Poincar\[EAcute] duality algebra it is the dual of the cyclic \
Hochschild differential of the algebra, whose homology is Connes' cyclic \
cohomology."
}], "Notes",ExpressionUUID->"6ff609d1-00ea-4293-b064-6182669ddf4a"],

