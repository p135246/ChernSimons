Cell["The alphabet of the circle:", "ExampleText",ExpressionUUID->"ab72e64a-506c-4908-a1bf-504a12ecc370"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"pairing", " ", "=", " ", 
  RowBox[{"GradedPairing", "[", 
   RowBox[{
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"x", " ", "->", " ", 
       RowBox[{"-", "1"}]}], ",", " ", 
      RowBox[{"y", " ", "->", " ", "0"}]}], "|>"}], ",", " ", 
    RowBox[{"<|", 
