Notebook[{

Cell[CellGroupData[{
Cell["TwistedDifferential", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"383d4763-75ce-4e50-a509-a17463ed8fbc"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["TwistedDifferential"]], 
     "paclet:ChernSimons/ref/TwistedDifferential", 
     "ChernSimons Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["m", "TI"], ",", " ", 
    StyleBox["w", "TI"], ",", " ", 
    StyleBox["pairing", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4aaa70ea-3b27-49f9-b778-813050dd0a52"],
 "\[LineSeparator]",
 "gives the differential ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["q", "TI"], 
    RowBox[{"1", ",", "1", ",", "0"}], 
    StyleBox["m", "TI"]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "be5420e0-256a-44e6-95c2-a154ba2a7fbc"],
 " twisted by the element ",
 StyleBox["m", "TI"],
 ", applied to the cyclic word ",
 StyleBox["w", "TI"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"ebf7afab-c5f3-4a9e-a84c-a2037397d5cd"],

Cell[TextData[{
 "The twisted differential is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CyclicDifferential"]], 
    "paclet:ChernSimons/ref/CyclicDifferential", "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "5c3791e4-f8f7-43ef-8a88-2049407e8868"],
 " plus the bracket with ",
 StyleBox["m", "TI"],
 ", the bracket taken up to the sign of the symmetric degree. On a formal \
alphabet the first summand vanishes and the twist is the bracket alone. \
Twisting by a Maurer-Cartan element gives a differential; twisting by \
anything else does not."
}], "Notes",ExpressionUUID->"797ec3e3-e458-44f4-bd99-7956be3ce2cf"],

Cell[TextData[{
 "Both this and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["TwistedCobracket"]], "paclet:ChernSimons/ref/TwistedCobracket",
     "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "eea1e0a5-0332-471c-af48-0cf0f9cf5ca0"],
 " are written in the exterior picture, the one the paper states them in, \
regardless of the convention carried by ",
 StyleBox["pairing", "TI"],
 "."
}], "Notes",ExpressionUUID->"b1658091-3f9b-4e0c-a210-d3c20d529fc3"]
}, Open  ]],

