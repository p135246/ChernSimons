 "."
}], "Notes",ExpressionUUID->"f6bfcac5-7997-4275-86a0-b3da0846714a"],

Cell[TextData[{
 "Only the part ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["m", "TI"], 
    RowBox[{"1", ",", "0"}]], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"7fd215ce-87cb-4571-bd23-11bd7a18f6a0"],
 " enters. The part ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["m", "TI"], 
    RowBox[{"2", ",", "0"}]], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"5e984f8b-78c6-4805-a308-082045f12c8d"],
 " is what ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["TwistedCobracket"]], "paclet:ChernSimons/ref/TwistedCobracket",
     "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "8faee09d-6698-412a-bda4-375cb49050b0"],
 " reads."
}], "Notes",ExpressionUUID->"c6c6d726-e8f5-40ea-b422-314dfdbe36f4"],

Cell[TextData[{
 "When the pairing carries no differential, ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CyclicHochschildDifferential"]], 
    "paclet:ChernSimons/ref/CyclicHochschildDifferential", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "e91778d1-df64-44aa-a27d-7a7ce8493fb0"],
 " is ",
 Cell[BoxData[
  FormBox["0", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "d6f74a98-b1ab-45dd-af21-3a2719028ab6"],
 " and the twist is the bracket alone."
}], "Notes",ExpressionUUID->"fa70d2cc-2191-45db-b401-80f9a8b983f3"],

Cell["On a cyclic word the result is the same in both conventions.", "Notes",ExpressionUUID->"e19ee2a7-9343-46e9-9790-1cc388d2f205"],

Cell[TextData[{
 "On a product the twisted differential acts on each factor in turn, with the \
Koszul sign of the shuffle, in the picture the convention of the pairing \
selects: a ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SymmetricProduct"]], "paclet:ChernSimons/ref/SymmetricProduct",
     "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "ca5ac94a-06c0-4e40-a096-691c18f6a517"],
 " under ",
 Cell[BoxData["\"\<Symmetric\>\""], "InlineFormula",ExpressionUUID->
  "34110104-c45f-41aa-b5d2-e936cebeb4e5"],
 ", an ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ExteriorProduct"]], "paclet:ChernSimons/ref/ExteriorProduct", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "57ac6d5e-9f96-494a-875d-cdac0dbba720"],
 " under ",
 Cell[BoxData["\"\<Exterior\>\""], "InlineFormula",ExpressionUUID->
  "aad0563c-617b-4b2a-9725-0fc93a92d9f9"],
 "."
}], "Notes",ExpressionUUID->"6d6a783a-75d6-449b-a2d8-efcab4fc577d"],

Cell["A product of the other kind returns unevaluated.", "Notes",ExpressionUUID->"f2ed14bd-15b6-4519-b66e-24e1fe0da3e4"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["TwistedDifferential"]], 
    "paclet:ChernSimons/ref/TwistedDifferential", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "954a03dc-15d0-4a7b-a91a-3be01d75974f"],
 " is linear in its second argument, and a word may be given as the list of \
its letters."
}], "Notes",ExpressionUUID->"937225ea-4909-49bd-95de-8593b00f7fb3"],

Cell[TextData[{
 "When ",
 StyleBox["m", "TI"],
 " solves the Maurer-Cartan equation, the twisted differential squares to \
zero."
}], "Notes",ExpressionUUID->"c1d4b66e-4cff-447b-8411-f3de4f29b3be"],

Cell[TextData[{
 "For the element ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["CanonicalMaurerCartan"]], 
     "paclet:ChernSimons/ref/CanonicalMaurerCartan", 
     "ChernSimons Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["pairing", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "aa780cf1-c2e2-43d1-b0ae-a5740842b813"],
 " of a Poincar\[EAcute] duality algebra it is the dual of the cyclic \
Hochschild differential of the algebra, whose homology is Connes' cyclic \
cohomology."
}], "Notes",ExpressionUUID->"9500f438-d42f-4a6f-8cf9-1be6275ccd6e"],

