Cell["Twisting by the canonical element of the circle:", "ExampleText",ExpressionUUID->"7248e267-c435-4a34-ab40-7473d94d85ff"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"pairing", " ", "=", " ", 
   RowBox[{"GradedPairing", "[", 
    RowBox[{
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"x", " ", "->", " ", 
        RowBox[{"-", "1"}]}], ",", " ", 
       RowBox[{"y", " ", "->", " ", "0"}]}], "|>"}], ",", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "y"}], "}"}], " ", "->", " ", "1"}], "|>"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{"TwistedDifferential", "[", 
  RowBox[{
   RowBox[{"CyclicWord", "[", 
    RowBox[{"{", 
     RowBox[{"x", ",", " ", "x", ",", " ", "y"}], "}"}], "]"}], ",", " ", 
   RowBox[{"CyclicWord", "[", 
    RowBox[{"{", 
     RowBox[{"x", ",", " ", "y", ",", " ", "y"}], "}"}], "]"}], ",", " ", 
   "pairing"}], "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"f55dc823-5c2e-4334-b8c6-620226155c2d"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"(", 
   RowBox[{
   "x", "\[ThinSpace]", "x", "\[ThinSpace]", "y", "\[ThinSpace]", "y"}], ")"}],
  ChernSimons`CyclicWord[{
   MTNB$37isx4iv06wl`x, MTNB$37isx4iv06wl`x, MTNB$37isx4iv06wl`y, 
    MTNB$37isx4iv06wl`y}],
  Editable->False]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"ea4fc4c4-eb17-4f26-ae26-63aeea7e6492"]
}, Open  ]],

