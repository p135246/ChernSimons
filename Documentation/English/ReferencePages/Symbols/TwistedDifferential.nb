Cell["Twisting by the canonical element of the circle:", "ExampleText",ExpressionUUID->"3bfbc713-a873-41cc-8fbe-7f7269495940"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"TwistedDifferential", "[", 
  RowBox[{
   RowBox[{"MaurerCartanElement", "[", 
    RowBox[{
     RowBox[{"CyclicWord", "[", 
      RowBox[{"{", 
       RowBox[{"x", ",", " ", "x", ",", " ", "y"}], "}"}], "]"}], ",", " ", 
     RowBox[{"GradedPairing", "[", 
      RowBox[{
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"x", " ", "->", " ", 
          RowBox[{"-", "1"}]}], ",", " ", 
         RowBox[{"y", " ", "->", " ", "0"}]}], "|>"}], ",", " ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"x", ",", " ", "y"}], "}"}], " ", "->", " ", "1"}], 
        "|>"}]}], "]"}]}], "]"}], ",", " ", 
   RowBox[{"CyclicWord", "[", 
    RowBox[{"{", 
     RowBox[{"x", ",", " ", "y", ",", " ", "y"}], "}"}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"18d8663d-f02e-4737-895d-4522ae237234"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"(", 
   RowBox[{
   "x", "\[ThinSpace]", "x", "\[ThinSpace]", "y", "\[ThinSpace]", "y"}], ")"}],
  ChernSimons`CyclicWord[{
   MTNB$1k0j4dbi58zje`x, MTNB$1k0j4dbi58zje`x, MTNB$1k0j4dbi58zje`y, 
    MTNB$1k0j4dbi58zje`y}],
  Editable->False]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"b35a2c6b-abc0-4028-8e87-2d02a2956d5b"]
}, Open  ]],

