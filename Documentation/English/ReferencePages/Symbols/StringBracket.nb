 StyleBox["pairing", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"82f96b54-75f1-433d-a62c-56ec95bad87c"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
