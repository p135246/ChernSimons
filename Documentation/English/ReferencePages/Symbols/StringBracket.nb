Cell["The bracket of two words of the circle:", "ExampleText",ExpressionUUID->"a869aa5f-76ae-4f8a-842a-50c023d609bf"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"StringBracket", "[", 
  RowBox[{
   RowBox[{"CyclicWord", "[", 
    RowBox[{"{", "x", "}"}], "]"}], ",", " ", 
   RowBox[{"CyclicWord", "[", 
    RowBox[{"{", 
     RowBox[{"x", ",", " ", "y"}], "}"}], "]"}], ",", " ", 
   RowBox[{"GradedPairing", "[", 
    RowBox[{
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"x", " ", "->", " ", 
        RowBox[{"-", "1"}]}], ",", " ", 
       RowBox[{"y", " ", "->", " ", "0"}]}], "|>"}], ",", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "y"}], "}"}], " ", "->", " ", "1"}], "|>"}]}], 
    "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"105f14c1-67f5-4432-9880-3c4c24d82671"],

