   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "b5b1b47a-9686-4a7f-b2c3-4f0df55bb9f9"],
 " that carries a product and has a perfect pairing.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"87d3a1d7-baf3-40ca-8b9b-6faef84f199a"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["PoincareDualityAlgebra"]], 
     "paclet:ChernSimons/ref/PoincareDualityAlgebra", 
     "ChernSimons Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["data", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "989032e0-1a13-47a6-9d9a-0deb3091524e"],
 "\[LineSeparator]",
 "is a finite-dimensional Poincar\[EAcute] duality algebra given by an \
Association ",
 StyleBox["data", "TI"],
 " of its basis, degrees, Gram matrix, differential and triple products, the \
object ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["NondegenerateQuotient"]], 
