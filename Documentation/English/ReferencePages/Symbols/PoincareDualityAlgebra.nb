 " gives."
}], "Usage",ExpressionUUID->"1cba6da3-22f7-4192-b4d7-30c4f3e20acb"],

Cell[TextData[{
 "The result is a tagged object, read with ",
 StyleBox["algebra", "TI"],
 "[",
 StyleBox["key", "TI"],
 "] and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Normal"]], "paclet:ref/Normal"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "f7a5dbe7-dc2c-49ec-95b9-daabcd2ca10b"],
 ". For a basis ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["b", "TI"], "1"], ",", "\[Ellipsis]", ",", 
    SubscriptBox[
     StyleBox["b", "TI"], 
     StyleBox["N", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e9aeb174-b250-4d9c-959b-7524db0d3e85"],
 " of degrees ",
