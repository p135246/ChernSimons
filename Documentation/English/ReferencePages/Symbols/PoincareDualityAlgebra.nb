Cell[CellGroupData[{
Cell["PoincareDualityAlgebra", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"6d034365-9a11-49a4-a401-4a1fac6e8ef0"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["PoincareDualityAlgebra"]], 
     "paclet:ChernSimons/ref/PoincareDualityAlgebra", 
     "ChernSimons Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["data", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7e9bc7ef-2943-48c1-b5ed-be614bd3dfa5"],
 "\[LineSeparator]",
 "is the finite-dimensional Poincare duality algebra that ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["NondegenerateQuotient"]], 
    "paclet:ChernSimons/ref/NondegenerateQuotient", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "dd1cf288-c978-4653-8d54-07378e0ff503"],
 " returns.",
 "\n"
}], "Usage",ExpressionUUID->"b43c7f5d-27b2-48c9-9c1c-1c5bfa8857d3"],

Cell[TextData[{
 "It is built by ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["NondegenerateQuotient"]], 
    "paclet:ChernSimons/ref/NondegenerateQuotient", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "14121665-0a13-47fd-8ae8-5cadbaa74a52"],
 ", not by hand, and it is the object the rational homotopy layer hands to \
the dIBL layer: ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["GradedPairing"]], "paclet:ChernSimons/ref/GradedPairing", 
     "ChernSimons Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["algebra", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "33536ae3-978f-4f14-9df7-40936feb238b"],
 " reads the alphabet off it, and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CanonicalMaurerCartan"]], 
    "paclet:ChernSimons/ref/CanonicalMaurerCartan", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "567299ee-4000-41c3-8bc1-360dfccf92a8"],
 " reads the canonical element off its triple product."
}], "Notes",ExpressionUUID->"56466d44-6829-4b44-bc6b-507b742b006b"],

