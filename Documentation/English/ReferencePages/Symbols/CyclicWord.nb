 "\[LineSeparator]",
 "is the cyclic word whose particles are the list ",
 StyleBox["w", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"4f8061cc-04de-4042-95fe-947814cf4f21"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["CyclicWord"]], "paclet:ChernSimons/ref/CyclicWord", 
     "ChernSimons Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
