Cell["Two rotations of one word normalize to the same word:", "ExampleText",ExpressionUUID->"8cc3486f-7fd0-4245-ae85-c259b36dfacd"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"CyclicWord", "[", 
