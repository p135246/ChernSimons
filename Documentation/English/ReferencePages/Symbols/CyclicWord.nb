Cell["Normalized with a pairing they agree:", "ExampleText",ExpressionUUID->"c61228cd-1a8d-448a-8661-1bfa261e9001"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"CyclicWord", "[", 
