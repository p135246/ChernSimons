Cell[CellGroupData[{
Cell["CyclicWord", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"a1256e07-555b-4285-abd6-2b1f8a047f23"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["CyclicWord"]], "paclet:IBLInfinity/ref/CyclicWord", 
     "IBLInfinity Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["w", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8ac253bd-ccd3-46d8-a6dd-3746109695f8"],
 "\[LineSeparator]",
 "represents the cyclic word whose particles are the list ",
 StyleBox["w", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"e41eb781-147b-4142-ac1f-93c6409825ee"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["CyclicWord"]], "paclet:IBLInfinity/ref/CyclicWord", 
     "IBLInfinity Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["w", "TI"], ",", " ", 
    StyleBox["data", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "67aa46c7-f1dc-4020-828a-4c307e9743de"],
 "\[LineSeparator]",
 "gives the canonical rotation of ",
 StyleBox["w", "TI"],
 " together with its Koszul sign, or ",
 Cell[BoxData["0"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "68be8aa7-2141-442c-aec1-e8bb2055bcef"],
 " if the word is cyclically antisymmetric."
}], "Usage",ExpressionUUID->"4ffad035-ff65-4f9d-b2d6-05cef1ef435f"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CyclicWord"]], "paclet:IBLInfinity/ref/CyclicWord", 
    "IBLInfinity Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "23864bb4-a171-4ceb-945d-8e5b35a0d70a"],
 " with one argument is inert: it is the normal form in which every operation \
of the paclet returns its words, and it carries no grading of its own."
}], "Notes",ExpressionUUID->"688f3683-5e8c-4003-bc1d-b683d2c41d04"],

Cell[TextData[{
 StyleBox["data", "TI"],
 " is either a pairing object built by ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Pairing"]], "paclet:IBLInfinity/ref/Pairing", 
    "IBLInfinity Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "692f3d33-72fa-4b6f-bd45-b6d4a8c96210"],
 ", or a bare association from particles to degrees. Only the degrees are \
read, so the two are interchangeable here."
}], "Notes",ExpressionUUID->"843ce80d-6d78-4eed-8d89-82a51f8a2c82"],

Cell[TextData[{
 "A cyclic word is a word up to rotation, and rotating past a particle of odd \
degree costs a Koszul sign. The canonical rotation is the least one in the \
paclet's internal order; the sign relating ",
 StyleBox["w", "TI"],
 " to it is returned as a scalar coefficient."
}], "Notes",ExpressionUUID->"6833e3e2-0c40-4e30-9879-b0dc8c4130a0"],

Cell[TextData[{
 "A word fixed by a rotation of odd total sign equals its own negative and is \
therefore ",
 Cell[BoxData["0"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "754c94df-f7d5-4907-bb96-980fc74cb5b1"],
 ". This is why the alphabet of the circle has no word ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"x", "x"}], "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "770f76ab-8ecf-4973-8586-8292dee4f8a4"],
 " and no word ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"x", "y", "x", "y"}], "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "517162a7-02d7-451a-bfa7-478bd7f80782"],
 "."
}], "Notes",ExpressionUUID->"27c2a8e6-d091-47a0-9a84-395618e6b11c"],

Cell["\<\
The two-argument form is a normalization, not a constructor: it is \
idempotent, and applying it to a word already in canonical form returns that \
word unchanged.\
\>", "Notes",ExpressionUUID->"222cfa1a-e417-46f7-8cce-6730ca895752"]
}, Open  ]],

