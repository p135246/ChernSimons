Cell[TextData[{
 "A word displays as its particles in parentheses, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     StyleBox["x", "TI"], " ", 
     StyleBox["y", "TI"], " ", 
     StyleBox["y", "TI"]}], ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"5c4b054b-e4ab-4f7d-b62a-2c65f21eeef0"],
