    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["w", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "37c5b07f-69dc-4282-aac5-c8516ad18b3a"],
 "\[LineSeparator]",
 "is the cyclic word whose letters are the list ",
 StyleBox["w", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"0f98dab9-e679-4917-990f-a628f5da960c"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["CyclicWord"]], "paclet:ChernSimons/ref/CyclicWord", 
     "ChernSimons Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["w", "TI"], ",", " ", 
    StyleBox["pairing", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "6d0f4582-6799-4bf7-94a8-927f80873fe4"],
 "\[LineSeparator]",
 "gives the canonical rotation of ",
 StyleBox["w", "TI"],
 " times its Koszul sign, or ",
 Cell[BoxData[
  FormBox["0", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "fdcce00f-251f-4c93-8b0d-8b474777cdd5"],
 " when a rotation sends ",
 StyleBox["w", "TI"],
 " to minus itself."
}], "Usage",ExpressionUUID->"f450493b-0140-43cb-a026-2a19ac4f0115"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CyclicWord"]], "paclet:ChernSimons/ref/CyclicWord", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "39575540-e9a8-4c05-83b5-7f19f7151512"],
 " with one argument is inert: it is the normal form in which every operation \
gives its words, and it carries no grading of its own."
}], "Notes",
 CellFrameLabels->{{Inherited, Inherited}, {Inherited, 
    Cell[
     TextData[{
      "26.09.30: Design review - a word is a list of letters, not a string, \
since the engine switched from strings on 2026-07-03: lists allow alphabets \
of arbitrary expressions, multi-character names and the basis monomials of a \
Poincare duality algebra among them, and use RotateLeft and Tuples directly. \
The one-argument form is inert, the normal form every operation gives its \
words in, and carries no grading, so the degrees always come from the pairing \
object passed beside it. The normalization is exported as the two-argument \
form because it is one of the few functions every operation shares, and the \
rule of the rewrite shares only exported functions with a mathematical name. \
Only the degrees are read, so an Association of degrees may stand in for the \
pairing object. The canonical rotation is the least rotation in the canonical \
order of Sort; it is not always the representative the engine picks, as on \
the Kodaira-Thurston alphabet. The empty word returns 0 by default, the \
positive-length convention of the paper, and is a word with \"EmptyWord\" -> \
True. Prior art: the Wolfram Language has no cyclic-word or necklace type; \
the engine the verification suites load normalizes the same words with its \
own cyc, and T12 compares the operations of the two on the words \
GenerateCyclicWords lists.", "\n\n", 
       Cell[
        BoxData[
         GridBox[{{
            Cell[
             BoxData[
              ButtonBox[
               DynamicBox[
                FEPrivate`FrontEndResource[
                "DocumentationToolsStrings", "Edit"]], BaseStyle -> 
               "TextAnnotationButton"]]], 
            StyleBox[
             RowBox[{
               DynamicBox[
                FEPrivate`FrontEndResource[
                "DocumentationToolsStrings", "LastAnnotator"]], "pavel"}], 
             "TextAnnotator"], 
            Cell[
             BoxData[
              ButtonBox[
               DynamicBox[
                FEPrivate`FrontEndResource[
                "DocumentationToolsStrings", "Delete"]], BaseStyle -> 
               "TextAnnotationRemoveButton"]]], ""}}, 
          GridBoxAlignment -> {
           "Columns" -> {Left, Left, Right, Right}, "Rows" -> {{Automatic}}}, 
          GridBoxItemSize -> {"Columns" -> {
              Scaled[0.15], 
              Scaled[0.68], 
              Scaled[0.15], 
              Scaled[0.02]}}]]], "\n"}], "TextAnnotation", 
     CellSize -> {590, Inherited}]}},
 CellTags->"TextAnnotation",
 CellID->970135755,ExpressionUUID->"943ef5a4-c8c2-46e4-af23-fffdaca7a368"],

Cell["\<\
In the string picture a cyclic word is a closed string, a necklace whose \
letters are the particles; the bracket joins two necklaces and the co-bracket \
cuts one.\
\>", "Notes",ExpressionUUID->"f94bd272-6fdd-4339-b919-9297f3e99b68"],

Cell[TextData[{
 StyleBox["pairing", "TI"],
 " is a pairing object built by ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["GradedPairing"]], "paclet:ChernSimons/ref/GradedPairing", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "cb2299b5-c944-4b6a-ba08-929693da290f"],
 ", or an association from letters to degrees. Only the degrees are read."
}], "Notes",ExpressionUUID->"82c4304d-edd8-4666-b29e-459dec1235c9"],

Cell[TextData[{
 "A cyclic word is a word up to rotation. Moving the first letter ",
 Cell[BoxData[
  FormBox[
   StyleBox["p", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "09456377-0454-4d37-90ee-ee17883041c3"],
 " of ",
 Cell[BoxData[
  FormBox[
   StyleBox["w", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "d6f7a4ee-ef43-4e8d-a905-a1df9869ca6c"],
 " to the end costs the Koszul sign ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"-", "1"}], ")"}], 
    RowBox[{"|", 
     StyleBox["p", "TI"], "|", 
     RowBox[{"(", 
      TemplateBox[{
        RowBox[{
          StyleBox["w", "TI"], "|", "-", "|", 
          StyleBox["p", "TI"]}]},
       "Abs"], ")"}]}]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "ba6b407e-4f26-4b38-9acd-7e6fcb543ae6"],
 "."
}], "Notes",ExpressionUUID->"2b3ab443-6ee0-4861-b6ce-bff7ba487ba2"],

Cell[TextData[{
 "The canonical rotation is the least rotation in the canonical order of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Sort"]], "paclet:ref/Sort"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "6fe51dc8-3ccc-4ea8-ba29-9ec01d5fa697"],
 ". The sign relating ",
 StyleBox["w", "TI"],
 " to it is a scalar coefficient in front of the word."
}], "Notes",ExpressionUUID->"91478ab9-5e6d-40d0-b82d-4d5bcd38fa5a"],

Cell[TextData[{
 "A word that a rotation sends to minus itself is ",
 Cell[BoxData[
  FormBox["0", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "c86b31b6-1d93-4924-b833-f16ab39cdd3c"],
 ". The alphabet of the circle has no word ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"x", "x"}], "TI"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"e23ca443-690c-49a3-b8d1-94f40c0c15b0"],
 " and no word ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"x", "y", "x", "y"}], "TI"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"5094f76d-8493-4019-8d91-e05b99b5f1f8"],
 "."
}], "Notes",ExpressionUUID->"febea7bf-eda9-4026-bedc-e71962bf98e7"],

Cell["\<\
The two-argument form is a normalization: a word already in canonical \
rotation is its own normal form.\
\>", "Notes",ExpressionUUID->"56e59cc3-e17b-4140-9341-e2a74ca3810d"],

