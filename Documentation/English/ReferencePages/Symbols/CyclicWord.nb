 Cell[BoxData[
  FormBox["\[Epsilon]", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "0ea03651-ca57-41b4-86a9-c7f512f3ea6c"],
 ". A particle that is not a symbol is set in its own parentheses, so \
juxtaposition always says where one particle ends and the next begins. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InputForm"]], "paclet:ref/InputForm"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "2fa2e27e-35e3-4639-b4ea-c1fd17308713"],
 " shows the expression itself."
}], "Notes",ExpressionUUID->"9942ceb2-2cd5-4947-b40d-afcb146c83ce"],

