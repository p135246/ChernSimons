  RowBox[{"CyclicWord", "[", 
   RowBox[{"{", 
    RowBox[{"x", ",", " ", "y"}], "}"}], "]"}]}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"e19ad37c-76e7-414b-9821-8cfabdb013fd"],

Cell[BoxData["False"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"7bf68ee8-5557-4294-9a59-ddf111911390"]
