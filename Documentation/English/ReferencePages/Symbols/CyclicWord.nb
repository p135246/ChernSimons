Cell["Longer words are normalized the same way:", "ExampleText",ExpressionUUID->"8294684e-43e8-4fca-9f69-cdfe62d979f5"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"pairing", " ", "=", " ", 
   RowBox[{"Pairing", "[", 
    RowBox[{
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"x", " ", "->", " ", 
        RowBox[{"-", "1"}]}], ",", " ", 
       RowBox[{"y", " ", "->", " ", "0"}]}], "|>"}], ",", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "y"}], "}"}], " ", "->", " ", "1"}], "|>"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"CyclicWord", "[", 
    RowBox[{"#", ",", " ", "pairing"}], "]"}], " ", "&"}], " ", "/@", " ", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"y", ",", " ", "x"}], "}"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"y", ",", " ", "y", ",", " ", "x"}], "}"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"y", ",", " ", "x", ",", " ", "y", ",", " ", "y"}], "}"}]}], 
   "}"}]}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"9b39d577-70d2-4337-9379-0b4dffe99d3d"],

Cell[BoxData[
 RowBox[{"{", 
