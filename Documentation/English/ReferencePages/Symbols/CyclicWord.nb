    RowBox[{"<|", 
     RowBox[{
      RowBox[{"x", " ", "->", " ", 
       RowBox[{"-", "1"}]}], ",", " ", 
      RowBox[{"y", " ", "->", " ", "0"}]}], "|>"}]}], "]"}], " ", "===", " ", 
  
  RowBox[{"CyclicWord", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"x", ",", " ", "y"}], "}"}], ",", " ", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"x", " ", "->", " ", 
