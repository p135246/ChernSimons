Cell["Rotating a word into canonical form:", "ExampleText",ExpressionUUID->"a11b3e1a-f581-4bab-870a-a73b2ab656cb"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"CyclicWord", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"y", ",", " ", "x"}], "}"}], ",", " ", 
   RowBox[{"Pairing", "[", 
    RowBox[{
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"x", " ", "->", " ", 
        RowBox[{"-", "1"}]}], ",", " ", 
       RowBox[{"y", " ", "->", " ", "0"}]}], "|>"}], ",", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "y"}], "}"}], " ", "->", " ", "1"}], "|>"}]}], 
    "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"ea62ff5d-a0e0-4bcb-ba46-93254e1819ff"],

Cell[BoxData[
 RowBox[{"CyclicWord", "[", 
  RowBox[{"{", 
