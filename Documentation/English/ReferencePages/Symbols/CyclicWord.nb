     RowBox[{"y", ",", " ", "y", ",", " ", "x"}], "}"}], ",", " ", 
    "pairing"}], "]"}], " ", "===", " ", 
  RowBox[{"CyclicWord", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"y", ",", " ", "x", ",", " ", "y"}], "}"}], ",", " ", 
