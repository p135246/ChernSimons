 Cell[BoxData[
  FormBox["\[Epsilon]", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "0babab8f-638a-4373-ac51-d3d0c764f6ed"],
 ". A letter that is not a symbol is set in its own parentheses, so \
juxtaposition always says where one letter ends and the next begins. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InputForm"]], "paclet:ref/InputForm"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "c7576289-2d94-4a17-995d-e1c473e6ec87"],
 " shows the expression itself."
}], "Notes",ExpressionUUID->"d05e93b2-b9c2-455e-acb3-ee84fdb966b9"],

