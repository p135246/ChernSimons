Cell["Rotating a word into canonical form:", "ExampleText",ExpressionUUID->"e11f9ba7-b3f0-4139-a16b-ec006b187c3f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"CyclicWord", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"y", ",", " ", "x"}], "}"}], ",", " ", 
   RowBox[{"GradedPairing", "[", 
    RowBox[{
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"x", " ", "->", " ", 
        RowBox[{"-", "1"}]}], ",", " ", 
       RowBox[{"y", " ", "->", " ", "0"}]}], "|>"}], ",", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "y"}], "}"}], " ", "->", " ", "1"}], "|>"}]}], 
    "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"d08be34c-25a3-4da2-8ace-bffd78c35f11"],

