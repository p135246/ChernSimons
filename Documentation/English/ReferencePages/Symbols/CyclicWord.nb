Notebook[{

Cell[CellGroupData[{
Cell["CyclicWord", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"b7089c09-bec0-4614-80ae-930757a58b9c"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["CyclicWord"]], "paclet:ChernSimons/ref/CyclicWord", 
     "ChernSimons Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["w", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "464babaa-51f7-4e36-89d3-436f189129b9"],
 "\[LineSeparator]",
 "represents the cyclic word whose particles are the list ",
 StyleBox["w", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"7095f93f-72ca-4083-8816-6d3c2c3a51b1"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["CyclicWord"]], "paclet:ChernSimons/ref/CyclicWord", 
     "ChernSimons Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["w", "TI"], ",", " ", 
    StyleBox["data", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "df139134-2f39-48b9-995b-000ac758a40b"],
 "\[LineSeparator]",
 "gives the canonical rotation of ",
 StyleBox["w", "TI"],
 " together with its Koszul sign, or ",
 Cell[BoxData[
  FormBox["0", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c59d40fd-258f-417c-8c1e-79bbadbda8c4"],
 " if the word is cyclically antisymmetric."
}], "Usage",ExpressionUUID->"71ef808c-3ab0-4699-85ff-6546245ae5e0"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CyclicWord"]], "paclet:ChernSimons/ref/CyclicWord", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "da26d72e-0d6f-4091-8817-6241aa2010d6"],
 " with one argument is inert: it is the normal form in which every operation \
of the paclet returns its words, and it carries no grading of its own."
}], "Notes",ExpressionUUID->"b0a37752-512c-4806-80d1-d12c0fe09fd7"],

Cell[TextData[{
 StyleBox["data", "TI"],
 " is either a pairing object built by ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["GradedPairing"]], "paclet:ChernSimons/ref/GradedPairing", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "187b3f43-3f88-4064-86a6-179c65d9008f"],
 ", or a bare association from particles to degrees. Only the degrees are \
read, so the two are interchangeable here."
}], "Notes",ExpressionUUID->"50cd51b6-d4eb-40b9-8cf7-402836d1a861"],

Cell[TextData[{
 "A cyclic word is a word up to rotation, and rotating past a particle of odd \
degree costs a Koszul sign. The canonical rotation is the least one in the \
paclet's internal order; the sign relating ",
 StyleBox["w", "TI"],
 " to it is returned as a scalar coefficient."
}], "Notes",ExpressionUUID->"83a3514d-e28c-46b2-a1ce-3764892ab7bf"],

Cell[TextData[{
 "A word fixed by a rotation of odd total sign equals its own negative and is \
therefore ",
 Cell[BoxData[
  FormBox["0", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0201e0a4-700d-42ca-8c14-3e9e69a600da"],
 ". This is why the alphabet of the circle has no word ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"x", "x"}], "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b76f9482-4a33-41f9-9420-788773ea1824"],
 " and no word ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"x", "y", "x", "y"}], "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f9f1b016-3887-4e8a-a573-9b59f20a9ec2"],
 "."
}], "Notes",ExpressionUUID->"f451da14-a84e-492b-b36d-f0959fb09d6d"],

Cell["\<\
The two-argument form is a normalization, not a constructor: it is \
idempotent, and applying it to a word already in canonical form returns that \
word unchanged.\
\>", "Notes",ExpressionUUID->"1efba96b-98da-4d7e-9310-90aaeef03da8"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["CyclicWord"]], "paclet:ChernSimons/ref/CyclicWord", 
     "ChernSimons Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{"{", "}"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "97f41dd0-1848-4436-ab69-80d01995f9b4"],
 " is the empty word, a word of degree ",
 Cell[BoxData[
  FormBox["0", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6581b2a6-bfe3-4c00-b051-89f23396b7b4"],
 " that the paper's positive-length convention does not have and the \
empty-word extension does."
}], "Notes",ExpressionUUID->"326e079b-965d-4ce9-926d-365e2c344006"],

Cell[TextData[{
 "A word displays as its letters in parentheses, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     StyleBox["x", "TI"], " ", 
     StyleBox["y", "TI"], " ", 
     StyleBox["y", "TI"]}], ")"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bd38610a-a69a-4880-9dae-f468be9cb7a7"],
 ", and the empty word as ",
 Cell[BoxData[
  FormBox["\[Epsilon]", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "73d66785-19f5-4265-adec-869bb1e7485a"],
 ". A letter that is not a symbol is set in its own parentheses, so \
juxtaposition always says where one letter ends and the next begins. The \
displayed form is the word itself: copying it back into an input cell gives \
the same expression, and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InputForm"]], "paclet:ref/InputForm"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "13525d75-ccc5-46b5-9e76-66340eae41dd"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["OutputForm"]], "paclet:ref/OutputForm"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "87e48a17-1033-4a57-b4dd-37c65e3b6043"],
 " are untouched."
}], "Notes",ExpressionUUID->"211f7ce6-6aaa-4318-8cc7-5fa3e033f243"],

