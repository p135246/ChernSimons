Cell["Rotating a word into canonical form:", "ExampleText",ExpressionUUID->"f3c95f99-d250-4e40-aa84-ef15a95b08b2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"CyclicWord", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"y", ",", " ", "x"}], "}"}], ",", " ", 
   RowBox[{"GradedPairing", "[", 
    RowBox[{
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"x", " ", "->", " ", 
        RowBox[{"-", "1"}]}], ",", " ", 
       RowBox[{"y", " ", "->", " ", "0"}]}], "|>"}], ",", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "y"}], "}"}], " ", "->", " ", "1"}], "|>"}]}], 
    "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"4193d96b-3233-43db-9822-e43f2c856df0"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"(", 
   RowBox[{"x", "\[ThinSpace]", "y"}], ")"}],
  ChernSimons`CyclicWord[{MTNB$d03ujeim6c4o`x, MTNB$d03ujeim6c4o`y}],
  Editable->False]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"9dc87996-6af8-4797-9990-45abfdafd169"]
}, Open  ]],

