Cell["Two rotations of one word normalize to the same word:", "ExampleText",ExpressionUUID->"c840aa2e-6d7e-4432-92b9-6291b67d20b2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"CyclicWord", "[", 
