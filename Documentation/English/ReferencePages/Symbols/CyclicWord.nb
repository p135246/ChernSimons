Cell["Rotating a word into canonical form:", "ExampleText",ExpressionUUID->"dff07970-181e-4401-abc5-a471192ce3a1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"CyclicWord", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"y", ",", " ", "x"}], "}"}], ",", " ", 
   RowBox[{"GradedPairing", "[", 
    RowBox[{
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"x", " ", "->", " ", 
        RowBox[{"-", "1"}]}], ",", " ", 
       RowBox[{"y", " ", "->", " ", "0"}]}], "|>"}], ",", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "y"}], "}"}], " ", "->", " ", "1"}], "|>"}]}], 
    "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"f240d8f5-be41-4c56-9bb4-cc250ae2b5cb"],

