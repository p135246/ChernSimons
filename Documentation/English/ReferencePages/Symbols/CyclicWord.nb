    RowBox[{"{", 
     RowBox[{"y", ",", " ", "x"}], "}"}], ",", " ", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"x", " ", "->", " ", 
       RowBox[{"-", "1"}]}], ",", " ", 
      RowBox[{"y", " ", "->", " ", "0"}]}], "|>"}]}], "]"}], " ", "===", " ", 
  
  RowBox[{"CyclicWord", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"x", ",", " ", "y"}], "}"}], ",", " ", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"x", " ", "->", " ", 
       RowBox[{"-", "1"}]}], ",", " ", 
      RowBox[{"y", " ", "->", " ", "0"}]}], "|>"}]}], "]"}]}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"cbc6dcc8-d9fc-4397-93b2-0403a3d75eec"],

