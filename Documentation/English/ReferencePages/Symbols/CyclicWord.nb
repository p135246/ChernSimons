Cell["Rotating a word into canonical form:", "ExampleText",ExpressionUUID->"84e36223-b531-4d9f-851c-a171869440ef"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"CyclicWord", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"y", ",", " ", "x"}], "}"}], ",", " ", 
   RowBox[{"GradedPairing", "[", 
    RowBox[{
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"x", " ", "->", " ", 
        RowBox[{"-", "1"}]}], ",", " ", 
       RowBox[{"y", " ", "->", " ", "0"}]}], "|>"}], ",", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "y"}], "}"}], " ", "->", " ", "1"}], "|>"}]}], 
    "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"3b78d063-06a8-4b00-a69b-d9f9b2fca2c7"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"(", 
   RowBox[{"x", "\[ThinSpace]", "y"}], ")"}],
  ChernSimons`CyclicWord[{MTNB$17rwrvivyzmah`x, MTNB$17rwrvivyzmah`y}],
  Editable->False]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"4ef55795-eba2-46dc-afbb-bac803120aff"]
}, Open  ]],

