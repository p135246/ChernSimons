 "\[LineSeparator]",
 "is the cyclic word whose particles are the list ",
 StyleBox["w", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"f2a7c2e5-1017-4093-9981-84db9a359f8e"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["CyclicWord"]], "paclet:ChernSimons/ref/CyclicWord", 
     "ChernSimons Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
