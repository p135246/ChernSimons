 "."
}], "Notes",ExpressionUUID->"5ec2b5cc-0d71-4f10-ba1a-00fcec2b46f2"],

Cell[TextData[{
 "A word displays as its letters in parentheses, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     StyleBox["x", "TI"], " ", 
     StyleBox["y", "TI"], " ", 
     StyleBox["y", "TI"]}], ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"828ebd65-fad4-424f-a70d-03d97a63ea02"],
