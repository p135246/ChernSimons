       RowBox[{"<|", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"x", ",", " ", "y"}], "}"}], " ", "->", " ", "1"}], 
        "|>"}]}], "]"}], ",", " ", 
     RowBox[{"\"\<Convention\>\"", " ", "->", " ", "\"\<Exterior\>\""}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{"Jacobi", "[", 
  RowBox[{
   RowBox[{"CyclicWord", "[", 
    RowBox[{"{", "x", "}"}], "]"}], ",", " ", 
   RowBox[{"CyclicWord", "[", 
    RowBox[{"{", 
     RowBox[{"x", ",", " ", "y"}], "}"}], "]"}], ",", " ", 
   RowBox[{"CyclicWord", "[", 
    RowBox[{"{", 
     RowBox[{"y", ",", " ", "y"}], "}"}], "]"}], ",", " ", "exterior"}], 
  "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"ab0293a6-7328-451b-901f-8003617f6804"],

