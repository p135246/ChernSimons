Cell[CellGroupData[{
Cell["Jacobi", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"dcaaa52e-6184-43eb-aab6-44c10b3f386a"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["Jacobi"]], "paclet:IBLInfinity/ref/Jacobi", 
     "IBLInfinity Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["u", "TI"], ",", " ", 
    StyleBox["v", "TI"], ",", " ", 
    StyleBox["w", "TI"], ",", " ", 
    StyleBox["pairing", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "146f44c4-94fc-407c-ad3e-747abf066fb1"],
 "\[LineSeparator]",
 "gives the Jacobi obstruction of three cyclic words; ",
 Cell[BoxData["0"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "88004288-5e6b-4883-b998-b05b295da319"],
 " means the identity holds there.",
 "\n"
}], "Usage",ExpressionUUID->"d34d4bf6-2229-458d-a032-af7189346582"],

Cell[TextData[{
 "The obstruction is the composite ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    OverscriptBox[
     StyleBox["q", "TI"], "^"], 
    RowBox[{"2", ",", "1", ",", "0"}]], "\[SmallCircle]", 
   SubscriptBox[
    OverscriptBox[
     StyleBox["q", "TI"], "^"], 
    RowBox[{"2", ",", "1", ",", "0"}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bdba18cb-79e6-4169-8ca0-35abde28675f"],
 " applied to the product ",
 Cell[BoxData[
  RowBox[{
   StyleBox["u", "TI"], "\[CircleDot]", 
   StyleBox["v", "TI"], "\[CircleDot]", 
   StyleBox["w", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8b085eee-292f-4c51-9a70-127f796ccbc4"],
 " \[LongDash] the graded Jacobi identity written as the statement that the \
derivation extension of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Bracket"]], "paclet:IBLInfinity/ref/Bracket", 
    "IBLInfinity Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "42818202-b1f1-4230-b821-1dfe8eafd35f"],
 " squares to zero."
}], "Notes",ExpressionUUID->"f42ace57-7813-4934-b91e-749c9e9e784b"],

Cell[TextData[{
 "The convention key of ",
 StyleBox["pairing", "TI"],
 " selects the picture, exactly as it does for ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Bracket"]], "paclet:IBLInfinity/ref/Bracket", 
    "IBLInfinity Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "92efc7f9-a02e-4459-8bcf-495d7f214806"],
 "."
}], "Notes",ExpressionUUID->"4d7566f9-40f2-47a3-ac5e-fddac034cd12"],

Cell["\<\
A nonzero value is a counterexample to the identity for that pairing, not a \
bug in the input: the identity is a property of the pairing, and this \
function is how it is tested.\
\>", "Notes",ExpressionUUID->"6282a5c4-2c67-48a4-a45e-32a86f40bfe8"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Jacobi"]], "paclet:IBLInfinity/ref/Jacobi", 
    "IBLInfinity Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "001955f0-e969-445b-b0fa-71898f953e78"],
 " is the arity-",
 Cell[BoxData["3"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3106f587-ca38-4dfd-9a51-929287d9ffab"],
 " entry of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["$Relations"]], "paclet:IBLInfinity/ref/$Relations", 
    "IBLInfinity Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "5a543503-cf3e-47a9-a1e2-8aba761c7d47"],
 "; ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RelationFailures"]], "paclet:IBLInfinity/ref/RelationFailures",
     "IBLInfinity Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "d983e7cd-8300-4612-b4d5-a5b889ce1d76"],
 " sweeps it over an enumerated range of words rather than one triple at a \
time."
}], "Notes",ExpressionUUID->"4f14d37c-d623-4f0b-8b42-efeefb3fd67f"]
}, Open  ]],

