Notebook[{

Cell[CellGroupData[{
Cell["CanonicalMaurerCartan", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"a735659a-67a4-4a94-867f-5a7e4059b7c0"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["CanonicalMaurerCartan"]], 
     "paclet:ChernSimons/ref/CanonicalMaurerCartan", 
     "ChernSimons Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["pairing", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "64ba65b5-132b-47ad-bcf1-c29e9b9af6a8"],
 "\[LineSeparator]",
 "is the canonical Maurer-Cartan element of the dIBL algebra of a Poincar\
\[EAcute] duality algebra.",
 "\n"
}], "Usage",ExpressionUUID->"a51996e6-aeeb-40b4-b07f-0dd8e6d92062"],

Cell[TextData[{
 "The triple product of a Poincar\[EAcute] duality algebra ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     StyleBox["H", "TI"], ",", 
     StyleBox["O", "TI"]}], ")"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "147fa9ea-948f-4013-9a8e-0b2d547d8666"],
 " of degree ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "80ae55a4-7210-47d2-94ce-3bc8bebd9e14"],
 " is a cyclic three-cochain on ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["H", "TI"], 
    RowBox[{"[", "1", "]"}]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ec5e79c3-7a49-4fac-9d24-cff10555c630"],
 ", hence an element of the cyclic words of length three. In a basis ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    SubscriptBox[
     StyleBox["e", "TI"], 
     StyleBox["i", "TI"]], ")"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "26f4d7cf-8123-40db-bbb3-09f16052b0a0"],
 " it reads"
}], "Notes",ExpressionUUID->"c4c0457a-c7de-4adb-8190-3c54700bacda"],

Cell[BoxData[
 PaneBox[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["m", "TI"], 
     RowBox[{"1", ",", "0"}], 
     StyleBox["can",
      FontSlant->"Plain"]], "\[LongEqual]", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"-", "1"}], ")"}], 
     RowBox[{
      StyleBox["n", "TI"], "-", "2"}]], 
    FractionBox["1", "3"], 
    UnderscriptBox["\[Sum]", 
     RowBox[{
      StyleBox["i", "TI"], ",", 
      StyleBox["j", "TI"], ",", 
      StyleBox["k", "TI"]}],
     LimitsPositioning->True], 
    RowBox[{"\[PlusMinus]", " "}], 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"-", "1"}], ")"}], 
     RowBox[{"deg", 
      SubscriptBox[
       StyleBox["e", "TI"], 
       StyleBox["j", "TI"]]}]], " ", 
    StyleBox["O", "TI"], 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox[
       StyleBox["e", "TI"], 
       StyleBox["i", "TI"]], "\[CenterDot]", 
      SubscriptBox[
       StyleBox["e", "TI"], 
       StyleBox["j", "TI"]], "\[CenterDot]", 
      SubscriptBox[
       StyleBox["e", "TI"], 
       StyleBox["k", "TI"]]}], ")"}], " ", 
    SuperscriptBox[
     StyleBox["e", "TI"], 
     StyleBox["i", "TI"]], 
    SuperscriptBox[
     StyleBox["e", "TI"], 
     StyleBox["j", "TI"]], 
    SuperscriptBox[
     StyleBox["e", "TI"], 
     StyleBox["k", "TI"]], ","}],
   TraditionalForm],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",ExpressionUUID->"dd29d17b-f254-431a-\
b198-f8290f4faf2d"],

Cell[TextData[{
 "with ",
 Cell[BoxData[
  FormBox["\[PlusMinus]", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fa99df7f-35e6-49f4-b50b-a7c97af7fa8c"],
 " the reversal sign ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"-", "1"}], ")"}], 
    TemplateBox[{
      RowBox[{
        SuperscriptBox[
         StyleBox["e", "TI"], 
         StyleBox["k", "TI"]], "|", 
        RowBox[{
          RowBox[{"(", 
            TemplateBox[{
              RowBox[{
                SuperscriptBox[
                 StyleBox["e", "TI"], 
                 StyleBox["i", "TI"]], "|", "+", "|", 
                SuperscriptBox[
                 StyleBox["e", "TI"], 
                 StyleBox["j", "TI"]]}]}, "Abs"], ")"}], "+"}], "|", 
        RowBox[{
          SuperscriptBox[
           StyleBox["e", "TI"], 
           StyleBox["j", "TI"]], "||", 
          SuperscriptBox[
           StyleBox["e", "TI"], 
           StyleBox["i", "TI"]]}]}]},
     "Abs"]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "992d94b6-2be4-458c-b672-bdb0ca99e069"],
 ". The summand is invariant under cyclic rotation, so each cyclic word is \
produced three times and the ",
 Cell[BoxData[
  FormBox[
   FractionBox["1", "3"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e4be3a57-d71e-4cd7-be50-2353f6feba9f"],
 " is exact."
}], "Notes",ExpressionUUID->"b75b4da0-20d4-4943-bab5-e4f2aa1e65fb"],

Cell[TextData[{
 StyleBox["pairing", "TI"],
 " must carry an ",
 Cell[BoxData["\"\<Algebra\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b69f23e7-7112-4713-855f-26a98e36de83"],
 " key, which ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["GradedPairing"]], "paclet:ChernSimons/ref/GradedPairing", 
     "ChernSimons Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["algebra", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c3f09a8b-ed50-4220-a8ae-64de51ba9739"],
 " supplies; without one the function issues ",
 Cell[BoxData[
  RowBox[{"GradedPairing", "::", "algebra"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dbb10289-0fb1-43c8-83fe-4b02a9125ef3"],
 " and aborts."
}], "Notes",ExpressionUUID->"ea798436-af45-4fcb-ae46-a171e0fac817"],

Cell[TextData[{
 "This is the first recipe in the paclet that ",
 StyleBox["produces", "TI"],
 " a Maurer-Cartan element rather than taking one as given. The geometric \
recipe \[LongDash] ribbon graphs, their combinatorial coefficients and the \
configuration-space integrals \[LongDash] is still not implemented; what is \
implemented is the algebraic element of a Poincar\[EAcute] duality algebra."
}], "Notes",ExpressionUUID->"5499f0a6-7c97-4ec0-9062-84cbd4910e75"],

Cell[TextData[{
 "The element carries only the product. When the algebra has a nonzero \
differential the canonical dIBL structure of a cyclic cochain complex carries \
it in ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["q", "TI"], 
    RowBox[{"1", ",", "1", ",", "0"}]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "acf4b155-45bc-40ef-afb6-a31e315c9bd4"],
 ", which the engine does not have; see ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["NondegenerateQuotient"]], 
    "paclet:ChernSimons/ref/NondegenerateQuotient", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "c4b303e7-1506-42cd-95ad-cf070366f927"],
 "."
}], "Notes",ExpressionUUID->"f6baa457-73e9-49e7-b5f4-55cfebbbfe07"]
}, Open  ]],

