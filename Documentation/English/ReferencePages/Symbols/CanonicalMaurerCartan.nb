   "fe922ed2-9dc3-4722-a658-645e6182b8ed"],
  $Line = 0; Null]], "ExampleDelimiter",ExpressionUUID->"e4a1471c-fd4a-4f09-\
8253-fa38fc66def9"],

Cell["\<\
It solves the Maurer-Cartan equation for every model in the catalogue, \
including the two whose quotient carries a differential:\
\>", "ExampleText",ExpressionUUID->"e64a2bec-a548-43ac-ae48-de6b684ca5fd"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Map", "[", 
  RowBox[{
   RowBox[{"name", " ", "|->", " ", 
    RowBox[{"name", " ", "->", " ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"pr", " ", "=", " ", 
         RowBox[{"GradedPairing", "[", 
          RowBox[{"NondegenerateQuotient", "[", 
           RowBox[{"SullivanModel", "[", "name", "]"}], "]"}], "]"}]}], "}"}],
        ",", "\n", "    ", 
       RowBox[{"MaurerCartanQ", "[", 
        RowBox[{
         RowBox[{"CanonicalMaurerCartan", "[", "pr", "]"}], ",", " ", "pr"}], 
        "]"}]}], "]"}]}]}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\"\<Sphere\>\"", "[", "3", "]"}], ",", " ", 
     RowBox[{"\"\<ComplexProjectiveSpace\>\"", "[", "3", "]"}], ",", " ", 
     RowBox[{"\"\<QuaternionicProjectiveSpace\>\"", "[", "2", "]"}], ",", 
     "\n", "   ", 
     RowBox[{"\"\<Torus\>\"", "[", "3", "]"}], ",", " ", 
     RowBox[{"\"\<SpecialUnitaryGroup\>\"", "[", "3", "]"}], ",", 
     " ", "\"\<HeisenbergNilmanifold\>\"", ",", 
     " ", "\"\<KodairaThurston\>\""}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"20ca9e27-064c-4093-baab-70982832221b"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    RowBox[{"\<\"Sphere\"\>", "[", "3", "]"}], "\[Rule]", "True"}], ",", 
   RowBox[{
    RowBox[{"\<\"ComplexProjectiveSpace\"\>", "[", "3", "]"}], "\[Rule]", 
    "True"}], ",", 
   RowBox[{
    RowBox[{"\<\"QuaternionicProjectiveSpace\"\>", "[", "2", "]"}], "\[Rule]",
     "True"}], ",", 
   RowBox[{
    RowBox[{"\<\"Torus\"\>", "[", "3", "]"}], "\[Rule]", "True"}], ",", 
   RowBox[{
    RowBox[{"\<\"SpecialUnitaryGroup\"\>", "[", "3", "]"}], "\[Rule]", 
    "True"}], ",", 
   RowBox[{"\<\"HeisenbergNilmanifold\"\>", "\[Rule]", "True"}], ",", 
   RowBox[{"\<\"KodairaThurston\"\>", "\[Rule]", "True"}]}], "}"}]], "Output",\

 CellLabel->"Out[1]= ",ExpressionUUID->"da2720d6-5786-4754-85b6-170a2883dae6"]
}, Open  ]]
}, Open  ]]
}, Open  ]],

