Cell["The canonical element of the circle:", "ExampleText",ExpressionUUID->"02b36556-19d0-4ccd-b91b-3c560c45691c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"m", " ", "=", " ", 
  RowBox[{"CanonicalMaurerCartan", "[", 
   RowBox[{"GradedPairing", "[", 
    RowBox[{
     RowBox[{"NondegenerateQuotient", "[", 
      RowBox[{"SullivanModel", "[", "\"\<Circle\>\"", "]"}], "]"}], ",", " ", 
     
     RowBox[{"{", 
      RowBox[{"x", ",", " ", "y"}], "}"}]}], "]"}], "]"}]}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"8d303751-204f-4855-b579-52f7b76e6a92"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{
   TagBox["MaurerCartanElement",
    "SummaryHead"], "[", 
   DynamicModuleBox[{Typeset`open$$ = False, Typeset`embedState$$ = "Ready"}, 
    
    TemplateBox[{
      PaneSelectorBox[{False -> GridBox[{{
            PaneBox[
             ButtonBox[
              DynamicBox[
               FEPrivate`FrontEndResource["FEBitmaps", "SummaryBoxOpener"]], 
              ButtonFunction :> (Typeset`open$$ = True), Appearance -> None, 
              BaseStyle -> {}, Evaluator -> Automatic, Method -> 
              "Preemptive"], Alignment -> {Center, Center}, ImageSize -> 
             Dynamic[{
               Automatic, 
                3.5 (CurrentValue["FontCapHeight"]/AbsoluteCurrentValue[
                 Magnification])}]], 
            GraphicsBox[{{
               GrayLevel[0.35], 
               AbsoluteThickness[1.1], 
               CapForm["Round"]}, 
              CircleBox[{0, 0}, 1], 
              LineBox[{{0, 0.62}, {-0.54, -0.31}, {0.54, -0.31}, {0, 0.62}}], 
              
              DiskBox[{0, 0.62}, 0.13], 
              DiskBox[{-0.54, -0.31}, 0.13], 
              DiskBox[{0.54, -0.31}, 0.13]}, ImageSize -> {Automatic, 22}, 
             PlotRange -> 1.2, Background -> None], 
            GridBox[{{
               RowBox[{
                 TagBox["\"parts: \"", "SummaryItemAnnotation"], 
                 "\[InvisibleSpace]", 
                 TagBox[
                  TemplateBox[{", ", "\", \"", 
                    SubscriptBox["\"m\"", 
                    
                    TemplateBox[{",", "\",\"", "1", "0"}, 
                    "RowWithSeparators"]]}, "RowWithSeparators"], 
                  "SummaryItem"]}]}, {
               RowBox[{
                 TagBox["\"alphabet: \"", "SummaryItemAnnotation"], 
                 "\[InvisibleSpace]", 
                 TagBox[
                  
                  TemplateBox[{", ", "\", \"", "x", "y"}, 
