Cell[TextData[{
 "It solves the Maurer-Cartan equation. On a word of length three the \
equation reduces to ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["q", "TI"], 
     RowBox[{"2", ",", "1", ",", "0"}]], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["m", "TI"], "\[CircleDot]", 
      StyleBox["m", "TI"]}], ")"}], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9bc5600c-fcc8-41df-9af6-3dfa2fab8f84"],
 ", which is associativity in these coordinates."
}], "ExampleText",ExpressionUUID->"a7429c2e-adab-47d6-92d3-8d52de2c69e2"],

