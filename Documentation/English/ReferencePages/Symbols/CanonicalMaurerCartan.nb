Cell[TextData[{
 "It solves the Maurer-Cartan equation; on a word of length three the \
equation reduces to ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["q", "TI"], 
     RowBox[{"2", ",", "1", ",", "0"}]], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["m", "TI"], "\[CircleDot]", 
      StyleBox["m", "TI"]}], ")"}], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"3e2e4faa-53b3-485e-b23b-ec961be656c9"],
 ", which is associativity in these coordinates:"
}], "ExampleText",ExpressionUUID->"07883a2f-9af2-4721-9e1e-4169dde17f4e"],

