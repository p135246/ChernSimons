a83b-49c8ef475b35"],

Cell[TextData[{
 "Twisting ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["q", "TI"], 
    RowBox[{"2", ",", "1", ",", "0"}]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "02191335-0820-42e8-b2f0-c60a18db2bae"],
 " by it gives the dual of the cyclic Hochschild differential. On the circle \
that operator inserts one letter ",
 Cell[BoxData[
  FormBox[
   StyleBox["x", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "90ae6640-33dc-45e7-acf9-5d98be2246d7"],
 ", and vanishes on a word with an even number of them:"
}], "ExampleText",ExpressionUUID->"bc7abf6e-656d-408e-92b0-6726ea28100e"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"pairing", " ", "=", " ", 
   RowBox[{"GradedPairing", "[", 
    RowBox[{
     RowBox[{"NondegenerateQuotient", "[", 
      RowBox[{"SullivanModel", "[", "\"\<Circle\>\"", "]"}], "]"}], ",", " ", 
     
     RowBox[{"{", 
      RowBox[{"x", ",", " ", "y"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"m", " ", "=", " ", 
   RowBox[{"CanonicalMaurerCartan", "[", "pairing", "]"}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"TwistedDifferential", "[", 
    RowBox[{"m", ",", " ", 
     RowBox[{"CyclicWord", "[", 
      RowBox[{"{", 
       RowBox[{"x", ",", " ", "y", ",", " ", "y"}], "}"}], "]"}], ",", " ", 
     "pairing"}], "]"}], ",", "\n", " ", 
   RowBox[{"TwistedDifferential", "[", 
    RowBox[{"m", ",", " ", 
     RowBox[{"CyclicWord", "[", 
      RowBox[{"{", 
       RowBox[{"x", ",", " ", "x", ",", " ", "y"}], "}"}], "]"}], ",", " ", 
     "pairing"}], "]"}]}], "}"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"12e4c29a-d891-40dc-94a2-6d685b40de9e"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   InterpretationBox[
    RowBox[{"(", 
     RowBox[{
     "x", "\[ThinSpace]", "x", "\[ThinSpace]", "y", "\[ThinSpace]", "y"}], 
     ")"}],
    ChernSimons`CyclicWord[{
     MTNB$17ezkdnjv7hcl`x, MTNB$17ezkdnjv7hcl`x, MTNB$17ezkdnjv7hcl`y, 
      MTNB$17ezkdnjv7hcl`y}],
    Editable->False], ",", "0"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"448d02fe-e2a9-4a45-a2a2-ad2f045fe4f2"]
}, Open  ]]
}, Open  ]]
}, Open  ]],

