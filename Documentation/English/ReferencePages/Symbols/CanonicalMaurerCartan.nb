Cell[TextData[{
 "A pairing object built from degrees and values carries no algebra, so there \
is no triple product to read, and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CanonicalMaurerCartan"]], 
    "paclet:ChernSimons/ref/CanonicalMaurerCartan", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "99316af9-3fec-430f-bf56-539738f6e500"],
 " aborts on it with ",
 Cell[BoxData[
  RowBox[{"GradedPairing", "::", "algebra"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7683a9a0-e0ee-4444-a059-6a54547634d4"],
 ". Check for the key before evaluating."
}], "ExampleText",ExpressionUUID->"b50e33c8-5c16-4c0b-b1bf-4ace941777b7"],

