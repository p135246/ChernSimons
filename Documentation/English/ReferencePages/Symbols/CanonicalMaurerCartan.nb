Cell[CellGroupData[{
Cell["CanonicalMaurerCartan", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"64efa3d4-8359-4800-a232-0c505f8f1879"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["CanonicalMaurerCartan"]], 
     "paclet:ChernSimons/ref/CanonicalMaurerCartan", 
     "ChernSimons Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["pairing", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "c4e08792-e1ae-41a8-a9a6-7d6e663ee0db"],
 "\[LineSeparator]",
 "gives the canonical Maurer-Cartan element of the Poincar\[EAcute] duality \
algebra that ",
 StyleBox["pairing", "TI"],
 " carries, a ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["MaurerCartanElement"]], 
    "paclet:ChernSimons/ref/MaurerCartanElement", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "a9014bba-044e-427e-9259-e123f35f4bfa"],
 " with the one part ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["m", "TI"], 
    RowBox[{"1", ",", "0"}]], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"b9649849-ad5f-4cef-9543-6e5e657c70f6"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"40eceefa-e1a5-4282-a02e-a41c8f028548"],

Cell[TextData[{
 "The triple product of a Poincar\[EAcute] duality algebra ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     StyleBox["H", "TI"], ",", 
     StyleBox["O", "TI"]}], ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"a6c92f47-6538-4ac8-859c-0811f088685c"],
 " of degree ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "eb31d703-a4d3-4d85-93c7-9ee87a07c41a"],
 " is a cyclic three-cochain on ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["H", "TI"], 
    RowBox[{"[", "1", "]"}]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"8423b605-6ed8-4d08-be66-26e9714a9208"],
 ", hence an element of the cyclic words of length three."
}], "Notes",
 CellFrameLabels->{{Inherited, Inherited}, {Inherited, 
    Cell[
     TextData[{
      "26.09.30: Design review - the function reads everything off the \
pairing object: the degrees of the letters from the pairing, and the degree n \
and the \"Triple\" key from its \"Algebra\" key, which GradedPairing[algebra] \
supplies, so the element is built over whatever letter names the pairing \
gives. On a pairing without an algebra it returns unevaluated; before R3 it \
issued GradedPairing::algebra and aborted the whole evaluation, and the \
message is gone. Since R5d it gives a MaurerCartanElement with the one part \
m_{1,0} rather than a bare BD action, and since R5c it lives in the \
ChernSimons part beside GradedPairing[algebra], so that ChernSimons reads the \
PoincareDualityAlgebra of the algebraic models and the dependency runs one \
way. It is the one function of the paclet that produces a Maurer-Cartan \
element rather than taking one as given; the geometric element, with ribbon \
graphs and configuration-space integrals, is not implemented. Prior art: the \
Wolfram Language has no Poincare duality algebras or cyclic words; the engine \
the verification suites load computes the element as pdCanonicalMC, and \
T17/canonical-element-is-the-engine-element pins this function against it \
over the catalogue and Kodaira-Thurston, with the words brought to the \
paclet's canonical rotation. No alternative interface was recorded.", "\n\n", 
       
       Cell[
        BoxData[
         GridBox[{{
            Cell[
             BoxData[
              ButtonBox[
               DynamicBox[
                FEPrivate`FrontEndResource[
                "DocumentationToolsStrings", "Edit"]], BaseStyle -> 
               "TextAnnotationButton"]]], 
            StyleBox[
             RowBox[{
               DynamicBox[
                FEPrivate`FrontEndResource[
                "DocumentationToolsStrings", "LastAnnotator"]], "pavel"}], 
             "TextAnnotator"], 
            Cell[
             BoxData[
              ButtonBox[
               DynamicBox[
                FEPrivate`FrontEndResource[
                "DocumentationToolsStrings", "Delete"]], BaseStyle -> 
               "TextAnnotationRemoveButton"]]], ""}}, 
          GridBoxAlignment -> {
           "Columns" -> {Left, Left, Right, Right}, "Rows" -> {{Automatic}}}, 
          GridBoxItemSize -> {"Columns" -> {
              Scaled[0.15], 
              Scaled[0.68], 
              Scaled[0.15], 
              Scaled[0.02]}}]]], "\n"}], "TextAnnotation", 
     CellSize -> {590, Inherited}]}},
 CellTags->"TextAnnotation",
 CellID->954819853,ExpressionUUID->"7f75af0c-0f13-41a0-9a52-817f19bd696c"],

Cell[TextData[{
 "In a basis ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    SubscriptBox[
     StyleBox["e", "TI"], 
     StyleBox["i", "TI"]], ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"1c760d7f-2fdd-49e6-95cb-028faeb0d4cb"],
 " the element is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["m", "TI"], 
     RowBox[{"1", ",", "0"}], 
     StyleBox["can",
      FontSlant->"Plain"]], "\[LongEqual]", 
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"-", "1"}], ")"}], 
      RowBox[{
       StyleBox["n", "TI"], "-", "2"}]], 
     FractionBox["1", "3"], 
     RowBox[{
      UnderscriptBox["\[Sum]", 
       RowBox[{
        StyleBox["i", "TI"], ",", 
        StyleBox["j", "TI"], ",", 
        StyleBox["k", "TI"]}],
       LimitsPositioning->True], 
      RowBox[{
       RowBox[{"\[PlusMinus]", " ", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"-", "1"}], ")"}], 
         RowBox[{"deg", 
          SubscriptBox[
           StyleBox["e", "TI"], 
           StyleBox["j", "TI"]]}]]}], " ", 
       StyleBox["O", "TI"], 
       RowBox[{"(", 
        RowBox[{
         SubscriptBox[
          StyleBox["e", "TI"], 
          StyleBox["i", "TI"]], "\[CenterDot]", 
         SubscriptBox[
          StyleBox["e", "TI"], 
          StyleBox["j", "TI"]], "\[CenterDot]", 
         SubscriptBox[
          StyleBox["e", "TI"], 
          StyleBox["k", "TI"]]}], ")"}], " ", 
       SuperscriptBox[
        StyleBox["e", "TI"], 
        StyleBox["i", "TI"]], 
       SuperscriptBox[
        StyleBox["e", "TI"], 
        StyleBox["j", "TI"]], 
       SuperscriptBox[
        StyleBox["e", "TI"], 
        StyleBox["k", "TI"]]}]}]}]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"bad62386-4be4-4b66-8cb7-023c23a75c39"],
 ", with ",
 Cell[BoxData[
  FormBox["\[PlusMinus]", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "51d93aff-2ec2-481d-a74e-39c6de4a2613"],
 " the reversal sign ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"-", "1"}], ")"}], 
    TemplateBox[{
      RowBox[{
        SuperscriptBox[
         StyleBox["e", "TI"], 
         StyleBox["k", "TI"]], "|", 
        RowBox[{
          RowBox[{"(", 
            TemplateBox[{
              RowBox[{
                SuperscriptBox[
                 StyleBox["e", "TI"], 
                 StyleBox["i", "TI"]], "|", "+", "|", 
                SuperscriptBox[
                 StyleBox["e", "TI"], 
                 StyleBox["j", "TI"]]}]}, "Abs"], ")"}], "+"}], "|", 
        RowBox[{
          SuperscriptBox[
           StyleBox["e", "TI"], 
           StyleBox["j", "TI"]], "||", 
          SuperscriptBox[
           StyleBox["e", "TI"], 
           StyleBox["i", "TI"]]}]}]},
     "Abs"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "bbafb8f7-60a9-4bd5-a1c5-5fe69d43efba"],
 "."
}], "Notes",ExpressionUUID->"52198bad-0c21-4a25-9680-c60080196680"],

Cell[TextData[{
 "In the degrees ",
 Cell[BoxData[
  FormBox[
   StyleBox["a", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "4faab52f-5625-4ec1-89fa-4ce16e2bd50b"],
 ", ",
 Cell[BoxData[
  FormBox[
   StyleBox["b", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "c1099e72-b2ef-4ea4-906c-63c00d1031f3"],
 ", ",
 Cell[BoxData[
  FormBox[
   StyleBox["c", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "ddd410e4-8c4b-49bf-9cd3-1a1e805ca294"],
 " of the three letters the sign of a summand is ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"-", "1"}], ")"}], 
    RowBox[{
     StyleBox["n", "TI"], "-", "1", "+", 
     StyleBox["b", "TI"], "+", 
     StyleBox["a", "TI"], 
     StyleBox["b", "TI"], "+", 
     StyleBox["b", "TI"], 
     StyleBox["c", "TI"], "+", 
     StyleBox["c", "TI"], 
     StyleBox["a", "TI"]}]], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"5bf3c931-76c5-4495-b7cf-a6170d4b83d7"],
 "."
}], "Notes",ExpressionUUID->"beb0b2b6-2886-4f07-ae43-241c138b150f"],

Cell[TextData[{
 "The summand is invariant under cyclic rotation. A cyclic word with three \
distinct rotations is produced three times and has the full coefficient; a \
word ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["e", "TI"], 
     StyleBox["i", "TI"]], 
    SuperscriptBox[
     StyleBox["e", "TI"], 
     StyleBox["i", "TI"]], 
    SuperscriptBox[
     StyleBox["e", "TI"], 
     StyleBox["i", "TI"]]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"a3eb8d09-db0f-4b38-9fd3-af8cf3f8c568"],
 " is produced once and keeps the factor ",
 Cell[BoxData[
  FormBox[
   FractionBox["1", "3"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "a1101b25-8186-441c-b4b0-011298aab169"],
 "."
}], "Notes",ExpressionUUID->"d0d5db70-9b5a-460b-a6c5-fe0a39f6ddce"],

Cell[TextData[{
 StyleBox["pairing", "TI"],
 " must carry an ",
 Cell[BoxData["\"\<Algebra\>\""], "InlineFormula",ExpressionUUID->
  "83fba335-f328-47ea-bc6d-9edf635f289a"],
 " key, which ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["GradedPairing"]], "paclet:ChernSimons/ref/GradedPairing", 
     "ChernSimons Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["algebra", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "013a978b-0239-4452-8edc-3d23b85a4003"],
 " supplies."
}], "Notes",ExpressionUUID->"9df1a789-2cae-4f0b-91f3-4cc4fc4a2878"],

Cell[TextData[{
 "The degrees of the letters are read off ",
 StyleBox["pairing", "TI"],
 ", and the degree ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "4e1ce6fe-03a4-4d3a-ba98-6ba27d54d6da"],
 " and the ",
 Cell[BoxData["\"\<Triple\>\""], "InlineFormula",ExpressionUUID->
  "899c8434-8919-4999-9857-78168d2088ac"],
 " key off the algebra."
}], "Notes",ExpressionUUID->"28077b69-711f-4337-9e11-458b9f444ae7"],

Cell[TextData[{
 "On a pairing without an algebra ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CanonicalMaurerCartan"]], 
    "paclet:ChernSimons/ref/CanonicalMaurerCartan", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "2ec1adf6-4b23-43cc-85bb-15863950de7c"],
 " returns unevaluated."
}], "Notes",ExpressionUUID->"b3288093-8819-4177-9253-8bf0babdafe9"],

Cell[TextData[{
 "The element carries only the product, in its part ",
 Cell[BoxData[
  RowBox[{
   StyleBox["m", "TI"], "[", 
   RowBox[{"{", 
    RowBox[{"1", ",", " ", "0"}], "}"}], "]"}]], "InlineFormula",
  ExpressionUUID->"bea09f85-62a6-46d3-8da8-c3a7ad2f35f1"],
 ", and it carries ",
 StyleBox["pairing", "TI"],
 "."
}], "Notes",ExpressionUUID->"371ec42e-4c31-40d9-870e-066d6c4a08d5"],

Cell[TextData[{
 "When the algebra has a nonzero differential, the canonical dIBL structure \
of a cyclic cochain complex carries it in ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["q", "TI"], 
    RowBox[{"1", ",", "1", ",", "0"}]], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"9b20f62e-dd9e-4e68-852b-fe967401b336"],
 ", which is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CyclicHochschildDifferential"]], 
    "paclet:ChernSimons/ref/CyclicHochschildDifferential", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "2ee3d682-5266-4b70-9b6d-360eed45e1dd"],
 "; see ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["NondegenerateQuotient"]], 
    "paclet:ChernSimons/ref/NondegenerateQuotient", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "ae24e88e-f848-40ed-8431-00bf9af15342"],
 "."
}], "Notes",ExpressionUUID->"d4221bab-b6ea-4e4d-a535-841eb098c026"],

Cell["\<\
The element is the algebraic one of a Poincar\[EAcute] duality algebra. The \
geometric element, with ribbon graphs, their combinatorial coefficients and \
the configuration-space integrals, is not computed.\
\>", "Notes",ExpressionUUID->"234ca60c-440d-46fb-a3a8-51e0a4000353"]
}, Open  ]],

