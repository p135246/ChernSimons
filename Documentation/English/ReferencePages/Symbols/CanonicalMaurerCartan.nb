Cell[CellGroupData[{
Cell["CanonicalMaurerCartan", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"a04933e7-2f15-408e-9e06-296ba0a6bf3e"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["CanonicalMaurerCartan"]], 
     "paclet:ChernSimons/ref/CanonicalMaurerCartan", 
     "ChernSimons Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["pairing", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "2e655a92-56a5-43dc-b432-b0a773c37cd8"],
 "\[LineSeparator]",
 "gives the canonical Maurer-Cartan element of the Poincar\[EAcute] duality \
algebra that ",
 StyleBox["pairing", "TI"],
 " carries, a ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["MaurerCartanElement"]], 
    "paclet:ChernSimons/ref/MaurerCartanElement", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "dd41b725-2575-4d99-aca5-37e3aafb7d24"],
 " with the one part ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["m", "TI"], 
    RowBox[{"1", ",", "0"}]], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"3980d98b-8642-4254-a3be-b3a008a436d2"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"d01bef40-ccd2-4889-887b-e9041acf910c"],

Cell[TextData[{
 "The triple product of a Poincar\[EAcute] duality algebra ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     StyleBox["H", "TI"], ",", 
     StyleBox["O", "TI"]}], ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"62e9146d-64a0-4dc5-bc1e-c86f9e91bfb7"],
 " of degree ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "ebe377c1-cf9b-40c9-b2ff-0972f4ba4ce4"],
 " is a cyclic three-cochain on ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["H", "TI"], 
    RowBox[{"[", "1", "]"}]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"aa8a575c-8415-4dcb-8f2f-1d86ec00b042"],
 ", hence an element of the cyclic words of length three."
}], "Notes",
 CellFrameLabels->{{Inherited, Inherited}, {Inherited, 
    Cell[
     TextData[{
      "26.09.30: Design review - the function reads everything off the \
pairing object: the degrees of the particles from the pairing, and the degree \
n and the \"Triple\" key from its \"Algebra\" key, which \
GradedPairing[algebra] supplies, so the element is built over whatever \
particle names the pairing gives. On a pairing without an algebra it returns \
unevaluated; before R3 it issued GradedPairing::algebra and aborted the whole \
evaluation, and the message is gone. Since R5d it gives a MaurerCartanElement \
with the one part m_{1,0} rather than a bare BD action, and since R5c it \
lives in the ChernSimons part beside GradedPairing[algebra], so that \
ChernSimons reads the PoincareDualityAlgebra of the algebraic models and the \
dependency runs one way. It is the one function of the paclet that produces a \
Maurer-Cartan element rather than taking one as given; the geometric element, \
with ribbon graphs and configuration-space integrals, is not implemented. \
Prior art: the Wolfram Language has no Poincare duality algebras or cyclic \
words; the engine the verification suites load computes the element as \
pdCanonicalMC, and T17/canonical-element-is-the-engine-element pins this \
function against it over the catalogue and Kodaira-Thurston, with the words \
brought to the paclet's canonical rotation. No alternative interface was \
recorded.", "\n\n", 
       Cell[
        BoxData[
         GridBox[{{
            Cell[
             BoxData[
              ButtonBox[
               DynamicBox[
                FEPrivate`FrontEndResource[
                "DocumentationToolsStrings", "Edit"]], BaseStyle -> 
               "TextAnnotationButton"]]], 
            StyleBox[
             RowBox[{
               DynamicBox[
                FEPrivate`FrontEndResource[
                "DocumentationToolsStrings", "LastAnnotator"]], "pavel"}], 
             "TextAnnotator"], 
            Cell[
             BoxData[
              ButtonBox[
               DynamicBox[
                FEPrivate`FrontEndResource[
                "DocumentationToolsStrings", "Delete"]], BaseStyle -> 
               "TextAnnotationRemoveButton"]]], ""}}, 
          GridBoxAlignment -> {
           "Columns" -> {Left, Left, Right, Right}, "Rows" -> {{Automatic}}}, 
          GridBoxItemSize -> {"Columns" -> {
              Scaled[0.15], 
              Scaled[0.68], 
              Scaled[0.15], 
              Scaled[0.02]}}]]], "\n"}], "TextAnnotation", 
     CellSize -> {590, Inherited}]}},
 CellTags->"TextAnnotation",
 CellID->761558465,ExpressionUUID->"722c8415-a7a2-478f-aa76-6bc6d98f5c31"],

Cell[TextData[{
 "In a basis ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    SubscriptBox[
     StyleBox["e", "TI"], 
     StyleBox["i", "TI"]], ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"954e9d32-c16d-4276-88e7-784182b8865f"],
 " the element is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["m", "TI"], 
     RowBox[{"1", ",", "0"}], 
     StyleBox["can",
      FontSlant->"Plain"]], "\[LongEqual]", 
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"-", "1"}], ")"}], 
      RowBox[{
       StyleBox["n", "TI"], "-", "2"}]], 
     FractionBox["1", "3"], 
     RowBox[{
      UnderscriptBox["\[Sum]", 
       RowBox[{
        StyleBox["i", "TI"], ",", 
        StyleBox["j", "TI"], ",", 
        StyleBox["k", "TI"]}],
       LimitsPositioning->True], 
      RowBox[{
       RowBox[{"\[PlusMinus]", " ", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"-", "1"}], ")"}], 
         RowBox[{"deg", 
          SubscriptBox[
           StyleBox["e", "TI"], 
           StyleBox["j", "TI"]]}]]}], " ", 
       StyleBox["O", "TI"], 
       RowBox[{"(", 
        RowBox[{
         SubscriptBox[
          StyleBox["e", "TI"], 
          StyleBox["i", "TI"]], "\[CenterDot]", 
         SubscriptBox[
          StyleBox["e", "TI"], 
          StyleBox["j", "TI"]], "\[CenterDot]", 
         SubscriptBox[
          StyleBox["e", "TI"], 
          StyleBox["k", "TI"]]}], ")"}], " ", 
       SuperscriptBox[
        StyleBox["e", "TI"], 
        StyleBox["i", "TI"]], 
       SuperscriptBox[
        StyleBox["e", "TI"], 
        StyleBox["j", "TI"]], 
       SuperscriptBox[
        StyleBox["e", "TI"], 
        StyleBox["k", "TI"]]}]}]}]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"ad1a39e0-7ff4-441c-8d3e-328f6a94674b"],
 ", with ",
 Cell[BoxData[
  FormBox["\[PlusMinus]", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "6005380b-8222-4ba9-a86c-015cd058d256"],
 " the reversal sign ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"-", "1"}], ")"}], 
    TemplateBox[{
      RowBox[{
        SuperscriptBox[
         StyleBox["e", "TI"], 
         StyleBox["k", "TI"]], "|", 
        RowBox[{
          RowBox[{"(", 
            TemplateBox[{
              RowBox[{
                SuperscriptBox[
                 StyleBox["e", "TI"], 
                 StyleBox["i", "TI"]], "|", "+", "|", 
                SuperscriptBox[
                 StyleBox["e", "TI"], 
                 StyleBox["j", "TI"]]}]}, "Abs"], ")"}], "+"}], "|", 
        RowBox[{
          SuperscriptBox[
           StyleBox["e", "TI"], 
           StyleBox["j", "TI"]], "||", 
          SuperscriptBox[
           StyleBox["e", "TI"], 
           StyleBox["i", "TI"]]}]}]},
     "Abs"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "9dbef202-3820-4d38-97d8-ac7fc2b2d564"],
 "."
}], "Notes",ExpressionUUID->"6212749c-4aa5-4506-a444-cfb83987ad78"],

Cell[TextData[{
 "In the degrees ",
 Cell[BoxData[
  FormBox[
   StyleBox["a", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "12edf319-2be0-4b50-b17f-c3fb3db3a64d"],
 ", ",
 Cell[BoxData[
  FormBox[
   StyleBox["b", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "43632b0c-3217-462b-83b1-8db79c1238fb"],
 ", ",
 Cell[BoxData[
  FormBox[
   StyleBox["c", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "fc560472-a73b-494f-a9a1-f7e921adf044"],
 " of the three particles the sign of a summand is ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"-", "1"}], ")"}], 
    RowBox[{
     StyleBox["n", "TI"], "-", "1", "+", 
     StyleBox["b", "TI"], "+", 
     StyleBox["a", "TI"], 
     StyleBox["b", "TI"], "+", 
     StyleBox["b", "TI"], 
     StyleBox["c", "TI"], "+", 
     StyleBox["c", "TI"], 
     StyleBox["a", "TI"]}]], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"2abffc6f-21ad-40e0-84d9-c954e9f00a64"],
 "."
}], "Notes",ExpressionUUID->"945afdd5-7c52-4d04-920d-463b790b75c0"],

Cell[TextData[{
 "The summand is invariant under cyclic rotation. A cyclic word with three \
distinct rotations is produced three times and has the full coefficient; a \
word ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["e", "TI"], 
     StyleBox["i", "TI"]], 
    SuperscriptBox[
     StyleBox["e", "TI"], 
     StyleBox["i", "TI"]], 
    SuperscriptBox[
     StyleBox["e", "TI"], 
     StyleBox["i", "TI"]]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"5784adca-56dd-469b-858d-6295cb1dfca7"],
 " is produced once and keeps the factor ",
 Cell[BoxData[
  FormBox[
   FractionBox["1", "3"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "fe6d08f0-36e3-40da-b4bd-da6e72930130"],
 "."
}], "Notes",ExpressionUUID->"950204bf-3b44-4db8-a68f-405a5fec0af6"],

Cell[TextData[{
 StyleBox["pairing", "TI"],
 " must carry an ",
 Cell[BoxData["\"\<Algebra\>\""], "InlineFormula",ExpressionUUID->
  "d26964f3-49de-4eb0-91ab-f536eaac7f4e"],
 " key, which ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["GradedPairing"]], "paclet:ChernSimons/ref/GradedPairing", 
     "ChernSimons Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["algebra", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "8251da56-8e81-4434-b7ec-16f962586641"],
 " supplies."
}], "Notes",ExpressionUUID->"3fcb70cd-9b04-4887-a96c-3b8c09ae1fbb"],

Cell[TextData[{
 "The degrees of the particles are read off ",
 StyleBox["pairing", "TI"],
 ", and the degree ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "81f59910-ffbd-41e1-8a2a-9e992a13edf5"],
 " and the ",
 Cell[BoxData["\"\<Triple\>\""], "InlineFormula",ExpressionUUID->
  "ecd257d1-1aab-4eae-af34-798e449fac8a"],
 " key off the algebra."
}], "Notes",ExpressionUUID->"13495fb8-1a88-4a6f-976e-769bb6826a25"],

Cell[TextData[{
 "On a pairing without an algebra ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CanonicalMaurerCartan"]], 
    "paclet:ChernSimons/ref/CanonicalMaurerCartan", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "e94013db-6fc7-4645-a709-4e555a537aae"],
 " returns unevaluated."
}], "Notes",ExpressionUUID->"cad24c2c-04c7-4dc6-9e99-edb478e13c66"],

Cell[TextData[{
 "The element carries only the product, in its part ",
 Cell[BoxData[
  RowBox[{
   StyleBox["m", "TI"], "[", 
   RowBox[{"{", 
    RowBox[{"1", ",", " ", "0"}], "}"}], "]"}]], "InlineFormula",
  ExpressionUUID->"40d88afe-cef0-4a9b-aede-46ba6371fdf9"],
 ", and it carries ",
 StyleBox["pairing", "TI"],
 "."
}], "Notes",ExpressionUUID->"918eb2ec-9d24-4d1c-a315-f0c597c79272"],

Cell[TextData[{
 "When the algebra has a nonzero differential, the canonical dIBL structure \
of a cyclic cochain complex carries it in ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["q", "TI"], 
    RowBox[{"1", ",", "1", ",", "0"}]], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"760d2f39-bcfc-4754-b8af-eb0fcb4f5c8c"],
 ", which is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CyclicHochschildDifferential"]], 
    "paclet:ChernSimons/ref/CyclicHochschildDifferential", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "f878a0ae-7b6e-4aae-bedb-eb329864f7eb"],
 "; see ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["NondegenerateQuotient"]], 
    "paclet:ChernSimons/ref/NondegenerateQuotient", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "e4a883b4-4d51-44ad-a20a-d23972b9af45"],
 "."
}], "Notes",ExpressionUUID->"15403645-2a48-4184-af77-e7bf3a573562"],

Cell["\<\
The element is the algebraic one of a Poincar\[EAcute] duality algebra. The \
geometric element, with ribbon graphs, their combinatorial coefficients and \
the configuration-space integrals, is not computed.\
\>", "Notes",ExpressionUUID->"9c8cbd6d-6ab8-47a2-afb7-2d13c62eedc2"]
}, Open  ]],

