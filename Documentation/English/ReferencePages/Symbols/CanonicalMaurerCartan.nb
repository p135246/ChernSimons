Cell[TextData[{
 "Its symmetric degree is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", "(", 
    RowBox[{
     StyleBox["n", "TI"], "-", "3"}], ")"}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "20ea09b9-7928-4747-b4e6-ce2f3c5f18ca"],
 ", which is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["PlanckDegree"]], "paclet:ChernSimons/ref/PlanckDegree", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "200223b1-5f6c-40ce-9066-adc3c62a671d"],
 " \[LongDash] the degree of ",
 Cell[BoxData[
  FormBox["\[Null]", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6e77e4c9-3f28-44c8-80ad-7a8136c4a40a"],
 ", and so of a BD action:"
}], "ExampleText",ExpressionUUID->"b3e3a9a1-0a6c-40b3-8b22-e5b3cc8db85f"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"pairing", " ", "=", " ", 
   RowBox[{"GradedPairing", "[", 
    RowBox[{"NondegenerateQuotient", "[", 
     RowBox[{"SullivanModel", "[", 
      RowBox[{"\"\<ComplexProjectiveSpace\>\"", "[", "2", "]"}], "]"}], "]"}],
     "]"}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"WordDegree", "[", 
    RowBox[{
     RowBox[{"CyclicWord", "[", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "1", ",", " ", 
        RowBox[{"a", "^", "2"}]}], "}"}], "]"}], ",", " ", "pairing", ",", 
     " ", "\"\<Symmetric\>\""}], "]"}], ",", " ", 
   RowBox[{"PlanckDegree", "[", "pairing", "]"}]}], "}"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"f8f0f54b-81a9-4810-8efd-5a4bab4b4d74"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"2", ",", "2"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"f95a2c17-0422-47db-9223-eedd4e9202ee"]
}, Open  ]],

Cell[CellGroupData[{

