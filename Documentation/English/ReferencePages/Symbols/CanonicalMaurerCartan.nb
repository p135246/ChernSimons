Cell[CellGroupData[{
Cell["CanonicalMaurerCartan", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"accc3768-09f6-4f67-a6bf-4dd86d862fbd"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["CanonicalMaurerCartan"]], 
     "paclet:ChernSimons/ref/CanonicalMaurerCartan", 
     "ChernSimons Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["pairing", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a8f356e9-e307-4ecb-9856-1f89904c004d"],
 "\[LineSeparator]",
 "gives the canonical Maurer-Cartan element of the Poincar\[EAcute] duality \
algebra that ",
 StyleBox["pairing", "TI"],
 " carries, a ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["MaurerCartanElement"]], 
    "paclet:ChernSimons/ref/MaurerCartanElement", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "f83469e5-8152-4fd2-9dca-73a4dc69f7f9"],
 " with the one part ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["m", "TI"], 
    RowBox[{"1", ",", "0"}]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "80eb4985-5f15-4e5c-858d-649869c5d53e"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"bde0ef30-6a87-4db1-88d0-4e884820e4ca"],

Cell[TextData[{
 "The triple product of a Poincar\[EAcute] duality algebra ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     StyleBox["H", "TI"], ",", 
     StyleBox["O", "TI"]}], ")"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5b428a34-193d-484a-bfc8-5206a9dc0576"],
 " of degree ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e4edcfa4-d99f-49db-95eb-4aeeb9742f92"],
 " is a cyclic three-cochain on ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["H", "TI"], 
    RowBox[{"[", "1", "]"}]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7647379a-6296-4b5e-afc2-cffaf30c54b7"],
 ", hence an element of the cyclic words of length three."
}], "Notes",
 CellFrameLabels->{{Inherited, Inherited}, {Inherited, 
    Cell[
     TextData[{
      "26.09.30: Design review - the function reads everything off the \
pairing object: the degrees of the particles from the pairing, and the degree \
n and the \"Triple\" key from its \"Algebra\" key, which \
GradedPairing[algebra] supplies, so the element is built over whatever \
particle names the pairing gives. On a pairing without an algebra it returns \
unevaluated; before R3 it issued GradedPairing::algebra and aborted the whole \
evaluation, and the message is gone. Since R5d it gives a MaurerCartanElement \
with the one part m_{1,0} rather than a bare BD action, and since R5c it \
lives in the ChernSimons part beside GradedPairing[algebra], so that \
ChernSimons reads the PoincareDualityAlgebra of the algebraic models and the \
dependency runs one way. It is the one function of the paclet that produces a \
Maurer-Cartan element rather than taking one as given; the geometric element, \
with ribbon graphs and configuration-space integrals, is not implemented. \
Prior art: the Wolfram Language has no Poincare duality algebras or cyclic \
words; the engine the verification suites load computes the element as \
pdCanonicalMC, and T17/canonical-element-is-the-engine-element pins this \
function against it over the catalogue and Kodaira-Thurston, with the words \
brought to the paclet's canonical rotation. No alternative interface was \
recorded.", "\n\n", 
       Cell[
        BoxData[
         GridBox[{{
            Cell[
             BoxData[
              ButtonBox[
               DynamicBox[
                FEPrivate`FrontEndResource[
                "DocumentationToolsStrings", "Edit"]], BaseStyle -> 
               "TextAnnotationButton"]]], 
            StyleBox[
             RowBox[{
               DynamicBox[
                FEPrivate`FrontEndResource[
                "DocumentationToolsStrings", "LastAnnotator"]], "pavel"}], 
             "TextAnnotator"], 
            Cell[
             BoxData[
              ButtonBox[
               DynamicBox[
                FEPrivate`FrontEndResource[
                "DocumentationToolsStrings", "Delete"]], BaseStyle -> 
               "TextAnnotationRemoveButton"]]], ""}}, 
          GridBoxAlignment -> {
           "Columns" -> {Left, Left, Right, Right}, "Rows" -> {{Automatic}}}, 
          GridBoxItemSize -> {"Columns" -> {
              Scaled[0.15], 
              Scaled[0.68], 
              Scaled[0.15], 
              Scaled[0.02]}}]]], "\n"}], "TextAnnotation", 
     CellSize -> {590, Inherited}]}},
 CellTags->"TextAnnotation",
 CellID->569351963,ExpressionUUID->"3afcc195-e53d-4f66-bccf-40d20a788465"],

Cell[TextData[{
 "In a basis ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    SubscriptBox[
     StyleBox["e", "TI"], 
     StyleBox["i", "TI"]], ")"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "82319bc2-995d-47ad-b977-73e9324c19aa"],
 " the element is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["m", "TI"], 
     RowBox[{"1", ",", "0"}], 
     StyleBox["can",
      FontSlant->"Plain"]], "\[LongEqual]", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"-", "1"}], ")"}], 
     RowBox[{
      StyleBox["n", "TI"], "-", "2"}]], 
    FractionBox["1", "3"], 
    UnderscriptBox["\[Sum]", 
     RowBox[{
      StyleBox["i", "TI"], ",", 
      StyleBox["j", "TI"], ",", 
      StyleBox["k", "TI"]}],
     LimitsPositioning->True], 
    RowBox[{"\[PlusMinus]", " "}], 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"-", "1"}], ")"}], 
     RowBox[{"deg", 
      SubscriptBox[
       StyleBox["e", "TI"], 
       StyleBox["j", "TI"]]}]], " ", 
    StyleBox["O", "TI"], 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox[
       StyleBox["e", "TI"], 
       StyleBox["i", "TI"]], "\[CenterDot]", 
      SubscriptBox[
       StyleBox["e", "TI"], 
       StyleBox["j", "TI"]], "\[CenterDot]", 
      SubscriptBox[
       StyleBox["e", "TI"], 
       StyleBox["k", "TI"]]}], ")"}], " ", 
    SuperscriptBox[
     StyleBox["e", "TI"], 
     StyleBox["i", "TI"]], 
    SuperscriptBox[
     StyleBox["e", "TI"], 
     StyleBox["j", "TI"]], 
    SuperscriptBox[
     StyleBox["e", "TI"], 
     StyleBox["k", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d4bd650e-756a-4a29-b307-b6a4a1817b8b"],
 ", with ",
 Cell[BoxData[
  FormBox["\[PlusMinus]", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "50feeb77-f943-4f51-b50d-670954716dea"],
 " the reversal sign ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"-", "1"}], ")"}], 
    TemplateBox[{
      RowBox[{
        SuperscriptBox[
         StyleBox["e", "TI"], 
         StyleBox["k", "TI"]], "|", 
        RowBox[{
          RowBox[{"(", 
            TemplateBox[{
              RowBox[{
                SuperscriptBox[
                 StyleBox["e", "TI"], 
                 StyleBox["i", "TI"]], "|", "+", "|", 
                SuperscriptBox[
                 StyleBox["e", "TI"], 
                 StyleBox["j", "TI"]]}]}, "Abs"], ")"}], "+"}], "|", 
        RowBox[{
          SuperscriptBox[
           StyleBox["e", "TI"], 
           StyleBox["j", "TI"]], "||", 
          SuperscriptBox[
           StyleBox["e", "TI"], 
           StyleBox["i", "TI"]]}]}]},
     "Abs"]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "97830103-e2bb-42b5-9990-ddb52e023db6"],
 "."
}], "Notes",ExpressionUUID->"bf0ec1fd-f49f-499d-bee6-821a109f0be2"],

Cell[TextData[{
 "In the degrees ",
 Cell[BoxData[
  FormBox[
   StyleBox["a", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4bc8e6a8-7296-4292-8ece-81dab02fac86"],
 ", ",
 Cell[BoxData[
  FormBox[
   StyleBox["b", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "96c7406c-1d80-48c5-8753-a6296d9f7261"],
 ", ",
 Cell[BoxData[
  FormBox[
   StyleBox["c", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "197ca8ac-6bdb-46b9-8e3f-1bfb3062f2c9"],
 " of the three particles the sign of a summand is ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"-", "1"}], ")"}], 
    RowBox[{
     StyleBox["n", "TI"], "-", "1", "+", 
     StyleBox["b", "TI"], "+", 
     StyleBox["a", "TI"], 
     StyleBox["b", "TI"], "+", 
     StyleBox["b", "TI"], 
     StyleBox["c", "TI"], "+", 
     StyleBox["c", "TI"], 
     StyleBox["a", "TI"]}]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8086023e-a3f2-4c85-bf9e-e1c2e363ac7d"],
 "."
}], "Notes",ExpressionUUID->"a56d1978-a925-46bc-8bcf-13cd24435324"],

Cell[TextData[{
 "The summand is invariant under cyclic rotation. A cyclic word with three \
distinct rotations is produced three times and has the full coefficient; a \
word ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["e", "TI"], 
     StyleBox["i", "TI"]], 
    SuperscriptBox[
     StyleBox["e", "TI"], 
     StyleBox["i", "TI"]], 
    SuperscriptBox[
     StyleBox["e", "TI"], 
     StyleBox["i", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "07d7cfd8-fb33-4e90-b470-338abd38d614"],
 " is produced once and keeps the factor ",
 Cell[BoxData[
  FormBox[
   FractionBox["1", "3"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fcc201ad-2de2-405a-bb6e-3c462be06501"],
 "."
}], "Notes",ExpressionUUID->"dd7a4f6c-f7cc-4222-8cbf-06e3f80f5ba4"],

Cell[TextData[{
 StyleBox["pairing", "TI"],
 " must carry an ",
 Cell[BoxData["\"\<Algebra\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cc8a75aa-5d44-4492-8c44-05b67f7709be"],
 " key, which ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["GradedPairing"]], "paclet:ChernSimons/ref/GradedPairing", 
     "ChernSimons Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["algebra", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "158e78c5-0710-4c76-91ff-ed4011d2182d"],
 " supplies."
}], "Notes",ExpressionUUID->"e6a12ba7-5d44-4167-8763-576be55b3ede"],

Cell[TextData[{
 "The degrees of the particles are read off ",
 StyleBox["pairing", "TI"],
 ", and the degree ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "817348ac-2b94-4007-9fee-7fa19fc6117c"],
 " and the ",
 Cell[BoxData["\"\<Triple\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0ac0a6de-2fb8-4e96-b8bb-e6e836a7584e"],
 " key off the algebra."
}], "Notes",ExpressionUUID->"e66973fa-c132-4439-83c2-4e835afb7999"],

Cell[TextData[{
 "On a pairing without an algebra ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CanonicalMaurerCartan"]], 
    "paclet:ChernSimons/ref/CanonicalMaurerCartan", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "e52fb2ff-52fc-4668-9b36-378cf00f99cd"],
 " returns unevaluated."
}], "Notes",ExpressionUUID->"d6e9c94f-96a5-41a2-b7c1-ef305f771af0"],

Cell[TextData[{
 "The element carries only the product, in its part ",
 Cell[BoxData[
  RowBox[{
   StyleBox["m", "TI"], "[", 
   RowBox[{"{", 
    RowBox[{"1", ",", " ", "0"}], "}"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4d3d2c82-a360-4958-bba3-bab666274c10"],
 ", and it carries ",
 StyleBox["pairing", "TI"],
 "."
}], "Notes",ExpressionUUID->"25e48bf8-41ae-4f18-b61b-2d2895ba5fa0"],

Cell[TextData[{
 "When the algebra has a nonzero differential, the canonical dIBL structure \
of a cyclic cochain complex carries it in ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["q", "TI"], 
    RowBox[{"1", ",", "1", ",", "0"}]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7ac459a1-b6ca-46db-b21d-6a6bb19d7d6f"],
 ", which is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CyclicHochschildDifferential"]], 
    "paclet:ChernSimons/ref/CyclicHochschildDifferential", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "0f8ef809-aee0-4a2a-8cd2-7b7c5791e745"],
 "; see ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["NondegenerateQuotient"]], 
    "paclet:ChernSimons/ref/NondegenerateQuotient", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "3109df07-af93-4ea3-aab5-049a4ec39026"],
 "."
}], "Notes",ExpressionUUID->"1b129254-4e97-440f-90ef-695fd14c5aa1"],

Cell["\<\
The element is the algebraic one of a Poincar\[EAcute] duality algebra. The \
geometric element, with ribbon graphs, their combinatorial coefficients and \
the configuration-space integrals, is not computed.\
\>", "Notes",ExpressionUUID->"5c351b27-9fbd-41eb-9066-c0fa5fcae429"]
}, Open  ]],

