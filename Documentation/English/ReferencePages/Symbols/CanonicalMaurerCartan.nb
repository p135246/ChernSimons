Cell[TextData[{
 "It solves the Maurer-Cartan equation; on a word of length three the \
equation reduces to ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["q", "TI"], 
     RowBox[{"2", ",", "1", ",", "0"}]], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["m", "TI"], "\[CircleDot]", 
      StyleBox["m", "TI"]}], ")"}], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"a9014249-5fc3-4980-8603-900f1b66e98d"],
 ", which is associativity in these coordinates:"
}], "ExampleText",ExpressionUUID->"def25d16-027f-4a7b-ac29-4d1e8858711e"],

