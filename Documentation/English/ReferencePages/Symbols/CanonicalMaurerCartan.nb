Cell[CellGroupData[{
Cell["CanonicalMaurerCartan", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"d0e23fa0-0725-4023-a19f-802ae65f6cc7"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["CanonicalMaurerCartan"]], 
     "paclet:ChernSimons/ref/CanonicalMaurerCartan", 
     "ChernSimons Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["pairing", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "14e6c027-4fa6-40bc-a7c6-ee74e33429fe"],
 "\[LineSeparator]",
 "gives the canonical Maurer-Cartan element of the Poincar\[EAcute] duality \
algebra that ",
 StyleBox["pairing", "TI"],
 " carries, a ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["MaurerCartanElement"]], 
    "paclet:ChernSimons/ref/MaurerCartanElement", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "d07ef436-2f1d-4d28-8af5-5ec65e1ee699"],
 " with the one part ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["m", "TI"], 
    RowBox[{"1", ",", "0"}]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b738a352-6094-4f04-9dba-b959f6ec346f"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"0563f47b-2f62-4dd4-bbb5-21688ac09662"],

Cell[TextData[{
 "The triple product of a Poincar\[EAcute] duality algebra ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     StyleBox["H", "TI"], ",", 
     StyleBox["O", "TI"]}], ")"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0ba7573c-4c21-4e03-8cad-8ba821a984ce"],
 " of degree ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "750cf833-8705-4621-9d21-d247d4179304"],
 " is a cyclic three-cochain on ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["H", "TI"], 
    RowBox[{"[", "1", "]"}]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "27fdae3e-9dc6-46e8-a66b-effebb2e4733"],
 ", hence an element of the cyclic words of length three."
}], "Notes",
 CellFrameLabels->{{Inherited, Inherited}, {Inherited, 
    Cell[
     TextData[{
      "26.09.30: Design review - the function reads everything off the \
pairing object: the degrees of the particles from the pairing, and the degree \
n and the \"Triple\" key from its \"Algebra\" key, which \
GradedPairing[algebra] supplies, so the element is built over whatever \
particle names the pairing gives. On a pairing without an algebra it returns \
unevaluated; before R3 it issued GradedPairing::algebra and aborted the whole \
evaluation, and the message is gone. Since R5d it gives a MaurerCartanElement \
with the one part m_{1,0} rather than a bare BD action, and since R5c it \
lives in the ChernSimons part beside GradedPairing[algebra], so that \
ChernSimons reads the PoincareDualityAlgebra of the algebraic models and the \
dependency runs one way. It is the one function of the paclet that produces a \
Maurer-Cartan element rather than taking one as given; the geometric element, \
with ribbon graphs and configuration-space integrals, is not implemented. \
Prior art: the Wolfram Language has no Poincare duality algebras or cyclic \
words; the engine the verification suites load computes the element as \
pdCanonicalMC, and T17/canonical-element-is-the-engine-element pins this \
function against it over the catalogue and Kodaira-Thurston, with the words \
brought to the paclet's canonical rotation. No alternative interface was \
recorded.", "\n\n", 
       Cell[
        BoxData[
         GridBox[{{
            Cell[
             BoxData[
              ButtonBox[
               DynamicBox[
                FEPrivate`FrontEndResource[
                "DocumentationToolsStrings", "Edit"]], BaseStyle -> 
               "TextAnnotationButton"]]], 
            StyleBox[
             RowBox[{
               DynamicBox[
                FEPrivate`FrontEndResource[
                "DocumentationToolsStrings", "LastAnnotator"]], "pavel"}], 
             "TextAnnotator"], 
            Cell[
             BoxData[
              ButtonBox[
               DynamicBox[
                FEPrivate`FrontEndResource[
                "DocumentationToolsStrings", "Delete"]], BaseStyle -> 
               "TextAnnotationRemoveButton"]]], ""}}, 
          GridBoxAlignment -> {
           "Columns" -> {Left, Left, Right, Right}, "Rows" -> {{Automatic}}}, 
          GridBoxItemSize -> {"Columns" -> {
              Scaled[0.15], 
              Scaled[0.68], 
              Scaled[0.15], 
              Scaled[0.02]}}]]], "\n"}], "TextAnnotation", 
     CellSize -> {590, Inherited}]}},
 CellTags->"TextAnnotation",
 CellID->659449214,ExpressionUUID->"f18ffaa5-c509-4117-8373-3056c6e4536f"],

Cell[TextData[{
 "In a basis ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    SubscriptBox[
     StyleBox["e", "TI"], 
     StyleBox["i", "TI"]], ")"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "db87638e-2f6c-401b-8df6-ccff201e9d37"],
 " the element is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["m", "TI"], 
     RowBox[{"1", ",", "0"}], 
     StyleBox["can",
      FontSlant->"Plain"]], "\[LongEqual]", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"-", "1"}], ")"}], 
     RowBox[{
      StyleBox["n", "TI"], "-", "2"}]], 
    FractionBox["1", "3"], 
    UnderscriptBox["\[Sum]", 
     RowBox[{
      StyleBox["i", "TI"], ",", 
      StyleBox["j", "TI"], ",", 
      StyleBox["k", "TI"]}],
     LimitsPositioning->True], 
    RowBox[{"\[PlusMinus]", " "}], 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"-", "1"}], ")"}], 
     RowBox[{"deg", 
      SubscriptBox[
       StyleBox["e", "TI"], 
       StyleBox["j", "TI"]]}]], " ", 
    StyleBox["O", "TI"], 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox[
       StyleBox["e", "TI"], 
       StyleBox["i", "TI"]], "\[CenterDot]", 
      SubscriptBox[
       StyleBox["e", "TI"], 
       StyleBox["j", "TI"]], "\[CenterDot]", 
      SubscriptBox[
       StyleBox["e", "TI"], 
       StyleBox["k", "TI"]]}], ")"}], " ", 
    SuperscriptBox[
     StyleBox["e", "TI"], 
     StyleBox["i", "TI"]], 
    SuperscriptBox[
     StyleBox["e", "TI"], 
     StyleBox["j", "TI"]], 
    SuperscriptBox[
     StyleBox["e", "TI"], 
     StyleBox["k", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "21fe437d-487b-44aa-919f-55eb79a3e120"],
 ", with ",
 Cell[BoxData[
  FormBox["\[PlusMinus]", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "478df18e-f03b-4cfa-aec4-1a1e7e19ba92"],
 " the reversal sign ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"-", "1"}], ")"}], 
    TemplateBox[{
      RowBox[{
        SuperscriptBox[
         StyleBox["e", "TI"], 
         StyleBox["k", "TI"]], "|", 
        RowBox[{
          RowBox[{"(", 
            TemplateBox[{
              RowBox[{
                SuperscriptBox[
                 StyleBox["e", "TI"], 
                 StyleBox["i", "TI"]], "|", "+", "|", 
                SuperscriptBox[
                 StyleBox["e", "TI"], 
                 StyleBox["j", "TI"]]}]}, "Abs"], ")"}], "+"}], "|", 
        RowBox[{
          SuperscriptBox[
           StyleBox["e", "TI"], 
           StyleBox["j", "TI"]], "||", 
          SuperscriptBox[
           StyleBox["e", "TI"], 
           StyleBox["i", "TI"]]}]}]},
     "Abs"]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d68b4b01-4a79-47f6-8ebb-2aceb3979953"],
 "."
}], "Notes",ExpressionUUID->"7ec2b63f-bab4-4dab-b155-de37f2f5ce1b"],

Cell[TextData[{
 "In the degrees ",
 Cell[BoxData[
  FormBox[
   StyleBox["a", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0984cbd3-b3c2-4a99-a36e-1fcfb760c482"],
 ", ",
 Cell[BoxData[
  FormBox[
   StyleBox["b", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "20e06632-f049-40c4-aeca-33e82eb099d0"],
 ", ",
 Cell[BoxData[
  FormBox[
   StyleBox["c", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "08f10296-6f9b-4e2c-aabe-38f97d8b3958"],
 " of the three particles the sign of a summand is ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"-", "1"}], ")"}], 
    RowBox[{
     StyleBox["n", "TI"], "-", "1", "+", 
     StyleBox["b", "TI"], "+", 
     StyleBox["a", "TI"], 
     StyleBox["b", "TI"], "+", 
     StyleBox["b", "TI"], 
     StyleBox["c", "TI"], "+", 
     StyleBox["c", "TI"], 
     StyleBox["a", "TI"]}]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a896e597-c778-464b-b192-cb1c8e0fbc87"],
 "."
}], "Notes",ExpressionUUID->"32efbe77-187c-4b90-96e1-4bcebac037e0"],

Cell[TextData[{
 "The summand is invariant under cyclic rotation. A cyclic word with three \
distinct rotations is produced three times and has the full coefficient; a \
word ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["e", "TI"], 
     StyleBox["i", "TI"]], 
    SuperscriptBox[
     StyleBox["e", "TI"], 
     StyleBox["i", "TI"]], 
    SuperscriptBox[
     StyleBox["e", "TI"], 
     StyleBox["i", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "693ca807-c7fa-4e22-b9b7-7d627689b921"],
 " is produced once and keeps the factor ",
 Cell[BoxData[
  FormBox[
   FractionBox["1", "3"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "38cd9711-a1e4-40d8-9f27-848eb06f0338"],
 "."
}], "Notes",ExpressionUUID->"67d1173d-ec75-44fa-8041-24e9ac4578e9"],

Cell[TextData[{
 StyleBox["pairing", "TI"],
 " must carry an ",
 Cell[BoxData["\"\<Algebra\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0e4cfbb2-203f-466f-94fc-ca60b33c7cd5"],
 " key, which ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["GradedPairing"]], "paclet:ChernSimons/ref/GradedPairing", 
     "ChernSimons Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["algebra", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1d509067-7361-4e35-b89a-9ecbbb6e2b2f"],
 " supplies."
}], "Notes",ExpressionUUID->"1818244f-32de-4d02-8a4f-a0cb10173707"],

Cell[TextData[{
 "The degrees of the particles are read off ",
 StyleBox["pairing", "TI"],
 ", and the degree ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cb800d5f-1cae-4e67-8036-94e2e62d21fc"],
 " and the ",
 Cell[BoxData["\"\<Triple\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bf5037a4-0194-4299-be49-320ab092e455"],
 " key off the algebra."
}], "Notes",ExpressionUUID->"ca148c57-ea92-4000-b5eb-fb21ac85d9d1"],

Cell[TextData[{
 "On a pairing without an algebra ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CanonicalMaurerCartan"]], 
    "paclet:ChernSimons/ref/CanonicalMaurerCartan", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "5f1689f6-14f1-41c3-9dd7-4a6ab1edc94f"],
 " returns unevaluated."
}], "Notes",ExpressionUUID->"87313691-690c-455b-8848-cefd8455e1a0"],

Cell[TextData[{
 "The element carries only the product, in its part ",
 Cell[BoxData[
  RowBox[{
   StyleBox["m", "TI"], "[", 
   RowBox[{"{", 
    RowBox[{"1", ",", " ", "0"}], "}"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "31af925d-912f-4c81-bd05-1c9089b77a7e"],
 ", and it carries ",
 StyleBox["pairing", "TI"],
 "."
}], "Notes",ExpressionUUID->"c0102fea-fef0-41ee-87e4-539743b60f61"],

Cell[TextData[{
 "When the algebra has a nonzero differential, the canonical dIBL structure \
of a cyclic cochain complex carries it in ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["q", "TI"], 
    RowBox[{"1", ",", "1", ",", "0"}]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9996fb35-8adf-4ec8-ae44-cd52deb0ccdf"],
 ", which is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CyclicHochschildDifferential"]], 
    "paclet:ChernSimons/ref/CyclicHochschildDifferential", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "7e9eedcc-e176-4f96-be9e-35a9900d02b0"],
 "; see ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["NondegenerateQuotient"]], 
    "paclet:ChernSimons/ref/NondegenerateQuotient", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "ab4f47d3-991e-4661-9b21-65c2937f513a"],
 "."
}], "Notes",ExpressionUUID->"ba4fe074-311c-47fb-89da-33619693f663"],

Cell["\<\
The element is the algebraic one of a Poincar\[EAcute] duality algebra. The \
geometric element, with ribbon graphs, their combinatorial coefficients and \
the configuration-space integrals, is not computed.\
\>", "Notes",ExpressionUUID->"0201ca4e-f1f1-431d-8512-5a5530ee40c5"]
}, Open  ]],

