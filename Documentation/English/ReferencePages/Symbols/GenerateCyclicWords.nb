Cell[CellGroupData[{
Cell["GenerateCyclicWords", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"5f44a415-01f3-4ddb-ae6e-69e874e4a87d"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["GenerateCyclicWords"]], 
     "paclet:ChernSimons/ref/GenerateCyclicWords", 
     "ChernSimons Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["n", "TI"], ",", " ", 
    StyleBox["pairing", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "84f9be31-fe8c-4304-bcf8-67b462bfd7a4"],
 "\[LineSeparator]",
 "gives the nonzero cyclic words of length ",
 StyleBox["n", "TI"],
 " over the alphabet of ",
 StyleBox["pairing", "TI"],
 ", each in its canonical rotation.",
 "\n"
}], "Usage",ExpressionUUID->"3ee66f75-44d3-4db7-b4ca-baa2070f8b98"],

Cell[TextData[{
 StyleBox["pairing", "TI"],
 " is a pairing object built by ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["GradedPairing"]], "paclet:ChernSimons/ref/GradedPairing", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "dfda9592-a60d-4c1c-a6c4-a6f771d45cc3"],
 ", or an association from particles to degrees."
}], "Notes",
 CellFrameLabels->{{Inherited, Inherited}, {Inherited, 
    Cell[
     TextData[{
      "26.09.30: Design review - the enumeration is the normalization of \
CyclicWord applied to every tuple of particles, with duplicates and zeros \
removed, so it lists exactly the representatives the operations give and \
nothing needs to be compared up to rotation. The length is exact by default \
and \"UpTo\" -> True gives every length up to n; the empty word is left out \
unless \"EmptyWord\" -> True, the positive-length convention of the paper. \
Only the degrees are read, so an Association of degrees may stand in for the \
pairing object. Alternative name considered: CyclicWords, the name until \
2026-09-30. Prior art: the Wolfram Language has no enumeration of necklaces \
or cyclic words, and Tuples gives the linear words the enumeration starts \
from. The verification suites build their test words from this function, as \
pacletWords in T12, and compare the operations on them with the engine they \
load.", "\n\n", 
       Cell[
        BoxData[
         GridBox[{{
            Cell[
             BoxData[
              ButtonBox[
               DynamicBox[
                FEPrivate`FrontEndResource[
                "DocumentationToolsStrings", "Edit"]], BaseStyle -> 
               "TextAnnotationButton"]]], 
            StyleBox[
             RowBox[{
               DynamicBox[
                FEPrivate`FrontEndResource[
                "DocumentationToolsStrings", "LastAnnotator"]], "pavel"}], 
             "TextAnnotator"], 
            Cell[
             BoxData[
              ButtonBox[
               DynamicBox[
                FEPrivate`FrontEndResource[
                "DocumentationToolsStrings", "Delete"]], BaseStyle -> 
               "TextAnnotationRemoveButton"]]], ""}}, 
          GridBoxAlignment -> {
           "Columns" -> {Left, Left, Right, Right}, "Rows" -> {{Automatic}}}, 
          GridBoxItemSize -> {"Columns" -> {
              Scaled[0.15], 
              Scaled[0.68], 
              Scaled[0.15], 
              Scaled[0.02]}}]]], "\n"}], "TextAnnotation", 
     CellSize -> {590, Inherited}]}},
 CellTags->"TextAnnotation",
 CellID->410368242,ExpressionUUID->"027d14ef-a0a4-48cb-99e2-345882e610d1"],

Cell[TextData[{
 "Only canonical representatives are listed, and the words that a rotation \
sends to minus themselves are left out, since they are ",
 Cell[BoxData[
  FormBox["0", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "834746e3-0dc0-4f1a-91eb-21cc06d3b291"],
 ". The list is a basis of the space of cyclic words of length ",
 StyleBox["n", "TI"],
 "."
}], "Notes",ExpressionUUID->"cc855f39-c9b7-4c94-92e3-a754afa390a6"],

Cell[TextData[{
 "The words come in the order in which ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Tuples"]], "paclet:ref/Tuples"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a5ce80da-ea6f-4f30-9022-8b390e9bb1e2"],
 " of the particles first reaches them."
}], "Notes",ExpressionUUID->"fbe505c2-41e1-4a0b-b43d-9d4995365456"],

Cell[TextData[{
 "The result is a list of inert one-argument ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CyclicWord"]], "paclet:ChernSimons/ref/CyclicWord", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "c7935ee0-f595-4116-b746-aed9ab50d519"],
 " expressions."
}], "Notes",ExpressionUUID->"1eef620f-06d8-451f-a224-8ede7ace2881"],

Cell[TextData[{
 "A negative ",
 StyleBox["n", "TI"],
 " returns unevaluated."
}], "Notes",ExpressionUUID->"d6ac6070-8938-4556-b5dd-5c7b575b42a7"],

