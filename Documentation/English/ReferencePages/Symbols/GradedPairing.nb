  RowBox[{
   TemplateBox[{
     Cell[
      TextData["GradedPairing"]], "paclet:ChernSimons/ref/GradedPairing", 
     "ChernSimons Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["assoc", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "9aaea18e-57aa-4dd6-aba7-be43597a0145"],
 " around one association. ",
 Cell[BoxData[
  RowBox[{
   StyleBox["pairing", "TI"], "[", "\"\<\!\(\*StyleBox[\"key\", \"TI\"]\)\>\"",
    "]"}]], "InlineFormula",ExpressionUUID->
  "68601cdf-33c3-4bf4-848c-4e20435e9117"],
 " gives the value of a key, and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Normal"]], "paclet:ref/Normal"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "849120dd-f644-4ac3-bba2-69d831fa3798"],
 " gives the association."
}], "Notes",ExpressionUUID->"f7a75fdb-4b6f-48ae-a51d-a2d62f198c49"],

