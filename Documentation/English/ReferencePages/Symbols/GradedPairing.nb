 ", ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["KeyDrop"]], "paclet:ref/KeyDrop"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "fa7207d2-32c6-40ee-a6e6-d3ae226c1e9a"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
