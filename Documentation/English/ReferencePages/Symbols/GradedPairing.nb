   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "1a6a6400-b121-4130-81ce-faa39539f47f"],
 ", ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["KeyDrop"]], "paclet:ref/KeyDrop"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "aec038d8-cbdc-4e2a-a067-9fc66f6d41d1"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
