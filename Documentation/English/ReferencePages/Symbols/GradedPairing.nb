Cell[TextData[{
 "The nonzero values must all have one degree ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{
     RowBox[{
       StyleBox["p", "TI"], "|", "+", "|", 
       StyleBox["q", "TI"]}]},
    "Abs"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ab5bef56-4c9f-4f1a-a102-5d7c79f41a19"],
 ". Otherwise the result is a ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Failure"]], "paclet:ref/Failure"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "341a8cd5-0dda-4182-ad8a-74b08742da53"],
 " whose message says that the pairing has no well-defined degree, and whose ",
 Cell[BoxData["\"\<Degrees\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "666e0826-ef46-4c44-9c0b-d4e4e4b5c7ba"],
 " lists the degrees found."
}], "Notes",ExpressionUUID->"f1a61c1e-1468-420c-9bba-b4cc163e0e87"],

