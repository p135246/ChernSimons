  FontSize->0.9 Inherited,ExpressionUUID->
  "557d2d53-895f-469e-8561-42fae4c53e73"],
 " gives the association."
}], "Notes",ExpressionUUID->"835b12d9-674b-4db7-aa09-b0e317f17e8a"],

