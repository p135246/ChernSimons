  FontSize->0.9 Inherited,ExpressionUUID->
  "bae28a38-d511-4d31-80d9-a10d1dfcffdc"],
 " around one association. ",
 Cell[BoxData[
  RowBox[{
   StyleBox["pairing", "TI"], "[", "\"\<\!\(\*StyleBox[\"key\", \"TI\"]\)\>\"",
    "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "419c271b-e231-4a2d-afd1-ce6508ca9552"],
 " gives the value of a key, and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Normal"]], "paclet:ref/Normal"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7832a8aa-1a7d-4930-83ac-71f3609237db"],
 " gives the association."
}], "Notes",ExpressionUUID->"58db4c2f-a63a-435f-a6eb-8fd85df8fc9d"],

