Cell[TextData[{
 "The nonzero values must all have one degree ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{
     RowBox[{
       StyleBox["p", "TI"], "|", "+", "|", 
       StyleBox["q", "TI"]}]},
    "Abs"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "e1b08c62-95e0-4208-9b47-af992bdc5051"],
 ". Otherwise the result is a ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Failure"]], "paclet:ref/Failure"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "c06b0a3f-b20d-4ce9-9139-9bf512a12e62"],
 " whose message says that the pairing has no well-defined degree, and whose ",
 Cell[BoxData["\"\<Degrees\>\""], "InlineFormula",ExpressionUUID->
  "1464aa4d-d225-4bb6-b274-d11fa2a53827"],
 " lists the degrees found."
}], "Notes",ExpressionUUID->"e5a304ac-022e-453f-8261-c234c309c908"],

Cell[TextData[{
 "The convention selects the picture every later operation works in: ",
 Cell[BoxData["\"\<Symmetric\>\""], "InlineFormula",ExpressionUUID->
  "80a3361e-9ac9-4954-b5cd-bfdb088d17cd"],
 " uses the ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SymmetricProduct"]], "paclet:ChernSimons/ref/SymmetricProduct",
     "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "6379c13c-2c0d-4958-a5c9-184ecdd51ada"],
 " grading ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     RowBox[{"[", "-", "]"}], "1"], "\[LongEqual]", 
    RowBox[{"[", "-", "]"}], "-", "1"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"d2f778a9-b6e8-49aa-b4af-14176fdbc7f1"],
 ", ",
 Cell[BoxData["\"\<Exterior\>\""], "InlineFormula",ExpressionUUID->
  "771c4971-54f9-44ce-9518-26dd8daac1ff"],
 " the ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ExteriorProduct"]], "paclet:ChernSimons/ref/ExteriorProduct", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "a7e24df7-66f7-44ad-a747-250ad483a188"],
 " grading ",
 Cell[BoxData[
  FormBox[
   RowBox[{"[", "-", "]"}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "97987ec3-2d91-48e1-bee7-9d6130614c8d"],
 ". ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["Append",
    BaseStyle->"Link"], "[", 
   RowBox[{
    StyleBox["pairing", "TI"], ",", " ", 
    RowBox[{"\"\<Convention\>\"", " ", "->", " ", "\"\<Exterior\>\""}]}], 
   "]"}]], "InlineFormula",ExpressionUUID->
  "37674640-449e-4a47-a71f-d2dcf24ee882"],
 " switches it."
}], "Notes",ExpressionUUID->"5409b16d-8f23-4b5d-9fbc-49d2fb50fb8f"],

Cell[TextData[{
 "In the four-argument form ",
 StyleBox["dual", "TI"],
 " is an association from dual letters to their degrees, and ",
 StyleBox["evaluation", "TI"],
 " gives ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[LeftAngleBracket]", 
    RowBox[{
     StyleBox["p", "TI"], ",", "\[Alpha]"}], "\[RightAngleBracket]"}], 
   TraditionalForm]], "InlineFormula",ExpressionUUID->
  "8d746d48-2988-4082-b7d2-69e19b3da69a"],
 " for a letter ",
 Cell[BoxData[
  FormBox[
   StyleBox["p", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "46fcf826-5209-4abf-97c9-95c1bbfc1cd4"],
 " and a dual letter ",
 Cell[BoxData[
  FormBox["\[Alpha]", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "2d7f7f34-f964-48cf-86d0-f0406d4dce24"],
 ". It is read by ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DualPairing"]], "paclet:ChernSimons/ref/DualPairing", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "c3da9e5e-21e8-44b6-b5ac-b4f788a6f081"],
 ", which issues a message and returns unevaluated on a pairing object \
without it. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ElementDegree"]], "paclet:ChernSimons/ref/ElementDegree", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "812fa9e8-5381-4498-86c1-7b6ec5b152eb"],
 " reads the degrees of the dual letters as well."
}], "Notes",ExpressionUUID->"9b1df5ec-3a36-422d-930e-0df66042c116"],

Cell[TextData[{
 "In the forms built from an algebra the letters are a basis of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["H", "TI"], 
    RowBox[{"[", "1", "]"}]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"032a7b04-36bf-41ad-a49d-b5589bf98086"],
 ": the letter of the basis vector ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["e", "TI"], 
    StyleBox["i", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "40d200b2-14d6-4bb0-9f29-421acd32e552"],
 " has degree ",
 Cell[BoxData[
  FormBox[
   RowBox[{"|", 
    SubscriptBox[
     StyleBox["e", "TI"], 
     StyleBox["i", "TI"]], "|", "-", "1"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"14ce567d-7515-48ec-a564-b1a44bbfbe53"],
 ", and the values are ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{
      StyleBox["s", "TI"], 
      SubscriptBox[
       StyleBox["e", "TI"], 
       StyleBox["i", "TI"]], ",", 
      StyleBox["s", "TI"], 
      SubscriptBox[
       StyleBox["e", "TI"], 
       StyleBox["j", "TI"]]}], "\[RightAngleBracket]"}], "\[LongEqual]", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"-", "1"}], ")"}], 
     TemplateBox[{
       RowBox[{
         SubscriptBox[
