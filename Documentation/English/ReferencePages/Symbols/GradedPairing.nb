  "4e5ea310-eb8b-44c3-958b-23451fbd7420"],
 " grading ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     RowBox[{"[", "-", "]"}], "1"], "\[LongEqual]", 
    RowBox[{"[", "-", "]"}], "-", "1"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3ae6db38-cf0e-4c4c-bd45-5b6908e2a4c3"],
 ", ",
 Cell[BoxData["\"\<Exterior\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b0a009f7-a5c6-45a9-8139-05c4c3abc68a"],
 " the ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ExteriorProduct"]], "paclet:ChernSimons/ref/ExteriorProduct", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "44c3455a-8d98-4ec4-9540-0b0e00ec8225"],
 " grading ",
 Cell[BoxData[
  FormBox[
   RowBox[{"[", "-", "]"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e6a4f63d-993b-49af-823b-fd94ba062b43"],
 ". ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["Append",
    BaseStyle->"Link"], "[", 
   RowBox[{
    StyleBox["pairing", "TI"], ",", " ", 
    RowBox[{"\"\<Convention\>\"", " ", "->", " ", "\"\<Exterior\>\""}]}], 
   "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6b7e5bc8-a6e6-40c9-966a-a31b6eb708b2"],
 " switches it."
}], "Notes",ExpressionUUID->"71e8edcb-5a74-46f8-a357-83028391d29d"],

Cell[TextData[{
 "In the four-argument form ",
 StyleBox["dual", "TI"],
 " is an association from dual particles to their degrees, and ",
 StyleBox["evaluation", "TI"],
 " gives ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[LeftAngleBracket]", 
    RowBox[{
     StyleBox["p", "TI"], ",", "\[Alpha]"}], "\[RightAngleBracket]"}], 
   TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f16935fe-7116-4997-93fe-35fc776722f7"],
 " for a particle ",
 Cell[BoxData[
  FormBox[
   StyleBox["p", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "37ab4f32-21ca-48d6-b57a-5fc52a378b6f"],
 " and a dual particle ",
 Cell[BoxData[
  FormBox["\[Alpha]", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "30a54e3d-81b5-4a5f-bd3a-e2a725c5af16"],
 ". It is read by ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DualPairing"]], "paclet:ChernSimons/ref/DualPairing", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "3c160d64-78cb-42f4-91af-040155a22057"],
 ", which issues a message and returns unevaluated on a pairing object \
without it. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ElementDegree"]], "paclet:ChernSimons/ref/ElementDegree", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "7fabe5b3-d9f0-41da-a7b0-40f7e4a5a07a"],
 " reads the degrees of the dual particles as well."
}], "Notes",ExpressionUUID->"5529d43a-b3a0-4b61-9577-191b18682438"],

Cell[TextData[{
 "In the forms built from an algebra the particles are a basis of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["H", "TI"], 
    RowBox[{"[", "1", "]"}]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e2672126-a0ab-4506-83c4-55932477605d"],
 ": the particle of the basis vector ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["e", "TI"], 
    StyleBox["i", "TI"]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a165ff42-88d6-4412-aea3-29c9d240812d"],
 " has degree ",
 Cell[BoxData[
  FormBox[
   RowBox[{"|", 
    SubscriptBox[
     StyleBox["e", "TI"], 
     StyleBox["i", "TI"]], "|", "-", "1"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1ee0f5cc-350c-4519-bddb-73742dbccb5e"],
 ", and the values are ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{
      StyleBox["s", "TI"], 
      SubscriptBox[
       StyleBox["e", "TI"], 
       StyleBox["i", "TI"]], ",", 
      StyleBox["s", "TI"], 
      SubscriptBox[
       StyleBox["e", "TI"], 
       StyleBox["j", "TI"]]}], "\[RightAngleBracket]"}], "\[LongEqual]", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"-", "1"}], ")"}], 
     TemplateBox[{
       RowBox[{
         SubscriptBox[
          StyleBox["e", "TI"], 
          StyleBox["i", "TI"]]}]},
      "Abs"]], 
    StyleBox["O", "TI"], 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox[
       StyleBox["e", "TI"], 
       StyleBox["i", "TI"]], 
      SubscriptBox[
       StyleBox["e", "TI"], 
       StyleBox["j", "TI"]]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5a6889ee-dc74-4a4d-82b3-d5fb3a81f183"],
 ". This sign turns the graded symmetric pairing of degree ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b0f9dd8b-fc64-4391-bb10-ee49389321d7"],
 " into a graded antisymmetric one of degree ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["n", "TI"], "-", "2"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "000965ba-0c06-4f3f-bda8-f824f4a9d52d"],
 "."
}], "Notes",ExpressionUUID->"6e17cbcb-4166-47f0-ae42-d86c3ca99702"],

