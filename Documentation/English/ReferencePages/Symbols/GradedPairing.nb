Cell[TextData[{
 "The nonzero values must all have one degree ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{
     RowBox[{
       StyleBox["p", "TI"], "|", "+", "|", 
       StyleBox["q", "TI"]}]},
    "Abs"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "5630e6d2-1712-4063-aa3a-82c6f8b7a4fd"],
 ". Otherwise the result is a ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Failure"]], "paclet:ref/Failure"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "6de76f82-fc7d-4bde-8a45-176e0d8be92a"],
 " whose message says that the pairing has no well-defined degree, and whose ",
 Cell[BoxData["\"\<Degrees\>\""], "InlineFormula",ExpressionUUID->
  "3648c569-3ff4-4493-b07b-14bc4c7958dc"],
 " lists the degrees found."
}], "Notes",ExpressionUUID->"0d03e7ce-0352-489c-b2ff-783240cd433a"],

Cell[TextData[{
 "The convention selects the picture every later operation works in: ",
 Cell[BoxData["\"\<Symmetric\>\""], "InlineFormula",ExpressionUUID->
  "c717c49e-7389-4ce8-8081-6b469ea5c374"],
 " uses the ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SymmetricProduct"]], "paclet:ChernSimons/ref/SymmetricProduct",
     "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "5f56a5d2-8986-4549-bbc4-4a9bab8c0d25"],
 " grading ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     RowBox[{"[", "-", "]"}], "1"], "\[LongEqual]", 
    RowBox[{"[", "-", "]"}], "-", "1"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"022c76d7-d5be-4fa8-966b-9da1ef962996"],
 ", ",
 Cell[BoxData["\"\<Exterior\>\""], "InlineFormula",ExpressionUUID->
  "1d7794e0-8a28-47e0-b248-f01dd4725b7c"],
 " the ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ExteriorProduct"]], "paclet:ChernSimons/ref/ExteriorProduct", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "5cfd689b-b669-41bc-b1a8-2b56d55a335f"],
 " grading ",
 Cell[BoxData[
  FormBox[
   RowBox[{"[", "-", "]"}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "d934fe80-3352-41be-b3f6-f4c1a8489592"],
 ". ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["Append",
    BaseStyle->"Link"], "[", 
   RowBox[{
    StyleBox["pairing", "TI"], ",", " ", 
    RowBox[{"\"\<Convention\>\"", " ", "->", " ", "\"\<Exterior\>\""}]}], 
   "]"}]], "InlineFormula",ExpressionUUID->
  "68d37d4d-067c-4e4b-8e40-6c325ffe383f"],
 " switches it."
}], "Notes",ExpressionUUID->"7fe62d13-05a6-41c2-ab7f-4501bac751e0"],

Cell[TextData[{
 "In the four-argument form ",
 StyleBox["dual", "TI"],
 " is an association from dual particles to their degrees, and ",
 StyleBox["evaluation", "TI"],
 " gives ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[LeftAngleBracket]", 
    RowBox[{
     StyleBox["p", "TI"], ",", "\[Alpha]"}], "\[RightAngleBracket]"}], 
   TraditionalForm]], "InlineFormula",ExpressionUUID->
  "1992a2a6-cec5-43ff-ba53-899c6ac740c5"],
 " for a particle ",
 Cell[BoxData[
  FormBox[
   StyleBox["p", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "8dabe03a-97f0-40d3-9c24-74cf51a7ea23"],
 " and a dual particle ",
 Cell[BoxData[
  FormBox["\[Alpha]", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "cbdf8110-dcd7-450b-8740-41d770cb4c50"],
 ". It is read by ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DualPairing"]], "paclet:ChernSimons/ref/DualPairing", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "a1cec4c7-29d0-4991-b652-8b428f27ec70"],
 ", which issues a message and returns unevaluated on a pairing object \
without it. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ElementDegree"]], "paclet:ChernSimons/ref/ElementDegree", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "699c3af9-06e4-4d36-a179-76e639743292"],
 " reads the degrees of the dual particles as well."
}], "Notes",ExpressionUUID->"5c86babb-c350-451e-bcae-88b163850b48"],

Cell[TextData[{
 "In the forms built from an algebra the particles are a basis of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["H", "TI"], 
    RowBox[{"[", "1", "]"}]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"79223cb3-b9f9-494a-9eef-e03c9ecfd3b4"],
 ": the particle of the basis vector ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["e", "TI"], 
    StyleBox["i", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "f914f0ce-893a-441c-be6b-09ec4aa2d42c"],
 " has degree ",
 Cell[BoxData[
  FormBox[
   RowBox[{"|", 
    SubscriptBox[
     StyleBox["e", "TI"], 
     StyleBox["i", "TI"]], "|", "-", "1"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"bfc165a3-81a3-416c-8381-e801b8ce52b7"],
 ", and the values are ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{
      StyleBox["s", "TI"], 
      SubscriptBox[
       StyleBox["e", "TI"], 
       StyleBox["i", "TI"]], ",", 
      StyleBox["s", "TI"], 
      SubscriptBox[
       StyleBox["e", "TI"], 
       StyleBox["j", "TI"]]}], "\[RightAngleBracket]"}], "\[LongEqual]", 
    SuperscriptBox[
     RowBox[{"(", 
