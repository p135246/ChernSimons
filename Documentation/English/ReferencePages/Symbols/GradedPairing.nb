   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "aeec5b26-aa69-45ab-93b7-4aa4af8d7800"],
 " grading ",
 Cell[BoxData[
  FormBox[
   RowBox[{"[", "-", "]"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e5b464a5-260a-4d20-8d2c-6d190bbefa39"],
 ". ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["Append",
    BaseStyle->"Link"], "[", 
   RowBox[{
    StyleBox["pairing", "TI"], ",", " ", 
    RowBox[{"\"\<Convention\>\"", " ", "->", " ", "\"\<Exterior\>\""}]}], 
   "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "14036752-89d2-40be-b8af-21540fa9596d"],
 " switches it."
}], "Notes",ExpressionUUID->"b4641343-8928-454f-ba1b-47d6796e8386"],

Cell[TextData[{
 "In the four-argument form ",
 StyleBox["dual", "TI"],
 " is an association from dual particles to their degrees, and ",
 StyleBox["evaluation", "TI"],
 " gives ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[LeftAngleBracket]", 
    RowBox[{
     StyleBox["p", "TI"], ",", "\[Alpha]"}], "\[RightAngleBracket]"}], 
   TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f99c2b45-d687-4f11-bce4-1caecb73bf68"],
 " for a particle ",
 Cell[BoxData[
  FormBox[
   StyleBox["p", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "59474537-225f-4765-b8db-892ea36bf8bb"],
 " and a dual particle ",
 Cell[BoxData[
  FormBox["\[Alpha]", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "69f5666a-e96f-4779-99b3-914e215d2e16"],
 ". It is read by ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DualPairing"]], "paclet:ChernSimons/ref/DualPairing", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "62923202-d207-491d-a855-d26dff719aac"],
 ", which issues a message and returns unevaluated on a pairing object \
without it. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ElementDegree"]], "paclet:ChernSimons/ref/ElementDegree", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "0396a463-8f75-481c-84bb-b3f3ec90ce98"],
 " reads the degrees of the dual particles as well."
}], "Notes",ExpressionUUID->"696d0b04-a98a-4900-b6ba-fc9029663751"],

Cell[TextData[{
 "In the forms built from an algebra the particles are a basis of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["H", "TI"], 
    RowBox[{"[", "1", "]"}]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "23ed048b-c856-41bc-a0e4-cd508d0a4995"],
 ": the particle of the basis vector ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["e", "TI"], 
    StyleBox["i", "TI"]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cfab4b00-1b0d-46ed-b329-8a6036e79071"],
 " has degree ",
 Cell[BoxData[
  FormBox[
   RowBox[{"|", 
    SubscriptBox[
     StyleBox["e", "TI"], 
     StyleBox["i", "TI"]], "|", "-", "1"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4e65777d-5794-4e10-a67b-cea5b94d44ab"],
 ", and the values are ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{
      StyleBox["s", "TI"], 
      SubscriptBox[
       StyleBox["e", "TI"], 
       StyleBox["i", "TI"]], ",", 
      StyleBox["s", "TI"], 
      SubscriptBox[
       StyleBox["e", "TI"], 
       StyleBox["j", "TI"]]}], "\[RightAngleBracket]"}], "\[LongEqual]", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"-", "1"}], ")"}], 
     TemplateBox[{
       RowBox[{
         SubscriptBox[
          StyleBox["e", "TI"], 
          StyleBox["i", "TI"]]}]},
      "Abs"]], 
    StyleBox["O", "TI"], 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox[
       StyleBox["e", "TI"], 
       StyleBox["i", "TI"]], 
      SubscriptBox[
       StyleBox["e", "TI"], 
       StyleBox["j", "TI"]]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "66791666-5886-4665-a27e-ab410ba07298"],
 ". This sign turns the graded symmetric pairing of degree ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "28881b90-7809-4955-bbde-5f8c562f6f67"],
 " into a graded antisymmetric one of degree ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["n", "TI"], "-", "2"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f4326e5d-637b-444a-93b6-cc6153afba1d"],
 "."
}], "Notes",ExpressionUUID->"d1551026-ebfb-4d8a-8f58-e072167e6c6b"],

