   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "8c3d07c6-3de1-47d8-9fef-04746b8b1004"],
 " give a pairing object again."
}], "Notes",ExpressionUUID->"075e7fc5-3957-47b1-be6d-f32514751522"],

