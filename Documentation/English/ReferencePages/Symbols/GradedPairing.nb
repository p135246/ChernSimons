Notebook[{

Cell[CellGroupData[{
Cell["GradedPairing", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"50119380-d662-4455-b390-b85385295098"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["GradedPairing"]], "paclet:ChernSimons/ref/GradedPairing", 
     "ChernSimons Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["degrees", "TI"], ",", " ", 
    StyleBox["spec", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cc8dbfb0-9e02-4868-919d-7f1a6a5301f9"],
 "\[LineSeparator]",
 "builds the pairing object of a graded alphabet, from an association ",
 StyleBox["degrees", "TI"],
 " of particles to their degrees and a specification ",
 StyleBox["spec", "TI"],
 " of the pairing values.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"b83abbb0-5b16-4757-9fba-56f1a690aee8"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["GradedPairing"]], "paclet:ChernSimons/ref/GradedPairing", 
     "ChernSimons Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["degrees", "TI"], ",", " ", 
    StyleBox["spec", "TI"], ",", " ", 
    StyleBox["dualDegrees", "TI"], ",", " ", 
    StyleBox["evaluation", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b592dfa6-afed-44fd-90a2-df7ca3229815"],
 "\[LineSeparator]",
 "attaches a dual alphabet, so that the resulting object also carries the \
evaluation of words on dual words.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"41d7fc93-0d75-4da6-89b2-2ea62047e3d4"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["GradedPairing"]], "paclet:ChernSimons/ref/GradedPairing", 
     "ChernSimons Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["algebra", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "32b36867-df26-4902-bb7f-372b5dbf39e9"],
 "\[LineSeparator]",
 "builds the pairing object of a Poincar\[EAcute] duality algebra, as ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["NondegenerateQuotient"]], 
    "paclet:ChernSimons/ref/NondegenerateQuotient", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "00972c3d-fb43-43b6-8e2a-f58410d186c1"],
 " returns one, taking its basis monomials as the particles.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"943d69f7-6892-4f9b-a67e-a3fc12a4c8c6"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["GradedPairing"]], "paclet:ChernSimons/ref/GradedPairing", 
     "ChernSimons Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["algebra", "TI"], ",", " ", 
    StyleBox["particles", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "55ae9da2-bd21-48fa-a163-78485159ab4d"],
 "\[LineSeparator]",
 "names the particles instead."
}], "Usage",ExpressionUUID->"38cfc053-adc1-430e-a6bd-bbd4b4589c63"],

Cell[TextData[{
 "The pairing object is the single piece of data every other operation in the \
paclet takes as its last argument. It is a plain ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Association"]], "paclet:ref/Association"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d9cae396-8640-42da-bb6c-dea10c7764ba"],
 ", not an opaque object, so it can be inspected, edited and stored like any \
other expression."
}], "Notes",ExpressionUUID->"e99d7d4e-9d77-4d23-a4a2-aa986c9779d0"],

Cell[TextData[{
 StyleBox["degrees", "TI"],
 " is an association from particles to integer degrees. A particle is an \
arbitrary expression, usually a symbol; multi-character names are fine."
}], "Notes",ExpressionUUID->"a64a35aa-39cd-473a-99e2-29054794862d"],

Cell[TextData[{
 StyleBox["spec", "TI"],
 " is either a function of two particles, or an association giving some of \
the values. In the association form the remaining values are completed by \
graded antisymmetry, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{
      StyleBox["q", "TI"], ",", 
      StyleBox["p", "TI"]}], "\[RightAngleBracket]"}], "\[LongEqual]", "-", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"-", "1"}], ")"}], 
     TemplateBox[{
       RowBox[{
         StyleBox["p", "TI"], "||", 
         StyleBox["q", "TI"]}]},
      "Abs"]], 
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{
      StyleBox["p", "TI"], ",", 
      StyleBox["q", "TI"]}], "\[RightAngleBracket]"}]}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "36daff7c-c9a9-46e1-a015-b632e1bafcd4"],
 ", and every pair left unmentioned is ",
 Cell[BoxData[
  FormBox["0", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "72677416-27d0-47e0-8b21-cfa473e52d98"],
 "."
}], "Notes",ExpressionUUID->"fec7a5ff-4c7e-4efb-939e-06eeac6bb5ac"],

Cell[TextData[{
 "The result has the keys ",
 Cell[BoxData["\"\<Degrees\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c337fd39-c16e-4eae-a2ef-8d04a586a352"],
 ", ",
 Cell[BoxData["\"\<Values\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "07bf77cb-a9a6-40db-9d26-440fc713e883"],
 ", ",
 Cell[BoxData["\"\<Degree\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1bf0b63b-df08-4abb-8dd2-affdb64bd6ab"],
 " and ",
 Cell[BoxData["\"\<Convention\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "64536df8-c7c5-4e12-818a-2511513d8b07"],
 ", plus ",
 Cell[BoxData["\"\<Dual\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ef4eafd7-cea9-4218-a9c5-7883cf39285c"],
 " in the four-argument form."
}], "Notes",ExpressionUUID->"794f47b8-a5c5-4949-9078-d7b0ef78be95"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "2aa2ddbf-e683-44f2-be99-77da3e1404b8"], Cell["key", "TableText",
     FontWeight->Bold,ExpressionUUID->"998e4455-30a0-4faa-a5bd-a05024451bdc"],
     Cell["value", "TableText",
     FontWeight->Bold,ExpressionUUID->"e98907f1-bf2f-447e-b84c-ad52a4180381"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "091f8748-770f-40d9-853a-7845ed3bac39"], Cell[TextData[Cell[
    BoxData["\"\<Degrees\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "2ecc659a-cdcb-48d0-8b17-cb87c7fe69f3"]], "TableText",ExpressionUUID->
     "481c8a33-8ec1-453b-8a25-c8b8ccaab28f"], Cell[TextData[{
     "the ",
     StyleBox["degrees", "TI"],
     " association, verbatim"
    }], "TableText",ExpressionUUID->"6dde8170-d251-473a-b9c2-4d9f28751224"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "988cb44c-7f21-4f25-b55f-6695df01703c"], Cell[TextData[Cell[
    BoxData["\"\<Values\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "495348d0-db57-4f49-890d-d1800f6ee187"]], "TableText",ExpressionUUID->
     "7f8c23d8-b72b-4eff-9be5-7b93a19eaed6"], Cell["\<\
the completed pairing, an association from ordered pairs of particles to \
their value\
\>", "TableText",ExpressionUUID->"6dbb888f-646b-4e71-a445-164f5a5c4ff9"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "eb30c20e-98e5-4e7e-ba97-a8549f60d304"], Cell[TextData[Cell[
    BoxData["\"\<Degree\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "a16a285d-6b03-446a-af6e-7edc1686ff79"]], "TableText",ExpressionUUID->
     "b4a72ed6-69b1-409e-9b76-34cefd23f609"], Cell[TextData[{
     "the common degree ",
     Cell[BoxData[
      FormBox[
       TemplateBox[{
         RowBox[{
           StyleBox["p", "TI"], "|", "+", "|", 
           StyleBox["q", "TI"]}]},
        "Abs"], TraditionalForm]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "c3460412-c269-40ca-a7d1-2ef25ad13797"],
     " over all pairs with ",
     Cell[BoxData[
      FormBox[
       RowBox[{
        RowBox[{"\[LeftAngleBracket]", 
         RowBox[{
          StyleBox["p", "TI"], ",", 
          StyleBox["q", "TI"]}], "\[RightAngleBracket]"}], "\[NotEqual]", 
        "0"}], TraditionalForm]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "3139c729-9fef-476c-8f10-84ef0a9814f2"]
    }], "TableText",ExpressionUUID->"dc827200-87d7-4aa4-8f0b-c10fe9274884"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "ccadba44-9b71-41c7-8cb5-d0c0545cc835"], Cell[TextData[Cell[
    BoxData["\"\<Convention\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "d462fa15-8aac-44c3-b496-edd70ae40755"]], "TableText",ExpressionUUID->
     "6d12594d-337f-444f-a652-dc2d4cf2de0e"], Cell[TextData[{
     Cell[BoxData["\"\<Symmetric\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "7ad8ac2a-b951-4587-ba89-2ce2588fa628"],
     " by default, ",
     Cell[BoxData["\"\<Exterior\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "f648a6fe-d125-4be3-a227-e7fd90cf1a85"],
     " to work in the exterior picture"
    }], "TableText",ExpressionUUID->"93d6dd88-0508-4fbf-a6c6-909ef5626713"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "85d09a57-2168-40a8-bdfe-3ec87614c092"], Cell[TextData[Cell[
    BoxData["\"\<Dual\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "843149f8-3d18-4975-b615-e1f92b4b0bac"]], "TableText",ExpressionUUID->
     "5f4ddcda-5d8b-4e3a-af30-0ec260b0a25d"], Cell[TextData[{
     "an association with its own ",
     Cell[BoxData["\"\<Degrees\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "b990f52d-af06-4506-b2dc-058f78d8dfe7"],
     " and ",
     Cell[BoxData["\"\<Values\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "463ba38f-2ec2-4f97-8401-0fe701d2cdab"],
     ", present only in the four-argument form"
    }], "TableText",ExpressionUUID->"2b24a6b8-837a-4738-8f66-587ae97cd397"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "566bc6ab-29e8-4da4-9005-338a73937d84"], Cell[TextData[Cell[
    BoxData["\"\<Algebra\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "ea678767-9e6c-4d13-b7a6-6f833e647daa"]], "TableText",ExpressionUUID->
     "3abe75df-c8c6-4210-83ff-0b774ea79079"], Cell["\<\
the Poincar\[EAcute] duality algebra, present only in the forms built from one\
\>", "TableText",ExpressionUUID->"e42a03da-2b79-4195-ab83-3233719d872b"]}
  }]], "2ColumnTableMod",ExpressionUUID->"bc65897a-fd7d-4c68-b36f-\
eed7892114a8"],

Cell[TextData[{
 "In the forms built from an algebra the particles are a basis of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["H", "TI"], 
    RowBox[{"[", "1", "]"}]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "da25e44d-48b3-4caa-af3f-1fcedb8ebc30"],
 ": a particle for the basis vector ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["e", "TI"], 
    StyleBox["i", "TI"]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "789a56ae-a7b0-40b2-a98b-abb200416e3d"],
 " has degree ",
 Cell[BoxData[
  FormBox[
   RowBox[{"|", 
    SubscriptBox[
     StyleBox["e", "TI"], 
     StyleBox["i", "TI"]], "|", "-", "1"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b86fe11d-039d-4452-9272-7eccac38a2b9"],
 ", and the values are ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{
      StyleBox["s", "TI"], 
      SubscriptBox[
       StyleBox["e", "TI"], 
       StyleBox["i", "TI"]], ",", 
      StyleBox["s", "TI"], 
      SubscriptBox[
       StyleBox["e", "TI"], 
       StyleBox["j", "TI"]]}], "\[RightAngleBracket]"}], "\[LongEqual]", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"-", "1"}], ")"}], 
     TemplateBox[{
       RowBox[{
         SubscriptBox[
          StyleBox["e", "TI"], 
          StyleBox["i", "TI"]]}]},
      "Abs"]], 
    StyleBox["O", "TI"], 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox[
       StyleBox["e", "TI"], 
       StyleBox["i", "TI"]], 
      SubscriptBox[
       StyleBox["e", "TI"], 
       StyleBox["j", "TI"]]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "509cd073-e848-4d9d-a3a7-5fe7df990df7"],
 " \[LongDash] the sign that turns the graded symmetric pairing of degree ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dfddb18c-1452-4d5b-a27f-9635ac08a1e7"],
 " into a graded antisymmetric one of degree ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["n", "TI"], "-", "2"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4f8e485d-37d9-4be0-bee6-cd0882714d24"],
 ", which is the pairing degree the operations want. The ",
 Cell[BoxData["\"\<Algebra\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0fc29f98-68dc-44c5-b289-ee018d1ff806"],
 " key is what ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CanonicalMaurerCartan"]], 
    "paclet:ChernSimons/ref/CanonicalMaurerCartan", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "6d27b470-54bc-41fd-880b-9715be9f5f6e"],
 " reads the triple product from."
}], "Notes",ExpressionUUID->"e794a614-fd25-40ce-ad71-074da4adc8e3"],

Cell[TextData[{
 "The convention is what selects the picture every later operation works in: ",
 Cell[BoxData["\"\<Symmetric\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d25d47e5-63c0-40b8-b48d-65ece5696650"],
 " uses the ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SymmetricProduct"]], "paclet:ChernSimons/ref/SymmetricProduct",
     "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "7548cf59-b7ca-43c7-888e-7fc2386c6b7a"],
 " grading ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     RowBox[{"[", "-", "]"}], "1"], "\[LongEqual]", 
    RowBox[{"[", "-", "]"}], "-", "1"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "391391a4-6dbd-4700-88aa-19ab8951fc99"],
 ", ",
 Cell[BoxData["\"\<Exterior\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "eca2b8f7-a379-47d0-80eb-eab5af31564e"],
 " the ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ExteriorProduct"]], "paclet:ChernSimons/ref/ExteriorProduct", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "10e13a3e-3b23-4ca2-b7e2-0eb799d9d61c"],
 " grading ",
 Cell[BoxData[
  FormBox[
   RowBox[{"[", "-", "]"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3262266e-b5b0-42a7-953f-8a8b781540e0"],
 ". Change it by resetting the key \[LongDash] ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["Append",
    BaseStyle->"Link"], "[", 
   RowBox[{
    StyleBox["pairing", "TI"], ",", " ", 
    RowBox[{"\"\<Convention\>\"", " ", "->", " ", "\"\<Exterior\>\""}]}], 
   "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d31ff2cb-ac10-40bc-b852-9419305ea0e1"],
 "."
}], "Notes",ExpressionUUID->"11860705-9189-4b66-bfcb-2600a7824deb"],

Cell[TextData[{
 "The pairing must be homogeneous: if the nonzero values do not all have one \
degree ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{
     RowBox[{
       StyleBox["p", "TI"], "|", "+", "|", 
       StyleBox["q", "TI"]}]},
    "Abs"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f7c4ec52-1006-4784-8d4b-99d649a7e5d4"],
 ", ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["GradedPairing"]], "paclet:ChernSimons/ref/GradedPairing", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "b5b4a93e-bc18-4cd9-9eeb-1d501d9473dc"],
 " issues ",
 Cell[BoxData[
  RowBox[{"GradedPairing", "::", "degree"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c33467a1-9439-4c97-b315-1e639fd81f33"],
 " and aborts."
}], "Notes",ExpressionUUID->"e5620e21-cf3e-47a2-a415-03041a9f7ea7"],

Cell[TextData[{
 StyleBox["evaluation", "TI"],
 " in the four-argument form gives ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[LeftAngleBracket]", 
    RowBox[{
     StyleBox["p", "TI"], ",", "\[Alpha]"}], "\[RightAngleBracket]"}], 
   TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ec094e5d-5978-4fbc-a725-01beb4c4343c"],
 " for a particle ",
 StyleBox["p", "TI"],
 " and a dual particle ",
 Cell[BoxData[
  FormBox["\[Alpha]", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "449b7b52-35e8-4dba-82de-ff5dbd6ebfd8"],
 "; it is read by ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DualPairing"]], "paclet:ChernSimons/ref/DualPairing", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "2db8dbd4-4195-4547-b358-8f7e1f5f5568"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ProductPairing"]], "paclet:ChernSimons/ref/ProductPairing", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "f477a5da-ec6c-4609-81ae-8e6b968986a3"],
 ", which abort without it."
}], "Notes",ExpressionUUID->"b980e092-e20f-4bbd-8f8e-39590729a000"],

Cell[TextData[{
 "The object displays as a summary box: the alphabet, the degree of the \
pairing and the convention, with the degrees, the matrix of values, the dual \
alphabet and the algebra under the opener. That is a display only \[LongDash] \
",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Normal"]], "paclet:ref/Normal"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "de6c7ed3-f3d4-452d-9c1a-6402a6e5efbe"],
 " gives the association back, and the copied box is the object itself."
}], "Notes",ExpressionUUID->"0eaa8708-ee83-4de9-91fc-4f65970189d9"]
}, Open  ]],

Cell[CellGroupData[{

