Cell[TextData[{
 "The nonzero values must all have one degree ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{
     RowBox[{
       StyleBox["p", "TI"], "|", "+", "|", 
       StyleBox["q", "TI"]}]},
    "Abs"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "94d16e09-85df-4317-8fd1-6405d1750c9c"],
 ". Otherwise the result is a ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Failure"]], "paclet:ref/Failure"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4649a754-b42a-410a-b69a-0fd447e268ae"],
 " whose message says that the pairing has no well-defined degree, and whose ",
 Cell[BoxData["\"\<Degrees\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ad1ec6ba-c3b6-45a9-aae3-ec04cf4b798e"],
 " lists the degrees found."
}], "Notes",ExpressionUUID->"35e37441-04fb-4071-bbf5-efd8d92f3954"],

Cell[TextData[{
 "The convention selects the picture every later operation works in: ",
 Cell[BoxData["\"\<Symmetric\>\""], "InlineFormula",
