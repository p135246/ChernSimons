Cell[CellGroupData[{
Cell["SullivanModelBasis", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"fb19016b-a6f1-49e7-b361-cf1dae76e5a8"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["SullivanModelBasis"]], 
     "paclet:ChernSimons/ref/SullivanModelBasis", 
     "ChernSimons Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["model", "TI"], ",", " ", 
    StyleBox["k", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8362c810-39fd-4a3d-95a1-c682bc991da1"],
 "\[LineSeparator]",
 "lists the monomials of degree ",
 StyleBox["k", "TI"],
 " in the model.",
 "\n"
}], "Usage",ExpressionUUID->"4f72c74f-a7b9-40bd-b037-73203164af1d"],

Cell[TextData[{
 "Each monomial is written as a product of generators in the order the model \
declares them, the empty monomial being ",
 Cell[BoxData["1"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6b736792-008a-49bc-b891-bd7612924490"],
 ". A generator of odd degree occurs at most once; one of even degree may \
occur any number of times."
}], "Notes",ExpressionUUID->"e95f4eec-7a87-4783-a1b6-c2696d215df1"],

Cell["\<\
The list is empty for a negative degree and above the model's truncation \
degree. The model is otherwise infinite-dimensional whenever it has a \
generator of even degree.\
\>", "Notes",ExpressionUUID->"cabf19da-de19-44b4-8039-45f55276ace3"]
}, Open  ]],

