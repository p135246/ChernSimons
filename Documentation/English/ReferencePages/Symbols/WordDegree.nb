     RowBox[{"<|", 
      RowBox[{
       RowBox[{"x", " ", "->", " ", 
        RowBox[{"-", "1"}]}], ",", " ", 
       RowBox[{"y", " ", "->", " ", "0"}]}], "|>"}], ",", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "y"}], "}"}], " ", "->", " ", "1"}], "|>"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"CyclicWords", "[", 
    RowBox[{"4", ",", " ", "pairing", ",", " ", 
     RowBox[{"\"\<UpTo\>\"", " ", "->", " ", "True"}]}], "]"}], ",", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"WordDegree", "[", 
      RowBox[{"#", ",", " ", "pairing", ",", " ", "\"\<Exterior\>\""}], "]"}],
      " ", "===", " ", 
     RowBox[{
      RowBox[{"WordDegree", "[", 
       RowBox[{"#", ",", " ", "pairing"}], "]"}], " ", "+", " ", 
      RowBox[{"pairing", "[", "\"\<Degree\>\"", "]"}]}]}], " ", "&"}]}], 
