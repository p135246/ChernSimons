   RowBox[{
    RowBox[{"CyclicWord", "[", 
     RowBox[{"{", "x", "}"}], "]"}], "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"-", "2"}], ",", 
      RowBox[{"-", "3"}]}], "}"}]}], ",", 
   RowBox[{
    RowBox[{"CyclicWord", "[", 
     RowBox[{"{", "y", "}"}], "]"}], "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"-", "1"}], ",", 
