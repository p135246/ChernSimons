Cell[TextData[{
 "The two-argument form reads only degrees, so ",
 StyleBox["data", "TI"],
 " may be a pairing object or a bare association from particles to degrees."
}], "Notes",ExpressionUUID->"4d76c262-e2ea-4d6c-8633-66f7c09e7922"],

Cell["\<\
The three-argument forms shift by the degree of the pairing and therefore \
need a real pairing object.\
\>", "Notes",ExpressionUUID->"3e7dd4b4-2833-404f-ad1b-bc0e142586b3"],

