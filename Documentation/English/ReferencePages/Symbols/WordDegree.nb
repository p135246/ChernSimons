Cell[TextData[{
 "The two shifted gradings are what make the sign bookkeeping of the two \
pictures differ, and choosing between them is the whole content of the ",
 Cell[BoxData["\"\<Convention\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "12095173-27f2-4c06-9ea9-e48daa2cc412"],
 " key of the pairing object. The symmetric grading is one lower than the \
exterior one, uniformly."
}], "Notes",ExpressionUUID->"68e569d6-0f07-4c96-991c-e46bd9a22b2e"]
}, Open  ]],

