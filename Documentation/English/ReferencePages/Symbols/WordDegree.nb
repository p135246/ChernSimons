Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    RowBox[{"CyclicWord", "[", 
     RowBox[{"{", "x", "}"}], "]"}], "\[Rule]", 
    RowBox[{"-", "1"}]}], ",", 
   RowBox[{
    RowBox[{"CyclicWord", "[", 
     RowBox[{"{", "y", "}"}], "]"}], "\[Rule]", "0"}], ",", 
   RowBox[{
    RowBox[{"CyclicWord", "[", 
     RowBox[{"{", 
      RowBox[{"x", ",", "y"}], "}"}], "]"}], "\[Rule]", 
    RowBox[{"-", "1"}]}], ",", 
   RowBox[{
    RowBox[{"CyclicWord", "[", 
     RowBox[{"{", 
      RowBox[{"y", ",", "y"}], "}"}], "]"}], "\[Rule]", "0"}], ",", 
   RowBox[{
    RowBox[{"CyclicWord", "[", 
     RowBox[{"{", 
