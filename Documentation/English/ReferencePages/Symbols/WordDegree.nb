Cell["The two shifted gradings, side by side:", "ExampleText",ExpressionUUID->"46a8238c-2397-4c7d-ab66-4d066de2db8a"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"pairing", " ", "=", " ", 
   RowBox[{"Pairing", "[", 
    RowBox[{
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"x", " ", "->", " ", 
        RowBox[{"-", "1"}]}], ",", " ", 
       RowBox[{"y", " ", "->", " ", "0"}]}], "|>"}], ",", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "y"}], "}"}], " ", "->", " ", "1"}], "|>"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{"Map", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"#", " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"WordDegree", "[", 
        RowBox[{"#", ",", " ", "pairing", ",", " ", "\"\<Exterior\>\""}], 
        "]"}], ",", " ", 
       RowBox[{"WordDegree", "[", 
        RowBox[{"#", ",", " ", "pairing", ",", " ", "\"\<Symmetric\>\""}], 
        "]"}]}], "}"}]}], " ", "&"}], ",", " ", 
   RowBox[{"CyclicWords", "[", 
    RowBox[{"2", ",", " ", "pairing", ",", " ", 
     RowBox[{"\"\<UpTo\>\"", " ", "->", " ", "True"}]}], "]"}]}], 
  "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"89932826-0c2a-4533-b6f8-a295b6c4dbaf"],

Cell[BoxData[
 RowBox[{"{", 
