Cell["The string algebra of the circle:", "ExampleText",ExpressionUUID->"74842c94-3f95-4e70-b0c1-a80cc072a822"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"StringAlgebra", "[", 
  RowBox[{"GradedPairing", "[", 
   RowBox[{
    RowBox[{"<|", 
     RowBox[{
