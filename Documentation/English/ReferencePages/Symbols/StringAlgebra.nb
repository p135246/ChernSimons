Cell[TextData[{
 "Its relations are ",
 Cell[BoxData["\"\<Jacobi\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bc1db4d3-4963-4a1f-af75-43fa4c167445"],
 " on three words, ",
 Cell[BoxData["\"\<CoJacobi\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c09defce-6202-4363-9d80-d7d9042c3499"],
 " on one, ",
 Cell[BoxData["\"\<Drinfeld\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3fd962fb-78e3-4c26-ae0d-ef68ee9ae207"],
 " on two and ",
 Cell[BoxData["\"\<Involutivity\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fd060e44-f34d-49b1-ba2d-8385ed9297f7"],
 " on one, the defining identities of an involutive bi-Lie algebra. They \
involve the bracket and the co-bracket."
}], "Notes",ExpressionUUID->"9bd98e92-eb76-4534-a8f2-c1a9fb27a9b3"],

