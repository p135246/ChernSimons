Notebook[{

Cell[CellGroupData[{
Cell["InvolutiveBracket", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"d1fa642e-905e-4cad-a3dc-9af3554a5540"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InvolutiveBracket"]], 
     "paclet:ChernSimons/ref/InvolutiveBracket", "ChernSimons Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["u", "TI"], ",", " ", 
    StyleBox["v", "TI"], ",", " ", 
    StyleBox["pairing", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "56884a3a-ce32-4019-b7b4-31a0fdb3d747"],
 "\[LineSeparator]",
 "gives the bracket ",
 Cell[BoxData[
  FormBox[
   RowBox[{"[", 
    RowBox[{
     StyleBox["u", "TI"], ",", 
     StyleBox["v", "TI"]}], "]"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "45d93261-f334-4b33-a4bc-706806ad1d5b"],
 " of two cyclic words, in the convention carried by ",
 StyleBox["pairing", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"61e6e782-90ff-4ddf-ae0f-634986051fac"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InvolutiveBracket"]], 
     "paclet:ChernSimons/ref/InvolutiveBracket", "ChernSimons Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["p", "TI"], ",", " ", 
    StyleBox["pairing", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9221b161-be95-4e65-82ac-ca11d6f8db84"],
 "\[LineSeparator]",
 "applies the extension of the bracket as a derivation to a product ",
 StyleBox["p", "TI"],
 " of any number of factors."
}], "Usage",ExpressionUUID->"5d67791c-007e-4e82-8ba2-b0c4ab09e02d"],

Cell[TextData[{
 "The bracket is the operation ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["q", "TI"], 
    RowBox[{"2", ",", "1", ",", "0"}]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "970ab9fa-8be2-4d07-b212-6dd06c84212d"],
 " of the involutive bi-Lie structure: it takes two cyclic words and returns \
one, contracting one particle of each against the pairing. It is the sum of \
",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ChordContraction"]], "paclet:ChernSimons/ref/ChordContraction",
     "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "2e633b04-cd1b-4e26-8f23-e6e12650e683"],
 " over every pair of positions."
}], "Notes",ExpressionUUID->"199f0e78-494b-439a-b1d8-c67c86787a3e"],

Cell[TextData[{
 "The convention key of ",
 StyleBox["pairing", "TI"],
 " selects the picture. ",
 Cell[BoxData["\"\<Symmetric\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a8d74ba0-a533-4e0f-bb53-a58801c65247"],
 " gives the bracket of the ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SymmetricProduct"]], "paclet:ChernSimons/ref/SymmetricProduct",
     "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "5d59c756-adb8-40c3-87aa-5886772975e8"],
 " grading, ",
 Cell[BoxData["\"\<Exterior\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fb19e6a9-29df-4bc3-9777-f028b9399ab6"],
 " that of the ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ExteriorProduct"]], "paclet:ChernSimons/ref/ExteriorProduct", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "5c6f994f-9efb-4fe5-8c95-310ef1b7ff2a"],
 " grading; the two differ by signs, not by the underlying contraction."
}], "Notes",ExpressionUUID->"03c8c995-e83a-4373-80eb-022ddb180013"],

Cell[TextData[{
 "In the two-argument form the result is the derivation extension ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    OverscriptBox[
     StyleBox["q", "TI"], "^"], 
    RowBox[{"2", ",", "1", ",", "0"}]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "39e55c40-1104-4ead-ac0f-4a8d2c21ff38"],
 ": the bracket is applied to each pair of factors in turn, with the Koszul \
sign of the shuffle, and the remaining factors are carried along. The \
extension lowers the number of factors by one, and a single remaining factor \
is returned as the word itself."
}], "Notes",ExpressionUUID->"46fe90a2-2433-4e53-a74f-c33a4bd636cc"],

Cell["\<\
Both forms are linear: they distribute over sums and pull scalars out. That \
is what lets them be composed, with the products, whose normalized form \
carries a sign whenever the factors have to be reordered, and with each other.\
\>", "Notes",ExpressionUUID->"5c051afa-8a94-484f-9df3-002720851289"],

Cell["A word may be given as the list of its particles.", "Notes",ExpressionUUID->"b43e7d92-ccd7-4397-b69c-56ce6d1b9df5"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "b642863a-fc26-445b-bc24-cac068b7a9f1"], Cell["option", "TableText",
     FontWeight->Bold,ExpressionUUID->"550841c0-dc92-4a14-9e14-5c4b4f4a3eec"],
