Cell[TextData[{
 StyleBox["The extension lowers the number of factors by one, so on a single \
cyclic word it is ",
  FontWeight->"Bold"],
 Cell[BoxData[
  FormBox["0", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,
  FontWeight->"Bold",ExpressionUUID->"40fcdb81-1197-46ff-910e-9b294338a3d6"],
 StyleBox[".",
  FontWeight->"Bold"],
 " A forgotten second argument therefore returns ",
 Cell[BoxData[
  FormBox["0", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1e158ffd-582e-448e-90ee-f6f0c5955be0"],
 " rather than staying unevaluated: ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InvolutiveBracket"]], 
     "paclet:ChernSimons/ref/InvolutiveBracket", "ChernSimons Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["u", "TI"], ",", " ", 
    StyleBox["pairing", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "51e945a0-3a49-468f-862c-1b74182051a8"],
 " is the extension applied to ",
 StyleBox["u", "TI"],
 ", not the bracket of ",
 StyleBox["u", "TI"],
 " with something."
}], "ExampleText",ExpressionUUID->"b5874d3b-c4a6-4d5d-9f81-361618faddb7"],

