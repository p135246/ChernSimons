     "368e97ab-fb40-4151-96dc-3920be5c10d3"], Cell[TextData[{
     "whether the contraction of two one-particle words is kept as the empty \
word ",
     Cell[BoxData[
      RowBox[{
       TemplateBox[{
         Cell[
          TextData["CyclicWord"]], "paclet:ChernSimons/ref/CyclicWord", 
         "ChernSimons Package Symbol"},
        "PackageLink",
        BaseStyle->"InlineFormula"], "[", 
       RowBox[{"{", "}"}], "]"}]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "b6f6d296-1714-4981-a741-c6b4097fca2d"],
     " rather than set to ",
     Cell[BoxData[
      FormBox["0", TraditionalForm]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "b2595203-446e-4e3e-8c27-08b6988ca8f1"]
    }], "TableText",ExpressionUUID->"a0c977c3-a20e-438f-a7de-925a6aba8ef5"]}
  }]], "3ColumnTableMod",ExpressionUUID->"4a9e6c3d-c246-432f-8280-\
ddb8bc8aa3ce"],

Cell[TextData[{
 "Without the option the bracket is that of the positive-length convention of \
the paper. With it the bracket is that of the empty-word extension, in which \
the empty word is a word of degree ",
 Cell[BoxData[
  FormBox["0", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2478a5ad-4f0a-4374-bf9b-1847e2887df8"],
 "; the empty word is central, so its bracket with anything is ",
 Cell[BoxData[
  FormBox["0", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1b40ace3-83b7-4405-b329-39a75a63c975"],
 " in both conventions."
}], "Notes",ExpressionUUID->"bb221b30-d2b6-4f9f-883b-91733df08df2"],

Cell[TextData[{
 "The identities the bracket satisfies are the business of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["JacobiObstruction"]], 
    "paclet:ChernSimons/ref/JacobiObstruction", "ChernSimons Package Symbol"},
   
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "9cbf64c3-e027-4a91-a95c-22c1625d24e5"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DrinfeldObstruction"]], 
    "paclet:ChernSimons/ref/DrinfeldObstruction", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "73c4c726-96b2-445c-a426-591ef5b5ecde"],
 ", swept over a range of word lengths to search for a counterexample."
}], "Notes",ExpressionUUID->"2f821fda-40c7-4acb-b98c-352a46833072"]
}, Open  ]],

