The bracket satisfies the graded Jacobi identity throughout the enumerated \
range:\
\>", "ExampleText",ExpressionUUID->"65ae149e-86d2-4203-b4ed-05e05904875a"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"words", "[", "n_", "]"}], " ", ":=", " ", 
   RowBox[{"CyclicWords", "[", 
    RowBox[{"n", ",", " ", 
     RowBox[{"GradedPairing", "[", 
      RowBox[{
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"x", " ", "->", " ", 
          RowBox[{"-", "1"}]}], ",", " ", 
         RowBox[{"y", " ", "->", " ", "0"}]}], "|>"}], ",", " ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"x", ",", " ", "y"}], "}"}], " ", "->", " ", "1"}], 
        "|>"}]}], "]"}], ",", " ", 
     RowBox[{"\"\<UpTo\>\"", " ", "->", " ", "True"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"DeleteDuplicates", "[", 
  RowBox[{"Map", "[", 
   RowBox[{
    RowBox[{"t", " ", "|->", " ", 
     RowBox[{"JacobiObstruction", "[", 
      RowBox[{
       RowBox[{"t", "[", 
        RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
       RowBox[{"t", "[", 
        RowBox[{"[", "2", "]"}], "]"}], ",", " ", 
       RowBox[{"t", "[", 
        RowBox[{"[", "3", "]"}], "]"}], ",", " ", 
       RowBox[{"GradedPairing", "[", 
        RowBox[{
         RowBox[{"<|", 
          RowBox[{
           RowBox[{"x", " ", "->", " ", 
            RowBox[{"-", "1"}]}], ",", " ", 
           RowBox[{"y", " ", "->", " ", "0"}]}], "|>"}], ",", " ", 
         RowBox[{"<|", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"x", ",", " ", "y"}], "}"}], " ", "->", " ", "1"}], 
          "|>"}]}], "]"}]}], "]"}]}], ",", " ", 
    RowBox[{"Tuples", "[", 
     RowBox[{
      RowBox[{"words", "[", "3", "]"}], ",", " ", "3"}], "]"}]}], "]"}], 
  "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"5bc4c42b-32fd-4e11-880a-943d8ffcd3b3"],

