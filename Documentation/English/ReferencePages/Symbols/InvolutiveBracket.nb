Cell[TextData[{
 StyleBox["The convention of ",
  FontWeight->"Bold"],
 StyleBox["pairing", "TI",
  FontWeight->"Bold"],
 StyleBox[" must match the head of ",
  FontWeight->"Bold"],
 StyleBox["p", "TI",
  FontWeight->"Bold"],
 StyleBox[".",
  FontWeight->"Bold"],
 " The extension is defined for a ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SymmetricProduct"]], "paclet:ChernSimons/ref/SymmetricProduct",
     "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "dfe2ede8-d261-4a95-a89a-67dc60154322"],
 " under ",
 Cell[BoxData["\"\<Symmetric\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "220ba24b-5865-4194-a9fe-7ee95740169e"],
 " and for an ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ExteriorProduct"]], "paclet:ChernSimons/ref/ExteriorProduct", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "a9f5ec4f-42f0-40b1-80d8-1efdb57aec36"],
 " under ",
 Cell[BoxData["\"\<Exterior\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "420855ee-f3f9-43de-9b4e-ce1c6fb47303"],
 ", so handing one to the other leaves the call unevaluated instead of \
returning a product of cyclic words. Rebuild the product with the pairing it \
is to be used with."
}], "ExampleText",ExpressionUUID->"782c12ef-46a7-463c-8aeb-bf5860217d05"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"pairing", " ", "=", " ", 
   RowBox[{"GradedPairing", "[", 
    RowBox[{
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"x", " ", "->", " ", 
        RowBox[{"-", "1"}]}], ",", " ", 
       RowBox[{"y", " ", "->", " ", "0"}]}], "|>"}], ",", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "y"}], "}"}], " ", "->", " ", "1"}], "|>"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"exterior", " ", "=", " ", 
   RowBox[{"Append", "[", 
    RowBox[{"pairing", ",", " ", 
     RowBox[{"\"\<Convention\>\"", " ", "->", " ", "\"\<Exterior\>\""}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{"Head", "[", 
  RowBox[{"InvolutiveBracket", "[", 
   RowBox[{
    RowBox[{"SymmetricProduct", "[", 
     RowBox[{
      RowBox[{"CyclicWord", "[", 
       RowBox[{"{", "x", "}"}], "]"}], ",", " ", 
      RowBox[{"CyclicWord", "[", 
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "y"}], "}"}], "]"}], ",", " ", "pairing"}], 
     "]"}], ",", " ", "exterior"}], "]"}], "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"71eff15a-65b6-468e-9956-14934e8e9928"],

Cell[BoxData["InvolutiveBracket"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"0378e22c-2763-4ed2-a530-312357b60086"]
