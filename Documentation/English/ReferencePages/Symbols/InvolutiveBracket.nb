     RowBox[{"InvolutiveBracket", "[", 
      RowBox[{"p", ",", " ", "pairing"}], "]"}], ",", " ", "pairing"}], 
    "]"}]}], "}"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"268d0729-b4f0-468c-aeb8-69dd5a6613aa"],

