Cell["The bracket of two words of the circle:", "ExampleText",ExpressionUUID->"85ccc3f6-8d63-4b33-842e-584bfc4fd26b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"InvolutiveBracket", "[", 
  RowBox[{
   RowBox[{"CyclicWord", "[", 
    RowBox[{"{", "x", "}"}], "]"}], ",", " ", 
   RowBox[{"CyclicWord", "[", 
    RowBox[{"{", 
     RowBox[{"x", ",", " ", "y"}], "}"}], "]"}], ",", " ", 
   RowBox[{"GradedPairing", "[", 
    RowBox[{
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"x", " ", "->", " ", 
        RowBox[{"-", "1"}]}], ",", " ", 
       RowBox[{"y", " ", "->", " ", "0"}]}], "|>"}], ",", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "y"}], "}"}], " ", "->", " ", "1"}], "|>"}]}], 
    "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"3693281f-9e64-4f36-8ad9-367a12909bf7"],

Cell[BoxData[
 RowBox[{"-", 
  InterpretationBox[
   RowBox[{"(", "x", ")"}],
   ChernSimons`CyclicWord[{MTNB$q0e7pk0nndq8`x}],
   Editable->False]}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"9bb4ec44-aca9-4083-948f-6b6ac9838593"]
}, Open  ]],

