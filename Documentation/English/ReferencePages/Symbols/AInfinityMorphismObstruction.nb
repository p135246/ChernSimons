Cell["The identity is a morphism, so the obstruction vanishes:", "ExampleText",ExpressionUUID->"a21c072c-d8e9-4954-8a40-37a5868d906d"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"assoc", " ", "=", " ", 
   RowBox[{"AInfinityAlgebra", "[", 
    RowBox[{
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"u", " ", "->", " ", 
        RowBox[{"-", "1"}]}], ",", " ", 
       RowBox[{"v", " ", "->", " ", 
        RowBox[{"-", "1"}]}]}], "|>"}], ",", "\n", "   ", 
     RowBox[{"t", " ", "|->", " ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Length", "[", "t", "]"}], " ", "===", " ", "2"}], ",", " ", 
        
        RowBox[{"Switch", "[", 
         RowBox[{"t", ",", " ", 
          RowBox[{"{", 
           RowBox[{"u", ",", " ", "u"}], "}"}], ",", " ", "u", ",", " ", 
          RowBox[{"{", 
           RowBox[{"u", ",", " ", "v"}], "}"}], ",", " ", "v", ",", " ", 
          RowBox[{"{", 
           RowBox[{"v", ",", " ", "u"}], "}"}], ",", " ", "v", ",", " ", "_", 
          ",", " ", "0"}], "]"}], ",", " ", "0"}], "]"}]}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{"AInfinityMorphismObstruction", "[", 
  RowBox[{"assoc", ",", " ", "assoc", ",", " ", 
   RowBox[{"t", " ", "|->", " ", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Length", "[", "t", "]"}], " ", "===", " ", "1"}], ",", " ", 
      RowBox[{"First", "[", "t", "]"}], ",", " ", "0"}], "]"}]}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"u", ",", " ", "v", ",", " ", "u"}], "}"}]}], "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"b5466599-2f99-4953-83b3-0b0e2d6f11f2"],

Cell[BoxData["0"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"a3688c62-0428-440e-b2de-9eb1f151a51d"]
}, Open  ]],

