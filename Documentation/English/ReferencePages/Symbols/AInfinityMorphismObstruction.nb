Cell[CellGroupData[{
Cell["AInfinityMorphismObstruction", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"58097281-bdff-4951-9331-d27968baf309"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["AInfinityMorphismObstruction"]], 
     "paclet:ChernSimons/ref/AInfinityMorphismObstruction", 
     "ChernSimons Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["source", "TI"], ",", " ", 
    StyleBox["target", "TI"], ",", " ", 
    StyleBox["f", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["e1", "TI"], ",", " ", "\[Ellipsis]", ",", " ", 
      StyleBox["en", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "74f6e28d-bce8-4171-8c02-6cbb5f5eb906"],
 "\[LineSeparator]",
 "gives the obstruction of the morphism relation for the collection ",
 StyleBox["f", "TI"],
 "; ",
 Cell[BoxData[
  FormBox["0", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "427abb04-06e5-4099-b6d5-3b9ac9be3474"],
 " means it holds there.",
 "\n"
}], "Usage",ExpressionUUID->"41fc5078-9e15-4118-b332-4ed0419f4c98"],

Cell[TextData[{
 StyleBox["f", "TI"],
 " is a function of a list of source basis elements giving ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["f", "TI"], 
    StyleBox["k", "TI"]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "de8f9c0c-5eb8-4d75-a861-1e3ed893389a"],
 " on it, as an element of the target. It is extended multilinearly, like an \
algebra's own products, so it can take the output of an inner operation."
}], "Notes",ExpressionUUID->"f9312e13-99c3-4ed6-9e73-c648a637bced"],

Cell[TextData[{
 "The left-hand side carries the same shifted signs as ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["AInfinityObstruction"]], 
    "paclet:ChernSimons/ref/AInfinityObstruction", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "1ccb7a4c-daad-4e34-a966-193bf4760d52"],
 ". The right-hand side sums over ",
 StyleBox["all",
  FontWeight->"Bold"],
 " compositions of the arguments into blocks, so a target with operations \
beyond ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["m", "TI"], "2"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5938ec66-0032-4520-adbe-590709864a18"],
 " is handled; when the target is a strictly associative algebra only the \
two-block terms survive."
}], "Notes",ExpressionUUID->"ed77d153-06f9-4a70-a08e-7d92f4cfe510"]
}, Open  ]],

