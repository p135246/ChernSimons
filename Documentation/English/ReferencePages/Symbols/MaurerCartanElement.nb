Cell["\<\
The element displays as a summary box: the keys of its parts and the \
alphabet, with the convention and the parts themselves under the opener.\
\>", "Notes",ExpressionUUID->"c161e68d-41b3-4d3c-a3e7-bf45b0e2d229"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["MaurerCartanElement"]], 
    "paclet:ChernSimons/ref/MaurerCartanElement", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "1551abcf-575b-4d8a-973b-2d7b55867d57"],
 " returns unevaluated when a term of ",
 StyleBox["s", "TI"],
 " is not a scalar times ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[HBar]", 
    StyleBox["g", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "7e177458-91f1-4689-ae49-f95d24ea4039"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["g", "TI"], "\[GreaterEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"13858d27-b4b3-4124-bffa-c5ed02e1627a"],
 ", times one cyclic word or one product."
}], "Notes",ExpressionUUID->"8407ae61-ead5-4e60-95be-39dbfede13ab"],

Cell["\<\
It returns unevaluated when a product carries the head of the other \
convention.\
\>", "Notes",ExpressionUUID->"2922ee13-a886-4d59-a99c-c14009d6242e"],

Cell[TextData[{
 "In the first form it returns unevaluated when a key is not ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"\[ScriptL]", ",", 
     StyleBox["g", "TI"]}], "}"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"1157fbfe-3848-486a-ab6c-ca9c4a231976"],
 " with ",
