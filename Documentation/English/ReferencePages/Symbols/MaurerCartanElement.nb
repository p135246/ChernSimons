Cell["MaurerCartanElement", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"17a221ae-94b9-4fe2-83a1-0799952b2437"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
