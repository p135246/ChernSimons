   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "ab2e8969-5de9-4b9a-8570-a7b9f6379a32"],
 " returns unevaluated when a term of ",
 StyleBox["s", "TI"],
 " is not a scalar times ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[HBar]", 
    StyleBox["g", "TI"]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "692f3143-9227-4a87-99c3-7f7bb6ee36da"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["g", "TI"], "\[GreaterEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "34c81033-3d11-4abb-9cd6-9f7f991db821"],
 ", times one cyclic word or one product."
}], "Notes",ExpressionUUID->"75f1275c-b513-49a7-bce2-7fd3aa4880ca"],

Cell["\<\
It returns unevaluated when a product carries the head of the other \
convention.\
\>", "Notes",ExpressionUUID->"aa479754-f5d1-4245-ade1-a39f5cb1cad2"],

