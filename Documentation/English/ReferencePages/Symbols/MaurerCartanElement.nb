Cell["\<\
The element displays as a summary box: the keys of its parts and the \
alphabet, with the convention and the parts themselves under the opener.\
\>", "Notes",ExpressionUUID->"79fb6463-a67a-4dd1-b045-4d4df48e2124"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["MaurerCartanElement"]], 
