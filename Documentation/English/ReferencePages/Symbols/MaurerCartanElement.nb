Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"MaurerCartanElement", "[", 
   RowBox[{
    RowBox[{"CyclicWord", "[", 
     RowBox[{"{", 
      RowBox[{"x", ",", " ", "y", ",", " ", "x"}], "}"}], "]"}], ",", " ", 
