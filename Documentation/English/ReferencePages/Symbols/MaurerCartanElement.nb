Cell["\<\
The Chern-Simons truncation of the circle, from its two parts:\
\>", "ExampleText",ExpressionUUID->"ed781f4a-a470-4e56-83dd-3f4c90dc6d54"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"m", " ", "=", " ", 
  RowBox[{"MaurerCartanElement", "[", 
   RowBox[{
    RowBox[{"<|", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "0"}], "}"}], " ", "->", " ", 
       RowBox[{"CyclicWord", "[", 
        RowBox[{"{", 
         RowBox[{"x", ",", " ", "x", ",", " ", "y"}], "}"}], "]"}]}], ",", 
      " ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"2", ",", " ", "0"}], "}"}], " ", "->", " ", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{"(", 
          RowBox[{"1", "/", "48"}], ")"}]}], " ", 
        RowBox[{"SymmetricProduct", "[", 
         RowBox[{
          RowBox[{"{", "y", "}"}], ",", " ", 
          RowBox[{"{", "y", "}"}], ",", " ", "pairing"}], "]"}]}]}]}], "|>"}],
     ",", " ", "pairing"}], "]"}]}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"8d7d0128-3885-4aab-8519-cc6aca64712c"],

