  FormBox[
   SuperscriptBox["\[HBar]", 
    StyleBox["g", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "860d9301-9c76-430f-b130-1dcbf6383445"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["g", "TI"], "\[GreaterEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"ff503b19-494b-4b8d-b4f9-47fdfb757a26"],
 ", times one cyclic word or one product."
}], "Notes",ExpressionUUID->"649e7ddc-ad4e-4942-9ca9-0be4a1e7cf93"],

Cell["\<\
It returns unevaluated when a product carries the head of the other \
convention.\
\>", "Notes",ExpressionUUID->"3e1d7b70-9a3e-406c-a81f-1f0bb24a3cc8"],

