   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "f6fa0d3e-621e-4ea2-85ca-349d432f35f2"],
 " returns unevaluated when a term of ",
 StyleBox["s", "TI"],
 " is not a scalar times ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[HBar]", 
    StyleBox["g", "TI"]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d055be3c-9e12-47e7-8540-2299ee794c74"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["g", "TI"], "\[GreaterEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9342ea99-5c53-4bbc-a1a6-93ef4eee56e2"],
 ", times one cyclic word or one product."
}], "Notes",ExpressionUUID->"27989aa9-5626-4ec0-a9cb-35e0da0411e0"],

Cell["\<\
It returns unevaluated when a product carries the head of the other \
convention.\
\>", "Notes",ExpressionUUID->"9af007a8-c425-4cf5-a843-1aa90540c8d1"],

