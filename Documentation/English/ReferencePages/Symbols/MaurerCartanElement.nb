  FormBox[
   RowBox[{"\[ScriptL]", "\[GreaterEqual]", "1"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"a62184d6-f848-42fd-8fd4-766a4bbbdb84"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["g", "TI"], "\[GreaterEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"71f7d8e5-60c1-43a3-88e2-ff1f683edb08"],
 ", or when a part contains ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["HBar"]], "paclet:ChernSimons/ref/HBar", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "e4a85916-8f73-4ce3-b2fc-b22ccbd01b2e"],
 " or has terms with a number of factors other than ",
 Cell[BoxData[
  FormBox["\[ScriptL]", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "1de6e80e-29e7-4e9f-9305-3efad5ea6d88"],
 "."
}], "Notes",ExpressionUUID->"da11d593-6f65-45d7-a5b8-dfa285cce49a"]
}, Open  ]],

