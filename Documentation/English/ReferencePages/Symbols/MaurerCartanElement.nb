Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"MaurerCartanElement", "[", 
   RowBox[{
    RowBox[{"CyclicWord", "[", 
     RowBox[{"{", 
      RowBox[{"x", ",", " ", "y", ",", " ", "x"}], "}"}], "]"}], ",", " ", 
    RowBox[{"GradedPairing", "[", 
     RowBox[{
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"x", " ", "->", " ", 
         RowBox[{"-", "1"}]}], ",", " ", 
        RowBox[{"y", " ", "->", " ", "0"}]}], "|>"}], ",", " ", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"x", ",", " ", "y"}], "}"}], " ", "->", " ", "1"}], "|>"}]}],
      "]"}]}], "]"}], " ", "===", " ", 
  RowBox[{"MaurerCartanElement", "[", 
   RowBox[{
    RowBox[{"CyclicWord", "[", 
     RowBox[{"{", 
      RowBox[{"x", ",", " ", "x", ",", " ", "y"}], "}"}], "]"}], ",", " ", 
