  "InlineFormula",ExpressionUUID->"22f46937-9c80-4a3a-b44f-97cf001503da"],
 ", or when a part contains ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["HBar"]], "paclet:ChernSimons/ref/HBar", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "606356f3-b3de-47a3-8df3-e021d15e3dd2"],
 " or has terms with a number of factors other than ",
 Cell[BoxData[
  FormBox["\[ScriptL]", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "5a035904-663e-48f9-8c67-e2f1e42b6966"],
 "."
}], "Notes",ExpressionUUID->"4be56fde-0473-4b95-a1f4-d96ee490026f"]
}, Open  ]],

