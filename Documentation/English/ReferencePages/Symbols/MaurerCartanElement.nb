Cell["\<\
The Chern-Simons truncation of the circle, from its two parts:\
\>", "ExampleText",ExpressionUUID->"abef2916-b687-4043-bbed-38e0bdb564fe"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"m", " ", "=", " ", 
  RowBox[{"MaurerCartanElement", "[", 
   RowBox[{
    RowBox[{"<|", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "0"}], "}"}], " ", "->", " ", 
       RowBox[{"CyclicWord", "[", 
        RowBox[{"{", 
         RowBox[{"x", ",", " ", "x", ",", " ", "y"}], "}"}], "]"}]}], ",", 
      " ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"2", ",", " ", "0"}], "}"}], " ", "->", " ", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{"(", 
          RowBox[{"1", "/", "48"}], ")"}]}], " ", 
        RowBox[{"SymmetricProduct", "[", 
         RowBox[{
          RowBox[{"{", "y", "}"}], ",", " ", 
          RowBox[{"{", "y", "}"}], ",", " ", "pairing"}], "]"}]}]}]}], "|>"}],
     ",", " ", "pairing"}], "]"}]}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"2b00cad7-5489-4a66-be67-71e637249b82"],

