Cell[BoxData[
 RowBox[{"m", " ", "=", " ", 
  RowBox[{"MaurerCartanElement", "[", 
   RowBox[{
    RowBox[{"<|", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "0"}], "}"}], " ", "->", " ", 
       RowBox[{"CyclicWord", "[", 
        RowBox[{"{", 
         RowBox[{"x", ",", " ", "x", ",", " ", "y"}], "}"}], "]"}]}], ",", 
      " ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"2", ",", " ", "0"}], "}"}], " ", "->", " ", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{"(", 
          RowBox[{"1", "/", "48"}], ")"}]}], " ", 
        RowBox[{"SymmetricProduct", "[", 
         RowBox[{
          RowBox[{"{", "y", "}"}], ",", " ", 
          RowBox[{"{", "y", "}"}], ",", " ", "pairing"}], "]"}]}]}]}], "|>"}],
     ",", " ", "pairing"}], "]"}]}]], "Input",
