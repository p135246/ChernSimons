  ExpressionUUID->"ed3b66eb-9d18-455f-ba39-a281d8060695"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"ef6aaf0e-3819-49e3-90eb-26e9ca6a0ec9"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
