Cell[TextData[{
 "Not every monomial of top degree is an orientation. Here ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["d",
     FontSlant->"Plain"], 
    StyleBox["a", "TI"], "\[LongEqual]", 
    StyleBox["b", "TI"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5b21172c-c816-4f41-8680-a7d3f6821471"],
 ", so the functional that is ",
 Cell[BoxData[
  FormBox["1", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0d84fadd-40b9-4a2d-a9f3-39f30d846842"],
 " on ",
 Cell[BoxData[
  FormBox[
   StyleBox["b", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "84ccadd1-9962-4a87-9a2c-9bfe09901d1b"],
 " does not vanish on the image of the differential; the result is a ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Failure"]], "paclet:ref/Failure"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "8e43ff90-14a4-40bb-9c49-b57fbc41f9f1"],
 ", whose message says so:"
}], "ExampleText",ExpressionUUID->"b70015d2-c0d4-4b48-a06e-b464861684bf"],

