Notebook[{

Cell[CellGroupData[{
Cell["SullivanModel", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"643afea7-2bd2-487a-9103-0077c3d8b117"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["SullivanModel"]], "paclet:ChernSimons/ref/SullivanModel", 
     "ChernSimons Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["name", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ecbcb2d4-2c83-4302-b160-029837d3328b"],
 "\[LineSeparator]",
 "gives a Sullivan minimal model with a volume form from the catalogue ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["$SullivanModels"]], "paclet:ChernSimons/ref/$SullivanModels", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "40b1415f-2209-49d0-a0de-a1111746d7eb"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"cc81909b-563d-4268-8a35-30c81ca4cf95"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["SullivanModel"]], "paclet:ChernSimons/ref/SullivanModel", 
     "ChernSimons Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["name", "TI"], ",", " ", 
    StyleBox["generators", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9dc418d7-458e-4697-8ce9-633de3dff50a"],
 "\[LineSeparator]",
 "uses the given generator symbols instead of the default ones.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"114b01bd-e10f-4290-81ff-eb2764e2f915"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["SullivanModel"]], "paclet:ChernSimons/ref/SullivanModel", 
     "ChernSimons Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["degrees", "TI"], ",", " ", 
    StyleBox["differential", "TI"], ",", " ", 
    StyleBox["volume", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5309a0d5-544b-428d-b990-42f883541735"],
 "\[LineSeparator]",
 "builds a model from an Association of generators to their degrees, an \
Association giving the differential on the generators, and a volume monomial.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"6ca56b06-1f87-4ab9-88be-dadbbb58c985"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["SullivanModel"]], "paclet:ChernSimons/ref/SullivanModel", 
     "ChernSimons Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["degrees", "TI"], ",", " ", 
    StyleBox["differential", "TI"], ",", " ", 
    StyleBox["volume", "TI"], ",", " ", 
    StyleBox["truncation", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2a48a523-5d1f-44a7-af57-295a2a2f397f"],
 "\[LineSeparator]",
 "quotients by the monomials above degree ",
 StyleBox["truncation", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"0d57c898-c4b0-4063-bd7b-d42d433d441c"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["SullivanModel"]], "paclet:ChernSimons/ref/SullivanModel", 
     "ChernSimons Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{"{", 
    RowBox[{
     StyleBox["model1", "TI"], ",", " ", 
     StyleBox["model2", "TI"], ",", " ", "\[Ellipsis]"}], "}"}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4393a961-a6a8-4658-b7d7-df2c558c8b5e"],
 "\[LineSeparator]",
 "is the tensor product."
}], "Usage",ExpressionUUID->"a9aeea38-79cc-4fed-9f5f-016094132710"],

Cell[TextData[{
 "The result is a plain ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Association"]], "paclet:ref/Association"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "236c65cd-c4e5-4b08-a8d2-4e5745822c5f"],
 " with five keys, so it can be inspected and edited like any other \
expression."
}], "Notes",ExpressionUUID->"fbaeb09c-bfc9-4f99-b2a8-e82d245812d5"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "aea756cd-2b5a-47f5-ac73-758947a5f5c3"], Cell["key", "TableText",
     FontWeight->Bold,ExpressionUUID->"87dff27f-13c6-4582-adab-2d9f3f334464"],
     Cell["value", "TableText",
     FontWeight->Bold,ExpressionUUID->"3a582473-906d-4b37-a35a-ccc28e685eac"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "07fdb97f-0772-4ec9-a3b4-579e3a309cc2"], Cell[TextData[Cell[
    BoxData["\"\<Generators\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "dc521f5e-3c41-4656-b6b0-7c461cf4e094"]], "TableText",ExpressionUUID->
     "5c6a54e4-87b3-4660-a408-f060747bb172"], Cell[TextData[{
     "the ",
     StyleBox["degrees", "TI"],
     " Association, verbatim; every degree must be at least ",
     Cell[BoxData[
      FormBox["1", TraditionalForm]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "d2267696-52c4-4297-8371-827399a2c194"]
    }], "TableText",ExpressionUUID->"61510b5e-fdab-4e0a-9ac7-fafb1eb92259"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "caae3a3f-03f9-43f9-b306-9d311acd8e65"], Cell[TextData[Cell[
    BoxData["\"\<Differential\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "c9b77dff-b489-49b5-ad3a-07eb7742d78f"]], "TableText",ExpressionUUID->
     "49564f04-6ea3-4811-901c-234e8ec0d8fd"], Cell["\<\
one element per generator, as an Association from monomials to coefficients\
\>", "TableText",ExpressionUUID->"b9b7865d-e375-4f64-a9b2-8ed589e0b2af"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "bf6081cd-4b86-4fe8-a996-aab6033e2f96"], Cell[TextData[Cell[
    BoxData["\"\<Volume\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "0cb39fdd-f43d-4ffd-b8d6-59278537ea43"]], "TableText",ExpressionUUID->
     "d6241198-989d-4bb3-b632-edd98d93db47"], Cell[
    "the volume monomial, as the list of its generators", "TableText",
     ExpressionUUID->"44f06e0b-f136-4efd-beb2-6b70bbb1d3a0"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "54db1b74-f5b7-46a8-bbea-8029063c7bd2"], Cell[TextData[Cell[
    BoxData["\"\<Degree\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "708eb105-6422-452d-b74c-690dbd3ec435"]], "TableText",ExpressionUUID->
     "2cf49a2d-2ef8-4dc5-b1bc-7a7aee364c60"], Cell[TextData[{
     "the degree of the volume monomial \[LongDash] the Poincar\[EAcute] \
duality degree ",
     Cell[BoxData[
      FormBox[
       StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "3e78bab9-4780-42ba-a3c9-914bcbe430e4"]
    }], "TableText",ExpressionUUID->"bdd554c0-0e4e-45d9-8bb3-c76738e1103a"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "0add6e6e-e2d7-4475-af4f-4ed75317137d"], Cell[TextData[Cell[
    BoxData["\"\<Truncation\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "a15d127c-2267-4a90-a8d3-8871e2366664"]], "TableText",ExpressionUUID->
     "2314a335-0ba3-49e4-991d-cb8e7382c8b8"], Cell[TextData[{
     "the degree above which the algebra is zero, ",
     Cell[BoxData[
      TemplateBox[{
        Cell[
         TextData["Infinity"]], "paclet:ref/Infinity"},
       "RefLink",
       BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
      "8cbf206f-f126-40bc-9a6c-e28d4ef5acf0"],
     " by default"
    }], "TableText",ExpressionUUID->"0a0bcb40-af21-4509-923e-59fa7d3d71e2"]}
  }]], "2ColumnTableMod",ExpressionUUID->"7271dedf-41c2-4df8-9441-\
4d53734b23af"],

Cell[TextData[{
 "The underlying algebra is the free graded commutative algebra on the \
generators: a generator of even degree is polynomial, one of odd degree \
squares to zero. A monomial is written as a product of generators and is read \
",
 StyleBox["in the order the model declares them",
  FontWeight->"Bold"],
 ", so ",
 Cell[BoxData[
  RowBox[{"x", " ", "y"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e6a16111-713f-48e3-9df1-b46fc0fa4e90"],
 " and ",
 Cell[BoxData[
  RowBox[{"y", " ", "x"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b795888a-5e3a-4d76-a2cf-70589caecbda"],
 " are the same expression and denote the same monomial; the sign of a \
reordering is produced by ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SullivanModelProduct"]], 
    "paclet:ChernSimons/ref/SullivanModelProduct", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "c3cbd2fa-80d6-4166-b115-091e0ba46044"],
 " and not by the way a monomial is typed."
}], "Notes",ExpressionUUID->"c78498e6-4509-489e-afb3-aa98d51f7075"],

Cell[TextData[{
 StyleBox["volume", "TI"],
 " determines the orientation ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["O", "TI"], ":", 
    StyleBox["V", "TI"], "\[Rule]", 
    StyleBox["K",
     FontSlant->"Plain"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "893eb021-c405-441f-82fe-bce53699fec1"],
 ": it is the coefficient of that monomial, so it has degree ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "047a0bb6-fe70-4606-879b-78b3b2913dad"],
 " and kills every other degree. That makes ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     StyleBox["V", "TI"], ",", 
     StyleBox["d",
      FontSlant->"Plain"], ",", 
     StyleBox["O", "TI"]}], ")"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c682acd9-03c0-4227-a409-c5aeefc6d164"],
 " an oriented PDGA of degree ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ce995a8e-0958-468d-822e-478042e03b80"],
 " whenever the pairing ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{
      SubscriptBox[
       StyleBox["v", "TI"], "1"], ",", 
      SubscriptBox[
       StyleBox["v", "TI"], "2"]}], "\[RightAngleBracket]"}], "\[LongEqual]", 
    
    StyleBox["O", "TI"], 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox[
       StyleBox["v", "TI"], "1"], 
      SubscriptBox[
       StyleBox["v", "TI"], "2"]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1f8bce64-6ed2-482a-a043-693e91375b8b"],
 " is perfect on cohomology, which is the case for every model in the \
catalogue."
}], "Notes",ExpressionUUID->"bb31f5a9-ba16-4c70-baaf-b39901614506"],

Cell["\<\
The differential may be given either as a monomial expression or as an \
Association from monomials to coefficients. A generator not mentioned is \
closed.\
\>", "Notes",ExpressionUUID->"3d630b32-454e-442a-a701-a9b77019c948"],

Cell[TextData[{
 "The default generator symbols are created in the caller's context \
\[LongDash] ",
 Cell[BoxData["a"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4b66bddb-0627-4e86-be75-1f1405d0f26a"],
 ", ",
 Cell[BoxData["b"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "aa677763-edcb-44b0-ae8d-2a393a5c1e14"],
 " for a projective space, ",
 Cell[BoxData["x"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "591be188-8e72-4ecd-8c0b-bb391dc709cf"],
 ", ",
 Cell[BoxData["y"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "964b666a-d686-4732-b113-6f249d0e576f"],
 ", ",
 Cell[BoxData["z"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d26f4a38-1f1f-4e33-bd4c-8b392f05309a"],
 " for the Heisenberg nilmanifold, and so on. Pass ",
 StyleBox["generators", "TI"],
 " to choose them, which is also how a collision is avoided when two models \
are tensored."
}], "Notes",ExpressionUUID->"3f89f774-fddf-4b96-8afe-cf0f8ca7ccb1"],

Cell["\<\
A truncation is legitimate because the span of the monomials above any degree \
is a differential graded ideal, the differential raising degree by one.\
\>", "Notes",ExpressionUUID->"5d914ab5-1608-4011-a6c5-2d5ddd58b15d"],

Cell["\<\
The model displays as a summary box: its generators with their degrees and \
the Poincar\[EAcute] duality degree, with the differential, the volume \
monomial and the truncation under the opener.\
\>", "Notes",ExpressionUUID->"073c402a-4189-4ecd-8d9a-86ee92a233ef"]
}, Open  ]],

