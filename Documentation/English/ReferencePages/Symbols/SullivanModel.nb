   RowBox[{
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"a", " ", "->", " ", "1"}], ",", " ", 
      RowBox[{"b", " ", "->", " ", "2"}]}], "|>"}], ",", " ", 
    RowBox[{"<|", 
     RowBox[{"a", " ", "->", " ", "b"}], "|>"}], ",", " ", "b"}], "]"}], 
  "[", "\"\<Message\>\"", "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"e59f7cbb-3e5f-4e9b-9f94-5af582b47ce8"],

