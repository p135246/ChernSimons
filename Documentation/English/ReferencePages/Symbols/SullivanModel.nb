     FontWeight->Bold,ExpressionUUID->"8dc65f05-7d52-4a8a-be70-76036a4a4f66"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "c3d4af69-78c6-412b-9f38-c729216f1d0f"], Cell[TextData[Cell[
    BoxData["\"\<Generators\>\""], "InlineFormula",ExpressionUUID->
     "f6686bc8-40c3-4cf1-ac80-a00053fd059a"]], "TableText",ExpressionUUID->
     "edf11f7c-7ea8-4ac5-91e4-1b7c95bd12cc"], Cell[TextData[{
     "the ",
     StyleBox["degrees", "TI"],
     " Association, each degree at least ",
     Cell[BoxData[
      FormBox["1", TraditionalForm]], "InlineFormula",ExpressionUUID->
      "39c08c60-9c3e-47ea-9724-c6f4e7f273de"]
    }], "TableText",ExpressionUUID->"178f0478-3fd5-4153-8329-339661176254"]},
