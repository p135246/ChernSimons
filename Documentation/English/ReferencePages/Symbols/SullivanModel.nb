Cell[TextData[{
 "Not every monomial of top degree is an orientation. Here ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["d",
     FontSlant->"Plain"], 
    StyleBox["a", "TI"], "\[LongEqual]", 
    StyleBox["b", "TI"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6f6d5b58-bd91-4870-877c-d401e9843f9f"],
 ", so the functional that is ",
 Cell[BoxData[
  FormBox["1", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d8f55732-7172-44ad-9e74-1f9570efb44f"],
 " on ",
 Cell[BoxData[
  FormBox[
   StyleBox["b", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f767ca33-3912-4c6c-a066-1ca9d60a973b"],
 " does not vanish on the image of the differential; the result is a ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Failure"]], "paclet:ref/Failure"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "051065f0-1aaa-474c-a6d4-a731088ff6cc"],
 ", whose message says so:"
}], "ExampleText",ExpressionUUID->"3cda32f0-2ff7-4649-b015-37a0eaeaaf45"],

