      RowBox[{"SullivanModel", "[", 
       RowBox[{
        RowBox[{"\"\<Sphere\>\"", "[", "2", "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"p", ",", " ", "q"}], "}"}]}], "]"}], ",", " ", 
      RowBox[{"SullivanModel", "[", 
       RowBox[{
        RowBox[{"\"\<Sphere\>\"", "[", "3", "]"}], ",", " ", 
        RowBox[{"{", "r", "}"}]}], "]"}]}], "}"}], "]"}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Normal", "[", 
    RowBox[{"product", "[", "\"\<Generators\>\"", "]"}], "]"}], ",", " ", 
   RowBox[{"product", "[", "\"\<Volume\>\"", "]"}], ",", " ", 
   RowBox[{"product", "[", "\"\<Degree\>\"", "]"}]}], "}"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"3062d427-d43e-4d38-9961-c3337d1736c8"],

