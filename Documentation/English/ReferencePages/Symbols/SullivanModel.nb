      "b112bad6-d4fb-493a-88c8-bcd5e7c13eeb"]
    }], "TableText",ExpressionUUID->"57e4b402-0f0d-4734-99d0-687f067a355f"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
