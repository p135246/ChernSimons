Cell[CellGroupData[{

Cell[BoxData[
 InterpretationBox[Cell[
  "Possible Issues", "ExampleSection",ExpressionUUID->
   "dda06a82-eb41-4b48-8510-6cb821647761"],
  $Line = 0; Null]], "ExampleSection",
 CellID->1305812373,ExpressionUUID->"9397dd0b-9de4-443a-9371-be2b75148f2f"],

Cell[TextData[{
 "Not every monomial of top degree is an orientation. Here ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["d",
     FontSlant->"Plain"], 
    StyleBox["a", "TI"], "\[LongEqual]", 
    StyleBox["b", "TI"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "ef6a7464-54b8-4639-82eb-fc87c5558b4e"],
 ", so the functional that is ",
 Cell[BoxData[
  FormBox["1", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "c13721b0-627f-49bd-9ebb-d4a1cfda3b7f"],
 " on ",
 Cell[BoxData[
  FormBox[
   StyleBox["b", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "5c98a796-5cc8-4029-954b-f80f54c48431"],
 " does not vanish on the image of the differential; the result is a ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Failure"]], "paclet:ref/Failure"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "322ef3c2-e39b-4b4f-9faa-89e88a6af9c3"],
 ", whose message says so:"
}], "ExampleText",ExpressionUUID->"c203131c-45c2-4dd8-8dbf-0cfd80b09eeb"],

