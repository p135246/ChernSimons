   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "f60e8eb9-ca2d-4acb-a5b1-67772cfb62c7"],
 ", with its orientation.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"88e2e729-2d40-48eb-a453-919a51d8812a"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
