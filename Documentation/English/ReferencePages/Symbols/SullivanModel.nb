Cell[TextData[{
 "The truncated polynomial algebra ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["K",
     FontSlant->"Plain"], 
    RowBox[{"[", 
     StyleBox["u", "TI"], "]"}], "/", 
    RowBox[{"(", 
     SuperscriptBox[
      StyleBox["u", "TI"], "3"], ")"}]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"b7160439-20e8-4bd1-a98a-3edc77762ce0"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{"|", 
    StyleBox["u", "TI"], "|", "\[LongEqual]", "2"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"0988c36c-7a88-4cae-aa8b-1005e0b1989f"],
 ", the cohomology of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["CP",
     FontSlant->"Plain"], "2"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"c748275f-d14b-4a5d-9ec4-71b0ee8693d2"],
 ", as a model with zero differential:"
}], "ExampleText",ExpressionUUID->"ef1233e3-5525-40cf-92bd-fd55e4f2fae0"],

