  FontSize->0.9 Inherited,ExpressionUUID->
  "56747dbc-ebc7-4405-ac47-f7ab7d2c794a"],
 "\[LineSeparator]",
 "gives the Sullivan model ",
 StyleBox["name", "TI"],
 " of the catalogue ",
