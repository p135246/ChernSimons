   RowBox[{"CanonicalMaurerCartan", "[", "pairing", "]"}]}], "}"}]}], "Input",\

 CellLabel->"In[1]:= ",ExpressionUUID->"0a8e5243-dc11-41c9-a43a-f94ad7eb9fee"],

