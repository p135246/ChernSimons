 Cell[BoxData["\"\<Volume\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2dec35f0-b431-411d-b4bd-6873585e8325"],
 " is stored as the list of the generators of the monomial, not as a product, \
because that is the form the engine works in. Every other function takes and \
returns products."
}], "ExampleText",ExpressionUUID->"aaff4b91-3a68-48ad-9501-f5579ecca8ee"],

