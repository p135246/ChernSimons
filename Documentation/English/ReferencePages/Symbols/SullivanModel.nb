  FontSize->0.9 Inherited,ExpressionUUID->
  "a81ec8fa-a29e-4cb0-8310-6b5a077b82f1"],
 "\[LineSeparator]",
 "gives the same model on the list of symbols ",
 StyleBox["generators", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"a2039f44-748a-4943-8cfd-d62b3c9e0223"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["SullivanModel"]], "paclet:ChernSimons/ref/SullivanModel", 
     "ChernSimons Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["degrees", "TI"], ",", " ", 
