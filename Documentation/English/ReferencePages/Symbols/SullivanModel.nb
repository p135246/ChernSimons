     FontWeight->Bold,ExpressionUUID->"5457e905-2ab4-4b49-a95c-8474fcb703e4"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "5942504c-c09f-4b82-92b8-6e8896864712"], Cell[TextData[Cell[
    BoxData["\"\<Generators\>\""], "InlineFormula",ExpressionUUID->
     "3598c674-fdc3-483e-8156-4441d9450ba9"]], "TableText",ExpressionUUID->
     "612db076-448a-492e-acdc-ffc3a861fdea"], Cell[TextData[{
     "the ",
     StyleBox["degrees", "TI"],
     " Association, each degree at least ",
     Cell[BoxData[
      FormBox["1", TraditionalForm]], "InlineFormula",ExpressionUUID->
      "dcdf37e9-5663-4394-91c5-fa4ae5b23b27"]
    }], "TableText",ExpressionUUID->"8a51065b-88d3-44c6-b055-5e013904aa10"]},
