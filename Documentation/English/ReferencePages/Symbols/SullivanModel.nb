   {Cell["      ", "ModInfo",ExpressionUUID->
     "5c86b0cc-59cf-44c8-85b1-dc752aaa3227"], Cell["Key", "TableText",
     FontWeight->Bold,ExpressionUUID->"b2d0f3cb-d50a-4412-9cf8-8c3643a195bc"],
     Cell["Value", "TableText",
     FontWeight->Bold,ExpressionUUID->"024d58b0-c0b4-40e8-b5a4-163a931045ec"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "acc29fff-462d-4ad3-a721-a56e1f5656cb"], Cell[TextData[Cell[
    BoxData["\"\<Generators\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "0e249690-54d0-4067-af85-655d13dd87ff"]], "TableText",ExpressionUUID->
     "2270fa2f-9f10-47bc-bc87-7eb1c5dfd222"], Cell[TextData[{
     "the ",
     StyleBox["degrees", "TI"],
     " Association, each degree at least ",
     Cell[BoxData[
      FormBox["1", TraditionalForm]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "2a77fcd6-a055-4f8b-8924-2c2610757676"]
    }], "TableText",ExpressionUUID->"fff7601b-615a-4241-a037-7e6c4286d092"]},
