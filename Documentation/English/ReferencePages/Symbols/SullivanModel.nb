Cell[TextData[{
 "The minimal model of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["CP",
     FontSlant->"Plain"], "2"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "87fd7280-7f47-4398-9a00-6ec3610361e1"],
 ": a generator of degree ",
 Cell[BoxData[
  FormBox["2", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4d3cafd0-f871-4c9b-920f-11c152577c77"],
 " and one of degree ",
 Cell[BoxData[
  FormBox["5", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "547cf249-2aa8-4839-9dbd-4bd7355646de"],
 " whose differential is its cube."
}], "ExampleText",ExpressionUUID->"71db1f45-0019-4d60-936f-017e6345ce1a"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"model", " ", "=", " ", 
   RowBox[{"SullivanModel", "[", 
    RowBox[{"\"\<ComplexProjectiveSpace\>\"", "[", "2", "]"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{"Normal", "[", 
  RowBox[{"model", "[", "\"\<Generators\>\"", "]"}], "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"3c4e723a-79c2-4d5c-87b5-c274ba412a91"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"a", "\[Rule]", "2"}], ",", 
   RowBox[{"b", "\[Rule]", "5"}]}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"8e7758d5-57f5-4b26-8e19-5d394f5925c4"]
}, Open  ]],

Cell[CellGroupData[{

