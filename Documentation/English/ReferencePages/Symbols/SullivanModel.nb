Cell[TextData[{
 "The truncated polynomial algebra ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["K",
     FontSlant->"Plain"], 
    RowBox[{"[", 
     StyleBox["u", "TI"], "]"}], "/", 
    RowBox[{"(", 
     SuperscriptBox[
      StyleBox["u", "TI"], "3"], ")"}]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "50263f45-82dc-471f-b002-5a96d5ef1a30"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{"|", 
    StyleBox["u", "TI"], "|", "\[LongEqual]", "2"}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "704a0290-1ce5-4d89-acd5-a14fb609de49"],
 " \[LongDash] the cohomology of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["CP",
     FontSlant->"Plain"], "2"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a5ddcab2-8996-478e-ae96-a5752614268b"],
 ", presented as a model with zero differential:"
}], "ExampleText",ExpressionUUID->"7ce05503-09e7-4565-be14-dbb7045249cb"],

