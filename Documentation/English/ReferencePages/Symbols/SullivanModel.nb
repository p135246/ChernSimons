Cell["SullivanModel", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"9993caf3-dd34-4e12-a506-6d135c0f3ca9"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["SullivanModel"]], "paclet:ChernSimons/ref/SullivanModel", 
     "ChernSimons Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["name", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "698eaf48-1303-4dcc-8bf0-e72c8217d91b"],
 "\[LineSeparator]",
 "gives the Sullivan model ",
 StyleBox["name", "TI"],
 " of the catalogue ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["$SullivanModels"]], "paclet:ChernSimons/ref/$SullivanModels", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "2e76a035-4f7c-4bee-890c-0ee14c14a409"],
 ", with its orientation.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"ecfc0100-09d5-479e-90da-5539210d6808"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["SullivanModel"]], "paclet:ChernSimons/ref/SullivanModel", 
     "ChernSimons Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["name", "TI"], ",", " ", 
    StyleBox["generators", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "f64d3d76-dbd6-4560-8875-18f5730cb80d"],
 "\[LineSeparator]",
 "gives the same model on the list of symbols ",
 StyleBox["generators", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"587e4cdd-3756-48ad-b81b-f56ffed0a671"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["SullivanModel"]], "paclet:ChernSimons/ref/SullivanModel", 
     "ChernSimons Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["degrees", "TI"], ",", " ", 
    StyleBox["differential", "TI"], ",", " ", 
    StyleBox["orientation", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "b987067f-35ed-49ad-9f1b-76213644e9cf"],
 "\[LineSeparator]",
 "gives the Sullivan model whose generators have the degrees ",
 StyleBox["degrees", "TI"],
 ", with the differential ",
 StyleBox["differential", "TI"],
 " on the generators and the orientation ",
 StyleBox["orientation", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"e5e9da47-6aa5-48db-961d-1eeca0510d8c"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["SullivanModel"]], "paclet:ChernSimons/ref/SullivanModel", 
     "ChernSimons Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["degrees", "TI"], ",", " ", 
    StyleBox["differential", "TI"], ",", " ", 
    StyleBox["orientation", "TI"], ",", " ", 
    StyleBox["truncation", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "02980d9a-5ef7-4255-af9f-10a839c030bd"],
 "\[LineSeparator]",
 "gives its quotient by the monomials above degree ",
 StyleBox["truncation", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"ec96bfe8-37f9-48ce-8125-2ff37acbb5f7"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["SullivanModel"]], "paclet:ChernSimons/ref/SullivanModel", 
     "ChernSimons Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{"{", 
    RowBox[{
     SubscriptBox[
      StyleBox["model", "TI"], 
      StyleBox["1", "TR"]], ",", " ", 
     SubscriptBox[
      StyleBox["model", "TI"], 
      StyleBox["2", "TR"]], ",", " ", "\[Ellipsis]"}], "}"}], "]"}]], 
  "InlineFormula",ExpressionUUID->"df381a1c-1609-453b-91b5-8afa8e5e9b9d"],
 "\[LineSeparator]",
 "gives the tensor product of the models."
}], "Usage",ExpressionUUID->"0bac177d-a6f1-470f-b37e-d3e0d2098e99"],

Cell[TextData[{
 "The result is a SullivanModel object, displayed as a summary box. Its data \
is read with ",
 StyleBox["model", "TI"],
 "[",
 StyleBox["key", "TI"],
 "] and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Normal"]], "paclet:ref/Normal"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "37a733ae-ac98-42b6-a9d9-ec287335bcc6"],
 ":"
}], "Notes",
 CellFrameLabels->{{Inherited, Inherited}, {Inherited, 
    Cell[
     TextData[{
      "26.09.30: Design review - a model is a tagged SullivanModel object \
wrapping an Association with the keys \"Generators\", \"Differential\", \
\"Orientation\", \"Degree\" and \"Truncation\", so that SullivanModelQ \
recognizes it and it prints as a summary box, while the upvalues for Normal, \
Keys and Lookup keep it readable as the Association it wraps (T0b, \
2026-09-21). The constructor takes the data a reader writes down for a model: \
an Association of generators to degrees, the differential on the generators \
as polynomials, and an orientation given either as one monomial or as values \
on the monomials of degree n, the second form coming from the request of \
2026-09-23 that introduced the orientation. Data of the wrong shape returns \
unevaluated; data of the right shape that fails the mathematics, a \
differential that does not raise the degree by one or does not square to zero \
or values that are not an orientation, gives a Failure without a message (H1, \
2026-09-24); no alternative was recorded. A truncation is kept as a group of \
generators with a degree, so that a tensor product keeps the truncation of \
each factor, and the generator symbols of a catalogue model can be chosen so \
that two models can be tensored. Prior art: the Wolfram Language has no \
Sullivan models and no differential graded algebras; GrassmannAlgebra is the \
exterior algebra on its generators, the case in which every generator has odd \
degree and the differential is zero. The engine the verification suites load \
builds the same nine catalogue models as plain Associations, with the \
orientation as one volume monomial, and the suites pin the basis, the product \
and the differential of this object against it on the catalogue and on \
Kodaira-Thurston.", "\n\n", 
       Cell[
        BoxData[
         GridBox[{{
            Cell[
             BoxData[
              ButtonBox[
               DynamicBox[
                FEPrivate`FrontEndResource[
                "DocumentationToolsStrings", "Edit"]], BaseStyle -> 
               "TextAnnotationButton"]]], 
            StyleBox[
             RowBox[{
               DynamicBox[
                FEPrivate`FrontEndResource[
                "DocumentationToolsStrings", "LastAnnotator"]], "pavel"}], 
             "TextAnnotator"], 
            Cell[
             BoxData[
              ButtonBox[
               DynamicBox[
                FEPrivate`FrontEndResource[
                "DocumentationToolsStrings", "Delete"]], BaseStyle -> 
               "TextAnnotationRemoveButton"]]], ""}}, 
          GridBoxAlignment -> {
           "Columns" -> {Left, Left, Right, Right}, "Rows" -> {{Automatic}}}, 
          GridBoxItemSize -> {"Columns" -> {
              Scaled[0.15], 
              Scaled[0.68], 
              Scaled[0.15], 
              Scaled[0.02]}}]]], "\n"}], "TextAnnotation", 
     CellSize -> {590, Inherited}]}},
 CellTags->"TextAnnotation",
 CellID->905841304,ExpressionUUID->"a5857b4d-e9d0-4d01-848e-62c20eda80f5"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "d8c855b8-99b8-4598-b75f-5fbda5bfa83a"], Cell["Key", "TableText",
     FontWeight->Bold,ExpressionUUID->"d4a64260-b6ec-43f5-8c16-6a0f27141e90"],
