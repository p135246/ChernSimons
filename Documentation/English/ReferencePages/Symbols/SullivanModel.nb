   {Cell["      ", "ModInfo",ExpressionUUID->
     "d94bd611-fc8f-44e3-b2c5-4c83746e2024"], Cell["Key", "TableText",
     FontWeight->Bold,ExpressionUUID->"b4689b1b-4d15-4776-946b-fc173a5e54c4"],
     Cell["Value", "TableText",
     FontWeight->Bold,ExpressionUUID->"aed91214-7b9c-4445-9b90-7111e55b2fa1"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "3d87fafd-3428-4c43-b1d5-9ccdcedc3976"], Cell[TextData[Cell[
    BoxData["\"\<Generators\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "23dea6cf-efb8-49db-b590-db9e4d61cd4e"]], "TableText",ExpressionUUID->
     "8abda0a1-e8ee-49c9-ab5a-17b5d3e8fe08"], Cell[TextData[{
     "the ",
     StyleBox["degrees", "TI"],
     " Association, each degree at least ",
