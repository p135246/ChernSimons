Cell[TextData[{
 "A tensor product, of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["S", "TI"], "2"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c8879923-85cc-40b7-80de-8e142b279975"],
 " and ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["S", "TI"], "3"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "767c2c21-5e31-4c43-ac86-945b59812731"],
 "; the generators have to be disjoint, so they are named:"
}], "ExampleText",ExpressionUUID->"2d4fdaf4-092c-4b19-a807-109110541897"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"product", " ", "=", " ", 
   RowBox[{"SullivanModel", "[", 
