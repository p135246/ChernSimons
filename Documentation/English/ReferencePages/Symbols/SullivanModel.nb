  FontSize->0.9 Inherited,ExpressionUUID->
  "c508bcd3-b4a6-44b1-8e57-5dff14ded4e3"],
 "\[LineSeparator]",
 "gives the Sullivan model ",
 StyleBox["name", "TI"],
 " of the catalogue ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["$SullivanModels"]], "paclet:ChernSimons/ref/$SullivanModels", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "e286b69a-d014-4119-b45f-7439dc1f9cf2"],
 ", with its orientation.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"5d5a0310-a9c1-4609-a1b5-e39228370285"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["SullivanModel"]], "paclet:ChernSimons/ref/SullivanModel", 
     "ChernSimons Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["name", "TI"], ",", " ", 
    StyleBox["generators", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "35b564b2-f1b6-4307-8544-df600de9d6ce"],
 "\[LineSeparator]",
 "gives the same model on the list of symbols ",
 StyleBox["generators", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"36c637cd-97c7-4abe-8780-5a016e0ca23f"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["SullivanModel"]], "paclet:ChernSimons/ref/SullivanModel", 
     "ChernSimons Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["degrees", "TI"], ",", " ", 
    StyleBox["differential", "TI"], ",", " ", 
