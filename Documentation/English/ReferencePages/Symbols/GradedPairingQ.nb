 "A bare association with the keys of a pairing object gives ",
 Cell[BoxData[
 "False"], "InlineFormula",ExpressionUUID->
  "a2c3ad6e-c310-40d4-9f70-697bace79555"],
 "."
}], "Notes",ExpressionUUID->"2e3ce0a8-5e32-496a-8433-e77ed8792f65"],

