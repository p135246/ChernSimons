Cell["GradedPairingQ", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"8b74eb75-5b9e-4662-b762-1002a1502217"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["GradedPairingQ"]], "paclet:ChernSimons/ref/GradedPairingQ", 
     "ChernSimons Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["expr", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4c565c13-6373-46c3-9bb4-d5a104857d21"],
 "\[LineSeparator]",
 "tests whether ",
 StyleBox["expr", "TI"],
 " is a pairing object built by ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["GradedPairing"]], "paclet:ChernSimons/ref/GradedPairing", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "4c9c00d6-3726-45ea-ada8-7e3091cd51c5"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"120c7baa-531b-40f1-82e0-fee81893a7b9"],

Cell["\<\
A structure of this paclet is a tagged object, not a bare Association, so \
that it can be recognized, dispatched on and printed as itself. The predicate \
answers the recognition question only: it does not check that the data inside \
is consistent.\
\>", "Notes",ExpressionUUID->"791ce8c8-6f17-4175-a95c-87d3b27f7f05"],

Cell["\<\
Every operation accepts the tagged object and unwraps it, so the predicate is \
never needed to call anything. It is for the caller writing their own \
definitions.\
\>", "Notes",ExpressionUUID->"e6b2f36f-06f4-4c83-af29-56a6a0b2f691"]
}, Open  ]],

