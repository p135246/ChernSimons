   RowBox[{"p_", "?", "GradedPairingQ"}], "]"}]], "InlineFormula",
  ExpressionUUID->"b451a20a-df8d-496f-9ee6-ffad2be95207"],
 "."
}], "Notes",ExpressionUUID->"89e166d5-55c1-4e5b-933f-a15fe608dad9"]
