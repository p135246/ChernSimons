 "A bare association with the keys of a pairing object gives ",
 Cell[BoxData["False"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d509b117-d146-4c98-a4f3-443078f7c711"],
 "."
}], "Notes",ExpressionUUID->"77077290-ee4f-4409-9b4f-5704d3c19b5f"],

Cell[TextData[{
 "Every operation takes the pairing object itself. The predicate serves as a \
pattern test, as in ",
 Cell[BoxData[
  RowBox[{"f", "[", 
   RowBox[{"p_", "?", "GradedPairingQ"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b5655638-0c35-4024-9915-872f5f7bde18"],
 "."
}], "Notes",ExpressionUUID->"722681f4-2e0f-476c-8aea-b60cc35c42d4"]
