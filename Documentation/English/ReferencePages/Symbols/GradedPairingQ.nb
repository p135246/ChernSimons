    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "a18b3a31-80ae-4bb1-962e-e0afad7af4d3"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"15a562c6-9f04-4cc0-8d40-08e0c306d270"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["GradedPairingQ"]], "paclet:ChernSimons/ref/GradedPairingQ", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "de3ed04b-d214-4945-b5de-ec47b3bebd39"],
 " gives ",
 Cell[BoxData[
 "True"], "InlineFormula",ExpressionUUID->
  "3504f77e-a6ba-41d8-a92b-b0188d52bbeb"],
 " for an expression ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["GradedPairing"]], "paclet:ChernSimons/ref/GradedPairing", 
     "ChernSimons Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["assoc", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "2d33d7cd-61dd-408b-b099-b1b600749198"],
 " whose association ",
 StyleBox["assoc", "TI"],
 " has the keys the constructor writes: ",
 Cell[BoxData["\"\<Degrees\>\""], "InlineFormula",ExpressionUUID->
  "7dd19e03-de47-4bc4-8bdb-a00017a246d3"],
 " and ",
 Cell[BoxData["\"\<Values\>\""], "InlineFormula",ExpressionUUID->
  "5a7252af-8b2f-44f4-98e3-2444abd9195c"],
 " holding associations, ",
 Cell[BoxData["\"\<Degree\>\""], "InlineFormula",ExpressionUUID->
  "39fb5f0b-5491-47b7-ac3a-e8c3d78431e8"],
 ", and ",
 Cell[BoxData["\"\<Convention\>\""], "InlineFormula",ExpressionUUID->
  "8455ac03-1cef-47bf-b62a-00be04c3cfda"],
 " holding ",
 Cell[BoxData["\"\<Symmetric\>\""], "InlineFormula",ExpressionUUID->
  "e94b051a-8811-4d25-9534-21b92de79a52"],
 " or ",
 Cell[BoxData["\"\<Exterior\>\""], "InlineFormula",ExpressionUUID->
  "d2c8c031-ad37-45c1-bc92-906e79673aea"],
 ". It gives ",
 Cell[BoxData[
 "False"], "InlineFormula",ExpressionUUID->
  "1e8d4c7e-9e41-4385-bcd6-b56e6c0e55c9"],
 " for every other expression."
}], "Notes",
 CellFrameLabels->{{Inherited, Inherited}, {Inherited, 
    Cell[
     TextData[{
      "26.09.30: Design review - the recognizer came with the tagged head in \
T0b, when the four plain Associations GradedPairing, SullivanModel, \
PoincareDualityAlgebra and AInfinityAlgebra became tagged objects, each with \
a recognizer named after it. Until R7 it tested the head and the Association \
inside and nothing more, so GradedPairing[<|x -> -1|>] was recognized. Since \
R7 (Pavel, 2026-10-01: \"fix all\") it tests the keys the constructor always \
writes, \"Degrees\" and \"Values\" holding Associations, \"Degree\", and \
\"Convention\" holding \"Symmetric\" or \"Exterior\", so it is True exactly \
on what GradedPairing builds, also after an Append, and no stricter than the \
operations, which read those four keys. PoincareDualityAlgebraQ got the same \
fix. It gives True or False on every input and does not check that the values \
are consistent with the degrees. Prior art: the Wolfram Language names its \
structural tests the same way (AssociationQ, MatrixQ), and AssociationQ gives \
False on the tagged object, since the head is GradedPairing. The engine the \
verification suites load has no pairing object and so no recognizer.", "\n\n", 
       Cell[
        BoxData[
         GridBox[{{
            Cell[
             BoxData[
              ButtonBox[
               DynamicBox[
                FEPrivate`FrontEndResource[
                "DocumentationToolsStrings", "Edit"]], BaseStyle -> 
               "TextAnnotationButton"]]], 
            StyleBox[
             RowBox[{
               DynamicBox[
                FEPrivate`FrontEndResource[
                "DocumentationToolsStrings", "LastAnnotator"]], "pavel"}], 
             "TextAnnotator"], 
            Cell[
             BoxData[
              ButtonBox[
               DynamicBox[
                FEPrivate`FrontEndResource[
                "DocumentationToolsStrings", "Delete"]], BaseStyle -> 
               "TextAnnotationRemoveButton"]]], ""}}, 
          GridBoxAlignment -> {
           "Columns" -> {Left, Left, Right, Right}, "Rows" -> {{Automatic}}}, 
          GridBoxItemSize -> {"Columns" -> {
              Scaled[0.15], 
              Scaled[0.68], 
              Scaled[0.15], 
              Scaled[0.02]}}]]], "\n"}], "TextAnnotation", 
     CellSize -> {590, Inherited}]}},
 CellTags->"TextAnnotation",
 CellID->366257553,ExpressionUUID->"f228e2fa-d37c-4242-8957-754706c1aced"],

Cell["\<\
It tests the form of the expression. It does not check that the values are \
consistent with the degrees.\
\>", "Notes",ExpressionUUID->"fdcfd191-dbea-46a6-87d7-14ce28510d8d"],

