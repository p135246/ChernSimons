Notebook[{

Cell[CellGroupData[{
Cell["SymmetricProduct", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"d9f09eb3-fd05-476d-9c12-9c5eeddfe917"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["SymmetricProduct"]], 
     "paclet:ChernSimons/ref/SymmetricProduct", "ChernSimons Package Symbol"},
    
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["u", "TI"], ",", " ", 
    StyleBox["v", "TI"], ",", " ", "\[Ellipsis]", ",", " ", 
    StyleBox["pairing", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "83e6c274-73f7-4f3b-825f-b3f6bbbaecb0"],
 "\[LineSeparator]",
 "gives the graded symmetric product ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["u", "TI"], "\[CircleDot]", 
    StyleBox["v", "TI"], "\[CircleDot]", "\[CenterEllipsis]"}], 
   TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9ba07321-5d43-4f1b-9856-bdafcbc72849"],
 " of cyclic words, sorted into canonical order with the Koszul sign of the \
symmetric grading.",
 "\n"
}], "Usage",ExpressionUUID->"d09c2e6f-932a-4c75-a777-344154d0f861"],

Cell["\<\
The factors are cyclic words, or lists of particles; the last argument is \
always the pairing object. The product is linear in every factor.\
\>", "Notes",ExpressionUUID->"bdb603ed-2997-454d-a22a-3bbb447e74b8"],

Cell[TextData[{
 "Sorting uses the symmetric grading ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     RowBox[{"[", "-", "]"}], "1"], "\[LongEqual]", 
    RowBox[{"[", "-", "]"}], "-", "1"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e70da580-d469-475e-890d-a598292b17f7"],
 ", the one ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["WordDegree"]], "paclet:ChernSimons/ref/WordDegree", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "2b899478-2aeb-40db-810d-e977b031011d"],
 " returns under ",
 Cell[BoxData["\"\<Symmetric\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "18d7ae85-780a-4f10-98ba-2c17c7ee9622"],
 ". Exchanging two factors costs ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"-", "1"}], ")"}], 
    RowBox[{
     SubscriptBox[
      RowBox[{"[", 
       StyleBox["u", "TI"], "]"}], "1"], 
     SubscriptBox[
      RowBox[{"[", 
       StyleBox["v", "TI"], "]"}], "1"]}]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "48bfdebc-caa6-43aa-bced-6b5e3d5a9499"],
 "."
}], "Notes",ExpressionUUID->"f555d36a-12c5-4231-bc36-44c7a452174d"],

Cell[TextData[{
 "Because the grading is shifted by one relative to ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ExteriorProduct"]], "paclet:ChernSimons/ref/ExteriorProduct", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "656968ae-35c6-4793-b567-cf08c54fdfb2"],
 ", the two products disagree on signs on the very same factors. Reconciling \
them is what ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ShiftIsomorphism"]], "paclet:ChernSimons/ref/ShiftIsomorphism",
     "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "956c48c8-5425-4842-b19e-9d5fb116c3f7"],
 " is for, and the sign translation between the two pictures is the delicate \
part of the whole subject."
}], "Notes",ExpressionUUID->"cc53015a-2c8b-4f2c-acc5-cc43db9b014d"],

Cell["\<\
The normalized result carries only its factors \[LongDash] the pairing \
argument is consumed.\
\>", "Notes",ExpressionUUID->"84a64630-dd06-4d54-b376-cede7332bd94"],

Cell[TextData[{
 "A product with a repeated factor of odd symmetric degree is ",
 Cell[BoxData[
  FormBox["0", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cd0c6bff-e006-4eae-9c22-864a757c4aad"],
 "."
}], "Notes",ExpressionUUID->"93b91907-9e99-4cdb-92c2-672508fb1d7b"],

Cell[TextData[{
 "This is the default picture: a pairing object built by ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["GradedPairing"]], "paclet:ChernSimons/ref/GradedPairing", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "85a0f7cf-e639-4834-9467-3c0dc0bca535"],
 " carries ",
 Cell[BoxData[
  RowBox[{"\"\<Convention\>\"", " ", "->", " ", "\"\<Symmetric\>\""}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "66993ed9-4a09-401a-b622-2b627dbb1a2a"],
 " unless it is reset."
}], "Notes",ExpressionUUID->"e8ca0969-48ea-4d2b-a45e-d49a7901f197"],

Cell[TextData[{
 "A normalized product displays as its factors joined by ",
 Cell[BoxData[
  FormBox["\[CircleDot]", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fdabdc22-6d66-4e21-b3fa-b0b5c7fd83a0"],
 ", each word in its own parentheses."
}], "Notes",ExpressionUUID->"16a50049-d2f9-43ec-8e9e-55c481fb0500"]
}, Open  ]],

