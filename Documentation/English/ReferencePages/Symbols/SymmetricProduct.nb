Cell["Two factors, sorted into canonical order:", "ExampleText",ExpressionUUID->"e93ab30a-c1ff-4f60-b45e-1fc69946bf00"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"SymmetricProduct", "[", 
  RowBox[{
   RowBox[{"CyclicWord", "[", 
    RowBox[{"{", "y", "}"}], "]"}], ",", " ", 
   RowBox[{"CyclicWord", "[", 
    RowBox[{"{", "x", "}"}], "]"}], ",", " ", 
   RowBox[{"GradedPairing", "[", 
    RowBox[{
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"x", " ", "->", " ", 
        RowBox[{"-", "1"}]}], ",", " ", 
       RowBox[{"y", " ", "->", " ", "0"}]}], "|>"}], ",", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "y"}], "}"}], " ", "->", " ", "1"}], "|>"}]}], 
    "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"2a6d1bea-9454-4c96-abae-6b726a8824c4"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{
   InterpretationBox[
    RowBox[{"(", "x", ")"}],
    ChernSimons`CyclicWord[{MTNB$19ot8qwgfrkag`x}],
    Editable->False], "\[CircleDot]", 
   InterpretationBox[
    RowBox[{"(", "y", ")"}],
    ChernSimons`CyclicWord[{MTNB$19ot8qwgfrkag`y}],
    Editable->False]}],
  ChernSimons`SymmetricProduct[
   ChernSimons`CyclicWord[{MTNB$19ot8qwgfrkag`x}], 
   ChernSimons`CyclicWord[{MTNB$19ot8qwgfrkag`y}]],
  Editable->False]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"1219cc03-0625-4a2d-8fe2-40a19c236e3e"]
}, Open  ]],

