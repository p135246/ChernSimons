Cell["\<\
Factors may be given as lists of particles, and are brought into canonical \
rotation:\
\>", "ExampleText",ExpressionUUID->"0ae16c22-0aff-4cc6-a4a9-f11f8d08f92c"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"pairing", " ", "=", " ", 
   RowBox[{"GradedPairing", "[", 
    RowBox[{
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"x", " ", "->", " ", 
        RowBox[{"-", "1"}]}], ",", " ", 
       RowBox[{"y", " ", "->", " ", "0"}]}], "|>"}], ",", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "y"}], "}"}], " ", "->", " ", "1"}], "|>"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"SymmetricProduct", "[", 
    RowBox[{
     RowBox[{"{", "y", "}"}], ",", " ", 
     RowBox[{"{", "x", "}"}], ",", " ", "pairing"}], "]"}], ",", " ", 
   RowBox[{"SymmetricProduct", "[", 
    RowBox[{
     RowBox[{"CyclicWord", "[", 
      RowBox[{"{", 
       RowBox[{"y", ",", " ", "x", ",", " ", "x"}], "}"}], "]"}], ",", " ", 
     RowBox[{"CyclicWord", "[", 
      RowBox[{"{", "y", "}"}], "]"}], ",", " ", "pairing"}], "]"}]}], 
  "}"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"aad9fe9c-a9a9-410e-a21b-8c015f3c5d3e"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   InterpretationBox[
    RowBox[{
     InterpretationBox[
      RowBox[{"(", "x", ")"}],
      ChernSimons`CyclicWord[{MTNB$19ot8qwgfrkag`x}],
      Editable->False], "\[CircleDot]", 
     InterpretationBox[
      RowBox[{"(", "y", ")"}],
      ChernSimons`CyclicWord[{MTNB$19ot8qwgfrkag`y}],
      Editable->False]}],
    ChernSimons`SymmetricProduct[
     ChernSimons`CyclicWord[{MTNB$19ot8qwgfrkag`x}], 
     ChernSimons`CyclicWord[{MTNB$19ot8qwgfrkag`y}]],
    Editable->False], ",", 
   InterpretationBox[
    RowBox[{
