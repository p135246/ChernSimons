Cell["Two factors, sorted into canonical order:", "ExampleText",ExpressionUUID->"438183b6-3b22-4168-92d8-b91cbfc7c752"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"SymmetricProduct", "[", 
  RowBox[{
   RowBox[{"CyclicWord", "[", 
    RowBox[{"{", "y", "}"}], "]"}], ",", " ", 
   RowBox[{"CyclicWord", "[", 
    RowBox[{"{", "x", "}"}], "]"}], ",", " ", 
   RowBox[{"GradedPairing", "[", 
    RowBox[{
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"x", " ", "->", " ", 
        RowBox[{"-", "1"}]}], ",", " ", 
       RowBox[{"y", " ", "->", " ", "0"}]}], "|>"}], ",", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "y"}], "}"}], " ", "->", " ", "1"}], "|>"}]}], 
    "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"8be1710a-5821-447a-b126-a5363d6953d9"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{
   InterpretationBox[
    RowBox[{"(", "x", ")"}],
    ChernSimons`CyclicWord[{MTNB$hdlhq51dtyt3`x}],
    Editable->False], "\[CircleDot]", 
   InterpretationBox[
    RowBox[{"(", "y", ")"}],
    ChernSimons`CyclicWord[{MTNB$hdlhq51dtyt3`y}],
    Editable->False]}],
  ChernSimons`SymmetricProduct[
   ChernSimons`CyclicWord[{MTNB$hdlhq51dtyt3`x}], 
   ChernSimons`CyclicWord[{MTNB$hdlhq51dtyt3`y}]],
  Editable->False]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"692d2c26-1134-41af-a533-fcf6b876f805"]
}, Open  ]],

