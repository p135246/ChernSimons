Notebook[{

Cell[CellGroupData[{
Cell["SymmetricProduct", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"7afabb5e-483d-4519-863e-c9166fc1fdaa"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["SymmetricProduct"]], 
     "paclet:IBLInfinity/ref/SymmetricProduct", "IBLInfinity Package Symbol"},
    
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["u", "TI"], ",", " ", 
    StyleBox["v", "TI"], ",", " ", "\[Ellipsis]", ",", " ", 
    StyleBox["pairing", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8f3dfc9e-a15c-44a7-afa9-9ab216a3986e"],
 "\[LineSeparator]",
 "gives the graded symmetric product ",
 Cell[BoxData[
  RowBox[{
   StyleBox["u", "TI"], "\[CircleDot]", 
   StyleBox["v", "TI"], "\[CircleDot]", "\[CenterDot]", 
   StyleBox["s", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3bde8090-9f68-46b9-9e7f-0ae35c493a65"],
 " of cyclic words, sorted into canonical order with the Koszul sign of the \
symmetric grading.",
 "\n"
}], "Usage",ExpressionUUID->"7c47047d-7b27-41d1-884e-c3f0837cc2fb"],

Cell["\<\
The factors are cyclic words; the last argument is always the pairing object.\
\
\>", "Notes",ExpressionUUID->"aab789f5-c3af-4bc1-9f10-cb3e12fcb2c4"],

Cell[TextData[{
 "Sorting uses the symmetric grading ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    RowBox[{
     StyleBox["[",
      SpanMaxSize->1], "-", 
     StyleBox["]",
      SpanMaxSize->1]}], "1"], "=", 
   StyleBox["[",
    SpanMaxSize->1], "-", 
   StyleBox["]",
    SpanMaxSize->1], "-", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2be687c1-d1b9-4bc1-91f9-c8f3ffa6008b"],
 ", the one ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["WordDegree"]], "paclet:IBLInfinity/ref/WordDegree", 
    "IBLInfinity Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "d3bdb039-8c7a-4a5e-8686-027f07309587"],
 " returns under ",
 Cell[BoxData["\"\<Symmetric\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "14ece0a2-5ed6-48e3-ab3c-01cf1a0f9cb7"],
 ". Exchanging two factors costs ",
 Cell[BoxData[
  SuperscriptBox[
   RowBox[{
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{"-", "1"}], 
    StyleBox[")",
     SpanMaxSize->1]}], 
   RowBox[{
    SubscriptBox[
     RowBox[{
      StyleBox["[",
       SpanMaxSize->1], 
      StyleBox["u", "TI"], 
      StyleBox["]",
       SpanMaxSize->1]}], "1"], 
    SubscriptBox[
     RowBox[{
      StyleBox["[",
       SpanMaxSize->1], 
      StyleBox["v", "TI"], 
      StyleBox["]",
       SpanMaxSize->1]}], "1"]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "11906b13-80b6-46c2-8432-8b217370ad12"],
 "."
}], "Notes",ExpressionUUID->"28c67c31-3fc7-4266-8f47-70e645a4481d"],

Cell[TextData[{
 "Because the grading is shifted by one relative to ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ExteriorProduct"]], "paclet:IBLInfinity/ref/ExteriorProduct", 
    "IBLInfinity Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "e74a77cd-5f37-43d1-bf02-67dd8a595f19"],
 ", the two products disagree on signs on the very same factors. Reconciling \
them is what ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ShiftIsomorphism"]], "paclet:IBLInfinity/ref/ShiftIsomorphism",
     "IBLInfinity Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "b15a44d3-9c22-47a2-9a73-25b11e152149"],
 " is for, and the sign translation between the two pictures is the delicate \
part of the whole subject."
}], "Notes",ExpressionUUID->"7596eab7-25f2-479f-930c-ef672e828892"],

Cell["\<\
The normalized result carries only its factors \[LongDash] the pairing \
argument is consumed.\
\>", "Notes",ExpressionUUID->"9ec29efb-3e5a-436a-82cb-1a12f152cd01"],

Cell[TextData[{
 "A product with a repeated factor of odd symmetric degree is ",
 Cell[BoxData["0"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "29c95065-a903-4ee3-9ec7-eae6cb972205"],
 "."
}], "Notes",ExpressionUUID->"c0ba886b-1ccb-4330-8bb0-ec4df06ddaf0"],

Cell[TextData[{
 "This is the default picture: a pairing object built by ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Pairing"]], "paclet:IBLInfinity/ref/Pairing", 
    "IBLInfinity Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "13c39cf4-9697-4565-a615-f21367f88f1c"],
 " carries ",
 Cell[BoxData[
  RowBox[{"\"\<Convention\>\"", " ", "->", " ", "\"\<Symmetric\>\""}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "83800f36-4688-4f7d-b428-39cf8a2b6e73"],
 " unless it is reset."
}], "Notes",ExpressionUUID->"9a4b8c0a-5e4c-4bba-8d57-4e5ce2de1e7e"]
}, Open  ]],

