Cell[CellGroupData[{
Cell["SymmetricProduct", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"ce5f69f1-aadc-4c55-bcf1-74ed79c98cee"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["SymmetricProduct"]], 
     "paclet:ChernSimons/ref/SymmetricProduct", "ChernSimons Package Symbol"},
    
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["u", "TI"], ",", " ", 
    StyleBox["v", "TI"], ",", " ", "\[Ellipsis]", ",", " ", 
    StyleBox["pairing", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5b955a9b-7b62-415a-9c43-eb60fda68713"],
 "\[LineSeparator]",
 "gives the graded symmetric product ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["u", "TI"], "\[CircleDot]", 
    StyleBox["v", "TI"], "\[CircleDot]", "\[CenterEllipsis]"}], 
   TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "271e7bbc-442b-4a3c-a4b4-249aea3b09f6"],
 " of the cyclic words ",
 StyleBox["u", "TI"],
 ", ",
 StyleBox["v", "TI"],
 ", \[Ellipsis], in canonical order with the Koszul sign of the symmetric \
grading.",
 "\n"
}], "Usage",ExpressionUUID->"7e5f73bd-fe97-4922-9092-115ce74fb92d"],

Cell["\<\
The factors are cyclic words or lists of particles, and the last argument is \
the pairing object.\
\>", "Notes",
 CellFrameLabels->{{Inherited, Inherited}, {Inherited, 
    Cell[
     TextData[{
      "26.09.30: Design review - the symmetric product is the default of the \
two pictures the paper works in: a pairing object built by GradedPairing \
carries \"Convention\" -> \"Symmetric\", and the Beilinson-Drinfeld exports \
compute in it only. The sign translation between it and the exterior product \
is the heart of the project, so both products are exported and \
SymmetricToExterior and ExteriorToSymmetric carry one to the other. The \
pairing is the last positional argument, because the sort needs the symmetric \
degrees and they depend on the pairing degree; it is consumed, and the result \
SymmetricProduct[u, v, ...] carries only its factors, so an expression \
without a pairing is inert and is the normal form. A single remaining factor \
is the word itself, never a one-factor product, the rule every product of the \
paclet follows; the engine keeps a one-factor odot instead, which is why the \
comparison with it starts at two factors. The product carries its own \
linearity rules and accepts lists of particles, so a sum or a scalar multiple \
composes without a wrapper. Prior art: the Wolfram Language has no graded \
symmetric product; Symmetrize symmetrizes arrays. The engine the verification \
suites load builds its odot and wedge from one constructor, and \
T12/paclet-products-and-shift pins this product against its odot on all \
products of two and three words to length 3.", "\n\n", 
       Cell[
        BoxData[
         GridBox[{{
            Cell[
             BoxData[
              ButtonBox[
               DynamicBox[
                FEPrivate`FrontEndResource[
                "DocumentationToolsStrings", "Edit"]], BaseStyle -> 
               "TextAnnotationButton"]]], 
            StyleBox[
             RowBox[{
               DynamicBox[
                FEPrivate`FrontEndResource[
                "DocumentationToolsStrings", "LastAnnotator"]], "pavel"}], 
             "TextAnnotator"], 
            Cell[
             BoxData[
              ButtonBox[
               DynamicBox[
                FEPrivate`FrontEndResource[
                "DocumentationToolsStrings", "Delete"]], BaseStyle -> 
               "TextAnnotationRemoveButton"]]], ""}}, 
          GridBoxAlignment -> {
           "Columns" -> {Left, Left, Right, Right}, "Rows" -> {{Automatic}}}, 
          GridBoxItemSize -> {"Columns" -> {
              Scaled[0.15], 
              Scaled[0.68], 
              Scaled[0.15], 
              Scaled[0.02]}}]]], "\n"}], "TextAnnotation", 
     CellSize -> {590, Inherited}]}},
 CellTags->"TextAnnotation",
 CellID->115191447,ExpressionUUID->"603129e1-a3ff-49db-b153-e70e96b07ffa"],

Cell[TextData[{
 "The factors are brought into canonical rotation and sorted in the symmetric \
grading ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     RowBox[{"[", "-", "]"}], "1"], "\[LongEqual]", 
    RowBox[{"[", "-", "]"}], "-", "1"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "98d5f1e4-f487-4c1f-b4bd-0d24c3d590b4"],
 ", the one ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ElementDegree"]], "paclet:ChernSimons/ref/ElementDegree", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "f65ba243-0c1b-4b83-a4b8-4b554e697487"],
 " gives under ",
 Cell[BoxData["\"\<Symmetric\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e61434ad-311f-4ebb-8b52-c44f5c485820"],
 ". Exchanging two factors ",
 Cell[BoxData[
  FormBox[
   StyleBox["u", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "50de5164-3e30-4450-ba9a-3cd3605b6ffc"],
 " and ",
 Cell[BoxData[
  FormBox[
   StyleBox["v", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "70772298-8230-4a32-817e-451bf809e6db"],
 " costs ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"-", "1"}], ")"}], 
    RowBox[{
     SubscriptBox[
      RowBox[{"[", 
       StyleBox["u", "TI"], "]"}], "1"], 
     SubscriptBox[
      RowBox[{"[", 
       StyleBox["v", "TI"], "]"}], "1"]}]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2d26f68d-f31e-4197-bcb6-641f0f0f59a7"],
 ", the sign ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["KoszulSign"]], "paclet:ChernSimons/ref/KoszulSign", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "7ff9ce28-ca58-4fce-9c7b-394978ff989d"],
 " gives with ",
 StyleBox["parity", "TI"],
 " ",
 Cell[BoxData[
  FormBox["0", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ab617ff2-ccf4-4712-bb95-b81c430b0e6e"],
 "."
}], "Notes",ExpressionUUID->"e176540e-f83f-49f3-83bf-a664580cc821"],

Cell[TextData[{
 "The pairing is consumed: the result is an expression ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["SymmetricProduct"]], 
     "paclet:ChernSimons/ref/SymmetricProduct", "ChernSimons Package Symbol"},
    
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    RowBox[{
     StyleBox["u", "TI"], "'"}], ",", " ", 
    RowBox[{
     StyleBox["v", "TI"], "'"}], ",", " ", "\[Ellipsis]"}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "48b4ee64-4ad3-427c-87ce-1f2a564c64f7"],
 " of the sorted factors, possibly with a scalar sign in front."
}], "Notes",ExpressionUUID->"7ec5f2c2-c0a1-4d2f-bd57-95d9b57b4990"],

Cell[TextData[{
 "A product with a repeated factor of odd symmetric degree is ",
 Cell[BoxData[
  FormBox["0", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d26a4f02-900f-4b31-8eb3-180da964c99b"],
 "."
}], "Notes",ExpressionUUID->"4e712f63-8d69-47dd-9446-5983d8e477f3"],

Cell["The product of a single factor is the word itself.", "Notes",ExpressionUUID->"d57e4e5f-2375-48a7-b7b0-6fa83a3b88b2"],

Cell["\<\
The product is linear in every factor, and a nested product is flattened.\
\>", "Notes",ExpressionUUID->"07244ce1-26e0-456c-9c1e-7224bd9f9469"],

Cell["A factor given as the empty list is the empty word.", "Notes",ExpressionUUID->"f3a97f50-626b-4507-bbb8-a0f6563d082f"],

Cell[TextData[{
 "The grading is shifted by one from that of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ExteriorProduct"]], "paclet:ChernSimons/ref/ExteriorProduct", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "8a6ec08b-1f95-4b04-b7df-028c5996db10"],
 ", so the two products sort the same factors with different signs. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SymmetricToExterior"]], 
    "paclet:ChernSimons/ref/SymmetricToExterior", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "f0886f11-3793-4791-bef5-914dcc6c0387"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ExteriorToSymmetric"]], 
    "paclet:ChernSimons/ref/ExteriorToSymmetric", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "e5f5ec03-c7cf-483a-a9b9-d4e6f053af0c"],
 " translate between them."
}], "Notes",ExpressionUUID->"85a4fbe4-8882-4690-9c8d-3f8ab8fe3203"],

Cell[TextData[{
 "A pairing object built by ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["GradedPairing"]], "paclet:ChernSimons/ref/GradedPairing", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "40058c10-e7de-4645-bab7-290a86c3dfa5"],
 " carries ",
 Cell[BoxData[
  RowBox[{"\"\<Convention\>\"", " ", "->", " ", "\"\<Symmetric\>\""}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6545ef93-47d9-4271-97ea-3e72075ef69c"],
 " unless it is reset, and its operations give their products as ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
