   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "ed9a8211-2eb8-4a39-b04e-e88641212616"],
 "."
}], "Notes",ExpressionUUID->"118f7acf-2cd7-4dd6-9548-68d6265109cf"],

Cell[TextData[{
 "A sorted product displays as its factors joined by ",
