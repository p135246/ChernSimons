Cell[CellGroupData[{
Cell["SymmetricProduct", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"da0b7a31-6794-4c4a-9561-574d11de1c9c"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["SymmetricProduct"]], 
     "paclet:ChernSimons/ref/SymmetricProduct", "ChernSimons Package Symbol"},
    
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["u", "TI"], ",", " ", 
    StyleBox["v", "TI"], ",", " ", "\[Ellipsis]", ",", " ", 
    StyleBox["pairing", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "d4de8e15-1743-4d42-aa20-9c18fd1afbc9"],
 "\[LineSeparator]",
 "gives the graded symmetric product ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["u", "TI"], "\[CircleDot]", 
    StyleBox["v", "TI"], "\[CircleDot]", "\[CenterEllipsis]"}], 
   TraditionalForm]], "InlineFormula",ExpressionUUID->
  "1e2f885a-5c30-4d3a-9d35-9278a793eb23"],
 " of the cyclic words ",
 StyleBox["u", "TI"],
 ", ",
 StyleBox["v", "TI"],
 ", \[Ellipsis], in canonical order with the Koszul sign of the symmetric \
grading.",
 "\n"
}], "Usage",ExpressionUUID->"2afd09ec-8768-4e33-853d-fb3baba5ebb6"],

Cell["\<\
The factors are cyclic words or lists of letters, and the last argument is \
the pairing object.\
\>", "Notes",
 CellFrameLabels->{{Inherited, Inherited}, {Inherited, 
    Cell[
     TextData[{
      "26.09.30: Design review - the symmetric product is the default of the \
two pictures the paper works in: a pairing object built by GradedPairing \
carries \"Convention\" -> \"Symmetric\", and the Beilinson-Drinfeld exports \
compute in it only. The sign translation between it and the exterior product \
is the heart of the project, so both products are exported and \
SymmetricToExterior and ExteriorToSymmetric carry one to the other. The \
pairing is the last positional argument, because the sort needs the symmetric \
degrees and they depend on the pairing degree; it is consumed, and the result \
SymmetricProduct[u, v, ...] carries only its factors, so an expression \
without a pairing is inert and is the normal form. A single remaining factor \
is the word itself, never a one-factor product, the rule every product of the \
paclet follows; the engine keeps a one-factor odot instead, which is why the \
comparison with it starts at two factors. The product carries its own \
linearity rules and accepts lists of letters, so a sum or a scalar multiple \
composes without a wrapper. Prior art: the Wolfram Language has no graded \
symmetric product; Symmetrize symmetrizes arrays. The engine the verification \
suites load builds its odot and wedge from one constructor, and \
T12/paclet-products-and-shift pins this product against its odot on all \
products of two and three words to length 3.", "\n\n", 
       Cell[
        BoxData[
         GridBox[{{
            Cell[
             BoxData[
              ButtonBox[
               DynamicBox[
                FEPrivate`FrontEndResource[
                "DocumentationToolsStrings", "Edit"]], BaseStyle -> 
               "TextAnnotationButton"]]], 
            StyleBox[
             RowBox[{
               DynamicBox[
                FEPrivate`FrontEndResource[
                "DocumentationToolsStrings", "LastAnnotator"]], "pavel"}], 
             "TextAnnotator"], 
            Cell[
             BoxData[
              ButtonBox[
               DynamicBox[
                FEPrivate`FrontEndResource[
                "DocumentationToolsStrings", "Delete"]], BaseStyle -> 
               "TextAnnotationRemoveButton"]]], ""}}, 
          GridBoxAlignment -> {
           "Columns" -> {Left, Left, Right, Right}, "Rows" -> {{Automatic}}}, 
          GridBoxItemSize -> {"Columns" -> {
              Scaled[0.15], 
              Scaled[0.68], 
              Scaled[0.15], 
              Scaled[0.02]}}]]], "\n"}], "TextAnnotation", 
     CellSize -> {590, Inherited}]}},
 CellTags->"TextAnnotation",
 CellID->293271306,ExpressionUUID->"ba68aa27-253b-4dc7-9c57-fdf8839ffff7"],

Cell[TextData[{
 "The factors are brought into canonical rotation and sorted in the symmetric \
grading ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     RowBox[{"[", "-", "]"}], "1"], "\[LongEqual]", 
    RowBox[{"[", "-", "]"}], "-", "1"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"6e10ba78-1077-40c2-a309-75a4847b584b"],
 ", the one ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ElementDegree"]], "paclet:ChernSimons/ref/ElementDegree", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "146a09db-9ea2-4712-9be3-394b84ebfa95"],
 " gives under ",
 Cell[BoxData["\"\<Symmetric\>\""], "InlineFormula",ExpressionUUID->
  "3234e8ce-6e5d-47d1-8b59-5645c39c3c83"],
 ". Exchanging two factors ",
 Cell[BoxData[
  FormBox[
   StyleBox["u", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "50ad96e8-8213-4693-9a57-ef2d5602275d"],
 " and ",
 Cell[BoxData[
  FormBox[
   StyleBox["v", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "87eb602c-d2f3-4dc0-bb2a-6a9460366780"],
 " costs ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"-", "1"}], ")"}], 
    RowBox[{
     SubscriptBox[
      RowBox[{"[", 
       StyleBox["u", "TI"], "]"}], "1"], 
     SubscriptBox[
      RowBox[{"[", 
       StyleBox["v", "TI"], "]"}], "1"]}]], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"7d758b00-110b-48a6-b34b-69e8421716cd"],
 ", the sign ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["KoszulSign"]], "paclet:ChernSimons/ref/KoszulSign", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "76bb827e-7a89-4b6e-b2b3-74977a7420c8"],
 " gives with ",
 StyleBox["parity", "TI"],
 " ",
 Cell[BoxData[
  FormBox["0", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "0c1eca00-aa98-4ab8-a7e1-92ced7d4f77c"],
 "."
}], "Notes",ExpressionUUID->"2d1bfb01-1db8-4420-88e0-f1b70d9a8e88"],

Cell[TextData[{
 "The pairing is consumed: the result is an expression ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["SymmetricProduct"]], 
     "paclet:ChernSimons/ref/SymmetricProduct", "ChernSimons Package Symbol"},
    
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    RowBox[{
     StyleBox["u", "TI"], "'"}], ",", " ", 
    RowBox[{
     StyleBox["v", "TI"], "'"}], ",", " ", "\[Ellipsis]"}], "]"}]], 
  "InlineFormula",ExpressionUUID->"40435e8a-beb8-473c-834c-bf958f2a7319"],
 " of the sorted factors, possibly with a scalar sign in front."
}], "Notes",ExpressionUUID->"3420153f-8786-4de1-ab31-fc0f9370bbaf"],

Cell[TextData[{
 "A product with a repeated factor of odd symmetric degree is ",
 Cell[BoxData[
  FormBox["0", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "34156abb-dfbd-4525-b12f-7e551b350f8c"],
 "."
}], "Notes",ExpressionUUID->"112e7d7e-0cf7-44ec-9d35-b74621a0fe09"],

Cell["The product of a single factor is the word itself.", "Notes",ExpressionUUID->"ad0e30ab-8955-4c9f-be93-55640e820c35"],

Cell["\<\
The product is linear in every factor, and a nested product is flattened.\
\>", "Notes",ExpressionUUID->"8713a4ee-5619-4654-a6c3-bd344d665bca"],

Cell["A factor given as the empty list is the empty word.", "Notes",ExpressionUUID->"8171da79-7aa6-4bb1-b31b-2dea35c0e3ea"],

Cell[TextData[{
 "The grading is shifted by one from that of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ExteriorProduct"]], "paclet:ChernSimons/ref/ExteriorProduct", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "2ebe3160-0222-40aa-b59e-99847a50e69b"],
 ", so the two products sort the same factors with different signs. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SymmetricToExterior"]], 
    "paclet:ChernSimons/ref/SymmetricToExterior", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "f02d7033-c713-47f8-8753-66fac9948529"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ExteriorToSymmetric"]], 
    "paclet:ChernSimons/ref/ExteriorToSymmetric", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "b7600b89-af26-4199-a97f-7355352aa56c"],
 " translate between them."
}], "Notes",ExpressionUUID->"79f4f6ad-69b3-439d-ab20-bc84ab9e6276"],

Cell[TextData[{
 "A pairing object built by ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["GradedPairing"]], "paclet:ChernSimons/ref/GradedPairing", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "8662e215-23f4-4c7f-ac84-1f211b31f057"],
 " carries ",
 Cell[BoxData[
  RowBox[{"\"\<Convention\>\"", " ", "->", " ", "\"\<Symmetric\>\""}]], 
  "InlineFormula",ExpressionUUID->"69fcd433-c477-4e45-a1be-914725df48cd"],
 " unless it is reset, and its operations give their products as ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SymmetricProduct"]], "paclet:ChernSimons/ref/SymmetricProduct",
     "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "8f53cbd8-aa87-439b-a2a9-dcf3f57414e5"],
 "."
}], "Notes",ExpressionUUID->"e4a9507b-e5d6-4847-a396-5033578fdebe"],

Cell[TextData[{
 "A sorted product displays as its factors joined by ",
 Cell[BoxData[
  FormBox["\[CircleDot]", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "7e035853-66b6-427f-9c5a-bd5bd2dd6dd2"],
 ", each word in its own parentheses."
}], "Notes",ExpressionUUID->"3da39ac7-0f50-40be-a0fc-031e7d3b617c"]
}, Open  ]],

