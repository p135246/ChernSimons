      RowBox[{"{", 
       RowBox[{"x", ",", " ", "y"}], "}"}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", "pairing"}], "]"}]}], 
  "}"}]}], "Input",
