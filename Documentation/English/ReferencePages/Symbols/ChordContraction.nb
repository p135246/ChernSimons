Cell[CellGroupData[{
Cell["ChordContraction", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"ddebda21-fbe3-43e0-9263-77a56e74279c"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["ChordContraction"]], 
     "paclet:ChernSimons/ref/ChordContraction", "ChernSimons Package Symbol"},
    
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["u", "TI"], ",", " ", 
    StyleBox["v", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["i", "TI"], ",", " ", 
      StyleBox["j", "TI"]}], "}"}], ",", " ", 
    StyleBox["pairing", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d310de76-ebe5-4189-8d64-13523dc24789"],
 "\[LineSeparator]",
 "gives the term of the bracket of the cyclic words ",
 StyleBox["u", "TI"],
 " and ",
 StyleBox["v", "TI"],
 " in which particle ",
 StyleBox["i", "TI"],
 " of ",
 StyleBox["u", "TI"],
 " is contracted against particle ",
 StyleBox["j", "TI"],
 " of ",
 StyleBox["v", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"963c019f-d828-4974-aa30-3fcaef3942ce"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["ChordContraction"]], 
     "paclet:ChernSimons/ref/ChordContraction", "ChernSimons Package Symbol"},
    
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["w", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["i", "TI"], ",", " ", 
      StyleBox["j", "TI"]}], "}"}], ",", " ", 
    StyleBox["pairing", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "09c48ed6-4a58-46d8-9541-753f545c38b2"],
 "\[LineSeparator]",
 "gives the term of the co-bracket of the cyclic word ",
 StyleBox["w", "TI"],
 " in which particles ",
 StyleBox["i", "TI"],
 " and ",
 StyleBox["j", "TI"],
 " are contracted and the word is cut into two arcs."
}], "Usage",ExpressionUUID->"06a9659e-d565-4cf9-afec-3c7205e26526"],

Cell[TextData[{
 "A chord joins two particles whose pairing value is nonzero. Between two \
words it joins the two circles into one: the two contracted particles are \
removed and the two remainders are concatenated, each read cyclically from \
the particle after the contracted one. On one word it cuts the circle into \
two: the arc from ",
 StyleBox["i", "TI"],
 " to ",
 StyleBox["j", "TI"],
 " and the arc from ",
 StyleBox["j", "TI"],
 " to ",
 StyleBox["i", "TI"],
 ", each without its endpoints."
}], "Notes",ExpressionUUID->"e1928c5f-3864-4491-8525-375d844cf6ff"],

Cell[TextData[{
 "The value is the pairing of the two particles, times the Koszul sign of the \
convention of ",
 StyleBox["pairing", "TI"],
 ", times the resulting word, or product of two words, in canonical form. The \
",
 Cell[BoxData["\"\<Convention\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "09c54817-51e2-45df-bb4f-ffc026019200"],
 " key of ",
 StyleBox["pairing", "TI"],
 " selects the symmetric or the exterior sign."
}], "Notes",ExpressionUUID->"2bee98b1-5074-4c16-8d8e-226baf54bbe9"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InvolutiveBracket"]], 
    "paclet:ChernSimons/ref/InvolutiveBracket", "ChernSimons Package Symbol"},
   
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "08e4d291-557b-4b09-9c10-2953b7131b46"],
 " is the sum over every pair ",
 StyleBox["{i, j}", "TI"],
 " of positions, and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InvolutiveCobracket"]], 
    "paclet:ChernSimons/ref/InvolutiveCobracket", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "12ae6a26-ce39-45db-8d15-30d132e1900c"],
 " is one half of the sum over every ordered pair of distinct positions."
}], "Notes",ExpressionUUID->"a451b138-ab44-4a31-a4ad-8a02e286d32c"],

