  "cc88c6f6-56eb-4c68-9503-bede83d8d950"],
 " is the sum over every pair ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     StyleBox["i", "TI"], ",", 
     StyleBox["j", "TI"]}], "}"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "80bb223c-10f6-4c7e-aa7a-39dd3d26f7ed"],
