  FormBox["1", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "247d4cac-b083-4d08-b182-f9ad136e359d"],
 " along the list of particles."
}], "Notes",ExpressionUUID->"23dcbfad-1769-430b-b726-9a291faf4ed2"],

