 StyleBox["v", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"4a6f4b09-dd00-47f2-a326-f8be5126b1b4"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["ChordContraction"]], 
