   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "cda2e9e4-e91f-488b-b842-972d10b5da10"],
 " is the sum over every pair ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     StyleBox["i", "TI"], ",", 
     StyleBox["j", "TI"]}], "}"}], TraditionalForm]], "InlineFormula",
