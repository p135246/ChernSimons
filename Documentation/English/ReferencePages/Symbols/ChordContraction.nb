   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "f8a0e92d-10d7-48ad-985d-324a06e4b59a"],
 " is one half of the sum over every ordered pair of distinct positions."
}], "Notes",ExpressionUUID->"ecd2a5ef-77a4-4db7-8938-a60112b51cf2"],

