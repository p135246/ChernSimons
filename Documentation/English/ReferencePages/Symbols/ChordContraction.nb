Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{"\"\<EmptyWord\>\"", " ", "->", " ", "False"}]], "InlineFormula",
  ExpressionUUID->"7a2c785c-0b4a-47bc-bb82-6849d1025a6f"],
 " the value is the term of the positive-length convention."
}], "Notes",ExpressionUUID->"18edf312-1913-4f26-b1d5-9d89d47f9ac4"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{"\"\<EmptyWord\>\"", " ", "->", " ", "True"}]], "InlineFormula",
  ExpressionUUID->"01488a7a-b474-482a-9f40-b20aafa02b54"],
 " the contraction of two one-letter words is the empty word, and a cut next \
to a contracted letter has the empty word as one arc. These are the boundary \
terms of the empty-word extension."
}], "Notes",ExpressionUUID->"443768bb-1083-4163-beed-4c29101f6d14"],

