          RowBox[{
          "x", ",", " ", "y", ",", " ", "y", ",", " ", "y", ",", " ", "y"}], 
          "}"}], "]"}], ",", " ", "pair", ",", " ", "pairing"}], "]"}]}], 
     ")"}], " ", "/@", " ", 
