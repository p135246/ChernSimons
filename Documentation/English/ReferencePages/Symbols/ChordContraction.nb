Cell["\<\
The bracket is the sum of the chord contractions over all pairs of positions:\
\
\>", "ExampleText",ExpressionUUID->"3b7a706a-e1ad-4a54-89da-53f925682c20"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"pairing", " ", "=", " ", 
   RowBox[{"GradedPairing", "[", 
    RowBox[{
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"x", " ", "->", " ", 
        RowBox[{"-", "1"}]}], ",", " ", 
       RowBox[{"y", " ", "->", " ", "0"}]}], "|>"}], ",", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "y"}], "}"}], " ", "->", " ", "1"}], "|>"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"u", " ", "=", " ", 
   RowBox[{"CyclicWord", "[", 
    RowBox[{"{", 
     RowBox[{"x", ",", " ", "y"}], "}"}], "]"}]}], ";", " ", 
  RowBox[{"v", " ", "=", " ", 
   RowBox[{"CyclicWord", "[", 
    RowBox[{"{", 
     RowBox[{"x", ",", " ", "y", ",", " ", "y"}], "}"}], "]"}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Total", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"ChordContraction", "[", 
        RowBox[{"u", ",", " ", "v", ",", " ", 
         RowBox[{"{", 
          RowBox[{"i", ",", " ", "j"}], "}"}], ",", " ", "pairing"}], "]"}], ",",
        " ", 
       RowBox[{"{", 
        RowBox[{"i", ",", " ", "2"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"j", ",", " ", "3"}], "}"}]}], "]"}], ",", " ", "2"}], "]"}], 
   ",", " ", 
   RowBox[{"InvolutiveBracket", "[", 
    RowBox[{"u", ",", " ", "v", ",", " ", "pairing"}], "]"}]}], 
  "}"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"16a36b57-4c76-4ed6-8192-394929b71938"],

