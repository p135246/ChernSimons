   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "30c053bb-334a-447e-8c8d-6cb96c91a264"],
 " expressions, and positions count from ",
 Cell[BoxData[
  FormBox["1", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "493113fd-35f3-4835-8aef-4811d5afd9fe"],
 " along the list of letters."
}], "Notes",ExpressionUUID->"d1c25bac-a9b5-4b7e-952c-62b7169b27e4"],

