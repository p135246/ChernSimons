Cell["ChordContraction", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"12876e50-7c5a-4c8e-b333-acb057997163"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["ChordContraction"]], 
     "paclet:ChernSimons/ref/ChordContraction", "ChernSimons Package Symbol"},
    
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["u", "TI"], ",", " ", 
    StyleBox["v", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["i", "TI"], ",", " ", 
      StyleBox["j", "TI"]}], "}"}], ",", " ", 
    StyleBox["pairing", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "580d4243-ae4e-49ce-aba0-5982e1e09b17"],
 "\[LineSeparator]",
 "gives the term of the bracket of the cyclic words ",
 StyleBox["u", "TI"],
 " and ",
 StyleBox["v", "TI"],
 " in which letter ",
 StyleBox["i", "TI"],
 " of ",
 StyleBox["u", "TI"],
 " is contracted against letter ",
 StyleBox["j", "TI"],
 " of ",
 StyleBox["v", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"89228ef7-68af-41b1-a7c4-2d065f5191fa"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["ChordContraction"]], 
     "paclet:ChernSimons/ref/ChordContraction", "ChernSimons Package Symbol"},
    
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["w", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["i", "TI"], ",", " ", 
      StyleBox["j", "TI"]}], "}"}], ",", " ", 
