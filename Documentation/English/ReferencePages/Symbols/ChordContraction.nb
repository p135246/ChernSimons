Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{"\"\<EmptyWord\>\"", " ", "->", " ", "False"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0aa1a39a-8bd8-4f1e-aee7-a3c0b8868fc7"],
 " the value is the term of the positive-length convention."
}], "Notes",ExpressionUUID->"ac7101a4-9ed0-4096-bf96-8eaf47d712e8"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{"\"\<EmptyWord\>\"", " ", "->", " ", "True"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5dd62b3b-65a6-4aa8-827d-b5334c34b5d7"],
 " the contraction of two one-particle words is the empty word, and a cut \
next to a contracted particle has the empty word as one arc. These are the \
boundary terms of the empty-word extension."
}], "Notes",ExpressionUUID->"e98dc4a7-be7c-44f9-9f69-143eac862df2"],

