Cell["\<\
The co-bracket is one half of the sum over ordered pairs of distinct \
positions; each chord is counted once in each orientation:\
\>", "ExampleText",ExpressionUUID->"6de75c3c-d601-40a6-81b5-c68cee06ff9c"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"pairing", " ", "=", " ", 
   RowBox[{"GradedPairing", "[", 
    RowBox[{
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"x", " ", "->", " ", 
        RowBox[{"-", "1"}]}], ",", " ", 
       RowBox[{"y", " ", "->", " ", "0"}]}], "|>"}], ",", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "y"}], "}"}], " ", "->", " ", "1"}], "|>"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"w", " ", "=", " ", 
   RowBox[{"CyclicWord", "[", 
    RowBox[{"{", 
     RowBox[{
     "x", ",", " ", "y", ",", " ", "y", ",", " ", "y", ",", " ", "y"}], "}"}],
     "]"}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    RowBox[{"Total", "[", 
     RowBox[{"Map", "[", 
      RowBox[{
       RowBox[{"pair", " ", "|->", " ", 
        RowBox[{"ChordContraction", "[", 
         RowBox[{"w", ",", " ", "pair", ",", " ", "pairing"}], "]"}]}], ",", 
       " ", 
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{"Tuples", "[", 
          RowBox[{
           RowBox[{"Range", "[", "5", "]"}], ",", " ", "2"}], "]"}], ",", " ", 
         RowBox[{"pair", " ", "|->", " ", 
          RowBox[{
           RowBox[{"First", "[", "pair", "]"}], " ", "=!=", " ", 
           RowBox[{"Last", "[", "pair", "]"}]}]}]}], "]"}]}], "]"}], "]"}], "/",
     "2"}], ",", " ", 
   RowBox[{"InvolutiveCobracket", "[", 
    RowBox[{"w", ",", " ", "pairing"}], "]"}]}], "}"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"7779641c-6d17-4053-a12c-1816a3542a7e"],

