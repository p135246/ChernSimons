  FontSize->0.9 Inherited,ExpressionUUID->
  "c4916b83-fdae-4fe5-bff0-807b714b5442"],
 " and a factor ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["v", "TI"], 
    StyleBox["j", "TI"]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a96ae3ea-7078-4981-9c9e-880d988ef850"],
 " of ",
 Cell[BoxData[
  FormBox[
   StyleBox["g", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3e2f451b-435d-4024-b1a3-52913863af8a"],
 " of the Koszul sign of bringing ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["u", "TI"], 
    StyleBox["i", "TI"]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "69f2f735-8c64-4e51-b4ca-eb2c9ad8c0d5"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["v", "TI"], 
    StyleBox["j", "TI"]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "359628d9-314e-4758-9b74-ef9b288658a5"],
 " to the front, times ",
 Cell[BoxData[
  FormBox[
   RowBox[{"[", 
    RowBox[{
     SubscriptBox[
      StyleBox["u", "TI"], 
      StyleBox["i", "TI"]], ",", 
     SubscriptBox[
      StyleBox["v", "TI"], 
      StyleBox["j", "TI"]]}], "]"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a5de42b4-0016-416a-9621-cf154a9cda8b"],
 " of ",
 Cell[BoxData[
