Cell["The bracket of two cyclic words of the circle:", "ExampleText",ExpressionUUID->"e8558caf-7aed-46ec-ac20-6987c18b57f5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"CanonicalBeilinsonDrinfeldBracket", "[", 
  RowBox[{
   RowBox[{"CyclicWord", "[", 
    RowBox[{"{", 
     RowBox[{"x", ",", " ", "y", ",", " ", "y", ",", " ", "y"}], "}"}], "]"}],
    ",", " ", 
   RowBox[{"CyclicWord", "[", 
    RowBox[{"{", 
     RowBox[{"x", ",", " ", "y"}], "}"}], "]"}], ",", " ", 
   RowBox[{"GradedPairing", "[", 
    RowBox[{
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"x", " ", "->", " ", 
        RowBox[{"-", "1"}]}], ",", " ", 
       RowBox[{"y", " ", "->", " ", "0"}]}], "|>"}], ",", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "y"}], "}"}], " ", "->", " ", "1"}], "|>"}]}], 
    "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"bdbcbf77-0ef0-44f0-a049-a39904ec9c60"],

Cell[BoxData[
 RowBox[{
  RowBox[{"-", "2"}], " ", 
  InterpretationBox[
   RowBox[{"(", 
    RowBox[{
    "x", "\[ThinSpace]", "y", "\[ThinSpace]", "y", "\[ThinSpace]", "y"}], 
    ")"}],
   ChernSimons`CyclicWord[{
    MTNB$rqcrgbfu8vjw`x, MTNB$rqcrgbfu8vjw`y, MTNB$rqcrgbfu8vjw`y, 
     MTNB$rqcrgbfu8vjw`y}],
   Editable->False]}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"45ceccc0-9d4f-431b-98df-ea1e92fc1f83"]
}, Open  ]],

