  ExpressionUUID->"fb40241e-a870-4d37-b86e-8b30077b98cc"],
 "."
}], "Notes",ExpressionUUID->"0e184b7b-9a0a-493b-a0a8-6bf948dff209"],

Cell[TextData[{
 "It is already present on the symmetric powers of cyclic words before ",
 Cell[BoxData[
  FormBox["\[HBar]", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "d16833a9-d9a5-413b-a661-05c5d8e0b53b"],
 " is adjoined, and carries no ",
 Cell[BoxData[
  FormBox["\[HBar]", TraditionalForm]], "InlineFormula",ExpressionUUID->
