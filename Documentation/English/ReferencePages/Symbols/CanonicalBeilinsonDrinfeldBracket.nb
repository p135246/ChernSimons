    RowBox[{"(", 
     StyleBox["f", "TI"], ")"}], 
    StyleBox["g", "TI"], "+", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"-", "1"}], ")"}], 
     TemplateBox[{
       RowBox[{
         StyleBox["f", "TI"]}]},
      "Abs"]], 
    StyleBox["f", "TI"], "\[CapitalDelta]", 
    RowBox[{"(", 
     StyleBox["g", "TI"], ")"}], "+", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"-", "1"}], ")"}], 
     TemplateBox[{
       RowBox[{
         StyleBox["f", "TI"]}]},
      "Abs"]], 
    RowBox[{"\[HBar]", " "}], 
    RowBox[{"{", 
     RowBox[{
      StyleBox["f", "TI"], ",", 
      StyleBox["g", "TI"]}], "}"}], ","}],
   TraditionalForm],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",ExpressionUUID->"9e418348-4ac7-4624-\
b3ba-8b2a7b15c1bf"],

