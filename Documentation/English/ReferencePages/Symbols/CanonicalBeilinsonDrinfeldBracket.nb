Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"u", " ", "=", " ", 
      RowBox[{"CyclicWord", "[", 
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "y", ",", " ", "y", ",", " ", "y"}], "}"}], 
       "]"}]}], ",", " ", 
     RowBox[{"v", " ", "=", " ", 
      RowBox[{"CyclicWord", "[", 
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "y"}], "}"}], "]"}]}]}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"s", " ", "=", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"-", "1"}], ")"}], "^", 
      RowBox[{"ElementDegree", "[", 
       RowBox[{"u", ",", " ", "pairing", ",", " ", "\"\<Symmetric\>\""}], 
       "]"}]}]}], "}"}], ",", " ", 
   RowBox[{"Expand", "[", 
    RowBox[{
     RowBox[{"CanonicalBeilinsonDrinfeldOperator", "[", 
      RowBox[{
       RowBox[{"SymmetricProduct", "[", 
        RowBox[{"u", ",", " ", "v", ",", " ", "pairing"}], "]"}], ",", " ", 
       "pairing"}], "]"}], " ", "-", " ", 
     RowBox[{"SymmetricProduct", "[", 
      RowBox[{
       RowBox[{"CanonicalBeilinsonDrinfeldOperator", "[", 
        RowBox[{"u", ",", " ", "pairing"}], "]"}], ",", " ", "v", ",", " ", 
       "pairing"}], "]"}], " ", "-", " ", 
     RowBox[{"s", " ", 
      RowBox[{"SymmetricProduct", "[", 
       RowBox[{"u", ",", " ", 
        RowBox[{"CanonicalBeilinsonDrinfeldOperator", "[", 
         RowBox[{"v", ",", " ", "pairing"}], "]"}], ",", " ", "pairing"}], 
       "]"}]}], " ", "-", " ", 
     RowBox[{"s", " ", "HBar", " ", 
      RowBox[{"CanonicalBeilinsonDrinfeldBracket", "[", 
       RowBox[{"u", ",", " ", "v", ",", " ", "pairing"}], "]"}]}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"d43226de-04bf-426c-aa72-50acb2cae038"],

