   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "aab259af-dd18-4c8e-b114-914aaa58d534"],
 " times the product of the other factors."
}], "Notes",ExpressionUUID->"251e4482-8216-414f-a066-755e33d4c440"],

