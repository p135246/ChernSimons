 ".",
 "\n"
}], "Usage",ExpressionUUID->"f536e44d-a0c9-4621-bacd-f0d129e2a1f6"],

Cell[TextData[{
 "The bracket is the one of the BD axiom satisfied by ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CanonicalBeilinsonDrinfeldOperator"]], 
    "paclet:ChernSimons/ref/CanonicalBeilinsonDrinfeldOperator", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "9898ff57-4535-4d46-824b-92a8504074d9"],
 ":"
}], "Notes",
 CellFrameLabels->{{Inherited, Inherited}, {Inherited, 
    Cell[
     TextData[{
      "26.09.30: Design review - the bracket is the one of the BD axiom as \
the paper writes it, with an explicit HBar in front, so it carries no HBar \
itself. The engine's bvBracket is instead the derived bracket of the \
operator, the BV bracket of the localization, which is HBar times this one; \
the paclet computes the bracket from its cross terms, CanonicalLieBracket of \
one factor of each argument with the Koszul sign of bringing the pair to the \
front, rather than dividing the derived bracket by HBar. A pairing in the \
exterior convention returns unevaluated, for the reason the operator does: \
the BD algebra is the symmetric algebra. Alternative name considered: \
BeilinsonDrinfeldBracket, the name until 2026-09-30. Prior art: the Wolfram \
Language has no Poisson or BD brackets on graded words. \
T12/paclet-bd-operator-and-bracket pins HBar times this bracket against the \
bvBracket of the engine the verification suites load on all pairs of words to \
length 4, and that it is free of HBar there.", "\n\n", 
       Cell[
        BoxData[
         GridBox[{{
            Cell[
             BoxData[
              ButtonBox[
               DynamicBox[
                FEPrivate`FrontEndResource[
                "DocumentationToolsStrings", "Edit"]], BaseStyle -> 
               "TextAnnotationButton"]]], 
            StyleBox[
             RowBox[{
               DynamicBox[
                FEPrivate`FrontEndResource[
                "DocumentationToolsStrings", "LastAnnotator"]], "pavel"}], 
             "TextAnnotator"], 
            Cell[
             BoxData[
              ButtonBox[
               DynamicBox[
                FEPrivate`FrontEndResource[
                "DocumentationToolsStrings", "Delete"]], BaseStyle -> 
               "TextAnnotationRemoveButton"]]], ""}}, 
          GridBoxAlignment -> {
           "Columns" -> {Left, Left, Right, Right}, "Rows" -> {{Automatic}}}, 
          GridBoxItemSize -> {"Columns" -> {
              Scaled[0.15], 
              Scaled[0.68], 
              Scaled[0.15], 
              Scaled[0.02]}}]]], "\n"}], "TextAnnotation", 
     CellSize -> {590, Inherited}]}},
 CellTags->"TextAnnotation",
 CellID->215953732,ExpressionUUID->"69b4ce6e-f425-4b50-8c07-a93ad7273352"],

Cell[BoxData[
 PaneBox[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"\[CapitalDelta]", 
      RowBox[{"(", 
       StyleBox[
        RowBox[{"f", "g"}], "TI"], ")"}]}], "\[LongEqual]", 
     RowBox[{
      RowBox[{"\[CapitalDelta]", 
       RowBox[{"(", 
        StyleBox["f", "TI"], ")"}], 
       StyleBox["g", "TI"]}], "+", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"-", "1"}], ")"}], 
        TemplateBox[{
          RowBox[{
            StyleBox["f", "TI"]}]},
         "Abs"]], 
       StyleBox["f", "TI"], "\[CapitalDelta]", 
       RowBox[{"(", 
        StyleBox["g", "TI"], ")"}]}], "+", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"-", "1"}], ")"}], 
        TemplateBox[{
          RowBox[{
            StyleBox["f", "TI"]}]},
         "Abs"]], "\[HBar]", " ", 
       RowBox[{"{", 
        RowBox[{
         StyleBox["f", "TI"], ",", 
         StyleBox["g", "TI"]}], "}"}]}]}]}], ","}],
   TraditionalForm],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",ExpressionUUID->"fea4f715-17c3-46f9-\
b4ff-bd06cdd28be7"],

Cell[TextData[{
 "with ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{
     RowBox[{
       StyleBox["f", "TI"]}]},
    "Abs"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "38fd3852-ccaa-4f5c-8f7d-95c228da8953"],
 " the symmetric degree of ",
 Cell[BoxData[
  FormBox[
   StyleBox["f", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "0651fd15-e55b-4dfd-835a-a68504e91e21"],
 "."
}], "Notes",ExpressionUUID->"93267d76-8bc5-4eb4-bb09-74b716f45168"],

Cell[TextData[{
 "For products ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["f", "TI"], "\[LongEqual]", 
    SubscriptBox[
     StyleBox["u", "TI"], "1"], "\[CircleDot]", "\[CenterEllipsis]", "\[CircleDot]", 
    SubscriptBox[
     StyleBox["u", "TI"], 
     StyleBox["k", "TI"]]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"e55f15a6-6a18-460e-8e66-44186bf6ee7e"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["g", "TI"], "\[LongEqual]", 
    SubscriptBox[
     StyleBox["v", "TI"], "1"], "\[CircleDot]", "\[CenterEllipsis]", "\[CircleDot]", 
    SubscriptBox[
     StyleBox["v", "TI"], 
     StyleBox["l", "TI"]]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"69f7a194-c665-46e9-8e3c-74baea922675"],
 " it is ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"-", "1"}], ")"}], 
    TemplateBox[{
      RowBox[{
        StyleBox["f", "TI"]}]},
     "Abs"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "07bab1f0-db8d-44d9-aa08-10821f2ecad3"],
 " times the sum over a factor ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["u", "TI"], 
    StyleBox["i", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "be9e919b-5e0d-40b8-8872-80d307dbf00a"],
 " of ",
 Cell[BoxData[
  FormBox[
   StyleBox["f", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "635582e1-1c76-4a9f-9641-6f6bd94b83fa"],
 " and a factor ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["v", "TI"], 
    StyleBox["j", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "09fe714a-e0ef-4478-9cfe-f6fd75238b6e"],
 " of ",
 Cell[BoxData[
  FormBox[
   StyleBox["g", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "8cb82a03-b568-4a30-aff0-e9b6ab90dce3"],
 " of the Koszul sign of bringing ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["u", "TI"], 
    StyleBox["i", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "34939836-7e53-4f8b-aeaf-bc5e1cf36fbc"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["v", "TI"], 
    StyleBox["j", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "9b4fa621-ef47-4b62-8e28-c81e2236084a"],
 " to the front, times ",
 Cell[BoxData[
  FormBox[
   RowBox[{"[", 
    RowBox[{
     SubscriptBox[
      StyleBox["u", "TI"], 
      StyleBox["i", "TI"]], ",", 
     SubscriptBox[
      StyleBox["v", "TI"], 
      StyleBox["j", "TI"]]}], "]"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"984bd3b6-b63a-4dd8-8d6a-8ac297275510"],
 " of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CanonicalLieBracket"]], 
    "paclet:ChernSimons/ref/CanonicalLieBracket", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "bda1d76e-c8cc-4c64-b811-6b03fc0fc936"],
 " times the product of the other factors."
}], "Notes",ExpressionUUID->"9bcb77ec-6ad7-4da4-a684-7eb7f4dfd24b"],

Cell[TextData[{
 "On two cyclic words it is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      StyleBox["u", "TI"], ",", 
      StyleBox["v", "TI"]}], "}"}], "\[LongEqual]", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"-", "1"}], ")"}], 
     TemplateBox[{
       RowBox[{
         StyleBox["u", "TI"]}]},
      "Abs"]], 
    RowBox[{"[", 
     RowBox[{
      StyleBox["u", "TI"], ",", 
      StyleBox["v", "TI"]}], "]"}]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"e4401976-34ce-49a8-aaa5-bf2e1e8822de"],
 "."
}], "Notes",ExpressionUUID->"dd673407-b037-4d13-951e-cb7c34cb1dcf"],

Cell[TextData[{
 "It is already present on the symmetric powers of cyclic words before ",
 Cell[BoxData[
  FormBox["\[HBar]", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "3b68c558-3799-4ad8-808c-89247416553b"],
 " is adjoined, and carries no ",
 Cell[BoxData[
  FormBox["\[HBar]", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "f48dc83a-e9bc-412b-84ce-ab5e25428beb"],
 " itself."
}], "Notes",ExpressionUUID->"64dceb6c-79c8-4236-ba81-eba2f821e0ce"],

Cell[TextData[{
 "The derived bracket of ",
 Cell[BoxData[
  FormBox["\[CapitalDelta]", TraditionalForm]], "InlineFormula",
  ExpressionUUID->"f9adf66d-419d-431b-88d6-2543ebfee537"],
 ", the failure of ",
 Cell[BoxData[
  FormBox["\[CapitalDelta]", TraditionalForm]], "InlineFormula",
  ExpressionUUID->"a285ccc9-bd99-4296-bc41-b0ab42816db0"],
 " to be a derivation, is ",
 Cell[BoxData[
  FormBox["\[HBar]", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "346d40af-cf94-40ae-955c-864e94a65380"],
 " times this bracket. That derived bracket is the BV bracket of the \
localization at ",
 Cell[BoxData[
  FormBox["\[HBar]", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "8949397c-8619-46f4-9c40-ed4b373a7b12"],
 "."
}], "Notes",ExpressionUUID->"428027b2-9862-4413-9309-0d263ccc2ea3"],

Cell[TextData[{
 StyleBox["f", "TI"],
 " and ",
 StyleBox["g", "TI"],
 " are cyclic words, symmetric products of cyclic words, lists of letters, or \
linear combinations of these. The bracket is bilinear."
}], "Notes",ExpressionUUID->"b6790a3f-1cb8-4a83-b772-cdd3afbdfbc7"],

