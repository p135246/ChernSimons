Cell["The alphabet of the circle:", "ExampleText",ExpressionUUID->"86821467-f1a6-43d5-bc3b-b573f289901f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"pairing", " ", "=", " ", 
  RowBox[{"GradedPairing", "[", 
   RowBox[{
    RowBox[{"<|", 
     RowBox[{
