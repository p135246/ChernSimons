  FormBox[
   StyleBox["f", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "3f6d0724-2319-4070-aabe-d9f747d46e4e"],
 "."
}], "Notes",ExpressionUUID->"f7942c52-2c99-4a58-b189-cce3a69b6f6e"],

Cell[TextData[{
 "For products ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["f", "TI"], "\[LongEqual]", 
    SubscriptBox[
     StyleBox["u", "TI"], "1"], "\[CircleDot]", "\[CenterEllipsis]", "\[CircleDot]", 
    SubscriptBox[
     StyleBox["u", "TI"], 
     StyleBox["k", "TI"]]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"b31066f8-e757-4da1-9b91-24a169c1e32e"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["g", "TI"], "\[LongEqual]", 
    SubscriptBox[
     StyleBox["v", "TI"], "1"], "\[CircleDot]", "\[CenterEllipsis]", "\[CircleDot]", 
    SubscriptBox[
     StyleBox["v", "TI"], 
     StyleBox["l", "TI"]]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"b590e78d-2720-4278-80e1-c3e8ec9ded11"],
 " it is ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"-", "1"}], ")"}], 
    TemplateBox[{
      RowBox[{
        StyleBox["f", "TI"]}]},
     "Abs"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "a3ba6b1c-84bc-4479-baaf-dde125553de6"],
 " times the sum over a factor ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["u", "TI"], 
    StyleBox["i", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "2f76d4f8-8af6-411a-8f7d-59aa6a7188e2"],
 " of ",
 Cell[BoxData[
  FormBox[
   StyleBox["f", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "b2daf3de-c7ba-45df-b09b-0da8a43aa5b0"],
 " and a factor ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["v", "TI"], 
    StyleBox["j", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "b3638879-20e2-4920-a36a-ba82f0658576"],
 " of ",
 Cell[BoxData[
  FormBox[
   StyleBox["g", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "c45925f2-88e1-40a3-861a-d4eb821a9d28"],
 " of the Koszul sign of bringing ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["u", "TI"], 
    StyleBox["i", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "ad1fdc84-6fd5-4c75-84c5-9eb593acc253"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["v", "TI"], 
    StyleBox["j", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "aca12072-0f16-4356-b44e-03174a6067ad"],
 " to the front, times ",
 Cell[BoxData[
  FormBox[
   RowBox[{"[", 
    RowBox[{
     SubscriptBox[
      StyleBox["u", "TI"], 
      StyleBox["i", "TI"]], ",", 
     SubscriptBox[
      StyleBox["v", "TI"], 
      StyleBox["j", "TI"]]}], "]"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"64fa486e-8e87-49b3-b792-324bfcfce1f3"],
 " of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CanonicalLieBracket"]], 
    "paclet:ChernSimons/ref/CanonicalLieBracket", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "053c412e-ed91-4f64-8781-704f5b4e0917"],
 " times the product of the other factors."
}], "Notes",ExpressionUUID->"4de94af1-f87d-46ea-9f05-afd07db7b0b3"],

Cell[TextData[{
