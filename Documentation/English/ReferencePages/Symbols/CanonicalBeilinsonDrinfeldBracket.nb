Cell["The bracket of two cyclic words of the circle:", "ExampleText",ExpressionUUID->"0e00f2f2-94ac-4f4a-b088-d09352cabea3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"CanonicalBeilinsonDrinfeldBracket", "[", 
  RowBox[{
   RowBox[{"CyclicWord", "[", 
    RowBox[{"{", 
     RowBox[{"x", ",", " ", "y", ",", " ", "y", ",", " ", "y"}], "}"}], "]"}],
    ",", " ", 
   RowBox[{"CyclicWord", "[", 
    RowBox[{"{", 
     RowBox[{"x", ",", " ", "y"}], "}"}], "]"}], ",", " ", 
   RowBox[{"GradedPairing", "[", 
    RowBox[{
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"x", " ", "->", " ", 
        RowBox[{"-", "1"}]}], ",", " ", 
       RowBox[{"y", " ", "->", " ", "0"}]}], "|>"}], ",", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "y"}], "}"}], " ", "->", " ", "1"}], "|>"}]}], 
    "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"0b30e7df-9478-42ce-aef8-ab6d7652be59"],

Cell[BoxData[
 RowBox[{
  RowBox[{"-", "2"}], " ", 
  InterpretationBox[
   RowBox[{"(", 
    RowBox[{
    "x", "\[ThinSpace]", "y", "\[ThinSpace]", "y", "\[ThinSpace]", "y"}], 
    ")"}],
   ChernSimons`CyclicWord[{
    MTNB$rqcrgbfu8vjw`x, MTNB$rqcrgbfu8vjw`y, MTNB$rqcrgbfu8vjw`y, 
