  FontSize->0.9 Inherited,ExpressionUUID->
  "4cebaa94-b941-43c1-8c0a-0222be84c6c6"],
 "."
}], "Notes",ExpressionUUID->"4fa0f22d-a0c5-46ad-83fe-757cc604072a"],

Cell[TextData[{
 "For products ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["f", "TI"], "\[LongEqual]", 
    SubscriptBox[
     StyleBox["u", "TI"], "1"], "\[CircleDot]", "\[CenterEllipsis]", "\[CircleDot]", 
    SubscriptBox[
     StyleBox["u", "TI"], 
     StyleBox["k", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9b0985f8-02c4-421b-8ff8-61de3af97859"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["g", "TI"], "\[LongEqual]", 
    SubscriptBox[
     StyleBox["v", "TI"], "1"], "\[CircleDot]", "\[CenterEllipsis]", "\[CircleDot]", 
    SubscriptBox[
     StyleBox["v", "TI"], 
     StyleBox["l", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a2fd6128-2412-4c2b-bf22-d06682035740"],
 " it is ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"-", "1"}], ")"}], 
    TemplateBox[{
      RowBox[{
        StyleBox["f", "TI"]}]},
     "Abs"]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f2fcb546-aa77-46ae-bb79-016da615375b"],
 " times the sum over a factor ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["u", "TI"], 
    StyleBox["i", "TI"]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d6afc758-836b-4fc7-bca7-a6fc26f43fba"],
 " of ",
 Cell[BoxData[
