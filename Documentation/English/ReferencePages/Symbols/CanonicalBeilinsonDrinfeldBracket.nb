 Cell[BoxData[
  FormBox["\[HBar]", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "f0055cde-4d12-4c73-8c4a-8a02a336a0f4"],
 "."
}], "Notes",ExpressionUUID->"d47f690a-aa27-4fbe-9be7-cb1b964d0692"],

Cell[TextData[{
 StyleBox["f", "TI"],
 " and ",
 StyleBox["g", "TI"],
 " are cyclic words, symmetric products of cyclic words, lists of particles, \
or linear combinations of these. The bracket is bilinear."
}], "Notes",ExpressionUUID->"2293e7b0-c256-4cba-99b5-af53ff4a5620"],

