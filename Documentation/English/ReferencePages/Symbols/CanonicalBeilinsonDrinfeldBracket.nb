Cell[TextData[{
 "The derived bracket of ",
 Cell[BoxData[
  FormBox["\[CapitalDelta]", TraditionalForm]], "InlineFormula",
  ExpressionUUID->"da891a58-79e1-4e1c-b8b1-c43db07b65a7"],
 ", the failure of ",
 Cell[BoxData[
