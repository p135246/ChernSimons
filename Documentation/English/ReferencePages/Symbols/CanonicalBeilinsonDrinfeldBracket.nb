Cell["The bracket of two cyclic words of the circle:", "ExampleText",ExpressionUUID->"3a1dc3a9-08b3-474e-b383-c1b85d34df0b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"CanonicalBeilinsonDrinfeldBracket", "[", 
  RowBox[{
   RowBox[{"CyclicWord", "[", 
    RowBox[{"{", 
     RowBox[{"x", ",", " ", "y", ",", " ", "y", ",", " ", "y"}], "}"}], "]"}],
    ",", " ", 
   RowBox[{"CyclicWord", "[", 
    RowBox[{"{", 
     RowBox[{"x", ",", " ", "y"}], "}"}], "]"}], ",", " ", 
   RowBox[{"GradedPairing", "[", 
    RowBox[{
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"x", " ", "->", " ", 
        RowBox[{"-", "1"}]}], ",", " ", 
       RowBox[{"y", " ", "->", " ", "0"}]}], "|>"}], ",", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "y"}], "}"}], " ", "->", " ", "1"}], "|>"}]}], 
    "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"2e074601-0598-484f-8c83-1ed8d40e8df2"],

Cell[BoxData[
 RowBox[{
  RowBox[{"-", "2"}], " ", 
  InterpretationBox[
   RowBox[{"(", 
    RowBox[{
    "x", "\[ThinSpace]", "y", "\[ThinSpace]", "y", "\[ThinSpace]", "y"}], 
    ")"}],
   ChernSimons`CyclicWord[{
    MTNB$rqcrgbfu8vjw`x, MTNB$rqcrgbfu8vjw`y, MTNB$rqcrgbfu8vjw`y, 
     MTNB$rqcrgbfu8vjw`y}],
   Editable->False]}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"0f2a9845-a739-4564-9636-7697e05aff56"]
}, Open  ]],

