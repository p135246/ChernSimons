Cell[TextData[{
 "The Chern-Simons truncation of the circle twists the co-bracket of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["x", "TI"], 
    SuperscriptBox[
     StyleBox["y", "TI"], "2"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "25a8bb02-2e54-4537-94a3-04c73fe572b6"],
 ":"
}], "ExampleText",ExpressionUUID->"4b1111a4-d37b-4997-98ce-e63a82ecbddc"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"TwistedCobracket", "[", 
  RowBox[{
   RowBox[{"MaurerCartanElement", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"CyclicWord", "[", 
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "x", ",", " ", "y"}], "}"}], "]"}], " ", "-", 
      " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "/", "48"}], ")"}], " ", 
       RowBox[{"SymmetricProduct", "[", 
        RowBox[{
         RowBox[{"{", "y", "}"}], ",", " ", 
         RowBox[{"{", "y", "}"}], ",", " ", 
         RowBox[{"GradedPairing", "[", 
          RowBox[{
           RowBox[{"<|", 
            RowBox[{
             RowBox[{"x", " ", "->", " ", 
              RowBox[{"-", "1"}]}], ",", " ", 
             RowBox[{"y", " ", "->", " ", "0"}]}], "|>"}], ",", " ", 
           RowBox[{"<|", 
            RowBox[{
             RowBox[{"{", 
