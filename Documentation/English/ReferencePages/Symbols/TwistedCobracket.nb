  FormBox[
   SubscriptBox[
    StyleBox["m", "TI"], 
    RowBox[{"1", ",", "0"}]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "816c2a82-b387-422f-9d8c-79c15695f4ab"],
 " is what ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["TwistedDifferential"]], 
    "paclet:ChernSimons/ref/TwistedDifferential", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "cf5da38b-abdd-4215-8ce8-23adbb3bfeeb"],
 " reads."
}], "Notes",ExpressionUUID->"7ac9e6bc-da90-4c31-a0ef-3bb0dd979fe9"],

Cell["\<\
On a cyclic word the result is a sum of products of two words.\
\>", "Notes",ExpressionUUID->"9daa3e82-cbb1-465f-b347-a75870c92ae1"],

Cell[TextData[{
 "The convention of the pairing selects the picture. Under ",
 Cell[BoxData["\"\<Symmetric\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bd8b5a55-9240-4744-beed-50e365ec4068"],
 " the parts of ",
 StyleBox["m", "TI"],
 " and the result are ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SymmetricProduct"]], "paclet:ChernSimons/ref/SymmetricProduct",
     "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "b32abd97-3ad7-4852-bbaa-e277d1b016bf"],
 " terms, under ",
 Cell[BoxData["\"\<Exterior\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c249a743-6ec1-4e7a-aa54-78cdd36eaf52"],
 " ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ExteriorProduct"]], "paclet:ChernSimons/ref/ExteriorProduct", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "487d5bff-44a5-4380-9366-dfa0613c177c"],
 " terms."
}], "Notes",ExpressionUUID->"f9a04d08-2859-48ec-a195-7c7145133ee4"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SymmetricToExterior"]], 
    "paclet:ChernSimons/ref/SymmetricToExterior", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "0580af6c-516e-4abf-b5a7-fa549b3bc657"],
 " relates the two pictures: it sends ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["f", "TI"], "\[CircleDot]", 
    StyleBox["g", "TI"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3c7f7f41-ab32-4743-bcb5-25745cb47379"],
 " to ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"-", "1"}], ")"}], 
     RowBox[{"|", 
      StyleBox["f", "TI"], 
      SubscriptBox["|", "\[Wedge]"]}]], 
    StyleBox["f", "TI"], "\[Wedge]", 
    StyleBox["g", "TI"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "70f0951b-428a-4a96-8fb4-0d0d30808db0"],
 ", so over the circle ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["y", "TI"], "\[CircleDot]", 
    StyleBox["y", "TI"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "eed145c7-fb4d-458c-b28c-06fe1e56a33e"],
 " corresponds to ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", 
    StyleBox["y", "TI"], "\[Wedge]", 
    StyleBox["y", "TI"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "36a97430-d3c8-4745-8045-207efadde86f"],
 "."
}], "Notes",ExpressionUUID->"4f96725b-5370-4050-898f-78ef6de25736"],

Cell["\<\
On a product the twisted co-bracket acts on each factor in turn, with the \
Koszul sign of the shuffle.\
\>", "Notes",ExpressionUUID->"f1f5de2c-7482-4646-a545-1c97b7955302"],

Cell["A product of the other kind returns unevaluated.", "Notes",ExpressionUUID->"4ee36421-96af-41cd-bba8-082158c53137"],

