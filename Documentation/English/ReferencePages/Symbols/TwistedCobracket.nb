Cell[TextData[{
 "The Chern-Simons truncation of the circle twists the co-bracket of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["x", "TI"], 
    SuperscriptBox[
     StyleBox["y", "TI"], "2"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6e43d833-ad53-4047-8540-9008bcebfea0"],
 ":"
}], "ExampleText",ExpressionUUID->"8ea2ae11-797a-4fc1-9522-bf6cefa8618b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"TwistedCobracket", "[", 
  RowBox[{
   RowBox[{"MaurerCartanElement", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"CyclicWord", "[", 
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "x", ",", " ", "y"}], "}"}], "]"}], " ", "-", 
      " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "/", "48"}], ")"}], " ", 
       RowBox[{"SymmetricProduct", "[", 
        RowBox[{
         RowBox[{"{", "y", "}"}], ",", " ", 
         RowBox[{"{", "y", "}"}], ",", " ", 
         RowBox[{"GradedPairing", "[", 
          RowBox[{
           RowBox[{"<|", 
            RowBox[{
             RowBox[{"x", " ", "->", " ", 
              RowBox[{"-", "1"}]}], ",", " ", 
             RowBox[{"y", " ", "->", " ", "0"}]}], "|>"}], ",", " ", 
           RowBox[{"<|", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"x", ",", " ", "y"}], "}"}], " ", "->", " ", "1"}], 
            "|>"}]}], "]"}]}], "]"}]}]}], ",", " ", 
     RowBox[{"GradedPairing", "[", 
      RowBox[{
       RowBox[{"<|", 
        RowBox[{
