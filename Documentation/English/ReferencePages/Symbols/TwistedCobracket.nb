    Cell[
     TextData["TwistedDifferential"]], 
    "paclet:ChernSimons/ref/TwistedDifferential", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "79fa637d-f796-49cf-9f6b-b77baceadb17"],
 " reads."
}], "Notes",ExpressionUUID->"d68374a1-0927-42ee-b3d1-288e348a6558"],

Cell["\<\
On a cyclic word the result is a sum of products of two words.\
\>", "Notes",ExpressionUUID->"c71d35ca-d56a-4489-aa31-529100a3c121"],

Cell[TextData[{
 "The convention of the pairing selects the picture. Under ",
 Cell[BoxData["\"\<Symmetric\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cf65457b-2ac0-4bbe-a412-f3a1a251f91c"],
 " the parts of ",
 StyleBox["m", "TI"],
 " and the result are ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SymmetricProduct"]], "paclet:ChernSimons/ref/SymmetricProduct",
     "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "0c3d7e75-d5f2-451a-8a11-68ee1d811844"],
 " terms, under ",
 Cell[BoxData["\"\<Exterior\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cef862f9-34c5-4f98-81ef-e9e84d89b8e4"],
 " ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ExteriorProduct"]], "paclet:ChernSimons/ref/ExteriorProduct", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "34e73789-5481-4e75-911b-1b1c7b224fb1"],
 " terms."
}], "Notes",ExpressionUUID->"46f196e3-946a-48f1-8306-aaf7704643e2"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SymmetricToExterior"]], 
    "paclet:ChernSimons/ref/SymmetricToExterior", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "95dbcfec-516b-4267-8b9f-2c97d046b1b1"],
 " relates the two pictures: it sends ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["f", "TI"], "\[CircleDot]", 
    StyleBox["g", "TI"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7bda82ed-75b5-4bf6-84c6-1e08e430b339"],
 " to ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"-", "1"}], ")"}], 
     RowBox[{"|", 
      StyleBox["f", "TI"], 
      SubscriptBox["|", "\[Wedge]"]}]], 
    StyleBox["f", "TI"], "\[Wedge]", 
    StyleBox["g", "TI"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "64bed376-b341-4690-8581-1c913fcd89e5"],
 ", so over the circle ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["y", "TI"], "\[CircleDot]", 
    StyleBox["y", "TI"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ed62797e-7f03-4391-a365-cde8a9b06d32"],
 " corresponds to ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", 
    StyleBox["y", "TI"], "\[Wedge]", 
    StyleBox["y", "TI"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1c057f59-7b58-434f-aff9-d4631f3d2fda"],
 "."
}], "Notes",ExpressionUUID->"f805c9ec-11d2-492e-b2f6-707fc692304b"],

Cell["\<\
On a product the twisted co-bracket acts on each factor in turn, with the \
Koszul sign of the shuffle.\
\>", "Notes",ExpressionUUID->"2a91e935-b208-4be1-a7df-cf644f7f337d"],

Cell["A product of the other kind returns unevaluated.", "Notes",ExpressionUUID->"24b61c04-4615-4b21-8cbe-f900fae52571"],

