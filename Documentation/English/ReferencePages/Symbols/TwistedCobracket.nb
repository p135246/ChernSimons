Cell[TextData[{
 "The Chern-Simons truncation of the circle twists the co-bracket of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["x", "TI"], 
    SuperscriptBox[
     StyleBox["y", "TI"], "2"]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"b51558fe-853e-4051-ad74-84214942ccb5"],
 ":"
}], "ExampleText",ExpressionUUID->"0b9edbf6-896f-4702-8173-eda1a3e4d8c5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"TwistedCobracket", "[", 
  RowBox[{
   RowBox[{"MaurerCartanElement", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"CyclicWord", "[", 
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "x", ",", " ", "y"}], "}"}], "]"}], " ", "-", 
      " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "/", "48"}], ")"}], " ", 
       RowBox[{"SymmetricProduct", "[", 
        RowBox[{
         RowBox[{"{", "y", "}"}], ",", " ", 
         RowBox[{"{", "y", "}"}], ",", " ", 
         RowBox[{"GradedPairing", "[", 
          RowBox[{
           RowBox[{"<|", 
            RowBox[{
             RowBox[{"x", " ", "->", " ", 
              RowBox[{"-", "1"}]}], ",", " ", 
             RowBox[{"y", " ", "->", " ", "0"}]}], "|>"}], ",", " ", 
           RowBox[{"<|", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"x", ",", " ", "y"}], "}"}], " ", "->", " ", "1"}], 
            "|>"}]}], "]"}]}], "]"}]}]}], ",", " ", 
     RowBox[{"GradedPairing", "[", 
      RowBox[{
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"x", " ", "->", " ", 
          RowBox[{"-", "1"}]}], ",", " ", 
         RowBox[{"y", " ", "->", " ", "0"}]}], "|>"}], ",", " ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"x", ",", " ", "y"}], "}"}], " ", "->", " ", "1"}], 
