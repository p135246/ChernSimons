Cell[TextData[{
 "Only the part ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["m", "TI"], 
    RowBox[{"2", ",", "0"}]], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"5fcad28f-8f62-45f4-a0c1-fcae98270064"],
 " enters. The part ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["m", "TI"], 
    RowBox[{"1", ",", "0"}]], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"a5508932-b8b1-4525-82e8-7df60768b6fd"],
 " is what ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["TwistedDifferential"]], 
    "paclet:ChernSimons/ref/TwistedDifferential", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "2c0addaa-af6f-44e4-81d5-5b0bb81088aa"],
 " reads."
}], "Notes",ExpressionUUID->"b7fef6fb-bd53-44b9-9251-2da685c4dd16"],

Cell["\<\
On a cyclic word the result is a sum of products of two words.\
\>", "Notes",ExpressionUUID->"645dbfe8-9c54-4f4d-b56c-a746b5246c3e"],

Cell[TextData[{
 "The convention of the pairing selects the picture. Under ",
 Cell[BoxData["\"\<Symmetric\>\""], "InlineFormula",ExpressionUUID->
  "e0d502a3-0655-46a1-9d2b-f53a023e5540"],
 " the parts of ",
 StyleBox["m", "TI"],
 " and the result are ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SymmetricProduct"]], "paclet:ChernSimons/ref/SymmetricProduct",
     "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "b32aec1a-e07c-4acb-9ce0-a648dae1fd34"],
 " terms, under ",
 Cell[BoxData["\"\<Exterior\>\""], "InlineFormula",ExpressionUUID->
  "aa8012a1-a742-46ed-88fa-862077aa332e"],
 " ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ExteriorProduct"]], "paclet:ChernSimons/ref/ExteriorProduct", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "f2c2a092-3471-4fa0-88e8-20612811626f"],
 " terms."
}], "Notes",ExpressionUUID->"d334c338-6ec1-44a3-9de8-58f00bb5ac4a"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SymmetricToExterior"]], 
    "paclet:ChernSimons/ref/SymmetricToExterior", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "f215dceb-ee07-4e14-9f6d-cfb001d0ac27"],
 " relates the two pictures: it sends ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["f", "TI"], "\[CircleDot]", 
    StyleBox["g", "TI"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "7c311cc2-4044-4f48-a511-321910e4060d"],
 " to ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"-", "1"}], ")"}], 
     RowBox[{"|", 
      StyleBox["f", "TI"], 
      SubscriptBox["|", "\[Wedge]"]}]], 
    StyleBox["f", "TI"], "\[Wedge]", 
    StyleBox["g", "TI"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "2daa62c1-8e83-4593-8ef5-e781cfd6505b"],
 ", so over the circle ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["y", "TI"], "\[CircleDot]", 
    StyleBox["y", "TI"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "45a1594d-2b0f-4e8c-8d3a-cfd04d003a89"],
 " corresponds to ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", 
    StyleBox["y", "TI"], "\[Wedge]", 
    StyleBox["y", "TI"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "5240c4d0-27fd-4b6b-9032-35f6c39fe1b5"],
 "."
}], "Notes",ExpressionUUID->"41ee83f3-5b86-43b5-8f4c-3b4e9db60032"],

Cell["\<\
On a product the twisted co-bracket acts on each factor in turn, with the \
Koszul sign of the shuffle.\
\>", "Notes",ExpressionUUID->"69acf176-48ea-454f-99a5-70d14932dde7"],

Cell["A product of the other kind returns unevaluated.", "Notes",ExpressionUUID->"b80cec65-3556-48b6-a0fe-ecb83517f2ee"],

