Cell[TextData[{
 "The Chern-Simons truncation of the circle twists the co-bracket of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["x", "TI"], 
    SuperscriptBox[
     StyleBox["y", "TI"], "2"]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"cb004697-2f57-4a70-a30e-bb8d02964b5d"],
 ":"
}], "ExampleText",ExpressionUUID->"9862f0ee-eb48-4df9-9cdd-58d3989b1b81"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"TwistedCobracket", "[", 
  RowBox[{
   RowBox[{"MaurerCartanElement", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"CyclicWord", "[", 
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "x", ",", " ", "y"}], "}"}], "]"}], " ", "-", 
      " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "/", "48"}], ")"}], " ", 
       RowBox[{"SymmetricProduct", "[", 
        RowBox[{
         RowBox[{"{", "y", "}"}], ",", " ", 
         RowBox[{"{", "y", "}"}], ",", " ", 
         RowBox[{"GradedPairing", "[", 
          RowBox[{
           RowBox[{"<|", 
            RowBox[{
             RowBox[{"x", " ", "->", " ", 
              RowBox[{"-", "1"}]}], ",", " ", 
             RowBox[{"y", " ", "->", " ", "0"}]}], "|>"}], ",", " ", 
           RowBox[{"<|", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"x", ",", " ", "y"}], "}"}], " ", "->", " ", "1"}], 
            "|>"}]}], "]"}]}], "]"}]}]}], ",", " ", 
     RowBox[{"GradedPairing", "[", 
      RowBox[{
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"x", " ", "->", " ", 
          RowBox[{"-", "1"}]}], ",", " ", 
         RowBox[{"y", " ", "->", " ", "0"}]}], "|>"}], ",", " ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"x", ",", " ", "y"}], "}"}], " ", "->", " ", "1"}], 
