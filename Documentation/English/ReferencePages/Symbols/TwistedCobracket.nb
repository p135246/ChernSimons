Cell[TextData[{
 "Only the part ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["m", "TI"], 
    RowBox[{"2", ",", "0"}]], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"41cee235-fdda-4b80-861d-e14d3b63301a"],
 " enters. The part ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["m", "TI"], 
    RowBox[{"1", ",", "0"}]], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"6e3b0e0b-d8ff-43e8-84be-c799f874cae4"],
 " is what ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["TwistedDifferential"]], 
    "paclet:ChernSimons/ref/TwistedDifferential", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "fd8e10b9-b425-4100-b4e0-c3c950de2dc2"],
 " reads."
}], "Notes",ExpressionUUID->"65423a78-b912-47b1-959b-d06da9a40fed"],

Cell["\<\
On a cyclic word the result is a sum of products of two words.\
\>", "Notes",ExpressionUUID->"b655a372-3354-402e-9117-f1689fb28300"],

Cell[TextData[{
 "The convention of the pairing selects the picture. Under ",
 Cell[BoxData["\"\<Symmetric\>\""], "InlineFormula",ExpressionUUID->
  "7dbd9067-dd03-48b0-bb9e-22d4dd162019"],
 " the parts of ",
 StyleBox["m", "TI"],
 " and the result are ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SymmetricProduct"]], "paclet:ChernSimons/ref/SymmetricProduct",
     "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "0fe4cf4d-9460-4318-bdb3-7ecbd8374e14"],
 " terms, under ",
 Cell[BoxData["\"\<Exterior\>\""], "InlineFormula",ExpressionUUID->
  "dec8e56d-64f7-4f4c-9fbc-25800c22997c"],
 " ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ExteriorProduct"]], "paclet:ChernSimons/ref/ExteriorProduct", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "c895cbcb-1d59-409e-bfa6-01fb06e94d88"],
 " terms."
}], "Notes",ExpressionUUID->"6d1bdeb3-69d5-4554-b5c8-292efb6f8488"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SymmetricToExterior"]], 
    "paclet:ChernSimons/ref/SymmetricToExterior", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "5b445e78-6d54-4b38-94fd-14f9cadf67a7"],
 " relates the two pictures: it sends ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["f", "TI"], "\[CircleDot]", 
    StyleBox["g", "TI"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "30c29f3a-8e14-494e-a0a7-0566e3d59581"],
 " to ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"-", "1"}], ")"}], 
     RowBox[{"|", 
      StyleBox["f", "TI"], 
      SubscriptBox["|", "\[Wedge]"]}]], 
    StyleBox["f", "TI"], "\[Wedge]", 
    StyleBox["g", "TI"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "f4e318a4-eb77-4950-9f75-afc51ee3ea85"],
 ", so over the circle ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["y", "TI"], "\[CircleDot]", 
    StyleBox["y", "TI"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "fdffeaaa-a94d-4498-a92e-100f2fa1e351"],
 " corresponds to ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", 
    StyleBox["y", "TI"], "\[Wedge]", 
    StyleBox["y", "TI"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "b3964f84-a8db-4430-82b3-637fea644ce8"],
 "."
}], "Notes",ExpressionUUID->"832a0e53-8583-4877-a09e-9d5011d7a277"],

Cell["\<\
On a product the twisted co-bracket acts on each factor in turn, with the \
Koszul sign of the shuffle.\
\>", "Notes",ExpressionUUID->"e7fd5b9e-cef6-485d-854d-9b0cfe65ae05"],

Cell["A product of the other kind returns unevaluated.", "Notes",ExpressionUUID->"3b748591-e477-4b6c-b354-beee06edaf77"],

