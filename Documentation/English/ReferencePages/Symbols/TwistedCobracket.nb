Cell["TwistedCobracket", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"f4ee77ea-47d4-4509-9613-12fc6f73c020"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["TwistedCobracket"]], 
     "paclet:ChernSimons/ref/TwistedCobracket", "ChernSimons Package Symbol"},
    
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["m", "TI"], ",", " ", 
    StyleBox["w", "TI"], ",", " ", 
    StyleBox["pairing", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a1f4b69e-ce8d-4ae4-910b-62791d9871e7"],
 "\[LineSeparator]",
 "gives the co-bracket ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["q", "TI"], 
    RowBox[{"1", ",", "2", ",", "0"}], 
    StyleBox["m", "TI"]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c8cc9751-8e30-46b9-884b-d456faf6919b"],
 " twisted by the element ",
 StyleBox["m", "TI"],
 ", applied to the cyclic word ",
 StyleBox["w", "TI"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"e421ae1f-cde1-4f45-9491-aa08d5ecae04"],

Cell[TextData[{
 "The untwisted co-bracket plus the insertion of ",
 StyleBox["m", "TI"],
 ", so the result is a sum of a cyclic word and a product of two."
}], "Notes",ExpressionUUID->"83865d9a-d997-4638-966c-c734e64ce3aa"],

Cell[TextData[{
 "Written in the exterior picture, like ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["TwistedDifferential"]], 
    "paclet:ChernSimons/ref/TwistedDifferential", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "bdd1e227-5fc4-480f-ae4d-78272f767bbb"],
 ", regardless of the convention carried by ",
 StyleBox["pairing", "TI"],
 "."
}], "Notes",ExpressionUUID->"b45e673a-1fff-47fd-9cab-be6c5a0b22d5"]
}, Open  ]],

