Cell[BoxData[{
 RowBox[{
  RowBox[{"pairing", " ", "=", " ", 
   RowBox[{"GradedPairing", "[", 
    RowBox[{
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"x", " ", "->", " ", 
        RowBox[{"-", "1"}]}], ",", " ", 
       RowBox[{"y", " ", "->", " ", "0"}]}], "|>"}], ",", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "y"}], "}"}], " ", "->", " ", "1"}], "|>"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{"TwistedCobracket", "[", 
  RowBox[{
   RowBox[{"CyclicWord", "[", 
    RowBox[{"{", 
     RowBox[{"x", ",", " ", "x", ",", " ", "y"}], "}"}], "]"}], ",", " ", 
   RowBox[{"CyclicWord", "[", 
    RowBox[{"{", 
     RowBox[{"x", ",", " ", "y", ",", " ", "y", ",", " ", "y"}], "}"}], "]"}],
    ",", " ", "pairing"}], "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"9fb10d1f-f4b2-4e79-a578-e16474057e7c"],

Cell[BoxData[
 RowBox[{
  InterpretationBox[
   RowBox[{"(", 
    RowBox[{
    "x", "\[ThinSpace]", "x", "\[ThinSpace]", "y", "\[ThinSpace]", "y", "\[ThinSpace]",
      "y"}], ")"}],
   ChernSimons`CyclicWord[{
    MTNB$6mkidb3b387a`x, MTNB$6mkidb3b387a`x, MTNB$6mkidb3b387a`y, 
     MTNB$6mkidb3b387a`y, MTNB$6mkidb3b387a`y}],
   Editable->False], "+", 
  InterpretationBox[
   RowBox[{
    InterpretationBox[
     RowBox[{"(", "y", ")"}],
     ChernSimons`CyclicWord[{MTNB$6mkidb3b387a`y}],
     Editable->False], "\[Wedge]", 
    InterpretationBox[
     RowBox[{"(", "y", ")"}],
     ChernSimons`CyclicWord[{MTNB$6mkidb3b387a`y}],
