Cell[BoxData[
 RowBox[{"TwistedCobracket", "[", 
  RowBox[{
   RowBox[{"MaurerCartanElement", "[", 
    RowBox[{
     RowBox[{"CyclicWord", "[", 
      RowBox[{"{", 
       RowBox[{"x", ",", " ", "x", ",", " ", "y"}], "}"}], "]"}], ",", " ", 
     "pairing"}], "]"}], ",", " ", 
   RowBox[{"ExteriorProduct", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"x", ",", " ", "y", ",", " ", "y"}], "}"}], ",", " ", 
     RowBox[{"{", "y", "}"}], ",", " ", 
     RowBox[{"Append", "[", 
      RowBox[{"pairing", ",", " ", 
