Cell[TextData[{
 "The report has one row per degree ",
 Cell[BoxData[
  FormBox[
   StyleBox["k", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7e80533f-7ee8-43f1-96fa-9e7c965f5548"],
 " and the following columns:"
}], "Notes",
 CellFrameLabels->{{Inherited, Inherited}, {Inherited, 
    Cell[
     TextData[{
      "26.09.30: Design review - the report shows the numbers behind \
HodgeTypeQ, one row per degree: the dimensions of the three terms of the \
short exact sequence from the degenerate subspace through the space to the \
nondegenerate quotient, and the cohomology of the first two, so that where a \
model fails to be of Hodge type can be read off: the quotient map is a \
quasi-isomorphism exactly where the column \"DegenerateCohomology\" vanishes. \
It is a Dataset of Associations keyed by degree, so a column is read with a \
Dataset query and Normal gives the plain data. For a model the default last \
degree is n+3, beyond the range n+1 that HodgeTypeQ needs, and \"MaxDegree\" \
sets it, at least n since R7 (Pavel, 2026-10-01), the rule of HodgeTypeQ and \
PoincareDualityQ; the complex is finite, so every degree from its lowest to \
its highest is shown and that form takes no option. The report does not ask \
PoincareDualityQ, since it decides nothing. No alternative interface was \
recorded. Prior art: the Wolfram Language has no such report; Dataset is its \
display. The engine of the verification suites computes the same table, and \
T17 pins Normal of the report against it to degree n+3 on the thirteen \
catalogue models and the Kodaira-Thurston model.", "\n\n", 
       Cell[
        BoxData[
         GridBox[{{
            Cell[
             BoxData[
              ButtonBox[
               DynamicBox[
                FEPrivate`FrontEndResource[
                "DocumentationToolsStrings", "Edit"]], BaseStyle -> 
               "TextAnnotationButton"]]], 
            StyleBox[
             RowBox[{
               DynamicBox[
                FEPrivate`FrontEndResource[
                "DocumentationToolsStrings", "LastAnnotator"]], "pavel"}], 
             "TextAnnotator"], 
            Cell[
             BoxData[
              ButtonBox[
               DynamicBox[
                FEPrivate`FrontEndResource[
                "DocumentationToolsStrings", "Delete"]], BaseStyle -> 
               "TextAnnotationRemoveButton"]]], ""}}, 
          GridBoxAlignment -> {
           "Columns" -> {Left, Left, Right, Right}, "Rows" -> {{Automatic}}}, 
          GridBoxItemSize -> {"Columns" -> {
              Scaled[0.15], 
              Scaled[0.68], 
              Scaled[0.15], 
              Scaled[0.02]}}]]], "\n"}], "TextAnnotation", 
     CellSize -> {590, Inherited}]}},
 CellTags->"TextAnnotation",
 CellID->399844188,ExpressionUUID->"13f335a9-d1a6-4643-8f20-bc9e5b21daf8"],

