Cell[TextData[{
 "The quotient map ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["V", "TI"], "\[Rule]", 
    StyleBox["Q", "TI"], 
    RowBox[{"(", 
     StyleBox["V", "TI"], ")"}]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f6fa93b2-5185-4650-b562-cd4d4b3b4a29"],
 " is a quasi-isomorphism exactly when ",
 Cell[BoxData["\"\<DegenerateCohomology\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "38f46bdd-d124-459d-8a56-4c3b360d623f"],
 " vanishes throughout. With Poincar\[EAcute] duality on cohomology, that is \
exactly when the space is of Hodge type, as ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["HodgeTypeQ"]], "paclet:ChernSimons/ref/HodgeTypeQ", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "dde28d40-e0b0-4d36-8579-df669092c89f"],
 " decides."
}], "Notes",ExpressionUUID->"66ca5153-3bec-46ff-bd64-d310260b5aee"],

Cell[TextData[{
 "When the quotient map is a quasi-isomorphism, ",
 Cell[BoxData["\"\<Cohomology\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5bfc1beb-85a2-47d4-a1dc-3647079383d5"],
 " is the cohomology of the quotient and is at most ",
 Cell[BoxData["\"\<Quotient\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "48bca5f3-9eeb-4da0-af14-49017f63bb19"],
 " in each degree."
}], "Notes",ExpressionUUID->"29af457a-de3c-4cd0-825a-3130ba059927"],

Cell["\<\
The two agree in every degree exactly when the quotient carries no \
differential. The quotient is then the cohomology, and the model is formal.\
\>", "Notes",ExpressionUUID->"89ce2905-1f55-48f6-ad4c-81c9447745b6"],

Cell["\<\
The report is computed whether or not the pairing on cohomology is perfect.\
\>", "Notes",ExpressionUUID->"a54dddee-0b59-4ee2-9e2b-775e4e301473"],

