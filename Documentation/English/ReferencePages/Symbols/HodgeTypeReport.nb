Cell[TextData[{
 Cell[BoxData["\"\<Dimension\>\""], "InlineFormula",ExpressionUUID->
  "90effa76-cf9d-4f81-affd-69203df2beba"],
 " is the sum of ",
 Cell[BoxData["\"\<Degenerate\>\""], "InlineFormula",ExpressionUUID->
  "5b99a477-51b4-4b9b-b3bf-641dff01d177"],
 " and ",
 Cell[BoxData["\"\<Quotient\>\""], "InlineFormula",ExpressionUUID->
  "b64efc5b-ee72-4437-89fc-d378fb4bdc5d"],
 " in every degree."
}], "Notes",ExpressionUUID->"00485fd2-ba47-43d1-b060-877a9adf0692"],

Cell[TextData[{
 "The quotient map ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["V", "TI"], "\[Rule]", 
    StyleBox["Q", "TI"], 
    RowBox[{"(", 
     StyleBox["V", "TI"], ")"}]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"66dfd852-ffca-441c-a751-23005407f5f7"],
 " is a quasi-isomorphism exactly when ",
 Cell[BoxData["\"\<DegenerateCohomology\>\""], "InlineFormula",ExpressionUUID->
  "19031de2-ddeb-463d-aaad-82c03b723d4f"],
 " vanishes throughout. With Poincar\[EAcute] duality on cohomology, that is \
exactly when the space is of Hodge type, as ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["HodgeTypeQ"]], "paclet:ChernSimons/ref/HodgeTypeQ", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "560279eb-2f23-4e84-83b0-8b508597f5a5"],
 " decides."
}], "Notes",ExpressionUUID->"02bda577-d348-4ea9-a0ef-ea118a654cc0"],

Cell[TextData[{
 "When the quotient map is a quasi-isomorphism, ",
 Cell[BoxData["\"\<Cohomology\>\""], "InlineFormula",ExpressionUUID->
  "23b2dddd-8564-475c-95a8-17a296dc3612"],
 " is the cohomology of the quotient and is at most ",
 Cell[BoxData["\"\<Quotient\>\""], "InlineFormula",ExpressionUUID->
  "11993973-c4ae-4b2b-8353-307f46c31dfe"],
 " in each degree."
}], "Notes",ExpressionUUID->"3d03ff0d-50b8-4689-b9fd-d0282f28721a"],

Cell["\<\
The two agree in every degree exactly when the quotient carries no \
differential. The quotient is then the cohomology, and the model is formal.\
\>", "Notes",ExpressionUUID->"29ca4e0f-bc1f-430b-8502-0c6f5876e78a"],

Cell["\<\
The report is computed whether or not the pairing on cohomology is perfect.\
\>", "Notes",ExpressionUUID->"5946311f-7c61-4985-8889-8c8b537ad60c"],

