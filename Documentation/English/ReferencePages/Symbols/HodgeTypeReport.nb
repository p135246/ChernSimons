  TemplateBox[{
    Cell[
     TextData["PoincareDualityQ"]], "paclet:ChernSimons/ref/PoincareDualityQ",
     "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "d1b53222-76b5-4860-b20c-c54af8d3141b"],
 "."
}], "Notes",ExpressionUUID->"cf3d70f2-8b2a-4c70-9748-5ddeccec8834"],

Cell["\<\
For a complex, the rows run from its lowest to its highest degree, and that \
form takes no option.\
\>", "Notes",ExpressionUUID->"a5b00694-6803-49aa-a142-774096fcb0ed"],

