Cell[BoxData[
 RowBox[{"HodgeTypeReport", "[", 
  RowBox[{"SullivanModel", "[", "\"\<HeisenbergNilmanifold\>\"", "]"}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"44783416-2308-4938-bdfe-eb3a05536ad0"],

