 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["PoincareDualityQ"]], "paclet:ChernSimons/ref/PoincareDualityQ",
     "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "b2142939-302b-4043-9b34-549b71a0279f"],
 "."
}], "Notes",ExpressionUUID->"39bca128-4772-4006-8bb8-60577f2a5098"],

Cell["\<\
For a complex, the rows run from its lowest to its highest degree, and that \
form takes no option.\
\>", "Notes",ExpressionUUID->"15adefd1-1703-4794-8a0a-7526f69b3d86"],

