Cell[TextData[{
 "The quotient map ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["V", "TI"], "\[Rule]", 
    StyleBox["Q", "TI"], 
    RowBox[{"(", 
     StyleBox["V", "TI"], ")"}]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "af6299a9-872f-4cb0-94b4-ccd1dafcabfa"],
 " is a quasi-isomorphism exactly when ",
 Cell[BoxData["\"\<DegenerateCohomology\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1b019016-b1c8-4bfc-83af-32e59558d7ff"],
 " vanishes throughout. With Poincar\[EAcute] duality on cohomology, that is \
exactly when the space is of Hodge type, as ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["HodgeTypeQ"]], "paclet:ChernSimons/ref/HodgeTypeQ", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "1f96604b-1920-4b96-8ee4-027c3bb2c101"],
 " decides."
}], "Notes",ExpressionUUID->"2b2777e5-5051-450e-99c8-0f0b67017392"],

Cell[TextData[{
 "When the quotient map is a quasi-isomorphism, ",
 Cell[BoxData["\"\<Cohomology\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fa55bb37-95d7-4135-a680-10b669151f4d"],
 " is the cohomology of the quotient and is at most ",
 Cell[BoxData["\"\<Quotient\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e9ae5bc1-3931-4009-bb7e-89f4bccb00ef"],
 " in each degree."
}], "Notes",ExpressionUUID->"1e23aff5-1074-4eb0-9dfb-ff20d31554b2"],

Cell["\<\
The two agree in every degree exactly when the quotient carries no \
differential. The quotient is then the cohomology, and the model is formal.\
\>", "Notes",ExpressionUUID->"7fbd4f14-c254-451d-bcec-fc0fd0146159"],

Cell["\<\
The report is computed whether or not the pairing on cohomology is perfect.\
\>", "Notes",ExpressionUUID->"a642c580-c34a-4905-8236-520de01bd447"],

