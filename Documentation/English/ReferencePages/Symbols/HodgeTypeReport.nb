Cell[CellGroupData[{

Cell[BoxData[
 InterpretationBox[GridBox[{
    {
     StyleBox[
      RowBox[{"Basic", " ", "Examples"}], "PrimaryExamplesSection"], 
     ButtonBox[
      RowBox[{
       RowBox[{"More", " ", "Examples"}], " ", "\[RightTriangle]"}],
      BaseStyle->"ExtendedExamplesLink",
      ButtonData:>"ExtendedExamples"]}
   }],
  $Line = 0; Null]], "PrimaryExamplesSection",
 CellID->880084151,ExpressionUUID->"4d971e0b-a467-44b1-b908-78f8a7482a42"],

Cell[TextData[{
 "The report of the model of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["CP",
     FontSlant->"Plain"], "2"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "361e3ca8-ee99-4a83-8d08-3eed6f84b206"],
 ". The column ",
 Cell[BoxData["\"\<DegenerateCohomology\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "20acf840-f8a0-407a-881d-feb7bc203123"],
 " is zero, so the model is of Hodge type; the columns ",
 Cell[BoxData["\"\<Cohomology\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5803853c-ee77-425a-b6bb-0b8d6d2c0829"],
 " and ",
 Cell[BoxData["\"\<Quotient\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a217e3e3-76bd-405c-a289-a796d4592ec1"],
 " coincide, because ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["CP",
     FontSlant->"Plain"], "2"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "31248ef0-bf62-47b2-95aa-dec27d41e257"],
 " is formal and the quotient is its cohomology, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", ",", "0", ",", "1", ",", "0", ",", "1"}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "230da7e5-4ce2-4628-8f27-56185d4696cd"],
 ":"
}], "ExampleText",ExpressionUUID->"72480cbf-174f-4230-bff6-d19c367b24a6"],

