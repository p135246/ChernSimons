Cell[TextData[{
 Cell[BoxData["\"\<Dimension\>\""], "InlineFormula",ExpressionUUID->
  "8da7e21f-7e5b-426a-8d7d-64667a0b4bd8"],
 " is the sum of ",
 Cell[BoxData["\"\<Degenerate\>\""], "InlineFormula",ExpressionUUID->
  "78381786-bb9a-4791-92c1-47286234b060"],
 " and ",
 Cell[BoxData["\"\<Quotient\>\""], "InlineFormula",ExpressionUUID->
  "3b525ec9-59f8-4fc1-8801-4727af4d4245"],
 " in every degree."
}], "Notes",ExpressionUUID->"c5727114-4593-413e-b566-79a3c54d782b"],

Cell[TextData[{
 "The quotient map ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["V", "TI"], "\[Rule]", 
    StyleBox["Q", "TI"], 
    RowBox[{"(", 
     StyleBox["V", "TI"], ")"}]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"9cce555d-fedc-4181-8a82-6ae7a0121004"],
 " is a quasi-isomorphism exactly when ",
 Cell[BoxData["\"\<DegenerateCohomology\>\""], "InlineFormula",ExpressionUUID->
  "1a0457bf-b67a-4dba-8417-b0cf87611f76"],
 " vanishes throughout. With Poincar\[EAcute] duality on cohomology, that is \
exactly when the space is of Hodge type, as ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["HodgeTypeQ"]], "paclet:ChernSimons/ref/HodgeTypeQ", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "5f2c4e7f-c66f-4c13-a532-b0d4fb764002"],
 " decides."
}], "Notes",ExpressionUUID->"365becb3-53a7-489b-b6af-5cd8baf9d5a5"],

Cell[TextData[{
 "When the quotient map is a quasi-isomorphism, ",
 Cell[BoxData["\"\<Cohomology\>\""], "InlineFormula",ExpressionUUID->
  "82d73dd0-ed58-4fd0-af14-d79483a7aaa4"],
 " is the cohomology of the quotient and is at most ",
 Cell[BoxData["\"\<Quotient\>\""], "InlineFormula",ExpressionUUID->
  "af7e799d-3306-48e5-a606-1d35ecf2b5d5"],
 " in each degree."
}], "Notes",ExpressionUUID->"84fd4677-1640-4547-8e24-b65107c55106"],

Cell["\<\
The two agree in every degree exactly when the quotient carries no \
differential. The quotient is then the cohomology, and the model is formal.\
\>", "Notes",ExpressionUUID->"af7dee5f-1bd5-428f-bfc9-b93a535f3469"],

Cell["\<\
The report is computed whether or not the pairing on cohomology is perfect.\
\>", "Notes",ExpressionUUID->"9befd29f-7e08-47f7-946c-a7da3c053747"],

