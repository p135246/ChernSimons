 Cell[BoxData["\"\<DegenerateCohomology\>\""], "InlineFormula",ExpressionUUID->
  "7033fd8e-9b77-4a41-89a6-305600d0adc8"],
 " is zero, so the model is of Hodge type; the columns ",
 Cell[BoxData["\"\<Cohomology\>\""], "InlineFormula",ExpressionUUID->
  "e1716b25-bfe1-4deb-b79b-1b8b099ed875"],
 " and ",
 Cell[BoxData["\"\<Quotient\>\""], "InlineFormula",ExpressionUUID->
  "e96cce00-4330-413f-949c-8be242e967fa"],
 " coincide, because ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["CP",
     FontSlant->"Plain"], "2"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"160fb636-171c-476a-a32a-0d46c3a8963e"],
 " is formal and the quotient is its cohomology, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", ",", "0", ",", "1", ",", "0", ",", "1"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"7fd87757-a114-4dbe-84b8-31c8bf03af08"],
 ":"
}], "ExampleText",ExpressionUUID->"cfd23a3c-bc66-4c11-ac05-929b09885632"],

