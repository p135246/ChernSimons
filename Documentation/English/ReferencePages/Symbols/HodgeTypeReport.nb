Cell[TextData[{
 "The minimal model of the Heisenberg nilmanifold has nothing degenerate, so \
it is its own quotient, an eight-dimensional differential Poincar\[EAcute] \
duality algebra with Betti numbers ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", ",", "2", ",", "2", ",", "1"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"0446293f-0b67-4fcc-aa2e-f14f0d98b7a0"],
 ". It is of Hodge type, and yet ",
 Cell[BoxData["\"\<Cohomology\>\""], "InlineFormula",ExpressionUUID->
  "0cab1844-a756-4828-9634-e99d0a807aa0"],
 " falls short of ",
 Cell[BoxData["\"\<Quotient\>\""], "InlineFormula",ExpressionUUID->
  "1638ffc4-668d-4dcc-8bcb-54b19f5b2fa7"],
 ": the nilmanifold is not formal, and the quotient keeps a differential:"
}], "ExampleText",ExpressionUUID->"7a4ba110-3941-41b8-a580-025c188ec631"],

