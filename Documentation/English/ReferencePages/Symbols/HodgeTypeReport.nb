Cell[BoxData[
 RowBox[{"HodgeTypeReport", "[", 
  RowBox[{"SullivanModel", "[", "\"\<HeisenbergNilmanifold\>\"", "]"}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"ccf1b896-3ffa-45b0-a704-38d2e2567276"],

