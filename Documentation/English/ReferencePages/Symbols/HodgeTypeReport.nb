Cell[TextData[{
 "The minimal model of the Heisenberg nilmanifold has nothing degenerate, so \
it is its own quotient, an eight-dimensional differential Poincar\[EAcute] \
duality algebra with Betti numbers ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", ",", "2", ",", "2", ",", "1"}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1f33b496-cc18-471b-a9df-c3c8aad74984"],
 ". It is of Hodge type, and yet ",
 Cell[BoxData["\"\<Cohomology\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6fffc9b0-eab4-4849-9c18-7707cc8a2386"],
 " falls short of ",
 Cell[BoxData["\"\<Quotient\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1966f98d-a653-4685-a8fa-ddd92c135bcb"],
 ": the nilmanifold is not formal, and the quotient keeps a differential:"
}], "ExampleText",ExpressionUUID->"eebbe9aa-cb73-480b-808f-5a77b6ba1923"],

