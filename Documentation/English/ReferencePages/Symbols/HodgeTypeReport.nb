Cell[TextData[{
 "The minimal model of the Heisenberg nilmanifold has nothing degenerate, so \
it is its own quotient \[LongDash] an eight-dimensional differential Poincar\
\[EAcute] duality algebra with Betti numbers ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", ",", "2", ",", "2", ",", "1"}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7b9d7873-597d-423a-ab9c-7131ff57b1e0"],
 ". It is of Hodge type, and yet ",
 Cell[BoxData["Cohomology"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9e07e9ad-cdc9-4d30-a338-bbabe9fcc457"],
 " falls short of ",
 Cell[BoxData["Quotient"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6e98a9fd-c3b4-43c6-93a7-a8375a0a6bb3"],
 ": the nilmanifold is not formal, and the quotient keeps a differential."
}], "ExampleText",ExpressionUUID->"563eefaa-9170-48a8-acaf-b143568fe411"],

