Cell[TextData[{
 "For ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["CP",
     FontSlant->"Plain"], "2"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "87150cff-d872-4283-b416-0d8e65388f3d"],
 " the fourth column is zero, so the model is of Hodge type; and the ",
 Cell[BoxData["Cohomology"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ed186fbe-7f76-45e4-867b-fd90efe57f88"],
 " and ",
 Cell[BoxData["Quotient"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cb187e3a-c7d1-429b-a45a-5ba0e4b45a24"],
 " columns coincide, because ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["CP",
     FontSlant->"Plain"], "2"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5fa8724c-4809-45b0-82f1-af4dc9f7448b"],
 " is formal and the quotient is its cohomology, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", ",", "0", ",", "1", ",", "0", ",", "1"}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d679f01c-bd22-4201-aa1e-33ee9a5c5945"],
 ":"
}], "ExampleText",ExpressionUUID->"aa5f7a05-ed9c-4664-82d5-1026c980fe94"],

