Cell[BoxData[
 RowBox[{"HodgeTypeReport", "[", 
  RowBox[{"SullivanModel", "[", "\"\<HeisenbergNilmanifold\>\"", "]"}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"cd43ba64-9c08-4c50-84dc-8f980a65bb29"],

