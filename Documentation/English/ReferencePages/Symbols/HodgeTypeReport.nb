 ". The column ",
 Cell[BoxData["\"\<DegenerateCohomology\>\""], "InlineFormula",ExpressionUUID->
  "51d31469-239c-4173-8610-b62d5559532e"],
 " is zero, so the model is of Hodge type; the columns ",
 Cell[BoxData["\"\<Cohomology\>\""], "InlineFormula",ExpressionUUID->
  "ea863a4f-f33f-41e5-bf80-7945188ec61d"],
 " and ",
 Cell[BoxData["\"\<Quotient\>\""], "InlineFormula",ExpressionUUID->
  "42e38424-3f3b-4bcd-9a96-e6b888846297"],
 " coincide, because ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["CP",
     FontSlant->"Plain"], "2"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"dc9b8947-dfc0-4524-b755-468f3252c2d1"],
 " is formal and the quotient is its cohomology, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", ",", "0", ",", "1", ",", "0", ",", "1"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"4a82192c-71d2-45f8-8b69-fa92c3c1a879"],
 ":"
}], "ExampleText",ExpressionUUID->"eb00f18a-03e9-43ca-8e63-34af0c83cb04"],

