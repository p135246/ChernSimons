Cell[BoxData[
 RowBox[{"HodgeTypeReport", "[", 
  RowBox[{"SullivanModel", "[", "\"\<HeisenbergNilmanifold\>\"", "]"}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"c8d6efc6-6674-4bbb-9cbd-849dad4f1816"],

