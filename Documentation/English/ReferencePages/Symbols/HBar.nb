Cell["\<\
It appears in the operator of the Beilinson-Drinfeld algebra:\
\>", "ExampleText",ExpressionUUID->"c7e078ae-b51e-4557-ace5-4f4763641b9e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"CanonicalBeilinsonDrinfeldOperator", "[", 
  RowBox[{
   RowBox[{"SymmetricProduct", "[", 
    RowBox[{
     RowBox[{"CyclicWord", "[", 
      RowBox[{"{", 
       RowBox[{"x", ",", " ", "y", ",", " ", "y", ",", " ", "y"}], "}"}], 
      "]"}], ",", " ", 
     RowBox[{"CyclicWord", "[", 
      RowBox[{"{", 
       RowBox[{"x", ",", " ", "y"}], "}"}], "]"}], ",", " ", "pairing"}], 
    "]"}], ",", " ", "pairing"}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"3e3c5a18-2725-49e2-b870-44df4935cc28"],

Cell[BoxData[
 RowBox[{
  RowBox[{"2", " ", 
   InterpretationBox["\[HBar]",
    ChernSimons`HBar,
    Editable->False], " ", 
   InterpretationBox[
    RowBox[{"(", 
     RowBox[{
     "x", "\[ThinSpace]", "y", "\[ThinSpace]", "y", "\[ThinSpace]", "y"}], 
     ")"}],
    ChernSimons`CyclicWord[{
     MTNB$qdqyuonvk7fn`x, MTNB$qdqyuonvk7fn`y, MTNB$qdqyuonvk7fn`y, 
      MTNB$qdqyuonvk7fn`y}],
    Editable->False]}], "-", 
  InterpretationBox[
   RowBox[{
    InterpretationBox[
     RowBox[{"(", "y", ")"}],
     ChernSimons`CyclicWord[{MTNB$qdqyuonvk7fn`y}],
     Editable->False], "\[CircleDot]", 
    InterpretationBox[
     RowBox[{"(", "y", ")"}],
     ChernSimons`CyclicWord[{MTNB$qdqyuonvk7fn`y}],
     Editable->False], "\[CircleDot]", 
    InterpretationBox[
     RowBox[{"(", 
      RowBox[{"x", "\[ThinSpace]", "y"}], ")"}],
     ChernSimons`CyclicWord[{MTNB$qdqyuonvk7fn`x, MTNB$qdqyuonvk7fn`y}],
     Editable->False]}],
   ChernSimons`SymmetricProduct[
    ChernSimons`CyclicWord[{MTNB$qdqyuonvk7fn`y}], 
    ChernSimons`CyclicWord[{MTNB$qdqyuonvk7fn`y}], 
    ChernSimons`CyclicWord[{MTNB$qdqyuonvk7fn`x, MTNB$qdqyuonvk7fn`y}]],
   Editable->False]}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"6c085cf0-5060-453d-850d-e1b74d315c17"]
