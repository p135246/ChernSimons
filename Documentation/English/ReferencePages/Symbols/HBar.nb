Cell[CellGroupData[{
Cell["HBar", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["HBar"]], "paclet:ChernSimons/ref/HBar", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "e166a553-4da3-4e92-ae51-4faf953e63d9"],
 " is the formal variable ",
 Cell[BoxData[
  FormBox["\[Null]", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0b52a338-ad7b-40fe-83af-9ea6708e6b6d"],
 " of the Beilinson-Drinfeld algebra.",
 "\n"
}], "Usage",ExpressionUUID->"8ad74195-0b1f-4ba4-96c2-2faaee85d66c"],

Cell[TextData[{
 "An ordinary symbol carrying no value, of symmetric degree ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["PlanckDegree"]], "paclet:ChernSimons/ref/PlanckDegree", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "4a43aa6a-1983-4bd0-b77a-259a2560ef9d"],
 "[",
 StyleBox["pairing", "TI"],
 "]."
}], "Notes",ExpressionUUID->"72ab6de6-06a3-4b46-8df2-ae4a0e97c2ea"],

Cell[TextData[{
 "It appears in ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["BeilinsonDrinfeldOperator"]], 
    "paclet:ChernSimons/ref/BeilinsonDrinfeldOperator", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "2c313232-e71a-4d1c-8d1a-1bbf668a32a5"],
 " as the weight of the bracket term, and in a BD action as the weight ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[Null]", 
    StyleBox["g", "TI"]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "85908a40-3e9d-4566-86ef-af2a35ec6b25"],
 " of the genus-",
 Cell[BoxData[
  FormBox[
   StyleBox["g", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f129bcfd-0c5b-4272-ac4a-d024f40243e2"],
 " component. The BD formalism never inverts it; negative powers appear only \
in the localized BV picture, where the BV action is ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[Null]", 
    RowBox[{"-", "1"}]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1c075de1-1adc-4d1c-a37a-037aa40feba4"],
 " times the BD one."
}], "Notes",ExpressionUUID->"e09bc14c-90b7-4bf6-9c65-ab91fa36bf6e"],

Cell["\<\
It is the one exported symbol of the paclet with no value of its own.\
\>", "Notes",ExpressionUUID->"eeb93a6f-43a5-4718-844e-22214459416f"],

Cell[TextData[{
 "It displays as ",
 Cell[BoxData[
  FormBox["\[Null]", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d161d1c0-9a8f-4625-becc-fad5bf7211b5"],
 "."
}], "Notes",ExpressionUUID->"23626472-da32-4c41-97db-80bd00a24bb2"]
}, Open  ]],

