Cell["\<\
It appears in the operator of the Beilinson-Drinfeld algebra:\
\>", "ExampleText",ExpressionUUID->"060e5a3a-65b3-48d1-b3d0-802d9ad8e20d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"CanonicalBeilinsonDrinfeldOperator", "[", 
  RowBox[{
   RowBox[{"SymmetricProduct", "[", 
    RowBox[{
     RowBox[{"CyclicWord", "[", 
      RowBox[{"{", 
       RowBox[{"x", ",", " ", "y", ",", " ", "y", ",", " ", "y"}], "}"}], 
      "]"}], ",", " ", 
     RowBox[{"CyclicWord", "[", 
      RowBox[{"{", 
       RowBox[{"x", ",", " ", "y"}], "}"}], "]"}], ",", " ", "pairing"}], 
    "]"}], ",", " ", "pairing"}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"545ec61b-2a9f-4ac8-8400-51702a2963a4"],

Cell[BoxData[
 RowBox[{
  RowBox[{"2", " ", 
   InterpretationBox["\[HBar]",
    ChernSimons`HBar,
    Editable->False], " ", 
   InterpretationBox[
    RowBox[{"(", 
     RowBox[{
     "x", "\[ThinSpace]", "y", "\[ThinSpace]", "y", "\[ThinSpace]", "y"}], 
     ")"}],
    ChernSimons`CyclicWord[{
     MTNB$qdqyuonvk7fn`x, MTNB$qdqyuonvk7fn`y, MTNB$qdqyuonvk7fn`y, 
      MTNB$qdqyuonvk7fn`y}],
    Editable->False]}], "-", 
  InterpretationBox[
   RowBox[{
    InterpretationBox[
     RowBox[{"(", "y", ")"}],
     ChernSimons`CyclicWord[{MTNB$qdqyuonvk7fn`y}],
     Editable->False], "\[CircleDot]", 
    InterpretationBox[
     RowBox[{"(", "y", ")"}],
     ChernSimons`CyclicWord[{MTNB$qdqyuonvk7fn`y}],
     Editable->False], "\[CircleDot]", 
    InterpretationBox[
     RowBox[{"(", 
      RowBox[{"x", "\[ThinSpace]", "y"}], ")"}],
     ChernSimons`CyclicWord[{MTNB$qdqyuonvk7fn`x, MTNB$qdqyuonvk7fn`y}],
     Editable->False]}],
   ChernSimons`SymmetricProduct[
    ChernSimons`CyclicWord[{MTNB$qdqyuonvk7fn`y}], 
    ChernSimons`CyclicWord[{MTNB$qdqyuonvk7fn`y}], 
    ChernSimons`CyclicWord[{MTNB$qdqyuonvk7fn`x, MTNB$qdqyuonvk7fn`y}]],
   Editable->False]}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"36b2e75d-6b1a-400b-a440-c5430ae266da"]
}, Open  ]],

Cell["Setting it to zero gives the classical limit:", "ExampleText",ExpressionUUID->"73f96e3c-f300-488d-ab1e-bc5efae0b56b"],

