 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"51192afc-b576-47f6-ab6a-184e3f944dc4"],
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["HBar"]], "paclet:ChernSimons/ref/HBar", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "03e515e5-69ff-403b-8cac-d830c3cb9f5a"],
 "\[LineSeparator]",
 "is the formal variable ",
 Cell[BoxData[
  FormBox["\[HBar]", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "e0e62d64-58f8-4dd8-9cb4-e8b14d0d32f0"],
 " of the Beilinson-Drinfeld algebra.",
 "\n"
}], "Usage",ExpressionUUID->"3f6bc350-3ee4-4bac-94cd-fac47dc8a72c"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["HBar"]], "paclet:ChernSimons/ref/HBar", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "5240b00a-94e8-40f6-8073-7001afe05ebf"],
 " is a symbol with no value."
}], "Notes",
 CellFrameLabels->{{Inherited, Inherited}, {Inherited, 
    Cell[
     TextData[{
      "26.09.30: Design review - HBar is an ordinary symbol with no value, by \
design the one export of the paclet that carries none; it was the engine's \
hbar until T0b. Every operation treats it as a scalar through the scalar \
tests of its linearity rules, and it has even degree, so it never enters a \
Koszul sign. Its degree is given by ElementDegree in the symmetric grading \
only, 2(n - 3), the degree that makes the operator homogeneous of degree -1; \
in the other two gradings it returns unevaluated, a decision of R5f kept by \
Pavel. The verification suites load their engine after the paclet, so the \
engine's HBar is this symbol. Prior art: in the Wolfram Language the \
character \\[HBar] is a letter that makes an ordinary symbol of the current \
context, with no built-in meaning.", "\n\n", 
       Cell[
        BoxData[
         GridBox[{{
            Cell[
             BoxData[
              ButtonBox[
               DynamicBox[
                FEPrivate`FrontEndResource[
                "DocumentationToolsStrings", "Edit"]], BaseStyle -> 
               "TextAnnotationButton"]]], 
            StyleBox[
             RowBox[{
               DynamicBox[
                FEPrivate`FrontEndResource[
                "DocumentationToolsStrings", "LastAnnotator"]], "pavel"}], 
             "TextAnnotator"], 
            Cell[
             BoxData[
              ButtonBox[
               DynamicBox[
                FEPrivate`FrontEndResource[
                "DocumentationToolsStrings", "Delete"]], BaseStyle -> 
               "TextAnnotationRemoveButton"]]], ""}}, 
          GridBoxAlignment -> {
           "Columns" -> {Left, Left, Right, Right}, "Rows" -> {{Automatic}}}, 
          GridBoxItemSize -> {"Columns" -> {
              Scaled[0.15], 
              Scaled[0.68], 
              Scaled[0.15], 
              Scaled[0.02]}}]]], "\n"}], "TextAnnotation", 
     CellSize -> {590, Inherited}]}},
 CellTags->"TextAnnotation",
 CellID->242153935,ExpressionUUID->"3b479308-21ba-4678-b4f7-a7a43d45d70d"],

Cell["Every operation treats it as a scalar.", "Notes",ExpressionUUID->"b1892a89-063b-4feb-a5e4-200f4cf50f9f"],

Cell[TextData[{
 "Its symmetric degree is ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["ElementDegree"]], "paclet:ChernSimons/ref/ElementDegree", 
     "ChernSimons Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{"HBar", ",", " ", 
    StyleBox["pairing", "TI"], ",", " ", "\"\<Symmetric\>\""}], "]"}]], 
  "InlineFormula",ExpressionUUID->"1e33b11b-b914-4115-b6f3-65e57b40ad4e"],
 ", which is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", "(", 
    RowBox[{
     StyleBox["n", "TI"], "-", "3"}], ")"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"6f240f3a-f021-45b4-bf6b-de69ebff36b7"],
 ". It has no bar or exterior degree."
}], "Notes",ExpressionUUID->"1a00d900-1373-4718-b11a-347ed728608f"],

Cell[TextData[{
 "It is the weight of the bracket term in ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CanonicalBeilinsonDrinfeldOperator"]], 
    "paclet:ChernSimons/ref/CanonicalBeilinsonDrinfeldOperator", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "62182ebf-736d-43aa-89e8-ba5a40db8662"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalDelta]", "\[LongEqual]", 
    RowBox[{
     SubscriptBox[
      OverscriptBox[
       StyleBox["q", "TI"], "^"], 
      RowBox[{"1", ",", "1", ",", "0"}]], "+", 
     SubscriptBox[
      OverscriptBox[
       StyleBox["q", "TI"], "^"], 
      RowBox[{"1", ",", "2", ",", "0"}]], "+", 
     RowBox[{"\[HBar]", " ", 
      SubscriptBox[
       OverscriptBox[
        StyleBox["q", "TI"], "^"], 
       RowBox[{"2", ",", "1", ",", "0"}]]}]}]}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"68283d97-7cfc-4e4f-b261-9e1ac5c27693"],
 "."
}], "Notes",ExpressionUUID->"1012cc0b-e5b8-4721-a46c-1e64e3e8918c"],

Cell[TextData[{
 "In a BD action it is the weight ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[HBar]", 
    StyleBox["g", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "d6ca84a4-831b-4ad5-bf07-bfe0a394a520"],
 " of the genus-",
 Cell[BoxData[
  FormBox[
   StyleBox["g", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "13bb3631-0057-4c10-aa5d-9d1d8cf036ee"],
 " component."
}], "Notes",ExpressionUUID->"474af924-c722-4797-8935-cf2508eef4e0"],

Cell[TextData[{
 "The BD formalism never inverts it. Negative powers appear only in the \
localized BV picture, where the BV action is ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[HBar]", 
    RowBox[{"-", "1"}]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "2c976dac-c370-49a0-9056-be4f3c12b1d0"],
 " times the BD one."
}], "Notes",ExpressionUUID->"fa9f3a9c-6a50-4f57-b6b9-8333a866ef17"],

Cell[TextData[{
 "It displays as ",
 Cell[BoxData[
  FormBox["\[HBar]", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "decbcbae-8758-4289-bc39-ef2d3ff3df56"],
 "."
}], "Notes",ExpressionUUID->"7908ae2c-08d8-4aef-9d3e-45feab853e85"]
}, Open  ]],

