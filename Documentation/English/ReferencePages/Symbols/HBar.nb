Cell["\<\
It appears in the operator of the Beilinson-Drinfeld algebra:\
\>", "ExampleText",ExpressionUUID->"bb0f28ac-145b-46b3-ad9a-b0be8f19a672"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"StringBeilinsonDrinfeldOperator", "[", 
  RowBox[{
   RowBox[{"SymmetricProduct", "[", 
    RowBox[{
     RowBox[{"CyclicWord", "[", 
      RowBox[{"{", 
       RowBox[{"x", ",", " ", "y", ",", " ", "y", ",", " ", "y"}], "}"}], 
      "]"}], ",", " ", 
     RowBox[{"CyclicWord", "[", 
      RowBox[{"{", 
       RowBox[{"x", ",", " ", "y"}], "}"}], "]"}], ",", " ", "pairing"}], 
    "]"}], ",", " ", "pairing"}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"b1a8e7f2-affa-407d-ae84-c3f1b62ac0d8"],

Cell[BoxData[
 RowBox[{
  RowBox[{"2", " ", 
   InterpretationBox["\[HBar]",
    ChernSimons`HBar,
    Editable->False], " ", 
   InterpretationBox[
    RowBox[{"(", 
     RowBox[{
     "x", "\[ThinSpace]", "y", "\[ThinSpace]", "y", "\[ThinSpace]", "y"}], 
     ")"}],
    ChernSimons`CyclicWord[{
     MTNB$fjhh89ncfgzh`x, MTNB$fjhh89ncfgzh`y, MTNB$fjhh89ncfgzh`y, 
      MTNB$fjhh89ncfgzh`y}],
    Editable->False]}], "-", 
  InterpretationBox[
   RowBox[{
    InterpretationBox[
     RowBox[{"(", "y", ")"}],
     ChernSimons`CyclicWord[{MTNB$fjhh89ncfgzh`y}],
     Editable->False], "\[CircleDot]", 
    InterpretationBox[
     RowBox[{"(", "y", ")"}],
     ChernSimons`CyclicWord[{MTNB$fjhh89ncfgzh`y}],
     Editable->False], "\[CircleDot]", 
    InterpretationBox[
     RowBox[{"(", 
      RowBox[{"x", "\[ThinSpace]", "y"}], ")"}],
     ChernSimons`CyclicWord[{MTNB$fjhh89ncfgzh`x, MTNB$fjhh89ncfgzh`y}],
     Editable->False]}],
   ChernSimons`SymmetricProduct[
    ChernSimons`CyclicWord[{MTNB$fjhh89ncfgzh`y}], 
