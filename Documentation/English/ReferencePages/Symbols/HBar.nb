Cell["\<\
It appears in the operator of the Beilinson-Drinfeld algebra:\
\>", "ExampleText",ExpressionUUID->"1bf36347-e57d-4aef-9a47-dd94ec7b845c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"CanonicalBeilinsonDrinfeldOperator", "[", 
  RowBox[{
   RowBox[{"SymmetricProduct", "[", 
    RowBox[{
     RowBox[{"CyclicWord", "[", 
      RowBox[{"{", 
       RowBox[{"x", ",", " ", "y", ",", " ", "y", ",", " ", "y"}], "}"}], 
      "]"}], ",", " ", 
     RowBox[{"CyclicWord", "[", 
      RowBox[{"{", 
       RowBox[{"x", ",", " ", "y"}], "}"}], "]"}], ",", " ", "pairing"}], 
    "]"}], ",", " ", "pairing"}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"7b056b20-6061-479a-a7c5-4b9eb2b65112"],

Cell[BoxData[
 RowBox[{
  RowBox[{"2", " ", 
   InterpretationBox["\[HBar]",
    ChernSimons`HBar,
    Editable->False], " ", 
   InterpretationBox[
    RowBox[{"(", 
     RowBox[{
     "x", "\[ThinSpace]", "y", "\[ThinSpace]", "y", "\[ThinSpace]", "y"}], 
     ")"}],
    ChernSimons`CyclicWord[{
     MTNB$qdqyuonvk7fn`x, MTNB$qdqyuonvk7fn`y, MTNB$qdqyuonvk7fn`y, 
      MTNB$qdqyuonvk7fn`y}],
    Editable->False]}], "-", 
  InterpretationBox[
   RowBox[{
    InterpretationBox[
     RowBox[{"(", "y", ")"}],
     ChernSimons`CyclicWord[{MTNB$qdqyuonvk7fn`y}],
     Editable->False], "\[CircleDot]", 
    InterpretationBox[
     RowBox[{"(", "y", ")"}],
     ChernSimons`CyclicWord[{MTNB$qdqyuonvk7fn`y}],
     Editable->False], "\[CircleDot]", 
    InterpretationBox[
     RowBox[{"(", 
      RowBox[{"x", "\[ThinSpace]", "y"}], ")"}],
     ChernSimons`CyclicWord[{MTNB$qdqyuonvk7fn`x, MTNB$qdqyuonvk7fn`y}],
     Editable->False]}],
   ChernSimons`SymmetricProduct[
