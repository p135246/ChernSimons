   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "acc33cd8-924f-4806-be9c-b22332f382c5"],
 "\[LineSeparator]",
 "is the formal variable ",
 Cell[BoxData[
  FormBox["\[HBar]", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "651e4fe9-1c61-4d27-abdb-ff2c6c1b897a"],
 " of the Beilinson-Drinfeld algebra.",
 "\n"
}], "Usage",ExpressionUUID->"6ba0eb68-d664-4cae-a542-14fa98ba5fe4"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["HBar"]], "paclet:ChernSimons/ref/HBar", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "400e2379-b092-43f9-940d-fae294c1d026"],
 " is a symbol with no value."
}], "Notes",
 CellFrameLabels->{{Inherited, Inherited}, {Inherited, 
    Cell[
     TextData[{
      "26.09.30: Design review - HBar is an ordinary symbol with no value, by \
design the one export of the paclet that carries none; it was the engine's \
hbar until T0b. Every operation treats it as a scalar through the scalar \
tests of its linearity rules, and it has even degree, so it never enters a \
Koszul sign. Its degree is given by ElementDegree in the symmetric grading \
only, 2(n - 3), the degree that makes the operator homogeneous of degree -1; \
in the other two gradings it returns unevaluated, a decision of R5f kept by \
Pavel. The verification suites load their engine after the paclet, so the \
engine's HBar is this symbol. Prior art: in the Wolfram Language the \
character \\[HBar] is a letter that makes an ordinary symbol of the current \
context, with no built-in meaning.", "\n\n", 
       Cell[
        BoxData[
         GridBox[{{
            Cell[
             BoxData[
              ButtonBox[
               DynamicBox[
                FEPrivate`FrontEndResource[
                "DocumentationToolsStrings", "Edit"]], BaseStyle -> 
               "TextAnnotationButton"]]], 
            StyleBox[
             RowBox[{
               DynamicBox[
                FEPrivate`FrontEndResource[
                "DocumentationToolsStrings", "LastAnnotator"]], "pavel"}], 
             "TextAnnotator"], 
            Cell[
             BoxData[
              ButtonBox[
               DynamicBox[
                FEPrivate`FrontEndResource[
                "DocumentationToolsStrings", "Delete"]], BaseStyle -> 
               "TextAnnotationRemoveButton"]]], ""}}, 
          GridBoxAlignment -> {
           "Columns" -> {Left, Left, Right, Right}, "Rows" -> {{Automatic}}}, 
          GridBoxItemSize -> {"Columns" -> {
              Scaled[0.15], 
              Scaled[0.68], 
              Scaled[0.15], 
              Scaled[0.02]}}]]], "\n"}], "TextAnnotation", 
     CellSize -> {590, Inherited}]}},
 CellTags->"TextAnnotation",
 CellID->685049998,ExpressionUUID->"d06bb05c-634e-4b6f-8dd6-8b52c8169c90"],

Cell["Every operation treats it as a scalar.", "Notes",ExpressionUUID->"c363d9e0-81ce-4779-aa67-0ff45157cdc4"],

Cell[TextData[{
 "Its symmetric degree is ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["ElementDegree"]], "paclet:ChernSimons/ref/ElementDegree", 
     "ChernSimons Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{"HBar", ",", " ", 
    StyleBox["pairing", "TI"], ",", " ", "\"\<Symmetric\>\""}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "befe52f3-f9d5-4582-9c32-d67af2e2ef18"],
 ", which is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", "(", 
    RowBox[{
     StyleBox["n", "TI"], "-", "3"}], ")"}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ff5fb625-c6b3-4b23-9c83-9f4a315887af"],
 ". It has no bar or exterior degree."
}], "Notes",ExpressionUUID->"50e5cc9d-55d6-40c0-a02f-43938d580950"],

Cell[TextData[{
 "It is the weight of the bracket term in ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["StringBeilinsonDrinfeldOperator"]], 
    "paclet:ChernSimons/ref/StringBeilinsonDrinfeldOperator", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "c83a04ce-62a1-4456-b977-e2da50781660"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalDelta]", "\[LongEqual]", 
    SubscriptBox[
     OverscriptBox[
      StyleBox["q", "TI"], "^"], 
     RowBox[{"1", ",", "1", ",", "0"}]], "+", 
    SubscriptBox[
     OverscriptBox[
      StyleBox["q", "TI"], "^"], 
     RowBox[{"1", ",", "2", ",", "0"}]], "+", 
    RowBox[{"\[HBar]", " "}], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["q", "TI"], "^"], 
     RowBox[{"2", ",", "1", ",", "0"}]]}], TraditionalForm]], "InlineFormula",
  
  FontSize->0.9 Inherited,ExpressionUUID->
  "cdbc51fe-9d8e-4417-9739-142162795740"],
 "."
}], "Notes",ExpressionUUID->"1023016b-7a72-4e5b-932c-9e4f3c1b4cb0"],

Cell[TextData[{
 "In a BD action it is the weight ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[HBar]", 
    StyleBox["g", "TI"]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e2e18a3e-a15d-474f-b309-049eb1f63636"],
 " of the genus-",
 Cell[BoxData[
  FormBox[
