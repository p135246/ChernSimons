     ChernSimons`CyclicWord[{MTNB$167ez6acbpe8m`y}]],
    Editable->False]}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"d71d03e7-370d-4651-9d6a-f1d80d1ab82a"]
