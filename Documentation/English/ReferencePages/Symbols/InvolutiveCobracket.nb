Notebook[{

Cell[CellGroupData[{
Cell["InvolutiveCobracket", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"da402890-309c-41d5-9657-4890c2b844e9"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InvolutiveCobracket"]], 
     "paclet:ChernSimons/ref/InvolutiveCobracket", 
     "ChernSimons Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["w", "TI"], ",", " ", 
    StyleBox["pairing", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7759e935-ec97-4b25-8ae7-a7f00cfef832"],
 "\[LineSeparator]",
 "gives the co-bracket of a cyclic word ",
 StyleBox["w", "TI"],
 ", a product of two words, in the convention carried by ",
 StyleBox["pairing", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"474ff40c-7f6c-472f-8ce7-ca377412dd85"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InvolutiveCobracket"]], 
     "paclet:ChernSimons/ref/InvolutiveCobracket", 
     "ChernSimons Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["p", "TI"], ",", " ", 
    StyleBox["pairing", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3132d675-c01a-46f7-a737-66834b19b8e9"],
 "\[LineSeparator]",
 "applies the extension of the co-bracket as a co-derivation to a product ",
 StyleBox["p", "TI"],
 "."
}], "Usage",ExpressionUUID->"bdecdaae-5c67-4ed8-8db0-cea95e153ac2"],

Cell[TextData[{
 "The co-bracket is the operation ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["q", "TI"], 
    RowBox[{"1", ",", "2", ",", "0"}]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "698aae16-86e7-4232-a9e5-66d0e4c839fe"],
 " of the involutive bi-Lie structure: it takes one cyclic word and returns a \
product of two, cutting the word at a pair of positions and contracting the \
two removed particles against the pairing."
}], "Notes",ExpressionUUID->"b027ab27-a2bf-4261-9f0a-6c0d2def67ab"],

Cell[TextData[{
 "The convention key of ",
 StyleBox["pairing", "TI"],
 " selects the picture: the result is a ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SymmetricProduct"]], "paclet:ChernSimons/ref/SymmetricProduct",
     "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "bfa190d6-9ceb-4e0d-991f-dd3829d10ca8"],
 " under ",
 Cell[BoxData["\"\<Symmetric\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c7092862-a24a-4fb9-8055-025b3e9eaf57"],
 " and an ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ExteriorProduct"]], "paclet:ChernSimons/ref/ExteriorProduct", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "8572e419-d13b-4808-9883-1cf71eac6485"],
 " under ",
 Cell[BoxData["\"\<Exterior\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7e3e933b-d5c6-4a45-8b1b-75bfe9d86df7"],
 "."
}], "Notes",ExpressionUUID->"bad7db81-5b2d-4ccd-9ac7-19b95e1d4488"],

Cell[TextData[{
 "A word too short to be cut in two, or one whose cuts all cancel, has \
co-bracket ",
 Cell[BoxData[
  FormBox["0", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "45e13906-e608-4e03-b8f2-1f4b1ce6cf87"],
 ". Over the alphabet of the circle the first nonzero co-bracket appears in \
length ",
 Cell[BoxData[
  FormBox["4", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "45844a21-3ce1-444c-bacf-74a257c9fac3"],
 "."
}], "Notes",ExpressionUUID->"cbd456f2-be87-4610-a92b-a29a5c14450a"],

Cell[TextData[{
 "On a product the result is the co-derivation extension ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    OverscriptBox[
     StyleBox["q", "TI"], "^"], 
    RowBox[{"1", ",", "2", ",", "0"}]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a70200b8-0c13-4aaa-8ad8-6191e6c7e473"],
 ": the co-bracket is applied to each factor in turn, with the Koszul sign of \
the shuffle. The extension raises the number of factors by one. On a single \
cyclic word the extension is the co-bracket itself, so there is one function \
here and not two."
}], "Notes",ExpressionUUID->"73d06a43-ba1f-4230-972c-bb75136cf09b"],

Cell["\<\
The extension is linear in its argument: it distributes over sums and pulls \
scalars out. That is what lets it be composed, with the products, whose \
normalized form carries a sign whenever the factors have to be reordered, and \
with itself.\
\>", "Notes",ExpressionUUID->"b8e6385c-54bb-4dda-b46b-3d909c9aa487"],

Cell[TextData[{
 "The co-bracket is one half of the sum of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ChordContraction"]], "paclet:ChernSimons/ref/ChordContraction",
     "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "09cdc167-8910-499f-8cb2-8640a16e5730"],
 " over every ordered pair of distinct positions. A word may be given as the \
list of its particles."
}], "Notes",ExpressionUUID->"fa68d52f-5e9c-4946-bb4f-ed1c54825bf8"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "394db5db-5444-45ce-8109-e19cfc39639f"], Cell["option", "TableText",
     FontWeight->Bold,ExpressionUUID->"54bf701f-849b-44e4-90aa-b48cc30310de"],
