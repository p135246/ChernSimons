Cell[CellGroupData[{

Cell[BoxData[
 InterpretationBox[Cell[
  "\t", "ExampleDelimiter",ExpressionUUID->
   "6aed56e4-b09c-429f-8623-74e306a57b3a"],
  $Line = 0; Null]], "ExampleDelimiter",ExpressionUUID->"db34d172-3485-49e2-\
b6c3-93a88f93e85b"],

Cell["\<\
Because the extension is linear it may be applied twice, and the co-Jacobi \
identity is the statement that doing so gives zero. The intermediate result \
is a signed product, so this composition is exactly what linearity buys:\
\>", "ExampleText",ExpressionUUID->"3a5c73bc-ae70-4464-a3cf-637a3223421c"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"pairing", " ", "=", " ", 
   RowBox[{"GradedPairing", "[", 
    RowBox[{
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"x", " ", "->", " ", 
        RowBox[{"-", "1"}]}], ",", " ", 
       RowBox[{"y", " ", "->", " ", "0"}]}], "|>"}], ",", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "y"}], "}"}], " ", "->", " ", "1"}], "|>"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"w", " ", "=", " ", 
   RowBox[{"CyclicWord", "[", 
    RowBox[{"{", 
     RowBox[{
     "x", ",", " ", "y", ",", " ", "y", ",", " ", "y", ",", " ", "y"}], "}"}],
     "]"}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"InvolutiveCobracket", "[", 
    RowBox[{"w", ",", " ", "pairing"}], "]"}], ",", " ", 
   RowBox[{"InvolutiveCobracket", "[", 
    RowBox[{
     RowBox[{"InvolutiveCobracket", "[", 
      RowBox[{"w", ",", " ", "pairing"}], "]"}], ",", " ", "pairing"}], 
    "]"}]}], "}"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"3db49bab-4b71-4f29-816c-fa14e65e0aff"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    RowBox[{"-", "2"}], " ", 
    InterpretationBox[
     RowBox[{
      InterpretationBox[
       RowBox[{"(", "y", ")"}],
       ChernSimons`CyclicWord[{MTNB$167ez6acbpe8m`y}],
       Editable->False], "\[CircleDot]", 
      InterpretationBox[
       RowBox[{"(", 
        RowBox[{"y", "\[ThinSpace]", "y"}], ")"}],
       ChernSimons`CyclicWord[{MTNB$167ez6acbpe8m`y, MTNB$167ez6acbpe8m`y}],
       Editable->False]}],
     ChernSimons`SymmetricProduct[
      ChernSimons`CyclicWord[{MTNB$167ez6acbpe8m`y}], 
      ChernSimons`CyclicWord[{MTNB$167ez6acbpe8m`y, MTNB$167ez6acbpe8m`y}]],
     Editable->False]}], ",", "0"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"9f55939e-6d8b-4968-896f-a23c752399c6"]
}, Open  ]]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 InterpretationBox[Cell[
  "Possible Issues", "ExampleSection",ExpressionUUID->
   "dda06a82-eb41-4b48-8510-6cb821647761"],
  $Line = 0; Null]], "ExampleSection",
 CellID->1305812373,ExpressionUUID->"9397dd0b-9de4-443a-9371-be2b75148f2f"],

Cell[TextData[{
 StyleBox["The convention of ",
  FontWeight->"Bold"],
 StyleBox["pairing", "TI",
  FontWeight->"Bold"],
 StyleBox[" must match the head of the product.",
  FontWeight->"Bold"],
 " The extension is defined for a ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SymmetricProduct"]], "paclet:ChernSimons/ref/SymmetricProduct",
     "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "1266b926-5603-4838-b624-e1084a2660f5"],
 " under ",
 Cell[BoxData["\"\<Symmetric\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f7c32f20-abf4-40df-9b1d-65c4c92ba0c9"],
 " and for an ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ExteriorProduct"]], "paclet:ChernSimons/ref/ExteriorProduct", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "aa292f50-017f-4c59-8582-788083163c1a"],
 " under ",
 Cell[BoxData["\"\<Exterior\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "65165c94-9cca-483a-a38a-ca2ce046abf3"],
 ", so handing one to the other leaves the call unevaluated instead of \
returning a product of cyclic words. Rebuild the product with the pairing it \
is to be used with."
}], "ExampleText",ExpressionUUID->"26e80e87-6772-4268-9f90-7c1ac307d7e9"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"pairing", " ", "=", " ", 
   RowBox[{"GradedPairing", "[", 
    RowBox[{
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"x", " ", "->", " ", 
        RowBox[{"-", "1"}]}], ",", " ", 
       RowBox[{"y", " ", "->", " ", "0"}]}], "|>"}], ",", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "y"}], "}"}], " ", "->", " ", "1"}], "|>"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"exterior", " ", "=", " ", 
   RowBox[{"Append", "[", 
    RowBox[{"pairing", ",", " ", 
     RowBox[{"\"\<Convention\>\"", " ", "->", " ", "\"\<Exterior\>\""}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{"Head", "[", 
  RowBox[{"InvolutiveCobracket", "[", 
   RowBox[{
    RowBox[{"SymmetricProduct", "[", 
     RowBox[{
      RowBox[{"CyclicWord", "[", 
       RowBox[{"{", "y", "}"}], "]"}], ",", " ", 
      RowBox[{"CyclicWord", "[", 
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "y", ",", " ", "y", ",", " ", "y"}], "}"}], 
       "]"}], ",", " ", "pairing"}], "]"}], ",", " ", "exterior"}], "]"}], 
  "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"a6de2c43-afa5-41f0-b7f5-79b6893d7fa2"],

Cell[BoxData["InvolutiveCobracket"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"db882caf-82a4-4cba-99d1-db3ced024f0b"]
