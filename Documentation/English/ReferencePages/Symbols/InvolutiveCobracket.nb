     "5c8afc17-4ef1-4132-a032-e7fc81ea6c28"], Cell[TextData[{
     "whether a cut next to a contracted particle is kept, with the empty \
word ",
     Cell[BoxData[
      RowBox[{
       TemplateBox[{
         Cell[
          TextData["CyclicWord"]], "paclet:ChernSimons/ref/CyclicWord", 
         "ChernSimons Package Symbol"},
        "PackageLink",
        BaseStyle->"InlineFormula"], "[", 
       RowBox[{"{", "}"}], "]"}]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "41ec3d13-98c4-453f-a161-4dd0deb614c8"],
     " as its empty arc, rather than dropped"
    }], "TableText",ExpressionUUID->"3ce341fa-6dc8-47df-98de-373a8771ab3c"]}
  }]], "3ColumnTableMod",ExpressionUUID->"3765a8c3-bc23-40ae-9a85-\
0e834f7b7fb3"],

Cell[TextData[{
 "Without the option only cuts with two nonempty arcs count, which is the \
positive-length convention of the paper. With it the co-bracket is that of \
the empty-word extension; the co-bracket of the empty word itself is ",
 Cell[BoxData[
  FormBox["0", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "59ee8263-2d59-4f86-bd06-094610fc5d0a"],
 " in both conventions."
}], "Notes",ExpressionUUID->"3e2e7e9d-bb59-45b8-93c7-9b1be777a8c9"],

Cell[TextData[{
 "The identities the co-bracket satisfies are the business of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CoJacobiObstruction"]], 
    "paclet:ChernSimons/ref/CoJacobiObstruction", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "c2429b79-5df9-4456-a9ed-e1701ee1d37c"],
 ", ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DrinfeldObstruction"]], 
    "paclet:ChernSimons/ref/DrinfeldObstruction", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "bf1864e6-d438-475f-8b6d-c40bbcff2400"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InvolutivityObstruction"]], 
    "paclet:ChernSimons/ref/InvolutivityObstruction", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "d60cb4e3-566c-4a07-9ad5-76667cee5e61"],
 "."
}], "Notes",ExpressionUUID->"03262e73-56c5-4d34-8866-a1c30e4983f1"]
}, Open  ]],

