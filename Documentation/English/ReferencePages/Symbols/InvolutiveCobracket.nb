Cell[TextData[{
 "The same computation in the exterior picture, where the answer lands in an ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ExteriorProduct"]], "paclet:ChernSimons/ref/ExteriorProduct", 
    "ChernSimons Package Symbol"},
   "PackageLink",
