Cell["\<\
The first nonzero co-bracket over the alphabet of the circle:\
\>", "ExampleText",ExpressionUUID->"d2ceb580-635b-4b1c-8f1c-b91ad0ca0407"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"InvolutiveCobracket", "[", 
  RowBox[{
   RowBox[{"CyclicWord", "[", 
    RowBox[{"{", 
     RowBox[{"x", ",", " ", "y", ",", " ", "y", ",", " ", "y"}], "}"}], "]"}],
    ",", " ", 
   RowBox[{"GradedPairing", "[", 
    RowBox[{
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"x", " ", "->", " ", 
        RowBox[{"-", "1"}]}], ",", " ", 
       RowBox[{"y", " ", "->", " ", "0"}]}], "|>"}], ",", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "y"}], "}"}], " ", "->", " ", "1"}], "|>"}]}], 
    "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"8f617ecb-551c-4d93-aff4-9810ebf868bd"],

Cell[BoxData[
 RowBox[{"-", 
  InterpretationBox[
   RowBox[{
    InterpretationBox[
     RowBox[{"(", "y", ")"}],
     ChernSimons`CyclicWord[{MTNB$167ez6acbpe8m`y}],
     Editable->False], "\[CircleDot]", 
    InterpretationBox[
     RowBox[{"(", "y", ")"}],
     ChernSimons`CyclicWord[{MTNB$167ez6acbpe8m`y}],
     Editable->False]}],
   ChernSimons`SymmetricProduct[
    ChernSimons`CyclicWord[{MTNB$167ez6acbpe8m`y}], 
    ChernSimons`CyclicWord[{MTNB$167ez6acbpe8m`y}]],
   Editable->False]}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"a42b92c3-da46-4860-a318-fc1c0fc3135e"]
}, Open  ]],

