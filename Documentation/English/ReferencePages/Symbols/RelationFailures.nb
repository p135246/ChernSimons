   "d5715ee2-1cae-4f33-89b2-0e99ea9caa6e"],
  $Line = 0; Null]], "ExampleSection",
 CellID->258228157,ExpressionUUID->"1cd6234d-1e3c-431d-9989-71f3025eee95"],

Cell[CellGroupData[{

Cell[BoxData[
 InterpretationBox[Cell[
  "Properties & Relations", "ExampleSection",ExpressionUUID->
   "d18b1e1f-4c4c-49a5-bb54-1e5e145ddf4e"],
  $Line = 0; Null]], "ExampleSection",
 CellID->2123667759,ExpressionUUID->"0e0d5f37-f3c9-4474-a22b-9f10dcc8b438"],

Cell[TextData[{
 "The arity of the tuples comes from ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["$Relations"]], "paclet:IBLInfinity/ref/$Relations", 
    "IBLInfinity Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "7460afdd-9458-4ede-be26-4c8ee044870b"],
 ", which is why a one-word identity and a three-word one are swept by the \
same call:"
}], "ExampleText",ExpressionUUID->"b15d8458-7960-420d-96e3-53acff5c42aa"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Normal", "[", 
  RowBox[{"Map", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"#", "[", "\"\<Arity\>\"", "]"}], " ", "&"}], ",", " ", 
    "$Relations"}], "]"}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"40246fc4-2951-4397-b490-1e06738fc20d"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\<\"Jacobi\"\>", "\[Rule]", "3"}], ",", 
   RowBox[{"\<\"CoJacobi\"\>", "\[Rule]", "1"}], ",", 
   RowBox[{"\<\"Drinfeld\"\>", "\[Rule]", "2"}], ",", 
   RowBox[{"\<\"Involutivity\"\>", "\[Rule]", "1"}]}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"f8d9cb0e-e19f-4b08-949f-78c2d394f1c1"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 InterpretationBox[Cell[
  "\t", "ExampleDelimiter",ExpressionUUID->
   "141fcc92-edde-4a85-88bc-4601f8086bd9"],
  $Line = 0; Null]], "ExampleDelimiter",ExpressionUUID->"55460da9-6f84-44c6-\
b788-f87145dd74ca"],

Cell["\<\
A failure would be reported as the tuple itself, so a nonempty result is \
directly re-runnable through the obstruction function:\
\>", "ExampleText",ExpressionUUID->"e321deea-6a37-41f6-be1b-08419349ca08"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"pairing", " ", "=", " ", 
   RowBox[{"Pairing", "[", 
    RowBox[{
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"x", " ", "->", " ", 
        RowBox[{"-", "1"}]}], ",", " ", 
       RowBox[{"y", " ", "->", " ", "0"}]}], "|>"}], ",", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "y"}], "}"}], " ", "->", " ", "1"}], "|>"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Map", "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"$Relations", "[", "\"\<Involutivity\>\"", "]"}], 
       "[", "\"\<Function\>\"", "]"}], "[", 
      RowBox[{"#", ",", " ", "pairing"}], "]"}], " ", "&"}], ",", " ", 
    RowBox[{"CyclicWords", "[", 
     RowBox[{"4", ",", " ", "pairing", ",", " ", 
      RowBox[{"\"\<UpTo\>\"", " ", "->", " ", "True"}]}], "]"}]}], "]"}], " ",
   "//", " ", "Union"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"c65cd50e-8eac-4dcf-a24a-65e5b213b123"],

Cell[BoxData[
 RowBox[{"{", "0", "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"ae799f5a-ac12-4e69-beaa-fa79dd596964"]
}, Open  ]]
}, Open  ]]
}, Open  ]],

