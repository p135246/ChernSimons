Cell["The same sweep in the exterior picture:", "ExampleText",ExpressionUUID->"8266b6e4-ed28-4e24-a44b-02b6d8c5e28e"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"exterior", " ", "=", " ", 
   RowBox[{"Append", "[", 
    RowBox[{
     RowBox[{"Pairing", "[", 
      RowBox[{
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"x", " ", "->", " ", 
          RowBox[{"-", "1"}]}], ",", " ", 
         RowBox[{"y", " ", "->", " ", "0"}]}], "|>"}], ",", " ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"x", ",", " ", "y"}], "}"}], " ", "->", " ", "1"}], 
        "|>"}]}], "]"}], ",", " ", 
     RowBox[{"\"\<Convention\>\"", " ", "->", " ", "\"\<Exterior\>\""}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{"Map", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"#", " ", "->", " ", 
     RowBox[{"RelationFailures", "[", 
      RowBox[{"#", ",", " ", "exterior", ",", " ", "3"}], "]"}]}], " ", "&"}],
    ",", " ", 
   RowBox[{"Keys", "[", "$Relations", "]"}]}], "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"b31b277c-3b77-4a75-9721-1a65ed938792"],

