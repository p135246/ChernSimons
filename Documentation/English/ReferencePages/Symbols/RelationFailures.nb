Cell[CellGroupData[{
Cell["RelationFailures", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"0f1dbc50-04f1-4c82-95d0-b503e0227800"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RelationFailures"]], 
     "paclet:IBLInfinity/ref/RelationFailures", "IBLInfinity Package Symbol"},
    
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["name", "TI"], ",", " ", 
    StyleBox["pairing", "TI"], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ad40f961-b1bb-4bc0-8db1-2382bccf8e9e"],
 "\[LineSeparator]",
 "returns the tuples of cyclic words of length at most ",
 StyleBox["n", "TI"],
 " on which the named identity fails. An empty list means it holds throughout \
the range.",
 "\n"
}], "Usage",ExpressionUUID->"58ad7142-ed67-4e6d-af46-ed639cb7e0f3"],

Cell[TextData[{
 StyleBox["name", "TI"],
 " is one of the keys of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["$Relations"]], "paclet:IBLInfinity/ref/$Relations", 
    "IBLInfinity Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "42b57d2c-670b-41a9-88cd-715cbefce143"],
 " \[LongDash] ",
 Cell[BoxData["\"\<Jacobi\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1dc4066a-0d7a-4398-b68a-b882ec6e9be3"],
 ", ",
 Cell[BoxData["\"\<CoJacobi\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d2a419cd-7c26-478d-a128-449ca34055b7"],
 ", ",
 Cell[BoxData["\"\<Drinfeld\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "00bbef8f-4e7d-4f8d-9c6d-a0bd2272d415"],
 " or ",
 Cell[BoxData["\"\<Involutivity\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "18a2ee82-df22-4c44-ac87-c214822e5c19"],
 "."
}], "Notes",ExpressionUUID->"7f79bfe0-7cdf-4c98-a7f8-12b448b9ba0c"],

Cell[TextData[{
 "The sweep runs over ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["CyclicWords"]], "paclet:IBLInfinity/ref/CyclicWords", 
     "IBLInfinity Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["n", "TI"], ",", " ", 
    StyleBox["pairing", "TI"], ",", " ", 
    RowBox[{"\"\<UpTo\>\"", " ", "->", " ", 
     ButtonBox["True",
      BaseStyle->"Link"]}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7d503bc6-6160-4b3e-92d4-61684a6963af"],
 ", taking tuples of the arity the entry records, and keeps those whose \
obstruction does not expand to ",
 Cell[BoxData["0"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a58d1a35-b4da-40be-a3ec-cae358664f3f"],
 "."
}], "Notes",ExpressionUUID->"2d06ca14-f6b6-4a73-a0c4-4d2840e3667b"],

Cell[TextData[{
 "The convention key of ",
 StyleBox["pairing", "TI"],
 " selects the picture, so an identity can be checked in the symmetric and \
the exterior picture separately."
}], "Notes",ExpressionUUID->"d797145e-b695-4804-97af-4793207640e1"],

Cell[TextData[{
 StyleBox["The empty list is a truncated statement, not a proof.",
  FontWeight->"Bold"],
 " It says the identity holds on every tuple of words of length at most ",
 StyleBox["n", "TI"],
 ", and says nothing beyond that range. Any claim resting on it must state \
the ",
 StyleBox["n", "TI"],
 " it was checked at."
}], "Notes",ExpressionUUID->"c9a3ab47-3459-4805-9c40-b7e96542d7f3"],

Cell[TextData[{
 "The cost grows quickly: the number of tuples is the number of words up to \
length ",
 StyleBox["n", "TI"],
 " raised to the arity, so ",
 Cell[BoxData["\"\<Jacobi\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "38fc753d-095c-4576-a66a-2696d3cce5af"],
 " at arity ",
 Cell[BoxData["3"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ff4ab54d-23f3-497e-87d4-fb0b8a7b7652"],
 " is the expensive one."
}], "Notes",ExpressionUUID->"054bed04-93cc-48b5-8ec7-de1c68f6ddce"]
}, Open  ]],

