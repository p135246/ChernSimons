  "\t", "ExampleDelimiter",ExpressionUUID->
   "17e5c0d5-6be1-48cc-8983-bcdd3f1c9b8c"],
  $Line = 0; Null]], "ExampleDelimiter",ExpressionUUID->"116fb8a4-fda8-47c0-\
97cb-ec3ca723ad56"],

Cell["Sweeping all four at once over the same range:", "ExampleText",ExpressionUUID->"5a2f3924-151a-4de3-8172-3cd0e9ae1c3f"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"pairing", " ", "=", " ", 
   RowBox[{"GradedPairing", "[", 
    RowBox[{
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"x", " ", "->", " ", 
        RowBox[{"-", "1"}]}], ",", " ", 
       RowBox[{"y", " ", "->", " ", "0"}]}], "|>"}], ",", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "y"}], "}"}], " ", "->", " ", "1"}], "|>"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{"Normal", "[", 
  RowBox[{"Map", "[", 
   RowBox[{
    RowBox[{"e", " ", "|->", " ", 
     RowBox[{"DeleteDuplicates", "[", 
      RowBox[{"Map", "[", 
       RowBox[{
        RowBox[{"t", " ", "|->", " ", 
         RowBox[{"Expand", "[", 
          RowBox[{
           RowBox[{"e", "[", "\"\<Function\>\"", "]"}], " ", "@@", " ", 
           RowBox[{"Append", "[", 
            RowBox[{"t", ",", " ", "pairing"}], "]"}]}], "]"}]}], ",", "\n", 
        "   ", 
        RowBox[{"Tuples", "[", 
         RowBox[{
          RowBox[{"CyclicWords", "[", 
           RowBox[{"3", ",", " ", "pairing", ",", " ", 
            RowBox[{"\"\<UpTo\>\"", " ", "->", " ", "True"}]}], "]"}], ",", 
          " ", 
          RowBox[{"e", "[", "\"\<Arity\>\"", "]"}]}], "]"}]}], "]"}], "]"}]}],
     ",", " ", "$DefiningIdentities"}], "]"}], "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"621804bb-b3b0-4b52-8513-5fd5d559f846"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\<\"JacobiObstruction\"\>", "\[Rule]", 
    RowBox[{"{", "0", "}"}]}], ",", 
   RowBox[{"\<\"CoJacobiObstruction\"\>", "\[Rule]", 
    RowBox[{"{", "0", "}"}]}], ",", 
   RowBox[{"\<\"DrinfeldObstruction\"\>", "\[Rule]", 
    RowBox[{"{", "0", "}"}]}], ",", 
   RowBox[{"\<\"InvolutivityObstruction\"\>", "\[Rule]", 
    RowBox[{"{", "0", "}"}]}]}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"e556f2c6-1206-4a56-89b9-9ac4b253cf7a"]
}, Open  ]]
}, Open  ]]
}, Open  ]],

