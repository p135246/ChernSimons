Cell["\<\
Each entry can be applied directly, arity words then the pairing object:\
\>", "ExampleText",ExpressionUUID->"586d51b0-7722-43de-9aea-800a8d9868e2"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"pairing", " ", "=", " ", 
   RowBox[{"GradedPairing", "[", 
    RowBox[{
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"x", " ", "->", " ", 
        RowBox[{"-", "1"}]}], ",", " ", 
       RowBox[{"y", " ", "->", " ", "0"}]}], "|>"}], ",", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "y"}], "}"}], " ", "->", " ", "1"}], "|>"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"$DefiningIdentities", "[", "\"\<CoJacobiObstruction\>\"", "]"}], 
   "[", "\"\<Function\>\"", "]"}], "[", 
  RowBox[{
   RowBox[{"CyclicWord", "[", 
    RowBox[{"{", 
     RowBox[{"x", ",", " ", "y", ",", " ", "y", ",", " ", "y"}], "}"}], "]"}],
    ",", " ", "pairing"}], "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"67023566-b2c5-4a36-8aef-53b253b43abf"],

Cell[BoxData["0"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"41f3d9f5-dfab-4515-8d11-82ee3ad7406b"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
