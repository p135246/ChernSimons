"ExampleText",ExpressionUUID->"1a9c5bea-f4c6-4bae-ade1-df81c2876d17"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Relations", "[", 
  RowBox[{"CanonicalLieBialgebra", "[", 
   RowBox[{"GradedPairing", "[", 
    RowBox[{
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"x", " ", "->", " ", 
        RowBox[{"-", "1"}]}], ",", " ", 
       RowBox[{"y", " ", "->", " ", "0"}]}], "|>"}], ",", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "y"}], "}"}], " ", "->", " ", "1"}], "|>"}]}], 
    "]"}], "]"}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"f87acf5e-6091-4efd-917d-8feca7a77b65"],

