Cell["A strictly associative algebra:", "ExampleText",ExpressionUUID->"8b7e7dc3-f562-4b65-a341-552c84f3097d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"assoc", " ", "=", " ", 
  RowBox[{"AInfinityAlgebra", "[", 
   RowBox[{
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"u", " ", "->", " ", 
       RowBox[{"-", "1"}]}], ",", " ", 
      RowBox[{"v", " ", "->", " ", 
       RowBox[{"-", "1"}]}]}], "|>"}], ",", " ", 
    RowBox[{"t", " ", "|->", " ", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", "t", "]"}], " ", "===", " ", "2"}], ",", " ", 
       RowBox[{"Switch", "[", 
        RowBox[{"t", ",", " ", 
         RowBox[{"{", 
          RowBox[{"u", ",", " ", "u"}], "}"}], ",", " ", "u", ",", " ", 
         RowBox[{"{", 
          RowBox[{"u", ",", " ", "v"}], "}"}], ",", " ", "v", ",", " ", 
         RowBox[{"{", 
          RowBox[{"v", ",", " ", "u"}], "}"}], ",", " ", "v", ",", " ", "_", ",",
          " ", "0"}], "]"}], ",", " ", "0"}], "]"}]}]}], "]"}]}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"1ef394ef-aa5a-4397-b283-bd7662a13e3f"],

