Cell[TextData[{
 "The last six relations are those of a complex with a product, and ",
 Cell[BoxData["\"\<Unit\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d09af139-01a4-41fb-a5b6-7c8078e524d1"],
 " requires ",
 Cell[BoxData[
  FormBox["1", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3450118d-5a4a-4920-8f30-70659858ab35"],
 " to be a basis element."
}], "Notes",ExpressionUUID->"1606317b-3565-44b9-9175-12465af39a6b"],

Cell[TextData[{
 "A decomposition ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["V", "TI"], "\[LongEqual]", 
    StyleBox["H", "TI"], "\[CirclePlus]", 
    StyleBox["im",
     FontSlant->"Plain"], " ", 
    StyleBox["d",
     FontSlant->"Plain"], "\[CirclePlus]", 
    StyleBox["C", "TI"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5cca170c-924e-4586-beac-1c993e658f74"],
 " has the relations of its complex and its own axioms, which are conditions \
on its parts in every degree rather than identities on arguments, so their \
arity is ",
 Cell[BoxData[
  FormBox["0", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "59e8c1d0-8a73-43df-8585-ee502c71b6d7"],
 ":"
}], "Notes",ExpressionUUID->"2bfbe35e-0eaf-4f5f-af53-07a540cf97be"],

