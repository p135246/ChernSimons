Cell[TextData[{
 "A test of every relation reads both halves of an entry, the name to give ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Obstruction"]], "paclet:ChernSimons/ref/Obstruction", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "f55fcad5-ab30-4a3e-85f2-11d689ab95f9"],
 " and the arity to build the tuples:"
}], "ExampleText",ExpressionUUID->"c363d54e-88f6-4657-ac45-94c0fc9fc78d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"KeyValueMap", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{"name", ",", " ", "arity"}], "}"}], " ", "|->", " ", 
    RowBox[{"name", " ", "->", " ", 
     RowBox[{"Union", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"t", " ", "|->", " ", 
         RowBox[{"Obstruction", "[", 
          RowBox[{"algebra", ",", " ", "name", ",", " ", "t"}], "]"}]}], 
        ")"}], " ", "/@", " ", 
       RowBox[{"Tuples", "[", 
        RowBox[{
         RowBox[{"GenerateCyclicWords", "[", 
          RowBox[{"3", ",", " ", "pairing", ",", " ", 
           RowBox[{"\"\<UpTo\>\"", " ", "->", " ", "True"}], ",", " ", 
           RowBox[{"\"\<EmptyWord\>\"", " ", "->", " ", "True"}]}], "]"}], ",",
          " ", "arity"}], "]"}]}], "]"}]}]}], ",", " ", 
   RowBox[{"Relations", "[", "algebra", "]"}]}], "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"fe220051-124c-4b8d-9440-143bb9f48e05"],

