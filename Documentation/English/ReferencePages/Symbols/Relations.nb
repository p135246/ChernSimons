 "A test of every relation reads both halves of an entry, the name to give ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Obstruction"]], "paclet:ChernSimons/ref/Obstruction", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "6efb7e3e-72f2-4332-a7d5-5eb5ecb38ecc"],
 " and the arity to build the tuples:"
}], "ExampleText",ExpressionUUID->"37b60bbf-c97f-442a-a602-2aeb7afc3cc0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"KeyValueMap", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{"name", ",", " ", "arity"}], "}"}], " ", "|->", " ", 
    RowBox[{"name", " ", "->", " ", 
     RowBox[{"Union", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"t", " ", "|->", " ", 
         RowBox[{"Obstruction", "[", 
          RowBox[{"algebra", ",", " ", "name", ",", " ", "t"}], "]"}]}], 
        ")"}], " ", "/@", " ", 
       RowBox[{"Tuples", "[", 
        RowBox[{
         RowBox[{"GenerateCyclicWords", "[", 
          RowBox[{"3", ",", " ", "pairing", ",", " ", 
           RowBox[{"\"\<UpTo\>\"", " ", "->", " ", "True"}], ",", " ", 
           RowBox[{"\"\<EmptyWord\>\"", " ", "->", " ", "True"}]}], "]"}], ",",
          " ", "arity"}], "]"}]}], "]"}]}]}], ",", " ", 
   RowBox[{"Relations", "[", "algebra", "]"}]}], "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"f2ed539d-ca43-400c-acde-d520f1e0d28e"],

