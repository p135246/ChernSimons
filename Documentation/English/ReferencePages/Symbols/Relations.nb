Cell[TextData[{
 "A test of every relation reads both halves of an entry, the name to give ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Obstruction"]], "paclet:ChernSimons/ref/Obstruction", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "7962ba88-9774-4356-9e8e-5249a5dab988"],
 " and the arity to build the tuples:"
}], "ExampleText",ExpressionUUID->"8bcb4681-53c3-4679-8a3c-966cfb9a519d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"KeyValueMap", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{"name", ",", " ", "arity"}], "}"}], " ", "|->", " ", 
    RowBox[{"name", " ", "->", " ", 
     RowBox[{"Union", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"t", " ", "|->", " ", 
         RowBox[{"Obstruction", "[", 
          RowBox[{"algebra", ",", " ", "name", ",", " ", "t"}], "]"}]}], 
        ")"}], " ", "/@", " ", 
       RowBox[{"Tuples", "[", 
        RowBox[{
         RowBox[{"GenerateCyclicWords", "[", 
          RowBox[{"3", ",", " ", "pairing", ",", " ", 
           RowBox[{"\"\<UpTo\>\"", " ", "->", " ", "True"}], ",", " ", 
           RowBox[{"\"\<EmptyWord\>\"", " ", "->", " ", "True"}]}], "]"}], ",",
          " ", "arity"}], "]"}]}], "]"}]}]}], ",", " ", 
   RowBox[{"Relations", "[", "algebra", "]"}]}], "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"ec148e58-2063-4614-a7b8-1ae5b4b12a35"],

