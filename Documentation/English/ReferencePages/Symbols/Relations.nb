Cell[TextData[{
 "The last six relations are those of a complex with a product, and ",
 Cell[BoxData["\"\<Unit\>\""], "InlineFormula",ExpressionUUID->
  "fcace47b-ce12-48fd-8e8f-8fd6b59e22bb"],
 " requires ",
 Cell[BoxData[
  FormBox["1", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "585975a2-3b78-4639-839a-77321286d748"],
 " to be a basis element."
}], "Notes",ExpressionUUID->"5395c215-d50f-4ddf-8ccc-b561e23a4fe1"],

Cell[TextData[{
 "A decomposition ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["V", "TI"], "\[LongEqual]", 
    StyleBox["H", "TI"], "\[CirclePlus]", 
    StyleBox["im",
     FontSlant->"Plain"], " ", 
    StyleBox["d",
     FontSlant->"Plain"], "\[CirclePlus]", 
    StyleBox["C", "TI"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "23493964-881a-4f94-bd99-62917d843c43"],
 " has the relations of its complex and its own axioms, which are conditions \
on its parts in every degree rather than identities on arguments, so their \
arity is ",
 Cell[BoxData[
  FormBox["0", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "3dc6f361-3fa9-49a6-a150-a18a2d145180"],
 ":"
}], "Notes",ExpressionUUID->"0e26ab95-6606-4e0f-831f-86a2d09d083f"],

