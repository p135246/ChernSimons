Cell[TextData[{
 "A test of every relation reads both halves of an entry, the name to give ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Obstruction"]], "paclet:ChernSimons/ref/Obstruction", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "df963f77-8d55-45f4-b606-03f5802572e2"],
 " and the arity to build the tuples:"
}], "ExampleText",ExpressionUUID->"59ecbaa3-c85e-404d-a8af-1eec31ef9b18"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"KeyValueMap", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{"name", ",", " ", "arity"}], "}"}], " ", "|->", " ", 
    RowBox[{"name", " ", "->", " ", 
     RowBox[{"Union", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"t", " ", "|->", " ", 
         RowBox[{"Obstruction", "[", 
          RowBox[{"algebra", ",", " ", "name", ",", " ", "t"}], "]"}]}], 
        ")"}], " ", "/@", " ", 
       RowBox[{"Tuples", "[", 
        RowBox[{
         RowBox[{"GenerateCyclicWords", "[", 
          RowBox[{"3", ",", " ", "pairing", ",", " ", 
           RowBox[{"\"\<UpTo\>\"", " ", "->", " ", "True"}], ",", " ", 
           RowBox[{"\"\<EmptyWord\>\"", " ", "->", " ", "True"}]}], "]"}], ",",
          " ", "arity"}], "]"}]}], "]"}]}]}], ",", " ", 
   RowBox[{"Relations", "[", "algebra", "]"}]}], "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"41feb1e6-c214-4d75-883d-df03a49c21af"],

