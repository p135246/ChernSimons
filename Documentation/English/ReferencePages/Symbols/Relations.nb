Cell["A strictly associative algebra:", "ExampleText",ExpressionUUID->"c744a922-4b5b-4961-95b9-665698f98175"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"assoc", " ", "=", " ", 
  RowBox[{"AInfinityAlgebra", "[", 
   RowBox[{
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"u", " ", "->", " ", 
       RowBox[{"-", "1"}]}], ",", " ", 
      RowBox[{"v", " ", "->", " ", 
       RowBox[{"-", "1"}]}]}], "|>"}], ",", " ", 
    RowBox[{"t", " ", "|->", " ", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", "t", "]"}], " ", "===", " ", "2"}], ",", " ", 
       RowBox[{"Switch", "[", 
        RowBox[{"t", ",", " ", 
         RowBox[{"{", 
          RowBox[{"u", ",", " ", "u"}], "}"}], ",", " ", "u", ",", " ", 
         RowBox[{"{", 
          RowBox[{"u", ",", " ", "v"}], "}"}], ",", " ", "v", ",", " ", 
         RowBox[{"{", 
          RowBox[{"v", ",", " ", "u"}], "}"}], ",", " ", "v", ",", " ", "_", ",",
          " ", "0"}], "]"}], ",", " ", "0"}], "]"}]}]}], "]"}]}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"84be9e47-78bd-4aee-a742-e7e4d6a83099"],

