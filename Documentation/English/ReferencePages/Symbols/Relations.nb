Cell["A strictly associative algebra:", "ExampleText",ExpressionUUID->"c96e4234-d88c-4e40-b547-c9cba49f1361"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"assoc", " ", "=", " ", 
  RowBox[{"AInfinityAlgebra", "[", 
   RowBox[{
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"u", " ", "->", " ", 
       RowBox[{"-", "1"}]}], ",", " ", 
      RowBox[{"v", " ", "->", " ", 
       RowBox[{"-", "1"}]}]}], "|>"}], ",", " ", 
    RowBox[{"t", " ", "|->", " ", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", "t", "]"}], " ", "===", " ", "2"}], ",", " ", 
       RowBox[{"Switch", "[", 
        RowBox[{"t", ",", " ", 
         RowBox[{"{", 
          RowBox[{"u", ",", " ", "u"}], "}"}], ",", " ", "u", ",", " ", 
         RowBox[{"{", 
          RowBox[{"u", ",", " ", "v"}], "}"}], ",", " ", "v", ",", " ", 
         RowBox[{"{", 
          RowBox[{"v", ",", " ", "u"}], "}"}], ",", " ", "v", ",", " ", "_", ",",
          " ", "0"}], "]"}], ",", " ", "0"}], "]"}]}]}], "]"}]}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"503f847f-f5ce-46f1-8858-6676acaeae69"],

