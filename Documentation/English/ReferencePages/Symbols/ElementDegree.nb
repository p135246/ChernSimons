An association of degrees carries no degree of the pairing, so it gives only \
the bar degree:\
\>", "ExampleText",ExpressionUUID->"99dee20a-51bd-47b6-bb18-29361cbb3df0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ElementDegree", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"x", ",", " ", "y"}], "}"}], ",", " ", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"x", " ", "->", " ", 
      RowBox[{"-", "1"}]}], ",", " ", 
     RowBox[{"y", " ", "->", " ", "0"}]}], "|>"}], ",", 
   " ", "\"\<Exterior\>\""}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"0975e11c-d684-4b95-b3c8-7b545b53bdcc"],

