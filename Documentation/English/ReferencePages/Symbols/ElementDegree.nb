Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["HBar"]], "paclet:ChernSimons/ref/HBar", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "31822fb6-0869-4df6-bb4a-f75fe19b9a27"],
 " has a degree only in the symmetric grading, the grading of the \
Beilinson-Drinfeld algebra. It is the degree that makes the operator ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalDelta]", "\[LongEqual]", 
    RowBox[{
     SubscriptBox[
      StyleBox["q", "TI"], "110"], "+", 
     SubscriptBox[
      StyleBox["q", "TI"], "120"], "+", 
     RowBox[{"\[HBar]", " ", 
      SubscriptBox[
       StyleBox["q", "TI"], "210"]}]}]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"ecd3bcfd-bc51-4d25-bcaf-3fa3e252c48b"],
 " homogeneous of degree ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", "1"}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "1607b3c2-9f82-4974-bde8-fecbc8c930bc"],
 "."
}], "Notes",ExpressionUUID->"019492fd-4fb3-4b76-bd0a-bedfd6916ee5"],

