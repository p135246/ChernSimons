 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["MaurerCartanAnsatz"]], 
    "paclet:ChernSimons/ref/MaurerCartanAnsatz", "ChernSimons Package Symbol"},
