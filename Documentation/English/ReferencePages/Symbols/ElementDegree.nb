   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "fb375a94-8c28-4efe-b966-a24b5c5d6088"],
 " has a degree only in the symmetric grading, the grading of the \
Beilinson-Drinfeld algebra. It is the degree that makes the operator ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalDelta]", "\[LongEqual]", 
    SubscriptBox[
     StyleBox["q", "TI"], "110"], "+", 
    SubscriptBox[
     StyleBox["q", "TI"], "120"], "+", 
    RowBox[{"\[HBar]", " "}], 
    SubscriptBox[
     StyleBox["q", "TI"], "210"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fae7a54e-bf22-4b16-aa0d-72cb28d94d63"],
 " homogeneous of degree ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", "1"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "951f1b96-1f19-43ef-a64d-b3911d88fa89"],
 "."
}], "Notes",ExpressionUUID->"fe517c7f-9d43-4f19-a851-9821bc1f3507"],

