Cell["\<\
An association of degrees carries no degree of the pairing, so it gives only \
the bar degree:\
\>", "ExampleText",ExpressionUUID->"d6647fec-cff3-4716-946c-f341840fc113"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ElementDegree", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"x", ",", " ", "y"}], "}"}], ",", " ", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"x", " ", "->", " ", 
      RowBox[{"-", "1"}]}], ",", " ", 
     RowBox[{"y", " ", "->", " ", "0"}]}], "|>"}], ",", 
   " ", "\"\<Exterior\>\""}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"e4c3781e-3793-409d-a8ad-4b57366e59b1"],

Cell[BoxData[
 RowBox[{"ElementDegree", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"x", ",", "y"}], "}"}], ",", 
   RowBox[{"\[LeftAssociation]", 
    RowBox[{
     RowBox[{"x", "\[Rule]", 
      RowBox[{"-", "1"}]}], ",", 
     RowBox[{"y", "\[Rule]", "0"}]}], "\[RightAssociation]"}], 
   ",", "\<\"Exterior\"\>"}], "]"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"d7a0a792-6589-432f-9126-1834520a97af"]
