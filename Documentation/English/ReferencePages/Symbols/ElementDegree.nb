   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "f0a17dd7-df93-44f4-8d1d-4a8a7c2ca33b"],
 ", which is the degree ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["MaurerCartanBasis"]], 
    "paclet:ChernSimons/ref/MaurerCartanBasis", "ChernSimons Package Symbol"},
   
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "ed09f1ef-ad72-4b25-aae5-10b7692ee876"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["MaurerCartanAnsatz"]], 
    "paclet:ChernSimons/ref/MaurerCartanAnsatz", "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "85153263-0129-491e-b294-90cf13fbcb65"],
 " use when none is given."
}], "Notes",ExpressionUUID->"92858107-b229-4a79-b4dc-ef29d92fd75c"],

Cell[TextData[{
 "A scalar multiple has the degree of what it multiplies, a power ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[HBar]", 
    StyleBox["g", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "8bd24425-c2bd-49ac-bb88-c6178ff70de2"],
 " has ",
 Cell[BoxData[
  FormBox[
   StyleBox["g", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "a8cdb869-2575-4a69-b27f-0a22cfc7b10e"],
 " times the degree of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["HBar"]], "paclet:ChernSimons/ref/HBar", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "8c3c1330-bf29-45f5-8693-59e6b68cedcd"],
 ", and a sum has a degree when all its terms have the same one."
}], "Notes",ExpressionUUID->"c4c56795-df30-4603-915c-b5bf64dbb4a9"],

Cell["\<\
A scalar multiple of a particle counts only when the scalar contains no \
particle.\
\>", "Notes",ExpressionUUID->"a8e55656-e007-4052-8b10-9d16f30296c5"],

Cell["\<\
The particles of the dual alphabet of a pairing object have their degrees too.\
\>", "Notes",ExpressionUUID->"526f1943-729b-43f4-af96-076e4f8cbe93"],

Cell[TextData[{
 "In the bar grading ",
 StyleBox["pairing", "TI"],
 " may also be an association from particles to degrees."
}], "Notes",ExpressionUUID->"9323cb9b-3aec-40c5-9059-c9220c47cc58"],

Cell[TextData[{
 "A sum of mixed degree, ",
 Cell[BoxData[
 "0"], "InlineFormula",ExpressionUUID->"20f2a7f0-30f1-42b8-b68d-8d80508b2262"],
 ", a bare scalar, a particle outside the alphabet, and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["HBar"]], "paclet:ChernSimons/ref/HBar", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "1d98a415-88f8-47ab-b763-d729f5af5689"],
 " in the bar or exterior grading return unevaluated."
}], "Notes",ExpressionUUID->"1897b630-d88f-4cf0-af9f-03dd386e5243"]
