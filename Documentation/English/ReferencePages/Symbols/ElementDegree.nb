  FontSize->0.9 Inherited,ExpressionUUID->
  "59bd8363-b970-424d-b19e-b83f25e1f616"],
 " is the degree of the Poincar\[EAcute] duality algebra. ",
 Cell[BoxData[
  RowBox[{
   StyleBox["pairing", "TI"], "[", "\"\<Degree\>\"", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "92bdf66d-0a10-4598-af7c-d7e0c5d76731"],
 " gives ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["n", "TI"], "-", "2"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0dbdd9ac-1e94-4152-be60-fbb620ae6481"],
 "."
}], "Notes",ExpressionUUID->"f8f8df41-e6d3-4a68-98fb-c4b7cfd94b3e"],

