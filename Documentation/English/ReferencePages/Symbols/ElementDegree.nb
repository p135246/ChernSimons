Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["HBar"]], "paclet:ChernSimons/ref/HBar", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "807f5964-3723-4a80-8f8f-7dc2a0ac68fa"],
 " has a degree only in the symmetric grading, the grading of the \
Beilinson-Drinfeld algebra. It is the degree that makes the operator ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalDelta]", "\[LongEqual]", 
    RowBox[{
     SubscriptBox[
      StyleBox["q", "TI"], "110"], "+", 
     SubscriptBox[
      StyleBox["q", "TI"], "120"], "+", 
     RowBox[{"\[HBar]", " ", 
      SubscriptBox[
       StyleBox["q", "TI"], "210"]}]}]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"220abaa4-d9c1-47c4-a823-5cc0943ea8a1"],
 " homogeneous of degree ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", "1"}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "77a13343-9a39-4cb3-8465-778e435b9f92"],
 "."
}], "Notes",ExpressionUUID->"0fab9127-bc1f-4306-806f-ca355f61ce0c"],

Cell[TextData[{
 "A BD action has the degree ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", "(", 
    RowBox[{
     StyleBox["n", "TI"], "-", "3"}], ")"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"6be05617-5190-43ec-b41d-73000b88f59a"],
