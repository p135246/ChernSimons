Cell["\<\
An association of degrees carries no degree of the pairing, so it gives only \
the bar degree:\
\>", "ExampleText",ExpressionUUID->"952c8013-c1a8-41d5-a8bb-d429cce193f7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ElementDegree", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"x", ",", " ", "y"}], "}"}], ",", " ", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"x", " ", "->", " ", 
      RowBox[{"-", "1"}]}], ",", " ", 
     RowBox[{"y", " ", "->", " ", "0"}]}], "|>"}], ",", 
