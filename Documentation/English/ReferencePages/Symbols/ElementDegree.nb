   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "5e8aca2c-b0cb-4a88-a0f4-14e239111694"],
 " is the degree of the Poincar\[EAcute] duality algebra. ",
 Cell[BoxData[
  RowBox[{
   StyleBox["pairing", "TI"], "[", "\"\<Degree\>\"", "]"}]], "InlineFormula",
  ExpressionUUID->"72d80961-4b16-451d-b618-00814e2c2cf3"],
 " gives ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["n", "TI"], "-", "2"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"41384985-8861-44fc-b4f7-7096902a09c0"],
 "."
}], "Notes",ExpressionUUID->"deb256b0-9a6a-477e-9fb4-4ed28be0f967"],

