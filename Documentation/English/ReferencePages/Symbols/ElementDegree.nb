   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "9c5892b5-af38-4a57-aa84-26c4052d836a"],
 " has a degree only in the symmetric grading, the grading of the \
Beilinson-Drinfeld algebra. It is the degree that makes the operator ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalDelta]", "\[LongEqual]", 
    SubscriptBox[
     StyleBox["q", "TI"], "110"], "+", 
    SubscriptBox[
     StyleBox["q", "TI"], "120"], "+", 
    RowBox[{"\[HBar]", " "}], 
    SubscriptBox[
     StyleBox["q", "TI"], "210"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4c91e60f-c6f3-4727-841e-41bb74a9818b"],
 " homogeneous of degree ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", "1"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b7f651c1-e752-4ea8-a5f1-4130766efa69"],
 "."
}], "Notes",ExpressionUUID->"7284f808-6599-47f0-a5cf-1e97c14ec5ee"],

