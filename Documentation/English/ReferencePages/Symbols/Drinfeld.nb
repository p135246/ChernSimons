Notebook[{

Cell[CellGroupData[{
Cell["Drinfeld", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"027d57a4-9f21-4ded-b537-889d27c78743"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["Drinfeld"]], "paclet:IBLInfinity/ref/Drinfeld", 
     "IBLInfinity Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["u", "TI"], ",", " ", 
    StyleBox["v", "TI"], ",", " ", 
    StyleBox["pairing", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "435b5aa4-04a5-4e1a-8910-4ef27a4a9759"],
 "\[LineSeparator]",
 "gives the Drinfeld compatibility obstruction of two cyclic words; ",
 Cell[BoxData["0"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a914d4d6-41df-4c5b-869c-11c75e3ca58d"],
 " means the identity holds there.",
 "\n"
}], "Usage",ExpressionUUID->"78ba9ca2-f7b4-4ac1-aeb0-b72492de988d"],

Cell[TextData[{
 "The obstruction is ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    OverscriptBox[
     StyleBox["q", "TI"], "^"], 
    RowBox[{"1", ",", "2", ",", "0"}]], "\[SmallCircle]", 
   SubscriptBox[
    OverscriptBox[
     StyleBox["q", "TI"], "^"], 
    RowBox[{"2", ",", "1", ",", "0"}]], "+", 
   SubscriptBox[
    OverscriptBox[
     StyleBox["q", "TI"], "^"], 
    RowBox[{"2", ",", "1", ",", "0"}]], "\[SmallCircle]", 
   SubscriptBox[
    OverscriptBox[
     StyleBox["q", "TI"], "^"], 
    RowBox[{"1", ",", "2", ",", "0"}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c67597a2-71b5-43ca-99ba-126b313ae099"],
 " applied to the product ",
 Cell[BoxData[
  RowBox[{
   StyleBox["u", "TI"], "\[CircleDot]", 
   StyleBox["v", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f236b4d5-e5b5-41aa-bb29-43deede39bf0"],
 " \[LongDash] the statement that the co-bracket is a derivation for the \
bracket, which is what makes the two operations a bi-Lie structure rather \
than two unrelated ones."
}], "Notes",ExpressionUUID->"a5a66da1-6625-4a68-bcd5-f11ce7200fb5"],

Cell[TextData[{
 "The convention key of ",
 StyleBox["pairing", "TI"],
 " selects the picture."
}], "Notes",ExpressionUUID->"b07e3ddd-035a-4586-b0ee-1687be750651"],

Cell["\<\
Both composites raise and lower the number of factors by one, so the \
obstruction lives in the same two-factor space as the input product, and the \
identity is the vanishing of their sum rather than of either term.\
\>", "Notes",ExpressionUUID->"294cb11b-efb2-4696-8e20-80e1f0b3942f"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Drinfeld"]], "paclet:IBLInfinity/ref/Drinfeld", 
    "IBLInfinity Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "aefa6107-677e-458a-afd2-3de81ac504cd"],
 " is the arity-",
 Cell[BoxData["2"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a82afcec-08a8-4d53-8c8b-1dd62c2216ef"],
 " entry of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["$Relations"]], "paclet:IBLInfinity/ref/$Relations", 
    "IBLInfinity Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "fe32a60e-0ee0-4224-8f9c-75bc19fa8672"],
 "; ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RelationFailures"]], "paclet:IBLInfinity/ref/RelationFailures",
     "IBLInfinity Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "fe63655b-b1ad-48c3-b719-70d6df9bd612"],
 " sweeps it over an enumerated range of pairs."
}], "Notes",ExpressionUUID->"73935aec-ce45-477b-b82e-68060acfe33b"]
}, Open  ]],

