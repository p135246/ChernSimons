Cell["The identity holds on a pair of words of the circle:", "ExampleText",ExpressionUUID->"4cfe7250-9dd9-4873-bb68-0aa202345cef"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Drinfeld", "[", 
  RowBox[{
   RowBox[{"CyclicWord", "[", 
    RowBox[{"{", 
     RowBox[{"x", ",", " ", "y"}], "}"}], "]"}], ",", " ", 
   RowBox[{"CyclicWord", "[", 
    RowBox[{"{", 
     RowBox[{"x", ",", " ", "y", ",", " ", "y"}], "}"}], "]"}], ",", " ", 
   RowBox[{"Pairing", "[", 
    RowBox[{
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"x", " ", "->", " ", 
        RowBox[{"-", "1"}]}], ",", " ", 
       RowBox[{"y", " ", "->", " ", "0"}]}], "|>"}], ",", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "y"}], "}"}], " ", "->", " ", "1"}], "|>"}]}], 
    "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"4267e34e-ba46-4c02-a8f7-8657dcb8173d"],

Cell[BoxData["0"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"32ed4790-948d-471f-993e-27a791c40a44"]
}, Open  ]],

