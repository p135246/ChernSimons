Notebook[{

Cell[CellGroupData[{
Cell["SullivanModelProduct", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"44c8fcf5-260c-43ee-bae1-b05d29ea9e13"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["SullivanModelProduct"]], 
     "paclet:ChernSimons/ref/SullivanModelProduct", 
     "ChernSimons Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["e1", "TI"], ",", " ", 
    StyleBox["e2", "TI"], ",", " ", "\[Ellipsis]", ",", " ", 
    StyleBox["model", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "94802350-766b-45e9-a6b2-cc842fa1e89a"],
 "\[LineSeparator]",
 "multiplies elements of the model.",
 "\n"
}], "Usage",ExpressionUUID->"c4b8f34a-ee75-4dc6-89a0-fb78d3922e93"],

Cell[TextData[{
 "The product is graded commutative: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["e", "TI"], "1"], 
    SubscriptBox[
     StyleBox["e", "TI"], "2"], "\[LongEqual]", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"-", "1"}], ")"}], 
     TemplateBox[{
       RowBox[{
         SubscriptBox[
          StyleBox["e", "TI"], "1"], "||", 
         SubscriptBox[
          StyleBox["e", "TI"], "2"]}]},
      "Abs"]], 
    SubscriptBox[
     StyleBox["e", "TI"], "2"], 
    SubscriptBox[
     StyleBox["e", "TI"], "1"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9dfc72fa-af8a-467f-b210-a07bd781b82c"],
 ", and a generator of odd degree squares to zero. It is linear in each \
argument, so an argument may be any linear combination of monomials."
}], "Notes",ExpressionUUID->"3b4d3c9c-6931-42a8-ad73-3aa600170e52"],

Cell[TextData[{
 "A monomial written as a product of generators is read in the order the \
model declares them, so the ",
 StyleBox["order of the arguments",
  FontWeight->"Bold"],
 " is what carries the sign, not the way each monomial is typed."
}], "Notes",ExpressionUUID->"6bf32291-9114-4ecf-b61b-011a77da76fb"],

Cell["\<\
Anything landing above the model's truncation degree is zero.\
\>", "Notes",ExpressionUUID->"cdfc5da9-ec63-4a5d-aa66-8764f280cbef"]
}, Open  ]],

