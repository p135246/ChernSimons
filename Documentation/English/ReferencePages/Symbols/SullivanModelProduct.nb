Cell[CellGroupData[{
Cell["SullivanModelProduct", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"1e5e6801-9ef6-434b-beba-cab2364439a8"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["SullivanModelProduct"]], 
     "paclet:ChernSimons/ref/SullivanModelProduct", 
     "ChernSimons Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    SubscriptBox[
     StyleBox["e", "TI"], 
     StyleBox["1", "TR"]], ",", " ", 
    SubscriptBox[
     StyleBox["e", "TI"], 
     StyleBox["2", "TR"]], ",", " ", "\[Ellipsis]", ",", " ", 
    StyleBox["model", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "cbe5039f-94a1-48d3-af53-ab1808603446"],
 "\[LineSeparator]",
 "gives the graded commutative product of the elements ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["e", "TI"], "1"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"dcbd8a31-605c-4951-b93a-71afc2b3f59e"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["e", "TI"], "2"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"11247cd2-acee-4616-be93-825dded41846"],
 ", \[Ellipsis] of the Sullivan model ",
 StyleBox["model", "TI"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"35c6f262-33a9-4630-9ae1-a32399f702aa"],

Cell[TextData[{
 "The product is graded commutative: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["e", "TI"], "1"], 
    SubscriptBox[
     StyleBox["e", "TI"], "2"], "\[LongEqual]", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"-", "1"}], ")"}], 
     TemplateBox[{
       RowBox[{
         SubscriptBox[
          StyleBox["e", "TI"], "1"], "||", 
         SubscriptBox[
          StyleBox["e", "TI"], "2"]}]},
      "Abs"]], 
    SubscriptBox[
     StyleBox["e", "TI"], "2"], 
    SubscriptBox[
     StyleBox["e", "TI"], "1"]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"5ff328e5-0cf7-471d-8962-8ebe7a4b1df9"],
 " for homogeneous elements, and a generator of odd degree squares to zero."
}], "Notes",
 CellFrameLabels->{{Inherited, Inherited}, {Inherited, 
    Cell[
     TextData[{
      "26.09.30: Design review - an element is a polynomial in the \
generators, and a monomial is read in the order the model declares its \
generators, because Times is orderless: x y and y x are one expression, so \
the sign of the graded commutative product can only come from the order of \
the arguments. The product takes any number of elements before the model and \
applies the truncations, so a product never leaves a truncated model. \
Alternative name considered: ModelProduct, the name until 2026-09-21, renamed \
because \"Model\" alone is generic. Prior art: the Wolfram Language \
multiplies polynomials with Times, which is commutative, and GrassmannAlgebra \
is the exterior algebra on its generators; neither has generators of both \
parities or a truncation. The engine the verification suites load multiplies \
monomials given as lists of generators by a bubble sort with Koszul signs, \
and the suites pin this function against it on every pair of monomials of \
degree at most 4 of the catalogue and of Kodaira-Thurston.", "\n\n", 
       Cell[
        BoxData[
         GridBox[{{
            Cell[
             BoxData[
              ButtonBox[
               DynamicBox[
                FEPrivate`FrontEndResource[
                "DocumentationToolsStrings", "Edit"]], BaseStyle -> 
               "TextAnnotationButton"]]], 
            StyleBox[
             RowBox[{
               DynamicBox[
                FEPrivate`FrontEndResource[
                "DocumentationToolsStrings", "LastAnnotator"]], "pavel"}], 
             "TextAnnotator"], 
            Cell[
             BoxData[
              ButtonBox[
               DynamicBox[
                FEPrivate`FrontEndResource[
                "DocumentationToolsStrings", "Delete"]], BaseStyle -> 
               "TextAnnotationRemoveButton"]]], ""}}, 
          GridBoxAlignment -> {
           "Columns" -> {Left, Left, Right, Right}, "Rows" -> {{Automatic}}}, 
          GridBoxItemSize -> {"Columns" -> {
              Scaled[0.15], 
              Scaled[0.68], 
              Scaled[0.15], 
              Scaled[0.02]}}]]], "\n"}], "TextAnnotation", 
     CellSize -> {590, Inherited}]}},
 CellTags->"TextAnnotation",
 CellID->453628065,ExpressionUUID->"9dd30f08-936b-40f3-a03d-4203983e0aa1"],

Cell["\<\
An element is a polynomial in the generators, a linear combination of \
monomials, and the product is linear in each argument.\
\>", "Notes",ExpressionUUID->"0f60f3a1-e34c-4386-a22f-d2c8dc63a4a6"],

Cell["\<\
A monomial written as a product of generators is read in the order the model \
declares them, so the order of the arguments carries the sign, not the way a \
monomial is typed.\
\>", "Notes",ExpressionUUID->"58e8734f-69f0-49ff-a3a1-0622a54b2bd4"],

Cell[TextData[{
 "A monomial of the product whose part in a truncated group of generators \
lies above the degree of the truncation is ",
 Cell[BoxData[
  FormBox["0", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "827b26bb-ee77-4160-8c72-366d4962d5e2"],
 "."
}], "Notes",ExpressionUUID->"aee5e035-b7e7-48af-a38b-57d1e052ca5d"],

Cell["\<\
With more than two elements the product is taken from the left. A single \
element gives the element itself, expanded and truncated.\
\>", "Notes",ExpressionUUID->"3f8b6196-483b-429e-8820-cb815ea4d809"],

Cell["\<\
An argument that is not a polynomial in the generators returns unevaluated.\
\>", "Notes",ExpressionUUID->"f786620f-8735-4181-8f4c-9188be7d1e2d"]
}, Open  ]],

