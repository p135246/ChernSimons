Cell["\<\
The Leibniz identity, on a case where both terms are nonzero:\
\>", "ExampleText",ExpressionUUID->"a6cadabc-8f98-455b-bace-0a565c384335"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"model", " ", "=", " ", 
   RowBox[{"SullivanModel", "[", 
    RowBox[{"\"\<ComplexProjectiveSpace\>\"", "[", "2", "]"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"SullivanModelDifferential", "[", 
    RowBox[{
     RowBox[{"SullivanModelProduct", "[", 
      RowBox[{"a", ",", " ", "b", ",", " ", "model"}], "]"}], ",", " ", 
     "model"}], "]"}], ",", "\n", " ", 
   RowBox[{
    RowBox[{"SullivanModelProduct", "[", 
     RowBox[{
      RowBox[{"SullivanModelDifferential", "[", 
       RowBox[{"a", ",", " ", "model"}], "]"}], ",", " ", "b", ",", " ", 
      "model"}], "]"}], " ", "+", "\n", "   ", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"-", "1"}], ")"}], "^", "2"}], " ", 
     RowBox[{"SullivanModelProduct", "[", 
      RowBox[{"a", ",", " ", 
       RowBox[{"SullivanModelDifferential", "[", 
        RowBox[{"b", ",", " ", "model"}], "]"}], ",", " ", "model"}], 
      "]"}]}]}]}], "}"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"9db2744b-4c41-4710-add4-516602ec24a0"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   SuperscriptBox["a", "4"], ",", 
   SuperscriptBox["a", "4"]}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"e9984620-f727-47ff-8814-e2d6527d5842"]
}, Open  ]],

