Cell["\<\
An even generator is polynomial, and the model is not truncated, so its \
powers keep going:\
\>", "ExampleText",ExpressionUUID->"20ca6554-e7b2-470f-8736-3353f1cbe78a"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"model", " ", "=", " ", 
   RowBox[{"SullivanModel", "[", 
    RowBox[{"\"\<ComplexProjectiveSpace\>\"", "[", "2", "]"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{"SullivanModelProduct", "[", 
  RowBox[{
   RowBox[{"a", "^", "2"}], ",", " ", 
   RowBox[{"a", "^", "3"}], ",", " ", "model"}], "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"1feee530-3f63-4c9f-91c4-bc423473ded7"],

Cell[BoxData[
 SuperscriptBox["a", "5"]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"4ed8d349-b6ae-4c57-a011-120ae1bb549e"]
}, Open  ]],

