Cell[TextData[{
 "A special propagator of a cochain complex with a pairing ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     StyleBox["V", "TI"], ",", 
     StyleBox["d",
      FontSlant->"Plain"], ",", 
     RowBox[{"\[LeftAngleBracket]", 
      RowBox[{"-", ",", "-"}], "\[RightAngleBracket]"}]}], ")"}], 
   TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1207cb27-294d-4b6e-833b-ece3feb486c2"],
 " is a linear map ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["P", "TI"], ":", 
    StyleBox["V", "TI"], "\[Rule]", 
    StyleBox["V", "TI"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4338a9d4-2144-43ad-b0f9-1f260c455e78"],
 " of degree ",
 Cell[BoxData[
  FormBox[
