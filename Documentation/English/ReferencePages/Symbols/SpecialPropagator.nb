Cell[TextData[{
 "Special propagators and Hodge decompositions correspond one to one: the \
propagator of a decomposition is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", 
    StyleBox["c", "TI"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "4777bba2-8e3f-4c59-b8ae-a9f68fcfddd6"],
 " on ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["d",
     FontSlant->"Plain"], 
    StyleBox["c", "TI"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "5466d835-bcf2-484d-ada3-bc352304c87d"],
 " for ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["c", "TI"], "\[Element]", 
    StyleBox["C", "TI"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "6adad92d-ea94-4a20-9ea9-af11f42a4199"],
 " and ",
 Cell[BoxData[
  FormBox["0", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "73b46a35-fb9b-426e-b653-e554be77994d"],
 " on ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["H", "TI"], "\[CirclePlus]", 
    StyleBox["C", "TI"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "133b5ee5-2ba7-4716-a98a-4ca137c832c0"],
 ", and a propagator gives back ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["H", "TI"], "\[LongEqual]", 
    StyleBox["im",
     FontSlant->"Plain"], " ", "\[Pi]"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"97aa788b-4e20-4489-ae42-3e06f39c1b01"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["C", "TI"], "\[LongEqual]", 
    StyleBox["im",
     FontSlant->"Plain"], " ", 
    StyleBox["P", "TI"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "1f88ab27-9b28-43e0-8a65-76a640353187"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Pi]", "\[LongEqual]", 
    StyleBox["Id",
     FontSlant->"Plain"], "+", 
    StyleBox["d",
     FontSlant->"Plain"], 
    StyleBox["P", "TI"], "+", 
    StyleBox["P", "TI"], 
    StyleBox["d",
     FontSlant->"Plain"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "3b82b150-9efa-400f-b15f-9c658d8e60c6"],
 " (arXiv:2004.07362, Lemma 3.18)."
}], "Notes",ExpressionUUID->"633e63bb-b59d-4217-9bf1-9346103e3566"],

