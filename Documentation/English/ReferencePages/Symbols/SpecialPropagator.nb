              Scaled[0.15], 
              Scaled[0.02]}}]]], "\n"}], "TextAnnotation", 
     CellSize -> {590, Inherited}]}},
 CellTags->"TextAnnotation",
 CellID->252968307,ExpressionUUID->"9fc0d36f-2abe-4a2c-a969-3eeda1d17911"],

Cell[TextData[{
 "Special propagators and Hodge decompositions correspond one to one: the \
propagator of a decomposition is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", 
    StyleBox["c", "TI"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a9122e61-4c27-41b2-9d33-2aa540d04d3c"],
 " on ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["d",
     FontSlant->"Plain"], 
    StyleBox["c", "TI"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a2e3220f-0bf0-4707-b5cd-a6179c1bc266"],
 " for ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["c", "TI"], "\[Element]", 
    StyleBox["C", "TI"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3760deae-6974-4bfd-9c02-4dbef32b1c78"],
 " and ",
 Cell[BoxData[
  FormBox["0", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0a7a04ad-a9c5-49b2-ab5d-dd28710459e6"],
 " on ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["H", "TI"], "\[CirclePlus]", 
    StyleBox["C", "TI"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1d623c0c-a108-4f08-acee-0450275a7290"],
 ", and a propagator gives back ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["H", "TI"], "\[LongEqual]", 
    StyleBox["im",
     FontSlant->"Plain"], " ", "\[Pi]"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e6122989-ecaa-40d6-8eef-4396bb8ab396"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["C", "TI"], "\[LongEqual]", 
    StyleBox["im",
     FontSlant->"Plain"], " ", 
    StyleBox["P", "TI"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8dc788a1-ddc3-4ebf-b46f-50bcdae3543c"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Pi]", "\[LongEqual]", 
    StyleBox["Id",
     FontSlant->"Plain"], "+", 
    StyleBox["d",
     FontSlant->"Plain"], 
    StyleBox["P", "TI"], "+", 
    StyleBox["P", "TI"], 
    StyleBox["d",
     FontSlant->"Plain"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "eb3f967d-9f06-42cb-8998-f66f25ccd5d6"],
 " (arXiv:2004.07362, Lemma 3.18)."
}], "Notes",ExpressionUUID->"546de65e-a673-4abe-8813-5af76bd848c3"],

