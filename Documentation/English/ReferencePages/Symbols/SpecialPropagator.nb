Cell[TextData[{
 "Special propagators and Hodge decompositions correspond one to one: the \
propagator of a decomposition is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", 
    StyleBox["c", "TI"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "4c99d12a-30d2-4c87-a37a-8c0ceff21b9a"],
 " on ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["d",
     FontSlant->"Plain"], 
    StyleBox["c", "TI"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "d48e9282-9469-4443-be69-5a72db0bb2a5"],
 " for ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["c", "TI"], "\[Element]", 
    StyleBox["C", "TI"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "e1c6f1c3-642b-401c-931e-769316e34622"],
 " and ",
 Cell[BoxData[
  FormBox["0", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "1cd07fe9-ae5d-44fb-88a5-769a90b84dad"],
 " on ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["H", "TI"], "\[CirclePlus]", 
    StyleBox["C", "TI"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "23b02df2-c36e-4aef-8112-87a7ac73f161"],
 ", and a propagator gives back ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["H", "TI"], "\[LongEqual]", 
    StyleBox["im",
     FontSlant->"Plain"], " ", "\[Pi]"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"46b7b58c-5790-4762-90bf-8afc5d471ede"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["C", "TI"], "\[LongEqual]", 
    StyleBox["im",
     FontSlant->"Plain"], " ", 
    StyleBox["P", "TI"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "3c24cd41-86a2-4712-a3bb-e5d3b2e5fa02"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Pi]", "\[LongEqual]", 
    StyleBox["Id",
     FontSlant->"Plain"], "+", 
    StyleBox["d",
     FontSlant->"Plain"], 
    StyleBox["P", "TI"], "+", 
    StyleBox["P", "TI"], 
    StyleBox["d",
     FontSlant->"Plain"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "ca5e74ae-7007-4670-bcf7-fbd7fceecfee"],
 " (arXiv:2004.07362, Lemma 3.18)."
}], "Notes",ExpressionUUID->"694d4ff9-00fb-43cd-b291-93eb5b1ec259"],

