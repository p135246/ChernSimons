              Scaled[0.68], 
              Scaled[0.15], 
              Scaled[0.02]}}]]], "\n"}], "TextAnnotation", 
     CellSize -> {590, Inherited}]}},
 CellTags->"TextAnnotation",
 CellID->111295292,ExpressionUUID->"036b5daa-13d4-4f84-a842-b02a6407c2db"],

Cell[TextData[{
 "Special propagators and Hodge decompositions correspond one to one: the \
propagator of a decomposition is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", 
    StyleBox["c", "TI"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f0f561a1-9000-4746-8d15-e4cbf4ebda59"],
 " on ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["d",
     FontSlant->"Plain"], 
    StyleBox["c", "TI"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8046cff3-c39a-4a80-845d-d4be9a2a6ea8"],
 " for ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["c", "TI"], "\[Element]", 
    StyleBox["C", "TI"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "95b6f241-abbf-42f1-8210-27a9763f7d92"],
 " and ",
 Cell[BoxData[
  FormBox["0", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "35b9d6be-53ce-4593-b919-2b235a93ea46"],
 " on ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["H", "TI"], "\[CirclePlus]", 
    StyleBox["C", "TI"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "41f0965c-6a4b-4d8e-ae7f-a429499508b2"],
 ", and a propagator gives back ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["H", "TI"], "\[LongEqual]", 
    StyleBox["im",
     FontSlant->"Plain"], " ", "\[Pi]"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "67c3c4c2-ea47-429e-8c5c-46f869f1077c"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["C", "TI"], "\[LongEqual]", 
    StyleBox["im",
     FontSlant->"Plain"], " ", 
    StyleBox["P", "TI"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "615f9876-f15a-4c1c-8856-c2e9a6e4a405"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Pi]", "\[LongEqual]", 
    StyleBox["Id",
     FontSlant->"Plain"], "+", 
    StyleBox["d",
     FontSlant->"Plain"], 
    StyleBox["P", "TI"], "+", 
    StyleBox["P", "TI"], 
    StyleBox["d",
     FontSlant->"Plain"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bbd3b592-ef00-40d2-807e-ad62c8787dad"],
 " (arXiv:2004.07362, Lemma 3.18)."
}], "Notes",ExpressionUUID->"6426d4ab-9955-4797-b1c3-c825ef92372a"],

