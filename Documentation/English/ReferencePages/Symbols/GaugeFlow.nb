Cell["\<\
The flow solves the BD homotopy equation to the order asked for:\
\>", "ExampleText",ExpressionUUID->"32b718a6-49ba-48eb-8bf5-edaacc53ce54"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"pairing", " ", "=", " ", 
   RowBox[{"GradedPairing", "[", 
    RowBox[{
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"x", " ", "->", " ", 
        RowBox[{"-", "1"}]}], ",", " ", 
       RowBox[{"y", " ", "->", " ", "0"}]}], "|>"}], ",", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "y"}], "}"}], " ", "->", " ", "1"}], "|>"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"ys", "[", "k_", "]"}], " ", ":=", " ", 
   RowBox[{"ConstantArray", "[", 
    RowBox[{"y", ",", " ", "k"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"xyxy", "[", 
    RowBox[{"i_", ",", " ", "j_"}], "]"}], " ", ":=", " ", 
   RowBox[{"CyclicWord", "[", 
    RowBox[{"Join", "[", 
     RowBox[{
      RowBox[{"{", "x", "}"}], ",", " ", 
      RowBox[{"ys", "[", "i", "]"}], ",", " ", 
      RowBox[{"{", "x", "}"}], ",", " ", 
      RowBox[{"ys", "[", "j", "]"}]}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"yp", "[", "k_", "]"}], " ", ":=", " ", 
   RowBox[{"CyclicWord", "[", 
    RowBox[{"ys", "[", "k", "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"b", " ", "=", " ", 
     RowBox[{"w1", " ", 
      RowBox[{"CyclicWord", "[", 
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "y"}], "}"}], "]"}]}]}], "}"}], ",", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"a", " ", "=", " ", 
       RowBox[{"GaugeFlow", "[", 
        RowBox[{
         RowBox[{"c01", " ", 
          RowBox[{"xyxy", "[", 
           RowBox[{"0", ",", " ", "1"}], "]"}]}], ",", " ", "b", ",", " ", 
         "pairing", ",", " ", "4", ",", " ", "t", ",", " ", "3"}], "]"}]}], 
      "}"}], ",", "\n", "  ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Expand", "[", 
        RowBox[{"Coefficient", "[", 
         RowBox[{
          RowBox[{"Expand", "[", 
           RowBox[{
            RowBox[{"BeilinsonDrinfeldOperator", "[", 
             RowBox[{"b", ",", " ", "pairing"}], "]"}], " ", "+", " ", 
            RowBox[{"BeilinsonDrinfeldBracket", "[", 
             RowBox[{"a", ",", " ", "b", ",", " ", "pairing"}], "]"}], " ", "+",
             " ", 
            RowBox[{"D", "[", 
             RowBox[{"a", ",", " ", "t"}], "]"}]}], "]"}], ",", " ", "t", ",",
           " ", "k"}], "]"}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"k", ",", " ", "0", ",", " ", "2"}], "}"}]}], "]"}]}], 
