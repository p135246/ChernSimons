Cell["\<\
And it carries Maurer-Cartan elements to Maurer-Cartan elements:\
\>", "ExampleText",ExpressionUUID->"e45cb7b4-b245-4672-9551-fe2e1ba40c7b"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"pairing", " ", "=", " ", 
   RowBox[{"GradedPairing", "[", 
    RowBox[{
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"x", " ", "->", " ", 
        RowBox[{"-", "1"}]}], ",", " ", 
       RowBox[{"y", " ", "->", " ", "0"}]}], "|>"}], ",", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "y"}], "}"}], " ", "->", " ", "1"}], "|>"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"ys", "[", "k_", "]"}], " ", ":=", " ", 
   RowBox[{"ConstantArray", "[", 
    RowBox[{"y", ",", " ", "k"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"xyxy", "[", 
    RowBox[{"i_", ",", " ", "j_"}], "]"}], " ", ":=", " ", 
   RowBox[{"CyclicWord", "[", 
    RowBox[{"Join", "[", 
     RowBox[{
      RowBox[{"{", "x", "}"}], ",", " ", 
      RowBox[{"ys", "[", "i", "]"}], ",", " ", 
      RowBox[{"{", "x", "}"}], ",", " ", 
      RowBox[{"ys", "[", "j", "]"}]}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"yp", "[", "k_", "]"}], " ", ":=", " ", 
   RowBox[{"CyclicWord", "[", 
    RowBox[{"ys", "[", "k", "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{"MaurerCartanEquation", "[", 
  RowBox[{
   RowBox[{"GaugeFlow", "[", 
    RowBox[{
     RowBox[{"c01", " ", 
      RowBox[{"xyxy", "[", 
       RowBox[{"0", ",", " ", "1"}], "]"}]}], ",", " ", 
     RowBox[{"w1", " ", 
      RowBox[{"CyclicWord", "[", 
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "y"}], "}"}], "]"}]}], ",", " ", "pairing", ",",
      " ", "4", ",", " ", "t", ",", " ", "3"}], "]"}], ",", " ", "pairing"}], 
  "]"}]}], "Input",
