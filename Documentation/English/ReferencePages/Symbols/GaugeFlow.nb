Notebook[{

Cell[CellGroupData[{
Cell["GaugeFlow", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"cc1d769f-5899-4ddc-a275-e231eadf4ae3"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["GaugeFlow"]], "paclet:ChernSimons/ref/GaugeFlow", 
     "ChernSimons Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["a", "TI"], ",", " ", 
    StyleBox["b", "TI"], ",", " ", 
    StyleBox["pairing", "TI"], ",", " ", 
    StyleBox["n", "TI"], ",", " ", 
    StyleBox["t", "TI"], ",", " ", 
    StyleBox["order", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1cd75027-c69d-431a-be11-76111c7320ca"],
 "\[LineSeparator]",
 "solves the BD homotopy equation ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalDelta]", 
    StyleBox["b", "TI"], "+", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["a", "TI"], ",", 
      StyleBox["b", "TI"]}], "}"}], "\[LongEqual]", "-", 
    OverscriptBox[
     StyleBox["a", "TI"], "."]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3ad84698-f6cb-4caa-bae5-151ab9e770b0"],
 " by Picard iteration, starting from the BD action ",
 StyleBox["a", "TI"],
 " at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["t", "TI"], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9c0d647d-8265-411f-b776-d4e27deb7dc8"],
 " and flowing along the interval component ",
 StyleBox["b", "TI"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"d8239e7d-fd2b-4db3-a94a-9bf00f92c2c1"],

Cell["\<\
Two BD actions are BD homotopic \[LongDash] equivalently, their Maurer-Cartan \
elements are gauge equivalent \[LongDash] when such a flow connects them.\
\>", "Notes",ExpressionUUID->"99134240-aee9-4446-bd58-89a3c5731279"],

Cell[TextData[{
 "The result is a polynomial in ",
 StyleBox["t", "TI"],
 " of degree at most ",
 StyleBox["order", "TI"],
 ", truncated to monomials of total word length at most ",
 StyleBox["n", "TI"],
 ". Both truncations are genuine: the equation is satisfied to order ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["t", "TI"], 
    RowBox[{
     StyleBox["o", "TI"], 
     StyleBox["r", "TI"], 
     StyleBox["d", "TI"], 
     StyleBox["e", "TI"], 
     StyleBox["r", "TI"], "-", "1"}]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "09303723-f6e7-4814-93c0-6e5c2bda405c"],
 " and generally fails at ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["t", "TI"], 
    StyleBox[
     RowBox[{"o", "r", "d", "e", "r"}], "TI"]], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d074505c-5a7e-4319-9564-85a9f7f03e22"],
 "."
}], "Notes",ExpressionUUID->"72160774-b22e-48e0-9972-24a7dcc5cdaf"],

Cell[TextData[{
 "The equation is written in the BD algebra itself, from ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["BeilinsonDrinfeldOperator"]], 
    "paclet:ChernSimons/ref/BeilinsonDrinfeldOperator", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "b939d8e0-46dd-4354-b1f7-865f4259613c"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["BeilinsonDrinfeldBracket"]], 
    "paclet:ChernSimons/ref/BeilinsonDrinfeldBracket", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "d4198db6-4077-4df4-9b84-fe854dd4a483"],
 ", so it needs no coefficient parametrization and is not tied to any \
alphabet. On the circle it reproduces the coefficient system of the paper's \
lemma on BD homotopies; note that the two truncate differently \[LongDash] by \
word length here, by array index there \[LongDash] so they agree only where \
both truncations are inactive."
}], "Notes",ExpressionUUID->"08341876-39fa-4b23-9636-566f9c0e500e"],

Cell[TextData[{
 "The flow preserves the Maurer-Cartan property: if ",
 StyleBox["a", "TI"],
 " solves the master equation, so does every ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["a", "TI"], "(", 
    StyleBox["t", "TI"], ")"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8310bc28-de82-4959-a368-551941f4524e"],
 "."
}], "Notes",ExpressionUUID->"8c41aa97-5bdc-49c1-a59c-d45f96fce901"]
}, Open  ]],

