Cell["It starts where it was told to:", "ExampleText",ExpressionUUID->"009d2e5e-adcc-4bec-aeb2-3918d110542e"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"pairing", " ", "=", " ", 
   RowBox[{"GradedPairing", "[", 
    RowBox[{
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"x", " ", "->", " ", 
        RowBox[{"-", "1"}]}], ",", " ", 
       RowBox[{"y", " ", "->", " ", "0"}]}], "|>"}], ",", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "y"}], "}"}], " ", "->", " ", "1"}], "|>"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"ys", "[", "k_", "]"}], " ", ":=", " ", 
   RowBox[{"ConstantArray", "[", 
    RowBox[{"y", ",", " ", "k"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"xyxy", "[", 
    RowBox[{"i_", ",", " ", "j_"}], "]"}], " ", ":=", " ", 
   RowBox[{"CyclicWord", "[", 
    RowBox[{"Join", "[", 
     RowBox[{
      RowBox[{"{", "x", "}"}], ",", " ", 
      RowBox[{"ys", "[", "i", "]"}], ",", " ", 
      RowBox[{"{", "x", "}"}], ",", " ", 
      RowBox[{"ys", "[", "j", "]"}]}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"yp", "[", "k_", "]"}], " ", ":=", " ", 
   RowBox[{"CyclicWord", "[", 
    RowBox[{"ys", "[", "k", "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{"Expand", "[", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{"GaugeFlow", "[", 
      RowBox[{
       RowBox[{"c01", " ", 
        RowBox[{"xyxy", "[", 
         RowBox[{"0", ",", " ", "1"}], "]"}]}], ",", " ", 
       RowBox[{"w1", " ", 
        RowBox[{"CyclicWord", "[", 
         RowBox[{"{", 
          RowBox[{"x", ",", " ", "y"}], "}"}], "]"}]}], ",", " ", "pairing", ",",
        " ", "4", ",", " ", "t", ",", " ", "3"}], "]"}], " ", "/.", " ", 
     RowBox[{"t", " ", "->", " ", "0"}]}], ")"}], " ", "-", " ", 
   RowBox[{"c01", " ", 
    RowBox[{"xyxy", "[", 
     RowBox[{"0", ",", " ", "1"}], "]"}]}]}], "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"0aa18e46-17af-483a-97c3-fb3d1df2bced"],

Cell[BoxData["0"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"0c4dc512-d28c-43b8-b4ae-f632b105c68b"]
}, Open  ]]
}, Open  ]]
}, Open  ]],

