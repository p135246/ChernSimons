Cell["A flow of the circle along a single homotopy generator:", "ExampleText",ExpressionUUID->"1b1221ce-8039-4b6d-8717-aa195131243b"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"pairing", " ", "=", " ", 
   RowBox[{"GradedPairing", "[", 
    RowBox[{
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"x", " ", "->", " ", 
        RowBox[{"-", "1"}]}], ",", " ", 
       RowBox[{"y", " ", "->", " ", "0"}]}], "|>"}], ",", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "y"}], "}"}], " ", "->", " ", "1"}], "|>"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"ys", "[", "k_", "]"}], " ", ":=", " ", 
   RowBox[{"ConstantArray", "[", 
    RowBox[{"y", ",", " ", "k"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"xyxy", "[", 
    RowBox[{"i_", ",", " ", "j_"}], "]"}], " ", ":=", " ", 
   RowBox[{"CyclicWord", "[", 
    RowBox[{"Join", "[", 
     RowBox[{
      RowBox[{"{", "x", "}"}], ",", " ", 
      RowBox[{"ys", "[", "i", "]"}], ",", " ", 
      RowBox[{"{", "x", "}"}], ",", " ", 
      RowBox[{"ys", "[", "j", "]"}]}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"yp", "[", "k_", "]"}], " ", ":=", " ", 
   RowBox[{"CyclicWord", "[", 
    RowBox[{"ys", "[", "k", "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{"GaugeFlow", "[", 
  RowBox[{
   RowBox[{"c01", " ", 
    RowBox[{"xyxy", "[", 
     RowBox[{"0", ",", " ", "1"}], "]"}]}], ",", " ", 
   RowBox[{"w1", " ", 
    RowBox[{"CyclicWord", "[", 
     RowBox[{"{", 
      RowBox[{"x", ",", " ", "y"}], "}"}], "]"}]}], ",", " ", "pairing", ",", 
   " ", "4", ",", " ", "t", ",", " ", "3"}], "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"db6906c3-7a85-47c5-a903-969540ad0b9d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"c01", " ", 
   InterpretationBox[
    RowBox[{"(", 
     RowBox[{"x", "\[ThinSpace]", "x", "\[ThinSpace]", "y"}], ")"}],
    ChernSimons`CyclicWord[{
     MTNB$xnmclvpik097`x, MTNB$xnmclvpik097`x, MTNB$xnmclvpik097`y}],
    Editable->False]}], "-", 
  RowBox[{"c01", " ", "t", " ", "w1", " ", 
   InterpretationBox[
    RowBox[{"(", 
     RowBox[{"x", "\[ThinSpace]", "x", "\[ThinSpace]", "y"}], ")"}],
    ChernSimons`CyclicWord[{
     MTNB$xnmclvpik097`x, MTNB$xnmclvpik097`x, MTNB$xnmclvpik097`y}],
    Editable->False]}], "+", 
  RowBox[{
   FractionBox["1", "2"], " ", "c01", " ", 
   SuperscriptBox["t", "2"], " ", 
   SuperscriptBox["w1", "2"], " ", 
   InterpretationBox[
    RowBox[{"(", 
     RowBox[{"x", "\[ThinSpace]", "x", "\[ThinSpace]", "y"}], ")"}],
    ChernSimons`CyclicWord[{
     MTNB$xnmclvpik097`x, MTNB$xnmclvpik097`x, MTNB$xnmclvpik097`y}],
    Editable->False]}], "-", 
  RowBox[{
   FractionBox["1", "6"], " ", "c01", " ", 
   SuperscriptBox["t", "3"], " ", 
   SuperscriptBox["w1", "3"], " ", 
   InterpretationBox[
    RowBox[{"(", 
     RowBox[{"x", "\[ThinSpace]", "x", "\[ThinSpace]", "y"}], ")"}],
    ChernSimons`CyclicWord[{
     MTNB$xnmclvpik097`x, MTNB$xnmclvpik097`x, MTNB$xnmclvpik097`y}],
    Editable->False]}]}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"1c9d343f-6a5b-457f-9eb8-4f02973d74d0"]
}, Open  ]],

