Cell[TextData[{
 "The arity is the number of cyclic words the obstruction takes before the \
pairing object, and it is what ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RelationFailures"]], "paclet:IBLInfinity/ref/RelationFailures",
     "IBLInfinity Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "18006864-3270-4d54-9a34-df19c0a64201"],
 " uses to build the tuples it sweeps."
}], "Notes",ExpressionUUID->"f6c05961-7968-4f9c-a5aa-40056921cffc"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["$Relations"]], "paclet:IBLInfinity/ref/$Relations", 
    "IBLInfinity Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "4a83f76d-adc4-4523-bc06-e7d792d56c04"],
 " is a plain value, not a held registry: adding an entry to a copy of it is \
enough to sweep an identity of one's own with ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RelationFailures"]], "paclet:IBLInfinity/ref/RelationFailures",
     "IBLInfinity Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "25add59b-46cc-47dd-a7ad-3f2d5a9f852a"],
 ", provided the function follows the same calling convention of ",
 StyleBox["arity", "TI"],
 " words followed by the pairing object."
}], "Notes",ExpressionUUID->"54144ab9-6fcf-4d75-a887-f715174e3cca"]
}, Open  ]],

