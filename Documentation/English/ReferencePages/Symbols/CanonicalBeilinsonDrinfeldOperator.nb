Cell[CellGroupData[{
Cell["CanonicalBeilinsonDrinfeldOperator", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"4ec61555-ec8f-4536-a41f-1c55d6ee0422"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["CanonicalBeilinsonDrinfeldOperator"]], 
     "paclet:ChernSimons/ref/CanonicalBeilinsonDrinfeldOperator", 
     "ChernSimons Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["e", "TI"], ",", " ", 
    StyleBox["pairing", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "aa2a24e2-6146-42bb-8537-dbd94b85a41c"],
 "\[LineSeparator]",
 "gives the operator ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalDelta]", "\[LongEqual]", 
    RowBox[{
     SubscriptBox[
      OverscriptBox[
       StyleBox["q", "TI"], "^"], 
      RowBox[{"1", ",", "1", ",", "0"}]], "+", 
     SubscriptBox[
      OverscriptBox[
       StyleBox["q", "TI"], "^"], 
      RowBox[{"1", ",", "2", ",", "0"}]], "+", 
     RowBox[{"\[HBar]", " ", 
      SubscriptBox[
       OverscriptBox[
        StyleBox["q", "TI"], "^"], 
       RowBox[{"2", ",", "1", ",", "0"}]]}]}]}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"9d8fb022-49af-48d0-a4fa-51b19fb332ae"],
 " of the Beilinson-Drinfeld algebra, applied to ",
 StyleBox["e", "TI"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"f9aaedae-9707-4574-949a-3cdd03bec0d1"],

Cell[TextData[{
 Cell[BoxData[
  FormBox["\[CapitalDelta]", TraditionalForm]], "InlineFormula",
  ExpressionUUID->"50a01ffd-ba40-486f-90d7-ef3065f88171"],
 " acts on the symmetric powers of cyclic words, completed over ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["R",
     FontSlant->"Plain"], 
    RowBox[{"[", 
     RowBox[{"[", "\[HBar]", "]"}], "]"}]}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"325b99e4-0e59-4967-a0a5-b1d63c998c55"],
 ". It is a derivative of order at most ",
 Cell[BoxData[
  FormBox["2", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "04b1d156-4c9d-47fc-810e-effec0bfa32d"],
 " and of symmetric degree ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", "1"}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "ab832435-1043-4241-ad47-c1ae173c60eb"],
 ", and it squares to zero exactly when the underlying structure is a dIBL \
algebra."
}], "Notes",
 CellFrameLabels->{{Inherited, Inherited}, {Inherited, 
    Cell[
     TextData[{
      "26.09.30: Design review - the operator is the sum of three exported \
extensions, CyclicHochschildDifferential + CanonicalLieCobracket + HBar \
CanonicalLieBracket, all in the symmetric convention, and carries its own \
linearity rules; HBar is a scalar to every linearity rule and has even \
degree, so it never contributes a sign. A pairing in the exterior convention \
returns unevaluated, since the BD algebra is the symmetric algebra and \
computing in the symmetric product under an exterior key would ignore the one \
switch between the pictures; the decision of R2 was kept by Pavel, who wants \
the conversion between the pictures available, as SymmetricToExterior and \
ExteriorToSymmetric. The option \"EmptyWord\" is passed to the bracket and \
the co-bracket, where the empty word enters. Alternative name considered: \
BeilinsonDrinfeldOperator, the name until 2026-09-30. Prior art: the Wolfram \
Language has no BV or BD operators. T12/paclet-bd-operator-and-bracket pins \
the operator against the bdOperator of the engine the verification suites \
load on every word to length 5 and on the two-factor products of words to \
length 4, and T12/paclet-bd-operator-squares-to-zero pins that it squares to \
zero there.", "\n\n", 
       Cell[
        BoxData[
         GridBox[{{
            Cell[
             BoxData[
              ButtonBox[
               DynamicBox[
                FEPrivate`FrontEndResource[
                "DocumentationToolsStrings", "Edit"]], BaseStyle -> 
               "TextAnnotationButton"]]], 
            StyleBox[
             RowBox[{
               DynamicBox[
                FEPrivate`FrontEndResource[
                "DocumentationToolsStrings", "LastAnnotator"]], "pavel"}], 
             "TextAnnotator"], 
            Cell[
             BoxData[
              ButtonBox[
               DynamicBox[
                FEPrivate`FrontEndResource[
                "DocumentationToolsStrings", "Delete"]], BaseStyle -> 
               "TextAnnotationRemoveButton"]]], ""}}, 
          GridBoxAlignment -> {
           "Columns" -> {Left, Left, Right, Right}, "Rows" -> {{Automatic}}}, 
          GridBoxItemSize -> {"Columns" -> {
              Scaled[0.15], 
              Scaled[0.68], 
              Scaled[0.15], 
              Scaled[0.02]}}]]], "\n"}], "TextAnnotation", 
     CellSize -> {590, Inherited}]}},
 CellTags->"TextAnnotation",
 CellID->586662613,ExpressionUUID->"a119f87e-6179-4697-b733-c27066524ea6"],

Cell[TextData[{
 "The first summand is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CyclicHochschildDifferential"]], 
    "paclet:ChernSimons/ref/CyclicHochschildDifferential", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "e7ded737-ea9c-4491-bd7d-6c5b9fafef0b"],
 " extended as a derivation. It is ",
 Cell[BoxData[
  FormBox["0", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "639cbb65-9a3b-4188-98b0-f2b0d13b2c1d"],
 " unless the pairing carries a Poincar\[EAcute] duality algebra with a \
differential, so on a formal alphabet ",
 Cell[BoxData[
  FormBox["\[CapitalDelta]", TraditionalForm]], "InlineFormula",
  ExpressionUUID->"3469f732-ab89-4800-9dad-aea1529b93d7"],
 " is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     OverscriptBox[
      StyleBox["q", "TI"], "^"], 
     RowBox[{"1", ",", "2", ",", "0"}]], "+", 
    RowBox[{"\[HBar]", " ", 
     SubscriptBox[
      OverscriptBox[
       StyleBox["q", "TI"], "^"], 
      RowBox[{"2", ",", "1", ",", "0"}]]}]}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"ca623149-b7b2-4780-890f-3bcdeca8a0d5"],
 "."
}], "Notes",ExpressionUUID->"2cd21802-088a-4494-b3c6-9e16bf09a26c"],

Cell[TextData[{
 "The second summand is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CanonicalLieCobracket"]], 
    "paclet:ChernSimons/ref/CanonicalLieCobracket", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "00059413-3a1e-4c82-86fb-70b1af0f4e14"],
 " extended as a co-derivation, and the third is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CanonicalLieBracket"]], 
    "paclet:ChernSimons/ref/CanonicalLieBracket", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "27b79bb9-a961-46c2-a247-1c9aff9f2be1"],
 " extended as a derivation and weighted by ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["HBar"]], "paclet:ChernSimons/ref/HBar", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "b9012c43-819f-42c8-b517-737deb21d0b4"],
 "."
}], "Notes",ExpressionUUID->"92eab866-43c7-4a05-846d-d60e3b9c9dd4"],

Cell[TextData[{
 "Only the third summand carries ",
 Cell[BoxData[
  FormBox["\[HBar]", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "5d19fb98-4a7c-4e75-885f-99d61fee404c"],
 ", so ",
 Cell[BoxData[
  FormBox["\[CapitalDelta]", TraditionalForm]], "InlineFormula",
  ExpressionUUID->"7db39128-ff4e-4b1f-b671-e83526bb1e63"],
 " is not divisible by ",
 Cell[BoxData[
  FormBox["\[HBar]", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "8ed1b163-43fb-4a24-a08e-8c80d7ea2446"],
 "."
}], "Notes",ExpressionUUID->"a4defa3a-3367-4999-9b13-eed0cff86a46"],

Cell[TextData[{
 Cell[BoxData[
  FormBox["\[CapitalDelta]", TraditionalForm]], "InlineFormula",
  ExpressionUUID->"539aa14e-b526-4eda-8c4c-fc83b19fde65"],
 " obeys the BD axiom"
}], "Notes",ExpressionUUID->"97402dfc-4e1e-449a-a7c4-3ca31f94e6fd"],

Cell[BoxData[
 PaneBox[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"\[CapitalDelta]", 
      RowBox[{"(", 
       RowBox[{
        StyleBox["f", "TI"], 
        SuperscriptBox[
         StyleBox["f", "TI"], "\[Prime]"]}], ")"}]}], "\[LongEqual]", 
     RowBox[{
      RowBox[{"\[CapitalDelta]", 
       RowBox[{"(", 
        StyleBox["f", "TI"], ")"}], 
       SuperscriptBox[
        StyleBox["f", "TI"], "\[Prime]"]}], "+", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"-", "1"}], ")"}], 
        TemplateBox[{
          RowBox[{
            StyleBox["f", "TI"]}]},
         "Abs"]], 
       StyleBox["f", "TI"], "\[CapitalDelta]", 
       RowBox[{"(", 
        SuperscriptBox[
         StyleBox["f", "TI"], "\[Prime]"], ")"}]}], "+", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"-", "1"}], ")"}], 
        TemplateBox[{
          RowBox[{
            StyleBox["f", "TI"]}]},
         "Abs"]], "\[HBar]", " ", 
       RowBox[{"{", 
        RowBox[{
         StyleBox["f", "TI"], ",", 
         SuperscriptBox[
          StyleBox["f", "TI"], "\[Prime]"]}], "}"}]}]}]}], ","}],
   TraditionalForm],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",ExpressionUUID->"e4c39973-cea0-40bf-\
a7d6-bf5400cc3d04"],

Cell[TextData[{
