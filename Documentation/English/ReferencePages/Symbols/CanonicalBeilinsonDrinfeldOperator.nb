  FontSize->0.9 Inherited,ExpressionUUID->
  "93b2cf70-8e3e-45d0-8dcf-c72ddf4d0eda"],
 " obeys the BD axiom"
}], "Notes",ExpressionUUID->"a56caa4e-41e9-407e-bb09-dbb1b4405232"],

Cell[BoxData[
 PaneBox[
  FormBox[
   RowBox[{"\[CapitalDelta]", 
    RowBox[{"(", 
