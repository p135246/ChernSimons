Cell["The operator on a word of the circle:", "ExampleText",ExpressionUUID->"78402682-8c71-4acf-b447-557b32f0d49e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"CanonicalBeilinsonDrinfeldOperator", "[", 
  RowBox[{
   RowBox[{"CyclicWord", "[", 
    RowBox[{"{", 
     RowBox[{"x", ",", " ", "y", ",", " ", "y", ",", " ", "y"}], "}"}], "]"}],
    ",", " ", 
   RowBox[{"GradedPairing", "[", 
    RowBox[{
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"x", " ", "->", " ", 
        RowBox[{"-", "1"}]}], ",", " ", 
       RowBox[{"y", " ", "->", " ", "0"}]}], "|>"}], ",", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "y"}], "}"}], " ", "->", " ", "1"}], "|>"}]}], 
    "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"38fb7bc0-fd8c-491a-a5cf-f4977e4a3477"],

Cell[BoxData[
 RowBox[{"-", 
  InterpretationBox[
   RowBox[{
