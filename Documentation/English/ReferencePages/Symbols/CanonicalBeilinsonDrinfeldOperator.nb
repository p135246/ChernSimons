       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"-", "1"}], ")"}], 
        TemplateBox[{
          RowBox[{
            StyleBox["f", "TI"]}]},
         "Abs"]], 
       StyleBox["f", "TI"], "\[CapitalDelta]", 
       RowBox[{"(", 
        SuperscriptBox[
         StyleBox["f", "TI"], "\[Prime]"], ")"}]}], "+", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"-", "1"}], ")"}], 
        TemplateBox[{
          RowBox[{
            StyleBox["f", "TI"]}]},
         "Abs"]], "\[HBar]", " ", 
       RowBox[{"{", 
        RowBox[{
         StyleBox["f", "TI"], ",", 
         SuperscriptBox[
          StyleBox["f", "TI"], "\[Prime]"]}], "}"}]}]}]}], ","}],
   TraditionalForm],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",ExpressionUUID->"212e76b5-839f-4a1e-\
9fb5-bbfa4742c252"],

