  FontSize->0.9 Inherited,ExpressionUUID->
  "2faf8d7c-24b2-42d0-9e77-a635051be27b"],
 "."
}], "Notes",ExpressionUUID->"077d00df-de7f-4b92-8a3c-f19fd2126b35"],

Cell[TextData[{
