Cell["The operator on a word of the circle:", "ExampleText",ExpressionUUID->"39e8d7ac-f210-495c-8751-f3ff76916b71"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"CanonicalBeilinsonDrinfeldOperator", "[", 
  RowBox[{
   RowBox[{"CyclicWord", "[", 
    RowBox[{"{", 
     RowBox[{"x", ",", " ", "y", ",", " ", "y", ",", " ", "y"}], "}"}], "]"}],
    ",", " ", 
   RowBox[{"GradedPairing", "[", 
    RowBox[{
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"x", " ", "->", " ", 
        RowBox[{"-", "1"}]}], ",", " ", 
       RowBox[{"y", " ", "->", " ", "0"}]}], "|>"}], ",", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "y"}], "}"}], " ", "->", " ", "1"}], "|>"}]}], 
    "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"e2cb0fd6-1d01-4408-8391-3457e682e797"],

Cell[BoxData[
 RowBox[{"-", 
  InterpretationBox[
   RowBox[{
    InterpretationBox[
     RowBox[{"(", "y", ")"}],
     ChernSimons`CyclicWord[{MTNB$akb8y5ph81em`y}],
     Editable->False], "\[CircleDot]", 
    InterpretationBox[
     RowBox[{"(", "y", ")"}],
     ChernSimons`CyclicWord[{MTNB$akb8y5ph81em`y}],
     Editable->False]}],
   ChernSimons`SymmetricProduct[
    ChernSimons`CyclicWord[{MTNB$akb8y5ph81em`y}], 
    ChernSimons`CyclicWord[{MTNB$akb8y5ph81em`y}]],
   Editable->False]}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"452a5f54-05fa-44ed-8edf-ba28e3930c71"]
}, Open  ]],

