Cell[TextData[{
 StyleBox["pairing", "TI"],
 " must carry a ",
 Cell[BoxData["\"\<Dual\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f336f113-7747-4d6e-85ee-8a77e9ffa285"],
 " key, so it has to be built with the four-argument form of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Pairing"]], "paclet:IBLInfinity/ref/Pairing", 
    "IBLInfinity Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "162ddff3-fa70-4c4b-9f50-4289d409a9d0"],
 ". Without it ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ProductPairing"]], "paclet:IBLInfinity/ref/ProductPairing", 
    "IBLInfinity Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "5e1bf72e-ebf0-4e62-89cc-5a9b6faa9b96"],
 " issues ",
 Cell[BoxData[
  RowBox[{"Pairing", "::", "dual"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "851210da-cc0b-4544-b074-32773051760b"],
 " and aborts."
}], "Notes",ExpressionUUID->"f927e835-22f7-40ae-88ed-2e31ed0645ad"],

Cell[TextData[{
 "Products of different numbers of factors pair to ",
 Cell[BoxData["0"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ade0d9e6-be58-4cda-a06a-77e6e870cd9e"],
 "."
}], "Notes",ExpressionUUID->"f094eefd-ea03-4497-b962-66d757c58a3c"],

Cell[TextData[{
 "The ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"1", "/", 
    StyleBox["k", "TI"]}], "!"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8a014c93-de1c-4734-8c17-0e20b3958901"],
 " in the symmetric convention is what makes the pairing agree with the \
exterior one after the shift, and it is the reason the two pictures return \
different rational numbers on the same underlying data."
}], "Notes",ExpressionUUID->"74f0e3bb-823f-4655-a321-e595d868a20b"]
}, Open  ]],

