Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"dual", " ", "=", " ", 
   RowBox[{"GradedPairing", "[", 
    RowBox[{
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"x", " ", "->", " ", 
        RowBox[{"-", "1"}]}], ",", " ", 
       RowBox[{"y", " ", "->", " ", "0"}]}], "|>"}], ",", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "y"}], "}"}], " ", "->", " ", "1"}], "|>"}], ",",
      " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"a", " ", "->", " ", 
        RowBox[{"-", "1"}]}], ",", " ", 
       RowBox[{"b", " ", "->", " ", "0"}]}], "|>"}], ",", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{"x", ",", " ", "a"}], "}"}], " ", "->", " ", "1"}], ",", " ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"y", ",", " ", "b"}], "}"}], " ", "->", " ", "1"}]}], 
      "|>"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"ProductPairing", "[", 
    RowBox[{
     RowBox[{"SymmetricProduct", "[", 
      RowBox[{
       RowBox[{"CyclicWord", "[", 
        RowBox[{"{", 
         RowBox[{"x", ",", " ", "y"}], "}"}], "]"}], ",", " ", "dual"}], 
      "]"}], ",", " ", 
     RowBox[{"SymmetricProduct", "[", 
      RowBox[{
       RowBox[{"CyclicWord", "[", 
        RowBox[{"{", 
         RowBox[{"a", ",", " ", "b"}], "}"}], "]"}], ",", " ", "dual"}], 
      "]"}], ",", " ", "dual"}], "]"}], ",", " ", 
   RowBox[{"DualPairing", "[", 
    RowBox[{
     RowBox[{"CyclicWord", "[", 
      RowBox[{"{", 
