Cell[TextData[{
 "Two one-factor-each products, in the symmetric convention with its ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"1", "/", "2"}], "!"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "656d9849-fd2d-42ea-81a9-587135deb100"],
 ":"
}], "ExampleText",ExpressionUUID->"31bb9687-96f7-46bf-87d0-2b5fbe3c4407"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"dual", " ", "=", " ", 
   RowBox[{"Pairing", "[", 
    RowBox[{
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"x", " ", "->", " ", 
        RowBox[{"-", "1"}]}], ",", " ", 
       RowBox[{"y", " ", "->", " ", "0"}]}], "|>"}], ",", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "y"}], "}"}], " ", "->", " ", "1"}], "|>"}], ",",
      " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"a", " ", "->", " ", 
        RowBox[{"-", "1"}]}], ",", " ", 
       RowBox[{"b", " ", "->", " ", "0"}]}], "|>"}], ",", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{"x", ",", " ", "a"}], "}"}], " ", "->", " ", "1"}], ",", " ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"y", ",", " ", "b"}], "}"}], " ", "->", " ", "1"}]}], 
      "|>"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"ProductPairing", "[", 
  RowBox[{
   RowBox[{"SymmetricProduct", "[", 
    RowBox[{
     RowBox[{"CyclicWord", "[", 
      RowBox[{"{", "x", "}"}], "]"}], ",", " ", 
     RowBox[{"CyclicWord", "[", 
      RowBox[{"{", "y", "}"}], "]"}], ",", " ", "dual"}], "]"}], ",", " ", 
   RowBox[{"SymmetricProduct", "[", 
    RowBox[{
     RowBox[{"CyclicWord", "[", 
      RowBox[{"{", "a", "}"}], "]"}], ",", " ", 
     RowBox[{"CyclicWord", "[", 
      RowBox[{"{", "b", "}"}], "]"}], ",", " ", "dual"}], "]"}], ",", " ", 
   "dual"}], "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"1812d571-3209-4cdf-a31b-d198ea7cd0da"],

Cell[BoxData[
 FractionBox["1", "2"]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"cfd2da76-73ba-4962-8fcd-bb30d85f815e"]
}, Open  ]],

