Cell[CellGroupData[{
Cell["ProductPairing", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"f1c19ebe-2cc2-4e9a-9fcf-7e5e6c4c6651"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["ProductPairing"]], "paclet:IBLInfinity/ref/ProductPairing", 
     "IBLInfinity Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["f", "TI"], ",", " ", 
    StyleBox["e", "TI"], ",", " ", 
    StyleBox["pairing", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d54cef5f-9deb-4473-bea3-b371b7080a62"],
 "\[LineSeparator]",
 "evaluates a product ",
 StyleBox["f", "TI"],
 " of cyclic words on a product ",
 StyleBox["e", "TI"],
 " of dual cyclic words of the same number of factors.",
 "\n"
}], "Usage",ExpressionUUID->"bff306d3-af1a-4db7-9338-f38a7b36496c"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ProductPairing"]], "paclet:IBLInfinity/ref/ProductPairing", 
    "IBLInfinity Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "6307ad01-f6f8-4418-a4ad-f4bab79abef0"],
 " extends ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DualPairing"]], "paclet:IBLInfinity/ref/DualPairing", 
    "IBLInfinity Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "b8392a13-9de6-492c-b5fe-0c14617e8ef9"],
 " from words to products. It sums over all matchings of the factors of ",
 StyleBox["f", "TI"],
 " with the factors of ",
 StyleBox["e", "TI"],
 ", each term the product of the factorwise ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DualPairing"]], "paclet:IBLInfinity/ref/DualPairing", 
    "IBLInfinity Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "859f2370-24cf-4ea9-b3b2-b945cf3d7b24"],
 " values times the Koszul sign of the permutation that realizes the matching."
}], "Notes",ExpressionUUID->"2f3bbbd6-58ac-4f0a-b3b7-791c8a6266b5"],

Cell[TextData[{
 "The convention key of ",
 StyleBox["pairing", "TI"],
 " decides both the product it expects and the weight it applies:"
}], "Notes",ExpressionUUID->"39e764d8-b87e-4067-b2c1-d55fdab4d896"],

