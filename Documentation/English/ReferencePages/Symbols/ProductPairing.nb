Cell[CellGroupData[{
Cell["ProductPairing", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"7a7aea48-ad27-4146-aa40-e83236ed0770"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["ProductPairing"]], "paclet:ChernSimons/ref/ProductPairing", 
     "ChernSimons Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["f", "TI"], ",", " ", 
    StyleBox["e", "TI"], ",", " ", 
    StyleBox["pairing", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "48f2da40-84f8-4fcb-808a-e0fd7eb9cefa"],
 "\[LineSeparator]",
 "evaluates a product ",
 StyleBox["f", "TI"],
 " of cyclic words on a product ",
 StyleBox["e", "TI"],
 " of dual cyclic words of the same number of factors.",
 "\n"
}], "Usage",ExpressionUUID->"252bb23b-f948-40a1-b772-e8e42ed2ec21"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ProductPairing"]], "paclet:ChernSimons/ref/ProductPairing", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "5fef8155-02a1-4887-9d47-483e32fd7376"],
 " extends ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DualPairing"]], "paclet:ChernSimons/ref/DualPairing", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "baf8317d-120a-4cb5-8c15-485826de6e23"],
 " from words to products. It sums over all matchings of the factors of ",
 StyleBox["f", "TI"],
 " with the factors of ",
 StyleBox["e", "TI"],
 ", each term the product of the factorwise ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DualPairing"]], "paclet:ChernSimons/ref/DualPairing", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "bb650bd5-a96b-49fd-bbd7-39d377243329"],
 " values times the Koszul sign of the permutation that realizes the matching."
}], "Notes",ExpressionUUID->"37f4f7f4-beaa-46fb-b8de-01cbcd4e0412"],

Cell[TextData[{
 "The convention key of ",
 StyleBox["pairing", "TI"],
 " decides both the product it expects and the weight it applies:"
}], "Notes",ExpressionUUID->"8f6b211f-827d-4ff7-b964-a4f60e8ac23d"],

