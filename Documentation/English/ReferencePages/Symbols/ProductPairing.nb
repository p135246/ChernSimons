Cell[TextData[{
 StyleBox["pairing", "TI"],
 " must carry a ",
 Cell[BoxData["\"\<Dual\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "94c496ad-c9d8-46d1-a74f-f66d5cc7e22f"],
 " key, so it has to be built with the four-argument form of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["GradedPairing"]], "paclet:ChernSimons/ref/GradedPairing", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "59e522f7-2b1b-4a76-960b-64e37d0847cc"],
 ". Without it ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ProductPairing"]], "paclet:ChernSimons/ref/ProductPairing", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "b4713263-ec6d-4b5f-a4cc-fc215b141c03"],
 " issues ",
 Cell[BoxData[
  RowBox[{"GradedPairing", "::", "dual"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2455a187-8d66-40a6-b26a-bc7736bf54e7"],
 " and aborts."
}], "Notes",ExpressionUUID->"8b61203b-c4fe-4cd2-a242-460b2f213633"],

Cell[TextData[{
 "Products of different numbers of factors pair to ",
 Cell[BoxData[
  FormBox["0", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "131518ac-acbc-4ac8-81e5-bda81e7f5d80"],
 "."
}], "Notes",ExpressionUUID->"8b55716b-57cb-4c35-b363-3b6c4dda0cfd"],

Cell[TextData[{
 "The ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "/", 
    StyleBox["k", "TI"], "!"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5db52604-1c42-40bd-9770-e6fd54080e8d"],
 " in the symmetric convention is what makes the pairing agree with the \
exterior one after the shift, and it is the reason the two pictures return \
different rational numbers on the same underlying data."
}], "Notes",ExpressionUUID->"2f6e7bea-3c49-4121-bb12-58410461c9ce"]
}, Open  ]],

