  FontSize->0.9 Inherited,ExpressionUUID->
  "8cf1d3c9-7b5b-4513-ae2a-090daeda466e"],
 ", ",
 Cell[BoxData["\"\<Pairing\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "26eff999-a5b3-4aee-a93d-bf9daeddfc7a"],
 ", ",
 Cell[BoxData["\"\<DifferentialPairing\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c73538b7-ffaa-4728-9520-ab395f1458d2"],
 ", ",
 Cell[BoxData["\"\<Differential\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1865e1a7-7c4d-40a2-b3a8-9c2797006601"],
 " and ",
