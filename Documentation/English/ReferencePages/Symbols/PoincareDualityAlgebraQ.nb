Cell[TextData[{
 "A PoincareDualityAlgebra object is the tagged object that ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["NondegenerateQuotient"]], 
    "paclet:ChernSimons/ref/NondegenerateQuotient", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "29832724-bc17-4770-8e49-e7508ac9a263"],
 " gives on a model and that ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["PoincareDualityAlgebra"]], 
    "paclet:ChernSimons/ref/PoincareDualityAlgebra", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "f29c97ff-67d6-4ab1-9ba7-fe54a9f5b8af"],
 " gives, a head wrapping an Association."
}], "Notes",
 CellFrameLabels->{{Inherited, Inherited}, {Inherited, 
    Cell[
     TextData[{
      "26.09.30: Design review - the recognizer came with the tagged head, \
when the eight-key result of NondegenerateQuotient became the \
PoincareDualityAlgebra object (T0b, 2026-09-21), under the rule that every \
object of the paclet is one head with a Q predicate; the object is what the \
algebraic models hand to GradedPairing. Until R7 it tested the head and the \
Association inside it only, so PoincareDualityAlgebra[<||>] was recognized; \
since R7 (Pavel, 2026-10-01) it tests the keys of the data and their kinds, \
and is True exactly on what PoincareDualityAlgebra[complex] and \
NondegenerateQuotient build, so it is no stricter than GradedPairing[algebra] \
and CochainComplexWithPairing[algebra], which take those objects. It does not \
validate the mathematics, as PureMath's ChainComplexQ does; that is recorded \
as open in the HodgeDecompositions hand-off. Prior art: the Wolfram Language \
has no Poincar\[EAcute] duality algebras; the engine the verification suites \
load keeps the quotient as a plain Association and has no recognizer.", 
       "\n\n", 
       Cell[
        BoxData[
         GridBox[{{
            Cell[
             BoxData[
              ButtonBox[
               DynamicBox[
                FEPrivate`FrontEndResource[
                "DocumentationToolsStrings", "Edit"]], BaseStyle -> 
               "TextAnnotationButton"]]], 
            StyleBox[
             RowBox[{
               DynamicBox[
                FEPrivate`FrontEndResource[
                "DocumentationToolsStrings", "LastAnnotator"]], "pavel"}], 
             "TextAnnotator"], 
            Cell[
             BoxData[
              ButtonBox[
               DynamicBox[
                FEPrivate`FrontEndResource[
                "DocumentationToolsStrings", "Delete"]], BaseStyle -> 
               "TextAnnotationRemoveButton"]]], ""}}, 
          GridBoxAlignment -> {
           "Columns" -> {Left, Left, Right, Right}, "Rows" -> {{Automatic}}}, 
          GridBoxItemSize -> {"Columns" -> {
              Scaled[0.15], 
              Scaled[0.68], 
              Scaled[0.15], 
              Scaled[0.02]}}]]], "\n"}], "TextAnnotation", 
     CellSize -> {590, Inherited}]}},
 CellTags->"TextAnnotation",
 CellID->344962077,ExpressionUUID->"54d8b256-355f-4d59-91a5-aae1c8c02510"],

