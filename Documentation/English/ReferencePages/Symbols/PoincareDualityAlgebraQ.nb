 ", ",
 Cell[BoxData["\"\<Basis\>\""], "InlineFormula",ExpressionUUID->
  "50bdbfcb-fb56-48b2-86d4-07a8172fc5aa"],
 ", ",
 Cell[BoxData["\"\<Degrees\>\""], "InlineFormula",ExpressionUUID->
  "5d880faa-4249-46bd-82a6-30822dabcdd9"],
 ", ",
 Cell[BoxData["\"\<Pairing\>\""], "InlineFormula",ExpressionUUID->
  "7634ddb5-18b6-498d-bfdc-aeac819d5400"],
 ", ",
 Cell[BoxData["\"\<DifferentialPairing\>\""], "InlineFormula",ExpressionUUID->
  "c85944e8-2153-49fb-800c-6474d6ecbf09"],
 ", ",
 Cell[BoxData["\"\<Differential\>\""], "InlineFormula",ExpressionUUID->
  "9e186a66-dbd8-44b1-83c9-682fdec044b7"],
 " and ",
 Cell[BoxData["\"\<Triple\>\""], "InlineFormula",ExpressionUUID->
  "92104734-3062-4e9b-8859-d6cff0581779"],
 ", of the kinds the constructors give."
}], "Notes",ExpressionUUID->"e00032e8-060d-444a-a476-8cb8a9fbd4ee"],

Cell["It does not check that the data inside is consistent.", "Notes",ExpressionUUID->"3a3a2380-b443-4bdf-829e-2b425c5cc9e9"],

