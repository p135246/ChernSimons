  "cd4568d3-97f1-4e33-b89f-a493d13033f6"],
 ", ",
 Cell[BoxData["\"\<Basis\>\""], "InlineFormula",ExpressionUUID->
  "217e7525-cef5-4e66-83e0-877219d1851d"],
 ", ",
 Cell[BoxData["\"\<Degrees\>\""], "InlineFormula",ExpressionUUID->
  "472ec7d6-e9e1-409d-99a0-fe95e28470c3"],
 ", ",
 Cell[BoxData["\"\<Pairing\>\""], "InlineFormula",ExpressionUUID->
  "71f4ab31-90d1-4497-86c7-dfed4fb627ef"],
 ", ",
 Cell[BoxData["\"\<DifferentialPairing\>\""], "InlineFormula",ExpressionUUID->
  "064a9b16-2a9e-49a4-8569-ed03d0c9d75b"],
 ", ",
 Cell[BoxData["\"\<Differential\>\""], "InlineFormula",ExpressionUUID->
  "ac98ed5e-564f-46b4-9b07-a42142ed4e64"],
 " and ",
 Cell[BoxData["\"\<Triple\>\""], "InlineFormula",ExpressionUUID->
  "3c1bf340-78c5-4ae9-bf14-6d3477ed137b"],
 ", of the kinds the constructors give."
}], "Notes",ExpressionUUID->"3acb3d3a-a0f4-47ca-a893-f1874c1ac940"],

Cell["It does not check that the data inside is consistent.", "Notes",ExpressionUUID->"bd4bc52e-cb4a-4faf-8895-7c2d16a987ff"],

