Cell[CellGroupData[{
Cell["BeilinsonDrinfeldMasterEquation", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"41041241-baf2-4ed7-b924-3dbd5c1b8775"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["BeilinsonDrinfeldMasterEquation"]], 
     "paclet:ChernSimons/ref/BeilinsonDrinfeldMasterEquation", 
     "ChernSimons Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["s", "TI"], ",", " ", 
    StyleBox["pairing", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "03777ca3-8004-4996-b485-1e540cd0d90c"],
 "\[LineSeparator]",
 "gives the obstruction ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{"\[CapitalDelta]", 
     StyleBox["s", "TI"], "+", "1"}], 
    RowBox[{"2", 
     RowBox[{"{", 
      RowBox[{
       StyleBox["s", "TI"], ",", 
       StyleBox["s", "TI"]}], "}"}]}]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bf752165-0464-4c5a-b7c8-4ec5d16df00d"],
 " of the BD master equation for the BD action ",
 StyleBox["s", "TI"],
 "; ",
 Cell[BoxData[
  FormBox["0", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e16d9ee5-f8a9-4e41-87cc-55d63764cc12"],
 " means ",
 StyleBox["s", "TI"],
 " solves it.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"51e80002-9a65-4a23-b4a4-7b5073f1cff4"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["BeilinsonDrinfeldMasterEquation"]], 
     "paclet:ChernSimons/ref/BeilinsonDrinfeldMasterEquation", 
     "ChernSimons Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["s", "TI"], ",", " ", 
    StyleBox["pairing", "TI"], ",", " ", "\"\<Equations\>\""}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9bcb99ba-96e6-448b-9ca6-cb396fa060b6"],
 "\[LineSeparator]",
 "gives instead the Association of scalar equations, one per monomial of the \
obstruction."
}], "Usage",ExpressionUUID->"4afda1ab-b1f0-48b0-bca3-078d8b03bd4c"],

Cell[TextData[{
 "The equation is taken over ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["R",
     FontSlant->"Plain"], 
    RowBox[{"[", 
     RowBox[{"[", "]"}], "]"}]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c95f5231-addf-4fe9-99e8-e3f0a293e5e6"],
 ", without inverting ",
 Cell[BoxData[
  FormBox["\[Null]", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b45a7289-d70f-4e8b-baaf-2379780ebb3a"],
 ". The bracket is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["BeilinsonDrinfeldBracket"]], 
    "paclet:ChernSimons/ref/BeilinsonDrinfeldBracket", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "3a7ff96a-3d84-4a38-bef8-5167115d0152"],
 ", not the derived one, so no negative power of ",
 Cell[BoxData[
  FormBox["\[Null]", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8abfb480-f8e6-40dc-8100-2731bfe6b01e"],
 " appears anywhere."
}], "Notes",ExpressionUUID->"d0a60169-8331-4613-a372-3ee14da26b9f"],

Cell[TextData[{
 "A BD action is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["S", "TI"], 
     StyleBox["m", "TI"]], "\[LongEqual]", 
    UnderscriptBox["\[Sum]", 
     RowBox[{
      StyleBox["g", "TI"], "\[GreaterEqual]", "0"}],
     LimitsPositioning->True], 
    UnderscriptBox["\[Sum]", 
     RowBox[{"\[ScriptL]", "\[GreaterEqual]", "1"}],
     LimitsPositioning->True], 
    SubsuperscriptBox[
     StyleBox["m", "TI"], 
     RowBox[{"\[ScriptL]", ",", 
      StyleBox["g", "TI"]}], 
     StyleBox["g", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "47bec6d8-55f5-425c-bca9-db08ec9b5713"],
 ", of symmetric degree ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["PlanckDegree"]], "paclet:ChernSimons/ref/PlanckDegree", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "420460df-c044-4304-be93-5c4d22e4796a"],
 "[",
 StyleBox["pairing", "TI"],
 "]. The coefficient of the master equation in ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["S",
     FontSlant->"Plain"], "\[ScriptL]", 
    StyleBox["g", "TI"]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8529d695-d8bc-45f0-b959-41a5de180cd4"],
 " is exactly the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"\[ScriptL]", ",", 
     StyleBox["g", "TI"]}], ")"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "35fdbd0b-864e-424b-b056-a03d34d13e24"],
 " Maurer-Cartan equation, which is why ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["MaurerCartanEquation"]], 
    "paclet:ChernSimons/ref/MaurerCartanEquation", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "98ec195e-994d-4afd-ba48-4f02ba6d6a03"],
 " is the same function under another name."
}], "Notes",ExpressionUUID->"77585602-7870-4738-b65f-44337b6d39f9"],

Cell[TextData[{
 "In the ",
 Cell[BoxData["\"\<Equations\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bb53b9f0-b8a0-4629-b339-c41f1498b279"],
 " form the keys are the monomials \[LongDash] a power of ",
 Cell[BoxData[
  FormBox["\[Null]", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ac044ddf-a287-4870-8807-26b790c31ae6"],
 " times a product of cyclic words \[LongDash] and the values the scalar \
coefficients, each of which must vanish. That is the form to hand to ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Solve"]], "paclet:ref/Solve"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5f4ba68b-4d3f-44e4-8909-fbf5cf6d6077"],
 "."
}], "Notes",ExpressionUUID->"ef7d3dda-2517-4c06-bf6b-f849d9048e7c"]
}, Open  ]],

