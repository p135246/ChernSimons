 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["im",
     FontSlant->"Plain"], " ", 
    StyleBox["d",
     FontSlant->"Plain"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "37b333d6-1efc-421e-af61-07d7de58abf1"],
 " in ",
 Cell[BoxData[
  FormBox[
   RowBox[{"ker", 
    StyleBox["d",
     FontSlant->"Plain"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "a6cc96dd-7abb-48f3-8da5-394c8bd4ed87"],
 ", ",
 Cell[BoxData[
  FormBox[
   StyleBox["C", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "373bbddf-0542-4e4f-b2e8-d1ebbf3bd0b8"],
 " a complement of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"ker", 
    StyleBox["d",
     FontSlant->"Plain"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "2baef483-f38d-4d0d-836d-d30c74f6f267"],
 ", and ",
