            GraphicsBox[{{
               GrayLevel[0.35], 
               AbsoluteThickness[1.1], 
               CapForm["Round"]}, 
              LineBox[{{-1, 0.8}, {1, 0.8}}], 
              LineBox[{{-1, 0}, {1, 0}}], 
              LineBox[{{-1, -0.8}, {1, -0.8}}], 
              DiskBox[{-0.6, 0.8}, 0.13], 
              DiskBox[{0, 0}, 0.13], 
              DiskBox[{0.6, -0.8}, 0.13]}, ImageSize -> {Automatic, 22}, 
             PlotRange -> 1.3, Background -> None], 
            GridBox[{{
               RowBox[{
                 TagBox["\"harmonic: \"", "SummaryItemAnnotation"], 
                 "\[InvisibleSpace]", 
                 TagBox[
                  TemplateBox[{", ", "\", \"", 
                    TemplateBox[{"0", "\": \"", "1"}, "RowDefault"], 
                    TemplateBox[{"1", "\": \"", "3"}, "RowDefault"], 
                    TemplateBox[{"2", "\": \"", "4"}, "RowDefault"], 
                    TemplateBox[{"3", "\": \"", "3"}, "RowDefault"], 
                    TemplateBox[{"4", "\": \"", "1"}, "RowDefault"]}, 
                   "RowWithSeparators"], "SummaryItem"]}]}, {
               RowBox[{
                 TagBox["\"coexact: \"", "SummaryItemAnnotation"], 
                 "\[InvisibleSpace]", 
                 TagBox[
                  TemplateBox[{", ", "\", \"", 
                    TemplateBox[{"1", "\": \"", "1"}, "RowDefault"], 
                    TemplateBox[{"2", "\": \"", "1"}, "RowDefault"]}, 
                   "RowWithSeparators"], "SummaryItem"]}]}, {
               RowBox[{
                 TagBox["\"harmonic basis: \"", "SummaryItemAnnotation"], 
                 "\[InvisibleSpace]", 
                 TagBox[
                  TagBox[
                   GridBox[{{
                    TemplateBox[{"0", "\": \"", 
                    TemplateBox[{", ", "\", \"", "1"}, "RowWithSeparators"]}, 
                    "RowDefault"]}, {
                    TemplateBox[{"1", "\": \"", 
                    
                    TemplateBox[{", ", "\", \"", "t", "y", "x"}, 
                    "RowWithSeparators"]}, "RowDefault"]}, {
                    TemplateBox[{"2", "\": \"", 
                    TemplateBox[{", ", "\", \"", 
                    RowBox[{"t", " ", "y"}], 
                    RowBox[{"y", " ", "z"}], 
                    RowBox[{"t", " ", "x"}], 
                    RowBox[{"x", " ", "z"}]}, "RowWithSeparators"]}, 
