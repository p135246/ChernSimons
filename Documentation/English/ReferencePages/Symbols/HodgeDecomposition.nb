Cell[TextData[{
 "A Hodge decomposition of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     StyleBox["V", "TI"], ",", 
     StyleBox["d",
      FontSlant->"Plain"], ",", 
     RowBox[{"\[LeftAngleBracket]", 
      RowBox[{"-", ",", "-"}], "\[RightAngleBracket]"}]}], ")"}], 
   TraditionalForm]], "InlineFormula",ExpressionUUID->
  "930363b3-49c5-483d-8cb7-63788cd3f488"],
 " is a pre-Hodge decomposition whose coexact part is isotropic: ",
 Cell[BoxData[
  FormBox[
   StyleBox["H", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "c93dd14c-bb55-4aea-bfa4-3908ffb61356"],
