Cell["\<\
The identity holds on the shortest word with a nonzero co-bracket:\
\>", "ExampleText",ExpressionUUID->"2e62bf47-0cf5-4e40-adb5-3a08b88fd651"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"CoJacobiObstruction", "[", 
  RowBox[{
   RowBox[{"CyclicWord", "[", 
    RowBox[{"{", 
     RowBox[{"x", ",", " ", "y", ",", " ", "y", ",", " ", "y"}], "}"}], "]"}],
    ",", " ", 
   RowBox[{"GradedPairing", "[", 
    RowBox[{
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"x", " ", "->", " ", 
        RowBox[{"-", "1"}]}], ",", " ", 
       RowBox[{"y", " ", "->", " ", "0"}]}], "|>"}], ",", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "y"}], "}"}], " ", "->", " ", "1"}], "|>"}]}], 
    "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"c24b3e9f-9a6d-4286-93f9-739cedc216fd"],

Cell[BoxData["0"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"953db1e3-0a1e-4e19-8056-382fde096786"]
}, Open  ]],

