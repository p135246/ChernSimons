Cell["\<\
Sweeping it over an enumerated range of words, every value is zero:\
\>", "ExampleText",ExpressionUUID->"d7d56585-a98f-402f-8989-4bec38357426"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"words", "[", "n_", "]"}], " ", ":=", " ", 
   RowBox[{"CyclicWords", "[", 
    RowBox[{"n", ",", " ", 
     RowBox[{"GradedPairing", "[", 
      RowBox[{
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"x", " ", "->", " ", 
          RowBox[{"-", "1"}]}], ",", " ", 
         RowBox[{"y", " ", "->", " ", "0"}]}], "|>"}], ",", " ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"x", ",", " ", "y"}], "}"}], " ", "->", " ", "1"}], 
        "|>"}]}], "]"}], ",", " ", 
     RowBox[{"\"\<UpTo\>\"", " ", "->", " ", "True"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"DeleteDuplicates", "[", 
  RowBox[{"Map", "[", 
   RowBox[{
    RowBox[{"w", " ", "|->", " ", 
     RowBox[{"Expand", "[", 
      RowBox[{"CoJacobiObstruction", "[", 
       RowBox[{"w", ",", " ", 
        RowBox[{"GradedPairing", "[", 
         RowBox[{
          RowBox[{"<|", 
           RowBox[{
            RowBox[{"x", " ", "->", " ", 
             RowBox[{"-", "1"}]}], ",", " ", 
            RowBox[{"y", " ", "->", " ", "0"}]}], "|>"}], ",", " ", 
          RowBox[{"<|", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"x", ",", " ", "y"}], "}"}], " ", "->", " ", "1"}], 
           "|>"}]}], "]"}]}], "]"}], "]"}]}], ",", " ", 
    RowBox[{"words", "[", "5", "]"}]}], "]"}], "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"cb36877c-acfb-43da-b56e-43ee2e9496d8"],

Cell[BoxData[
 RowBox[{"{", "0", "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"6813d60d-3acf-4368-b799-87d9eda1e476"]
}, Open  ]],

