Cell[CellGroupData[{
Cell["CoJacobiObstruction", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"d773862e-769e-420b-bba0-80e040e91090"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["CoJacobiObstruction"]], 
     "paclet:ChernSimons/ref/CoJacobiObstruction", 
     "ChernSimons Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["w", "TI"], ",", " ", 
    StyleBox["pairing", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c733d254-9523-4c6c-b9d1-da044e2a5183"],
 "\[LineSeparator]",
 "gives the co-Jacobi obstruction of a cyclic word; ",
 Cell[BoxData[
  FormBox["0", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7394e38f-3731-4ba2-979c-3e61f9f6e3c2"],
 " means the identity holds there.",
 "\n"
}], "Usage",ExpressionUUID->"1ae1c4db-f3db-491f-b07b-1eb734d3643f"],

Cell[TextData[{
 "The obstruction is the composite ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     OverscriptBox[
      StyleBox["q", "TI"], "^"], 
     RowBox[{"1", ",", "2", ",", "0"}]], "\[EmptySmallCircle]", 
    SubscriptBox[
     OverscriptBox[
      StyleBox["q", "TI"], "^"], 
     RowBox[{"1", ",", "2", ",", "0"}]]}], TraditionalForm]], "InlineFormula",
  
  FontSize->0.9 Inherited,ExpressionUUID->
  "56f526ae-1d61-4713-adcd-fcfae1bfaffc"],
 " applied to ",
 StyleBox["w", "TI"],
 " \[LongDash] the co-Jacobi identity written as the statement that the \
co-derivation extension of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InvolutiveCobracket"]], 
    "paclet:ChernSimons/ref/InvolutiveCobracket", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "d2862b32-4b64-4dfa-ab59-e884bf0bf5c9"],
 " squares to zero."
}], "Notes",ExpressionUUID->"3bdd982c-6f37-4097-8217-1c99a3769db0"],

Cell[TextData[{
 "The convention key of ",
 StyleBox["pairing", "TI"],
 " selects the picture, exactly as it does for ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InvolutiveCobracket"]], 
    "paclet:ChernSimons/ref/InvolutiveCobracket", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "7027a85c-a099-4262-b2b7-61d584a3bf4e"],
 "."
}], "Notes",ExpressionUUID->"75358064-397b-448d-8b05-723fa61400b7"],

Cell[TextData[{
 "The identity is dual to the one ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["JacobiObstruction"]], 
    "paclet:ChernSimons/ref/JacobiObstruction", "ChernSimons Package Symbol"},
   
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "e7cbe267-e1fb-497e-b8ba-2dc022763bb2"],
 " tests, and takes one word rather than three: the co-bracket raises the \
number of factors, so composing it with itself already involves every cut of \
the single input word."
}], "Notes",ExpressionUUID->"654fe4c7-00e9-4b37-8e9d-1cc7ab199c5a"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CoJacobiObstruction"]], 
    "paclet:ChernSimons/ref/CoJacobiObstruction", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "1e25ba29-b035-402e-93a1-7a162bfba53c"],
 " is the arity-",
 Cell[BoxData[
  FormBox["1", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7d9db6f5-2240-429b-a7cc-4274a4d72183"],
 " entry of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["$DefiningIdentities"]], 
    "paclet:ChernSimons/ref/$DefiningIdentities", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "f6e54136-876b-4b71-9a2d-c609611601ab"],
 "."
}], "Notes",ExpressionUUID->"7d95dfd7-3374-4ffd-b186-43e9c081d41a"],

Cell[TextData[{
 "Words short enough to have vanishing ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InvolutiveCobracket"]], 
    "paclet:ChernSimons/ref/InvolutiveCobracket", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "0943e4bb-1889-4fbd-b2a5-4aae9f7dd0b6"],
 " have vanishing obstruction for trivial reasons; the first informative test \
over the alphabet of the circle is at length ",
 Cell[BoxData[
  FormBox["4", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "24f2753c-218c-4ec6-a1c8-4c35dab49caf"],
