Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"fd20c4b4-3d27-4108-98ab-0c59822fc5e8"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["StringBeilinsonDrinfeldOperator"]], 
     "paclet:ChernSimons/ref/StringBeilinsonDrinfeldOperator", 
     "ChernSimons Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["e", "TI"], ",", " ", 
    StyleBox["pairing", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2c98f6f5-8765-4f46-bb47-572ef471ec95"],
 "\[LineSeparator]",
 "gives the operator ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalDelta]", "\[LongEqual]", 
    SubscriptBox[
     OverscriptBox[
      StyleBox["q", "TI"], "^"], 
     RowBox[{"1", ",", "1", ",", "0"}]], "+", 
    SubscriptBox[
     OverscriptBox[
      StyleBox["q", "TI"], "^"], 
     RowBox[{"1", ",", "2", ",", "0"}]], "+", 
    RowBox[{"\[HBar]", " "}], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["q", "TI"], "^"], 
     RowBox[{"2", ",", "1", ",", "0"}]]}], TraditionalForm]], "InlineFormula",
  
  FontSize->0.9 Inherited,ExpressionUUID->
  "61e26e57-9b7d-41c1-835f-6cd55fdae183"],
 " of the Beilinson-Drinfeld algebra, applied to ",
 StyleBox["e", "TI"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"7e1c64f2-bcdb-4b35-97b4-ad97457dda96"],

Cell[TextData[{
 Cell[BoxData[
  FormBox["\[CapitalDelta]", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a379400e-0bdb-4410-a2e4-ca2044043224"],
 " acts on the symmetric powers of cyclic words, completed over ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["R",
     FontSlant->"Plain"], 
    RowBox[{"[", 
     RowBox[{"[", "\[HBar]", "]"}], "]"}]}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b4288149-5276-4074-99b2-1496e405bc04"],
 ". It is a derivative of order at most ",
 Cell[BoxData[
  FormBox["2", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "93194274-fd8c-4832-abff-54a7419d87ea"],
 " and of symmetric degree ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", "1"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0259c873-a72c-4ff5-a9ce-ad36ec0df8b9"],
 ", and it squares to zero exactly when the underlying structure is a dIBL \
algebra."
}], "Notes",
 CellFrameLabels->{{Inherited, Inherited}, {Inherited, 
    Cell[
     TextData[{
      "26.09.30: Design review - the operator is the sum of three exported \
extensions, CyclicHochschildDifferential + StringCobracket + HBar \
StringBracket, all in the symmetric convention, and carries its own linearity \
rules; HBar is a scalar to every linearity rule and has even degree, so it \
never contributes a sign. A pairing in the exterior convention returns \
unevaluated, since the BD algebra is the symmetric algebra and computing in \
the symmetric product under an exterior key would ignore the one switch \
between the pictures; the decision of R2 was kept by Pavel, who wants the \
conversion between the pictures available, as SymmetricToExterior and \
ExteriorToSymmetric. The option \"EmptyWord\" is passed to the bracket and \
the co-bracket, where the empty word enters. Alternative name considered: \
BeilinsonDrinfeldOperator, the name until 2026-09-30. Prior art: the Wolfram \
Language has no BV or BD operators. T12/paclet-bd-operator-and-bracket pins \
the operator against the bdOperator of the engine the verification suites \
load on every word to length 5 and on the two-factor products of words to \
length 4, and T12/paclet-bd-operator-squares-to-zero pins that it squares to \
zero there.", "\n\n", 
       Cell[
        BoxData[
         GridBox[{{
            Cell[
             BoxData[
              ButtonBox[
               DynamicBox[
                FEPrivate`FrontEndResource[
                "DocumentationToolsStrings", "Edit"]], BaseStyle -> 
               "TextAnnotationButton"]]], 
            StyleBox[
             RowBox[{
               DynamicBox[
                FEPrivate`FrontEndResource[
                "DocumentationToolsStrings", "LastAnnotator"]], "pavel"}], 
             "TextAnnotator"], 
            Cell[
             BoxData[
              ButtonBox[
               DynamicBox[
                FEPrivate`FrontEndResource[
                "DocumentationToolsStrings", "Delete"]], BaseStyle -> 
               "TextAnnotationRemoveButton"]]], ""}}, 
          GridBoxAlignment -> {
           "Columns" -> {Left, Left, Right, Right}, "Rows" -> {{Automatic}}}, 
          GridBoxItemSize -> {"Columns" -> {
              Scaled[0.15], 
              Scaled[0.68], 
              Scaled[0.15], 
              Scaled[0.02]}}]]], "\n"}], "TextAnnotation", 
     CellSize -> {590, Inherited}]}},
 CellTags->"TextAnnotation",
 CellID->316340294,ExpressionUUID->"e510c82d-a0dc-483e-9239-e60c555ea643"],

Cell[TextData[{
 "The first summand is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CyclicHochschildDifferential"]], 
    "paclet:ChernSimons/ref/CyclicHochschildDifferential", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "1a5b8901-e9d3-4308-958a-5d4f271ff50a"],
 " extended as a derivation. It is ",
 Cell[BoxData[
  FormBox["0", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c8600ec9-8214-4ce8-9677-df151210db65"],
 " unless the pairing carries a Poincar\[EAcute] duality algebra with a \
differential, so on a formal alphabet ",
 Cell[BoxData[
  FormBox["\[CapitalDelta]", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f0d86e89-04d4-40ff-bf15-af64b46d1965"],
 " is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     OverscriptBox[
      StyleBox["q", "TI"], "^"], 
     RowBox[{"1", ",", "2", ",", "0"}]], "+", 
    RowBox[{"\[HBar]", " "}], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["q", "TI"], "^"], 
     RowBox[{"2", ",", "1", ",", "0"}]]}], TraditionalForm]], "InlineFormula",
  
  FontSize->0.9 Inherited,ExpressionUUID->
  "378dd831-0e8a-4609-a6d1-79aea1fe7875"],
 "."
}], "Notes",ExpressionUUID->"9889a1d3-f989-428d-a061-b36ec8e63e2a"],

Cell[TextData[{
 "The second summand is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["StringCobracket"]], "paclet:ChernSimons/ref/StringCobracket", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "d8af07d9-5ff0-4595-a3db-02a0b5ebcac2"],
 " extended as a co-derivation, and the third is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["StringBracket"]], "paclet:ChernSimons/ref/StringBracket", 
