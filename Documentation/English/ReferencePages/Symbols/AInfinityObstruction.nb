Cell["\<\
On a strictly associative algebra the relation is associativity, and holds:\
\>", "ExampleText",ExpressionUUID->"704ece77-d5a6-42a6-b55c-e5b11785c337"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"assoc", " ", "=", " ", 
   RowBox[{"AInfinityAlgebra", "[", 
    RowBox[{
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"u", " ", "->", " ", 
        RowBox[{"-", "1"}]}], ",", " ", 
       RowBox[{"v", " ", "->", " ", 
        RowBox[{"-", "1"}]}]}], "|>"}], ",", "\n", "   ", 
     RowBox[{"t", " ", "|->", " ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Length", "[", "t", "]"}], " ", "===", " ", "2"}], ",", " ", 
        
        RowBox[{"Switch", "[", 
         RowBox[{"t", ",", " ", 
          RowBox[{"{", 
           RowBox[{"u", ",", " ", "u"}], "}"}], ",", " ", "u", ",", " ", 
          RowBox[{"{", 
           RowBox[{"u", ",", " ", "v"}], "}"}], ",", " ", "v", ",", " ", 
          RowBox[{"{", 
           RowBox[{"v", ",", " ", "u"}], "}"}], ",", " ", "v", ",", " ", "_", 
          ",", " ", "0"}], "]"}], ",", " ", "0"}], "]"}]}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"AInfinityObstruction", "[", 
    RowBox[{"assoc", ",", " ", 
     RowBox[{"{", 
      RowBox[{"u", ",", " ", "v", ",", " ", "u"}], "}"}]}], "]"}], ",", " ", 
   RowBox[{"AInfinityObstruction", "[", 
    RowBox[{"assoc", ",", " ", 
     RowBox[{"{", 
      RowBox[{"v", ",", " ", "v", ",", " ", "v"}], "}"}]}], "]"}]}], 
  "}"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"698f8b82-5b05-4d9b-85bc-99ea3af9b834"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0", ",", "0"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"5c87689c-dbdb-44ed-a55e-436d8404a8c4"]
}, Open  ]],

