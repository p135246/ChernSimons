Cell[CellGroupData[{
Cell["AInfinityObstruction", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"9103ba9f-9577-41c1-9e56-21c26dbd26ca"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["AInfinityObstruction"]], 
     "paclet:ChernSimons/ref/AInfinityObstruction", 
     "ChernSimons Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["algebra", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["e1", "TI"], ",", " ", "\[Ellipsis]", ",", " ", 
      StyleBox["en", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f5690bda-805c-46a6-9532-27f634615255"],
 "\[LineSeparator]",
 "gives the obstruction of the A-infinity relation on those elements; ",
 Cell[BoxData[
  FormBox["0", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d6ad2810-dba9-43b8-a4a4-04cbf72c18c2"],
 " means the relation holds there.",
 "\n"
}], "Usage",ExpressionUUID->"fbde3fb2-797d-4a23-8c19-5b9f826046f5"],

Cell[TextData[{
 "The convention is the shifted one: the term whose inner operation takes \
arguments ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["r", "TI"], "+", "1"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b61575ab-d8a4-4917-bdb8-cd410c7f13d7"],
 " through ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["r", "TI"], "+", 
    StyleBox["s", "TI"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a7c2d69c-95f7-40ba-ac6d-2a7ff0f7ccc9"],
 " carries the sign of the sum of the shifted degrees of the first ",
 Cell[BoxData[
  FormBox[
   StyleBox["r", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8e544e24-2894-49e0-b990-a2ff0cebdc8a"],
 " arguments,"
}], "Notes",ExpressionUUID->"82667dcd-eae0-47cc-8e34-29d129b3436b"],

Cell[BoxData[
 PaneBox[
  FormBox[
   RowBox[{
    UnderscriptBox["\[Sum]", 
     RowBox[{
      StyleBox["r", "TI"], "+", 
      StyleBox["s", "TI"], "+", 
      StyleBox["t", "TI"], "\[LongEqual]", 
      StyleBox["n", "TI"]}],
     LimitsPositioning->True], 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"-", "1"}], ")"}], 
     TemplateBox[{
       RowBox[{
         SubscriptBox[
          StyleBox["e", "TI"], "1"], "|", "+", "\[CenterEllipsis]", "+", "|", 
         
         SubscriptBox[
          StyleBox["e", "TI"], 
          StyleBox["r", "TI"]]}]},
      "Abs"]], " ", 
    SubscriptBox[
     StyleBox["m", "TI"], 
     RowBox[{
      StyleBox["r", "TI"], "+", "1", "+", 
      StyleBox["t", "TI"]}]], 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox[
       StyleBox["e", "TI"], "1"], ",", "\[Ellipsis]", ",", 
      SubscriptBox[
       StyleBox["e", "TI"], 
       StyleBox["r", "TI"]], ",", 
      SubscriptBox[
       StyleBox["m", "TI"], 
       StyleBox["s", "TI"]], 
      RowBox[{"(", 
       RowBox[{
        SubscriptBox[
         StyleBox["e", "TI"], 
         RowBox[{
          StyleBox["r", "TI"], "+", "1"}]], ",", "\[Ellipsis]", ",", 
        SubscriptBox[
         StyleBox["e", "TI"], 
         RowBox[{
          StyleBox["r", "TI"], "+", 
          StyleBox["s", "TI"]}]]}], ")"}], ",", "\[Ellipsis]", ",", 
      SubscriptBox[
       StyleBox["e", "TI"], 
       StyleBox["n", "TI"]]}], ")"}], "."}],
   TraditionalForm],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",ExpressionUUID->"5c32d9fb-8681-4dc4-\
8a5f-77e975fc22ca"]
}, Open  ]],

