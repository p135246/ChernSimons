Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "969b79f3-985f-43dc-897f-13a4ba7306d9"], Cell["Method", "TableText",
     FontWeight->Bold,ExpressionUUID->"1b47ab99-f152-41dc-9d53-cf3996286ede"],
     Cell["Subspace", "TableText",
     FontWeight->Bold,ExpressionUUID->"c92ebc26-2291-4f7e-96bf-433a1bdd67af"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "4fda40cc-df6e-432e-8ff5-6abcd4ff32cf"], Cell[TextData[Cell[
    BoxData["\"\<BasisOrder\>\""], "InlineFormula",ExpressionUUID->
     "f1ca6d07-a9e2-475b-91ec-5657d7094e3e"]], "TableText",ExpressionUUID->
     "d8b1d873-ab02-45c1-b479-78a89553f5f9"], Cell[TextData[{
     "the first cocycles, closed basis elements first, that are independent \
modulo ",
     Cell[BoxData[
      FormBox[
       RowBox[{
        StyleBox["im",
         FontSlant->"Plain"], " ", 
        StyleBox["d",
         FontSlant->"Plain"]}], TraditionalForm]], "InlineFormula",
      ExpressionUUID->"6635518e-9972-43d1-84a3-51dec8adcf2c"]
    }], "TableText",ExpressionUUID->"aec64d5c-eccc-430d-96c7-9c89e1905fd6"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "3a8a24f8-5bcd-4ac7-98bf-7b95fa468c51"], Cell[TextData[Cell[
    BoxData["\"\<Adjoint\>\""], "InlineFormula",ExpressionUUID->
     "4112a724-8c50-45fa-9c47-1ebe2355b5f8"]], "TableText",ExpressionUUID->
     "fe63eeca-235e-4310-a7fc-1ec696f31f56"], Cell[TextData[{
     Cell[BoxData[
      FormBox[
       RowBox[{"ker", 
        StyleBox["d",
         FontSlant->"Plain"], "\[Intersection]", "ker", 
        SuperscriptBox[
         StyleBox["d",
          FontSlant->"Plain"], 
         StyleBox["T",
          FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
      ExpressionUUID->"371eeb61-090b-428d-a2df-4e33656859c3"],
     ", with ",
     Cell[BoxData[
      FormBox[
       SuperscriptBox[
        StyleBox["d",
         FontSlant->"Plain"], 
        StyleBox["T",
         FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
      ExpressionUUID->"7aed7303-abdb-421e-9fe2-59d8d62de5df"],
     " the transpose of ",
     Cell[BoxData[
      FormBox[
       StyleBox["d",
        FontSlant->"Plain"], TraditionalForm]], "InlineFormula",
      ExpressionUUID->"cf4f54fe-ec03-48ba-a0b3-3c6a63b2b7cb"],
     " in the basis"
    }], "TableText",ExpressionUUID->"84f5352c-f250-4af9-a077-23272bd942bd"]}
  }]], "2ColumnTableMod",ExpressionUUID->"1f969518-f779-482d-bf7d-\
a2ee0618f41d"],

Cell[TextData[{
 "The rule ",
 Cell[BoxData["\"\<BasisOrder\>\""], "InlineFormula",ExpressionUUID->
  "6c33d619-874c-4e9b-8b66-dfbdb445b556"],
 " depends on the order of the basis, and it keeps basis elements as \
representatives where it can."
}], "Notes",ExpressionUUID->"70d2d045-0d78-4269-8f64-fb57a17c9f56"],

Cell[TextData[{
 "The rule ",
 Cell[BoxData["\"\<Adjoint\>\""], "InlineFormula",ExpressionUUID->
  "ee55b6d3-48f1-4d45-80ca-16a4cc4f7b29"],
 " takes the orthogonal complement of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["im",
     FontSlant->"Plain"], " ", 
    StyleBox["d",
     FontSlant->"Plain"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "b94603e5-3867-43c6-a9a2-6ae78d6f0fa1"],
 " in ",
 Cell[BoxData[
  FormBox[
   RowBox[{"ker", 
    StyleBox["d",
     FontSlant->"Plain"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "5f186fbf-1460-406f-bd37-cecc2f2ed259"],
 " for the inner product in which the basis is orthonormal, the discrete \
harmonic elements. That subspace does not depend on the order of the basis, \
but its elements may be sums of basis elements."
}], "Notes",ExpressionUUID->"79cd1b4d-dfe0-4bad-b209-f447ab722e82"],

