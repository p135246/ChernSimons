Cell[CellGroupData[{
Cell["FindHarmonicSubspace", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"00e668c4-88ff-4f3c-9f92-70196727cbf1"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindHarmonicSubspace"]], 
     "paclet:ChernSimons/ref/FindHarmonicSubspace", 
     "ChernSimons Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["space", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "613c0dc0-cdfc-4387-baed-e132d0d78b5a"],
 "\[LineSeparator]",
 "finds a harmonic subspace of a ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SullivanModel"]], "paclet:ChernSimons/ref/SullivanModel", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "e54e7654-2f78-455c-84b8-94639fdb19be"],
 " or a ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CochainComplexWithPairing"]], 
    "paclet:ChernSimons/ref/CochainComplexWithPairing", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "389065f7-4666-4e5e-8e3a-3268f142feb4"],
 ", a complement of the image of the differential in the cocycles, as an \
Association from degrees to bases.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"814af034-ccd2-4e99-9cb5-6961abd7468b"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindHarmonicSubspace"]], 
     "paclet:ChernSimons/ref/FindHarmonicSubspace", 
     "ChernSimons Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["space", "TI"], ",", " ", 
    StyleBox["k", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1d4d30e4-08a6-4801-9545-92e523a8ac92"],
 "\[LineSeparator]",
 "gives the basis of degree ",
 StyleBox["k", "TI"],
 " of that subspace."
}], "Usage",ExpressionUUID->"b8b092d4-af5e-4b54-9400-d06e1a897439"],

Cell[TextData[{
 "A harmonic subspace ",
 Cell[BoxData[
  FormBox[
   StyleBox["H", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4f6d6d7c-b65b-49b9-b4c6-9651497045e8"],
 " is a complement of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["im",
     FontSlant->"Plain"], " ", 
    StyleBox["d",
     FontSlant->"Plain"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "351037fc-d522-41b2-bf76-6141af4587ac"],
 " in ",
 Cell[BoxData[
  FormBox[
   RowBox[{"ker", 
    StyleBox["d",
     FontSlant->"Plain"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "36d879d5-63e8-4892-b804-c71a7b9a8905"],
 ", so that ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["H", "TI"], 
    StyleBox["k", "TI"]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b0346f5a-63de-41b8-a0f5-8efc4602e741"],
 " maps isomorphically onto ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["H", "TI"], 
    StyleBox["k", "TI"]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f2077398-c31c-4e7a-8d5b-037a54d59789"],
 " in each degree. There are many, and the method says which one is found."
}], "Notes",
 CellFrameLabels->{{Inherited, Inherited}, {Inherited, 
    Cell[
     TextData[{
      "26.09.30: Design review - design 4 of the names doc (R5g), which Pavel \
asked for on 2026-09-30 (\"we should be also able to find a harmonic subspace \
in some canonical way\") and left to the session. The subspace is found, not \
constructed: as with FindRoot, the answer is one of many, so the name says \
Find and the Method says which one. \"BasisOrder\", the default, is the rule \
of the former export: it keeps monomials as representatives and every value \
the suite pinned before. \"Adjoint\" is the choice free of the order of the \
basis that canonical can also mean, the kernel of d intersected with the \
kernel of its transpose in the monomial basis, at the price of \
representatives that are sums of monomials. The result is an Association from \
the degrees of the complex to bases, the shape FindPreHodgeDecomposition and \
FindHodgeDecomposition take as their second argument, so either rule reaches \
the decompositions without their taking a Method. For a model the computation \
runs on the complex of the model, which agrees with it up to degree n+1. \
Alternative name considered: HarmonicSubspace, the export until 2026-09-30. \
Prior art: the Wolfram Language has no harmonic subspace of a cochain \
complex; NullSpace and MatrixRank are the linear algebra it rests on. The \
engine of the verification suites has no counterpart; T17 pins the default \
rule on the catalogue and the adjoint rule as a complement of im d with the \
Betti dimensions, unchanged when the basis is listed backwards.", "\n\n", 
       Cell[
        BoxData[
         GridBox[{{
            Cell[
             BoxData[
              ButtonBox[
               DynamicBox[
                FEPrivate`FrontEndResource[
                "DocumentationToolsStrings", "Edit"]], BaseStyle -> 
               "TextAnnotationButton"]]], 
            StyleBox[
             RowBox[{
               DynamicBox[
                FEPrivate`FrontEndResource[
                "DocumentationToolsStrings", "LastAnnotator"]], "pavel"}], 
             "TextAnnotator"], 
            Cell[
             BoxData[
              ButtonBox[
               DynamicBox[
                FEPrivate`FrontEndResource[
                "DocumentationToolsStrings", "Delete"]], BaseStyle -> 
               "TextAnnotationRemoveButton"]]], ""}}, 
          GridBoxAlignment -> {
           "Columns" -> {Left, Left, Right, Right}, "Rows" -> {{Automatic}}}, 
          GridBoxItemSize -> {"Columns" -> {
              Scaled[0.15], 
              Scaled[0.68], 
              Scaled[0.15], 
              Scaled[0.02]}}]]], "\n"}], "TextAnnotation", 
     CellSize -> {590, Inherited}]}},
 CellTags->"TextAnnotation",
 CellID->220142210,ExpressionUUID->"5f50a759-2999-413f-95f5-011a4c8ca9bc"],

Cell[TextData[{
 "The Association has one key per degree of the complex, and its value is a \
basis of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["H", "TI"], 
    StyleBox["k", "TI"]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8e0f029d-55ff-4e0f-8112-d88edead6591"],
 ", a list of linear combinations of basis elements."
}], "Notes",ExpressionUUID->"fcf26f16-827b-4ee1-8950-74af758f554c"],

Cell[TextData[{
 "For a model the computation runs on ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["CochainComplexWithPairing"]], 
     "paclet:ChernSimons/ref/CochainComplexWithPairing", 
     "ChernSimons Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["model", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "901c3735-d374-4dfa-803b-f899641ef978"],
 ", which agrees with the model up to degree ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["n", "TI"], "+", "1"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "189f648f-860d-4cd9-8267-2d0d40cbe56d"],
 ". The keys are the degrees of that complex."
}], "Notes",ExpressionUUID->"59695bc8-8c78-4c12-9539-079c6d8a0bb6"],

