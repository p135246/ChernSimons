 Cell[BoxData[
  FormBox["2", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "717343f6-8337-485f-8195-e26715fc9f44"],
 " is spanned by the two other monomials:"
}], "ExampleText",ExpressionUUID->"3055ff64-062a-4955-860d-21170b8406ce"],

