     "3532629d-0aa2-43a3-be24-412a8792f877"]], "TableText",ExpressionUUID->
     "c56da3b4-33ab-4bfe-9c36-02a8acc2fe04"], Cell[TextData[{
     "the first cocycles, closed basis elements first, that are independent \
modulo ",
     Cell[BoxData[
      FormBox[
       RowBox[{
        StyleBox["im",
         FontSlant->"Plain"], " ", 
        StyleBox["d",
         FontSlant->"Plain"]}], TraditionalForm]], "InlineFormula",
      ExpressionUUID->"b9fe7b2a-8b1f-4fda-9b06-46d1d2ac2afd"]
    }], "TableText",ExpressionUUID->"d4fb3f99-ea93-4361-85a1-e53482c493fe"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "3fe6355b-4f37-4e9c-8d40-a75a5583cc7f"], Cell[TextData[Cell[
    BoxData["\"\<Adjoint\>\""], "InlineFormula",ExpressionUUID->
     "8e4b97c0-fa09-411b-b253-df7a8c4825a2"]], "TableText",ExpressionUUID->
     "e6ca4c5f-2015-42bd-9a14-90c0fed6112f"], Cell[TextData[{
     Cell[BoxData[
      FormBox[
       RowBox[{"ker", 
        StyleBox["d",
         FontSlant->"Plain"], "\[Intersection]", "ker", 
        SuperscriptBox[
         StyleBox["d",
          FontSlant->"Plain"], 
         StyleBox["T",
          FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
      ExpressionUUID->"24a968c0-1c72-462a-bd9c-2ebb2b0094bc"],
     ", with ",
