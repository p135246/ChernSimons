      FormBox[
       SuperscriptBox[
        StyleBox["d",
         FontSlant->"Plain"], 
        StyleBox["T",
         FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
      ExpressionUUID->"644de0ca-6772-4f02-9fd1-a7ed652012ef"],
     " the transpose of ",
     Cell[BoxData[
      FormBox[
       StyleBox["d",
        FontSlant->"Plain"], TraditionalForm]], "InlineFormula",
      ExpressionUUID->"d3cad067-35e2-47ed-8fc9-06f992ca2065"],
     " in the basis"
    }], "TableText",ExpressionUUID->"99c4512a-9cc5-4c8c-9ec0-0427869b5e2d"]}
  }]], "2ColumnTableMod",ExpressionUUID->"2826f7f1-a7ec-4648-b431-\
