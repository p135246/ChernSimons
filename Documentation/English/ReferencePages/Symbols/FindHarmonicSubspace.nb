Cell[TextData[{
 "The rule ",
 Cell[BoxData["\"\<BasisOrder\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "698579e1-d315-442c-93d9-5f3a383cfecb"],
 " depends on the order of the basis, and it keeps basis elements as \
representatives where it can."
}], "Notes",ExpressionUUID->"7b636416-6299-4921-ad86-96bfc2b5499c"],

Cell[TextData[{
 "The rule ",
 Cell[BoxData["\"\<Adjoint\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4b871a7c-c527-4d17-8a3b-814957c2bdf2"],
 " takes the orthogonal complement of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["im",
     FontSlant->"Plain"], " ", 
    StyleBox["d",
     FontSlant->"Plain"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d30878c2-d51e-499b-9ab5-1b81ace9f7c9"],
 " in ",
 Cell[BoxData[
  FormBox[
   RowBox[{"ker", 
    StyleBox["d",
     FontSlant->"Plain"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "65962454-aa19-412a-b7a0-e4c5aabe308c"],
 " for the inner product in which the basis is orthonormal, the discrete \
harmonic elements. That subspace does not depend on the order of the basis, \
but its elements may be sums of basis elements."
}], "Notes",ExpressionUUID->"6ba7cc02-86a0-4253-bf81-2ac602c2d060"],

