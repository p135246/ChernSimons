Cell[TextData[{
 "In the Heisenberg nilmanifold ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["x", "TI"], 
    StyleBox["y", "TI"], "\[LongEqual]", 
    StyleBox["d",
     FontSlant->"Plain"], 
    StyleBox["z", "TI"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "ebb5f593-4ae6-4338-b2de-627c52f9941f"],
