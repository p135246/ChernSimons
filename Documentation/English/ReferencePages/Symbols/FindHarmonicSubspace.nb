Cell[TextData[{
 "The rule ",
 Cell[BoxData["\"\<BasisOrder\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "98f1f0c5-4f1e-413c-bee5-8238e8d7b616"],
 " depends on the order of the basis, and it keeps basis elements as \
representatives where it can."
}], "Notes",ExpressionUUID->"04c24440-f351-4a05-bed5-6a303ae1a182"],

Cell[TextData[{
 "The rule ",
 Cell[BoxData["\"\<Adjoint\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "69074b05-69fb-4e3a-a9ae-e46311c20cb0"],
 " takes the orthogonal complement of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["im",
     FontSlant->"Plain"], " ", 
    StyleBox["d",
     FontSlant->"Plain"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b16c6979-9356-48de-8c29-a0dc282e82be"],
 " in ",
 Cell[BoxData[
  FormBox[
   RowBox[{"ker", 
    StyleBox["d",
     FontSlant->"Plain"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "defd5d0e-5a0b-48c8-8129-e87213fb9d53"],
 " for the inner product in which the basis is orthonormal, the discrete \
harmonic elements. That subspace does not depend on the order of the basis, \
but its elements may be sums of basis elements."
}], "Notes",ExpressionUUID->"730e8d34-0bd4-4f38-9d77-58f3b09f6eca"],

