Cell[TextData[{
 "The rule ",
 Cell[BoxData["\"\<BasisOrder\>\""], "InlineFormula",ExpressionUUID->
  "6d129818-ffab-481d-8076-947a65ee2313"],
 " depends on the order of the basis, and it keeps basis elements as \
representatives where it can."
}], "Notes",ExpressionUUID->"9edfe15b-aa0b-413e-83a8-19ffa6934340"],

Cell[TextData[{
 "The rule ",
 Cell[BoxData["\"\<Adjoint\>\""], "InlineFormula",ExpressionUUID->
  "0806f6ca-bc0a-488a-90d3-ff61fd54f054"],
 " takes the orthogonal complement of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["im",
     FontSlant->"Plain"], " ", 
    StyleBox["d",
     FontSlant->"Plain"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "ca60d5cf-e850-4809-a4cb-abb644e2f798"],
 " in ",
 Cell[BoxData[
  FormBox[
   RowBox[{"ker", 
    StyleBox["d",
     FontSlant->"Plain"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "2c04beb8-5492-4b60-894d-dc8ccdc04a8d"],
 " for the inner product in which the basis is orthonormal, the discrete \
harmonic elements. That subspace does not depend on the order of the basis, \
but its elements may be sums of basis elements."
}], "Notes",ExpressionUUID->"70e57b00-6535-4870-98df-e4e400e85c50"],

