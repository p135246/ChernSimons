Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "7a337ca3-78be-40d2-92f4-6df993e512d8"], Cell["Method", "TableText",
     FontWeight->Bold,ExpressionUUID->"05b95d96-8b6d-44a4-b168-5b32d1f5ae15"],
     Cell["Subspace", "TableText",
     FontWeight->Bold,ExpressionUUID->"9af5cb84-8691-45ba-b0ac-d4731d0b54bf"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
