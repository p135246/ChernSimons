  }]], "3ColumnTableMod",ExpressionUUID->"a151cd36-2fbc-43a3-880e-\
e3bfb7b4019e"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{"\"\<UpTo\>\"", " ", "->", " ", "True"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e24fd568-6f1e-43ac-bffc-fd0548583f6f"],
 " the lengths come in increasing order, and within each length the internal \
order is preserved."
}], "Notes",ExpressionUUID->"029f02c5-34e5-4a17-b9cb-9964e4e58891"],

Cell[TextData[{
 "Enumeration is the usual source of the truncation a finite check runs \
under: a statement verified on ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["CyclicWords"]], "paclet:IBLInfinity/ref/CyclicWords", 
     "IBLInfinity Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["n", "TI"], ",", " ", 
    StyleBox["pairing", "TI"], ",", " ", 
    RowBox[{"\"\<UpTo\>\"", " ", "->", " ", 
     ButtonBox["True",
      BaseStyle->"Link"]}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ea0633cb-bf5d-4208-9792-7d7fd4a1a234"],
 " is verified for words of length at most ",
 StyleBox["n", "TI"],
 " and no further."
}], "Notes",ExpressionUUID->"bc78b563-2dab-4408-9ef4-aa4493f3713c"]
}, Open  ]],

