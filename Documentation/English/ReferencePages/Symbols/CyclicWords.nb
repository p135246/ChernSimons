Cell[CellGroupData[{
Cell["CyclicWords", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"92fe1feb-451f-407f-ab12-cc2172f719bf"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["CyclicWords"]], "paclet:ChernSimons/ref/CyclicWords", 
     "ChernSimons Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["n", "TI"], ",", " ", 
    StyleBox["data", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7737906c-88f9-4dc0-af6f-8ff6561b1285"],
 "\[LineSeparator]",
 "enumerates the nonzero cyclic words of length ",
 StyleBox["n", "TI"],
 " over the alphabet of ",
 StyleBox["data", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"de826a87-748b-4922-abd3-b12713bd8a2b"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["CyclicWords"]], "paclet:ChernSimons/ref/CyclicWords", 
     "ChernSimons Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["n", "TI"], ",", " ", 
    StyleBox["data", "TI"], ",", " ", 
    RowBox[{"\"\<UpTo\>\"", " ", "->", " ", 
     ButtonBox["True",
      BaseStyle->"Link"]}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "35cf8547-8dd2-4b6f-a0d5-a78ac7a8a074"],
 "\[LineSeparator]",
 "gives the nonzero cyclic words of every length up to ",
 StyleBox["n", "TI"],
 "."
}], "Usage",ExpressionUUID->"f6711ec4-fdda-4d41-807b-f974d5cfd2bf"],

Cell[TextData[{
 StyleBox["data", "TI"],
 " is either a pairing object built by ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["GradedPairing"]], "paclet:ChernSimons/ref/GradedPairing", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "f9ecb514-defa-4a4c-85b0-6905b57d600e"],
 ", or a bare association from particles to degrees."
}], "Notes",ExpressionUUID->"a8676a1f-bf4a-4ec6-9530-98acaf773cd6"],

Cell[TextData[{
 "Only canonical representatives are listed, and words that a rotation sends \
to minus themselves are omitted \[LongDash] those are ",
 Cell[BoxData[
  FormBox["0", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "55b66528-d529-4bea-8317-81f780eceb4a"],
 ", not elements of a basis. So the list is a basis of the space of cyclic \
words in that length, in the paclet's internal order."
}], "Notes",ExpressionUUID->"74756ae4-1d4c-4c0f-b92a-1e662a4966d3"],

Cell[TextData[{
 "The result is a list of inert one-argument ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CyclicWord"]], "paclet:ChernSimons/ref/CyclicWord", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "441ad4af-667f-45de-bb64-8307305791b0"],
 " expressions, ready to be fed to any operation."
}], "Notes",ExpressionUUID->"41307ccc-bee3-4c89-ba40-08c3b2bd7811"],

