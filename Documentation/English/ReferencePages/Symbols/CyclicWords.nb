Cell["A three-particle alphabet enumerates the same way:", "ExampleText",ExpressionUUID->"1b190630-93f6-4970-9876-a76b6f38acab"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"CyclicWords", "[", 
  RowBox[{"2", ",", " ", 
   RowBox[{"Pairing", "[", 
    RowBox[{
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"alpha", " ", "->", " ", 
        RowBox[{"-", "1"}]}], ",", " ", 
       RowBox[{"beta", " ", "->", " ", "0"}], ",", " ", 
       RowBox[{"gamma", " ", "->", " ", 
        RowBox[{"-", "1"}]}]}], "|>"}], ",", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{"alpha", ",", " ", "beta"}], "}"}], " ", "->", " ", "1"}], ",",
        " ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"gamma", ",", " ", "beta"}], "}"}], " ", "->", " ", "1"}]}], 
      "|>"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"134e005f-3fc6-46b9-b0cf-be5ec8eb5a3d"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"CyclicWord", "[", 
    RowBox[{"{", 
     RowBox[{"alpha", ",", "beta"}], "}"}], "]"}], ",", 
