      "RefLink",
      BaseStyle->"InlineFormula"]], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "62b6fe4e-513c-47f4-a691-22e106c7ca54"]], "TableText",ExpressionUUID->
     "4b31ddd5-6bca-4e62-a08a-8b2df8044abf"], Cell[TextData[{
     "whether the empty word ",
     Cell[BoxData[
      RowBox[{
       TemplateBox[{
         Cell[
          TextData["CyclicWord"]], "paclet:ChernSimons/ref/CyclicWord", 
