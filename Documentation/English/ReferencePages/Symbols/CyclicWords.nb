    }], "TableText",ExpressionUUID->"1045d8c6-b25d-4de4-adf9-2b758ac913c7"]}
  }]], "3ColumnTableMod",ExpressionUUID->"d4b87f64-e80d-48d3-879f-\
abc3bd0a8284"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{"\"\<UpTo\>\"", " ", "->", " ", "True"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5cfdb5ad-4e32-4ef2-a117-2222a3f7a126"],
 " the lengths come in increasing order, and within each length the internal \
order is preserved. With ",
 Cell[BoxData[
  RowBox[{"\"\<EmptyWord\>\"", " ", "->", " ", "True"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0e5ee0d5-e038-417f-9b57-0bc3fc090d89"],
 " as well, the empty word comes first."
}], "Notes",ExpressionUUID->"6816ed10-6b9c-45d1-8b22-c7ce021f05f5"],

Cell[TextData[{
 "Enumeration is the usual source of the truncation a finite check runs \
under: a statement verified on ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["CyclicWords"]], "paclet:ChernSimons/ref/CyclicWords", 
     "ChernSimons Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["n", "TI"], ",", " ", 
    StyleBox["pairing", "TI"], ",", " ", 
    RowBox[{"\"\<UpTo\>\"", " ", "->", " ", 
     ButtonBox["True",
      BaseStyle->"Link"]}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6d07c56d-95a2-492b-a8c3-9b809c75dae6"],
 " is verified for words of length at most ",
 StyleBox["n", "TI"],
 " and no further."
}], "Notes",ExpressionUUID->"8e743e45-07f1-4580-ae28-a057e1f9ef3f"]
}, Open  ]],

