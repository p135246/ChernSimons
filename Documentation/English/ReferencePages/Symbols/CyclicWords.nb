Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"words", "[", "n_", "]"}], " ", ":=", " ", 
   RowBox[{"CyclicWords", "[", 
    RowBox[{"n", ",", " ", 
     RowBox[{"GradedPairing", "[", 
      RowBox[{
       RowBox[{"<|", 
