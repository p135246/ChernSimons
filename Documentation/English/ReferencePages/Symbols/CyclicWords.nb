           "|>"}]}], "]"}]}], "]"}], "]"}]}], ",", " ", 
    RowBox[{"words", "[", "4", "]"}]}], "]"}], "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"fcc05e19-dbf6-479c-a9d8-0e7bee385c30"],

