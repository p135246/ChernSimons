Cell[CellGroupData[{
Cell["CyclicWords", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"2e4785de-fa58-4d92-82c2-8da96c470fac"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["CyclicWords"]], "paclet:IBLInfinity/ref/CyclicWords", 
     "IBLInfinity Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["n", "TI"], ",", " ", 
    StyleBox["data", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a6c4dfb5-1842-44f7-85ec-12ae19d108cd"],
 "\[LineSeparator]",
 "enumerates the nonzero cyclic words of length ",
 StyleBox["n", "TI"],
 " over the alphabet of ",
 StyleBox["data", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"10a23c1e-cfa6-400c-9b48-c5a14d80726d"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["CyclicWords"]], "paclet:IBLInfinity/ref/CyclicWords", 
     "IBLInfinity Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["n", "TI"], ",", " ", 
    StyleBox["data", "TI"], ",", " ", 
    RowBox[{"\"\<UpTo\>\"", " ", "->", " ", 
     ButtonBox["True",
      BaseStyle->"Link"]}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "07665f08-91a6-4e26-88f4-070cdb9fcc6a"],
 "\[LineSeparator]",
 "gives the nonzero cyclic words of every length up to ",
 StyleBox["n", "TI"],
 "."
}], "Usage",ExpressionUUID->"f8db9999-d662-4bbb-9c2b-6f7d4957ef82"],

Cell[TextData[{
 StyleBox["data", "TI"],
 " is either a pairing object built by ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Pairing"]], "paclet:IBLInfinity/ref/Pairing", 
    "IBLInfinity Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "e6121a05-f0e1-4427-a575-3c1d7fee0692"],
 ", or a bare association from particles to degrees."
}], "Notes",ExpressionUUID->"45d3c64c-8c08-4cb0-90d8-ba7367386c80"],

Cell[TextData[{
 "Only canonical representatives are listed, and words that a rotation sends \
to minus themselves are omitted \[LongDash] those are ",
 Cell[BoxData["0"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7c39a2e3-4d26-4c88-8dba-dccd9b0535db"],
 ", not elements of a basis. So the list is a basis of the space of cyclic \
words in that length, in the paclet's internal order."
}], "Notes",ExpressionUUID->"d970325b-4f83-4751-8eb3-e39ddbdb17f5"],

Cell[TextData[{
 "The result is a list of inert one-argument ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CyclicWord"]], "paclet:IBLInfinity/ref/CyclicWord", 
    "IBLInfinity Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "b0ecff11-2c59-47ae-8914-8a6cea03633a"],
 " expressions, ready to be fed to any operation."
}], "Notes",ExpressionUUID->"01cc41dd-ca88-4fb8-95a8-56f8cd7cd877"],

