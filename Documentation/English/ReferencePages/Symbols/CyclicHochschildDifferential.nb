 "The differential is the first summand of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["StringBeilinsonDrinfeldOperator"]], 
    "paclet:ChernSimons/ref/StringBeilinsonDrinfeldOperator", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "8a67a1e0-8781-4873-80c1-86bdde6bb952"],
 " and of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["TwistedDifferential"]], 
    "paclet:ChernSimons/ref/TwistedDifferential", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "4b45e77e-6488-4d09-893a-570f6ed37b20"],
 "."
}], "Notes",ExpressionUUID->"8398c606-5976-4ce6-98b0-54ed0a04ea59"]
}, Open  ]],

