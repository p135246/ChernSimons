Cell[TextData[{
 "The alphabet of the Heisenberg nilmanifold carries ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["d", "TI"], 
    StyleBox["z", "TI"], "\[LongEqual]", 
    StyleBox["x", "TI"], 
    StyleBox["y", "TI"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8b884afe-5f04-4a1e-9cd5-5127e2137101"],
 ", so dually the particle ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"x", "y"}], "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "406fcd14-4c25-4c0b-aa20-1804500634fe"],
 " goes to the particle ",
 Cell[BoxData[
  FormBox[
   StyleBox["z", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8bec2293-317c-439e-97b3-c5a8f9f36bd3"],
 ":"
}], "ExampleText",ExpressionUUID->"8cf27614-e5b2-4225-bf32-247ac777d01b"],

