Cell[TextData[{
 "The alphabet of the Heisenberg nilmanifold carries ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["d", "TI"], 
    StyleBox["z", "TI"], "\[LongEqual]", 
    StyleBox["x", "TI"], 
    StyleBox["y", "TI"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "d3a6cd03-5b2f-4612-9bd0-1115f61f2601"],
 ", so dually the letter ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"x", "y"}], "TI"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"708f290b-dfab-40b4-84c6-05aac9a562d8"],
 " goes to the letter ",
 Cell[BoxData[
  FormBox[
   StyleBox["z", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "b0b6ca78-137f-4d7d-8af3-afe86e7bdc64"],
 ":"
}], "ExampleText",ExpressionUUID->"6f7fcac6-eeb8-476d-aaf5-29ee4b2fedde"],

