Cell[TextData[{
 "The alphabet of the Heisenberg nilmanifold carries ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["d", "TI"], 
    StyleBox["z", "TI"], "\[LongEqual]", 
    StyleBox["x", "TI"], 
    StyleBox["y", "TI"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9123c7aa-5197-4710-b64a-6bef37f499b1"],
 ", so dually the particle ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"x", "y"}], "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "db32b842-2057-46d3-9683-908a587d8213"],
 " goes to the particle ",
 Cell[BoxData[
  FormBox[
   StyleBox["z", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2b3d6433-5df5-4a81-88ab-59eb86a464bf"],
 ":"
}], "ExampleText",ExpressionUUID->"9dd9000b-3dc0-4664-8704-751ecba0af4a"],

