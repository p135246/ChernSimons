Cell[TextData[{
 "The alphabet of the Heisenberg nilmanifold carries ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["d", "TI"], 
    StyleBox["z", "TI"], "\[LongEqual]", 
    StyleBox["x", "TI"], 
    StyleBox["y", "TI"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "30b00d9b-ffb2-46ea-a4ae-2be51974f731"],
 ", so dually the particle ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"x", "y"}], "TI"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"0ad223ed-be86-43f8-af9d-d46f59859261"],
 " goes to the particle ",
 Cell[BoxData[
  FormBox[
   StyleBox["z", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "37818769-65e5-47af-8b35-3a519b28067e"],
 ":"
}], "ExampleText",ExpressionUUID->"ce2e0771-10bb-4009-bfc9-728a43906656"],

