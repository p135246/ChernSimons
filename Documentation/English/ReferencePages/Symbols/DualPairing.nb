 " of dual particles.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"4b54c09a-dd2c-449b-8f49-3f5b48a2c7aa"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["DualPairing"]], "paclet:ChernSimons/ref/DualPairing", 
     "ChernSimons Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
