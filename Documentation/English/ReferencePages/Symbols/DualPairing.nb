       RowBox[{"x", ",", " ", "y"}], "}"}], "]"}], ",", " ", 
     RowBox[{"CyclicWord", "[", 
      RowBox[{"{", 
       RowBox[{"b", ",", " ", "a"}], "}"}], "]"}], ",", " ", "dual"}], 
