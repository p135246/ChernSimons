  "16b4f126-acfe-4d1e-9583-5b75ebea0155"],
 "\[LineSeparator]",
 "gives the value of the cyclic word ",
 StyleBox["u", "TI"],
 " of letters on the cyclic word ",
 StyleBox["v", "TI"],
 " of dual letters.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"6e25f2c6-a349-4038-8511-9d6f91b6a694"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["DualPairing"]], "paclet:ChernSimons/ref/DualPairing", 
     "ChernSimons Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["p", "TI"], ",", " ", 
    StyleBox["q", "TI"], ",", " ", 
    StyleBox["pairing", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "cae13f02-59f9-4e95-9181-96b95cca9bbc"],
 "\[LineSeparator]",
 "gives the value of the product ",
 StyleBox["p", "TI"],
 " of cyclic words on the product ",
 StyleBox["q", "TI"],
 " of dual cyclic words, two symmetric or two exterior products."
}], "Usage",ExpressionUUID->"1cc7b03e-a8a9-4636-a735-19ae2fd0ea5c"],

Cell[TextData[{
 StyleBox["pairing", "TI"],
 " must carry a ",
 Cell[BoxData["\"\<Dual\>\""], "InlineFormula",ExpressionUUID->
  "ebe7f339-b5c0-41d1-af6f-16a3fbc43a60"],
 " key, so it is built with the four-argument form ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["GradedPairing"]], "paclet:ChernSimons/ref/GradedPairing", 
     "ChernSimons Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["degrees", "TI"], ",", " ", 
    StyleBox["spec", "TI"], ",", " ", 
    StyleBox["dual", "TI"], ",", " ", 
    StyleBox["evaluation", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "85f7eed2-efe1-4c58-a42a-6ca7be10eff2"],
 ". Without the key the message ",
 Cell[BoxData[
  RowBox[{"GradedPairing", "::", "dual"}]], "InlineFormula",ExpressionUUID->
  "fef812af-4363-4a22-8650-ec0139753d45"],
 " is issued and the expression returns unevaluated."
}], "Notes",
 CellFrameLabels->{{Inherited, Inherited}, {Inherited, 
    Cell[
     TextData[{
      "26.09.30: Design review - DualPairing absorbed ProductPairing on \
2026-09-30, on Pavel's proposal, so that one function per concept dispatches \
on the heads of its arguments: two words, two symmetric products, two \
exterior products, or a word and a product. Every form needs the \"Dual\" key \
of the pairing, so a pairing without a dual alphabet gives the one message \
GradedPairing::dual and returns unevaluated; before, ProductPairing gave 0 on \
a word and a product without the key, and on two products issued the message \
once per pair of factors. A symmetric against an exterior product returns \
unevaluated, as it did under ProductPairing; no alternative was recorded. \
Alternative name considered: ProductPairing, the name of the product form \
until 2026-09-30. Prior art: the Wolfram Language has no cyclic words or dual \
alphabets; the engine the verification suites load evaluates words and \
symmetric products, and pins both forms.", "\n\n", 
       Cell[
        BoxData[
         GridBox[{{
            Cell[
             BoxData[
              ButtonBox[
               DynamicBox[
                FEPrivate`FrontEndResource[
                "DocumentationToolsStrings", "Edit"]], BaseStyle -> 
               "TextAnnotationButton"]]], 
            StyleBox[
             RowBox[{
               DynamicBox[
                FEPrivate`FrontEndResource[
                "DocumentationToolsStrings", "LastAnnotator"]], "pavel"}], 
             "TextAnnotator"], 
            Cell[
             BoxData[
              ButtonBox[
               DynamicBox[
                FEPrivate`FrontEndResource[
                "DocumentationToolsStrings", "Delete"]], BaseStyle -> 
               "TextAnnotationRemoveButton"]]], ""}}, 
          GridBoxAlignment -> {
           "Columns" -> {Left, Left, Right, Right}, "Rows" -> {{Automatic}}}, 
          GridBoxItemSize -> {"Columns" -> {
              Scaled[0.15], 
              Scaled[0.68], 
              Scaled[0.15], 
              Scaled[0.02]}}]]], "\n"}], "TextAnnotation", 
     CellSize -> {590, Inherited}]}},
 CellTags->"TextAnnotation",
 CellID->700445345,ExpressionUUID->"b5e31815-2faa-4fdd-aa79-cbf4d50a0b96"],

