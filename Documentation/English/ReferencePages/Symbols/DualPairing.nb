Cell[TextData[{
 "On two words the value is a number: the sum over the rotations of ",
 StyleBox["v", "TI"],
 ", each with its Koszul sign, of the product of the values of the ",
 StyleBox["evaluation", "TI"],
 " association on the matched particles, times the reversal sign of the \
degrees of ",
 StyleBox["u", "TI"],
 "."
}], "Notes",ExpressionUUID->"3e468f86-3c63-49eb-a3f1-ed3f2a59a34a"],

Cell[TextData[{
 "A word of length ",
 Cell[BoxData[
  FormBox[
   StyleBox["k", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "346b028d-09d7-4c6e-8ceb-48659c670ff2"],
 " has up to ",
 Cell[BoxData[
  FormBox[
   StyleBox["k", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "25c810c4-4259-470e-b7d9-a5b103d57663"],
 " rotations matching a dual word, and the value counts them all, so a value \
may exceed ",
 Cell[BoxData[
  FormBox["1", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "43be5785-a123-419f-89d6-3b5f4d1651cf"],
 "."
}], "Notes",ExpressionUUID->"5723a6b7-02f3-48f0-ac95-8a85d9d78317"],

Cell[TextData[{
 "Words of different lengths give ",
 Cell[BoxData[
  FormBox["0", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "356c5cc1-41d7-4478-8f3e-b2be4d66f1ff"],
 "."
}], "Notes",ExpressionUUID->"b76f1c3a-76b7-49be-8d7a-f944376d262c"],

Cell[TextData[{
 "On two products the value is the sum over all matchings of the factors of \
",
 StyleBox["p", "TI"],
 " with the factors of ",
 StyleBox["q", "TI"],
 ": each term is the product of the values on the matched words, times the \
Koszul sign of the permutation that realizes the matching, times a sign of \
the degrees of the factors of ",
 StyleBox["p", "TI"],
 "."
}], "Notes",ExpressionUUID->"1a5ff2cb-ebbc-48bf-b0c9-26bb52da53b3"],

Cell[TextData[{
 "Products with different numbers of factors give ",
 Cell[BoxData[
  FormBox["0", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "1ccb6e42-9ae2-4860-8242-34f43c4ab3b0"],
 "."
}], "Notes",ExpressionUUID->"9c1c27e6-ca11-417f-a80e-6ae12c4b9d33"],

Cell["\<\
A symmetric product against an exterior product returns unevaluated.\
\>", "Notes",ExpressionUUID->"7f3218d8-01e3-47d7-bf20-1f65c8a89c0b"],

