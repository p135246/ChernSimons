Cell["A word whose two rotations both match counts both:", "ExampleText",ExpressionUUID->"29cab6c0-5638-499e-8423-aae30ccec9a3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"DualPairing", "[", 
  RowBox[{
   RowBox[{"CyclicWord", "[", 
    RowBox[{"{", 
     RowBox[{"y", ",", " ", "y"}], "}"}], "]"}], ",", " ", 
   RowBox[{"CyclicWord", "[", 
    RowBox[{"{", 
     RowBox[{"b", ",", " ", "b"}], "}"}], "]"}], ",", " ", 
   RowBox[{"GradedPairing", "[", 
    RowBox[{
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"x", " ", "->", " ", 
        RowBox[{"-", "1"}]}], ",", " ", 
       RowBox[{"y", " ", "->", " ", "0"}]}], "|>"}], ",", " ", 
     RowBox[{"<|", 
