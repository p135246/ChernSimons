       RowBox[{"x", ",", " ", "y"}], "}"}], "]"}], ",", " ", 
     RowBox[{"CyclicWord", "[", 
      RowBox[{"{", 
       RowBox[{"a", ",", " ", "b"}], "}"}], "]"}], ",", " ", "dual"}], "]"}], 
   ",", " ", 
   RowBox[{"DualPairing", "[", 
    RowBox[{
     RowBox[{"CyclicWord", "[", 
