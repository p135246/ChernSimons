Cell[TextData[{
 "On two words the value is a number: the sum over the rotations of ",
 StyleBox["v", "TI"],
 ", each with its Koszul sign, of the product of the values of the ",
 StyleBox["evaluation", "TI"],
 " association on the matched particles, times the reversal sign of the \
degrees of ",
 StyleBox["u", "TI"],
 "."
}], "Notes",ExpressionUUID->"ac084133-1ffe-4810-aa80-3f72e7fddbc4"],

Cell[TextData[{
 "A word of length ",
 Cell[BoxData[
  FormBox[
   StyleBox["k", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e9650246-3a6a-49d5-a436-21df67b7fabe"],
 " has up to ",
 Cell[BoxData[
  FormBox[
   StyleBox["k", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8063b5df-92c4-45ff-a548-1c9cf18d330b"],
 " rotations matching a dual word, and the value counts them all, so a value \
may exceed ",
 Cell[BoxData[
  FormBox["1", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e7943f5b-8f2e-4a0c-ad55-3899b31a6a82"],
 "."
}], "Notes",ExpressionUUID->"be479135-1243-4f78-80b3-4fae0ba494c7"],

Cell[TextData[{
 "Words of different lengths give ",
 Cell[BoxData[
  FormBox["0", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a2e8ea2a-d376-4295-9695-7a4a3b0a96b7"],
 "."
}], "Notes",ExpressionUUID->"c105c68f-2ec4-4fef-abc2-50fc44f61d54"],

Cell[TextData[{
 "On two products the value is the sum over all matchings of the factors of \
",
 StyleBox["p", "TI"],
 " with the factors of ",
 StyleBox["q", "TI"],
 ": each term is the product of the values on the matched words, times the \
Koszul sign of the permutation that realizes the matching, times a sign of \
the degrees of the factors of ",
 StyleBox["p", "TI"],
 "."
}], "Notes",ExpressionUUID->"258b2aa9-9627-48b8-8422-9c39ae21aeed"],

Cell[TextData[{
 "Products with different numbers of factors give ",
 Cell[BoxData[
  FormBox["0", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d1665ae6-4d44-4ba3-95f7-65b5c241928c"],
 "."
}], "Notes",ExpressionUUID->"2d0dbbc3-bac4-48de-988c-bb8dd60e0f09"],

Cell["\<\
A symmetric product against an exterior product returns unevaluated.\
\>", "Notes",ExpressionUUID->"9bfd798e-9695-49db-8dc4-9cdf06bff413"],

