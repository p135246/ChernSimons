Notebook[{

Cell[CellGroupData[{
Cell["DualPairing", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"6c2d4ae9-8135-4c5c-bae8-1513b287feeb"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["DualPairing"]], "paclet:ChernSimons/ref/DualPairing", 
     "ChernSimons Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["f", "TI"], ",", " ", 
    StyleBox["e", "TI"], ",", " ", 
    StyleBox["pairing", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "31c0a5b8-0d93-43e9-8a6f-054ae6bc9588"],
 "\[LineSeparator]",
 "evaluates a cyclic word ",
 StyleBox["f", "TI"],
 " of particles on a cyclic word ",
 StyleBox["e", "TI"],
 " of dual particles.",
 "\n"
}], "Usage",ExpressionUUID->"03f06239-d27c-4a14-b3be-93f853c43541"],

Cell[TextData[{
 StyleBox["pairing", "TI"],
 " must carry a ",
 Cell[BoxData["\"\<Dual\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6ab250bd-b585-44d4-a9ab-64fab45f8be4"],
 " key, so it has to be built with the four-argument form ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["GradedPairing"]], "paclet:ChernSimons/ref/GradedPairing", 
     "ChernSimons Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["degrees", "TI"], ",", " ", 
    StyleBox["spec", "TI"], ",", " ", 
    StyleBox["dualDegrees", "TI"], ",", " ", 
    StyleBox["evaluation", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a0086d6b-13ab-4da4-9983-7b0db1f9b999"],
 ". Without it ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DualPairing"]], "paclet:ChernSimons/ref/DualPairing", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "147a4a99-9775-438c-8df1-1d233ff4a11a"],
 " issues ",
 Cell[BoxData[
  RowBox[{"GradedPairing", "::", "dual"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9c82a54c-060d-4bf1-a3bd-f7914366e2b5"],
 " and aborts."
}], "Notes",ExpressionUUID->"9c418366-3c49-46b0-bf5d-f5722fc40b09"],

Cell[TextData[{
 "The value is a number: the sum over all matchings of the particles of ",
 StyleBox["f", "TI"],
 " against the dual particles of ",
 StyleBox["e", "TI"],
 ", each weighted by the Koszul sign of the rotation that produces it and by \
the entries of the ",
 StyleBox["evaluation", "TI"],
 " association."
}], "Notes",ExpressionUUID->"3353959f-bea2-499c-81a4-b808feaf8cab"],

Cell[TextData[{
 "Words of different lengths evaluate to ",
 Cell[BoxData[
  FormBox["0", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7dbcabe4-608f-4fe4-a493-033293bcd83c"],
 ", since no matching exists."
}], "Notes",ExpressionUUID->"07c56e36-ba75-43fe-9e93-a0794151e7b0"],

Cell[TextData[{
 "Because a cyclic word is a word up to rotation, a word of length ",
 Cell[BoxData[
  FormBox[
   StyleBox["k", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "aa1b5c8f-0e09-4774-bbbf-960b0d13436f"],
 " generally has ",
 Cell[BoxData[
  FormBox[
   StyleBox["k", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ef5d43e7-48c0-476f-baf6-6e46b3163ff3"],
 " matchings against a dual word of the same length, and the value counts \
them all. This is why the diagonal entries can be larger than ",
 Cell[BoxData[
  FormBox["1", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "af2f09a6-b8a3-4bfc-bb5b-bdee0c8bfcbc"],
 "."
}], "Notes",ExpressionUUID->"fe32b0c0-c590-4ee2-a20b-a0a15336c430"],

Cell[TextData[{
 "The extension of this evaluation to products of words is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ProductPairing"]], "paclet:ChernSimons/ref/ProductPairing", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "fa896792-d133-4011-91a2-e3b719298802"],
 "."
}], "Notes",ExpressionUUID->"17bde62f-14a7-42da-b166-91edc4584615"]
}, Open  ]],

