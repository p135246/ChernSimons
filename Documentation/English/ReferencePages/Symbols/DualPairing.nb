Cell[TextData[{
 "On two words the value is a number: the sum over the rotations of ",
 StyleBox["v", "TI"],
 ", each with its Koszul sign, of the product of the values of the ",
 StyleBox["evaluation", "TI"],
 " association on the matched particles, times the reversal sign of the \
degrees of ",
 StyleBox["u", "TI"],
 "."
}], "Notes",ExpressionUUID->"d53fc0dd-73e9-4555-8c93-ec18915e8bf2"],

Cell[TextData[{
 "A word of length ",
 Cell[BoxData[
  FormBox[
   StyleBox["k", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "febb6c69-2f89-467f-9289-db9a8611eb0b"],
 " has up to ",
 Cell[BoxData[
  FormBox[
   StyleBox["k", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d465df34-e04a-47e5-94bb-71c251e49fb1"],
 " rotations matching a dual word, and the value counts them all, so a value \
may exceed ",
 Cell[BoxData[
  FormBox["1", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "11078ccf-267e-443b-b046-69cae1689545"],
 "."
}], "Notes",ExpressionUUID->"ebfc6147-d525-4198-9af9-3b83f59c4284"],

Cell[TextData[{
 "Words of different lengths give ",
 Cell[BoxData[
  FormBox["0", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5d2e29ad-1354-4b55-b882-5a459992fd50"],
 "."
}], "Notes",ExpressionUUID->"1ce8f2e6-ffa0-41e9-9181-0696a50fa93e"],

Cell[TextData[{
 "On two products the value is the sum over all matchings of the factors of \
",
 StyleBox["p", "TI"],
 " with the factors of ",
 StyleBox["q", "TI"],
 ": each term is the product of the values on the matched words, times the \
Koszul sign of the permutation that realizes the matching, times a sign of \
the degrees of the factors of ",
 StyleBox["p", "TI"],
 "."
}], "Notes",ExpressionUUID->"61689f51-acaa-477b-b23e-cb3085847582"],

Cell[TextData[{
 "Products with different numbers of factors give ",
 Cell[BoxData[
  FormBox["0", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f1b202f0-dcb9-4de1-8986-d66f714e063f"],
 "."
}], "Notes",ExpressionUUID->"bce2c8e0-9abf-4adb-976a-52d098bc9846"],

Cell["\<\
A symmetric product against an exterior product returns unevaluated.\
\>", "Notes",ExpressionUUID->"03890dd9-6ad2-45a8-9c0f-d5f7fe62ddd9"],

