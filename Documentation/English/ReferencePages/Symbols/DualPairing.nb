Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"DualPairing", "[", 
  RowBox[{
   RowBox[{"CyclicWord", "[", 
    RowBox[{"{", 
     RowBox[{"y", ",", " ", "y"}], "}"}], "]"}], ",", " ", 
   RowBox[{"CyclicWord", "[", 
    RowBox[{"{", 
     RowBox[{"b", ",", " ", "b"}], "}"}], "]"}], ",", " ", 
   RowBox[{"GradedPairing", "[", 
    RowBox[{
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"x", " ", "->", " ", 
        RowBox[{"-", "1"}]}], ",", " ", 
       RowBox[{"y", " ", "->", " ", "0"}]}], "|>"}], ",", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "y"}], "}"}], " ", "->", " ", "1"}], "|>"}], ",",
      " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"a", " ", "->", " ", 
        RowBox[{"-", "1"}]}], ",", " ", 
       RowBox[{"b", " ", "->", " ", "0"}]}], "|>"}], ",", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{"x", ",", " ", "a"}], "}"}], " ", "->", " ", "1"}], ",", " ", 
       RowBox[{
