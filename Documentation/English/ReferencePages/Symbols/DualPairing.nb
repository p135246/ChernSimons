Notebook[{

Cell[CellGroupData[{
Cell["DualPairing", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"d48f4fac-ff13-46af-8717-6b115147f8ce"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["DualPairing"]], "paclet:IBLInfinity/ref/DualPairing", 
     "IBLInfinity Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["f", "TI"], ",", " ", 
    StyleBox["e", "TI"], ",", " ", 
    StyleBox["pairing", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f0b1e7e1-9ac4-4482-af00-ad4b8859908d"],
 "\[LineSeparator]",
 "evaluates a cyclic word ",
 StyleBox["f", "TI"],
 " of particles on a cyclic word ",
 StyleBox["e", "TI"],
 " of dual particles.",
 "\n"
}], "Usage",ExpressionUUID->"ae0ed85f-f7b0-4b76-8516-a93e88dc5078"],

Cell[TextData[{
 StyleBox["pairing", "TI"],
 " must carry a ",
 Cell[BoxData["\"\<Dual\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "eae28cd5-4a25-43a1-a6ca-09f141b8ca45"],
 " key, so it has to be built with the four-argument form ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["Pairing"]], "paclet:IBLInfinity/ref/Pairing", 
     "IBLInfinity Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["degrees", "TI"], ",", " ", 
    StyleBox["spec", "TI"], ",", " ", 
    StyleBox["dualDegrees", "TI"], ",", " ", 
    StyleBox["evaluation", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "efee4aab-75ae-4143-99c5-b597ec5bba6c"],
 ". Without it ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DualPairing"]], "paclet:IBLInfinity/ref/DualPairing", 
    "IBLInfinity Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "2185bb75-4f35-4bff-8f0b-91696ab552bf"],
 " issues ",
 Cell[BoxData[
  RowBox[{"Pairing", "::", "dual"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "152213c1-1b34-4e2d-b631-71dd6afe99dd"],
 " and aborts."
}], "Notes",ExpressionUUID->"44dcbc85-5681-4d20-a4b8-925f0b4ef0a2"],

Cell[TextData[{
 "The value is a number: the sum over all matchings of the particles of ",
 StyleBox["f", "TI"],
 " against the dual particles of ",
 StyleBox["e", "TI"],
 ", each weighted by the Koszul sign of the rotation that produces it and by \
the entries of the ",
 StyleBox["evaluation", "TI"],
 " association."
}], "Notes",ExpressionUUID->"860b1e28-8d00-4f4c-b149-d41007891790"],

Cell[TextData[{
 "Words of different lengths evaluate to ",
 Cell[BoxData["0"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "67115cbc-23d8-4368-b3ec-355e96d789b3"],
 ", since no matching exists."
}], "Notes",ExpressionUUID->"0da2c613-2b1b-4916-8c33-cd77aca3d1ef"],

Cell[TextData[{
 "Because a cyclic word is a word up to rotation, a word of length ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1d59765e-463c-4d55-b895-4c0830add621"],
 " generally has ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4256a83b-371e-4854-a0e7-70e6412c572d"],
 " matchings against a dual word of the same length, and the value counts \
them all. This is why the diagonal entries can be larger than ",
 Cell[BoxData["1"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "370f9bd7-7326-4c6f-bc54-c1b68674fb67"],
 "."
}], "Notes",ExpressionUUID->"a68c4c23-79e3-4204-8a7c-7378acefd927"],

Cell[TextData[{
 "The extension of this evaluation to products of words is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ProductPairing"]], "paclet:IBLInfinity/ref/ProductPairing", 
    "IBLInfinity Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "fe874d2f-bfba-40a5-b83e-2ac095ab6bed"],
 "."
}], "Notes",ExpressionUUID->"fdd9fb82-142e-4f44-a991-55365b50be3b"]
}, Open  ]],

