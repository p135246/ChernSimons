Cell["A word whose two rotations both match counts both:", "ExampleText",ExpressionUUID->"54fe4c2d-77b8-464c-a920-0ec77dfd1259"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"DualPairing", "[", 
  RowBox[{
   RowBox[{"CyclicWord", "[", 
    RowBox[{"{", 
     RowBox[{"y", ",", " ", "y"}], "}"}], "]"}], ",", " ", 
   RowBox[{"CyclicWord", "[", 
    RowBox[{"{", 
     RowBox[{"b", ",", " ", "b"}], "}"}], "]"}], ",", " ", 
   RowBox[{"GradedPairing", "[", 
    RowBox[{
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"x", " ", "->", " ", 
        RowBox[{"-", "1"}]}], ",", " ", 
       RowBox[{"y", " ", "->", " ", "0"}]}], "|>"}], ",", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "y"}], "}"}], " ", "->", " ", "1"}], "|>"}], ",",
      " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"a", " ", "->", " ", 
        RowBox[{"-", "1"}]}], ",", " ", 
       RowBox[{"b", " ", "->", " ", "0"}]}], "|>"}], ",", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{"x", ",", " ", "a"}], "}"}], " ", "->", " ", "1"}], ",", " ", 
       RowBox[{
