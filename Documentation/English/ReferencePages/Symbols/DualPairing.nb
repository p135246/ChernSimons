Cell[TextData[{
 "On two words the value is a number: the sum over the rotations of ",
 StyleBox["v", "TI"],
 ", each with its Koszul sign, of the product of the values of the ",
 StyleBox["evaluation", "TI"],
 " association on the matched letters, times the reversal sign of the degrees \
of ",
 StyleBox["u", "TI"],
 "."
}], "Notes",ExpressionUUID->"1d26645d-ebb4-443c-8f5d-d63a5fbe2519"],

Cell[TextData[{
 "A word of length ",
 Cell[BoxData[
  FormBox[
   StyleBox["k", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "c5351d74-f1d2-4ccb-9d31-7e018be11ad6"],
 " has up to ",
 Cell[BoxData[
  FormBox[
   StyleBox["k", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "bd161cfa-a0a2-420c-bf19-a876c78b4fd2"],
 " rotations matching a dual word, and the value counts them all, so a value \
may exceed ",
 Cell[BoxData[
  FormBox["1", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "f2a1129c-65fc-45d9-97f9-1eef8434ce7c"],
 "."
}], "Notes",ExpressionUUID->"db545641-4556-4b88-9084-98c9dc06e1d0"],

Cell[TextData[{
 "Words of different lengths give ",
 Cell[BoxData[
  FormBox["0", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "69f7ceb0-d18f-4fc2-938d-8a515b65c805"],
 "."
}], "Notes",ExpressionUUID->"be5156d6-e0ce-44b8-b0ee-586b4a0f8d7c"],

Cell[TextData[{
 "On two products the value is the sum over all matchings of the factors of \
",
 StyleBox["p", "TI"],
 " with the factors of ",
 StyleBox["q", "TI"],
 ": each term is the product of the values on the matched words, times the \
Koszul sign of the permutation that realizes the matching, times a sign of \
the degrees of the factors of ",
 StyleBox["p", "TI"],
 "."
}], "Notes",ExpressionUUID->"0c313cae-1350-4e64-93ca-40f159bdde48"],

Cell[TextData[{
 "Products with different numbers of factors give ",
 Cell[BoxData[
  FormBox["0", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "f244ecdd-11cb-44cc-941c-5fa3b101cf46"],
 "."
}], "Notes",ExpressionUUID->"4308c3f9-d977-4cb9-9464-66346ed49f4f"],

Cell["\<\
A symmetric product against an exterior product returns unevaluated.\
\>", "Notes",ExpressionUUID->"da97aebd-55bc-4fd0-af44-9c42a5cfafd7"],

