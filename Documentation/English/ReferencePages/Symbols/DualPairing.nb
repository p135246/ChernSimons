 StyleBox["v", "TI"],
 " of dual particles.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"f78fc8ff-22a9-4da8-a8f0-d09c67bd9204"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["DualPairing"]], "paclet:ChernSimons/ref/DualPairing", 
     "ChernSimons Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
