Cell["\<\
The pairing is on cyclic words, so a rotation of the dual word gives the same \
value:\
\>", "ExampleText",ExpressionUUID->"f950cf53-0331-4666-befd-ba5021396006"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"dual", " ", "=", " ", 
   RowBox[{"Pairing", "[", 
    RowBox[{
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"x", " ", "->", " ", 
        RowBox[{"-", "1"}]}], ",", " ", 
       RowBox[{"y", " ", "->", " ", "0"}]}], "|>"}], ",", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "y"}], "}"}], " ", "->", " ", "1"}], "|>"}], ",",
      " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"a", " ", "->", " ", 
        RowBox[{"-", "1"}]}], ",", " ", 
       RowBox[{"b", " ", "->", " ", "0"}]}], "|>"}], ",", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{"x", ",", " ", "a"}], "}"}], " ", "->", " ", "1"}], ",", " ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"y", ",", " ", "b"}], "}"}], " ", "->", " ", "1"}]}], 
      "|>"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"DualPairing", "[", 
    RowBox[{
