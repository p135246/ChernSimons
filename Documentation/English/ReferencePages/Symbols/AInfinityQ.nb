Cell[CellGroupData[{
Cell["AInfinityQ", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"523a73c1-0576-43f0-8113-72272515565c"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["AInfinityQ"]], "paclet:ChernSimons/ref/AInfinityQ", 
     "ChernSimons Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["algebra", "TI"], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1945c031-8f1b-4c06-8a44-5ed2827f043e"],
 "\[LineSeparator]",
 "tests the A-infinity relations on every tuple of basis elements of length \
at most ",
 StyleBox["n", "TI"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"650ec9e6-6a61-4e84-b0b2-c14a87feb2b9"],

Cell[TextData[{
 "A finite check: it says the relations hold up to arity ",
 StyleBox["n", "TI"],
 ", not that they hold. For an algebra whose operations vanish above some \
arity, a large enough ",
 StyleBox["n", "TI"],
 " is conclusive."
}], "Notes",ExpressionUUID->"c848586e-4d23-42fe-b898-2d9a99de49fe"]
}, Open  ]],

