Cell[TextData[{
 "The same algebra with unshifted degrees fails, since at degree ",
 Cell[BoxData[
  FormBox["0", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3b61e042-5160-4f33-ba19-bda784ccc1bc"],
 " the relation asks for anti-associativity:"
}], "ExampleText",ExpressionUUID->"33c609d7-97f1-41ed-b430-3af05ee1c300"],

