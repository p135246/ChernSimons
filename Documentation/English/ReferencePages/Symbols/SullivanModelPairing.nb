 CellLabel->"Out[3]= ",ExpressionUUID->"05e34cb7-36e2-4c28-b1a7-e256b9a9b282"]
}, Open  ]],

Cell[TextData[{
 "The degenerate subspace is not acyclic, since ",
 Cell[BoxData[
  FormBox[
   StyleBox["c", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "1beadcdb-4b60-4db5-8734-218930eb0f49"],
 " is closed and ",
 Cell[BoxData[
  FormBox[
   StyleBox["a", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "1f3fbf4e-3cb1-4e04-899b-6f836b33a209"],
 ", with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["d",
     FontSlant->"Plain"], 
    StyleBox["a", "TI"], "\[LongEqual]", 
    StyleBox["c", "TI"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "d41657bd-5dea-453b-a1b3-b5b825d32883"],
 ", is not degenerate, so the model is not of Hodge type:"
}], "ExampleText",ExpressionUUID->"4d17f848-f99b-48c5-aa3c-b6b3e4a52a58"],

