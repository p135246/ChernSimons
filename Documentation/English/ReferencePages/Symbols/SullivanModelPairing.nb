Cell[CellGroupData[{
Cell["SullivanModelPairing", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"000fd33b-daeb-4654-b0f1-99eba88dc657"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["SullivanModelPairing"]], 
     "paclet:ChernSimons/ref/SullivanModelPairing", 
     "ChernSimons Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["e1", "TI"], ",", " ", 
    StyleBox["e2", "TI"], ",", " ", 
    StyleBox["model", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6d083b7b-13e0-4502-9e4d-312cc25afab4"],
 "\[LineSeparator]",
 "is ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["SullivanModelOrientation"]], 
     "paclet:ChernSimons/ref/SullivanModelOrientation", 
     "ChernSimons Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    RowBox[{"SullivanModelProduct", "[", 
     RowBox[{
      StyleBox["e1", "TI"], ",", " ", 
      StyleBox["e2", "TI"], ",", " ", 
      StyleBox["model", "TI"]}], "]"}], ",", " ", 
    StyleBox["model", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "18a39ac7-1552-4652-849f-122529cb709c"],
 ", the chain-level pairing of the oriented model.",
 "\n"
}], "Usage",ExpressionUUID->"0ea54e88-399a-412b-8316-aeefe26246fc"],

Cell[TextData[{
 "The pairing has degree ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5a541946-310e-4e6c-bc74-1f3420bcb9b6"],
 ", the model's degree: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{
      SubscriptBox[
       StyleBox["e", "TI"], "1"], ",", 
      SubscriptBox[
       StyleBox["e", "TI"], "2"]}], "\[RightAngleBracket]"}], "\[NotEqual]", 
    "0"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "17b15340-5a62-47ea-8c9c-e387d5ff34db"],
 " forces ",
 Cell[BoxData[
  FormBox[
   RowBox[{"|", 
    SubscriptBox[
     StyleBox["e", "TI"], "1"], "|", "+", "|", 
    SubscriptBox[
     StyleBox["e", "TI"], "2"], "|", "\[LongEqual]", 
    StyleBox["n", "TI"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3415e6ca-3c14-4ef1-9ef0-751a5811b9b3"],
 ". It is graded symmetric, and it satisfies the two conditions a pairing on \
a DGA must:"
}], "Notes",ExpressionUUID->"76509599-6a7f-4045-9c7b-ab5014de2bdf"],

Cell[BoxData[
 PaneBox[
  FormBox[
   RowBox[{
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{
      StyleBox["d",
       FontSlant->"Plain"], 
      SubscriptBox[
       StyleBox["e", "TI"], "1"], ",", 
      SubscriptBox[
       StyleBox["e", "TI"], "2"]}], "\[RightAngleBracket]"}], "\[LongEqual]", 
    
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"-", "1"}], ")"}], 
     RowBox[{"|", 
      SubscriptBox[
       StyleBox["e", "TI"], "1"], "|", "+", "1"}]], 
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{
      SubscriptBox[
       StyleBox["e", "TI"], "1"], ",", 
      StyleBox["d",
       FontSlant->"Plain"], 
      SubscriptBox[
       StyleBox["e", "TI"], "2"]}], "\[RightAngleBracket]"}], 
    RowBox[{",", "    "}], 
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{
      SubscriptBox[
       StyleBox["e", "TI"], "1"], 
      SubscriptBox[
       StyleBox["e", "TI"], "2"], ",", 
      SubscriptBox[
       StyleBox["e", "TI"], "3"]}], "\[RightAngleBracket]"}], "\[LongEqual]", 
    
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{
      SubscriptBox[
       StyleBox["e", "TI"], "1"], ",", 
      SubscriptBox[
       StyleBox["e", "TI"], "2"], 
      SubscriptBox[
       StyleBox["e", "TI"], "3"]}], "\[RightAngleBracket]"}], "."}],
   TraditionalForm],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",ExpressionUUID->"d28e68e9-cd00-4c41-\
ac2e-1a00567ad95b"],

Cell[TextData[{
 "It is almost never nondegenerate on chain level \[LongDash] that is what ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DegenerateSubspace"]], 
    "paclet:ChernSimons/ref/DegenerateSubspace", "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "8e656e99-fd56-465a-acde-ee1cb80052d4"],
 " measures and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["NondegenerateQuotient"]], 
    "paclet:ChernSimons/ref/NondegenerateQuotient", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "4c82a68a-6efa-4774-9924-eded42e78b24"],
 " repairs. On cohomology it is perfect, which is what makes the model a PDGA."
}], "Notes",ExpressionUUID->"98ca2d1d-0ec3-4eab-ad19-1fac2e02b212"]
}, Open  ]],

