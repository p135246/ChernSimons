Cell["SullivanModelPairing", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"70f10553-dfd5-4a66-a0ee-185aa8d17aa5"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["SullivanModelPairing"]], 
     "paclet:ChernSimons/ref/SullivanModelPairing", 
     "ChernSimons Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    SubscriptBox[
     StyleBox["e", "TI"], 
     StyleBox["1", "TR"]], ",", " ", 
    SubscriptBox[
     StyleBox["e", "TI"], 
     StyleBox["2", "TR"]], ",", " ", 
    StyleBox["model", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7ac7962f-e339-4bdb-8155-65b621118344"],
 "\[LineSeparator]",
 "gives the pairing of the elements ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["e", "TI"], "1"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "07bbf134-05c7-4c25-a3fe-30a682669e05"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["e", "TI"], "2"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "605f8a9b-f465-4ef4-a464-ea21c06d0485"],
 " of the Sullivan model ",
 StyleBox["model", "TI"],
 ", the orientation of their product.",
 "\n"
}], "Usage",ExpressionUUID->"bebb7e98-97f3-49cd-87a0-880219dccc20"],

Cell[TextData[{
 "The pairing is ",
 Cell[BoxData[
  RowBox[{"SullivanModelOrientation", "[", 
   RowBox[{
    RowBox[{"SullivanModelProduct", "[", 
     RowBox[{"e1", ",", " ", "e2", ",", " ", "model"}], "]"}], ",", " ", 
    "model"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3d4adaf9-b83c-42b4-a52c-e86945eed95f"],
 "."
}], "Notes",
 CellFrameLabels->{{Inherited, Inherited}, {Inherited, 
    Cell[
     TextData[{
      "26.09.30: Design review - the pairing is by definition the orientation \
of the product, and it takes its two elements before the model, as \
SullivanModelProduct does. It is the chain-level pairing from which \
DegenerateSubspace, NondegenerateQuotient, PoincareDualityQ and \
PerfectPairingQ compute. Alternative name considered: ModelPairing, the name \
until 2026-09-21, renamed because \"Model\" alone is generic. Prior art: the \
Wolfram Language pairs vectors with Dot and Inner and has no pairing on a \
graded algebra. The engine the verification suites load defines its pairing \
the same way, as the orientation of its product, and the suites pin this \
function through the degenerate subspace and the Gram matrix of the \
nondegenerate quotient, which they compare with the engine's on the catalogue \
and on Kodaira-Thurston.", "\n\n", 
       Cell[
        BoxData[
         GridBox[{{
            Cell[
             BoxData[
              ButtonBox[
               DynamicBox[
                FEPrivate`FrontEndResource[
                "DocumentationToolsStrings", "Edit"]], BaseStyle -> 
               "TextAnnotationButton"]]], 
            StyleBox[
             RowBox[{
               DynamicBox[
                FEPrivate`FrontEndResource[
                "DocumentationToolsStrings", "LastAnnotator"]], "pavel"}], 
             "TextAnnotator"], 
            Cell[
             BoxData[
              ButtonBox[
               DynamicBox[
                FEPrivate`FrontEndResource[
                "DocumentationToolsStrings", "Delete"]], BaseStyle -> 
               "TextAnnotationRemoveButton"]]], ""}}, 
          GridBoxAlignment -> {
           "Columns" -> {Left, Left, Right, Right}, "Rows" -> {{Automatic}}}, 
          GridBoxItemSize -> {"Columns" -> {
              Scaled[0.15], 
              Scaled[0.68], 
              Scaled[0.15], 
              Scaled[0.02]}}]]], "\n"}], "TextAnnotation", 
     CellSize -> {590, Inherited}]}},
 CellTags->"TextAnnotation",
 CellID->675594969,ExpressionUUID->"7063408c-d5b1-4959-bd0e-29a2e60a631a"],

Cell[TextData[{
 "It has degree ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8f31379b-c9be-4571-afe7-acbbea776a70"],
 ", the degree of the model: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{
      SubscriptBox[
       StyleBox["e", "TI"], "1"], ",", 
      SubscriptBox[
       StyleBox["e", "TI"], "2"]}], "\[RightAngleBracket]"}], "\[NotEqual]", 
    "0"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d32a9b7d-c389-479f-8b42-88816444f5cc"],
 " forces ",
 Cell[BoxData[
  FormBox[
   RowBox[{"|", 
    SubscriptBox[
     StyleBox["e", "TI"], "1"], "|", "+", "|", 
    SubscriptBox[
     StyleBox["e", "TI"], "2"], "|", "\[LongEqual]", 
    StyleBox["n", "TI"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ba31ed6e-7816-4239-95fd-e6143529b2dc"],
 "."
}], "Notes",ExpressionUUID->"16026f43-6459-438b-b6dc-b5f50f1b4e00"],

Cell[TextData[{
 "It is graded symmetric, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{
      SubscriptBox[
       StyleBox["e", "TI"], "1"], ",", 
      SubscriptBox[
       StyleBox["e", "TI"], "2"]}], "\[RightAngleBracket]"}], "\[LongEqual]", 
    
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"-", "1"}], ")"}], 
     TemplateBox[{
       RowBox[{
         SubscriptBox[
          StyleBox["e", "TI"], "1"], "||", 
         SubscriptBox[
          StyleBox["e", "TI"], "2"]}]},
      "Abs"]], 
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{
      SubscriptBox[
       StyleBox["e", "TI"], "2"], ",", 
      SubscriptBox[
       StyleBox["e", "TI"], "1"]}], "\[RightAngleBracket]"}]}], 
   TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9c6508c3-d5a4-4d45-8a68-468e576c5187"],
 ", and bilinear."
}], "Notes",ExpressionUUID->"dea9e4d2-9876-40a8-9388-2eddf27f0c51"],

Cell["\<\
It satisfies the two conditions of a pairing on a differential graded algebra:\
\>", "Notes",ExpressionUUID->"96b9f61b-305a-4174-8303-0ea5efd522b0"],

Cell[BoxData[
 PaneBox[
  FormBox[
   RowBox[{
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{
      StyleBox["d",
       FontSlant->"Plain"], 
      SubscriptBox[
       StyleBox["e", "TI"], "1"], ",", 
      SubscriptBox[
       StyleBox["e", "TI"], "2"]}], "\[RightAngleBracket]"}], "\[LongEqual]", 
    
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"-", "1"}], ")"}], 
     RowBox[{"|", 
      SubscriptBox[
       StyleBox["e", "TI"], "1"], "|", "+", "1"}]], 
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{
      SubscriptBox[
       StyleBox["e", "TI"], "1"], ",", 
      StyleBox["d",
       FontSlant->"Plain"], 
      SubscriptBox[
       StyleBox["e", "TI"], "2"]}], "\[RightAngleBracket]"}], 
    RowBox[{",", "    "}], 
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{
      SubscriptBox[
       StyleBox["e", "TI"], "1"], 
      SubscriptBox[
       StyleBox["e", "TI"], "2"], ",", 
      SubscriptBox[
       StyleBox["e", "TI"], "3"]}], "\[RightAngleBracket]"}], "\[LongEqual]", 
    
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{
      SubscriptBox[
       StyleBox["e", "TI"], "1"], ",", 
      SubscriptBox[
       StyleBox["e", "TI"], "2"], 
      SubscriptBox[
       StyleBox["e", "TI"], "3"]}], "\[RightAngleBracket]"}], "."}],
   TraditionalForm],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",ExpressionUUID->"3654f312-338d-467c-\
b067-6523e9996417"],

Cell[TextData[{
 "On chain level it is in general degenerate. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DegenerateSubspace"]], 
    "paclet:ChernSimons/ref/DegenerateSubspace", "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "03792796-d2de-4699-a3fe-6f911321e252"],
 " gives its kernel and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["NondegenerateQuotient"]], 
    "paclet:ChernSimons/ref/NondegenerateQuotient", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "894a1ee4-cbea-4892-9764-e772ebbbb520"],
 " the quotient by it."
}], "Notes",ExpressionUUID->"8015a230-f057-41a4-a17f-dac994b646d0"],

Cell[TextData[{
 "It descends to cohomology, where it is perfect exactly when ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["PoincareDualityQ"]], "paclet:ChernSimons/ref/PoincareDualityQ",
     "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "471fb487-22f5-4b33-a402-d1f81e07e8c5"],
 " gives ",
 Cell[BoxData["True"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b1e8918a-74c1-4caa-b992-6ffc55d94088"],
 "."
}], "Notes",ExpressionUUID->"88719657-5362-4a5d-8249-a8cdd4849c61"]
}, Open  ]],

