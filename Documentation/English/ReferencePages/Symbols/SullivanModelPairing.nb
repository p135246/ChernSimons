Cell["SullivanModelPairing", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"9f719d0a-3bcb-427e-91c4-59b6b83c5b11"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["SullivanModelPairing"]], 
     "paclet:ChernSimons/ref/SullivanModelPairing", 
     "ChernSimons Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    SubscriptBox[
     StyleBox["e", "TI"], 
     StyleBox["1", "TR"]], ",", " ", 
    SubscriptBox[
     StyleBox["e", "TI"], 
     StyleBox["2", "TR"]], ",", " ", 
    StyleBox["model", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b10cd31a-0b14-496f-b4b2-5c0a0cea5a35"],
 "\[LineSeparator]",
 "gives the pairing of the elements ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["e", "TI"], "1"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "358445bb-ab94-4ff4-8116-70ac9e3ea340"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["e", "TI"], "2"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "09d2addf-f1c7-4756-8ca1-1c34e4f34426"],
 " of the Sullivan model ",
 StyleBox["model", "TI"],
 ", the orientation of their product.",
 "\n"
}], "Usage",ExpressionUUID->"f1ef1864-aa76-4428-8af5-958e2a9422e5"],

Cell[TextData[{
 "The pairing is ",
 Cell[BoxData[
  RowBox[{"SullivanModelOrientation", "[", 
   RowBox[{
    RowBox[{"SullivanModelProduct", "[", 
     RowBox[{"e1", ",", " ", "e2", ",", " ", "model"}], "]"}], ",", " ", 
    "model"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "36fd3da1-b9fc-4aa4-afa4-3ce510f90eaf"],
 "."
}], "Notes",
 CellFrameLabels->{{Inherited, Inherited}, {Inherited, 
    Cell[
     TextData[{
      "26.09.30: Design review - the pairing is by definition the orientation \
of the product, and it takes its two elements before the model, as \
SullivanModelProduct does. It is the chain-level pairing from which \
DegenerateSubspace, NondegenerateQuotient, PoincareDualityQ and \
PerfectPairingQ compute. Alternative name considered: ModelPairing, the name \
until 2026-09-21, renamed because \"Model\" alone is generic. Prior art: the \
Wolfram Language pairs vectors with Dot and Inner and has no pairing on a \
graded algebra. The engine the verification suites load defines its pairing \
the same way, as the orientation of its product, and the suites pin this \
function through the degenerate subspace and the Gram matrix of the \
nondegenerate quotient, which they compare with the engine's on the catalogue \
and on Kodaira-Thurston.", "\n\n", 
       Cell[
        BoxData[
         GridBox[{{
            Cell[
             BoxData[
              ButtonBox[
               DynamicBox[
                FEPrivate`FrontEndResource[
                "DocumentationToolsStrings", "Edit"]], BaseStyle -> 
               "TextAnnotationButton"]]], 
            StyleBox[
             RowBox[{
               DynamicBox[
                FEPrivate`FrontEndResource[
                "DocumentationToolsStrings", "LastAnnotator"]], "pavel"}], 
             "TextAnnotator"], 
            Cell[
             BoxData[
              ButtonBox[
               DynamicBox[
                FEPrivate`FrontEndResource[
                "DocumentationToolsStrings", "Delete"]], BaseStyle -> 
               "TextAnnotationRemoveButton"]]], ""}}, 
          GridBoxAlignment -> {
           "Columns" -> {Left, Left, Right, Right}, "Rows" -> {{Automatic}}}, 
          GridBoxItemSize -> {"Columns" -> {
              Scaled[0.15], 
              Scaled[0.68], 
              Scaled[0.15], 
              Scaled[0.02]}}]]], "\n"}], "TextAnnotation", 
     CellSize -> {590, Inherited}]}},
 CellTags->"TextAnnotation",
 CellID->327101587,ExpressionUUID->"17aa0c79-dab9-4db0-890b-7207fc6ecfb5"],

Cell[TextData[{
 "It has degree ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "59066cf7-e17d-448a-b3a6-1385233d5808"],
 ", the degree of the model: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{
      SubscriptBox[
       StyleBox["e", "TI"], "1"], ",", 
      SubscriptBox[
       StyleBox["e", "TI"], "2"]}], "\[RightAngleBracket]"}], "\[NotEqual]", 
    "0"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8c5f2f4f-5ddd-4b67-9e68-ec3f8aa3106f"],
 " forces ",
 Cell[BoxData[
  FormBox[
   RowBox[{"|", 
    SubscriptBox[
     StyleBox["e", "TI"], "1"], "|", "+", "|", 
    SubscriptBox[
     StyleBox["e", "TI"], "2"], "|", "\[LongEqual]", 
    StyleBox["n", "TI"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3bf553e8-737a-44b2-877c-465d74e0c438"],
 "."
}], "Notes",ExpressionUUID->"332bd050-02bf-4102-8fb6-b94f0f624920"],

Cell[TextData[{
 "It is graded symmetric, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{
      SubscriptBox[
       StyleBox["e", "TI"], "1"], ",", 
      SubscriptBox[
       StyleBox["e", "TI"], "2"]}], "\[RightAngleBracket]"}], "\[LongEqual]", 
    
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"-", "1"}], ")"}], 
     TemplateBox[{
       RowBox[{
         SubscriptBox[
          StyleBox["e", "TI"], "1"], "||", 
         SubscriptBox[
          StyleBox["e", "TI"], "2"]}]},
      "Abs"]], 
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{
      SubscriptBox[
       StyleBox["e", "TI"], "2"], ",", 
      SubscriptBox[
       StyleBox["e", "TI"], "1"]}], "\[RightAngleBracket]"}]}], 
   TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ddf35d54-1daf-4954-875f-cf0151d318d3"],
 ", and bilinear."
}], "Notes",ExpressionUUID->"8ecef8c3-2098-476f-8003-b25e5b397919"],

Cell["\<\
It satisfies the two conditions of a pairing on a differential graded algebra:\
\>", "Notes",ExpressionUUID->"cb0af7a3-1192-4add-b9b8-435507d6f413"],

Cell[BoxData[
 PaneBox[
  FormBox[
   RowBox[{
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{
      StyleBox["d",
       FontSlant->"Plain"], 
      SubscriptBox[
       StyleBox["e", "TI"], "1"], ",", 
      SubscriptBox[
       StyleBox["e", "TI"], "2"]}], "\[RightAngleBracket]"}], "\[LongEqual]", 
    
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"-", "1"}], ")"}], 
     RowBox[{"|", 
      SubscriptBox[
       StyleBox["e", "TI"], "1"], "|", "+", "1"}]], 
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{
      SubscriptBox[
       StyleBox["e", "TI"], "1"], ",", 
      StyleBox["d",
       FontSlant->"Plain"], 
      SubscriptBox[
       StyleBox["e", "TI"], "2"]}], "\[RightAngleBracket]"}], 
    RowBox[{",", "    "}], 
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{
      SubscriptBox[
       StyleBox["e", "TI"], "1"], 
      SubscriptBox[
       StyleBox["e", "TI"], "2"], ",", 
      SubscriptBox[
       StyleBox["e", "TI"], "3"]}], "\[RightAngleBracket]"}], "\[LongEqual]", 
    
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{
      SubscriptBox[
       StyleBox["e", "TI"], "1"], ",", 
      SubscriptBox[
       StyleBox["e", "TI"], "2"], 
      SubscriptBox[
       StyleBox["e", "TI"], "3"]}], "\[RightAngleBracket]"}], "."}],
   TraditionalForm],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",ExpressionUUID->"8c07337d-77e7-4c6b-\
988c-18b45c07583e"],

Cell[TextData[{
 "On chain level it is in general degenerate. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DegenerateSubspace"]], 
    "paclet:ChernSimons/ref/DegenerateSubspace", "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "2034e2b3-334d-48a7-8473-68ff700270cc"],
 " gives its kernel and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["NondegenerateQuotient"]], 
    "paclet:ChernSimons/ref/NondegenerateQuotient", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "fc9a0f72-2c73-4ea9-aa71-fa4c2ebdbdbb"],
 " the quotient by it."
}], "Notes",ExpressionUUID->"64b0f10b-ba50-44c3-bb5e-aca61a847a52"],

Cell[TextData[{
 "It descends to cohomology, where it is perfect exactly when ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["PoincareDualityQ"]], "paclet:ChernSimons/ref/PoincareDualityQ",
     "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "4f997d4a-2e9f-4c85-a704-28d14b267ce6"],
 " gives ",
 Cell[BoxData["True"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4c267412-fc98-4a4e-9eb8-fa36283e9da7"],
 "."
}], "Notes",ExpressionUUID->"0cae81dc-8aec-43a6-b290-32d8750efae8"]
}, Open  ]],

