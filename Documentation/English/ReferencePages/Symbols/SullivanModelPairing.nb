 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["NondegenerateQuotient"]], 
    "paclet:ChernSimons/ref/NondegenerateQuotient", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "07819ab8-0466-4d31-bd09-946f9fb0ad85"],
 " the quotient by it."
}], "Notes",ExpressionUUID->"0fa8c0e1-268d-499f-8f76-eb19989bd430"],

Cell[TextData[{
 "It descends to cohomology, where it is perfect exactly when ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["PoincareDualityQ"]], "paclet:ChernSimons/ref/PoincareDualityQ",
     "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "4a869132-4a02-4e4f-88b6-703662e2a7bf"],
 " gives ",
 Cell[BoxData[
 "True"], "InlineFormula",ExpressionUUID->
  "e9f1990d-fb0a-47df-b355-8f6008509483"],
 "."
}], "Notes",ExpressionUUID->"fcdbfe5b-7a72-4003-8894-b33a3214807b"]
}, Open  ]],

