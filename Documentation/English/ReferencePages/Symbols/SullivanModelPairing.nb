Cell[TextData[{
 "Yet the whole of degree ",
 Cell[BoxData[
  FormBox["3", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "ddb68b7a-f1b6-4259-854b-cd1a8f26e170"],
 " is degenerate:"
}], "ExampleText",ExpressionUUID->"45baa1b9-1416-41ff-bd96-f06f6f0ec7cd"],

Cell[CellGroupData[{

