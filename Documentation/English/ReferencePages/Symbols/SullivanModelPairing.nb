Cell[TextData[{
 "The pairing of ",
 Cell[BoxData[
  FormBox[
   StyleBox["a", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "462d6100-670a-474d-a0bd-e65735e543d0"],
 " with itself is nonzero:"
}], "ExampleText",ExpressionUUID->"3dd45d37-d0dd-4105-8e4d-703b5dbb1c55"],

