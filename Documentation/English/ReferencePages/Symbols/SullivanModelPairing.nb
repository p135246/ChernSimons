Cell["\<\
Compatibility with the differential, at a degree where both sides are nonzero:\
\>", "ExampleText",ExpressionUUID->"00a87a18-ecc3-488c-9b11-0eb647334f40"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"model", " ", "=", " ", 
   RowBox[{"SullivanModel", "[", "\"\<HeisenbergNilmanifold\>\"", "]"}]}], 
  ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"SullivanModelPairing", "[", 
    RowBox[{
     RowBox[{"SullivanModelDifferential", "[", 
      RowBox[{"z", ",", " ", "model"}], "]"}], ",", " ", "z", ",", " ", 
     "model"}], "]"}], ",", "\n", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"-", "1"}], ")"}], "^", 
     RowBox[{"(", 
      RowBox[{"1", " ", "+", " ", "1"}], ")"}]}], " ", 
    RowBox[{"SullivanModelPairing", "[", 
     RowBox[{"z", ",", " ", 
      RowBox[{"SullivanModelDifferential", "[", 
       RowBox[{"z", ",", " ", "model"}], "]"}], ",", " ", "model"}], 
     "]"}]}]}], "}"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"066ef7ca-4046-4078-bd79-21734b7bac93"],

