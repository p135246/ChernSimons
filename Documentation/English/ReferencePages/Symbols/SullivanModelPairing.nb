Cell[TextData[{
 "The pairing of ",
 Cell[BoxData[
  FormBox[
   StyleBox["a", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9c5d34ec-32cb-4942-823c-a9b6233dbe8e"],
 " with itself is nonzero:"
}], "ExampleText",ExpressionUUID->"85c2842a-99a4-45e9-a442-c67667c6fb85"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"SullivanModelPairing", "[", 
