Cell[TextData[{
 "Yet the whole of degree ",
 Cell[BoxData[
  FormBox["3", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "5870b78e-647e-4b23-8e66-e0a4a0f358de"],
