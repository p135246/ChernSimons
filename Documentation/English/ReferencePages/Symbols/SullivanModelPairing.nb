 CellLabel->"Out[3]= ",ExpressionUUID->"2cc37596-b457-42ff-8ad0-e9c18391e5da"]
}, Open  ]],

Cell[TextData[{
 "The degenerate subspace is not acyclic, since ",
 Cell[BoxData[
  FormBox[
   StyleBox["c", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "30dc277e-58ab-4bea-8058-3aff4138cf2b"],
 " is closed and ",
 Cell[BoxData[
  FormBox[
   StyleBox["a", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f14139e4-f9ff-4259-9563-5413f2452caf"],
 ", with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["d",
     FontSlant->"Plain"], 
    StyleBox["a", "TI"], "\[LongEqual]", 
    StyleBox["c", "TI"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bf4c3a34-a201-47a8-9d54-d809ad276efc"],
 ", is not degenerate, so the model is not of Hodge type:"
}], "ExampleText",ExpressionUUID->"39ab95c6-160a-4682-9d61-f23d5df6d015"],

