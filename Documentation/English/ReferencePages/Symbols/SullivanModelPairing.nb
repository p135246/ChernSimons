Cell[TextData[{
 "The pairing of ",
 Cell[BoxData[
  FormBox[
   StyleBox["a", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "12eaa3c5-2c0f-499b-a888-c0718cea5d54"],
 " with itself is nonzero:"
}], "ExampleText",ExpressionUUID->"66f0d7b1-3e8c-4a07-bc47-f73376272d8c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"SullivanModelPairing", "[", 
