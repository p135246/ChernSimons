 CellLabel->"Out[3]= ",ExpressionUUID->"4b3d55a5-8e2e-4eb1-aaa4-06b57cd8849c"]
}, Open  ]],

Cell[TextData[{
 "The degenerate subspace is not acyclic, since ",
 Cell[BoxData[
  FormBox[
   StyleBox["c", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "8d13e039-1b14-4453-9d8d-a8d8f731f860"],
 " is closed and ",
 Cell[BoxData[
  FormBox[
   StyleBox["a", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "c7c01819-50d7-432a-9996-9a5996d0572c"],
 ", with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["d",
     FontSlant->"Plain"], 
    StyleBox["a", "TI"], "\[LongEqual]", 
    StyleBox["c", "TI"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "7d0cb227-564a-40f5-b4a2-3107f27c502b"],
 ", is not degenerate, so the model is not of Hodge type:"
}], "ExampleText",ExpressionUUID->"11451992-b070-4374-bbff-34b0274d5a74"],

