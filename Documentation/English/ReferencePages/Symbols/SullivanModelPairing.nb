Cell[TextData[{
 "The pairing being nonzero on an element does not make it nondegenerate: in \
the model of the degree-",
 Cell[BoxData[
  FormBox["4", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ed9d85e1-af34-4874-984d-f76fe01c8eb8"],
 " obstruction ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{
      StyleBox["a", "TI"], ",", 
      StyleBox["a", "TI"]}], "\[RightAngleBracket]"}], "\[LongEqual]", "1"}], 
   TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "884b8337-cf9e-4f52-805f-d3ce31db6a59"],
 " while the whole of degree ",
 Cell[BoxData[
  FormBox["3", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7f221d39-8ab9-4d71-8d98-6d81209ad588"],
 " is degenerate, and that is exactly why the model is not of Hodge type."
}], "ExampleText",ExpressionUUID->"8e6e8119-52b9-420b-9f24-576683806f08"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"model", " ", "=", " ", 
   RowBox[{"SullivanModel", "[", "\"\<Degree4Obstruction\>\"", "]"}]}], 
  ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
