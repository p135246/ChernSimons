Cell[TextData[{
 "The degenerate subspace is not acyclic, since ",
 Cell[BoxData[
  FormBox[
   StyleBox["c", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6a81277b-9c2d-48a6-becf-522b1047a45b"],
 " is closed and ",
