}, Open  ]],

Cell[TextData[{
 "Yet the whole of degree ",
 Cell[BoxData[
  FormBox["3", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3fe5c125-ba2b-4784-aaa3-31696c92e6ce"],
 " is degenerate:"
}], "ExampleText",ExpressionUUID->"99cb2e41-d3f2-451a-a79d-9439ab8017f6"],

