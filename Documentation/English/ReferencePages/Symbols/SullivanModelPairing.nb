Cell["SullivanModelPairing", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"f063ddae-b965-4faf-98c8-7c0f9718c5a3"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["SullivanModelPairing"]], 
     "paclet:ChernSimons/ref/SullivanModelPairing", 
     "ChernSimons Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    SubscriptBox[
     StyleBox["e", "TI"], 
     StyleBox["1", "TR"]], ",", " ", 
    SubscriptBox[
     StyleBox["e", "TI"], 
     StyleBox["2", "TR"]], ",", " ", 
    StyleBox["model", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "0226cf62-abec-4657-828a-0eeb649b0490"],
 "\[LineSeparator]",
 "gives the pairing of the elements ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["e", "TI"], "1"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"298a72d3-600f-4d55-8e8a-b8740b369278"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["e", "TI"], "2"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"db8b5569-9307-4fc4-8508-cbbcd14cc196"],
 " of the Sullivan model ",
 StyleBox["model", "TI"],
 ", the orientation of their product.",
 "\n"
}], "Usage",ExpressionUUID->"535dfa36-d8b2-4b64-a8dc-cf27c9c06caa"],

Cell[TextData[{
 "The pairing is ",
 Cell[BoxData[
  RowBox[{"SullivanModelOrientation", "[", 
   RowBox[{
    RowBox[{"SullivanModelProduct", "[", 
     RowBox[{"e1", ",", " ", "e2", ",", " ", "model"}], "]"}], ",", " ", 
    "model"}], "]"}]], "InlineFormula",ExpressionUUID->
  "64ea2d43-12fe-4427-a6ed-d7ffda462b92"],
 "."
}], "Notes",
 CellFrameLabels->{{Inherited, Inherited}, {Inherited, 
    Cell[
     TextData[{
      "26.09.30: Design review - the pairing is by definition the orientation \
of the product, and it takes its two elements before the model, as \
SullivanModelProduct does. It is the chain-level pairing from which \
DegenerateSubspace, NondegenerateQuotient, PoincareDualityQ and \
PerfectPairingQ compute. Alternative name considered: ModelPairing, the name \
until 2026-09-21, renamed because \"Model\" alone is generic. Prior art: the \
Wolfram Language pairs vectors with Dot and Inner and has no pairing on a \
graded algebra. The engine the verification suites load defines its pairing \
the same way, as the orientation of its product, and the suites pin this \
function through the degenerate subspace and the Gram matrix of the \
nondegenerate quotient, which they compare with the engine's on the catalogue \
and on Kodaira-Thurston.", "\n\n", 
       Cell[
        BoxData[
         GridBox[{{
            Cell[
             BoxData[
              ButtonBox[
               DynamicBox[
                FEPrivate`FrontEndResource[
                "DocumentationToolsStrings", "Edit"]], BaseStyle -> 
               "TextAnnotationButton"]]], 
            StyleBox[
             RowBox[{
               DynamicBox[
                FEPrivate`FrontEndResource[
                "DocumentationToolsStrings", "LastAnnotator"]], "pavel"}], 
             "TextAnnotator"], 
            Cell[
             BoxData[
              ButtonBox[
               DynamicBox[
                FEPrivate`FrontEndResource[
                "DocumentationToolsStrings", "Delete"]], BaseStyle -> 
               "TextAnnotationRemoveButton"]]], ""}}, 
          GridBoxAlignment -> {
           "Columns" -> {Left, Left, Right, Right}, "Rows" -> {{Automatic}}}, 
          GridBoxItemSize -> {"Columns" -> {
              Scaled[0.15], 
              Scaled[0.68], 
              Scaled[0.15], 
              Scaled[0.02]}}]]], "\n"}], "TextAnnotation", 
     CellSize -> {590, Inherited}]}},
 CellTags->"TextAnnotation",
 CellID->698257314,ExpressionUUID->"361412b4-3599-411b-a691-985bd7ea5672"],

Cell[TextData[{
 "It has degree ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "a29de885-ccd0-431b-967f-a33a47646138"],
 ", the degree of the model: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{
      SubscriptBox[
       StyleBox["e", "TI"], "1"], ",", 
      SubscriptBox[
       StyleBox["e", "TI"], "2"]}], "\[RightAngleBracket]"}], "\[NotEqual]", 
    "0"}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "cc0df9a3-f5bd-4031-a970-f37b28c66ff3"],
 " forces ",
 Cell[BoxData[
  FormBox[
   RowBox[{"|", 
    SubscriptBox[
     StyleBox["e", "TI"], "1"], "|", "+", "|", 
    SubscriptBox[
     StyleBox["e", "TI"], "2"], "|", "\[LongEqual]", 
    StyleBox["n", "TI"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "cf2048ee-417a-4780-a8fd-a1a511e73d77"],
 "."
}], "Notes",ExpressionUUID->"6c9a2ab0-79f3-469d-b96d-e2606f905be3"],

Cell[TextData[{
 "It is graded symmetric, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{
      SubscriptBox[
       StyleBox["e", "TI"], "1"], ",", 
      SubscriptBox[
       StyleBox["e", "TI"], "2"]}], "\[RightAngleBracket]"}], "\[LongEqual]", 
    
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"-", "1"}], ")"}], 
     TemplateBox[{
       RowBox[{
         SubscriptBox[
          StyleBox["e", "TI"], "1"], "||", 
         SubscriptBox[
          StyleBox["e", "TI"], "2"]}]},
      "Abs"]], 
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{
      SubscriptBox[
       StyleBox["e", "TI"], "2"], ",", 
      SubscriptBox[
       StyleBox["e", "TI"], "1"]}], "\[RightAngleBracket]"}]}], 
   TraditionalForm]], "InlineFormula",ExpressionUUID->
  "d30f4eb0-fdc9-490f-87af-c20f95eb4727"],
 ", and bilinear."
}], "Notes",ExpressionUUID->"e04034c2-49ad-4e56-b30e-47cd5a067d5f"],

Cell["\<\
It satisfies the two conditions of a pairing on a differential graded algebra:\
\>", "Notes",ExpressionUUID->"c7e3221c-0531-4c77-a60a-4b632c346588"],

Cell[BoxData[
 PaneBox[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"\[LeftAngleBracket]", 
      RowBox[{
       StyleBox["d",
        FontSlant->"Plain"], 
       SubscriptBox[
        StyleBox["e", "TI"], "1"], ",", 
       SubscriptBox[
        StyleBox["e", "TI"], "2"]}], "\[RightAngleBracket]"}], "\[LongEqual]", 
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"-", "1"}], ")"}], 
       RowBox[{"|", 
        SubscriptBox[
         StyleBox["e", "TI"], "1"], "|", "+", "1"}]], 
      RowBox[{"\[LeftAngleBracket]", 
       RowBox[{
        SubscriptBox[
         StyleBox["e", "TI"], "1"], ",", 
        StyleBox["d",
         FontSlant->"Plain"], 
        SubscriptBox[
         StyleBox["e", "TI"], "2"]}], "\[RightAngleBracket]"}]}]}], ",", 
    "    ", 
    RowBox[{
     RowBox[{"\[LeftAngleBracket]", 
      RowBox[{
       SubscriptBox[
        StyleBox["e", "TI"], "1"], 
       SubscriptBox[
        StyleBox["e", "TI"], "2"], ",", 
       SubscriptBox[
        StyleBox["e", "TI"], "3"]}], "\[RightAngleBracket]"}], "\[LongEqual]", 
     RowBox[{
      RowBox[{"\[LeftAngleBracket]", 
       RowBox[{
        SubscriptBox[
         StyleBox["e", "TI"], "1"], ",", 
        SubscriptBox[
         StyleBox["e", "TI"], "2"], 
        SubscriptBox[
         StyleBox["e", "TI"], "3"]}], "\[RightAngleBracket]"}], "."}]}]}],
   TraditionalForm],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",ExpressionUUID->"eceef566-44e0-43d2-\
83f4-a0344b3ab892"],

Cell[TextData[{
 "On chain level it is in general degenerate. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DegenerateSubspace"]], 
    "paclet:ChernSimons/ref/DegenerateSubspace", "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "ecd47cd2-9e41-46db-8eae-5bb81aa7858c"],
