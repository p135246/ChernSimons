Cell[CellGroupData[{
Cell["SullivanModelPairing", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"15913907-06d6-4559-a39a-2ffa26d7aea7"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["SullivanModelPairing"]], 
     "paclet:ChernSimons/ref/SullivanModelPairing", 
     "ChernSimons Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    SubscriptBox[
     StyleBox["e", "TI"], 
     StyleBox["1", "TR"]], ",", " ", 
    SubscriptBox[
     StyleBox["e", "TI"], 
     StyleBox["2", "TR"]], ",", " ", 
    StyleBox["model", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "f7a2ad85-c1d1-41fc-8053-d92c4effc479"],
 "\[LineSeparator]",
 "gives the pairing of the elements ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["e", "TI"], "1"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"4c3ad6fb-f35d-4661-8e67-1402d5f50016"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["e", "TI"], "2"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"8338d6c3-a6d0-4378-8c00-4a20ae0fde66"],
 " of the Sullivan model ",
 StyleBox["model", "TI"],
 ", the orientation of their product.",
 "\n"
}], "Usage",ExpressionUUID->"c9738f18-f940-4dcb-8a9f-cd01bf25e70a"],

Cell[TextData[{
 "The pairing is ",
 Cell[BoxData[
  RowBox[{"SullivanModelOrientation", "[", 
   RowBox[{
    RowBox[{"SullivanModelProduct", "[", 
     RowBox[{"e1", ",", " ", "e2", ",", " ", "model"}], "]"}], ",", " ", 
    "model"}], "]"}]], "InlineFormula",ExpressionUUID->
  "68dd53a9-fa76-4d8d-a154-6cc8cccbb157"],
 "."
}], "Notes",
 CellFrameLabels->{{Inherited, Inherited}, {Inherited, 
    Cell[
     TextData[{
      "26.09.30: Design review - the pairing is by definition the orientation \
of the product, and it takes its two elements before the model, as \
SullivanModelProduct does. It is the chain-level pairing from which \
DegenerateSubspace, NondegenerateQuotient, PoincareDualityQ and \
PerfectPairingQ compute. Alternative name considered: ModelPairing, the name \
until 2026-09-21, renamed because \"Model\" alone is generic. Prior art: the \
Wolfram Language pairs vectors with Dot and Inner and has no pairing on a \
graded algebra. The engine the verification suites load defines its pairing \
the same way, as the orientation of its product, and the suites pin this \
function through the degenerate subspace and the Gram matrix of the \
nondegenerate quotient, which they compare with the engine's on the catalogue \
and on Kodaira-Thurston.", "\n\n", 
       Cell[
        BoxData[
         GridBox[{{
            Cell[
             BoxData[
              ButtonBox[
               DynamicBox[
                FEPrivate`FrontEndResource[
                "DocumentationToolsStrings", "Edit"]], BaseStyle -> 
               "TextAnnotationButton"]]], 
            StyleBox[
             RowBox[{
               DynamicBox[
                FEPrivate`FrontEndResource[
                "DocumentationToolsStrings", "LastAnnotator"]], "pavel"}], 
             "TextAnnotator"], 
            Cell[
             BoxData[
              ButtonBox[
               DynamicBox[
                FEPrivate`FrontEndResource[
                "DocumentationToolsStrings", "Delete"]], BaseStyle -> 
               "TextAnnotationRemoveButton"]]], ""}}, 
          GridBoxAlignment -> {
           "Columns" -> {Left, Left, Right, Right}, "Rows" -> {{Automatic}}}, 
          GridBoxItemSize -> {"Columns" -> {
              Scaled[0.15], 
              Scaled[0.68], 
              Scaled[0.15], 
              Scaled[0.02]}}]]], "\n"}], "TextAnnotation", 
     CellSize -> {590, Inherited}]}},
 CellTags->"TextAnnotation",
 CellID->707234605,ExpressionUUID->"da6cba8d-0151-4773-9d97-c3684f5ebd89"],

Cell[TextData[{
 "It has degree ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "f9420484-f766-4193-a129-7763b517fe57"],
 ", the degree of the model: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{
      SubscriptBox[
       StyleBox["e", "TI"], "1"], ",", 
      SubscriptBox[
       StyleBox["e", "TI"], "2"]}], "\[RightAngleBracket]"}], "\[NotEqual]", 
    "0"}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "33f35b44-ce67-4e01-b624-0ef068aa1c19"],
 " forces ",
 Cell[BoxData[
  FormBox[
   RowBox[{"|", 
    SubscriptBox[
     StyleBox["e", "TI"], "1"], "|", "+", "|", 
    SubscriptBox[
     StyleBox["e", "TI"], "2"], "|", "\[LongEqual]", 
    StyleBox["n", "TI"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "1fc49838-3e79-4b46-8168-c6d420fd9673"],
 "."
}], "Notes",ExpressionUUID->"b724ca6c-6524-4e96-97bb-732a093cfcdd"],

Cell[TextData[{
 "It is graded symmetric, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{
      SubscriptBox[
       StyleBox["e", "TI"], "1"], ",", 
      SubscriptBox[
       StyleBox["e", "TI"], "2"]}], "\[RightAngleBracket]"}], "\[LongEqual]", 
    
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"-", "1"}], ")"}], 
     TemplateBox[{
       RowBox[{
         SubscriptBox[
          StyleBox["e", "TI"], "1"], "||", 
         SubscriptBox[
          StyleBox["e", "TI"], "2"]}]},
      "Abs"]], 
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{
      SubscriptBox[
       StyleBox["e", "TI"], "2"], ",", 
      SubscriptBox[
       StyleBox["e", "TI"], "1"]}], "\[RightAngleBracket]"}]}], 
   TraditionalForm]], "InlineFormula",ExpressionUUID->
  "cfdeee97-2375-4315-a402-78eee924a9a6"],
 ", and bilinear."
}], "Notes",ExpressionUUID->"f0ea1c61-6358-4ad4-bda2-78d9768c44dd"],

Cell["\<\
It satisfies the two conditions of a pairing on a differential graded algebra:\
\>", "Notes",ExpressionUUID->"79c5e868-b664-4c80-9c69-396ed1fea81a"],

Cell[BoxData[
 PaneBox[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"\[LeftAngleBracket]", 
      RowBox[{
       StyleBox["d",
        FontSlant->"Plain"], 
       SubscriptBox[
        StyleBox["e", "TI"], "1"], ",", 
       SubscriptBox[
        StyleBox["e", "TI"], "2"]}], "\[RightAngleBracket]"}], "\[LongEqual]", 
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"-", "1"}], ")"}], 
       RowBox[{"|", 
        SubscriptBox[
         StyleBox["e", "TI"], "1"], "|", "+", "1"}]], 
      RowBox[{"\[LeftAngleBracket]", 
       RowBox[{
        SubscriptBox[
         StyleBox["e", "TI"], "1"], ",", 
        StyleBox["d",
         FontSlant->"Plain"], 
        SubscriptBox[
         StyleBox["e", "TI"], "2"]}], "\[RightAngleBracket]"}]}]}], ",", 
    "    ", 
    RowBox[{
     RowBox[{"\[LeftAngleBracket]", 
      RowBox[{
       SubscriptBox[
        StyleBox["e", "TI"], "1"], 
       SubscriptBox[
        StyleBox["e", "TI"], "2"], ",", 
       SubscriptBox[
        StyleBox["e", "TI"], "3"]}], "\[RightAngleBracket]"}], "\[LongEqual]", 
     RowBox[{
      RowBox[{"\[LeftAngleBracket]", 
       RowBox[{
        SubscriptBox[
         StyleBox["e", "TI"], "1"], ",", 
        SubscriptBox[
         StyleBox["e", "TI"], "2"], 
        SubscriptBox[
         StyleBox["e", "TI"], "3"]}], "\[RightAngleBracket]"}], "."}]}]}],
   TraditionalForm],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",ExpressionUUID->"823bce04-dd5a-474b-\
a9b6-f207af2d7825"],

Cell[TextData[{
 "On chain level it is in general degenerate. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DegenerateSubspace"]], 
    "paclet:ChernSimons/ref/DegenerateSubspace", "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "ed2dca36-bac1-4c31-98c3-30e155ec359a"],
 " gives its kernel and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["NondegenerateQuotient"]], 
    "paclet:ChernSimons/ref/NondegenerateQuotient", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "3bc42d8b-cc9d-4b47-8ec1-3ee8287e532f"],
 " the quotient by it."
}], "Notes",ExpressionUUID->"c7201185-7b7e-495d-80ca-e62079775970"],

Cell[TextData[{
 "It descends to cohomology, where it is perfect exactly when ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["PoincareDualityQ"]], "paclet:ChernSimons/ref/PoincareDualityQ",
     "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "31f6d3cd-5c79-4814-8bcb-1bdda5a3e7ef"],
 " gives ",
 Cell[BoxData[
 "True"], "InlineFormula",ExpressionUUID->
  "295ab6cb-2d90-417e-bbeb-c7049b65efa6"],
 "."
}], "Notes",ExpressionUUID->"5cac3985-e079-4a14-9eba-4b6ad15870fc"]
}, Open  ]],

