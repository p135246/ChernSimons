Cell[TextData[{
 "The pairing of ",
 Cell[BoxData[
  FormBox[
   StyleBox["a", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "6f38b691-4747-4658-a6cb-c4b1402cea54"],
 " with itself is nonzero:"
}], "ExampleText",ExpressionUUID->"6d59df2e-2a01-4248-9578-46d3db8d354d"],

Cell[CellGroupData[{

