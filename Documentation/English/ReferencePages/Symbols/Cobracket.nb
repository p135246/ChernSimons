Cell["\<\
The first nonzero co-bracket over the alphabet of the circle:\
\>", "ExampleText",ExpressionUUID->"f82e99ee-8eb1-4339-9f0f-6d33c2ba9467"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Cobracket", "[", 
  RowBox[{
   RowBox[{"CyclicWord", "[", 
    RowBox[{"{", 
     RowBox[{"x", ",", " ", "y", ",", " ", "y", ",", " ", "y"}], "}"}], "]"}],
    ",", " ", 
   RowBox[{"Pairing", "[", 
    RowBox[{
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"x", " ", "->", " ", 
        RowBox[{"-", "1"}]}], ",", " ", 
       RowBox[{"y", " ", "->", " ", "0"}]}], "|>"}], ",", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "y"}], "}"}], " ", "->", " ", "1"}], "|>"}]}], 
    "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"f49b01bf-394b-4318-84b8-8b8c508a8b9b"],

Cell[BoxData[
 RowBox[{"-", 
  RowBox[{"SymmetricProduct", "[", 
   RowBox[{
    RowBox[{"CyclicWord", "[", 
     RowBox[{"{", "y", "}"}], "]"}], ",", 
    RowBox[{"CyclicWord", "[", 
     RowBox[{"{", "y", "}"}], "]"}]}], "]"}]}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"cd0c8ebe-d4bb-482e-a4a8-cab0909b871b"]
}, Open  ]],

