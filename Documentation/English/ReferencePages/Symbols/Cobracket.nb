    RowBox[{"{", "y", "}"}], "]"}], ",", 
   RowBox[{"CyclicWord", "[", 
    RowBox[{"{", "y", "}"}], "]"}]}], "]"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"ee4e11c8-2ddb-4b6f-aca5-e03a951dfa44"]
}, Open  ]]
