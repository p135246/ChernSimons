Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"pairing", " ", "=", " ", 
   RowBox[{"Pairing", "[", 
    RowBox[{
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"x", " ", "->", " ", 
        RowBox[{"-", "1"}]}], ",", " ", 
       RowBox[{"y", " ", "->", " ", "0"}]}], "|>"}], ",", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "y"}], "}"}], " ", "->", " ", "1"}], "|>"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{"DeleteCases", "[", 
  RowBox[{
   RowBox[{"Map", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"#", " ", "->", " ", 
       RowBox[{"Cobracket", "[", 
        RowBox[{"#", ",", " ", "pairing"}], "]"}]}], " ", "&"}], ",", " ", 
     RowBox[{"CyclicWords", "[", 
      RowBox[{"5", ",", " ", "pairing", ",", " ", 
       RowBox[{"\"\<UpTo\>\"", " ", "->", " ", "True"}]}], "]"}]}], "]"}], ",",
    " ", 
   RowBox[{"_", " ", "->", " ", "0"}]}], "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"1e0fbc4c-6618-4056-ba83-571d819891a8"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    RowBox[{"CyclicWord", "[", 
     RowBox[{"{", 
      RowBox[{"x", ",", "y", ",", "y", ",", "y"}], "}"}], "]"}], "\[Rule]", 
    RowBox[{"-", 
     RowBox[{"SymmetricProduct", "[", 
      RowBox[{
       RowBox[{"CyclicWord", "[", 
        RowBox[{"{", "y", "}"}], "]"}], ",", 
       RowBox[{"CyclicWord", "[", 
        RowBox[{"{", "y", "}"}], "]"}]}], "]"}]}]}], ",", 
   RowBox[{
    RowBox[{"CyclicWord", "[", 
     RowBox[{"{", 
      RowBox[{"x", ",", "y", ",", "y", ",", "y", ",", "y"}], "}"}], "]"}], "\[Rule]", 
    RowBox[{
     RowBox[{"-", "2"}], " ", 
     RowBox[{"SymmetricProduct", "[", 
      RowBox[{
       RowBox[{"CyclicWord", "[", 
        RowBox[{"{", "y", "}"}], "]"}], ",", 
       RowBox[{"CyclicWord", "[", 
