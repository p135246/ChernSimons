Notebook[{

Cell[CellGroupData[{
Cell["Cobracket", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"8cd32f45-7123-4353-a558-908bfedbf741"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["Cobracket"]], "paclet:IBLInfinity/ref/Cobracket", 
     "IBLInfinity Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["w", "TI"], ",", " ", 
    StyleBox["pairing", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "44177bbb-659d-4ed7-aad2-62091aaf2958"],
 "\[LineSeparator]",
 "gives the co-bracket of a cyclic word ",
 StyleBox["w", "TI"],
 ", a product of two words, in the convention carried by ",
 StyleBox["pairing", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"e96926c3-4bb4-494a-b193-900b5d38aa2f"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["Cobracket"]], "paclet:IBLInfinity/ref/Cobracket", 
     "IBLInfinity Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["p", "TI"], ",", " ", 
    StyleBox["pairing", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ec9456b5-7da4-4ef4-ae8b-44c98d6b81e6"],
 "\[LineSeparator]",
 "applies the extension of the co-bracket as a co-derivation to a product ",
 StyleBox["p", "TI"],
 "."
}], "Usage",ExpressionUUID->"09c497b7-a6c4-4fe2-bca1-890a46991fed"],

Cell[TextData[{
 "The co-bracket is the operation ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["q", "TI"], 
   RowBox[{"1", ",", "2", ",", "0"}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f8e07ac6-fc1c-4b64-be11-c03b0d834cb5"],
 " of the involutive bi-Lie structure: it takes one cyclic word and returns a \
product of two, cutting the word at a pair of positions and contracting the \
two removed particles against the pairing."
}], "Notes",ExpressionUUID->"cfc5e329-16ef-41aa-9210-57135f464c4f"],

Cell[TextData[{
 "The convention key of ",
 StyleBox["pairing", "TI"],
 " selects the picture: the result is a ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SymmetricProduct"]], "paclet:IBLInfinity/ref/SymmetricProduct",
     "IBLInfinity Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "3d194fbf-4ead-44dc-a5b7-7e431c783609"],
 " under ",
 Cell[BoxData["\"\<Symmetric\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0f72f856-ca1f-48f7-ba31-1f2ec4166267"],
 " and an ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ExteriorProduct"]], "paclet:IBLInfinity/ref/ExteriorProduct", 
    "IBLInfinity Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "1b757bbb-669d-423a-be09-1098a1550f6e"],
 " under ",
 Cell[BoxData["\"\<Exterior\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "712f3f8d-269a-478a-9922-ff2d9d36b4e2"],
 "."
}], "Notes",ExpressionUUID->"ad5a9efc-9725-4f1e-a35c-ed82925fa985"],

Cell[TextData[{
 "A word too short to be cut in two, or one whose cuts all cancel, has \
co-bracket ",
 Cell[BoxData["0"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "872f86ab-a35f-462e-a638-c74f396841d7"],
 ". Over the alphabet of the circle the first nonzero co-bracket appears in \
length ",
 Cell[BoxData["4"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4c80cec9-6dff-4f06-9ad5-f6420ebb6355"],
 "."
}], "Notes",ExpressionUUID->"86c48685-4259-4e80-88d8-6f171cc2f655"],

Cell[TextData[{
 "In the two-argument form with a product argument the result is the \
co-derivation extension ",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox[
    StyleBox["q", "TI"], "^"], 
   RowBox[{"1", ",", "2", ",", "0"}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3c0cb7e0-86ef-4fc4-bb56-3b39b107e68a"],
 ": the co-bracket is applied to each factor in turn, with the Koszul sign of \
the shuffle. The extension raises the number of factors by one."
}], "Notes",ExpressionUUID->"74e9a430-c615-4485-a7c9-1771df7a185a"],

Cell[TextData[{
 "The identities the co-bracket satisfies are the business of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CoJacobi"]], "paclet:IBLInfinity/ref/CoJacobi", 
    "IBLInfinity Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "0aea1c6a-de11-411c-b296-ccc70ff8dda6"],
 ", ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Drinfeld"]], "paclet:IBLInfinity/ref/Drinfeld", 
    "IBLInfinity Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "3fbaef5d-f198-4af9-af19-c2ad9636f0ce"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Involutivity"]], "paclet:IBLInfinity/ref/Involutivity", 
    "IBLInfinity Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "40146345-6fa1-47a0-93bc-7763045fbb1b"],
 "."
}], "Notes",ExpressionUUID->"6537b782-c65c-4536-b91f-b835d44476ab"]
}, Open  ]],

