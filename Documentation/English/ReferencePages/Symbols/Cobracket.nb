 CellID->1305812373,ExpressionUUID->"9397dd0b-9de4-443a-9371-be2b75148f2f"],

Cell[TextData[{
 StyleBox["The co-derivation form does not see a scalar coefficient, and \
fails silently.",
  FontWeight->"Bold"],
 " ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["Cobracket"]], "paclet:IBLInfinity/ref/Cobracket", 
     "IBLInfinity Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    RowBox[{
     StyleBox["c", "TI"], " ", 
     StyleBox["p", "TI"]}], ",", " ", 
    StyleBox["pairing", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b752c253-425a-478b-847f-eafd30d1d364"],
 " for a number ",
 StyleBox["c", "TI"],
 " \[LongDash] including the sign a product returns when its factors need \
reordering \[LongDash] falls through to the one-word definition, and the \
result contains an unreduced private symbol of the engine rather than a \
product of cyclic words. The same happens on a sum of products. Divide the \
coefficient out, map over the terms of a sum, and multiply back afterwards."
}], "ExampleText",ExpressionUUID->"7d7e02ec-2df5-43e9-a25f-ade5e0c803e2"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"pairing", " ", "=", " ", 
   RowBox[{"Pairing", "[", 
    RowBox[{
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"x", " ", "->", " ", 
        RowBox[{"-", "1"}]}], ",", " ", 
       RowBox[{"y", " ", "->", " ", "0"}]}], "|>"}], ",", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "y"}], "}"}], " ", "->", " ", "1"}], "|>"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"p", " ", "=", " ", 
   RowBox[{"SymmetricProduct", "[", 
    RowBox[{
     RowBox[{"CyclicWord", "[", 
      RowBox[{"{", "y", "}"}], "]"}], ",", " ", 
     RowBox[{"CyclicWord", "[", 
      RowBox[{"{", 
       RowBox[{"x", ",", " ", "y", ",", " ", "y", ",", " ", "y"}], "}"}], 
      "]"}], ",", " ", "pairing"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Cobracket", "[", 
   RowBox[{
    RowBox[{"-", "p"}], ",", " ", "pairing"}], "]"}], " ", "===", " ", 
  RowBox[{"-", 
   RowBox[{"Cobracket", "[", 
    RowBox[{"p", ",", " ", "pairing"}], "]"}]}]}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"3d60d865-e953-42ed-bf96-c112a217b65c"],

