Cell["\<\
The co-derivation extension raises the number of factors by one:\
\>", "ExampleText",ExpressionUUID->"91470b97-fe55-45cd-89ab-5abbe7a27b60"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"pairing", " ", "=", " ", 
   RowBox[{"Pairing", "[", 
    RowBox[{
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"x", " ", "->", " ", 
        RowBox[{"-", "1"}]}], ",", " ", 
       RowBox[{"y", " ", "->", " ", "0"}]}], "|>"}], ",", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "y"}], "}"}], " ", "->", " ", "1"}], "|>"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{"Cobracket", "[", 
  RowBox[{
   RowBox[{"SymmetricProduct", "[", 
    RowBox[{
     RowBox[{"CyclicWord", "[", 
