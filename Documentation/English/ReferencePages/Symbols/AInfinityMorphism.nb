Cell["The identity of a strictly associative algebra:", "ExampleText",ExpressionUUID->"993518f8-c59e-4b5f-947f-2ac72dd15379"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"identity", " ", "=", " ", 
  RowBox[{"AInfinityMorphism", "[", 
   RowBox[{
    RowBox[{"AInfinityAlgebra", "[", 
     RowBox[{
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"u", " ", "->", " ", 
         RowBox[{"-", "1"}]}], ",", " ", 
        RowBox[{"v", " ", "->", " ", 
         RowBox[{"-", "1"}]}]}], "|>"}], ",", " ", 
      RowBox[{"t", " ", "|->", " ", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", "t", "]"}], " ", "===", " ", "2"}], ",", " ", 
         RowBox[{"Switch", "[", 
          RowBox[{"t", ",", " ", 
           RowBox[{"{", 
            RowBox[{"u", ",", " ", "u"}], "}"}], ",", " ", "u", ",", " ", 
           RowBox[{"{", 
            RowBox[{"u", ",", " ", "v"}], "}"}], ",", " ", "v", ",", " ", 
           RowBox[{"{", 
            RowBox[{"v", ",", " ", "u"}], "}"}], ",", " ", "v", ",", " ", "_",
            ",", " ", "0"}], "]"}], ",", " ", "0"}], "]"}]}]}], "]"}], ",", 
    " ", 
    RowBox[{"AInfinityAlgebra", "[", 
     RowBox[{
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"u", " ", "->", " ", 
         RowBox[{"-", "1"}]}], ",", " ", 
        RowBox[{"v", " ", "->", " ", 
         RowBox[{"-", "1"}]}]}], "|>"}], ",", " ", 
      RowBox[{"t", " ", "|->", " ", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", "t", "]"}], " ", "===", " ", "2"}], ",", " ", 
         RowBox[{"Switch", "[", 
          RowBox[{"t", ",", " ", 
           RowBox[{"{", 
            RowBox[{"u", ",", " ", "u"}], "}"}], ",", " ", "u", ",", " ", 
           RowBox[{"{", 
            RowBox[{"u", ",", " ", "v"}], "}"}], ",", " ", "v", ",", " ", 
           RowBox[{"{", 
            RowBox[{"v", ",", " ", "u"}], "}"}], ",", " ", "v", ",", " ", "_",
            ",", " ", "0"}], "]"}], ",", " ", "0"}], "]"}]}]}], "]"}], ",", 
    " ", 
    RowBox[{"t", " ", "|->", " ", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", "t", "]"}], " ", "===", " ", "1"}], ",", " ", 
       RowBox[{"First", "[", "t", "]"}], ",", " ", "0"}], "]"}]}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"d35f9112-0f7b-4175-be98-3d9c957c57cf"],

