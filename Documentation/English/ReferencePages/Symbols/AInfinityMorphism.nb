Cell["The identity of a strictly associative algebra:", "ExampleText",ExpressionUUID->"29511f01-fdcd-4b30-8a1d-d6a9e5f75afe"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"identity", " ", "=", " ", 
  RowBox[{"AInfinityMorphism", "[", 
   RowBox[{
    RowBox[{"AInfinityAlgebra", "[", 
     RowBox[{
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"u", " ", "->", " ", 
         RowBox[{"-", "1"}]}], ",", " ", 
        RowBox[{"v", " ", "->", " ", 
         RowBox[{"-", "1"}]}]}], "|>"}], ",", " ", 
      RowBox[{"t", " ", "|->", " ", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", "t", "]"}], " ", "===", " ", "2"}], ",", " ", 
         RowBox[{"Switch", "[", 
          RowBox[{"t", ",", " ", 
           RowBox[{"{", 
            RowBox[{"u", ",", " ", "u"}], "}"}], ",", " ", "u", ",", " ", 
           RowBox[{"{", 
            RowBox[{"u", ",", " ", "v"}], "}"}], ",", " ", "v", ",", " ", 
           RowBox[{"{", 
            RowBox[{"v", ",", " ", "u"}], "}"}], ",", " ", "v", ",", " ", "_",
            ",", " ", "0"}], "]"}], ",", " ", "0"}], "]"}]}]}], "]"}], ",", 
    " ", 
    RowBox[{"AInfinityAlgebra", "[", 
     RowBox[{
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"u", " ", "->", " ", 
         RowBox[{"-", "1"}]}], ",", " ", 
        RowBox[{"v", " ", "->", " ", 
         RowBox[{"-", "1"}]}]}], "|>"}], ",", " ", 
      RowBox[{"t", " ", "|->", " ", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", "t", "]"}], " ", "===", " ", "2"}], ",", " ", 
         RowBox[{"Switch", "[", 
          RowBox[{"t", ",", " ", 
           RowBox[{"{", 
            RowBox[{"u", ",", " ", "u"}], "}"}], ",", " ", "u", ",", " ", 
           RowBox[{"{", 
            RowBox[{"u", ",", " ", "v"}], "}"}], ",", " ", "v", ",", " ", 
           RowBox[{"{", 
            RowBox[{"v", ",", " ", "u"}], "}"}], ",", " ", "v", ",", " ", "_",
            ",", " ", "0"}], "]"}], ",", " ", "0"}], "]"}]}]}], "]"}], ",", 
    " ", 
    RowBox[{"t", " ", "|->", " ", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", "t", "]"}], " ", "===", " ", "1"}], ",", " ", 
       RowBox[{"First", "[", "t", "]"}], ",", " ", "0"}], "]"}]}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"bb166eab-628d-4a55-8419-fe644eab5f46"],

