Cell["The identity of a strictly associative algebra:", "ExampleText",ExpressionUUID->"bfdb7742-262a-4cf2-8e0e-50e17b478566"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"identity", " ", "=", " ", 
  RowBox[{"AInfinityMorphism", "[", 
   RowBox[{
    RowBox[{"AInfinityAlgebra", "[", 
     RowBox[{
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"u", " ", "->", " ", 
         RowBox[{"-", "1"}]}], ",", " ", 
        RowBox[{"v", " ", "->", " ", 
         RowBox[{"-", "1"}]}]}], "|>"}], ",", " ", 
      RowBox[{"t", " ", "|->", " ", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", "t", "]"}], " ", "===", " ", "2"}], ",", " ", 
         RowBox[{"Switch", "[", 
          RowBox[{"t", ",", " ", 
           RowBox[{"{", 
            RowBox[{"u", ",", " ", "u"}], "}"}], ",", " ", "u", ",", " ", 
           RowBox[{"{", 
            RowBox[{"u", ",", " ", "v"}], "}"}], ",", " ", "v", ",", " ", 
           RowBox[{"{", 
            RowBox[{"v", ",", " ", "u"}], "}"}], ",", " ", "v", ",", " ", "_",
            ",", " ", "0"}], "]"}], ",", " ", "0"}], "]"}]}]}], "]"}], ",", 
    " ", 
    RowBox[{"AInfinityAlgebra", "[", 
     RowBox[{
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"u", " ", "->", " ", 
         RowBox[{"-", "1"}]}], ",", " ", 
        RowBox[{"v", " ", "->", " ", 
         RowBox[{"-", "1"}]}]}], "|>"}], ",", " ", 
      RowBox[{"t", " ", "|->", " ", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", "t", "]"}], " ", "===", " ", "2"}], ",", " ", 
         RowBox[{"Switch", "[", 
          RowBox[{"t", ",", " ", 
           RowBox[{"{", 
            RowBox[{"u", ",", " ", "u"}], "}"}], ",", " ", "u", ",", " ", 
           RowBox[{"{", 
            RowBox[{"u", ",", " ", "v"}], "}"}], ",", " ", "v", ",", " ", 
           RowBox[{"{", 
            RowBox[{"v", ",", " ", "u"}], "}"}], ",", " ", "v", ",", " ", "_",
            ",", " ", "0"}], "]"}], ",", " ", "0"}], "]"}]}]}], "]"}], ",", 
    " ", 
    RowBox[{"t", " ", "|->", " ", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", "t", "]"}], " ", "===", " ", "1"}], ",", " ", 
       RowBox[{"First", "[", "t", "]"}], ",", " ", "0"}], "]"}]}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"de16aee5-ba17-4d06-9c5c-d643be12f561"],

