Cell["The identity of a strictly associative algebra:", "ExampleText",ExpressionUUID->"86f0ab88-50ad-41c0-a058-269b486797ce"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"identity", " ", "=", " ", 
  RowBox[{"AInfinityMorphism", "[", 
   RowBox[{
    RowBox[{"AInfinityAlgebra", "[", 
     RowBox[{
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"u", " ", "->", " ", 
         RowBox[{"-", "1"}]}], ",", " ", 
        RowBox[{"v", " ", "->", " ", 
         RowBox[{"-", "1"}]}]}], "|>"}], ",", " ", 
      RowBox[{"t", " ", "|->", " ", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", "t", "]"}], " ", "===", " ", "2"}], ",", " ", 
         RowBox[{"Switch", "[", 
          RowBox[{"t", ",", " ", 
           RowBox[{"{", 
            RowBox[{"u", ",", " ", "u"}], "}"}], ",", " ", "u", ",", " ", 
           RowBox[{"{", 
            RowBox[{"u", ",", " ", "v"}], "}"}], ",", " ", "v", ",", " ", 
           RowBox[{"{", 
            RowBox[{"v", ",", " ", "u"}], "}"}], ",", " ", "v", ",", " ", "_",
            ",", " ", "0"}], "]"}], ",", " ", "0"}], "]"}]}]}], "]"}], ",", 
    " ", 
    RowBox[{"AInfinityAlgebra", "[", 
     RowBox[{
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"u", " ", "->", " ", 
         RowBox[{"-", "1"}]}], ",", " ", 
        RowBox[{"v", " ", "->", " ", 
         RowBox[{"-", "1"}]}]}], "|>"}], ",", " ", 
      RowBox[{"t", " ", "|->", " ", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", "t", "]"}], " ", "===", " ", "2"}], ",", " ", 
         RowBox[{"Switch", "[", 
          RowBox[{"t", ",", " ", 
           RowBox[{"{", 
            RowBox[{"u", ",", " ", "u"}], "}"}], ",", " ", "u", ",", " ", 
           RowBox[{"{", 
            RowBox[{"u", ",", " ", "v"}], "}"}], ",", " ", "v", ",", " ", 
           RowBox[{"{", 
            RowBox[{"v", ",", " ", "u"}], "}"}], ",", " ", "v", ",", " ", "_",
            ",", " ", "0"}], "]"}], ",", " ", "0"}], "]"}]}]}], "]"}], ",", 
    " ", 
    RowBox[{"t", " ", "|->", " ", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", "t", "]"}], " ", "===", " ", "1"}], ",", " ", 
       RowBox[{"First", "[", "t", "]"}], ",", " ", "0"}], "]"}]}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"2d8670e1-0ae1-4ebd-b835-ea077c8aaa38"],

