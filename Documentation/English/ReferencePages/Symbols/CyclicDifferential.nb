Notebook[{

Cell[CellGroupData[{
Cell["CyclicDifferential", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"c54b56ab-774f-42ab-b97c-23a9f09685ff"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["CyclicDifferential"]], 
     "paclet:ChernSimons/ref/CyclicDifferential", 
     "ChernSimons Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["w", "TI"], ",", " ", 
    StyleBox["pairing", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5823ecbe-2590-46d9-851f-485832372ad6"],
 "\[LineSeparator]",
 "gives the differential of a cyclic word ",
 StyleBox["w", "TI"],
 ", induced letterwise by the differential of the Poincare duality algebra \
carried by ",
 StyleBox["pairing", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"0310111b-e0e5-40b5-8d51-01d647d4ebac"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["CyclicDifferential"]], 
     "paclet:ChernSimons/ref/CyclicDifferential", 
     "ChernSimons Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["p", "TI"], ",", " ", 
    StyleBox["pairing", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "da63e141-a501-4385-820b-d67cba2a9ed4"],
 "\[LineSeparator]",
 "applies the extension of the differential as a derivation to a product ",
 StyleBox["p", "TI"],
 "."
}], "Usage",ExpressionUUID->"9866ba7f-1f5b-4603-adf2-8eb65486d792"],

Cell[TextData[{
 "The differential is the operation ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["q", "TI"], 
    RowBox[{"1", ",", "1", ",", "0"}]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "96d1abf5-0d32-4b6e-850e-952032ce8499"],
 " of the involutive bi-Lie structure of a cyclic ",
 StyleBox["cochain complex", "TI"],
 ": it takes one cyclic word and returns one cyclic word of the same length, \
replacing each letter in turn by its image under the differential dual to the \
one on the algebra, with the running sign of the letters strictly after that \
slot."
}], "Notes",ExpressionUUID->"2d19c30d-c891-4292-939f-82cc49b49f25"],

Cell["\<\
It lowers the degree by one and preserves length, so it is the only operation \
of the structure that changes neither the number of letters nor the number of \
factors.\
\>", "Notes",ExpressionUUID->"0b9aa1d5-17db-4e7a-8042-9c14eeb0537f"],

Cell[TextData[{
 "The suffix running sign is the reference's prefix rule read through the \
alphabet's own convention: the engine's cyclic words correspond to the \
functionals of the literature via the reversal sign ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"-", "1"}], ")"}], 
    RowBox[{
     UnderscriptBox["\[Sum]", 
      RowBox[{
       StyleBox["r", "TI"], "<", 
       StyleBox["s", "TI"]}],
      LimitsPositioning->True], 
     SubscriptBox["\[Eta]", 
      StyleBox["r", "TI"]], 
     SubscriptBox["\[Eta]", 
      StyleBox["s", "TI"]]}]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ddf2dcac-e176-47d1-90bf-1de9dd289505"],
 " of the letter degrees, and conjugating by that sign turns a prefix into a \
suffix. Both give the same operation; only the coordinates differ."
}], "Notes",ExpressionUUID->"a493c27c-3b6a-4cb6-b23e-83f837840fea"],

Cell[TextData[{
 "The differential is read from the ",
 Cell[BoxData["\"\<Algebra\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f7d6412d-47be-4dff-8c8c-475f05937db6"],
 " key of ",
 StyleBox["pairing", "TI"],
 ", which ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["GradedPairing"]], "paclet:ChernSimons/ref/GradedPairing", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "7623ae7c-5d4f-431e-879b-71b43401f3d6"],
 " attaches when the alphabet is built as ",
 Cell[BoxData[
  RowBox[{"GradedPairing", "[", 
   RowBox[{"NondegenerateQuotient", "[", "model", "]"}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d32513c4-8109-4834-a7be-c06d6c41f326"],
 ". An alphabet built by hand from degrees and pairing values carries no \
algebra, and the differential of every word is then ",
 Cell[BoxData[
  FormBox["0", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "476435e9-0889-4bad-bab0-a392becc1079"],
 "."
}], "Notes",ExpressionUUID->"f757f02b-ba97-4c0b-8a6b-b343f4e32c61"],

Cell[TextData[{
 "It is also ",
 Cell[BoxData[
  FormBox["0", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0fdf62e0-3c5e-4f0f-b291-e7f954a6c1a5"],
 " whenever the model is formal \[LongDash] that is, whenever the \
nondegenerate quotient is already the cohomology. Nine of the catalogue's \
eleven models are of that kind; ",
 Cell[BoxData["\"\<HeisenbergNilmanifold\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "509e685e-3e9a-4e37-ade7-3a19405dabdb"],
 " and ",
 Cell[BoxData["\"\<KodairaThurston\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4e694109-3c1d-48da-a7ce-9e9e095e7303"],
 " are the two that are not."
}], "Notes",ExpressionUUID->"827848a8-f160-479b-af58-83f0a312f816"],

Cell[TextData[{
 "Unlike ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InvolutiveBracket"]], 
    "paclet:ChernSimons/ref/InvolutiveBracket", "ChernSimons Package Symbol"},
   
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "75b95a4a-2846-44ee-8924-5952a92ae5eb"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InvolutiveCobracket"]], 
    "paclet:ChernSimons/ref/InvolutiveCobracket", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "9a9c16a0-541f-4a81-843f-febe54cda85a"],
 ", the operation itself carries no degree-shift sign, so on a cyclic word it \
is the same in both pictures. The convention key of ",
 StyleBox["pairing", "TI"],
 " is still read, because the derivation extension to a product needs the \
Koszul signs of the picture it lives in."
}], "Notes",ExpressionUUID->"87aea874-4e33-4300-aee2-5676584118df"],

Cell[TextData[{
 "The differential is the first summand of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["BeilinsonDrinfeldOperator"]], 
    "paclet:ChernSimons/ref/BeilinsonDrinfeldOperator", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "9894631f-08c5-48f0-a01c-b0fa5bd28318"],
 ", so it enters ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["MaurerCartanEquation"]], 
    "paclet:ChernSimons/ref/MaurerCartanEquation", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "7d6ba94f-00ce-4be9-8e08-75380e95ed3c"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["MaurerCartanQ"]], "paclet:ChernSimons/ref/MaurerCartanQ", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "68704878-d61b-46f5-9574-2a2f3e816e9c"],
 "; and it is the first summand of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["TwistedDifferential"]], 
    "paclet:ChernSimons/ref/TwistedDifferential", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "511d1373-b857-4bbf-97ef-4312cf766c8f"],
 ", whose second summand is the bracket with the twisting element."
}], "Notes",ExpressionUUID->"1d8d8ea3-a607-49cb-9fca-8cca7a3b5e73"]
}, Open  ]],

