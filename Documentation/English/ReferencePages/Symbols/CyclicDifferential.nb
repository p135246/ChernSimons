Cell[TextData[{
 "Over the alphabet of the circle, which is formal, every differential is ",
 Cell[BoxData[
  FormBox["0", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3ac6b326-13b5-4d78-8054-34db2afce9b3"],
 ":"
}], "ExampleText",ExpressionUUID->"a606c81e-72d2-4051-99fc-291c6f0b4dec"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"CyclicDifferential", "[", 
  RowBox[{
   RowBox[{"CyclicWord", "[", 
    RowBox[{"{", 
     RowBox[{"x", ",", " ", "y", ",", " ", "y", ",", " ", "y"}], "}"}], "]"}],
    ",", " ", 
   RowBox[{"GradedPairing", "[", 
    RowBox[{
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"x", " ", "->", " ", 
        RowBox[{"-", "1"}]}], ",", " ", 
       RowBox[{"y", " ", "->", " ", "0"}]}], "|>"}], ",", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "y"}], "}"}], " ", "->", " ", "1"}], "|>"}]}], 
    "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"d85ef5a7-ef91-4259-8800-0d087d3e04f7"],

Cell[BoxData["0"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"6121100b-d6b8-4932-a754-2b6fac58d76e"]
}, Open  ]]
}, Open  ]],

