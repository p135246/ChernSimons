Cell[TextData[{
 "So does ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["TwistedDifferential"]], 
    "paclet:ChernSimons/ref/TwistedDifferential", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "b175514e-8136-4528-a824-0ce86b7e53ca"],
 ": twisting by the canonical element adds the bracket with it, the sum \
squares to zero, and its homology is Connes' cyclic cohomology:"
}], "ExampleText",ExpressionUUID->"ee87844f-f6c9-439a-b948-9d5e03dd79ff"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"pairing", " ", "=", " ", 
   RowBox[{"GradedPairing", "[", 
    RowBox[{"NondegenerateQuotient", "[", 
     RowBox[{"SullivanModel", "[", "\"\<HeisenbergNilmanifold\>\"", "]"}], 
     "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"m", " ", "=", " ", 
   RowBox[{"CanonicalMaurerCartan", "[", "pairing", "]"}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"TwistedDifferential", "[", 
    RowBox[{"m", ",", " ", 
     RowBox[{"CyclicWord", "[", 
      RowBox[{"{", 
       RowBox[{"x", "*", "y"}], "}"}], "]"}], ",", " ", "pairing"}], "]"}], ",",
    "\n", " ", 
   RowBox[{"TwistedDifferential", "[", 
    RowBox[{"m", ",", " ", 
     RowBox[{"TwistedDifferential", "[", 
      RowBox[{"m", ",", " ", 
       RowBox[{"CyclicWord", "[", 
        RowBox[{"{", 
         RowBox[{"x", "*", "y"}], "}"}], "]"}], ",", " ", "pairing"}], "]"}], 
     ",", " ", "pairing"}], "]"}]}], "}"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"12488d87-641b-497a-bd35-b48c024cbafa"],

