 RowBox[{"{", 
  RowBox[{"0", ",", "True"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"16ee0f12-8583-4019-a60b-73f76235d57f"]
}, Open  ]]
}, Open  ]],

