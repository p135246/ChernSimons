Cell[TextData[{
 "The Heisenberg nilmanifold is not formal: its minimal model is its own \
nondegenerate quotient, and that quotient carries ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["d", "TI"], 
    StyleBox["z", "TI"], "\[LongEqual]", 
    StyleBox["x", "TI"], 
    StyleBox["y", "TI"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ce02bd6d-91b3-4f11-8e2c-4d354e19b8af"],
 ". Dually, the letter ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"x", "y"}], "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1bb3669d-e9fe-42da-9d20-26f5b4a3da51"],
 " of the alphabet goes to the letter ",
 Cell[BoxData[
  FormBox[
   StyleBox["z", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "12393495-813a-447c-b8a2-d77b7a1345f8"],
 ":"
}], "ExampleText",ExpressionUUID->"bfea8b05-66dd-419f-b687-fd32e4218dc5"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"pairing", " ", "=", " ", 
   RowBox[{"GradedPairing", "[", 
    RowBox[{"NondegenerateQuotient", "[", 
     RowBox[{"SullivanModel", "[", "\"\<HeisenbergNilmanifold\>\"", "]"}], 
     "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{"CyclicDifferential", "[", 
  RowBox[{
   RowBox[{"CyclicWord", "[", 
    RowBox[{"{", 
     RowBox[{"x", "*", "y"}], "}"}], "]"}], ",", " ", "pairing"}], 
  "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"c90118cb-3aea-4d59-9557-fd95402fd7d6"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"(", "z", ")"}],
  ChernSimons`CyclicWord[{MTNB$wsneq806zbq1`z}],
  Editable->False]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"9fef508d-4885-4397-b03f-119f4e4a540e"]
}, Open  ]],

