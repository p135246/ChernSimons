Cell["\<\
It kills the canonical Maurer-Cartan element. That is the Leibniz rule of the \
algebra, read on the element that carries its triple product, and it is a \
theorem rather than a convention \[LongDash] which is what lets it pin the \
sign of the operation:\
\>", "ExampleText",ExpressionUUID->"96664676-3479-465a-ba07-88dc5bd49651"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"pairing", " ", "=", " ", 
   RowBox[{"GradedPairing", "[", 
    RowBox[{"NondegenerateQuotient", "[", 
     RowBox[{"SullivanModel", "[", "\"\<HeisenbergNilmanifold\>\"", "]"}], 
     "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"CyclicDifferential", "[", 
    RowBox[{
     RowBox[{"CanonicalMaurerCartan", "[", "pairing", "]"}], ",", " ", 
     "pairing"}], "]"}], ",", " ", 
   RowBox[{"MaurerCartanQ", "[", 
    RowBox[{
     RowBox[{"CanonicalMaurerCartan", "[", "pairing", "]"}], ",", " ", 
     "pairing"}], "]"}]}], "}"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"df999c55-c753-4f14-845a-2a91ad1dbf55"],

