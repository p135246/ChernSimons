Cell[TextData[{
 "On a product the result is the derivation extension ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    OverscriptBox[
     StyleBox["q", "TI"], "^"], 
    RowBox[{"1", ",", "1", ",", "0"}]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cf5a26a9-c452-4a73-b3fa-3f98b30b95f0"],
 ", which preserves the number of factors:"
}], "ExampleText",ExpressionUUID->"1099a13a-dfbd-43a6-9188-24e9ab2d2b1c"],

