Cell["\<\
On a cyclic word the two pictures agree, the operation having no degree-shift \
sign of its own:\
\>", "ExampleText",ExpressionUUID->"596a08af-1006-499f-83fa-077ca6c8b1b2"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"pairing", " ", "=", " ", 
   RowBox[{"GradedPairing", "[", 
    RowBox[{"NondegenerateQuotient", "[", 
     RowBox[{"SullivanModel", "[", "\"\<HeisenbergNilmanifold\>\"", "]"}], 
     "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"exterior", " ", "=", " ", 
   RowBox[{"Append", "[", 
    RowBox[{"pairing", ",", " ", 
     RowBox[{"\"\<Convention\>\"", " ", "->", " ", "\"\<Exterior\>\""}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"CyclicDifferential", "[", 
    RowBox[{
     RowBox[{"CyclicWord", "[", 
