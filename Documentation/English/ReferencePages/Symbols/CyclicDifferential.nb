Cell[CellGroupData[{

Cell[BoxData[
 InterpretationBox[Cell[
  "Possible Issues", "ExampleSection",ExpressionUUID->
   "dda06a82-eb41-4b48-8510-6cb821647761"],
  $Line = 0; Null]], "ExampleSection",
 CellID->1305812373,ExpressionUUID->"9397dd0b-9de4-443a-9371-be2b75148f2f"],

Cell[TextData[{
 StyleBox["An alphabet with no algebra has no differential, and gives ",
  FontWeight->"Bold"],
 Cell[BoxData[
  FormBox["0", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,
  FontWeight->"Bold",ExpressionUUID->"e77afc98-6209-4013-be36-0014ddc35bcf"],
 StyleBox[" rather than an error.",
  FontWeight->"Bold"],
 " The operation reads the ",
 Cell[BoxData["\"\<Algebra\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "41884536-9085-436f-816a-ceadc9c20ffc"],
 " key, which only ",
 Cell[BoxData[
  RowBox[{"GradedPairing", "[", 
   RowBox[{"NondegenerateQuotient", "[", "model", "]"}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "08ff5181-1450-488e-8cfe-5c731ca1e9de"],
 " attaches; a pairing built by hand from degrees and values carries none, \
and every word is then closed. Check for the key before reading a zero as a \
computation."
}], "ExampleText",ExpressionUUID->"9a35464c-b197-4c27-b5de-c8641d729792"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"pairing", " ", "=", " ", 
   RowBox[{"GradedPairing", "[", 
    RowBox[{
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"x", " ", "->", " ", 
        RowBox[{"-", "1"}]}], ",", " ", 
       RowBox[{"y", " ", "->", " ", "0"}]}], "|>"}], ",", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "y"}], "}"}], " ", "->", " ", "1"}], "|>"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"KeyExistsQ", "[", 
    RowBox[{"pairing", ",", " ", "\"\<Algebra\>\""}], "]"}], ",", " ", 
   RowBox[{"CyclicDifferential", "[", 
    RowBox[{
     RowBox[{"CyclicWord", "[", 
      RowBox[{"{", 
       RowBox[{"x", ",", " ", "y"}], "}"}], "]"}], ",", " ", "pairing"}], 
    "]"}]}], "}"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"7eddbdc3-4d1f-45ae-9216-c350dfb97486"],

