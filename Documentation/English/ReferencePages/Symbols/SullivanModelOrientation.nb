Cell[CellGroupData[{
Cell["SullivanModelOrientation", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"e0d9f856-f1d8-4b47-8fa6-8db8454ad9a9"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["SullivanModelOrientation"]], 
     "paclet:ChernSimons/ref/SullivanModelOrientation", 
     "ChernSimons Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["e", "TI"], ",", " ", 
    StyleBox["model", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "fc241037-be72-4ad6-ae42-7aa4f96b267f"],
 "\[LineSeparator]",
 "gives the orientation of the Sullivan model ",
 StyleBox["model", "TI"],
 " applied to the element ",
 StyleBox["e", "TI"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"b05e65dc-59cb-4b33-8eb2-587a26131392"],

Cell[TextData[{
 "An orientation of degree ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "3ff464b5-17d6-475a-bc65-62d3619df7a7"],
 " on a cochain complex ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     StyleBox["V", "TI"], ",", 
     StyleBox["d",
      FontSlant->"Plain"]}], ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"8fe18184-abed-401b-9fb4-d12c9a0ec520"],
 " is a linear map ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["O", "TI"], ":", 
    StyleBox["V", "TI"], "\[Rule]", 
    StyleBox["K",
     FontSlant->"Plain"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "ee8c634e-7226-4410-aa05-2c4b788822a4"],
 " that vanishes outside degree ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "7b1776e1-1b20-4dfb-833d-8912c44bc05c"],
 ", satisfies ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["O", "TI"], "\[EmptySmallCircle]", 
    StyleBox["d",
     FontSlant->"Plain"], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"33b0ace6-ccb8-46ed-8eaa-01d8c9d733af"],
 ", and induces a nonzero map on cohomology."
}], "Notes",
 CellFrameLabels->{{Inherited, Inherited}, {Inherited, 
    Cell[
     TextData[{
      "26.09.30: Design review - the model keeps its orientation as values on \
the monomials of degree n, under the key \"Orientation\", so that an \
orientation may take other values than 1 and on several monomials, as the \
request of 2026-09-23 asked; this function expands e in monomials and weights \
each coefficient by its value. Alternative name considered: ModelOrientation, \
the name until 2026-09-21, renamed because \"Model\" alone is generic. Prior \
art: the Wolfram Language integrates functions with Integrate and has no \
algebraic orientation of a graded algebra. The engine the verification suites \
load orients a model by one volume monomial and reads its coefficient; the \
suites pin this function over the catalogue, where it kills the image of the \
differential and is 1 on the volume monomial, and through the pairing and the \
triple product of the nondegenerate quotient, which they compare with the \
engine's.", "\n\n", 
       Cell[
        BoxData[
         GridBox[{{
            Cell[
             BoxData[
              ButtonBox[
               DynamicBox[
                FEPrivate`FrontEndResource[
                "DocumentationToolsStrings", "Edit"]], BaseStyle -> 
               "TextAnnotationButton"]]], 
            StyleBox[
             RowBox[{
               DynamicBox[
                FEPrivate`FrontEndResource[
                "DocumentationToolsStrings", "LastAnnotator"]], "pavel"}], 
             "TextAnnotator"], 
            Cell[
             BoxData[
              ButtonBox[
               DynamicBox[
                FEPrivate`FrontEndResource[
                "DocumentationToolsStrings", "Delete"]], BaseStyle -> 
               "TextAnnotationRemoveButton"]]], ""}}, 
          GridBoxAlignment -> {
           "Columns" -> {Left, Left, Right, Right}, "Rows" -> {{Automatic}}}, 
          GridBoxItemSize -> {"Columns" -> {
              Scaled[0.15], 
              Scaled[0.68], 
              Scaled[0.15], 
              Scaled[0.02]}}]]], "\n"}], "TextAnnotation", 
     CellSize -> {590, Inherited}]}},
 CellTags->"TextAnnotation",
 CellID->981633206,ExpressionUUID->"e68a01aa-5220-466d-9273-3c61b976382a"],

Cell[TextData[{
 "The model stores the values of ",
 Cell[BoxData[
  FormBox[
   StyleBox["O", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "795eccbf-0493-498d-92d6-d48b28294006"],
 " on the monomials of degree ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "5bf76488-4347-4e90-b53e-f5c0ca0c3e4b"],
 " under the key ",
 Cell[BoxData["\"\<Orientation\>\""], "InlineFormula",ExpressionUUID->
  "8e29b03f-b6a8-4611-a241-888909433ea9"],
 ". ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SullivanModelOrientation"]], 
    "paclet:ChernSimons/ref/SullivanModelOrientation", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "97e8714a-0a45-4b57-8bd7-3cea16860157"],
 " gives the sum of the coefficients of ",
 StyleBox["e", "TI"],
 " on those monomials, weighted by their values."
}], "Notes",ExpressionUUID->"436cba0a-7a3e-47f4-b7df-f41bac68b6bb"],

Cell[TextData[{
 "It is linear, and it is ",
 Cell[BoxData[
  FormBox["0", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "4ab9be1b-a03a-40a8-883a-720742e985fd"],
 " on every monomial that has no value."
}], "Notes",ExpressionUUID->"2a0d07e2-198a-4e31-8ab9-0891312d7574"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SullivanModel"]], "paclet:ChernSimons/ref/SullivanModel", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "52957782-9f8e-4def-9727-5dccd79de9c8"],
 " checks with ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["OrientationQ"]], "paclet:ChernSimons/ref/OrientationQ", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "b1ee1950-063f-4fa2-9e71-67359788be74"],
 " that the values define an orientation when it builds a model."
}], "Notes",ExpressionUUID->"8ca52e82-dd71-4dba-a71d-f824e1c40237"],

Cell[TextData[{
 "For the de Rham algebra of a closed oriented manifold ",
 Cell[BoxData[
  FormBox[
   StyleBox["X", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "c9923d08-c224-4664-ac69-84dcd96d5386"],
 " the corresponding map is integration, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Omega]", "\[RightTeeArrow]", 
    SubscriptBox["\[Integral]", 
     StyleBox["X", "TI"]], "\[Omega]"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"2b2632d4-c6dd-4849-bb08-5525513a1ae0"],
 "."
}], "Notes",ExpressionUUID->"540a7bb2-1dda-4369-b9c9-e5511f04c1c9"],

Cell[TextData[{
 "A monomial is read in the order the model declares its generators, so a \
reordering carries no sign; the sign comes from ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SullivanModelProduct"]], 
    "paclet:ChernSimons/ref/SullivanModelProduct", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "2af03a71-51fc-44a1-acf0-da27ac372700"],
 "."
}], "Notes",ExpressionUUID->"560ca837-c78e-4ff9-9c21-758a2799ba83"],

Cell["\<\
An element that is not a polynomial in the generators returns unevaluated.\
\>", "Notes",ExpressionUUID->"c36a126e-ceb8-4f40-ab18-af9dfeb8572b"]
}, Open  ]],

