Cell[TextData[{
 "On the Heisenberg nilmanifold the volume monomial is ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"x", "y", "z"}], "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3fa8d9d1-ea35-43de-8a3a-7c75eb559919"],
 ", and the sign of a reordering is visible:"
}], "ExampleText",ExpressionUUID->"13337b09-d001-4a34-86c2-28b0017ab03e"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"model", " ", "=", " ", 
   RowBox[{"SullivanModel", "[", "\"\<HeisenbergNilmanifold\>\"", "]"}]}], 
  ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"SullivanModelOrientation", "[", 
    RowBox[{
     RowBox[{"SullivanModelProduct", "[", 
      RowBox[{"x", ",", " ", "y", ",", " ", "z", ",", " ", "model"}], "]"}], ",",
      " ", "model"}], "]"}], ",", "\n", " ", 
   RowBox[{"SullivanModelOrientation", "[", 
    RowBox[{
     RowBox[{"SullivanModelProduct", "[", 
      RowBox[{"z", ",", " ", "y", ",", " ", "x", ",", " ", "model"}], "]"}], ",",
      " ", "model"}], "]"}]}], "}"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"588b4b2d-3c27-4011-958b-bc93d5d45d79"],

