  FontSize->0.9 Inherited,ExpressionUUID->
  "0a80cf14-0c1b-449a-9ff4-11b4b290abef"],
 ", and the orientation sees nothing else:"
}], "ExampleText",ExpressionUUID->"769df814-17c1-496f-ad9e-29c19408fb63"],

