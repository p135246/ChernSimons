Cell["SullivanModelOrientation", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"717c3474-daa7-41c7-b66b-4475805f9b0a"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["SullivanModelOrientation"]], 
     "paclet:ChernSimons/ref/SullivanModelOrientation", 
     "ChernSimons Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["e", "TI"], ",", " ", 
    StyleBox["model", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "28362691-417c-427c-b2b0-14e11efd94bb"],
 "\[LineSeparator]",
 "gives the orientation of the Sullivan model ",
 StyleBox["model", "TI"],
 " applied to the element ",
 StyleBox["e", "TI"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"0ea36fb5-19d8-440a-be8e-8f8790ee54bb"],

Cell[TextData[{
 "An orientation of degree ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "975d5bbf-de3a-463e-bc4f-cf7d210c2810"],
 " on a cochain complex ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     StyleBox["V", "TI"], ",", 
     StyleBox["d",
      FontSlant->"Plain"]}], ")"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b381e02b-a4a9-49f9-8df0-15c14976dc4f"],
 " is a linear map ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["O", "TI"], ":", 
    StyleBox["V", "TI"], "\[Rule]", 
    StyleBox["K",
     FontSlant->"Plain"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4ae272f0-4a95-41b9-9b29-81c201f6d766"],
 " that vanishes outside degree ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "56e93a95-e674-419c-9504-174b371560ae"],
 ", satisfies ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["O", "TI"], "\[EmptySmallCircle]", 
    StyleBox["d",
     FontSlant->"Plain"], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4d9f8dde-7831-4f04-a996-65c1e2b29ab9"],
 ", and induces a nonzero map on cohomology."
}], "Notes",
 CellFrameLabels->{{Inherited, Inherited}, {Inherited, 
    Cell[
     TextData[{
      "26.09.30: Design review - the model keeps its orientation as values on \
the monomials of degree n, under the key \"Orientation\", so that an \
orientation may take other values than 1 and on several monomials, as the \
request of 2026-09-23 asked; this function expands e in monomials and weights \
each coefficient by its value. Alternative name considered: ModelOrientation, \
the name until 2026-09-21, renamed because \"Model\" alone is generic. Prior \
art: the Wolfram Language integrates functions with Integrate and has no \
algebraic orientation of a graded algebra. The engine the verification suites \
load orients a model by one volume monomial and reads its coefficient; the \
suites pin this function over the catalogue, where it kills the image of the \
differential and is 1 on the volume monomial, and through the pairing and the \
triple product of the nondegenerate quotient, which they compare with the \
engine's.", "\n\n", 
       Cell[
        BoxData[
         GridBox[{{
            Cell[
             BoxData[
              ButtonBox[
               DynamicBox[
                FEPrivate`FrontEndResource[
                "DocumentationToolsStrings", "Edit"]], BaseStyle -> 
               "TextAnnotationButton"]]], 
            StyleBox[
             RowBox[{
               DynamicBox[
                FEPrivate`FrontEndResource[
                "DocumentationToolsStrings", "LastAnnotator"]], "pavel"}], 
             "TextAnnotator"], 
            Cell[
             BoxData[
              ButtonBox[
               DynamicBox[
                FEPrivate`FrontEndResource[
                "DocumentationToolsStrings", "Delete"]], BaseStyle -> 
               "TextAnnotationRemoveButton"]]], ""}}, 
          GridBoxAlignment -> {
           "Columns" -> {Left, Left, Right, Right}, "Rows" -> {{Automatic}}}, 
          GridBoxItemSize -> {"Columns" -> {
              Scaled[0.15], 
              Scaled[0.68], 
              Scaled[0.15], 
              Scaled[0.02]}}]]], "\n"}], "TextAnnotation", 
     CellSize -> {590, Inherited}]}},
 CellTags->"TextAnnotation",
 CellID->400828839,ExpressionUUID->"575418c2-b0fd-4eb6-b41e-d0093105da4e"],

Cell[TextData[{
 "The model stores the values of ",
 Cell[BoxData[
  FormBox[
   StyleBox["O", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9b131161-a8ca-4b61-a63d-d404230036a0"],
 " on the monomials of degree ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "82fedfc8-edfb-476a-98bf-0ee8a9115c6a"],
 " under the key ",
 Cell[BoxData["\"\<Orientation\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d6f5c41d-5dee-4c9d-b561-fe0625624792"],
 ". ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SullivanModelOrientation"]], 
    "paclet:ChernSimons/ref/SullivanModelOrientation", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "14bfde57-bd0c-45d4-8d79-1cb5e52b0b5f"],
 " gives the sum of the coefficients of ",
 StyleBox["e", "TI"],
 " on those monomials, weighted by their values."
}], "Notes",ExpressionUUID->"77bfa9e1-55d3-4796-9140-c6390ccbe294"],

Cell[TextData[{
 "It is linear, and it is ",
 Cell[BoxData[
  FormBox["0", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "516840b1-8d49-4c70-abf7-3d7ff9408bd0"],
 " on every monomial that has no value."
}], "Notes",ExpressionUUID->"1100b4ce-7f1b-4de3-b1fb-b1e1c837d4b8"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SullivanModel"]], "paclet:ChernSimons/ref/SullivanModel", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "847f6201-0015-45a8-b306-f5f1b5ef4daf"],
 " checks with ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["OrientationQ"]], "paclet:ChernSimons/ref/OrientationQ", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "3dd1898d-fb0c-48ea-9895-31d927135efd"],
 " that the values define an orientation when it builds a model."
}], "Notes",ExpressionUUID->"cdaf6ca7-7f78-4982-9480-0cd361bb90f1"],

Cell[TextData[{
 "For the de Rham algebra of a closed oriented manifold ",
 Cell[BoxData[
  FormBox[
   StyleBox["X", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "982f0050-4321-424e-a356-616ca6b44b88"],
 " the corresponding map is integration, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Omega]", "\[RightTeeArrow]", 
    SubscriptBox["\[Integral]", 
     StyleBox["X", "TI"]], "\[Omega]"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fa79924c-fc61-4f8b-b180-82901f2e66ca"],
 "."
}], "Notes",ExpressionUUID->"50812332-a486-4fb9-8dde-87fbd30307d7"],

Cell[TextData[{
 "A monomial is read in the order the model declares its generators, so a \
reordering carries no sign; the sign comes from ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SullivanModelProduct"]], 
    "paclet:ChernSimons/ref/SullivanModelProduct", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "a46979e9-e0b5-42fa-91d0-822b6a181fb2"],
 "."
}], "Notes",ExpressionUUID->"be4211f8-35f2-4bcc-95aa-4a7fff1956a7"],

Cell["\<\
An element that is not a polynomial in the generators returns unevaluated.\
\>", "Notes",ExpressionUUID->"e5f4dc9e-05cb-4cd0-a2a0-4cf129e74724"]
}, Open  ]],

