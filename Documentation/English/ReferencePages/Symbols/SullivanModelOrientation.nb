Cell[CellGroupData[{
Cell["SullivanModelOrientation", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"f9b9acb9-2aaf-4211-9d3d-6e7e034d27c6"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["SullivanModelOrientation"]], 
     "paclet:ChernSimons/ref/SullivanModelOrientation", 
     "ChernSimons Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["e", "TI"], ",", " ", 
    StyleBox["model", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "aeebca39-8c73-4f2f-a02e-3016fda98371"],
 "\[LineSeparator]",
 "is the coefficient of the volume monomial in ",
 StyleBox["e", "TI"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"9824ccd7-ebe0-44d9-b9a7-fbd9d445f9cd"],

Cell[TextData[{
 "An ",
 StyleBox["orientation", "TI"],
 " of degree ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7ef0d31e-70f5-43e3-8eea-3d883b75aeb1"],
 " on a cochain complex ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     StyleBox["V", "TI"], ",", 
     StyleBox["d",
      FontSlant->"Plain"]}], ")"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ac7c2f6d-93a1-4c58-a050-468a4bbaea82"],
 " is a linear map ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["O", "TI"], ":", 
    StyleBox["V", "TI"], "\[Rule]", 
    StyleBox["K",
     FontSlant->"Plain"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0101c627-c4f1-455c-9f60-6a7a79104952"],
 " such that ",
 Cell[BoxData[
  FormBox[
   StyleBox["O", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c365b2af-427b-4604-bd84-19c84f5a023b"],
 " vanishes outside degree ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3c3f050b-6a4d-4fd7-b46e-d8c3b75fb3f6"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["O", "TI"], "\[EmptySmallCircle]", 
    StyleBox["d",
     FontSlant->"Plain"], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a6e1fb2a-7e4d-4607-b5a0-9211d05af06c"],
 ", and the induced map on cohomology is nonzero. Projecting onto a single \
monomial of degree ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "633ecb56-cb23-4e3c-991f-5dac37403788"],
 " satisfies the first condition by construction; the other two hold for \
every model in ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["$SullivanModels"]], "paclet:ChernSimons/ref/$SullivanModels", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "821bad95-2942-450e-8d14-bf9908bb91dd"],
 "."
}], "Notes",ExpressionUUID->"c116a239-b21e-4db5-bd92-31429c265dd1"],

Cell[TextData[{
 "For the de Rham algebra of a closed oriented manifold the corresponding map \
is integration, so this is the algebraic stand-in for ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Omega]", "\[RightTeeArrow]", 
    SubscriptBox["\[Integral]", 
     StyleBox["X", "TI"]], "\[Omega]"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bcfe5394-3a8d-43e9-a283-26ab93061be8"],
 "."
}], "Notes",ExpressionUUID->"25130830-e92c-4674-a8a6-c8802ccdbc71"]
}, Open  ]],

