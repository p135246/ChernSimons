Cell[TextData[{
 "The volume monomial of the model of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["CP",
     FontSlant->"Plain"], "2"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d8e4f26a-e116-4d90-b4b8-a8cd5f0eed32"],
