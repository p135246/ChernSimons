 Cell[BoxData["\"\<Degrees\>\""], "InlineFormula",ExpressionUUID->
  "1ef2bafd-0e43-443e-9450-714228b72046"],
 " name the degrees where no coexact part exists."
}], "Notes",ExpressionUUID->"203d80bf-a8ea-4ca2-a6b3-6138a068f602"],

