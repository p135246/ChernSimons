Cell[TextData[{
 "A pre-Hodge decomposition of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     StyleBox["V", "TI"], ",", 
     StyleBox["d",
      FontSlant->"Plain"], ",", 
     RowBox[{"\[LeftAngleBracket]", 
