    StyleBox["a", "TI"], "21"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"84f3c548-d91f-4784-abbc-a6243411fa9f"],
 " is not closed, while the class of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["a", "TI"], "5"], 
    SubscriptBox[
     StyleBox["a", "TI"], "9"], 
    SubscriptBox[
     StyleBox["a", "TI"], "23"]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"732a7fa8-2ccf-4fa6-91f9-32af410fabd9"],
 " in degree ",
 Cell[BoxData[
  FormBox["37", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "dc23f259-ae80-47d4-8532-7d8cb0992fe6"],
 " pairs with it to ",
 Cell[BoxData[
  FormBox["1", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "a3406554-1402-45ca-9430-dba078568996"],
 ", so no complement of the cocycles is perpendicular to the harmonic \
subspace. The result is a ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Failure"]], "paclet:ref/Failure"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "1907a80d-5c2a-4c2f-bd4c-c2ae5a164322"],
