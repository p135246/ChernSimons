  "92030ae1-a3da-43df-bdd7-99e9e127580c"],
 " a complement of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["im",
     FontSlant->"Plain"], " ", 
    StyleBox["d",
     FontSlant->"Plain"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "e9815e3e-5db7-4f79-a969-99844633f481"],
