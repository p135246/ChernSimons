  FontSize->0.9 Inherited,ExpressionUUID->
  "c4638dca-3b26-4ae3-895f-0d69095f762b"],
 " name the degrees where no coexact part exists."
}], "Notes",ExpressionUUID->"bedafbd0-3140-45fe-a7da-048d512f8867"],

