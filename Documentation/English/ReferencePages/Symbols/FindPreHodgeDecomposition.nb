  RowBox[{"CochainComplexWithPairing", "[", 
   RowBox[{
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"1", " ", "->", " ", "0"}], ",", " ", 
      RowBox[{"a", " ", "->", " ", "1"}], ",", " ", 
