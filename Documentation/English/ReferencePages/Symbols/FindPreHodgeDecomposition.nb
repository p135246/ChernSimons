  FontSize->0.9 Inherited,ExpressionUUID->
  "5e7c901f-c48f-42ad-9950-21ed978ed182"],
 " name the degrees where no coexact part exists."
}], "Notes",ExpressionUUID->"55561ac5-ce73-439f-8356-132ce78f46e7"],

