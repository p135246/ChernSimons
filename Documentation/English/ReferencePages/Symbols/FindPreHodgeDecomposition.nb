Cell[TextData[{
 "A pre-Hodge decomposition of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     StyleBox["V", "TI"], ",", 
     StyleBox["d",
      FontSlant->"Plain"], ",", 
     RowBox[{"\[LeftAngleBracket]", 
      RowBox[{"-", ",", "-"}], "\[RightAngleBracket]"}]}], ")"}], 
   TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "042be1a5-f735-487c-85fa-a044ba8b73ad"],
 " is a splitting ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["V", "TI"], "\[LongEqual]", 
    StyleBox["H", "TI"], "\[CirclePlus]", 
    StyleBox["im",
     FontSlant->"Plain"], " ", 
    StyleBox["d",
