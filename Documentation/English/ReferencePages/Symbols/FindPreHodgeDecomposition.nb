 Cell[BoxData[
  FormBox[
   RowBox[{"ker", 
    StyleBox["d",
     FontSlant->"Plain"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "e227522c-5612-4d0b-b217-f624a01904fe"],
