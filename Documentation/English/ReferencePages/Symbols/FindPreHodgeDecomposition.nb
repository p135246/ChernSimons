    StyleBox["d",
     FontSlant->"Plain"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f285b7ae-966f-4df5-ac91-fd0ff442c900"],
 ", ",
 Cell[BoxData[
  FormBox[
   StyleBox["C", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1625a272-7e0b-42ee-8750-4282ca904485"],
 " a complement of ",
 Cell[BoxData[
  FormBox[
