  FontSize->0.9 Inherited,ExpressionUUID->
  "15d27951-7570-4133-b1d7-19b9d8e986df"],
 " with ",
 Cell[BoxData[
  FormBox[
   StyleBox["H", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "eb816624-6d67-4234-b695-5ee665df5cdc"],
 " a complement of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["im",
     FontSlant->"Plain"], " ", 
    StyleBox["d",
     FontSlant->"Plain"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "97a36378-9618-4fa5-91e4-e5609d0316c3"],
 " in ",
 Cell[BoxData[
  FormBox[
