Cell["The same in the exterior picture:", "ExampleText",ExpressionUUID->"e479a343-b956-49ae-ad65-5e92bbbd148c"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"exterior", " ", "=", " ", 
   RowBox[{"Append", "[", 
    RowBox[{
     RowBox[{"Pairing", "[", 
      RowBox[{
       RowBox[{"<|", 
        RowBox[{
