Cell["\<\
The derivation extension applied to a two-factor product returns a one-factor \
product:\
\>", "ExampleText",ExpressionUUID->"21d441f1-fdec-405d-8395-affc11969d82"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"pairing", " ", "=", " ", 
   RowBox[{"Pairing", "[", 
    RowBox[{
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"x", " ", "->", " ", 
        RowBox[{"-", "1"}]}], ",", " ", 
       RowBox[{"y", " ", "->", " ", "0"}]}], "|>"}], ",", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "y"}], "}"}], " ", "->", " ", "1"}], "|>"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{"Bracket", "[", 
  RowBox[{
   RowBox[{"SymmetricProduct", "[", 
    RowBox[{
     RowBox[{"CyclicWord", "[", 
      RowBox[{"{", "x", "}"}], "]"}], ",", " ", 
     RowBox[{"CyclicWord", "[", 
      RowBox[{"{", 
       RowBox[{"x", ",", " ", "y"}], "}"}], "]"}], ",", " ", "pairing"}], 
    "]"}], ",", " ", "pairing"}], "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"f4cfc6f1-c02c-43b7-90fb-9329088040f4"],

Cell[BoxData[
 RowBox[{"-", 
  RowBox[{"SymmetricProduct", "[", 
   RowBox[{"CyclicWord", "[", 
    RowBox[{"{", "x", "}"}], "]"}], "]"}]}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"2fcadcd0-5757-4b12-b2d8-e758e3125b79"]
}, Open  ]],

