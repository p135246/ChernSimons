Cell[CellGroupData[{
Cell["Bracket", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"29b1ff8b-e255-4432-bae8-5814b39202b0"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["Bracket"]], "paclet:IBLInfinity/ref/Bracket", 
     "IBLInfinity Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["u", "TI"], ",", " ", 
    StyleBox["v", "TI"], ",", " ", 
    StyleBox["pairing", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f9fd21c6-9349-49c2-a0f5-cdeadf2634e6"],
 "\[LineSeparator]",
 "gives the bracket ",
 Cell[BoxData[
  RowBox[{
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["u", "TI"], ",", 
    StyleBox["v", "TI"]}], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "35098aab-ba4f-49dd-8c60-bff96e94db5b"],
 " of two cyclic words, in the convention carried by ",
 StyleBox["pairing", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"0da912d8-31d5-4a23-919d-3bc5c5d43f13"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["Bracket"]], "paclet:IBLInfinity/ref/Bracket", 
     "IBLInfinity Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["p", "TI"], ",", " ", 
    StyleBox["pairing", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8cb37eb8-e772-44bf-b5c4-546023cc7d41"],
 "\[LineSeparator]",
 "applies the extension of the bracket as a derivation to a product ",
 StyleBox["p", "TI"],
 " of any number of factors."
}], "Usage",ExpressionUUID->"217fc62e-6034-42db-bb36-a8c881d24b32"],

Cell[TextData[{
 "The bracket is the operation ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["q", "TI"], 
   RowBox[{"2", ",", "1", ",", "0"}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3ce1acda-1d09-431f-9c65-e17e98092be2"],
 " of the involutive bi-Lie structure: it takes two cyclic words and returns \
one, contracting one particle of each against the pairing."
}], "Notes",ExpressionUUID->"549d37eb-a2db-4687-a0ba-d98d4308abd1"],

Cell[TextData[{
 "The convention key of ",
 StyleBox["pairing", "TI"],
 " selects the picture. ",
 Cell[BoxData["\"\<Symmetric\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5f1bdea1-4274-473d-9c2b-f160a9b08771"],
 " gives the bracket of the ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SymmetricProduct"]], "paclet:IBLInfinity/ref/SymmetricProduct",
     "IBLInfinity Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "b9453ee9-5cbf-4130-9981-e81c20f52927"],
 " grading, ",
 Cell[BoxData["\"\<Exterior\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b7cec433-7b95-4581-b2bb-a8da93c8d7a1"],
 " that of the ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ExteriorProduct"]], "paclet:IBLInfinity/ref/ExteriorProduct", 
    "IBLInfinity Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "ef0306ce-a7c4-4552-93af-2318bcffbb94"],
 " grading; the two differ by signs, not by the underlying contraction."
}], "Notes",ExpressionUUID->"2a868928-69eb-44f9-86e3-5f3bd000fb43"],

Cell[TextData[{
 "In the two-argument form ",
 StyleBox["p", "TI"],
 " is a ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SymmetricProduct"]], "paclet:IBLInfinity/ref/SymmetricProduct",
     "IBLInfinity Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "baae336b-4fc8-4c3e-a06e-f40ea322fdaa"],
 " or an ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ExteriorProduct"]], "paclet:IBLInfinity/ref/ExteriorProduct", 
    "IBLInfinity Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "2b7d7526-afd0-4c19-99d7-84112ef32e34"],
 ", and the result is the derivation extension ",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox[
    StyleBox["q", "TI"], "^"], 
   RowBox[{"2", ",", "1", ",", "0"}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "66650441-c73a-4550-9525-1e493bf3601b"],
 ": the bracket is applied to each pair of factors in turn, with the Koszul \
sign of the shuffle, and the remaining factors are carried along. The \
extension lowers the number of factors by one."
}], "Notes",ExpressionUUID->"97107895-2738-44e0-b0ba-a80370d1c767"],

Cell[TextData[{
 "The identities the bracket satisfies are the business of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Jacobi"]], "paclet:IBLInfinity/ref/Jacobi", 
    "IBLInfinity Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "cb7fd600-0595-47f0-b9f7-f370f3d7cb21"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Drinfeld"]], "paclet:IBLInfinity/ref/Drinfeld", 
    "IBLInfinity Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "73d890c3-0335-4a39-bb77-826041362208"],
 "; ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RelationFailures"]], "paclet:IBLInfinity/ref/RelationFailures",
     "IBLInfinity Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "d3210209-0e03-4923-99dc-4a60d6df5b9b"],
 " searches for a counterexample over a range of word lengths."
}], "Notes",ExpressionUUID->"772f5ce1-d9c0-41c8-b6e1-136d6fef6af2"]
}, Open  ]],

