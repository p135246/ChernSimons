       RowBox[{"x", ",", " ", "y"}], "}"}], "]"}], ",", " ", 
     RowBox[{"CyclicWord", "[", 
      RowBox[{"{", 
       RowBox[{"y", ",", " ", "y"}], "}"}], "]"}], ",", " ", "pairing"}], 
    "]"}], ",", " ", "pairing"}], "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"5e60796b-8ed4-4e0a-882b-11b2010606b4"],

