Cell[TextData[{
 "A SullivanModel object is the tagged object that ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SullivanModel"]], "paclet:ChernSimons/ref/SullivanModel", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "af9b7013-b244-4535-9634-6b6be4174be5"],
 " gives, a head wrapping an Association."
}], "Notes",
 CellFrameLabels->{{Inherited, Inherited}, {Inherited, 
    Cell[
     TextData[{
      "26.09.30: Design review - the recognizer came with the tagged head, \
when the model stopped being a plain Association (T0b, 2026-09-21), under the \
rule that every object of the paclet is one head with a Q predicate. It tests \
the head and the Association inside it only, and does not check the data, \
which the constructor has already checked; whether the recognizers should \
validate the mathematics, as PureMath's ChainComplexQ does, is recorded as \
open in the HodgeDecompositions hand-off. Prior art: the Wolfram Language has \
no Sullivan models; the engine the verification suites load keeps a model as \
a plain Association and has no recognizer.", "\n\n", 
       Cell[
        BoxData[
         GridBox[{{
            Cell[
             BoxData[
              ButtonBox[
               DynamicBox[
                FEPrivate`FrontEndResource[
                "DocumentationToolsStrings", "Edit"]], BaseStyle -> 
               "TextAnnotationButton"]]], 
            StyleBox[
             RowBox[{
               DynamicBox[
                FEPrivate`FrontEndResource[
                "DocumentationToolsStrings", "LastAnnotator"]], "pavel"}], 
             "TextAnnotator"], 
            Cell[
             BoxData[
              ButtonBox[
               DynamicBox[
                FEPrivate`FrontEndResource[
                "DocumentationToolsStrings", "Delete"]], BaseStyle -> 
               "TextAnnotationRemoveButton"]]], ""}}, 
          GridBoxAlignment -> {
           "Columns" -> {Left, Left, Right, Right}, "Rows" -> {{Automatic}}}, 
          GridBoxItemSize -> {"Columns" -> {
              Scaled[0.15], 
              Scaled[0.68], 
              Scaled[0.15], 
              Scaled[0.02]}}]]], "\n"}], "TextAnnotation", 
     CellSize -> {590, Inherited}]}},
 CellTags->"TextAnnotation",
 CellID->902900549,ExpressionUUID->"b3464686-728f-4ea0-b6e7-dd9f5a1b87a5"],

