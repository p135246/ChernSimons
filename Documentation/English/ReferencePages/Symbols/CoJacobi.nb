Cell[CellGroupData[{
Cell["CoJacobi", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"d42375d0-ebff-465f-9075-bb882a3417da"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["CoJacobi"]], "paclet:IBLInfinity/ref/CoJacobi", 
     "IBLInfinity Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["w", "TI"], ",", " ", 
    StyleBox["pairing", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4dcbf1b6-e8b5-414b-a62c-6d50f51afb64"],
 "\[LineSeparator]",
 "gives the co-Jacobi obstruction of a cyclic word; ",
 Cell[BoxData["0"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c31767a8-0d5b-4a9e-9d59-cf18ca357196"],
 " means the identity holds there.",
 "\n"
}], "Usage",ExpressionUUID->"21ddfa24-4e46-4a93-b9c7-10b48496b2b3"],

Cell[TextData[{
 "The obstruction is the composite ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    OverscriptBox[
     StyleBox["q", "TI"], "^"], 
    RowBox[{"1", ",", "2", ",", "0"}]], "\[SmallCircle]", 
   SubscriptBox[
    OverscriptBox[
     StyleBox["q", "TI"], "^"], 
    RowBox[{"1", ",", "2", ",", "0"}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c1fb2cd6-2e84-4ab6-aa9b-767c3bf5a280"],
 " applied to ",
 StyleBox["w", "TI"],
 " \[LongDash] the co-Jacobi identity written as the statement that the \
co-derivation extension of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Cobracket"]], "paclet:IBLInfinity/ref/Cobracket", 
    "IBLInfinity Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "b56b6adb-385a-4f86-8847-7944863a961e"],
 " squares to zero."
}], "Notes",ExpressionUUID->"afff01d5-f42a-453c-aa12-16699f8ced52"],

Cell[TextData[{
 "The convention key of ",
 StyleBox["pairing", "TI"],
 " selects the picture, exactly as it does for ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Cobracket"]], "paclet:IBLInfinity/ref/Cobracket", 
    "IBLInfinity Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "912fbc85-f4ac-470b-b01e-78c33e3fb738"],
 "."
}], "Notes",ExpressionUUID->"71a16000-222c-4a16-b331-4b65e98963f0"],

Cell[TextData[{
 "The identity is dual to the one ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Jacobi"]], "paclet:IBLInfinity/ref/Jacobi", 
    "IBLInfinity Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "7a45b5fc-da14-413f-97fb-40b8dd25eaf3"],
 " tests, and takes one word rather than three: the co-bracket raises the \
number of factors, so composing it with itself already involves every cut of \
the single input word."
}], "Notes",ExpressionUUID->"dc06176d-8a02-452d-ace9-f6b22d42aea0"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CoJacobi"]], "paclet:IBLInfinity/ref/CoJacobi", 
    "IBLInfinity Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "4a699292-c223-4da3-b68a-d52dfc906a4f"],
 " is the arity-",
 Cell[BoxData["1"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e222eb84-fbfe-401d-bb77-01ec0dd0276e"],
 " entry of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["$Relations"]], "paclet:IBLInfinity/ref/$Relations", 
    "IBLInfinity Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "28a43c94-30e3-4b18-bb0e-f00396f255f6"],
 "; ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RelationFailures"]], "paclet:IBLInfinity/ref/RelationFailures",
     "IBLInfinity Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "5492fd84-1775-4718-9650-6e1e589b3061"],
 " sweeps it over an enumerated range of words."
}], "Notes",ExpressionUUID->"eb20a8a5-9935-4edf-9b82-972944fb98ac"],

Cell[TextData[{
 "Words short enough to have vanishing ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Cobracket"]], "paclet:IBLInfinity/ref/Cobracket", 
    "IBLInfinity Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "0b25918b-e59f-4300-bcff-460538fb9e2d"],
 " have vanishing obstruction for trivial reasons; the first informative test \
over the alphabet of the circle is at length ",
 Cell[BoxData["4"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e4612586-5d87-45ed-a877-f6e03e098e4d"],
 "."
}], "Notes",ExpressionUUID->"76bae616-11aa-45a3-a7a2-8e63989bdcf5"]
