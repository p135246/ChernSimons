Cell["\<\
The identity holds on the shortest word with a nonzero co-bracket:\
\>", "ExampleText",ExpressionUUID->"c1c3a142-bb7b-46a5-a8f6-7fcbe2e2e83a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"CoJacobi", "[", 
  RowBox[{
   RowBox[{"CyclicWord", "[", 
    RowBox[{"{", 
     RowBox[{"x", ",", " ", "y", ",", " ", "y", ",", " ", "y"}], "}"}], "]"}],
    ",", " ", 
   RowBox[{"Pairing", "[", 
    RowBox[{
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"x", " ", "->", " ", 
        RowBox[{"-", "1"}]}], ",", " ", 
       RowBox[{"y", " ", "->", " ", "0"}]}], "|>"}], ",", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "y"}], "}"}], " ", "->", " ", "1"}], "|>"}]}], 
    "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"14d811ce-3ddb-4ce4-803e-d40542624dc5"],

Cell[BoxData["0"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"8573e0cf-5c73-41cf-9ef8-3faca0e3506c"]
}, Open  ]],

