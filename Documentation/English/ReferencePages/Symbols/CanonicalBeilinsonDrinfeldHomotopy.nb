Cell[TextData[{
 "A flow of the circle along a single homotopy generator ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["w", "TI"], "1"], " ", 
    StyleBox["x", "TI"], 
    StyleBox["y", "TI"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8155e14f-cd1f-46af-855b-8b2ca91c2856"],
 ":"
}], "ExampleText",ExpressionUUID->"ad29346b-dc5e-4100-84d6-fc260079bdff"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"flow", " ", "=", " ", 
  RowBox[{"CanonicalBeilinsonDrinfeldHomotopy", "[", 
   RowBox[{
    RowBox[{"c01", " ", 
     RowBox[{"CyclicWord", "[", 
      RowBox[{"{", 
       RowBox[{"x", ",", " ", "x", ",", " ", "y"}], "}"}], "]"}]}], ",", " ", 
    
    RowBox[{"w1", " ", 
     RowBox[{"CyclicWord", "[", 
      RowBox[{"{", 
       RowBox[{"x", ",", " ", "y"}], "}"}], "]"}]}], ",", " ", 
    RowBox[{"GradedPairing", "[", 
     RowBox[{
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"x", " ", "->", " ", 
         RowBox[{"-", "1"}]}], ",", " ", 
        RowBox[{"y", " ", "->", " ", "0"}]}], "|>"}], ",", " ", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"x", ",", " ", "y"}], "}"}], " ", "->", " ", "1"}], "|>"}]}],
      "]"}], ",", " ", "4", ",", " ", "t", ",", " ", "3"}], "]"}]}]], "Input",\

 CellLabel->"In[1]:= ",ExpressionUUID->"5bff134e-8b62-482c-82cd-2b7a54d2e214"],

Cell[BoxData[
 RowBox[{
  RowBox[{"c01", " ", 
   InterpretationBox[
    RowBox[{"(", 
     RowBox[{"x", "\[ThinSpace]", "x", "\[ThinSpace]", "y"}], ")"}],
    ChernSimons`CyclicWord[{
     MTNB$5ns7lj85sxbb`x, MTNB$5ns7lj85sxbb`x, MTNB$5ns7lj85sxbb`y}],
    Editable->False]}], "-", 
  RowBox[{"c01", " ", "t", " ", "w1", " ", 
   InterpretationBox[
    RowBox[{"(", 
     RowBox[{"x", "\[ThinSpace]", "x", "\[ThinSpace]", "y"}], ")"}],
    ChernSimons`CyclicWord[{
     MTNB$5ns7lj85sxbb`x, MTNB$5ns7lj85sxbb`x, MTNB$5ns7lj85sxbb`y}],
    Editable->False]}], "+", 
  RowBox[{
   FractionBox["1", "2"], " ", "c01", " ", 
   SuperscriptBox["t", "2"], " ", 
   SuperscriptBox["w1", "2"], " ", 
   InterpretationBox[
    RowBox[{"(", 
     RowBox[{"x", "\[ThinSpace]", "x", "\[ThinSpace]", "y"}], ")"}],
    ChernSimons`CyclicWord[{
     MTNB$5ns7lj85sxbb`x, MTNB$5ns7lj85sxbb`x, MTNB$5ns7lj85sxbb`y}],
    Editable->False]}], "-", 
  RowBox[{
   FractionBox["1", "6"], " ", "c01", " ", 
   SuperscriptBox["t", "3"], " ", 
   SuperscriptBox["w1", "3"], " ", 
   InterpretationBox[
    RowBox[{"(", 
     RowBox[{"x", "\[ThinSpace]", "x", "\[ThinSpace]", "y"}], ")"}],
    ChernSimons`CyclicWord[{
     MTNB$5ns7lj85sxbb`x, MTNB$5ns7lj85sxbb`x, MTNB$5ns7lj85sxbb`y}],
    Editable->False]}]}]], "Output",
