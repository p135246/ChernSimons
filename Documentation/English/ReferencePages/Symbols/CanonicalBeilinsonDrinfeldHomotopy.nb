Cell[CellGroupData[{
Cell["CanonicalBeilinsonDrinfeldHomotopy", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"50c52725-da0c-4380-b826-f0efe9c75b60"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["CanonicalBeilinsonDrinfeldHomotopy"]], 
     "paclet:ChernSimons/ref/CanonicalBeilinsonDrinfeldHomotopy", 
     "ChernSimons Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["a", "TI"], ",", " ", 
    StyleBox["b", "TI"], ",", " ", 
    StyleBox["pairing", "TI"], ",", " ", 
    StyleBox["n", "TI"], ",", " ", 
    StyleBox["t", "TI"], ",", " ", 
    StyleBox["order", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "c5051fdd-fbb9-4f78-94a8-9a4e94a93187"],
 "\[LineSeparator]",
 "gives the solution ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["a", "TI"], "(", 
    StyleBox["t", "TI"], ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"7a4e7c4b-cee1-4166-bfd2-3680c162c86d"],
 " of the BD homotopy equation ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalDelta]", 
    StyleBox["b", "TI"], "+", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["a", "TI"], 
      RowBox[{"(", 
       StyleBox["t", "TI"], ")"}], ",", 
      StyleBox["b", "TI"]}], "}"}], "\[LongEqual]", "-", 
    OverscriptBox[
     StyleBox["a", "TI"], "."], 
    RowBox[{"(", 
     StyleBox["t", "TI"], ")"}]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"7bdd2e2f-cf5b-4c6b-bffc-480910fadcf2"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["a", "TI"], 
    RowBox[{"(", "0", ")"}], "\[LongEqual]", 
    StyleBox["a", "TI"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "cd098323-298e-4369-9208-256cad671249"],
 ", as a polynomial in ",
 StyleBox["t", "TI"],
 " of degree at most ",
 StyleBox["order", "TI"],
 ", truncated to total word length at most ",
 StyleBox["n", "TI"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"99a549fb-0b20-420a-ab76-35c0820410be"],

Cell[TextData[{
 StyleBox["a", "TI"],
 " is a BD action, a sum of scalars times powers of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["HBar"]], "paclet:ChernSimons/ref/HBar", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "07593d0b-e6d7-4006-bdfc-9fa015f7bff8"],
 " times cyclic words and symmetric products, and ",
 StyleBox["b", "TI"],
 " is the interval component of the homotopy, constant in ",
 StyleBox["t", "TI"],
 "."
}], "Notes",
 CellFrameLabels->{{Inherited, Inherited}, {Inherited, 
    Cell[
     TextData[{
      "26.09.30: Design review - the name says what the function computes, a \
homotopy in the Beilinson-Drinfeld algebra of the string operations, beside \
CanonicalBeilinsonDrinfeldOperator and CanonicalBeilinsonDrinfeldBracket; it \
was GaugeFlow until R5f (the name the names doc recommended, approved by \
Pavel, 2026-09-30), with the same signature and option. Alternative name \
considered: GaugeFlow. It takes BD actions and a pairing, not \
MaurerCartanElement objects; R5d and R5f kept that signature, and no \
alternative was recorded. The equation is written in the BD algebra itself, \
from CanonicalBeilinsonDrinfeldOperator and \
CanonicalBeilinsonDrinfeldBracket, so it needs no parametrization by \
coefficients and is not tied to any alphabet; the two truncations, by word \
length and by the power of t, are explicit arguments. A pairing in the \
exterior convention returns unevaluated, since the BD algebra is the \
symmetric algebra (R2). Prior art: the Wolfram Language has no BD algebras; \
the engine the verification suites load solves the coefficient equations of \
the circle on arrays truncated by index, which truncates differently, so \
T12/paclet-gauge-flow-solves-the-bd-homotopy-equation tests the equation \
itself rather than a comparison, and \
T12/paclet-empty-word-gauge-flow-is-the-extended-transport pins the velocity \
at t = 0 against the transport of the empty-word extension, with and without \
the option.", "\n\n", 
       Cell[
        BoxData[
         GridBox[{{
            Cell[
             BoxData[
              ButtonBox[
               DynamicBox[
                FEPrivate`FrontEndResource[
                "DocumentationToolsStrings", "Edit"]], BaseStyle -> 
               "TextAnnotationButton"]]], 
            StyleBox[
             RowBox[{
               DynamicBox[
                FEPrivate`FrontEndResource[
                "DocumentationToolsStrings", "LastAnnotator"]], "pavel"}], 
             "TextAnnotator"], 
            Cell[
             BoxData[
              ButtonBox[
               DynamicBox[
                FEPrivate`FrontEndResource[
                "DocumentationToolsStrings", "Delete"]], BaseStyle -> 
               "TextAnnotationRemoveButton"]]], ""}}, 
          GridBoxAlignment -> {
           "Columns" -> {Left, Left, Right, Right}, "Rows" -> {{Automatic}}}, 
          GridBoxItemSize -> {"Columns" -> {
              Scaled[0.15], 
              Scaled[0.68], 
              Scaled[0.15], 
              Scaled[0.02]}}]]], "\n"}], "TextAnnotation", 
     CellSize -> {590, Inherited}]}},
 CellTags->"TextAnnotation",
 CellID->641017981,ExpressionUUID->"923baae3-a136-47dd-921f-4b9139a73512"],

Cell[TextData[{
 Cell[BoxData[
  FormBox["\[CapitalDelta]", TraditionalForm]], "InlineFormula",
  ExpressionUUID->"72ee5b06-f818-4353-9f9b-e29443f6971b"],
 " is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CanonicalBeilinsonDrinfeldOperator"]], 
    "paclet:ChernSimons/ref/CanonicalBeilinsonDrinfeldOperator", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "9b63b011-4428-49db-97b0-385bcd3ee4df"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"\[CenterDot]", ",", "\[CenterDot]"}], "}"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"fc155230-09ed-42d3-a5cc-24f39c8285cd"],
 " is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CanonicalBeilinsonDrinfeldBracket"]], 
    "paclet:ChernSimons/ref/CanonicalBeilinsonDrinfeldBracket", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "a4cc9560-a76c-4efb-959d-10ba82337075"],
 "."
}], "Notes",ExpressionUUID->"a3c77902-5a99-45c4-937d-f307d5f17d9a"],

Cell[TextData[{
 "The solution is computed by Picard iteration: ",
 StyleBox["order", "TI"],
 " steps of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["a", "TI"], 
    RowBox[{"(", 
     StyleBox["t", "TI"], ")"}], "\[RightTeeArrow]", 
    StyleBox["a", "TI"], "-", 
    SubsuperscriptBox["\[Integral]", "0", 
     StyleBox["t", "TI"]], 
    RowBox[{"(", 
     RowBox[{"\[CapitalDelta]", 
      StyleBox["b", "TI"], "+", 
      RowBox[{"{", 
       RowBox[{
        StyleBox["a", "TI"], 
        RowBox[{"(", 
         StyleBox["s", "TI"], ")"}], ",", 
        StyleBox["b", "TI"]}], "}"}]}], ")"}], "\[DifferentialD]", 
    StyleBox["s", "TI"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "61457a18-5eec-4faf-badd-bfce1a0d268d"],
 ", each truncated to degree at most ",
 StyleBox["order", "TI"],
 " in ",
 StyleBox["t", "TI"],
 "."
}], "Notes",ExpressionUUID->"a43ae1fa-0b38-4210-9044-0c8e5e5ac6eb"],

Cell[TextData[{
 "After each step the words and products of total word length greater than ",
 StyleBox["n", "TI"],
 " are dropped, those of ",
 StyleBox["a", "TI"],
 " included."
}], "Notes",ExpressionUUID->"a1fbf407-2cc5-4244-b00e-8850e96a581f"],

Cell[TextData[{
 "The equation holds to order ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["t", "TI"], 
    RowBox[{"order", "-", "1"}]], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"8652d0b6-2e87-4a2c-a2d4-aa948a1b1746"],
 " and in general fails at ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["t", "TI"], "order"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"cbab34cb-047d-4b79-a428-0582bd534b03"],
 "."
}], "Notes",ExpressionUUID->"4b0c8122-441a-4074-95c3-f2a2ed3daee0"],

Cell["\<\
Two BD actions are BD homotopic, equivalently their Maurer-Cartan elements \
are gauge equivalent, when such a flow connects them.\
\>", "Notes",ExpressionUUID->"dd29b688-89d9-46f2-8e44-06df9e8a07bd"],

Cell[TextData[{
 "If ",
 StyleBox["a", "TI"],
 " solves the Maurer-Cartan equation, so does ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["a", "TI"], "(", 
    StyleBox["t", "TI"], ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"bab7be91-be26-4df3-8769-3d0bfff2dc2c"],
 ", up to the two truncations."
}], "Notes",ExpressionUUID->"eac278d1-6302-4cc7-abcd-3ae9316f3106"],

Cell[TextData[{
 "The result is a BD action, which ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["MaurerCartanElement"]], 
    "paclet:ChernSimons/ref/MaurerCartanElement", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "4d615a15-0762-41d7-89fc-59c0d77c1277"],
 " splits into its parts."
}], "Notes",ExpressionUUID->"d7cc27bd-85c9-4afe-a5e1-9faa5333fae7"],

Cell["\<\
On the circle the equation is the coefficient system of the paper's lemma on \
BD homotopies. That system is truncated by the indices of the coefficients \
rather than by word length, so the two agree only where neither truncation is \
active.\
\>", "Notes",ExpressionUUID->"adc10057-0937-4d8e-adba-5e1216ec0d3c"],

Cell["A pairing in the exterior convention returns unevaluated.", "Notes",ExpressionUUID->"fb8a3fbd-6743-4717-90dd-a719f5e82b60"],

