Cell[TextData[{
 "A flow of the circle along a single homotopy generator ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["w", "TI"], "1"], " ", 
    StyleBox["x", "TI"], 
    StyleBox["y", "TI"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "91edf3fb-c455-410a-a691-128c442e1341"],
 ":"
}], "ExampleText",ExpressionUUID->"453ab129-8cd4-40f2-9120-1f8acbf053e8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"flow", " ", "=", " ", 
  RowBox[{"CanonicalBeilinsonDrinfeldHomotopy", "[", 
   RowBox[{
    RowBox[{"c01", " ", 
     RowBox[{"CyclicWord", "[", 
      RowBox[{"{", 
       RowBox[{"x", ",", " ", "x", ",", " ", "y"}], "}"}], "]"}]}], ",", " ", 
    
    RowBox[{"w1", " ", 
     RowBox[{"CyclicWord", "[", 
      RowBox[{"{", 
       RowBox[{"x", ",", " ", "y"}], "}"}], "]"}]}], ",", " ", 
    RowBox[{"GradedPairing", "[", 
     RowBox[{
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"x", " ", "->", " ", 
         RowBox[{"-", "1"}]}], ",", " ", 
        RowBox[{"y", " ", "->", " ", "0"}]}], "|>"}], ",", " ", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"x", ",", " ", "y"}], "}"}], " ", "->", " ", "1"}], "|>"}]}],
      "]"}], ",", " ", "4", ",", " ", "t", ",", " ", "3"}], "]"}]}]], "Input",\

 CellLabel->"In[1]:= ",ExpressionUUID->"c6143606-f6d9-48c1-bbe1-d20eb9d334aa"],

Cell[BoxData[
 RowBox[{
  RowBox[{"c01", " ", 
   InterpretationBox[
    RowBox[{"(", 
     RowBox[{"x", "\[ThinSpace]", "x", "\[ThinSpace]", "y"}], ")"}],
    ChernSimons`CyclicWord[{
     MTNB$5ns7lj85sxbb`x, MTNB$5ns7lj85sxbb`x, MTNB$5ns7lj85sxbb`y}],
    Editable->False]}], "-", 
  RowBox[{"c01", " ", "t", " ", "w1", " ", 
   InterpretationBox[
    RowBox[{"(", 
     RowBox[{"x", "\[ThinSpace]", "x", "\[ThinSpace]", "y"}], ")"}],
    ChernSimons`CyclicWord[{
     MTNB$5ns7lj85sxbb`x, MTNB$5ns7lj85sxbb`x, MTNB$5ns7lj85sxbb`y}],
    Editable->False]}], "+", 
  RowBox[{
   FractionBox["1", "2"], " ", "c01", " ", 
   SuperscriptBox["t", "2"], " ", 
   SuperscriptBox["w1", "2"], " ", 
   InterpretationBox[
    RowBox[{"(", 
     RowBox[{"x", "\[ThinSpace]", "x", "\[ThinSpace]", "y"}], ")"}],
    ChernSimons`CyclicWord[{
     MTNB$5ns7lj85sxbb`x, MTNB$5ns7lj85sxbb`x, MTNB$5ns7lj85sxbb`y}],
    Editable->False]}], "-", 
  RowBox[{
   FractionBox["1", "6"], " ", "c01", " ", 
   SuperscriptBox["t", "3"], " ", 
   SuperscriptBox["w1", "3"], " ", 
   InterpretationBox[
    RowBox[{"(", 
     RowBox[{"x", "\[ThinSpace]", "x", "\[ThinSpace]", "y"}], ")"}],
    ChernSimons`CyclicWord[{
     MTNB$5ns7lj85sxbb`x, MTNB$5ns7lj85sxbb`x, MTNB$5ns7lj85sxbb`y}],
    Editable->False]}]}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"c32a936b-b24b-4eed-a7b0-28cd765b636f"]
}, Open  ]],

