Cell[TextData[{
 "A flow of the circle along a single homotopy generator ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["w", "TI"], "1"], " ", 
    StyleBox["x", "TI"], 
    StyleBox["y", "TI"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "25ba7bc5-95c9-4e2b-9a9f-2dcd33fd5e23"],
 ":"
}], "ExampleText",ExpressionUUID->"7fce91e9-94a0-4ea1-a05d-d4ef56c2b8c3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"flow", " ", "=", " ", 
  RowBox[{"CanonicalBeilinsonDrinfeldHomotopy", "[", 
   RowBox[{
    RowBox[{"c01", " ", 
     RowBox[{"CyclicWord", "[", 
      RowBox[{"{", 
       RowBox[{"x", ",", " ", "x", ",", " ", "y"}], "}"}], "]"}]}], ",", " ", 
    
    RowBox[{"w1", " ", 
     RowBox[{"CyclicWord", "[", 
      RowBox[{"{", 
       RowBox[{"x", ",", " ", "y"}], "}"}], "]"}]}], ",", " ", 
    RowBox[{"GradedPairing", "[", 
     RowBox[{
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"x", " ", "->", " ", 
         RowBox[{"-", "1"}]}], ",", " ", 
        RowBox[{"y", " ", "->", " ", "0"}]}], "|>"}], ",", " ", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"x", ",", " ", "y"}], "}"}], " ", "->", " ", "1"}], "|>"}]}],
      "]"}], ",", " ", "4", ",", " ", "t", ",", " ", "3"}], "]"}]}]], "Input",\

 CellLabel->"In[1]:= ",ExpressionUUID->"7a853b6a-4705-4256-9e41-7959ef82b155"],

Cell[BoxData[
 RowBox[{
  RowBox[{"c01", " ", 
   InterpretationBox[
    RowBox[{"(", 
     RowBox[{"x", "\[ThinSpace]", "x", "\[ThinSpace]", "y"}], ")"}],
    ChernSimons`CyclicWord[{
     MTNB$5ns7lj85sxbb`x, MTNB$5ns7lj85sxbb`x, MTNB$5ns7lj85sxbb`y}],
    Editable->False]}], "-", 
  RowBox[{"c01", " ", "t", " ", "w1", " ", 
   InterpretationBox[
    RowBox[{"(", 
     RowBox[{"x", "\[ThinSpace]", "x", "\[ThinSpace]", "y"}], ")"}],
    ChernSimons`CyclicWord[{
     MTNB$5ns7lj85sxbb`x, MTNB$5ns7lj85sxbb`x, MTNB$5ns7lj85sxbb`y}],
    Editable->False]}], "+", 
  RowBox[{
   FractionBox["1", "2"], " ", "c01", " ", 
   SuperscriptBox["t", "2"], " ", 
   SuperscriptBox["w1", "2"], " ", 
   InterpretationBox[
    RowBox[{"(", 
     RowBox[{"x", "\[ThinSpace]", "x", "\[ThinSpace]", "y"}], ")"}],
    ChernSimons`CyclicWord[{
     MTNB$5ns7lj85sxbb`x, MTNB$5ns7lj85sxbb`x, MTNB$5ns7lj85sxbb`y}],
    Editable->False]}], "-", 
  RowBox[{
   FractionBox["1", "6"], " ", "c01", " ", 
   SuperscriptBox["t", "3"], " ", 
   SuperscriptBox["w1", "3"], " ", 
   InterpretationBox[
    RowBox[{"(", 
     RowBox[{"x", "\[ThinSpace]", "x", "\[ThinSpace]", "y"}], ")"}],
    ChernSimons`CyclicWord[{
     MTNB$5ns7lj85sxbb`x, MTNB$5ns7lj85sxbb`x, MTNB$5ns7lj85sxbb`y}],
    Editable->False]}]}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"f48fed19-8218-437a-afa0-cc040c3b13d8"]
}, Open  ]],

