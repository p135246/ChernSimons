Cell[CellGroupData[{
Cell["CanonicalBeilinsonDrinfeldHomotopy", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"aeda4e64-fdda-4909-88b3-af6fb4ca6ccf"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["CanonicalBeilinsonDrinfeldHomotopy"]], 
     "paclet:ChernSimons/ref/CanonicalBeilinsonDrinfeldHomotopy", 
     "ChernSimons Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["a", "TI"], ",", " ", 
    StyleBox["b", "TI"], ",", " ", 
    StyleBox["pairing", "TI"], ",", " ", 
    StyleBox["n", "TI"], ",", " ", 
    StyleBox["t", "TI"], ",", " ", 
    StyleBox["order", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "08b9f1dc-84d8-47f5-9970-7edc6e6b79c7"],
 "\[LineSeparator]",
 "gives the solution ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["a", "TI"], "(", 
    StyleBox["t", "TI"], ")"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bee479bb-62b2-4f59-a4cc-71809de9db56"],
 " of the BD homotopy equation ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalDelta]", 
    StyleBox["b", "TI"], "+", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["a", "TI"], 
      RowBox[{"(", 
       StyleBox["t", "TI"], ")"}], ",", 
      StyleBox["b", "TI"]}], "}"}], "\[LongEqual]", "-", 
    OverscriptBox[
     StyleBox["a", "TI"], "."], 
    RowBox[{"(", 
     StyleBox["t", "TI"], ")"}]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "64ef2645-7b70-45c9-99d8-811978588d8a"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["a", "TI"], 
    RowBox[{"(", "0", ")"}], "\[LongEqual]", 
    StyleBox["a", "TI"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "acedbc03-7b83-4232-8505-47db76f90a29"],
 ", as a polynomial in ",
 StyleBox["t", "TI"],
 " of degree at most ",
 StyleBox["order", "TI"],
 ", truncated to total word length at most ",
 StyleBox["n", "TI"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"3d5144e9-7b89-4ac9-81dc-7d6f5a485293"],

Cell[TextData[{
 StyleBox["a", "TI"],
 " is a BD action, a sum of scalars times powers of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["HBar"]], "paclet:ChernSimons/ref/HBar", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "afccb07f-1e83-41f1-aa48-6abefad43899"],
 " times cyclic words and symmetric products, and ",
 StyleBox["b", "TI"],
 " is the interval component of the homotopy, constant in ",
 StyleBox["t", "TI"],
 "."
}], "Notes",
 CellFrameLabels->{{Inherited, Inherited}, {Inherited, 
    Cell[
     TextData[{
      "26.09.30: Design review - the name says what the function computes, a \
homotopy in the Beilinson-Drinfeld algebra of the string operations, beside \
CanonicalBeilinsonDrinfeldOperator and CanonicalBeilinsonDrinfeldBracket; it \
was GaugeFlow until R5f (the name the names doc recommended, approved by \
Pavel, 2026-09-30), with the same signature and option. Alternative name \
considered: GaugeFlow. It takes BD actions and a pairing, not \
MaurerCartanElement objects; R5d and R5f kept that signature, and no \
alternative was recorded. The equation is written in the BD algebra itself, \
from CanonicalBeilinsonDrinfeldOperator and \
CanonicalBeilinsonDrinfeldBracket, so it needs no parametrization by \
coefficients and is not tied to any alphabet; the two truncations, by word \
length and by the power of t, are explicit arguments. A pairing in the \
exterior convention returns unevaluated, since the BD algebra is the \
symmetric algebra (R2). Prior art: the Wolfram Language has no BD algebras; \
the engine the verification suites load solves the coefficient equations of \
the circle on arrays truncated by index, which truncates differently, so \
T12/paclet-gauge-flow-solves-the-bd-homotopy-equation tests the equation \
itself rather than a comparison, and \
T12/paclet-empty-word-gauge-flow-is-the-extended-transport pins the velocity \
at t = 0 against the transport of the empty-word extension, with and without \
the option.", "\n\n", 
       Cell[
        BoxData[
         GridBox[{{
            Cell[
             BoxData[
              ButtonBox[
               DynamicBox[
                FEPrivate`FrontEndResource[
                "DocumentationToolsStrings", "Edit"]], BaseStyle -> 
               "TextAnnotationButton"]]], 
            StyleBox[
             RowBox[{
               DynamicBox[
                FEPrivate`FrontEndResource[
                "DocumentationToolsStrings", "LastAnnotator"]], "pavel"}], 
             "TextAnnotator"], 
            Cell[
             BoxData[
              ButtonBox[
               DynamicBox[
                FEPrivate`FrontEndResource[
                "DocumentationToolsStrings", "Delete"]], BaseStyle -> 
               "TextAnnotationRemoveButton"]]], ""}}, 
          GridBoxAlignment -> {
           "Columns" -> {Left, Left, Right, Right}, "Rows" -> {{Automatic}}}, 
          GridBoxItemSize -> {"Columns" -> {
              Scaled[0.15], 
              Scaled[0.68], 
              Scaled[0.15], 
              Scaled[0.02]}}]]], "\n"}], "TextAnnotation", 
     CellSize -> {590, Inherited}]}},
 CellTags->"TextAnnotation",
 CellID->803502682,ExpressionUUID->"aa0458bc-51a8-4aa8-8051-24a34b44036f"],

Cell[TextData[{
 Cell[BoxData[
  FormBox["\[CapitalDelta]", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "eb303de0-3940-4e10-a5ab-059dd9fb6fcb"],
 " is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CanonicalBeilinsonDrinfeldOperator"]], 
    "paclet:ChernSimons/ref/CanonicalBeilinsonDrinfeldOperator", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "d1a21774-533a-4d2c-b9e7-c466ef34d15e"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"\[CenterDot]", ",", "\[CenterDot]"}], "}"}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7aafb598-55fc-4582-9a45-1c31caf5bef0"],
 " is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CanonicalBeilinsonDrinfeldBracket"]], 
    "paclet:ChernSimons/ref/CanonicalBeilinsonDrinfeldBracket", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "988c4c69-aed8-400c-9565-c215bb231c0e"],
 "."
}], "Notes",ExpressionUUID->"420969b8-3d9f-4846-99aa-9bcbb573c7cb"],

Cell[TextData[{
 "The solution is computed by Picard iteration: ",
 StyleBox["order", "TI"],
 " steps of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["a", "TI"], 
    RowBox[{"(", 
     StyleBox["t", "TI"], ")"}], "\[RightTeeArrow]", 
    StyleBox["a", "TI"], "-", 
    SubsuperscriptBox["\[Integral]", "0", 
     StyleBox["t", "TI"]], 
    RowBox[{"(", 
     RowBox[{"\[CapitalDelta]", 
      StyleBox["b", "TI"], "+", 
      RowBox[{"{", 
       RowBox[{
        StyleBox["a", "TI"], 
        RowBox[{"(", 
         StyleBox["s", "TI"], ")"}], ",", 
        StyleBox["b", "TI"]}], "}"}]}], ")"}], "\[DifferentialD]", 
    StyleBox["s", "TI"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f8274d5b-7721-4f0a-a014-285907a6682a"],
 ", each truncated to degree at most ",
 StyleBox["order", "TI"],
 " in ",
 StyleBox["t", "TI"],
 "."
}], "Notes",ExpressionUUID->"423118a9-23cb-4770-a9c6-ce1324b979ec"],

Cell[TextData[{
 "After each step the words and products of total word length greater than ",
 StyleBox["n", "TI"],
 " are dropped, those of ",
 StyleBox["a", "TI"],
 " included."
}], "Notes",ExpressionUUID->"d8bf55dd-89f9-4644-a6bf-2f890c9d7335"],

Cell[TextData[{
 "The equation holds to order ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["t", "TI"], 
    RowBox[{"order", "-", "1"}]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e3638e7d-9f34-49f4-ae94-5318bbd6db74"],
 " and in general fails at ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["t", "TI"], "order"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a8fe3ed7-1f4f-46d0-afc4-78c6689a825b"],
 "."
}], "Notes",ExpressionUUID->"7485e550-c853-4d33-85bf-2df8135f2ab9"],

Cell["\<\
Two BD actions are BD homotopic, equivalently their Maurer-Cartan elements \
are gauge equivalent, when such a flow connects them.\
\>", "Notes",ExpressionUUID->"d753c57b-5c3d-4006-8762-c9f6d8b091dd"],

Cell[TextData[{
 "If ",
 StyleBox["a", "TI"],
 " solves the Maurer-Cartan equation, so does ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["a", "TI"], "(", 
    StyleBox["t", "TI"], ")"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fdaf6dd8-62c9-4049-99f4-12bda110c716"],
 ", up to the two truncations."
}], "Notes",ExpressionUUID->"61cdc46c-04fe-4ed0-87f2-c8a27184c558"],

Cell[TextData[{
 "The result is a BD action, which ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["MaurerCartanElement"]], 
    "paclet:ChernSimons/ref/MaurerCartanElement", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "8714397a-3f2b-40fa-bead-2a1e484921eb"],
 " splits into its parts."
}], "Notes",ExpressionUUID->"4179abd1-0ff9-4604-aff0-23669bcb2f4d"],

Cell["\<\
On the circle the equation is the coefficient system of the paper's lemma on \
BD homotopies. That system is truncated by the indices of the coefficients \
rather than by word length, so the two agree only where neither truncation is \
active.\
\>", "Notes",ExpressionUUID->"37f8ab7c-40e9-44a3-b73e-41ef94493f84"],

Cell["A pairing in the exterior convention returns unevaluated.", "Notes",ExpressionUUID->"30e02f25-703a-4a3e-af5a-b844acab1414"],

