Cell[CellGroupData[{
Cell["CanonicalBeilinsonDrinfeldHomotopy", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"e2428b4e-fad8-460f-905a-2f980bf6f958"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["CanonicalBeilinsonDrinfeldHomotopy"]], 
     "paclet:ChernSimons/ref/CanonicalBeilinsonDrinfeldHomotopy", 
     "ChernSimons Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["a", "TI"], ",", " ", 
    StyleBox["b", "TI"], ",", " ", 
    StyleBox["pairing", "TI"], ",", " ", 
    StyleBox["n", "TI"], ",", " ", 
    StyleBox["t", "TI"], ",", " ", 
    StyleBox["order", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "a7954e51-bdd7-4d7c-986b-451ebbbe42e9"],
 "\[LineSeparator]",
 "gives the solution ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["a", "TI"], "(", 
    StyleBox["t", "TI"], ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"be89bafe-9bf5-4e4b-b395-09690e688cc0"],
 " of the BD homotopy equation ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalDelta]", 
    StyleBox["b", "TI"], "+", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["a", "TI"], 
      RowBox[{"(", 
       StyleBox["t", "TI"], ")"}], ",", 
      StyleBox["b", "TI"]}], "}"}], "\[LongEqual]", "-", 
    OverscriptBox[
     StyleBox["a", "TI"], "."], 
    RowBox[{"(", 
     StyleBox["t", "TI"], ")"}]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"d255d824-2203-467a-904f-c4991b824458"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["a", "TI"], 
    RowBox[{"(", "0", ")"}], "\[LongEqual]", 
    StyleBox["a", "TI"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "4def4ce9-f8f3-476c-9a23-d22dc53b8b8f"],
 ", as a polynomial in ",
 StyleBox["t", "TI"],
 " of degree at most ",
 StyleBox["order", "TI"],
 ", truncated to total word length at most ",
 StyleBox["n", "TI"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"052b1ad4-0853-4fb9-9f93-aa7c4790d1de"],

Cell[TextData[{
 StyleBox["a", "TI"],
 " is a BD action, a sum of scalars times powers of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["HBar"]], "paclet:ChernSimons/ref/HBar", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "11abd7a1-56b0-404a-b201-b328051fb780"],
 " times cyclic words and symmetric products, and ",
 StyleBox["b", "TI"],
 " is the interval component of the homotopy, constant in ",
 StyleBox["t", "TI"],
 "."
}], "Notes",
 CellFrameLabels->{{Inherited, Inherited}, {Inherited, 
    Cell[
     TextData[{
      "26.09.30: Design review - the name says what the function computes, a \
homotopy in the Beilinson-Drinfeld algebra of the string operations, beside \
CanonicalBeilinsonDrinfeldOperator and CanonicalBeilinsonDrinfeldBracket; it \
was GaugeFlow until R5f (the name the names doc recommended, approved by \
Pavel, 2026-09-30), with the same signature and option. Alternative name \
considered: GaugeFlow. It takes BD actions and a pairing, not \
MaurerCartanElement objects; R5d and R5f kept that signature, and no \
alternative was recorded. The equation is written in the BD algebra itself, \
from CanonicalBeilinsonDrinfeldOperator and \
CanonicalBeilinsonDrinfeldBracket, so it needs no parametrization by \
coefficients and is not tied to any alphabet; the two truncations, by word \
length and by the power of t, are explicit arguments. A pairing in the \
exterior convention returns unevaluated, since the BD algebra is the \
symmetric algebra (R2). Prior art: the Wolfram Language has no BD algebras; \
the engine the verification suites load solves the coefficient equations of \
the circle on arrays truncated by index, which truncates differently, so \
T12/paclet-gauge-flow-solves-the-bd-homotopy-equation tests the equation \
itself rather than a comparison, and \
T12/paclet-empty-word-gauge-flow-is-the-extended-transport pins the velocity \
at t = 0 against the transport of the empty-word extension, with and without \
the option.", "\n\n", 
       Cell[
        BoxData[
         GridBox[{{
            Cell[
             BoxData[
              ButtonBox[
               DynamicBox[
                FEPrivate`FrontEndResource[
                "DocumentationToolsStrings", "Edit"]], BaseStyle -> 
               "TextAnnotationButton"]]], 
            StyleBox[
             RowBox[{
               DynamicBox[
                FEPrivate`FrontEndResource[
                "DocumentationToolsStrings", "LastAnnotator"]], "pavel"}], 
             "TextAnnotator"], 
            Cell[
             BoxData[
              ButtonBox[
               DynamicBox[
                FEPrivate`FrontEndResource[
                "DocumentationToolsStrings", "Delete"]], BaseStyle -> 
               "TextAnnotationRemoveButton"]]], ""}}, 
          GridBoxAlignment -> {
           "Columns" -> {Left, Left, Right, Right}, "Rows" -> {{Automatic}}}, 
          GridBoxItemSize -> {"Columns" -> {
              Scaled[0.15], 
              Scaled[0.68], 
              Scaled[0.15], 
              Scaled[0.02]}}]]], "\n"}], "TextAnnotation", 
     CellSize -> {590, Inherited}]}},
 CellTags->"TextAnnotation",
 CellID->525779438,ExpressionUUID->"4037cc8c-e7e2-4298-bc98-6f1c77ac2052"],

Cell[TextData[{
 Cell[BoxData[
  FormBox["\[CapitalDelta]", TraditionalForm]], "InlineFormula",
  ExpressionUUID->"4f97f83a-964b-412f-9fdb-364e6884a8ef"],
 " is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CanonicalBeilinsonDrinfeldOperator"]], 
    "paclet:ChernSimons/ref/CanonicalBeilinsonDrinfeldOperator", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "0c770c3b-e12e-47af-819f-ded70c3e2af5"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"\[CenterDot]", ",", "\[CenterDot]"}], "}"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"6f910682-99df-4708-8773-08d2ada9155b"],
 " is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CanonicalBeilinsonDrinfeldBracket"]], 
    "paclet:ChernSimons/ref/CanonicalBeilinsonDrinfeldBracket", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "e3640ae3-6791-467a-8bb4-a0e5284d9747"],
 "."
}], "Notes",ExpressionUUID->"220cd454-e3d2-4e5e-b3fc-63fc3c5e5297"],

Cell[TextData[{
 "The solution is computed by Picard iteration: ",
 StyleBox["order", "TI"],
 " steps of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["a", "TI"], 
    RowBox[{"(", 
     StyleBox["t", "TI"], ")"}], "\[RightTeeArrow]", 
    StyleBox["a", "TI"], "-", 
    SubsuperscriptBox["\[Integral]", "0", 
     StyleBox["t", "TI"]], 
    RowBox[{"(", 
     RowBox[{"\[CapitalDelta]", 
      StyleBox["b", "TI"], "+", 
      RowBox[{"{", 
       RowBox[{
        StyleBox["a", "TI"], 
        RowBox[{"(", 
         StyleBox["s", "TI"], ")"}], ",", 
        StyleBox["b", "TI"]}], "}"}]}], ")"}], "\[DifferentialD]", 
    StyleBox["s", "TI"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "cd5474b9-bcfe-4db2-9a08-c0fa597d794f"],
 ", each truncated to degree at most ",
 StyleBox["order", "TI"],
 " in ",
 StyleBox["t", "TI"],
 "."
}], "Notes",ExpressionUUID->"3b7941ae-a881-41da-a916-9f04a2b47acb"],

Cell[TextData[{
 "After each step the words and products of total word length greater than ",
 StyleBox["n", "TI"],
 " are dropped, those of ",
 StyleBox["a", "TI"],
 " included."
}], "Notes",ExpressionUUID->"4bf45b0e-7d4e-43e5-b15b-1371416b6032"],

Cell[TextData[{
 "The equation holds to order ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["t", "TI"], 
    RowBox[{"order", "-", "1"}]], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"f059b4f9-68ac-4d3c-bcb9-de37ca6d52f8"],
 " and in general fails at ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["t", "TI"], "order"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"901c74b2-a3a3-47ab-bd5c-79eb5a47d3bb"],
 "."
}], "Notes",ExpressionUUID->"f48578d3-65f5-4398-bb56-1428c4d2fb28"],

Cell["\<\
Two BD actions are BD homotopic, equivalently their Maurer-Cartan elements \
are gauge equivalent, when such a flow connects them.\
\>", "Notes",ExpressionUUID->"ae4eb44a-245d-4a2b-9b90-deb81778069a"],

Cell[TextData[{
 "If ",
 StyleBox["a", "TI"],
 " solves the Maurer-Cartan equation, so does ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["a", "TI"], "(", 
    StyleBox["t", "TI"], ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"54f899f3-ff5e-4907-b0ae-7c711782c845"],
 ", up to the two truncations."
}], "Notes",ExpressionUUID->"d4a6c000-7ff3-456a-aa75-8c952c571f2f"],

Cell[TextData[{
 "The result is a BD action, which ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["MaurerCartanElement"]], 
    "paclet:ChernSimons/ref/MaurerCartanElement", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "9a1ffffe-8a88-47e3-85b7-5a50e7f6e5ce"],
 " splits into its parts."
}], "Notes",ExpressionUUID->"68650471-56f5-4a83-ae5f-cb06ff1a4cc9"],

Cell["\<\
On the circle the equation is the coefficient system of the paper's lemma on \
BD homotopies. That system is truncated by the indices of the coefficients \
rather than by word length, so the two agree only where neither truncation is \
active.\
\>", "Notes",ExpressionUUID->"9e7dc7f2-6501-433c-a3fa-db459d952ea4"],

Cell["A pairing in the exterior convention returns unevaluated.", "Notes",ExpressionUUID->"17e806aa-b35d-42bd-ac40-c2a704153321"],

