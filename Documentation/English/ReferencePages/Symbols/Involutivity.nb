Cell["And in the exterior picture:", "ExampleText",ExpressionUUID->"04ed597b-8441-4006-8b27-0feca941db15"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"exterior", " ", "=", " ", 
   RowBox[{"Append", "[", 
    RowBox[{
     RowBox[{"Pairing", "[", 
      RowBox[{
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"x", " ", "->", " ", 
          RowBox[{"-", "1"}]}], ",", " ", 
         RowBox[{"y", " ", "->", " ", "0"}]}], "|>"}], ",", " ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"x", ",", " ", "y"}], "}"}], " ", "->", " ", "1"}], 
        "|>"}]}], "]"}], ",", " ", 
     RowBox[{"\"\<Convention\>\"", " ", "->", " ", "\"\<Exterior\>\""}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{"Involutivity", "[", 
  RowBox[{
   RowBox[{"CyclicWord", "[", 
    RowBox[{"{", 
     RowBox[{"x", ",", " ", "y", ",", " ", "y", ",", " ", "y"}], "}"}], "]"}],
    ",", " ", "exterior"}], "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"fa1885dc-2317-43dc-8fbf-d2c0244e0fe7"],

Cell[BoxData["0"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"72b7fd50-1e55-4b78-8769-40f547a697b4"]
}, Open  ]]
}, Open  ]]
}, Open  ]],

