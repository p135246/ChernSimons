Cell["\<\
The identity holds on the shortest word with a nonzero co-bracket:\
\>", "ExampleText",ExpressionUUID->"3d0931f0-eda3-4e56-b088-4babfd8064df"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Involutivity", "[", 
  RowBox[{
   RowBox[{"CyclicWord", "[", 
    RowBox[{"{", 
     RowBox[{"x", ",", " ", "y", ",", " ", "y", ",", " ", "y"}], "}"}], "]"}],
    ",", " ", 
   RowBox[{"Pairing", "[", 
    RowBox[{
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"x", " ", "->", " ", 
        RowBox[{"-", "1"}]}], ",", " ", 
       RowBox[{"y", " ", "->", " ", "0"}]}], "|>"}], ",", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "y"}], "}"}], " ", "->", " ", "1"}], "|>"}]}], 
    "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"1754be1d-2ecf-497a-b04f-8271773cd3fa"],

Cell[BoxData["0"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"9429cabc-4c19-4123-8298-63688414bc7d"]
}, Open  ]],

