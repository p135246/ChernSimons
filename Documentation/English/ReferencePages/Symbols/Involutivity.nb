Notebook[{

Cell[CellGroupData[{
Cell["Involutivity", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"0a315c27-c466-41b6-b7e0-9bc5b7804641"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["Involutivity"]], "paclet:IBLInfinity/ref/Involutivity", 
     "IBLInfinity Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["w", "TI"], ",", " ", 
    StyleBox["pairing", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8b768a56-ea33-48a3-827a-caa3236424db"],
 "\[LineSeparator]",
 "gives the involutivity obstruction of a cyclic word; ",
 Cell[BoxData["0"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d15dbb35-0dff-4020-9149-72bad03afff4"],
 " means the identity holds there.",
 "\n"
}], "Usage",ExpressionUUID->"76fbd3b1-f43e-4cc0-bec9-5e74f5bc6734"],

Cell[TextData[{
 "The obstruction is the composite ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    OverscriptBox[
     StyleBox["q", "TI"], "^"], 
    RowBox[{"2", ",", "1", ",", "0"}]], "\[SmallCircle]", 
   SubscriptBox[
    OverscriptBox[
     StyleBox["q", "TI"], "^"], 
    RowBox[{"1", ",", "2", ",", "0"}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cfd7a054-f80f-4018-b56d-45521bc2547a"],
 " applied to ",
 StyleBox["w", "TI"],
 " \[LongDash] cut the word in two with ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Cobracket"]], "paclet:IBLInfinity/ref/Cobracket", 
    "IBLInfinity Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "cf2ef9b2-be89-4d5e-a684-aee00f1c6fef"],
 ", then bracket the two pieces back together. Its vanishing is the ",
 StyleBox["involutive", "TI"],
 " in involutive bi-Lie algebra, and it is the identity that fails for a \
general bi-Lie structure."
}], "Notes",ExpressionUUID->"9cca86f4-9667-4428-b5ac-2f03201d2c5b"],

Cell[TextData[{
 "The convention key of ",
 StyleBox["pairing", "TI"],
 " selects the picture."
}], "Notes",ExpressionUUID->"1abb200f-3a8a-4723-925a-f4aa5e08bb37"],

Cell["\<\
The composite lands back where it started, on a single cyclic word, so the \
obstruction is a word rather than a product.\
\>", "Notes",ExpressionUUID->"eda605d5-bcc0-48e7-ba04-43662166915b"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Involutivity"]], "paclet:IBLInfinity/ref/Involutivity", 
    "IBLInfinity Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "cb3a52ca-cff2-4db2-b98f-d56586ae63fb"],
 " is the arity-",
 Cell[BoxData["1"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cd2877de-04e0-489b-96c5-d0442cfbee41"],
 " entry of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["$Relations"]], "paclet:IBLInfinity/ref/$Relations", 
    "IBLInfinity Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "e6895798-f66c-4d1f-83c5-b4e3de8f57be"],
 "; ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RelationFailures"]], "paclet:IBLInfinity/ref/RelationFailures",
     "IBLInfinity Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "d2598706-3e17-4fb2-a2bf-44a68eadd360"],
 " sweeps it over an enumerated range of words."
}], "Notes",ExpressionUUID->"198bb88b-3dac-4c17-8f57-9ef738eedc43"],

Cell[TextData[{
 "Words with vanishing ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Cobracket"]], "paclet:IBLInfinity/ref/Cobracket", 
    "IBLInfinity Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "3bf992fb-e49b-4742-829a-0947cd1d822a"],
 " have vanishing obstruction for trivial reasons; over the alphabet of the \
circle the first informative test is at length ",
 Cell[BoxData["4"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cdecfb35-a8ac-4d7b-8466-46ef26140d0b"],
 "."
}], "Notes",ExpressionUUID->"03b97594-2ac8-48e7-8e81-29167a383422"]
}, Open  ]],

