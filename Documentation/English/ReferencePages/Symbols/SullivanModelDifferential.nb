     "ChernSimons Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["e", "TI"], ",", " ", 
    StyleBox["model", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "75dd6e25-a097-454d-a645-53c64098b715"],
 "\[LineSeparator]",
 "gives the differential of the Sullivan model ",
 StyleBox["model", "TI"],
 " applied to the element ",
 StyleBox["e", "TI"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"7476e62a-be11-40ee-9a02-3b620ad3dd50"],

Cell[TextData[{
 "The differential is given on the generators and extended as a derivation of \
degree ",
 Cell[BoxData[
  FormBox["1", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "0bc2c9f1-f8d6-4c3f-9ca1-048a6a2d0dca"],
 ":"
}], "Notes",
 CellFrameLabels->{{Inherited, Inherited}, {Inherited, 
    Cell[
     TextData[{
      "26.09.30: Design review - the model stores the differential on the \
generators only, the data a reader writes down, and this function extends it \
as a derivation with the Koszul signs of the declared order of the \
generators, each term a SullivanModelProduct, so that the truncations are \
applied. SullivanModel checks through this function that the differential \
squares to zero. Alternative name considered: ModelDifferential, the name \
until 2026-09-21, renamed because \"Model\" alone is generic. Prior art: the \
Wolfram Language has no differential graded algebras; the built-in D is a \
derivation of degree 0, with no signs. The engine the verification suites \
load extends the differential in the same way on monomials given as lists of \
generators, and the suites pin this function against it on every monomial of \
degree at most n+2 of the catalogue and of Kodaira-Thurston.", "\n\n", 
       Cell[
        BoxData[
         GridBox[{{
            Cell[
             BoxData[
              ButtonBox[
               DynamicBox[
                FEPrivate`FrontEndResource[
                "DocumentationToolsStrings", "Edit"]], BaseStyle -> 
               "TextAnnotationButton"]]], 
            StyleBox[
             RowBox[{
               DynamicBox[
                FEPrivate`FrontEndResource[
                "DocumentationToolsStrings", "LastAnnotator"]], "pavel"}], 
             "TextAnnotator"], 
            Cell[
             BoxData[
              ButtonBox[
               DynamicBox[
                FEPrivate`FrontEndResource[
                "DocumentationToolsStrings", "Delete"]], BaseStyle -> 
               "TextAnnotationRemoveButton"]]], ""}}, 
          GridBoxAlignment -> {
           "Columns" -> {Left, Left, Right, Right}, "Rows" -> {{Automatic}}}, 
          GridBoxItemSize -> {"Columns" -> {
              Scaled[0.15], 
              Scaled[0.68], 
              Scaled[0.15], 
              Scaled[0.02]}}]]], "\n"}], "TextAnnotation", 
     CellSize -> {590, Inherited}]}},
 CellTags->"TextAnnotation",
 CellID->369318285,ExpressionUUID->"8ef27554-39a9-41c8-af65-ec24f0618911"],

Cell[BoxData[
 PaneBox[
  FormBox[
   RowBox[{
    StyleBox["d",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox[
       StyleBox["g", "TI"], "1"], "\[CenterEllipsis]", 
      SubscriptBox[
       StyleBox["g", "TI"], 
       StyleBox["k", "TI"]]}], ")"}], "\[LongEqual]", 
    UnderscriptBox["\[Sum]", 
     StyleBox["i", "TI"],
     LimitsPositioning->True], 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"-", "1"}], ")"}], 
     TemplateBox[{
       RowBox[{
         SubscriptBox[
          StyleBox["g", "TI"], "1"], "|", "+", "\[Ellipsis]", "+", "|", 
         SubscriptBox[
          StyleBox["g", "TI"], 
          RowBox[{
            StyleBox["i", "TI"], "-", "1"}]]}]},
      "Abs"]], " ", 
    SubscriptBox[
     StyleBox["g", "TI"], "1"], "\[CenterEllipsis]", 
    StyleBox["d",
     FontSlant->"Plain"], 
    SubscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["i", "TI"]], "\[CenterEllipsis]", 
    SubscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["k", "TI"]], "."}],
   TraditionalForm],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",ExpressionUUID->"26bd8db8-4542-4cec-\
8bcd-e002a1eeadcd"],

Cell["It is linear, and it squares to zero.", "Notes",ExpressionUUID->"2a3805ca-4bc7-43c6-aa6f-9675d6ac9842"],

Cell[TextData[{
 "In a truncated model a term whose monomial lies above the truncation is ",
 Cell[BoxData[
  FormBox["0", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "f8e7ea64-c523-46eb-bb66-98851b963eb0"],
 "."
}], "Notes",ExpressionUUID->"68c3c22f-44fa-4288-9996-281c5a705148"],

