}], "Usage",ExpressionUUID->"94f109da-70bd-4085-8c75-5ee91615c756"],

Cell[TextData[{
 "The differential is given on the generators and extended as a derivation of \
degree ",
 Cell[BoxData[
  FormBox["1", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dd1ceb8e-6b6a-4411-ba7c-7431977d9b9a"],
 ":"
}], "Notes",ExpressionUUID->"cc1cd08c-d5e5-4cc5-987b-927008ba48ab"],

Cell[BoxData[
 PaneBox[
  FormBox[
   RowBox[{
    StyleBox["d",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox[
       StyleBox["g", "TI"], "1"], "\[CenterEllipsis]", 
      SubscriptBox[
       StyleBox["g", "TI"], 
       StyleBox["k", "TI"]]}], ")"}], "\[LongEqual]", 
    UnderscriptBox["\[Sum]", 
     StyleBox["i", "TI"],
     LimitsPositioning->True], 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"-", "1"}], ")"}], 
     TemplateBox[{
       RowBox[{
         SubscriptBox[
          StyleBox["g", "TI"], "1"], "|", "+", "\[Ellipsis]", "+", "|", 
         SubscriptBox[
          StyleBox["g", "TI"], 
          RowBox[{
            StyleBox["i", "TI"], "-", "1"}]]}]},
      "Abs"]], " ", 
    SubscriptBox[
     StyleBox["g", "TI"], "1"], "\[CenterEllipsis]", 
    StyleBox["d",
     FontSlant->"Plain"], 
    SubscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["i", "TI"]], "\[CenterEllipsis]", 
    SubscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["k", "TI"]], "."}],
   TraditionalForm],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",ExpressionUUID->"46a703bf-dd79-4180-\
b40c-74669fb06ec6"],

Cell["\<\
It is linear, it squares to zero, and it is zero into a degree above the \
model's truncation.\
\>", "Notes",ExpressionUUID->"71837e8b-26f3-496c-ac58-f75bf1db721a"]
}, Open  ]],

