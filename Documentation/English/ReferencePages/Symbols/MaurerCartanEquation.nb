      RowBox[{
      "x", "\[ThinSpace]", "x", "\[ThinSpace]", "y", "\[ThinSpace]", "x", "\[ThinSpace]",
        "y", "\[ThinSpace]", "y"}], ")"}],
     ChernSimons`CyclicWord[{
      MTNB$1jv0izlut6bhl`x, MTNB$1jv0izlut6bhl`x, MTNB$1jv0izlut6bhl`y, 
