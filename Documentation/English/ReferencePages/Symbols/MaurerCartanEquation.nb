Cell[CellGroupData[{
Cell["MaurerCartanEquation", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"cc456a7c-78c3-4456-a0e7-811bc339a77d"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["MaurerCartanEquation"]], 
     "paclet:ChernSimons/ref/MaurerCartanEquation", 
     "ChernSimons Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["s", "TI"], ",", " ", 
    StyleBox["pairing", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d608a996-622e-40c9-bde5-035a55b05963"],
 "\[LineSeparator]",
 "gives the obstruction of the Maurer-Cartan equation for the element whose \
BD action is ",
 StyleBox["s", "TI"],
 "; ",
 Cell[BoxData[
  FormBox["0", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d579d561-e820-4338-8b68-c56c440d55aa"],
 " means it is a Maurer-Cartan element.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"16414912-e51b-45d2-8a63-031829c7ceab"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["MaurerCartanEquation"]], 
     "paclet:ChernSimons/ref/MaurerCartanEquation", 
     "ChernSimons Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["s", "TI"], ",", " ", 
    StyleBox["pairing", "TI"], ",", " ", "\"\<Equations\>\""}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d0d4c532-f3f4-461d-a30e-fd8ab004d5a5"],
 "\[LineSeparator]",
 "gives the Association of scalar equations on the coefficients of ",
 StyleBox["s", "TI"],
 "."
}], "Usage",ExpressionUUID->"f8c0cfdc-049e-4317-8701-d2f5b7138a54"],

Cell[TextData[{
 "The same function as ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["BeilinsonDrinfeldMasterEquation"]], 
    "paclet:ChernSimons/ref/BeilinsonDrinfeldMasterEquation", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "e33ee5a1-fa95-428c-8fb1-40fcec963ca2"],
 ": the coefficient of the BD master equation in ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["S",
      FontSlant->"Plain"], "\[ScriptL]"], 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       StyleBox["C", "TI"], 
       RowBox[{"[", "1", "]"}]}], ")"}], 
     StyleBox["g", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "788d919c-ba04-471b-b18a-5a5208624fb3"],
 " is exactly the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"\[ScriptL]", ",", 
     StyleBox["g", "TI"]}], ")"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2657c9f4-165e-4a7e-8ee6-b9c2a45f55d3"],
 " Maurer-Cartan equation, so the two names name one computation seen from \
two sides."
}], "Notes",ExpressionUUID->"dd75e071-8905-4083-b3b7-eade56c94cd1"],

Cell[TextData[{
 "The recipe that produces a Maurer-Cartan element from a geometry \
\[LongDash] ribbon graphs, their combinatorial coefficients, the \
configuration-space integrals and the signs \[LongDash] is ",
 StyleBox["not",
  FontWeight->"Bold"],
 " implemented. An element is supplied, either written out or as a ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["MaurerCartanAnsatz"]], 
    "paclet:ChernSimons/ref/MaurerCartanAnsatz", "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "74c225cf-1f7c-4e00-9836-e6f0d5b3a187"],
 " over ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["MaurerCartanBasis"]], 
    "paclet:ChernSimons/ref/MaurerCartanBasis", "ChernSimons Package Symbol"},
   
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "e31de43d-91ea-4845-8ec7-3511d37e2523"],
 "."
}], "Notes",ExpressionUUID->"59413f2a-51c7-4197-bbbd-79f60e2459f7"]
}, Open  ]],

