Cell["\<\
Nothing here is the circle's \[LongDash] a three-letter alphabet works the \
same way:\
\>", "ExampleText",ExpressionUUID->"c95d5432-4107-47f6-b775-0b3d5005836a"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"three", " ", "=", " ", 
   RowBox[{"GradedPairing", "[", 
    RowBox[{
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"p", " ", "->", " ", 
        RowBox[{"-", "1"}]}], ",", " ", 
       RowBox[{"q", " ", "->", " ", "0"}], ",", " ", 
       RowBox[{"r", " ", "->", " ", 
        RowBox[{"-", "1"}]}]}], "|>"}], ",", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{"p", ",", " ", "q"}], "}"}], " ", "->", " ", "1"}], ",", " ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"r", ",", " ", "q"}], "}"}], " ", "->", " ", "1"}]}], 
      "|>"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"MaurerCartanEquation", "[", 
    RowBox[{
     RowBox[{"CyclicWord", "[", 
      RowBox[{"{", 
       RowBox[{"p", ",", " ", "p", ",", " ", "q"}], "}"}], "]"}], ",", " ", 
     "three"}], "]"}], ",", " ", 
   RowBox[{"MaurerCartanEquation", "[", 
    RowBox[{
     RowBox[{"CyclicWord", "[", 
      RowBox[{"{", 
