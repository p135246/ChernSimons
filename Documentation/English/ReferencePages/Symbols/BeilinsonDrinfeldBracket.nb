Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"pairing", " ", "=", " ", 
   RowBox[{"GradedPairing", "[", 
    RowBox[{
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"x", " ", "->", " ", 
        RowBox[{"-", "1"}]}], ",", " ", 
       RowBox[{"y", " ", "->", " ", "0"}]}], "|>"}], ",", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "y"}], "}"}], " ", "->", " ", "1"}], "|>"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"u", " ", "=", " ", 
      RowBox[{"CyclicWord", "[", 
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "y", ",", " ", "y", ",", " ", "y"}], "}"}], 
       "]"}]}], ",", " ", 
     RowBox[{"v", " ", "=", " ", 
      RowBox[{"CyclicWord", "[", 
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "y"}], "}"}], "]"}]}]}], "}"}], ",", "\n", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"s", " ", "=", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"-", "1"}], ")"}], "^", 
        RowBox[{"WordDegree", "[", 
         RowBox[{"u", ",", " ", "pairing", ",", " ", "\"\<Symmetric\>\""}], 
         "]"}]}]}], "}"}], ",", "\n", "  ", 
     RowBox[{"Expand", "[", 
      RowBox[{
       RowBox[{"BeilinsonDrinfeldOperator", "[", 
        RowBox[{
         RowBox[{"SymmetricProduct", "[", 
          RowBox[{"u", ",", " ", "v", ",", " ", "pairing"}], "]"}], ",", " ", 
         "pairing"}], "]"}], " ", "-", " ", 
       RowBox[{"SymmetricProduct", "[", 
        RowBox[{
         RowBox[{"BeilinsonDrinfeldOperator", "[", 
          RowBox[{"u", ",", " ", "pairing"}], "]"}], ",", " ", "v", ",", " ", 
         "pairing"}], "]"}], " ", "-", " ", 
       RowBox[{"s", " ", 
        RowBox[{"SymmetricProduct", "[", 
         RowBox[{"u", ",", " ", 
          RowBox[{"BeilinsonDrinfeldOperator", "[", 
           RowBox[{"v", ",", " ", "pairing"}], "]"}], ",", " ", "pairing"}], 
         "]"}]}], " ", "-", " ", 
       RowBox[{"s", " ", "HBar", " ", 
        RowBox[{"BeilinsonDrinfeldBracket", "[", 
         RowBox[{"u", ",", " ", "v", ",", " ", "pairing"}], "]"}]}]}], 
      "]"}]}], "]"}]}], "]"}]}], "Input",
