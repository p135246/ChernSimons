Cell[TextData[{
 "The bracket of the BD axiom satisfied by ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["BeilinsonDrinfeldOperator"]], 
    "paclet:ChernSimons/ref/BeilinsonDrinfeldOperator", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "fbed86a4-4449-4ff6-89d4-29e7b42534d0"],
 ". It is already present on the symmetric powers of cyclic words before ",
 Cell[BoxData[
  FormBox["\[Null]", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "aa288f70-d2e4-4209-8a36-bb59e2e5e2aa"],
 " is adjoined, and carries no ",
 Cell[BoxData[
  FormBox["\[Null]", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7d571fdf-88a4-41a3-b34c-887e9aeb21b2"],
 " itself: it is ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["q", "TI"], 
    RowBox[{"2", ",", "1", ",", "0"}]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "eaf76548-f35a-4f9d-b7b3-dcc55e737df0"],
 " inserted into ",
 StyleBox["f", "TI"],
 ", with the sign of the symmetric degree of ",
 StyleBox["f", "TI"],
 "."
}], "Notes",ExpressionUUID->"b23c6fad-3dac-405a-b212-929aeda563a3"],

Cell[TextData[{
 "The derived bracket of ",
 Cell[BoxData[
  FormBox["\[CapitalDelta]", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8ca31983-8214-41fe-aba3-366f4a716a24"],
 " \[LongDash] the failure of ",
 Cell[BoxData[
  FormBox["\[CapitalDelta]", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "26abb5cc-4c0e-477f-8cdb-9dfd8a37d226"],
 " to be a derivation \[LongDash] is ",
 Cell[BoxData[
  FormBox["\[Null]", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d1b5c64a-a1bd-4b7e-a56b-37f873ed75f0"],
 " times this one. That derived bracket is the BV bracket of the localization \
at ",
 Cell[BoxData[
  FormBox["\[Null]", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b4b6c297-7e9b-4cdb-a7e9-f99b2f297988"],
 ", and is what the engine calls ",
 Cell[BoxData["bvBracket"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bb444f5b-9f16-47e7-b033-031e003e29f9"],
 ". Confusing the two is a factor of ",
 Cell[BoxData[
  FormBox["\[Null]", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "96e04a20-87b8-4e94-8da0-eb6e9266da38"],
 " in every formula, so the distinction is worth keeping."
}], "Notes",ExpressionUUID->"60502c83-be66-4759-a163-523a5d1fe01c"]
}, Open  ]],

