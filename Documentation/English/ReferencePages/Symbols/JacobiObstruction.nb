Cell["\<\
Sweeping it over an enumerated range of words, every value is zero:\
\>", "ExampleText",ExpressionUUID->"5df824c8-bb2f-4d96-acd5-ae43d62404fc"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"words", "[", "n_", "]"}], " ", ":=", " ", 
   RowBox[{"CyclicWords", "[", 
    RowBox[{"n", ",", " ", 
     RowBox[{"GradedPairing", "[", 
      RowBox[{
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"x", " ", "->", " ", 
          RowBox[{"-", "1"}]}], ",", " ", 
         RowBox[{"y", " ", "->", " ", "0"}]}], "|>"}], ",", " ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"x", ",", " ", "y"}], "}"}], " ", "->", " ", "1"}], 
        "|>"}]}], "]"}], ",", " ", 
     RowBox[{"\"\<UpTo\>\"", " ", "->", " ", "True"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"DeleteDuplicates", "[", 
  RowBox[{"Map", "[", 
   RowBox[{
    RowBox[{"t", " ", "|->", " ", 
     RowBox[{"Expand", "[", 
      RowBox[{"JacobiObstruction", "[", 
       RowBox[{
        RowBox[{"t", "[", 
         RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
        RowBox[{"t", "[", 
         RowBox[{"[", "2", "]"}], "]"}], ",", " ", 
        RowBox[{"t", "[", 
         RowBox[{"[", "3", "]"}], "]"}], ",", " ", 
        RowBox[{"GradedPairing", "[", 
         RowBox[{
          RowBox[{"<|", 
           RowBox[{
            RowBox[{"x", " ", "->", " ", 
             RowBox[{"-", "1"}]}], ",", " ", 
            RowBox[{"y", " ", "->", " ", "0"}]}], "|>"}], ",", " ", 
          RowBox[{"<|", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"x", ",", " ", "y"}], "}"}], " ", "->", " ", "1"}], 
           "|>"}]}], "]"}]}], "]"}], "]"}]}], ",", " ", 
    RowBox[{"Tuples", "[", 
     RowBox[{
      RowBox[{"words", "[", "3", "]"}], ",", " ", "3"}], "]"}]}], "]"}], 
  "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"68e33f50-01a0-408d-9f16-8ddcd88fb616"],

Cell[BoxData[
 RowBox[{"{", "0", "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"cc696f64-5f56-4247-b6a9-98827da131dc"]
}, Open  ]],

