Cell["And in the exterior picture:", "ExampleText",ExpressionUUID->"45987ba0-9769-4666-88ad-2184f856a402"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"exterior", " ", "=", " ", 
   RowBox[{"Append", "[", 
    RowBox[{
     RowBox[{"GradedPairing", "[", 
      RowBox[{
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"x", " ", "->", " ", 
          RowBox[{"-", "1"}]}], ",", " ", 
         RowBox[{"y", " ", "->", " ", "0"}]}], "|>"}], ",", " ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"x", ",", " ", "y"}], "}"}], " ", "->", " ", "1"}], 
        "|>"}]}], "]"}], ",", " ", 
     RowBox[{"\"\<Convention\>\"", " ", "->", " ", "\"\<Exterior\>\""}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{"JacobiObstruction", "[", 
  RowBox[{
   RowBox[{"CyclicWord", "[", 
    RowBox[{"{", "x", "}"}], "]"}], ",", " ", 
   RowBox[{"CyclicWord", "[", 
    RowBox[{"{", 
     RowBox[{"x", ",", " ", "y"}], "}"}], "]"}], ",", " ", 
   RowBox[{"CyclicWord", "[", 
    RowBox[{"{", 
     RowBox[{"y", ",", " ", "y"}], "}"}], "]"}], ",", " ", "exterior"}], 
  "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"92184b41-9d6f-42a4-95eb-cb15830a150f"],

Cell[BoxData["0"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"d7a3e10e-edfa-450a-a428-8cf4698b49fd"]
