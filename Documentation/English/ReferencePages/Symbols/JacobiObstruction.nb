Cell[CellGroupData[{
Cell["JacobiObstruction", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"49bfd210-e9e4-40cb-b265-0e12b48c33e8"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["JacobiObstruction"]], 
     "paclet:ChernSimons/ref/JacobiObstruction", "ChernSimons Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["u", "TI"], ",", " ", 
    StyleBox["v", "TI"], ",", " ", 
    StyleBox["w", "TI"], ",", " ", 
    StyleBox["pairing", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9fa88a85-ac15-47df-a86b-9e005a06e498"],
 "\[LineSeparator]",
 "gives the Jacobi obstruction of three cyclic words; ",
 Cell[BoxData[
  FormBox["0", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d0f145b0-91fb-47f2-8396-8c1b18a4bbc4"],
 " means the identity holds there.",
 "\n"
}], "Usage",ExpressionUUID->"4d83e852-4f76-4256-a326-4d087ccc874f"],

Cell[TextData[{
 "The obstruction is the composite ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     OverscriptBox[
      StyleBox["q", "TI"], "^"], 
     RowBox[{"2", ",", "1", ",", "0"}]], "\[EmptySmallCircle]", 
    SubscriptBox[
     OverscriptBox[
      StyleBox["q", "TI"], "^"], 
     RowBox[{"2", ",", "1", ",", "0"}]]}], TraditionalForm]], "InlineFormula",
  
  FontSize->0.9 Inherited,ExpressionUUID->
  "dc015c4e-632f-435f-a0f4-a80af8e26759"],
 " applied to the product ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["u", "TI"], "\[CircleDot]", 
    StyleBox["v", "TI"], "\[CircleDot]", 
    StyleBox["w", "TI"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0699f673-6306-40d5-9ca8-3a227d8486a5"],
 " \[LongDash] the graded Jacobi identity written as the statement that the \
derivation extension of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InvolutiveBracket"]], 
    "paclet:ChernSimons/ref/InvolutiveBracket", "ChernSimons Package Symbol"},
   
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "f6911d9a-fa00-4362-9fab-ef3e69ac7cc4"],
 " squares to zero."
}], "Notes",ExpressionUUID->"86294ca9-bd26-46a5-bd8e-9f86cc9f22b4"],

Cell[TextData[{
 "The convention key of ",
 StyleBox["pairing", "TI"],
 " selects the picture, exactly as it does for ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InvolutiveBracket"]], 
    "paclet:ChernSimons/ref/InvolutiveBracket", "ChernSimons Package Symbol"},
   
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "32febf67-b7b5-4cb1-a86a-bb1942021bae"],
 "."
}], "Notes",ExpressionUUID->"6624e734-7e1d-4f0a-8f81-e8792423e04a"],

Cell["\<\
A nonzero value is a counterexample to the identity for that pairing, not a \
bug in the input: the identity is a property of the pairing, and this \
function is how it is tested.\
\>", "Notes",ExpressionUUID->"21278a82-d401-4e81-ae22-ef9ec638e657"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["JacobiObstruction"]], 
    "paclet:ChernSimons/ref/JacobiObstruction", "ChernSimons Package Symbol"},
   
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "49ea30a7-9734-4eec-961e-5f04afcfbd18"],
 " is the arity-",
 Cell[BoxData[
  FormBox["3", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "869920c4-9867-434a-84ce-668a8cce9b18"],
