Cell[TextData[{
 "The model ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalLambda]", "(", 
    RowBox[{
     StyleBox["v", "TI"], ",", 
     StyleBox["w", "TI"], ",", 
     StyleBox["z", "TI"]}], ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"af907f5c-0dba-435f-9b03-09078a30dc7c"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{"|", 
    StyleBox["v", "TI"], "|", "\[LongEqual]", "2"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"0b8aa737-37eb-49b8-8f15-5069675a12e1"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["d",
     FontSlant->"Plain"], 
