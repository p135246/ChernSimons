Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"PoincareDualityQ", "[", 
  RowBox[{"SullivanModel", "[", 
   RowBox[{
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"v1", " ", "->", " ", "1"}], ",", " ", 
