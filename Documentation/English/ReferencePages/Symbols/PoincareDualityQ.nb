   RowBox[{
    StyleBox["n", "TI"], "+", "1"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"f42e4b6a-1d89-42c3-be68-5d28d845f2a6"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"4cee9ec3-4083-49c0-a9d7-1b245a1f2363"],
 Cell[BoxData[
  RowBox[{
