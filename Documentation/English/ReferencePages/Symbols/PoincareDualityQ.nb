    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["complex", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e4c3b7a2-e295-4977-b7c8-0901e866b1f7"],
 "\[LineSeparator]",
 "tests whether the pairing of the ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CochainComplexWithPairing"]], 
    "paclet:ChernSimons/ref/CochainComplexWithPairing", 
