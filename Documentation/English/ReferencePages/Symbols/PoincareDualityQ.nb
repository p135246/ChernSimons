   RowBox[{
    StyleBox["n", "TI"], "+", "1"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "374c86a1-2629-4bfc-87cf-ec3715e9414e"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"39501e7b-446b-4217-888a-0cd4441af0ce"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
