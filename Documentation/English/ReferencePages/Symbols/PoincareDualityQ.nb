Cell[TextData[{
 "The torus ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["T", "TI"], "2"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c102e756-c058-4f5e-a05f-bc6bc232bb92"],
