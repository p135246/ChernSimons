Cell[TextData[{
 "The pairing ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{
      StyleBox["v", "TI"], ",", 
      StyleBox["w", "TI"]}], "\[RightAngleBracket]"}], "\[LongEqual]", 
    StyleBox["O", "TI"], 
    RowBox[{"(", 
     StyleBox[
      RowBox[{"v", "w"}], "TI"], ")"}]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"03842e30-9306-4d48-9dda-34ca00c16b29"],
 " vanishes when one of ",
 Cell[BoxData[
  FormBox[
   StyleBox["v", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "c1cc3d26-4b02-4f73-af5b-b02b8e3f15c5"],
 ", ",
 Cell[BoxData[
  FormBox[
   StyleBox["w", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "cd2cdb47-b78c-454a-8d23-4f05a979e573"],
 " is a boundary and the other a cocycle, so it descends to cohomology."
}], "Notes",
 CellFrameLabels->{{Inherited, Inherited}, {Inherited, 
    Cell[
     TextData[{
      "26.09.30: Design review - the predicate answers the hypothesis under \
which HodgeTypeQ decides Hodge type, and HodgeTypeQ is guarded by it (H2, \
2026-09-24). On a model it computes the cohomology degree by degree, and an \
untruncated model with a generator of even degree is infinite-dimensional, so \
the test stops at a degree: n+1 by default, with the option \"MaxDegree\" as \
in HodgeTypeQ. Since R7 (Pavel, 2026-10-01) a value below n returns \
unevaluated, since duality needs every degree from 0 to n; before, it was \
read as n and changed nothing. Beyond that degree it cannot see, which the \
page shows on the model with generators of degrees 2, 3 and 6 (H1, \
2026-09-24). On a complex, which is finite-dimensional, it checks every \
degree, is exact and takes no option. Prior art: the Wolfram Language has no \
cohomology of cochain complexes; the cocycles, the boundaries and the rank of \
the pairing on them are NullSpace and MatrixRank computations. The engine the \
verification suites load has no Poincar\[EAcute] duality test; the suites pin \
this predicate over the catalogue, all of whose models are oriented PDGAs, \
and on T^2 oriented in degree 1, which is not.", "\n\n", 
       Cell[
        BoxData[
         GridBox[{{
            Cell[
             BoxData[
              ButtonBox[
               DynamicBox[
                FEPrivate`FrontEndResource[
                "DocumentationToolsStrings", "Edit"]], BaseStyle -> 
               "TextAnnotationButton"]]], 
            StyleBox[
             RowBox[{
               DynamicBox[
                FEPrivate`FrontEndResource[
                "DocumentationToolsStrings", "LastAnnotator"]], "pavel"}], 
             "TextAnnotator"], 
            Cell[
             BoxData[
              ButtonBox[
               DynamicBox[
                FEPrivate`FrontEndResource[
                "DocumentationToolsStrings", "Delete"]], BaseStyle -> 
               "TextAnnotationRemoveButton"]]], ""}}, 
          GridBoxAlignment -> {
           "Columns" -> {Left, Left, Right, Right}, "Rows" -> {{Automatic}}}, 
          GridBoxItemSize -> {"Columns" -> {
              Scaled[0.15], 
              Scaled[0.68], 
              Scaled[0.15], 
              Scaled[0.02]}}]]], "\n"}], "TextAnnotation", 
     CellSize -> {590, Inherited}]}},
 CellTags->"TextAnnotation",
 CellID->864109797,ExpressionUUID->"60a16d66-186c-4da6-879f-74bb60bcd608"],

Cell[TextData[{
 "A model of degree ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "a177fe79-4ce4-4767-b719-788bf84fcd53"],
 " is an oriented PDGA when the pairing ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["H", "TI"], 
     StyleBox["k", "TI"]], "\[Cross]", 
    SuperscriptBox[
     StyleBox["H", "TI"], 
     RowBox[{
      StyleBox["n", "TI"], "-", 
      StyleBox["k", "TI"]}]], "\[Rule]", 
    StyleBox["K",
     FontSlant->"Plain"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "bac24b83-d3c1-4254-9df9-7d88b71f4d02"],
 " is nondegenerate for ",
 Cell[BoxData[
  FormBox[
   RowBox[{"0", "\[LessEqual]", 
    StyleBox["k", "TI"], "\[LessEqual]", 
    StyleBox["n", "TI"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "8d83eac2-768b-48c3-aa57-c826a914cf57"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["H", "TI"], 
     StyleBox["k", "TI"]], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"66e58dd9-5842-4716-9b01-3313f3cf9ff7"],
 " for ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["k", "TI"], ">", 
    StyleBox["n", "TI"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "db75270a-6baa-451e-8d62-60ddd8d317b6"],
 "."
}], "Notes",ExpressionUUID->"87342389-67ef-4e9d-83eb-1dba90c51580"],

Cell[TextData[{
 "For a model the test runs in the degrees ",
 Cell[BoxData[
  FormBox["0", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "daa77710-1fc1-4017-a664-d0330de91344"],
 " to ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["n", "TI"], "+", "1"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"0d509364-6c24-4de1-9536-b237bd7d8bdf"],
 " by default and does not look further up."
}], "Notes",ExpressionUUID->"4e736b76-58be-4e35-8033-e01513f7a55f"],

Cell["\<\
For a complex every degree is checked, and the test is exact. The complex \
form takes no option.\
\>", "Notes",ExpressionUUID->"0428bc96-3518-40ec-9367-e8073e5ae52f"],

