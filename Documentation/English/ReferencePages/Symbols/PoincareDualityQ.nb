Cell[TextData[{
 "The model ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalLambda]", "(", 
    RowBox[{
     StyleBox["v", "TI"], ",", 
     StyleBox["w", "TI"], ",", 
     StyleBox["z", "TI"]}], ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"18e240c6-3144-489d-ab60-0f3635f96d38"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{"|", 
    StyleBox["v", "TI"], "|", "\[LongEqual]", "2"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"93e46ce5-0e28-4270-bc8a-1c8f6a88bbef"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["d",
     FontSlant->"Plain"], 
