 " induces on cohomology is perfect, checking the degrees ",
 Cell[BoxData[
  FormBox["0", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "0e4a5c98-4293-4f80-893e-55d04679bb36"],
 " to ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["n", "TI"], "+", "1"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"172ca82f-4da8-4fdb-aa2c-b028bfb8fca3"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"50c7f2cd-52ad-46e0-9cfe-1131f52518f4"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
