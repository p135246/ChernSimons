  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["w", "TI"], "1"], " ", 
    StyleBox["x", "TI"], 
    StyleBox["y", "TI"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f6d8c286-fcff-4662-bb0a-b96d1830b6a4"],
 ":"
}], "ExampleText",ExpressionUUID->"8050a833-37d2-4b63-9854-a6538cc07c5c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"flow", " ", "=", " ", 
  RowBox[{"StringBeilinsonDrinfeldHomotopy", "[", 
   RowBox[{
    RowBox[{"c01", " ", 
     RowBox[{"CyclicWord", "[", 
      RowBox[{"{", 
       RowBox[{"x", ",", " ", "x", ",", " ", "y"}], "}"}], "]"}]}], ",", " ", 
    
    RowBox[{"w1", " ", 
     RowBox[{"CyclicWord", "[", 
      RowBox[{"{", 
       RowBox[{"x", ",", " ", "y"}], "}"}], "]"}]}], ",", " ", 
    RowBox[{"GradedPairing", "[", 
     RowBox[{
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"x", " ", "->", " ", 
         RowBox[{"-", "1"}]}], ",", " ", 
        RowBox[{"y", " ", "->", " ", "0"}]}], "|>"}], ",", " ", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"x", ",", " ", "y"}], "}"}], " ", "->", " ", "1"}], "|>"}]}],
      "]"}], ",", " ", "4", ",", " ", "t", ",", " ", "3"}], "]"}]}]], "Input",\

 CellLabel->"In[1]:= ",ExpressionUUID->"48c0d156-452f-4b49-b4a8-05189fd5a947"],

Cell[BoxData[
 RowBox[{
  RowBox[{"c01", " ", 
   InterpretationBox[
    RowBox[{"(", 
     RowBox[{"x", "\[ThinSpace]", "x", "\[ThinSpace]", "y"}], ")"}],
    ChernSimons`CyclicWord[{
     MTNB$1uzoeff775r7r`x, MTNB$1uzoeff775r7r`x, MTNB$1uzoeff775r7r`y}],
    Editable->False]}], "-", 
  RowBox[{"c01", " ", "t", " ", "w1", " ", 
   InterpretationBox[
    RowBox[{"(", 
     RowBox[{"x", "\[ThinSpace]", "x", "\[ThinSpace]", "y"}], ")"}],
    ChernSimons`CyclicWord[{
     MTNB$1uzoeff775r7r`x, MTNB$1uzoeff775r7r`x, MTNB$1uzoeff775r7r`y}],
    Editable->False]}], "+", 
  RowBox[{
   FractionBox["1", "2"], " ", "c01", " ", 
   SuperscriptBox["t", "2"], " ", 
   SuperscriptBox["w1", "2"], " ", 
   InterpretationBox[
    RowBox[{"(", 
     RowBox[{"x", "\[ThinSpace]", "x", "\[ThinSpace]", "y"}], ")"}],
    ChernSimons`CyclicWord[{
     MTNB$1uzoeff775r7r`x, MTNB$1uzoeff775r7r`x, MTNB$1uzoeff775r7r`y}],
    Editable->False]}], "-", 
  RowBox[{
   FractionBox["1", "6"], " ", "c01", " ", 
   SuperscriptBox["t", "3"], " ", 
   SuperscriptBox["w1", "3"], " ", 
   InterpretationBox[
    RowBox[{"(", 
     RowBox[{"x", "\[ThinSpace]", "x", "\[ThinSpace]", "y"}], ")"}],
    ChernSimons`CyclicWord[{
     MTNB$1uzoeff775r7r`x, MTNB$1uzoeff775r7r`x, MTNB$1uzoeff775r7r`y}],
    Editable->False]}]}]], "Output",
