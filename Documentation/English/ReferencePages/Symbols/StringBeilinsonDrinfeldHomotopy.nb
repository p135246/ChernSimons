Cell[CellGroupData[{
Cell["StringBeilinsonDrinfeldHomotopy", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"98b22b17-fbbe-4a45-8bee-93a30ad988d5"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["StringBeilinsonDrinfeldHomotopy"]], 
     "paclet:ChernSimons/ref/StringBeilinsonDrinfeldHomotopy", 
     "ChernSimons Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["a", "TI"], ",", " ", 
    StyleBox["b", "TI"], ",", " ", 
    StyleBox["pairing", "TI"], ",", " ", 
    StyleBox["n", "TI"], ",", " ", 
    StyleBox["t", "TI"], ",", " ", 
    StyleBox["order", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b997d319-3a8f-41b1-bb9b-0d2a3973d8dc"],
 "\[LineSeparator]",
 "gives the solution ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["a", "TI"], "(", 
    StyleBox["t", "TI"], ")"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ff6d1cae-9fbe-4ea3-b591-be2ca13b1953"],
 " of the BD homotopy equation ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalDelta]", 
    StyleBox["b", "TI"], "+", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["a", "TI"], 
      RowBox[{"(", 
       StyleBox["t", "TI"], ")"}], ",", 
      StyleBox["b", "TI"]}], "}"}], "\[LongEqual]", "-", 
    OverscriptBox[
     StyleBox["a", "TI"], "."], 
    RowBox[{"(", 
     StyleBox["t", "TI"], ")"}]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8bf41c5d-c7d7-447e-b5b3-52016b31426b"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["a", "TI"], 
    RowBox[{"(", "0", ")"}], "\[LongEqual]", 
    StyleBox["a", "TI"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a49a0f79-2008-43bd-8b9d-21ef22771fe3"],
 ", as a polynomial in ",
 StyleBox["t", "TI"],
 " of degree at most ",
 StyleBox["order", "TI"],
 ", truncated to total word length at most ",
 StyleBox["n", "TI"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"4eb3b626-94d8-4498-853c-f3c57ed54878"],

Cell[TextData[{
 StyleBox["a", "TI"],
 " is a BD action, a sum of scalars times powers of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["HBar"]], "paclet:ChernSimons/ref/HBar", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "3e1477d4-6ca4-42d2-ab57-b03b3c0f8ef1"],
 " times cyclic words and symmetric products, and ",
 StyleBox["b", "TI"],
 " is the interval component of the homotopy, constant in ",
 StyleBox["t", "TI"],
 "."
}], "Notes",
 CellFrameLabels->{{Inherited, Inherited}, {Inherited, 
    Cell[
     TextData[{
      "26.09.30: Design review - the name says what the function computes, a \
homotopy in the Beilinson-Drinfeld algebra of the string operations, beside \
StringBeilinsonDrinfeldOperator and StringBeilinsonDrinfeldBracket; it was \
GaugeFlow until R5f (the name the names doc recommended, approved by Pavel, \
2026-09-30), with the same signature and option. Alternative name considered: \
GaugeFlow. It takes BD actions and a pairing, not MaurerCartanElement \
objects; R5d and R5f kept that signature, and no alternative was recorded. \
The equation is written in the BD algebra itself, from \
StringBeilinsonDrinfeldOperator and StringBeilinsonDrinfeldBracket, so it \
needs no parametrization by coefficients and is not tied to any alphabet; the \
two truncations, by word length and by the power of t, are explicit \
arguments. A pairing in the exterior convention returns unevaluated, since \
the BD algebra is the symmetric algebra (R2). Prior art: the Wolfram Language \
has no BD algebras; the engine the verification suites load solves the \
coefficient equations of the circle on arrays truncated by index, which \
truncates differently, so \
T12/paclet-gauge-flow-solves-the-bd-homotopy-equation tests the equation \
itself rather than a comparison, and \
T12/paclet-empty-word-gauge-flow-is-the-extended-transport pins the velocity \
at t = 0 against the transport of the empty-word extension, with and without \
the option.", "\n\n", 
       Cell[
        BoxData[
         GridBox[{{
            Cell[
             BoxData[
              ButtonBox[
               DynamicBox[
                FEPrivate`FrontEndResource[
                "DocumentationToolsStrings", "Edit"]], BaseStyle -> 
               "TextAnnotationButton"]]], 
            StyleBox[
             RowBox[{
               DynamicBox[
                FEPrivate`FrontEndResource[
                "DocumentationToolsStrings", "LastAnnotator"]], "pavel"}], 
             "TextAnnotator"], 
            Cell[
             BoxData[
              ButtonBox[
               DynamicBox[
                FEPrivate`FrontEndResource[
                "DocumentationToolsStrings", "Delete"]], BaseStyle -> 
               "TextAnnotationRemoveButton"]]], ""}}, 
          GridBoxAlignment -> {
           "Columns" -> {Left, Left, Right, Right}, "Rows" -> {{Automatic}}}, 
          GridBoxItemSize -> {"Columns" -> {
              Scaled[0.15], 
              Scaled[0.68], 
              Scaled[0.15], 
              Scaled[0.02]}}]]], "\n"}], "TextAnnotation", 
     CellSize -> {590, Inherited}]}},
 CellTags->"TextAnnotation",
 CellID->583141164,ExpressionUUID->"9d65cf46-5466-4335-83dc-31e623acd429"],

Cell[TextData[{
 Cell[BoxData[
  FormBox["\[CapitalDelta]", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6ab8020a-d1cb-4101-977c-f8b4dc101d5c"],
 " is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["StringBeilinsonDrinfeldOperator"]], 
    "paclet:ChernSimons/ref/StringBeilinsonDrinfeldOperator", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "60652105-1d28-44e2-ac5c-30498d881825"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"\[CenterDot]", ",", "\[CenterDot]"}], "}"}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f873fad6-1f5c-4a0a-bd71-7b839a07e35d"],
 " is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["StringBeilinsonDrinfeldBracket"]], 
    "paclet:ChernSimons/ref/StringBeilinsonDrinfeldBracket", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "ec6c5024-be9d-4869-b23d-b784cea6f819"],
 "."
}], "Notes",ExpressionUUID->"4be9d6fe-9894-4a36-9eee-0eb8ffe9f8ed"],

Cell[TextData[{
 "The solution is computed by Picard iteration: ",
 StyleBox["order", "TI"],
 " steps of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["a", "TI"], 
    RowBox[{"(", 
     StyleBox["t", "TI"], ")"}], "\[RightTeeArrow]", 
    StyleBox["a", "TI"], "-", 
    SubsuperscriptBox["\[Integral]", "0", 
     StyleBox["t", "TI"]], 
    RowBox[{"(", 
     RowBox[{"\[CapitalDelta]", 
      StyleBox["b", "TI"], "+", 
      RowBox[{"{", 
       RowBox[{
        StyleBox["a", "TI"], 
        RowBox[{"(", 
         StyleBox["s", "TI"], ")"}], ",", 
        StyleBox["b", "TI"]}], "}"}]}], ")"}], "\[DifferentialD]", 
    StyleBox["s", "TI"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8aa65690-5f7a-4c4e-9421-2739d51d261a"],
 ", each truncated to degree at most ",
 StyleBox["order", "TI"],
 " in ",
 StyleBox["t", "TI"],
 "."
}], "Notes",ExpressionUUID->"aebd62ff-14d8-4068-a049-a6cccb23be76"],

Cell[TextData[{
 "After each step the words and products of total word length greater than ",
 StyleBox["n", "TI"],
 " are dropped, those of ",
 StyleBox["a", "TI"],
 " included."
}], "Notes",ExpressionUUID->"1318f190-3bac-47a9-939c-713aea6549c5"],

Cell[TextData[{
 "The equation holds to order ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["t", "TI"], 
    RowBox[{"order", "-", "1"}]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e6c7858b-915b-475d-9b16-61049c1689af"],
 " and in general fails at ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["t", "TI"], "order"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d7544f29-e475-4a84-8c2f-1c518eb56c55"],
 "."
}], "Notes",ExpressionUUID->"17bf116d-b459-46dc-9fda-b3f6221c7fa7"],

Cell["\<\
Two BD actions are BD homotopic, equivalently their Maurer-Cartan elements \
are gauge equivalent, when such a flow connects them.\
\>", "Notes",ExpressionUUID->"8dbc922b-594c-419b-a04d-37672f3f7853"],

Cell[TextData[{
 "If ",
 StyleBox["a", "TI"],
 " solves the Maurer-Cartan equation, so does ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["a", "TI"], "(", 
    StyleBox["t", "TI"], ")"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3be44dfe-4c9c-4266-8dd6-84e78275d7cc"],
 ", up to the two truncations."
}], "Notes",ExpressionUUID->"17266509-cc09-47b2-b068-da826df23df7"],

Cell[TextData[{
 "The result is a BD action, which ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["MaurerCartanElement"]], 
    "paclet:ChernSimons/ref/MaurerCartanElement", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "eed62294-a117-48ef-990b-f538272ab201"],
 " splits into its parts."
}], "Notes",ExpressionUUID->"49f25209-6d17-4ed4-b9d3-4845f55f0fd6"],

Cell["\<\
On the circle the equation is the coefficient system of the paper's lemma on \
BD homotopies. That system is truncated by the indices of the coefficients \
rather than by word length, so the two agree only where neither truncation is \
active.\
\>", "Notes",ExpressionUUID->"2ea0b8f4-15a9-46d2-b5f6-c6c7e30a6723"],

Cell["A pairing in the exterior convention returns unevaluated.", "Notes",ExpressionUUID->"29d4d21d-a3c5-4fb2-bdaf-068c2df66123"],

