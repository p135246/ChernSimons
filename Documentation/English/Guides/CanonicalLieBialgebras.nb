Notebook[{

Cell[CellGroupData[{
Cell["Canonical Lie Bialgebras", "GuideTitle",
 CellID->942062912,ExpressionUUID->"a3a3c038-ca24-47b7-9945-83f1c1312fe3"],

Cell["\<\
Canonical Lie bialgebras are the differential involutive bi-Lie algebras of \
cyclic words over a graded alphabet with a pairing: the alphabet, its cyclic \
words and their degrees; the exterior and symmetric products of cyclic words \
and the degree shift between them; the bracket and the co-bracket, a \
differential, a bracket that joins two words and a co-bracket that cuts one; \
and the canonical Lie bialgebra they make, with its four relations.\
\>", "GuideAbstract",
 CellID->2001916300,ExpressionUUID->"ef0ab37b-2e0d-4399-8f7e-82603ccbe925"]
}, Open  ]],

