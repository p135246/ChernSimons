Notebook[{

Cell[CellGroupData[{
Cell["Homotopy Algebras", "GuideTitle",
 CellID->942062912,ExpressionUUID->"a3a3c038-ca24-47b7-9945-83f1c1312fe3"],

Cell["\<\
Homotopy algebras are algebras whose relations hold up to coherent homotopy: \
finite-dimensional A-infinity algebras, their operations and their morphisms; \
and the relations of an algebraic structure, the obstruction of each and the \
test of all of them, for string algebras, Maurer-Cartan elements, A-infinity \
algebras and morphisms, and cochain complexes with a pairing and their \
decompositions.\
\>", "GuideAbstract",
 CellID->2001916300,ExpressionUUID->"ef0ab37b-2e0d-4399-8f7e-82603ccbe925"]
}, Open  ]],

Cell[CellGroupData[{

