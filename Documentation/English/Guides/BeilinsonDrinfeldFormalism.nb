  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "af3d1920-39d1-472a-9ead-831a43e60d15"],
 " \[LongDash] ",
 "the left side ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{"\[CapitalDelta]", 
     StyleBox["s", "TI"], "+", "1"}], 
    RowBox[{"2", 
     RowBox[{"{", 
      RowBox[{
       StyleBox["s", "TI"], ",", 
       StyleBox["s", "TI"]}], "}"}]}]], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"9b4e37e9-58c1-4911-8d32-dcbf35fa8abd"],
 " of the master equation, and its scalar equations on the coefficients"
}], "GuideText",ExpressionUUID->"1a9c2f0e-012b-4094-a15d-1c42574b925b"],

