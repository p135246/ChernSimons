 "the left side ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{"\[CapitalDelta]", 
     StyleBox["s", "TI"], "+", "1"}], 
    RowBox[{"2", 
     RowBox[{"{", 
      RowBox[{
       StyleBox["s", "TI"], ",", 
       StyleBox["s", "TI"]}], "}"}]}]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b757815a-0f48-4c65-9bc5-69331129878e"],
 " of the master equation, and its scalar equations on the coefficients"
}], "GuideText",ExpressionUUID->"0ecf62d5-e5a1-46a5-ac24-3a3cb7ad463c"],

