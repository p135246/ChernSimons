Cell[CellGroupData[{

Cell["Maurer-Cartan elements and the master equation", \
"GuideFunctionsSubsection",ExpressionUUID->"89f737ce-4eb8-4025-8c5e-\
b26534695a87"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["MaurerCartanElement"]], 
    "paclet:ChernSimons/ref/MaurerCartanElement", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineGuideFunction",
  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "acc11ff3-b01b-4d39-b4ae-c283db42de54"],
 " \[LongDash] ",
 "an element given by its parts ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["m", "TI"], 
    RowBox[{"\[ScriptL]", ",", 
     StyleBox["g", "TI"]}]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "976a94dc-03df-4001-8f25-138a2bb43fa4"],
 ", products of ",
 Cell[BoxData[
  FormBox["\[ScriptL]", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6afa8b94-7234-4c85-985e-75596db83557"],
 " cyclic words at genus ",
 Cell[BoxData[
  FormBox[
   StyleBox["g", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a9a2e277-7883-4f07-85b4-99a99de14cba"],
 ", or by its action ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["s", "TI"], "\[LongEqual]", 
    UnderscriptBox["\[Sum]", 
     RowBox[{"\[ScriptL]", ",", 
      StyleBox["g", "TI"]}],
     LimitsPositioning->True], 
    SuperscriptBox["\[HBar]", 
     StyleBox["g", "TI"]], " ", 
    SubscriptBox[
     StyleBox["m", "TI"], 
     RowBox[{"\[ScriptL]", ",", 
      StyleBox["g", "TI"]}]]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a368b74d-5893-41c1-bfcf-229f09dfb964"]
}], "GuideText",ExpressionUUID->"3efc0e96-3905-42b3-b2f6-31d007a72896"],

