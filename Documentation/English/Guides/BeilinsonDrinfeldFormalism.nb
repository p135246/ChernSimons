   BaseStyle->"InlineFormula"]], "InlineGuideFunction",
  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "31c9e219-c5ea-48b5-afb3-bccf322808ab"],
 " \[LongDash] ",
 "the bracket of the Beilinson-Drinfeld axiom, the bracket of cyclic words \
extended to products"
}], "GuideText",ExpressionUUID->"1eec13ed-1db4-4cc2-a0b8-61a01c2a3dac"],

