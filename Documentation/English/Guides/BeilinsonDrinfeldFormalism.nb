Cell[CellGroupData[{

Cell["Maurer-Cartan elements and the master equation", \
"GuideFunctionsSubsection",ExpressionUUID->"f2036042-72fa-49c3-939b-\
744c74bb65c8"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["MaurerCartanElement"]], 
    "paclet:ChernSimons/ref/MaurerCartanElement", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineGuideFunction",
  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "65380154-0b89-412e-9ec7-91777102d445"],
 " \[LongDash] ",
 "an element given by its parts ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["m", "TI"], 
    RowBox[{"\[ScriptL]", ",", 
     StyleBox["g", "TI"]}]], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"bfdcbd1e-bf20-45d0-a104-a631c31607b5"],
 ", products of ",
 Cell[BoxData[
  FormBox["\[ScriptL]", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "ab62696c-cf3d-4667-8efd-9b24dad0f94f"],
 " cyclic words at genus ",
 Cell[BoxData[
  FormBox[
   StyleBox["g", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "1d39cdff-0177-4c82-8d53-2bef3079e55b"],
 ", or by its action ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["s", "TI"], "\[LongEqual]", 
    UnderscriptBox["\[Sum]", 
     RowBox[{"\[ScriptL]", ",", 
      StyleBox["g", "TI"]}],
     LimitsPositioning->True], 
    SuperscriptBox["\[HBar]", 
     StyleBox["g", "TI"]], " ", 
    SubscriptBox[
     StyleBox["m", "TI"], 
     RowBox[{"\[ScriptL]", ",", 
      StyleBox["g", "TI"]}]]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"76f07e9e-e52d-4b89-83e5-bc8e1905ec65"]
}], "GuideText",ExpressionUUID->"6d3a1560-1bc4-440f-afe3-5ec901d591fc"],

