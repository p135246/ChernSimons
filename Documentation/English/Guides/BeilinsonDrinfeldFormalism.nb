 "the left side ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{"\[CapitalDelta]", 
     StyleBox["s", "TI"], "+", "1"}], 
    RowBox[{"2", 
     RowBox[{"{", 
      RowBox[{
       StyleBox["s", "TI"], ",", 
       StyleBox["s", "TI"]}], "}"}]}]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fd9d58cd-f18a-4e94-9a4f-a107f44874a2"],
 " of the master equation, and its scalar equations on the coefficients"
}], "GuideText",ExpressionUUID->"d9987c02-a845-4939-bbcc-a491470e3cbf"],

