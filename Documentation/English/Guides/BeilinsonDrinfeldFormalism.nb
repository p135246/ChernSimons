Cell[CellGroupData[{

Cell["Maurer-Cartan elements and the master equation", \
"GuideFunctionsSubsection",ExpressionUUID->"4eb0302b-ec2d-4c28-b650-\
188244b41350"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["MaurerCartanElement"]], 
    "paclet:ChernSimons/ref/MaurerCartanElement", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineGuideFunction",
  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "aac39fd6-beb4-4843-816d-f66a05a456ab"],
 " \[LongDash] ",
 "an element given by its parts ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["m", "TI"], 
    RowBox[{"\[ScriptL]", ",", 
     StyleBox["g", "TI"]}]], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"e3f2e74e-ed0d-4a00-81ec-406960b350ec"],
 ", products of ",
 Cell[BoxData[
  FormBox["\[ScriptL]", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "693f2d44-4e5a-4d66-bfc6-7127f591c334"],
 " cyclic words at genus ",
 Cell[BoxData[
  FormBox[
   StyleBox["g", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "36ec36b6-bf66-4f96-8571-ae9a3045203e"],
 ", or by its action ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["s", "TI"], "\[LongEqual]", 
    UnderscriptBox["\[Sum]", 
     RowBox[{"\[ScriptL]", ",", 
      StyleBox["g", "TI"]}],
     LimitsPositioning->True], 
    SuperscriptBox["\[HBar]", 
     StyleBox["g", "TI"]], " ", 
    SubscriptBox[
     StyleBox["m", "TI"], 
     RowBox[{"\[ScriptL]", ",", 
      StyleBox["g", "TI"]}]]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"38ddb581-e4db-4197-a3b0-c98722ef2ce0"]
}], "GuideText",ExpressionUUID->"d980e335-f1ec-4a05-998d-74a86d31e8d9"],

