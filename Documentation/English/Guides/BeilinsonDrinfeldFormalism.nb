Notebook[{

Cell[CellGroupData[{
Cell["Beilinson-Drinfeld Formalism", "GuideTitle",
 CellID->942062912,ExpressionUUID->"a3a3c038-ca24-47b7-9945-83f1c1312fe3"],

Cell[TextData[{
 "The Beilinson-Drinfeld formalism encodes the differential involutive bi-Lie \
algebra of cyclic words in one operator on their symmetric powers, with \
coefficients in power series in a formal variable ",
 Cell[BoxData[
  FormBox["\[HBar]", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "af460a07-48cf-4e8a-bb5f-f32e5991c739"],
 ": the Beilinson-Drinfeld operator and the bracket it defines; Maurer-Cartan \
elements, the solutions of the master equation; the canonical Maurer-Cartan \
element of a Poincar\[EAcute] duality algebra; and the operations twisted by \
a Maurer-Cartan element, with the homotopies between elements."
}], "GuideAbstract",ExpressionUUID->"cba6d4a5-cb43-41c5-9289-6de55440a25a"]
}, Open  ]],

Cell[CellGroupData[{

Cell["", "GuideFunctionsSection",
 CellID->1866139230,ExpressionUUID->"a0ea3657-4c83-4862-93c8-ecf80cebc774"],

Cell[CellGroupData[{

Cell["Beilinson-Drinfeld operator and bracket", "GuideFunctionsSubsection",ExpressionUUID->"71b4ae5b-1515-4727-9241-c4abb62a1c8f"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CanonicalBeilinsonDrinfeldOperator"]], 
    "paclet:ChernSimons/ref/CanonicalBeilinsonDrinfeldOperator", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineGuideFunction",
  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "09696f8c-b9f5-44b1-964e-fe6877a42784"],
 " \[LongDash] ",
 "the operator ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalDelta]", "\[LongEqual]", 
    RowBox[{
     SubscriptBox[
      OverscriptBox[
       StyleBox["q", "TI"], "^"], 
      RowBox[{"1", ",", "1", ",", "0"}]], "+", 
     SubscriptBox[
      OverscriptBox[
       StyleBox["q", "TI"], "^"], 
      RowBox[{"1", ",", "2", ",", "0"}]], "+", 
     RowBox[{"\[HBar]", " ", 
      SubscriptBox[
       OverscriptBox[
        StyleBox["q", "TI"], "^"], 
       RowBox[{"2", ",", "1", ",", "0"}]]}]}]}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"ff27a10f-39ba-4147-ae8e-508c8828307a"],
 " on the symmetric powers of cyclic words"
}], "GuideText",ExpressionUUID->"bfa4b763-1509-498b-a4fb-baf89c4c6ed3"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
