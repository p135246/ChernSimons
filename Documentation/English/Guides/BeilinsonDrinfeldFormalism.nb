Cell[CellGroupData[{

Cell["Maurer-Cartan elements and the master equation", \
"GuideFunctionsSubsection",ExpressionUUID->"46e577f7-d383-4509-9048-\
4d657c78d91f"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["MaurerCartanElement"]], 
    "paclet:ChernSimons/ref/MaurerCartanElement", 
    "ChernSimons Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineGuideFunction",
  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "562ddf76-0993-473c-894e-1ced1240f5cb"],
 " \[LongDash] ",
 "an element given by its parts ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["m", "TI"], 
    RowBox[{"\[ScriptL]", ",", 
     StyleBox["g", "TI"]}]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0378ab94-777b-4782-85b1-7f4dc1840c3c"],
 ", products of ",
 Cell[BoxData[
  FormBox["\[ScriptL]", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "34d71d37-af71-4c3a-b165-e9bc7740812e"],
 " cyclic words at genus ",
 Cell[BoxData[
  FormBox[
   StyleBox["g", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f4de5a03-8f4a-43d3-8ae5-32f4890f34d9"],
 ", or by its action ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["s", "TI"], "\[LongEqual]", 
    UnderscriptBox["\[Sum]", 
     RowBox[{"\[ScriptL]", ",", 
      StyleBox["g", "TI"]}],
     LimitsPositioning->True], 
    SuperscriptBox["\[HBar]", 
     StyleBox["g", "TI"]], " ", 
    SubscriptBox[
     StyleBox["m", "TI"], 
     RowBox[{"\[ScriptL]", ",", 
      StyleBox["g", "TI"]}]]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ce325965-e470-4913-bdc9-90d962763173"]
}], "GuideText",ExpressionUUID->"1a45b1e8-3b65-4981-a991-f39bb5ea3141"],

