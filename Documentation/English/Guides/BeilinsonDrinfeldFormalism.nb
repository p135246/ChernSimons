  "2f65ed71-e090-40a6-a081-632ca415e724"],
 " \[LongDash] ",
 "the left side ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{"\[CapitalDelta]", 
     StyleBox["s", "TI"], "+", "1"}], 
    RowBox[{"2", 
     RowBox[{"{", 
      RowBox[{
       StyleBox["s", "TI"], ",", 
       StyleBox["s", "TI"]}], "}"}]}]], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"96d508e2-f663-4cd3-b2b1-d504d63957b2"],
 " of the master equation, and its scalar equations on the coefficients"
}], "GuideText",ExpressionUUID->"a1063d62-ebb9-4ca2-b126-156d729af839"],

